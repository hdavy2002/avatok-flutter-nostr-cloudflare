{
  "name": "avatok-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "avatok.ai public web client — consume-side (browse, book, pay, watch, consult, talk to AI). Astro + React islands + Tailwind on Cloudflare Pages, rendered in the app's zine visual language.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "export-tokens": "node scripts/export-zine-tokens.mjs",
    "predev": "node scripts/export-zine-tokens.mjs && node scripts/copy-design-demo.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/export-zine-tokens.mjs && node scripts/copy-design-demo.mjs && node scripts/prepare-global-art.mjs && node scripts/prepare-public-images.mjs && node scripts/check-image-urls.mjs",
    "build": "astro build",
    "postbuild": "node scripts/dedupe-routes-json.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "copy-demo": "node scripts/copy-design-demo.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "12.6.13",
    "@astrojs/react": "4.4.2",
    "@astrojs/tailwind": "6.0.2",
    "@clerk/clerk-react": "5.61.3",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@stream-io/video-react-sdk": "1.42.0",
    "astro": "5.18.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "framer-motion": "^13.4.4",
    "hls.js": "1.6.16",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.48.0",
    "posthog-js": "^1.424.1",
    "qrcode": "^1.5.4",
    "react": "19.2.7",
    "react-day-picker": "^8.10.2",
    "react-dom": "19.2.7",
    "sonner": "^2.0.8",
    "stream-chat": "^9.52.0",
    "stream-chat-react": "^14.12.0",
    "tailwind-merge": "^2.6.1",
    "tailwindcss": "3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^1.1.2",
    "web-vitals": "6.2.1"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3"
  }
}
