# avatok.ai web client — environment.
# Copy to `.env` for local dev. PUBLIC_* vars are exposed to the browser bundle.

# API base (the SAME Worker the Flutter app calls). Prod is the default in
# src/lib/config.ts; override here for staging.
PUBLIC_API_BASE=https://api.avatok.ai
# Staging: https://api-staging.avatok.ai

# Clerk publishable key for web auth/session (pk_test_… or pk_live_…).
# Get it from the Clerk dashboard. Required for any auth'd island / GuestGate.
PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Server-only email configuration for /api/contact, /api/careers-apply and
# /api/waitlist (src/lib/sendMail.ts). Cloudflare Email Service REST API is
# tried first, Brevo is the fallback — see
# Specs/PLAN-2026-09-11-EMAIL-CLOUDFLARE-PRIMARY-BREVO-FALLBACK.md §3.4.

# Cloudflare Email Service (primary). CF_ACCOUNT_ID is public and already set
# in wrangler.toml [vars] — repeated here only for local dev convenience.
# CF_EMAIL_API_TOKEN must be an encrypted Cloudflare Pages secret in prod
# (Pages project → Settings → Environment variables), scoped to
# Account → Email Sending: Edit and nothing else. Requires `avatok.ai` to be
# onboarded to Email Sending in the Cloudflare dashboard.
CF_ACCOUNT_ID=fd3dbf43f8e6d8bf65bd36b02eb0abb0
CF_EMAIL_API_TOKEN=replace_me

# Brevo (fallback transport, and still the transport for the waitlist
# contacts-list add, which is out of scope for the Cloudflare migration).
# In Cloudflare Pages, add BREVO_API_KEY as an encrypted secret rather than a
# plaintext variable. The sender address must be verified in Brevo.
BREVO_API_KEY=xkeysib_replace_me
BREVO_SENDER_NAME=avaTOK Website
BREVO_SENDER_EMAIL=hello@avatok.ai
# Optional: one or more comma-separated Brevo contact-list IDs for the waitlist.
BREVO_LIST_ID=

# Optional override of the send policy: "cloudflare_then_brevo" (default when
# CF_EMAIL_API_TOKEN is set) | "brevo" (rollback) | "cloudflare" (no fallback).
EMAIL_PROVIDER=
