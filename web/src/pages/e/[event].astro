---
// Legacy scheduled-event alias. A listing has one canonical public URL, so
// every /e/<id> request converges in one hop instead of publishing duplicate
// HTML, metadata and structured data.
export const prerender = false;

import { getListing, ApiError } from '../../lib/apiClient';
import { listingPath } from '../../lib/urls';
import type { Listing } from '../../lib/types';

const { event } = Astro.params;
let listing: Listing | null = null;
try {
  listing = await getListing(event!);
} catch (error) {
  if (error instanceof ApiError && (error.status === 404 || error.status === 410)) {
    return new Response('Event not found', { status: error.status });
  }
  throw error;
}

if (!listing) return new Response('Event not found', { status: 404 });
return Astro.redirect(listingPath({
  id: listing.id,
  handle: listing.creator?.handle ?? null,
  slug: listing.slug ?? null,
}), 301);
---
