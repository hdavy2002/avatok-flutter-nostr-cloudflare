---
// [LIST-PAGE-2] Public scheduled-event share link — an event is a listing, so
// this now renders through the SAME `ListingDetailView` component /l/<id> and
// /<handle>/<slug> use, instead of the bespoke countdown-card page that used
// to live here. That old page's one feature this doesn't have on its own —
// "Add to calendar" — isn't in the comp; the booking box's join-lead-time line
// covers "when do I get the link" instead (SPEC-2026-09-02 §1 row 12).
export const prerender = false;

import Base from '../../layouts/Base.astro';
import { getListingCompanions } from '../../lib/listingCompanions';
import { scheduleStateOf } from '../../lib/card';
import ListingDetailsComp from '../../components/ListingDetailsComp.astro';
import { getListing, ApiError } from '../../lib/apiClient';
import { listingOg, listingJsonLd, listingBreadcrumbLd } from '../../lib/og';
import type { Listing } from '../../lib/types';

const { event } = Astro.params;

let listing: Listing | null = null;
let notFound = false;
try {
  listing = await getListing(event!);
} catch (e) {
  if (e instanceof ApiError && (e.status === 404 || e.status === 410)) notFound = true;
  else throw e;
}
if (notFound || !listing) return new Response('Event not found', { status: 404 });

Astro.response.headers.set('Cache-Control', 'public, max-age=60, stale-while-revalidate=300');
const og = listingOg(listing);
// [LISTING-EXPIRY-1] A finished or cancelled show keeps a readable page for anyone
// holding the link, but is no longer something to rank in search.
const closedListing = ['ended', 'cancelled', 'expired'].includes(scheduleStateOf(listing));
// [WEB-GATEWAY-FIX3 2026-09-19] A badged example is real, published copy but never a
// real transaction — keep it out of search the same way a closed show is kept out.
const isExampleListing = Boolean(listing.is_example);
// [LISTING-SEO-1 2026-09-06] Same Event + breadcrumb graph as /l/<id>.
// All three listing URLs render the same component, so they must carry the
// same structured data — a listing that describes itself differently
// depending on which of its URLs a crawler reached is worse than one that
// describes itself not at all.
const pageUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://avatok.ai').toString();
const eventLd = listingJsonLd(listing, pageUrl);
const crumbLd = listingBreadcrumbLd(listing, pageUrl);

const { reviewList, slots, browseMore, creatorProfile, creatorListings } = await getListingCompanions(listing);
const isOwner = Boolean(listing.viewer?.is_owner);
---

<Base title={og.title} description={og.description} image={og.image} noindex={closedListing || isExampleListing}>
  <Fragment slot="head">
    {og.extra.map((m) => (m.property ? <meta property={m.property} content={m.content} /> : <meta name={m.name} content={m.content} />))}
    <script type="application/ld+json" set:html={JSON.stringify(eventLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(crumbLd)} />
  </Fragment>

  {isExampleListing && (
    <div style="max-width:100rem; margin:0 auto; padding:10px clamp(14px,4vw,40px) 0; display:flex; align-items:center; gap:10px; flex-wrap:wrap; font-family:'Nunito',sans-serif; font-weight:800; font-size:12px; letter-spacing:.08em; text-transform:uppercase;">
      <span data-i18n="web-l.5f2a7c19be3d4e0a" style="display:inline-block; padding:4px 10px; border:2px solid #0e1116; border-radius:999px; background:#fdf1d3;">Example listing</span>
      <span data-i18n="web-l.7c6d0a2f915e4b3c" style="text-transform:none; letter-spacing:0; font-size:13px; font-weight:700;">This shows what creators will offer on avaTOK. Booking opens at launch.</span>
    </div>
  )}

  {isOwner && (
    <div style="max-width:100rem; margin:0 auto; padding:10px clamp(14px,4vw,40px) 0; display:flex; align-items:center; gap:12px; font-family:'Nunito',sans-serif; font-weight:800; font-size:12px; letter-spacing:.08em;">
      <span data-i18n="web-e.cf3f39ccb027e0bc">YOU OWN THIS LISTING</span>
      <a data-i18n="web-e.25ea91162e54d14e" href={`/dashboard/listings/new?id=${encodeURIComponent(listing.id)}`} style="text-decoration:underline;">EDIT LISTING →</a>
    </div>
  )}

  <ListingDetailsComp listing={listing} reviews={reviewList} slots={slots} browse={browseMore} creatorListings={creatorListings} creatorProfile={creatorProfile} />
</Base>
