---
export const prerender = true;
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import OriginalIdeasSection from '../components/OriginalIdeasSection.astro';
import '../styles/global-editorial.css';
---
<Base chrome={false} title="Creator ideas for YouTube, TikTok & Instagram · avaTOK" description="Practical ways to turn your audience into paid live streams and 1:1 video consultations. Find a format, plan your session and make it yours." image="/assets/global-original/ideas-creator-watch-party.png" imageAlt="YouTube creator watch party: react, teach and hang out live with your biggest viewers." imageWidth={396} imageHeight={308}>
  <SiteHeader variant="global" />
  <main class="global-editorial ge-catalog" id="main-content" data-global-ideas>
    <div class="ge-catalog-back"><a data-i18n="web-global-ideas.d443aa85fab5a3a4" class="ge-back" href="/">← The global home</a></div>
    <OriginalIdeasSection mainHeading />
    <section class="ge-start"><div><p data-i18n="web-global-ideas.f1000c96a2ade550" class="ge-kicker">START SMALL. MAKE IT YOURS.</p><h2 data-i18n="web-global-ideas.a265ddc9119cb658">Your next idea is already in your comments.</h2><p data-i18n="web-global-ideas.90b39ebb950abe5c">Choose one question your audience keeps asking. Build one clear session around it. These guides are starting points—not promises of earnings or platform reach.</p></div><div class="ge-start__actions"><a data-i18n="web-global-ideas.24bca8259f00fdd3" class="ge-button" href="/sign-up?role=creator&country=global">Start creating →</a><a data-i18n="web-global-ideas.554e8db153833afa" class="ge-text-link" href="/marketplace">Explore the India marketplace ↗</a><a data-i18n="web-global-ideas.af101a3b0ce30fc9" class="ge-text-link" href="/ideas">Looking for ideas for India? →</a></div></section>
  </main>
  <SiteFooter variant="global" />
</Base>
