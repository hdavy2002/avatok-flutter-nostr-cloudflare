---
// [MKT-V2-1 2026-09-27] THE NEW MARKETPLACE (owner-approved "marketplace v2"
// mockup, formerly pages/marketplace-v2-preview.astro). Replaces the bazaar
// marketplace (MarketplaceBrowse / ExploreGrid / BazaarHero — deleted).
//
// NOTE FOR AI:
//  - Public for everyone, logged in or not (SPEC-2026-09-01 A1.1).
//    /dashboard/marketplace 301s here; /marketplace/page/[page] is the crawlable
//    directory for the sitemap and is unrelated to this page.
//  - REAL DATA ONLY. Everything that depends on listings (tabs counts, live strip,
//    rails, deity/festival/temple counts, the grid, filters, empty state, hero
//    stats) is islands/marketplace/MarketplaceV2.tsx over /api/explore. Never add
//    placeholder/sample cards "so it looks full" — that was reverted on 2026-08-29.
//  - This file renders only the static chrome: hero + search form (a plain GET
//    form so a search is a shareable URL and works without JS), the intention band
//    (passed into the island as the `intentions` slot so it sits between the
//    deity row and the festival panel), the booking steps, promises and the note.
//  - SSR (prerender = false) because the hero form is pre-filled from ?q=&type=&when=.
//  - Island props carry RAW /assets paths only — a /cdn-cgi/image URL inside
//    serialized props fails the built-image-source deploy check (see pages/index.astro).
//  - Brand is "Saa Thum". Prices are only ever "Starting from ₹X" from the listing.
export const prerender = false;

import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import MarketplaceV2 from '../islands/marketplace/MarketplaceV2';
import FreeVideosRow from '../islands/freevideos/FreeVideosRow';
import ExploreGuides from '../islands/guides/ExploreGuides';
import { API_BASE, publicImage } from '../lib/config';
import { HOME_HEADER_LINKS } from '../lib/homeNavigation';
import { rituals, ritualBySlug } from '../lib/ritualGuides';
import { MARKETPLACE_SEO } from '../lib/seo/catalog';
import '../styles/saathum-folk.css';
import '../islands/home/BookNowShelf.css';
import '../islands/marketplace/MarketplaceV2.css';
import { BRAND } from '../lib/brand';
import { loadMarketplaceCards } from '../lib/marketplaceCards';
import { withDeadline } from '../lib/requestDeadline';
import type { Card } from '../lib/types';

const params = Astro.url.searchParams;
const q = (params.get('q') ?? '').trim().slice(0, 80);
const type = (params.get('type') ?? '').trim().toLowerCase();
const when = (params.get('when') ?? '').trim().toLowerCase();

const guides = rituals.map(r => ({ title: r.title, href: r.href, image: r.image }));
const heroImage = ritualBySlug('lakshmi-havan')?.image ?? '/assets/grand/hero.png';
const typeOptions = [['', 'All categories'], ['havan', 'Havan'], ['puja', 'Puja'], ['satsang', 'Satsang'], ['sermon', 'Sermon'], ['meditation', 'Meditation'], ['festival', 'Festival specials']];
const whenOptions = [['', 'Any date'], ['today', 'Today'], ['week', 'This week'], ['weekend', 'This weekend'], ['month', 'This month']];
const trending = ['Lakshmi', 'Navratri', 'Ganesh', 'Mahamrityunjaya', 'Satyanarayan', 'Exams'];

// [MKT-SSR-1 2026-09-30] Fetch the listings HERE so the "Upcoming events" grid is in
// the HTML. Before this the island had to download + boot and only then start the
// fetch (0.7 s median, 1.6 s p90 on top), and on slow phones the section sat empty
// long enough that the owner scrolled past it. Server → api is Cloudflare-internal
// and fast; if it is not (deadline) or it fails, the island falls back to its
// client fetch with placeholder cards, exactly as before. Never blocks the page long.
const SSR_DEADLINE_MS = 1500;
let initialCards: Card[] | undefined;
let serverMs: number | undefined;
{
  const t0 = Date.now();
  try {
    initialCards = await withDeadline((signal) => loadMarketplaceCards(signal), SSR_DEADLINE_MS);
  } catch (err) {
    console.warn('[MKT-SSR-1] server listing fetch failed; island will fetch', err instanceof Error ? err.message : String(err));
  }
  serverMs = Date.now() - t0;
}
const serverNow = Date.now();

Astro.response.headers.set('Cache-Control', 'public, max-age=60, stale-while-revalidate=300');
---
<Base content={MARKETPLACE_SEO} chrome={false} indiaLandingLanguage={false}>
  <Fragment slot="head">
    <meta name="theme-color" content="#fff8e8" />
    <!-- [MKT-SPEED-1] Open the API connection while the island JS downloads, so the
         listings fetch skips DNS + TLS setup. -->
    <link rel="preconnect" href={API_BASE} crossorigin />
    <link rel="preload" as="style" onload="this.onload=null;this.rel='stylesheet'" href="https://fonts.googleapis.com/css2?family=Comfortaa:wght@400;500;600;700&family=Nunito:wght@400;600;700;800;900&display=swap" />
  </Fragment>
  <div class="folk-site" data-design="reference-v5" style={`--folk-border-url:url(${publicImage('/assets/bright/border.png', { width: 640, fit: 'scale-down' })})`}>
    <a class="folk-skip" href="#main-content">Skip to main content</a>
    <SiteHeader folk indiaLandingLanguage={false} responsiveHome referenceHome links={HOME_HEADER_LINKS} />
    <main id="main-content" class="mk">

      <!-- ① HERO + SEARCH ENGINE. Plain GET form: every search is a shareable URL
           (?q=&type=&when=); the island intercepts it when JS is on. -->
      <section class="mk-hero" aria-labelledby="mk-title">
        <div class="mk-hero-inner">
          <div class="mk-hero-copy">
            <p class="mk-eyebrow">{BRAND.nameUpper} MARKETPLACE<span id="mk-hero-count"></span></p>
            <h1 id="mk-title">Search havans, pujas and satsangs. <em>Booked in about a minute.</em></h1>
            <p class="mk-lead">Led by the priests of Himalayan temples<span id="mk-hero-cities"></span>. A shared sankalp for all who join, and prasad couriered home.</p>
            <form class="mk-search" action="/marketplace" method="get" role="search" aria-label="Search events">
              <label class="mk-field mk-field--q">
                <span>What are you looking for?</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
                <input name="q" type="search" value={q} maxlength="80" placeholder="Deity, ritual or a wish — Lakshmi, exams, new home…" autocomplete="off" />
              </label>
              <label class="mk-field"><span>Category</span><select name="type">{typeOptions.map(([v, l]) => <option value={v} selected={v === type}>{l}</option>)}</select></label>
              <label class="mk-field"><span>When</span><select name="when">{whenOptions.map(([v, l]) => <option value={v} selected={v === when}>{l}</option>)}</select></label>
              <button class="mk-search-btn" type="submit">Search <span aria-hidden="true">→</span></button>
            </form>
            <div class="mk-quick" aria-label="Popular searches">
              <span>Trending:</span>
              {trending.map(t => <a href={'/marketplace?q=' + encodeURIComponent(t) + '#all-events'}>{t}</a>)}
            </div>
          </div>
          <div class="mk-hero-art">
            <img class="mk-hero-img" aria-hidden="true" src={publicImage(heroImage, { width: 900, fit: 'scale-down' })} alt="" width="1536" height="1024" fetchpriority="high" decoding="async" />
            <div id="mk-hero-stats" class="mk-hero-stats-slot"></div>
          </div>
        </div>
      </section>
      <div class="grand-divider" aria-hidden="true"></div>

      <!-- ②–⑨ Data-driven sections (tabs, live strip, rails, deities, festivals,
           temples, all events, empty state). The intention band is static and
           slotted in between. -->
      <MarketplaceV2 client:load guides={guides}
        initialCards={initialCards} serverNow={serverNow} serverMs={serverMs}
        initialSearch={Astro.url.search} origin={Astro.url.origin}>
        <!-- [SAATHUM-FREEVIDEOS-WEB-1] "Free videos" row: its own section right after the Upcoming
             events grid (MarketplaceV2 renders this slot there). client:visible = loads when scrolled to. -->
        <FreeVideosRow slot="afterEvents" client:visible surface="marketplace" />
      </MarketplaceV2>
      {/* [AUMFE-GUIDES-FRONT-1] "Talk to a guide" (#guides) — admin-preview only, renders nothing for customers. */}
      <ExploreGuides client:idle />
      <div class="grand-divider" aria-hidden="true"></div>

      <p class="grand-booking-note">{BRAND.name} performs pujas and havans for you. You book and pay online; refunds follow our <a href="/refunds">published policy</a>. Benefits described are those traditionally sought by devotees; {BRAND.name} makes no claims of guaranteed outcomes.</p>
    </main>
    <SiteFooter folk indiaLandingLanguage={false} />
  </div>
</Base>
