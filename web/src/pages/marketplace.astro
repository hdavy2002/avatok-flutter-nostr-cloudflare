---
// [HELLO-FRAANDS-EXPLORE-1 2026-10-08] /marketplace = "Explore": browse every host with mood,
// language, price and online filters. Re-skinned for Hello Fraands (owner decision 2026-10-08,
// rulebook HF-SITE-3). The old puja/havan marketplace (islands/marketplace/MarketplaceV2) is in git
// history and its directory pages are archived.
//
// NOTE FOR AI:
//  - Same people grid, ProfileCard and filter script (lib/notebookHome.ts) as the home page's
//    #people section, so a card change lands here too. The element ids (#mood-filter, #people …)
//    are what the script reads — keep them.
//  - Profiles are the illustrative samples from lib/callvaalHomeReference until the backend lists
//    real listings; avoid presenting sample profile counts as verified facts.
export const prerender = true;
import brandConfig from '../../../Specs/brand.json';
import { publicImage } from '../lib/config';
import { marketplaceCategories, profiles } from '../lib/callvaalHomeReference';
import ProfileCard from '../components/callvaal/ProfileCard.astro';
import LiveHostCards from '../islands/hosts/LiveHostCards';
import ModernIcon from '../components/home/ModernIcon.astro';
import Header from '../components/callvaal/Header.astro';
import Footer from '../components/callvaal/Footer.astro';
import '../styles/callvaal-notebook.css';
import '../styles/hello-fraands-pages.css';

const identity = brandConfig.homepageIdentity;
const title = `Find an influencer. Start a conversation. | ${identity.name}`;
const description = 'Find your favourite influencer and book a private phone call. Explore influencers by category, language and price. Your number stays private. 18+.';
const canonical = `https://${identity.domain}/marketplace`;
const languages = [...new Set(profiles.flatMap(p => p.languages.split(/,\s*|\s*·\s*/)).map(s => s.trim()).filter(Boolean))];
---
<!doctype html>
<html lang="en-IN">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title><meta name="description" content={description} /><link rel="canonical" href={canonical} /><meta name="theme-color" content="#46113e" /><meta name="robots" content="index,follow" />
  <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'CollectionPage', name: title, description, url: canonical, inLanguage: 'en-IN' })} />
  <meta property="og:type" content="website" /><meta property="og:site_name" content={identity.name} /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} />
  <meta property="og:image" content={`https://${identity.domain}/assets/callvaal/scrapbook/hero-collage-friendship.jpg`} />
  <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:image" content={`https://${identity.domain}/assets/callvaal/scrapbook/hero-collage-friendship.jpg`} />
  <link rel="icon" href="/assets/branding/hf-favicon.png" type="image/png" />
  <link data-site-fonts rel="preload" href="/fonts/Comfortaa-Bold.ttf" as="font" type="font/ttf" crossorigin /><link rel="preload" href="/fonts/Nunito-Black.woff2" as="font" type="font/woff2" crossorigin />
</head>
<body>
<div class="notebook-site hf-site" data-design="callvaal-scrapbook">
  <a class="skip-link" href="#main-content">Skip to main content</a>
  <Header />
  <main id="main-content" class="hf-content explore-page">
    <header class="hfp-hero">
      <div class="hfp-hero-copy">
        <nav class="hf-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">Explore</span></nav>
        <h1>Baat karne ka mann hai?</h1>
        <p class="hf-hindi"><em>Talk to the influencers you follow on YouTube, Instagram and Facebook over a private phone call. Find an influencer who speaks your language, check their price, and start a call.</em></p>
        <div class="trust-chips"><span><ModernIcon name="lock" />Number kabhi share nahi hota</span><span><ModernIcon name="user" />Har influencer video verified hai</span><span><ModernIcon name="clock" />From ₹5/min</span></div>
      </div>
      <div class="hfp-hero-note paper-note" aria-hidden="true">Tumhari vibe.<br />Tumhari baat.</div>
    </header>

    <section class="explore-moods" aria-labelledby="explore-moods-title">
      <h2 id="explore-moods-title" class="explore-h2">Ajj kis topic per baat karni hai?</h2>
      <div class="category-story-grid" aria-label="Browse influencer categories">{[
        { title: 'LGBTQ+ conversations', category: 'lgbtq', image: '/assets/marketplace/call-category-lgbtq.jpg', alt: 'Two distinct young adult women in separate rooms, each smiling on a phone call', tone: 'cream' },
        { title: 'Celebrity chats', category: 'celebrity-chat', image: '/assets/marketplace/call-category-celebrities.jpg', alt: 'A young adult performer and listener talking by phone from separate places', tone: 'pink' },
        { title: 'Social media creators', category: 'social-media-influencers', image: '/assets/marketplace/call-category-creators.jpg', alt: 'Two different young adult women creators in separate studios, each on a phone call', tone: 'lilac' },
        { title: 'Uncensored talk', category: 'uncensored-talk', image: '/assets/marketplace/call-category-uncensored.jpg', alt: 'A young adult man and woman having a candid phone conversation from separate homes', tone: 'paper' },
      ].map(item => <a class:list={['category-story-card', `category-story-card--${item.tone}`]} href={`/marketplace?category=${encodeURIComponent(item.category)}#people`} aria-label={`Browse ${item.title}`}>
        <img src={publicImage(item.image, { width: 900 })} alt={item.alt} loading="lazy" />
        <span class="category-story-card__label">{item.title}<span aria-hidden="true">↗</span></span>
      </a>)}</div>
    </section>

    <section class="people-section" id="people" aria-labelledby="people-title"><h2 id="people-title">Apni vibe ka influencer dhundo</h2>
      <div class="people-toolbar"><div class="people-filters"><button type="button" class="filter-all" data-reset-filters>All</button><label for="category-filter">Categories</label><select id="category-filter"><option value="">All categories</option>{marketplaceCategories.map(category => <option value={category.slug}>{category.label}</option>)}</select><label for="language-filter">Language</label><select id="language-filter"><option value="">Any language</option>{(languages.length ? languages : ['Hindi','English','Kannada','Marathi']).map(language => <option>{language}</option>)}</select><label for="price-filter">Price</label><select id="price-filter"><option value="">Any price</option>{[5,10,20,25,30].map(value => <option value={value}>₹{value}/min or less</option>)}</select><label class="online-toggle"><input id="online-filter" type="checkbox" /> Online now</label></div><button class="view-all" type="button" data-reset-filters>Show everyone →</button></div>
      <p class="sr-only" data-favourites-status role="status" aria-live="polite"></p>
      <p class="selected-category-label" data-selected-category-label hidden></p><p class="sample-label" aria-hidden="true" style="visibility:hidden">Sample profiles · Illustrative names, KYC badges, ratings, conversation counts and prices</p><p class="sr-only" id="filter-status" role="status" aria-live="polite"></p>
      <LiveHostCards client:visible /><div class="people-grid">{profiles.map(profile => <ProfileCard profile={profile} marketplace />)}</div>
      <div class="no-results" hidden><p>No sample profiles match those filters.</p><button type="button" data-reset-filters>Show all sample profiles</button></div>
    </section>

    <section class="explore-help" aria-label="Before you call">
      <a class="tone-cream" href="/help/getting-started/how-a-call-works"><strong>How a call works</strong><span>We call the influencer first and announce you. If they accept, we call you and join the two calls. No one listens to your calls.</span></a>
      <a class="tone-pink" href="/help/calling/price-and-minutes"><strong>What a call costs</strong><span>Rates start at ₹5/min; each influencer sets their own price.</span></a>
      <a class="tone-lilac" href="/safety"><strong>Kaise safe hai</strong><span>Your number stays hidden. Press # to end a call and block the person. Report anyone; our team reviews reports before strikes and bans.</span></a>
      <a class="tone-paper" href="/hosts/join"><strong>Kya aap influencer hain?</strong><span>Become an influencer. Talk to your fans, share your interests, and earn through conversation.</span></a>
    </section>
  </main>
  <Footer hideTagline />
</div>
<dialog id="preview-dialog" aria-labelledby="preview-title" aria-describedby="preview-description"><h2 id="preview-title">Preview only</h2><p id="preview-description">Calls and joining are not available yet.</p><button type="button" data-close-preview>Close</button></dialog>
<style>
  .explore-page .trust-chips{margin-top:20px}
  .explore-page .people-section h2{white-space:nowrap;font-size:clamp(1.5rem,3.5vw,3rem)}
  .explore-page .sample-label{visibility:hidden}
  .explore-page .profile-disclosure{display:none}
  .explore-page :global(.people-grid .profile-card-facts){grid-template-columns:1fr}
  .explore-page :global(.people-grid .profile-card-facts>div:nth-child(2)){display:none}
  .explore-page :global(.people-grid .profile-card-facts>div:first-child){padding:8px 12px}
  .explore-page :global(.people-grid .profile-card-facts>div:first-child dd){font-size:1rem}
  .explore-page :global(.people-grid .profile-card-stats .modern-icon){display:none}
  .explore-page :global(.people-grid .profile-card-stats p>span){font-size:.75rem;line-height:1.25}
  .explore-page :global(.people-grid .profile-card-stats strong){font-size:1.125rem}
  .explore-page :global(.people-grid .profile-card-topics .person-moods){display:flex;flex-wrap:nowrap;overflow-x:auto;overscroll-behavior-inline:contain;scroll-snap-type:x proximity;padding-bottom:4px}
  .explore-page :global(.people-grid .profile-card-topics .person-moods li){flex:0 0 auto;white-space:nowrap;scroll-snap-align:start}
  @media(max-width:599px){.explore-page .people-section h2{white-space:normal;font-size:clamp(1.5rem,7vw,2rem)}}
  .explore-moods{margin:clamp(40px,6vw,72px) 0}
  .explore-h2{margin-bottom:26px}
  .explore-h2 em,.explore-page .people-section h2 em{color:#A52E67}
  .explore-page .people-section{margin-top:0}
  .explore-page :global(.people-grid .profile-card){border:5px solid #fff;border-radius:24px;overflow:hidden;box-shadow:0 4px 10px #46113e10,0 18px 36px #46113e18;transition:transform .2s ease,box-shadow .2s ease}
  .explore-page :global(.people-grid .profile-card:hover){transform:translateY(-4px);box-shadow:0 8px 16px #46113e14,0 24px 42px #46113e20}
  .category-story-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}
  .category-story-card{position:relative;display:block;min-height:220px;aspect-ratio:1.9/1;overflow:hidden;border:6px solid #fff;border-radius:24px;background:#f4eaff;box-shadow:0 5px 12px #46113e12,0 18px 34px #46113e18;transition:transform .2s ease,box-shadow .2s ease}
  .category-story-card:hover,.category-story-card:focus-visible{transform:translateY(-4px);box-shadow:0 9px 18px #46113e16,0 24px 42px #46113e20}
  .category-story-card img{display:block;width:100%;height:100%;object-fit:cover}
  .category-story-card__label{position:absolute;inset:auto 12px 12px 12px;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:13px 17px;border:1px solid #ffffffc7;border-radius:16px;background:#fffF;color:#46113e;font-family:Nunito,sans-serif;font-size:clamp(1rem,2vw,1.3rem);font-weight:900;box-shadow:0 5px 15px #270d2526}
  @media(max-width:599px){.category-story-grid{grid-template-columns:1fr;gap:14px}.category-story-card{min-height:190px;aspect-ratio:1.55/1}}
  @media(prefers-reduced-motion:reduce){.category-story-card,.explore-page :global(.people-grid .profile-card){transition:none}.category-story-card:hover,.category-story-card:focus-visible,.explore-page :global(.people-grid .profile-card:hover){transform:none}}
  .explore-help{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin-top:clamp(40px,6vw,72px)}
  .explore-help a{display:grid;gap:8px;padding:22px;border-radius:22px;text-decoration:none;box-shadow:0 5px 16px #46113e0d}
  .explore-help strong{font-family:Nunito,sans-serif;font-weight:900;font-size:1.25rem}
  .explore-help span{font-size:var(--text-note);color:#5d3a59}
  .explore-help a:hover{transform:translateY(-2px)}
  @media(max-width:1099px){.explore-help{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:599px){.explore-help{grid-template-columns:1fr}}
</style>
<script>import '../lib/notebookHome';</script>
</body>
</html>
