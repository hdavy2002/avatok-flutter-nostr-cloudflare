---
export const prerender = true;
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { creatorIdeas, formats, topics } from '../lib/creatorIdeas';
import '../styles/railway-home.css';

const ideas = creatorIdeas.slice(0, 6);

---
<Base title="AvaTOK — Get Paid to Listen, Chat & Live Stream From Home" description="AvaTOK is an India-focused creator marketplace where people create listings, book time with one another, and host paid live events, private sessions, and group conversations." image="/ogimage.jpg" chrome={false}>
  <Fragment slot="head">
    <meta name="theme-color" content="#f7ead5" />
    <link rel="preload" as="image" href="/assets/home/avatok-creator-constellation.png" />
  </Fragment>
  <a class="rail-skip" href="#ideas-catalogue">Skip to earning ideas</a>
  <SiteHeader />
  <main class="rail-home" data-design="creator-marketplace-2026-09" id="main-content">
    <section class="station-hero creator-hero" aria-labelledby="rail-title">
      <div class="creator-hero__frame">
        {/* [UI-MOTION-1 2026-09-10] "texts-reveal" (transitions.dev, `.t-*` in
            styles/motion.css) — headline and supporting line rise in with a
            staggered blur on first paint. `.t-stagger` goes on `.station-copy`
            itself, not a new wrapper div, so `h1`/`p` stay its DIRECT children —
            railway-home.css has `.station-copy > p:not(.station-aside)` rules
            at every breakpoint that a wrapper div would have broken.
            CRITICAL: both lines are real, readable text at rest — the
            <noscript> below forces them visible if JS never runs, and
            railwayHome.ts's safety-net timeout forces `.is-shown` even if the
            reveal script itself fails, so nothing is ever permanently parked
            at opacity:0. */}
        <noscript><style>.t-stagger .t-stagger-line{opacity:1!important;transform:none!important;filter:none!important}</style></noscript>
        <div class="station-copy creator-hero__copy t-stagger" id="hero-reveal">
          <p class="station-kicker creator-hero__kicker"><span aria-hidden="true"></span> India’s creator marketplace</p>
          <h1 id="rail-title" class="t-stagger-line"><span class="creator-hero__line">Apna hunar.</span><span class="creator-hero__line creator-hero__line--accent">Apni kamaai.</span></h1>
          <p class="t-stagger-line t-stagger-line--2">Jo aata hai, usse kamao. Host a live event, offer your time 1:1, or teach a small group—<strong>on your terms, at your price.</strong></p>
          <div class="station-actions">
            <a class="rail-button" href="/sign-up" data-home-cta="hero-create">Start earning free</a>
            <a class="station-outline" href="/ideas" data-home-cta="hero-ideas">Explore ideas</a>
          </div>
          <div class="creator-hero__formats" aria-label="Ways to earn on AvaTOK">
            <a href="/marketplace?group=india_goes_live" data-home-cta="hero-live">Live events</a>
            <a href="/marketplace?group=find_your_people" data-home-cta="hero-private">Private 1:1</a>
            <a href="/marketplace?group=book_their_time" data-home-cta="hero-group">Group sessions</a>
          </div>
        </div>
        {/* closes the merged .station-copy.t-stagger div opened above (it used
            to close a plain .station-copy). */}
        <div class="station-art creator-hero__art">
          <span class="creator-hero__live" aria-hidden="true">● Live from India</span>
          <img src="/assets/home/avatok-creator-constellation.png" width="1156" height="1360" alt="Indian creators hosting a live stream, teaching a class, and offering a one-to-one conversation online." fetchpriority="high" decoding="async" />
          <p class="creator-hero__share"><strong>80%</strong><span>you keep</span></p>
        </div>
      </div>
      <a class="rail-next" href="#ideas-catalogue">Find your first earning idea <span aria-hidden="true">↓</span></a>
    </section>

    <section class="rail-ideas rail-wrap" id="ideas-catalogue" aria-labelledby="ideas-title" data-home-section="ideas">
      <p class="rail-eyebrow rail-flowered"><img src="/ornament-flower.png" alt="" width="28" height="28" /> Kya offer karoge? <img src="/ornament-flower.png" alt="" width="28" height="28" /></p>
      <h2 id="ideas-title">Socha hai, isse bhi <span>kamaa sakte ho?</span></h2>
      <p class="rail-section-copy">A few ideas to get your first listing started.</p>
      <div class="rail-idea-grid">
        {ideas.map((idea) => (
          <article class="idea-card rail-article-card">
            <a class="idea-card-link" href={idea.href} aria-labelledby={`${idea.id}-title`} data-home-idea={idea.id}>
              <div class="idea-picture"><img src={idea.cardImage} srcset={`${idea.cardImage} 768w, ${idea.image} 1536w`} sizes="(max-width:699px) 90vw, (max-width:1100px) 44vw, 29vw" alt="" width="1536" height="1024" loading="lazy" decoding="async" /></div>
              <div class="idea-card-copy"><div class="idea-chips"><span class:list={['idea-format', idea.format]}>{formats[idea.format]}</span><span>{topics[idea.topic].label}</span>{idea.setting === 'home' && <span>From home</span>}</div><h3 id={`${idea.id}-title`}>{idea.title}</h3><p>{idea.description}</p><span class="idea-read-guide">Read the guide <span aria-hidden="true">↗</span></span></div>
            </a>
          </article>
        ))}
      </div>
      {/* [WEB-HOME-EXPLORE-BTN 2026-09-10] A real button, not a text link —
          the only way on from the six sample ideas is the full /ideas page. */}
      <a class="rail-button rail-button--ink rail-explore-button" href="/ideas" data-home-cta="explore-ideas">Explore more ideas <span aria-hidden="true">↗</span></a>
      <p class="rail-note">Listening sessions: adults 18+ · Companionship, not therapy or emergency support.</p>
    </section>

    <section class="rail-formats rail-wrap" aria-labelledby="formats-title" id="consultations" data-home-section="formats">
      <h2 class="rail-flowered" id="formats-title"><img src="/ornament-flower.png" alt="" width="34" height="34" /> Ek platform. Teen tareeke. <img src="/ornament-flower.png" alt="" width="34" height="34" /></h2>
      <div class="rail-format-grid">
        <a id="live-streaming" href="/marketplace?group=india_goes_live" data-home-cta="format-live"><span class="rail-format-icon rail-badge--pink" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="6" width="12" height="12" rx="2" /><path d="m15 10 6-3v10l-6-3" /></svg></span><span><h3>Live events</h3><p>Sell tickets to your stream.</p></span><span aria-hidden="true">↗</span></a>
        <a id="live-friends" href="/marketplace?group=book_their_time" data-home-cta="format-private"><span class="rail-format-icon rail-badge--yellow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="7" r="4" /><path d="M4 22v-3a8 8 0 0 1 16 0v3" /></svg></span><span><h3>1:1 sessions</h3><p>Offer your undivided time.</p></span><span aria-hidden="true">↗</span></a>
        <a id="group-sessions" href="/marketplace?group=book_their_time" data-home-cta="format-group"><span class="rail-format-icon rail-badge--blue" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="7" r="3" /><path d="M2 21v-3a7 7 0 0 1 14 0v3M16 4a3 3 0 0 1 0 6m2 4a5 5 0 0 1 4 5v2" /></svg></span><span><h3>Group sessions</h3><p>Teach or advise a small group.</p></span><span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <section class="rail-onboarding rail-wrap" aria-labelledby="ticket-title" id="how-avatok-works" data-home-section="start">
      <div class="rail-ticket">
        <div class="rail-ticket-art" aria-hidden="true">
          <svg viewBox="80 1352 120 58" xmlns="http://www.w3.org/2000/svg">
            <defs><filter id="ticket-ink" color-interpolation-filters="sRGB"><feColorMatrix type="matrix" values="0 0 0 0 0.10  0 0 0 0 0.10  0 0 0 0 0.06  -0.6378 -2.1456 -0.2166 0 2" /></filter></defs>
            <image href="/assets/railway/approved-ideas.jpg" width="865" height="1819" filter="url(#ticket-ink)" />
          </svg>
        </div>
        <div class="rail-ticket-main">
          <h2 id="ticket-title">Your first booking express</h2>
          <p>Four simple steps to get on board</p>
          <ol>
            <li><span>1</span>Create a listing</li>
            <li><span>2</span>Set your price</li>
            <li><span>3</span>Open your calendar</li>
            <li><span>4</span>Go live</li>
          </ol>
        </div>
        <div class="rail-ticket-end"><span>Same<br />people<br />new<br />opportunities</span><span aria-hidden="true">♥</span></div>
      </div>
      <div class="rail-last-cta"><a class="rail-button rail-button--ink" href="/sign-up" data-home-cta="footer-create">Create your free listing <span aria-hidden="true">↗</span></a><p class="rail-script">Chhoti shuruaat<br />badi kahaniyan<br />banati hai.</p></div>
    </section>
  </main>
  <div class="station-footer"><SiteFooter /></div>
  <script>
    import '../lib/railwayHome';
  </script>
</Base>
