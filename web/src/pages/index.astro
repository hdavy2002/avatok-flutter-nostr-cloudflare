---
export const prerender = true;
import brandConfig from '../../../Specs/brand.json';
import { publicImage, publicImageSrcSet } from '../lib/config';
import { moodGroups, moods, profiles } from '../lib/callvaalHomeReference';
import ModernIcon from '../components/home/ModernIcon.astro';
import '../styles/callvaal-notebook.css';
import HelloFraandsHeader from '../components/callvaal/Header.astro';
import HelloFraandsFooter from '../components/callvaal/Footer.astro';
const identity = brandConfig.homepageIdentity;
const title = `Baat karo. Dil halka karo. | ${identity.name}`;
const description = 'Talk to a real person in your language, right now. Your number stays private. Pay per minute. 18+.';
const canonical = `https://${identity.domain}/`;
const moodLabel = (slug: string) => moods.find(mood => mood.slug === slug)?.label ?? slug;
---
<!doctype html>
<html lang="en-IN">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title><meta name="description" content={description} /><link rel="canonical" href={canonical} /><meta name="theme-color" content="#46113e" /><meta name="robots" content="index,follow" />
  <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'WebPage', name: title, description, url: canonical, inLanguage: 'en-IN' })} />
  <meta property="og:type" content="website" /><meta property="og:site_name" content={identity.name} /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} />
  <meta property="og:image" content={`${canonical}assets/callvaal/scrapbook/hero-collage-moods.png`} /><meta property="og:image:alt" content={`${identity.name}: everyday people talking privately.`} />
  <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={`${canonical}assets/callvaal/scrapbook/hero-collage-moods.png`} />
  <link rel="icon" href="/assets/callvaal/notebook/favicon.svg" type="image/svg+xml" />
  <link data-site-fonts rel="preload" href="/fonts/Comfortaa-Bold.ttf" as="font" type="font/ttf" crossorigin /><link rel="preload" href="/fonts/Nunito-Black.woff2" as="font" type="font/woff2" crossorigin />
</head>
<body>
<div class="notebook-site" data-design="callvaal-scrapbook">
  <a class="skip-link" href="#main-content">Skip to main content</a>
  <HelloFraandsHeader />
  <main id="main-content">
    <section class="notebook-hero" aria-labelledby="hero-title">
      <div class="hero-copy"><h1 id="hero-title">Baat karo.<br/><mark><em>Dil halka karo.</em></mark></h1><p class="hero-promise">Real people. Your number stays private.</p><p class="hero-subtitle">Someone to talk to, in your language, right now. Pay per minute. Nobody sees your phone number.</p>
        <div class="hero-actions"><a class="hero-primary" href="#people">Kisi se baat karo</a><a class="hero-secondary" href="#earn">Earn by talking</a></div>
        <div class="trust-chips"><span><ModernIcon name="lock" />Number kabhi share nahi hota</span><span><ModernIcon name="user" />Har host video-KYC verified</span><span><ModernIcon name="clock" />From ₹20/min</span></div>
      </div>
      <div class="hero-art"><img src={publicImage('/assets/callvaal/scrapbook/hero-collage-moods.png', { width: 1280 })} srcset={publicImageSrcSet('/assets/callvaal/scrapbook/hero-collage-moods.png', [420, 640, 900, 1280])} sizes="(max-width: 599px) calc(100vw - 32px), (max-width: 899px) calc((100vw - 40px) / 2), (max-width: 1824px) calc((100vw - 64px) / 2), 880px" alt="Torn-paper collage of two everyday people talking on private phone calls" fetchpriority="high" width="1254" height="1254" /></div>
    </section>
    <aside class="service-disclaimer" aria-label="Service disclaimer">Yahan sirf baat hoti hai. No medical, legal or money advice. No miracles, no guaranteed results. Not a replacement for a doctor or counsellor. 18+ only.</aside>
    <section class="social-proof-section" aria-labelledby="social-proof-title">
      <div class="social-proof-heading"><div><p class="preview-kicker">Illustrative preview</p><h2 id="social-proof-title">Bharat bhar mein, <em>baat kaam ki.</em></h2></div><p>What we are building towards at launch.</p></div>
      <div class="proof-card-grid">
        {[
          ['coral', '5,000+', 'People to talk to', 'Launch target'],
          ['gold', 'Any Indian language', 'Talk naturally', 'Designed for multilingual conversations'],
          ['violet', 'Pan India', 'People across India', 'Find someone to talk to, wherever you are'],
          ['rose', 'Private numbers', 'Your number stays yours', 'Calls connect without sharing personal numbers'],
        ].map(([tone, value, label, note]) => <article class:list={['proof-card', `proof-card--${tone}`]}>
          <svg class="proof-flower" aria-hidden="true" viewBox="0 0 64 64"><g fill="currentColor"><ellipse cx="32" cy="13" rx="8" ry="13"/><ellipse cx="51" cy="32" rx="13" ry="8"/><ellipse cx="32" cy="51" rx="8" ry="13"/><ellipse cx="13" cy="32" rx="13" ry="8"/></g><circle cx="32" cy="32" r="9" fill="#fffdf7"/></svg>
          <strong>{value}</strong><span>{label}</span><small>{note}</small>
        </article>)}
      </div>
      <div class="activity-preview">
        <div class="activity-preview-label"><strong>Sample activity</strong><span>Live updates coming later</span></div>
        <div class="activity-ticker" role="group" tabindex="0" aria-label="Illustrative sample activity from fictional people. Live activity updates are not available yet.">
          <div class="activity-track">
            <div class="activity-sequence">
              <span><b>Rohit from Pune</b> just talked to Neha · 18 min</span><span><b>Ananya from Guwahati</b> just talked to Priya · 32 min</span><span><b>Meera from Jaipur</b> just talked to Sana · 21 min</span><span><b>Arjun from Kochi</b> just talked to Kavya · 15 min</span>
            </div>
            <div class="activity-sequence" aria-hidden="true">
              <span><b>Rohit from Pune</b> just talked to Neha · 18 min</span><span><b>Ananya from Guwahati</b> just talked to Priya · 32 min</span><span><b>Meera from Jaipur</b> just talked to Sana · 21 min</span><span><b>Arjun from Kochi</b> just talked to Kavya · 15 min</span>
            </div>
          </div>
        </div>
      </div>
    </section>
    <section class="mood-section" id="moods" aria-labelledby="moods-title"><p class="preview-kicker">Find your kind of conversation</p><h2 id="moods-title">Aaj kya <em>mood hai?</em></h2>
      <div class="mood-grid">{moodGroups.map((group, index) => <div class:list={['mood-group', `mood-group--${index + 1}`]}><div class="mood-group-head"><span class="mood-doodle" aria-hidden="true">{['✳','✷','☼','✦'][index]}</span><h3>{group}</h3></div><div class="mood-chips">{moods.filter(mood => mood.group === group).map(mood => <a class="mood-chip" href={`/?mood=${encodeURIComponent(mood.slug)}#people`}>{mood.label}<span aria-hidden="true">↗</span></a>)}</div>{group === 'Tension' && <p class="crisis-note">If you're in crisis, call <a href="tel:14416">Tele-MANAS 14416</a> (free, 24×7) or <a href="tel:112">112</a>.</p>}</div>)}</div>
    </section>
    {/* Launch auth contract: when auth is wired, render this entire section, its moods and its hosts ONLY for signed-in accounts with gender_verified = F or T. The section, moods and hosts must be absent for all other accounts. This public card is a static preview only. */}
    <section class="women-section" id="women-only" aria-labelledby="women-title">
      <p class="women-preview-tag">Preview — visible to verified women at launch</p>
      <div class="women-heading"><ModernIcon name="lock" /><h2 id="women-title">Sirf ladkiyon ke liye<br/><em>Ek jagah jahan sirf auratein baat karti hain.</em></h2></div>
      <p class="women-description">A women-only space. Periods, PCOS worries, saas-bahu, pregnancy nerves, 3am with a newborn — talk to another woman who gets it. Both the caller and the host are KYC-verified as women. This space is not visible to men.</p>
      <small class="women-disclaimer">Talk and share — not medical advice.</small>
      <div class="women-moods" aria-label="Women-only conversation topics">
        <a class="women-mood-chip" href="/?lane=women#people">periods &amp; PCOS worries</a>
        <a class="women-mood-chip" href="/?lane=women#people">saas-bahu, ghar ki baatein</a>
        <a class="women-mood-chip" href="/?lane=women#people">pregnancy &amp; new mom nights</a>
      </div>
      <div class="women-actions">
        <span class="women-entry-preview" title="Coming at launch" tabindex="0" aria-label="Verify &amp; enter — Coming at launch"><button type="button" disabled aria-describedby="women-launch-note">Verify &amp; enter</button><span class="women-launch-tooltip" id="women-launch-note" role="tooltip">Coming at launch</span></span>
        <a class="women-explainer" href="/women-only">How the women-only space works →</a>
      </div>
      <p class="women-host-note">Hosts in this space earn the same rates. <a href="#earn">Earn with us →</a></p>
    </section>
    <section class="privacy-section" id="privacy-note" aria-labelledby="privacy-title">
      <h2 id="privacy-title">Aapka number. <em>Sirf aapka.</em></h2><p class="privacy-intro">Neither person sees the other’s personal phone number.</p>
      <ol class="privacy-diagram">
        <li><p><b>1</b><span>Choose a person<br/>and tap Call.</span></p><div class="phone-frame"><ModernIcon name="user" /></div><strong>You</strong></li>
        <li><p><b>2</b><span>{identity.name} calls the host first;<br/>then the caller after acceptance.</span></p><div class="phone-frame"><ModernIcon name="lock" /><small>{identity.name}</small></div><strong>Private connection</strong></li>
        <li><p><b>3</b><span>Both hear a recording notice.<br/>The calls connect privately.</span></p><div class="phone-frame"><ModernIcon name="user" /></div><strong>Call partner</strong></li>
      </ol>
      <div class="privacy-note paper-note">Number private.<br/>Baat apni.</div><div class="privacy-conversation-note paper-note">People.<br/>Conversations.<br/>A brighter you.</div><p class="privacy-bottom">No need to exchange personal numbers.<br/><button type="button" data-preview-action="privacy" data-preview-label="Number privacy">Learn about number privacy →</button></p>
    </section>
    <section class="safety-section" id="safety" aria-labelledby="safety-title"><p class="preview-kicker">Planned for launch</p><h2 id="safety-title">Kaise <em>safe rahega</em></h2><div class="safety-grid">
      <article><span aria-hidden="true">01</span><p>Your number will be masked. Calls will be bridged through {identity.name}.</p></article>
      <article><span aria-hidden="true">02</span><p>Hosts will complete video KYC and Aadhaar verification before taking calls.</p></article>
      <article><span aria-hidden="true">03</span><p>At launch, both people will hear a recording notice. Recordings may be reviewed for safety.</p></article>
      <article><span aria-hidden="true">04</span><p>Harassment and sexual advances are not allowed. Reports are reviewed; repeated confirmed violations can lead to a ban.</p></article>
    </div><div class="safety-links"><a href="/talk-safely">Rules for talking safely with strangers →</a><button type="button" data-preview-action="page" data-preview-label="Community guidelines">Community guidelines</button></div></section>
    <section class="people-section" id="people" aria-labelledby="people-title"><p class="preview-kicker">Sample profiles · Illustrative</p><h2 id="people-title">Kaun hai <em>online?</em></h2>
      <div class="people-toolbar"><div class="people-filters"><button type="button" class="filter-all" data-reset-filters>All</button><label for="mood-filter">Mood</label><select id="mood-filter"><option value="">All moods</option>{moods.map(mood => <option value={mood.slug}>{mood.label}</option>)}</select><label for="language-filter">Language</label><select id="language-filter"><option value="">Any language</option>{['Hindi','English','Kannada','Marathi'].map(language => <option>{language}</option>)}</select><label for="price-filter">Price</label><select id="price-filter"><option value="">Any price</option>{[20,25,30].map(value => <option value={value}>₹{value}/min or less</option>)}</select><label class="online-toggle"><input id="online-filter" type="checkbox" /> Online now</label></div><button class="view-all" type="button" data-reset-filters>View all people →</button></div>
      <p class="selected-category-label" data-selected-mood-label hidden></p><p class="sample-label">Sample profiles · Illustrative names, KYC badges, ratings, conversation counts and prices</p><p class="sr-only" id="filter-status" role="status" aria-live="polite"></p>
      <div class="people-grid">{profiles.map(profile => <article class="profile-card" data-person data-moods={profile.moods.join(' ')} data-languages={profile.languages} data-price={profile.price} data-online={String(profile.online)} data-search={`${profile.name} ${profile.languages} ${profile.moods.map(moodLabel).join(' ')}`}>
        <div class="portrait-wrap"><img class="person-portrait" src={publicImage(`/assets/callvaal/scrapbook/${profile.portrait}`, { width: 900 })} alt={`Illustrative portrait of ${profile.name}`} width="1254" height="1254" loading="lazy" /><button type="button" class="favourite-button" data-favourite aria-pressed="false" aria-label={`Save ${profile.name} for this visit`}><ModernIcon name="bookmark" /></button></div>
        <div class="person-copy"><div class="person-heading"><h3>{profile.detailPath ? <a class="person-detail-link" href={profile.detailPath}>{profile.name}</a> : profile.name}</h3>{profile.videoKyc && <span class="verification-badge" aria-label="Illustrative video-KYC badge">video-KYC ✓</span>}</div><p class:list={['person-status', profile.online ? 'is-online' : 'is-offline']}><span aria-hidden="true"></span>{profile.online ? 'Online now' : 'Offline'}</p><ul class="person-moods">{profile.moods.map(slug => <li>{moodLabel(slug)}</li>)}</ul><p>{profile.languages}</p><p class="person-rating"><span aria-hidden="true">★</span><b>{profile.rating}</b></p><p class="person-talks"><ModernIcon name="user" /> Talked to {profile.talkedTo} people</p><div class="person-actions"><strong class="person-price">₹{profile.price}/min</strong>{profile.detailPath ? <a class="sample-call person-detail-action" href={profile.detailPath}>View profile</a> : <button type="button" class="sample-call" data-preview-action="call" data-preview-label={profile.name}>Talk</button>}</div></div>
      </article>)}</div>
      <div class="no-results" hidden><p>No sample profiles match those filters.</p><button type="button" data-reset-filters>Show all sample profiles</button></div><p class="profile-disclosure">All profiles, video-KYC badges, ratings and conversation counts shown here are illustrative. Calls and payments are unavailable in this preview.</p>
    </section>
    <section class="earn-section" id="earn" aria-labelledby="earn-title"><img class="earn-art" src={publicImage('/assets/callvaal/scrapbook/earn-art-moods.png', { width: 900 })} alt="Torn-paper notebook with phone conversation doodles, pencil and chai" loading="lazy" width="1254" height="1254" /><div class="earn-copy"><h2 id="earn-title">Baatein karo. <em>Paise kamao.</em></h2><p>Good on the phone? Set your rate and talk from home on your own hours. At a ₹20/min caller rate, the planned host share is ₹10.80/min before tax; paid calls are not guaranteed. Your number stays private. You can end and report an abusive call, and confirmed abuse can lead to a ban.</p><ol class="earn-steps"><li><ModernIcon name="user" /><span>Sign up with WhatsApp OTP</span></li><li><ModernIcon name="lock" /><span>Video KYC + Aadhaar</span></li><li><ModernIcon name="clock" /><span>Pick your moods, languages and price</span></li><li><ModernIcon name="tax" /><span>Go online, get paid via UPI</span></li></ol><button type="button" class="join-button" data-preview-action="join">Join &amp; earn →</button></div><div class="earn-note paper-note">More conversations.<br/>A brighter tomorrow.</div></section>
    <aside class="phone-strip">Planned for launch: no app needed. Calls will come to your normal number.</aside>
  </main>
  <HelloFraandsFooter />
  <nav class="mobile-bottom-nav" aria-label="Quick navigation">{[['home','#main-content','Home'],['grid','#moods','Moods'],['user','#people','People'],['lock','#safety','Safety'],['tax','#earn','Earn']].map(([icon,href,label]) => <a href={href}><ModernIcon name={icon}/><span>{label}</span></a>)}</nav>
</div>
<dialog id="preview-dialog" aria-labelledby="preview-title" aria-describedby="preview-description"><h2 id="preview-title">Preview only</h2><p id="preview-description">Calls and joining are not available yet.</p><button type="button" data-close-preview>Close</button></dialog>
<script>import '../lib/notebookHome';</script>
</body>
</html>