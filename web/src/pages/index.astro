---
export const prerender = true;
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import FolkArtwork from '../components/FolkArtwork.astro';
import FolkIcon from '../components/FolkIcon.astro';
import BookingArtwork from '../components/BookingArtwork.astro';
import { ARTWORK_QUALITY, publicImage, publicImageSrcSet } from '../lib/config';
import { HOME_HERO, HOME_SEO } from '../lib/homeContent';
import '../styles/saathum-folk.css';
import '../styles/home-hero.css';

// rebrand: reviewed — [SAATHUM-REBRAND-1 2026-09-25] Puja & Havan service brief.
// Intention cards (brief §5.3) in the existing six-card design.
const categories = [
  { name: 'puja', label: 'Success in studies', term: 'Studies' },
  { name: 'festival', label: 'A fresh start', term: 'Fresh start' },
  { name: 'aarti', label: 'Prosperity', term: 'Prosperity' },
  { name: 'yoga', label: 'Health & peace', term: 'Health' },
  { name: 'satsang', label: 'Love & family', term: 'Family' },
  { name: 'bhajan', label: 'Festival pujas', term: 'Festival' },
] as const;

// [SAATHUM-GUIDE-1 2026-09-25] OWNER DECISION: the "Upcoming live pujas & havans"
// listing cards were replaced by eight HAVAN KNOWLEDGE cards (title, deity,
// description, Read more → /rituals/<slug>), plus an "Explore more havans &
// pujas" button → /rituals (the Puja & Havan Guide, which replaced /ideas).
// Cards + images come from lib/ritualGuides.ts (featuredHavans) — images at
// /assets/saathum-rituals/<slug>.png. The old sample listing cards (prices,
// ratings, schedule badges) are in git history at c32524ca for restore.
import { featuredHavans, ritualCategoryShort, rituals } from '../lib/ritualGuides';
// [SAATHUM-BOOKNOW-1 2026-09-26] "Book now" shelf — real upcoming listings, hidden when there are none.
import BookNowShelf from '../islands/home/BookNowShelf';
// [SAATHUM-FREEVIDEOS-WEB-1 2026-10-01] "Free videos" row, right after the events shelf.
import FreeVideosRow from '../islands/freevideos/FreeVideosRow';
// Raw /assets paths on purpose: a /cdn-cgi/image URL inside serialized island props
// (HTML-escaped JSON) trips the built-image-source deploy check. The island calls publicImage().
// [WEB-HERO-PHOTO-1] Full-bleed hero photo (design/temple-crew/havan3.png).
const HERO_PHOTO = '/assets/saathum-grand/hero-havan.jpg';
const heroPhoto = publicImage(HERO_PHOTO, { width: 1672, fit: 'scale-down' });
const heroPhotoSet = publicImageSrcSet(HERO_PHOTO, [640, 900, 1280, 1672], { fit: 'scale-down' });
const bookNowGuides = rituals.map(r => ({ title: r.title, href: r.href, image: r.image }));
const bookNowSamples = featuredHavans.filter(h => ['ganapati-havan', 'lakshmi-havan', 'mahamrityunjaya-havan', 'rudra-havan'].includes(h.slug)).map(h => ({ title: h.title, href: h.href, image: h.image }));

const search = (term: string) => '/marketplace?q=' + encodeURIComponent(term);
// [SAATHUM-ARCHIVE-1 2026-09-25] Marketplace menu label (see lib/homeNavigation.ts).
import { HOME_HEADER_LINKS } from '../lib/homeNavigation';
import PreetiMount from '../components/PreetiMount.astro';
import { BRAND } from '../lib/brand';
---
<Base content={HOME_SEO} chrome={false} indiaLandingLanguage={false}>
  <Fragment slot="head">
    <meta name="theme-color" content="#fff8e8" />
    <link rel="preload" as="style" onload="this.onload=null;this.rel='stylesheet'" href="https://fonts.googleapis.com/css2?family=Comfortaa:wght@400;500;600;700&family=Nunito:wght@400;600;700;800;900&display=swap" />
  </Fragment>
  <div class="folk-site" data-design="saathum-reference-v5" style={`--folk-border-url:url(${publicImage('/assets/saathum-bright/border.png', { width: 640, fit: 'scale-down' })})`}>
    <a class="folk-skip" href="#main-content">Skip to main content</a>
    <SiteHeader folk indiaLandingLanguage={false} responsiveHome referenceHome links={HOME_HEADER_LINKS} />
    <main id="main-content">
      {/* [WEB-HERO-PHOTO-1 2026-09-29] Owner-approved full-bleed photo hero —
          design/homepage-hero/saathum-home-hero-mock.src.html, reproduced exactly. Styles: styles/home-hero.css. */}
      <section class="grand-hero hx" aria-labelledby="grand-title" data-home-section="hero">
        <div class="grand-hero-art hx-art">
          <img class="grand-hero-image hx-photo" data-grand-artwork="hero" src={heroPhoto} srcset={heroPhotoSet} sizes="100vw" alt="Our crew filming a havan at a Himalayan temple at dawn, the pujari offering ghee into the fire with snow peaks behind." width="1672" height="941" fetchpriority="high" decoding="async" />
        </div>
        <div class="hx-inner">
          <div class="grand-hero-copy hx-copy">
            <p class="hx-eyebrow">{HOME_HERO.eyebrow}</p>
            <h1 id="grand-title">{HOME_HERO.titleLineOne} <em>{HOME_HERO.titleLineTwo}</em></h1>
            <p class="hx-lead">{HOME_HERO.lead}</p>
            <div class="hx-actions">
              <a class="grand-button" href="/marketplace?q=Havan" data-home-cta="hero-join-havan">Join a havan <span aria-hidden="true">→</span></a>
              <a class="grand-link hx-link" href="/how-it-works" data-home-cta="hero-how-it-works">How it works <span aria-hidden="true">→</span></a>
            </div>
            <p class="hx-proof">{HOME_HERO.proof}</p>
          </div>
        </div>
      </section>

      <div class="grand-divider" aria-hidden="true"></div>

      <section class="grand-experiences" id="experiences" aria-labelledby="grand-experiences-title" data-home-section="experiences">
        <div class="grand-section-heading">
          <h2 id="grand-experiences-title"><span aria-hidden="true">✽</span> What would you like to welcome into your life? <span aria-hidden="true">✽</span></h2>
        </div>
        <div class="grand-category-grid">
          {categories.map(category => <a class="grand-category" href={search(category.term)} data-home-cta={'experience-' + category.term.toLowerCase().replace(/\s+/g, '-')}>
            <BookingArtwork kind="category" name={category.name} alt="" sizes="(max-width: 600px) 46vw, (max-width: 1100px) 30vw, 15vw" />
            <div class="grand-category-copy"><h3>{category.label}</h3><span class="grand-arrow" aria-hidden="true">↗</span></div>
          </a>)}
        </div>
      </section>
      <div class="grand-divider grand-divider--after-experiences" aria-hidden="true"></div>

      <!-- [HOME-HOWITWORKS-1 2026-09-27] "How does it work?" strip — sits above Book now,
           framed by the gold ribbon on both sides. Tooltips are CSS-only (hover + keyboard focus). -->
      <section class="grand-belonging" id="benefits" aria-labelledby="grand-benefits-title" data-home-section="benefits">
        <div class="grand-belonging-inner">
          <div class="grand-belonging-art"><FolkArtwork name="satsang" sizes="(max-width: 600px) 90vw, 32vw" alt="A woman teacher seated with women in prayer, in colourful Indian folk art." /></div>
          <div class="grand-belonging-copy"><h2 id="grand-benefits-title">HOW DOES IT WORK?</h2></div>
          <div class="grand-joining" id="joining" data-home-section="joining">
            <ol class="grand-step-grid" aria-label="How it works, in three steps">
              <li><a href="/marketplace" data-home-cta="steps-book" aria-describedby="step-tip-book"><FolkIcon kind="ticket" /><span class="grand-step-number">01</span><span class="grand-step-label">Book an event</span></a><span class="grand-step-tip" role="tooltip" id="step-tip-book">Pay using Stripe for international and UPI for India.</span></li>
              <li><a href="/help/booking-and-paying/join-a-live-show" data-home-cta="steps-watch" aria-describedby="step-tip-watch"><FolkIcon kind="live" /><span class="grand-step-number">02</span><span class="grand-step-label">Get the video</span></a><span class="grand-step-tip" role="tooltip" id="step-tip-watch">Filmed at the temple by our crew. We email you the video to download when it finishes.</span></li>
              <li><a href="/help/booking-and-paying/sankalp-replay-and-prasad" data-home-cta="steps-prasad" aria-describedby="step-tip-prasad"><FolkIcon kind="prasad" /><span class="grand-step-number">03</span><span class="grand-step-label">Get prasad delivered</span></a><span class="grand-step-tip" role="tooltip" id="step-tip-prasad">Prasad is optional, for a havan or puja, and available pan-India for now.</span></li>
            </ol>
          </div>
        </div>
      </section>
      <div class="grand-divider" aria-hidden="true"></div>

      <!-- NOTE FOR AI: [SAATHUM-BOOKNOW-1] up to 4 real bookable listings (live/1:1) from /api/explore.
           Renders NOTHING when none are listed. Add ?booknow=preview to see sample cards. -->
      <BookNowShelf client:idle guides={bookNowGuides} samples={bookNowSamples} exploreHref="/marketplace" />

      <!-- NOTE FOR AI: [SAATHUM-FREEVIDEOS-WEB-1] the "Free videos" row — its own section under the
           paid events. Loads in the background (client:idle) and renders NOTHING when no free video
           is published. Components: islands/freevideos/. -->
      <FreeVideosRow client:idle surface="home" />

      <section class="grand-moments" id="home-events" aria-labelledby="grand-moments-title" data-home-section="havans">
        <!-- NOTE FOR AI: knowledge cards, NOT bookable listings. Each opens the ritual's
             article in the Puja & Havan Guide. Data + images: lib/ritualGuides.ts. -->
        <div class="grand-moments-inner">
          <div class="grand-section-heading">
            <h2 id="grand-moments-title"><span aria-hidden="true">✽</span> Sacred havans we perform for you</h2>
          </div>
          <div class="grand-listing-grid grand-listing-grid--havans">
            {featuredHavans.map((havan, i) => <article class="grand-listing grand-havan" data-havan-index={i}>
              <div class="grand-listing-art-wrap">
                <a class="grand-listing-art" href={havan.href} tabindex="-1" aria-hidden="true" data-home-cta={'havan-art-' + havan.slug}>
                  <img src={publicImage(havan.image, { width: 900, fit: 'scale-down', quality: ARTWORK_QUALITY })} srcset={publicImageSrcSet(havan.image, [420, 640, 900], { fit: 'scale-down', quality: ARTWORK_QUALITY })} sizes="(max-width: 600px) 92vw, (max-width: 1100px) 46vw, 23vw" alt="" width="1536" height="1024" loading="lazy" decoding="async" />
                </a>
              </div>
              <div class="grand-listing-copy">
                <div class="grand-listing-heading"><h3><a href={havan.href}>{havan.title}</a></h3></div>
                <div class="grand-listing-host"><span>{havan.deity}</span></div>
                <p class="grand-listing-description">{havan.description}</p>
                <div class="grand-listing-footer"><span class="grand-city-pill">● {ritualCategoryShort[havan.category]}</span><a class="grand-booking-link" href={havan.href} aria-label={'Read more about the ' + havan.title} data-home-cta={'havan-read-' + havan.slug}>Read more <span aria-hidden="true">→</span></a></div>
              </div>
            </article>)}
          </div>
          <div class="grand-havan-more"><a class="grand-button" href="/rituals/" data-home-cta="explore-havans-pujas">Explore more havans &amp; pujas <span aria-hidden="true">→</span></a></div>
        </div>
      </section>


      <section class="grand-organise" id="organise-invite" aria-labelledby="grand-organise-title" data-home-section="promise">
        <div class="grand-elephant grand-elephant--left"><img src={publicImage('/assets/saathum-booking/elephant.png', { width: 360, fit: 'scale-down', quality: ARTWORK_QUALITY })} alt="" width="1536" height="1024" loading="lazy" decoding="async" /></div>
        <div class="grand-organise-copy"><h2 id="grand-organise-title">Only joy, only blessings.</h2><p>Only positive Himalayan temples, only benefic rituals. No fear, ever.</p><a class="grand-button" href="/marketplace" data-home-cta="promise-choose-puja">Choose a puja <span aria-hidden="true">↗</span></a></div>
        <div class="grand-elephant grand-elephant--right"><img src={publicImage('/assets/saathum-booking/elephant.png', { width: 360, fit: 'scale-down', quality: ARTWORK_QUALITY })} alt="" width="1536" height="1024" loading="lazy" decoding="async" /></div>
      </section>

      <p class="grand-booking-note">{BRAND.name} performs pujas and havans for you. You book and pay online; refunds follow our <a href="/refunds">published policy</a>. Benefits described are those traditionally sought by devotees; {BRAND.name} makes no claims of guaranteed outcomes.</p>
    </main>
    <SiteFooter folk indiaLandingLanguage={false} />
  </div>
  <script>
    import '../lib/railwayHome';
    document.querySelectorAll<HTMLButtonElement>('[data-favorite]').forEach((button) => {
      button.addEventListener('click', () => {
        const active = button.getAttribute('aria-pressed') === 'true';
        button.setAttribute('aria-pressed', String(!active));
        button.textContent = active ? '♡' : '♥';
        button.setAttribute('aria-label', active ? 'Save this ritual' : 'Remove from saved');
      });
    });
  </script>
  <PreetiMount kind="home" />
</Base>
