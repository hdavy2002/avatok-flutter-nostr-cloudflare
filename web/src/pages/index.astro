---
export const prerender = true;
import brandConfig from '../../../Specs/brand.json';
import ModernIcon from '../components/home/ModernIcon.astro';
import HelloFraandsHeader from '../components/callvaal/Header.astro';
import HelloFraandsFooter from '../components/callvaal/Footer.astro';
import CreatorPreviewCard from '../components/callvaal/CreatorPreviewCard.astro';
import { creatorPreviews, homeCopy } from '../lib/hostFanHomeReference';
import { publicImage, publicImageSrcSet } from '../lib/config';
import '../styles/callvaal-notebook.css';
import '../styles/host-fan-redesign.css';
const identity = brandConfig.homepageIdentity;
const title = `${homeCopy.heroTitle} | ${identity.name}`;
const description = homeCopy.heroDescription;
const canonical = `https://${identity.domain}/`;
const assets = '/assets/callvaal/host-fan/redesign/';
---
<!doctype html>
<html lang="en-IN">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title><meta name="description" content={description} /><link rel="canonical" href={canonical} /><meta name="theme-color" content="#46113e" /><meta name="robots" content="index,follow" />
  <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'WebPage', name: title, description, url: canonical, inLanguage: 'en-IN' })} />
  <meta property="og:type" content="website" /><meta property="og:site_name" content={identity.name} /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} />
  <meta property="og:image" content={`${canonical}assets/callvaal/host-fan/redesign/hero.jpg`} /><meta property="og:image:alt" content="Illustrative fan and creator enjoying a private phone conversation." />
  <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={`${canonical}assets/callvaal/host-fan/redesign/hero.jpg`} />
  <link rel="icon" href="/assets/callvaal/notebook/favicon.svg" type="image/svg+xml" />
  <link data-site-fonts rel="preload" href="/fonts/Comfortaa-Bold.ttf" as="font" type="font/ttf" crossorigin /><link rel="preload" href="/fonts/Nunito-Variable.ttf" as="font" type="font/ttf" crossorigin />
  <link rel="preload" href="/fonts/Comfortaa-Variable.ttf" as="font" type="font/ttf" crossorigin />
</head>
<body class="hfh-reference-page">
<div class="notebook-site" data-design="callvaal-scrapbook">
  <a class="skip-link" href="#main-content">Skip to main content</a>
  <HelloFraandsHeader homeReference />
  <main id="main-content" class="hfh-home">
    <section class="hfh-hero" aria-labelledby="hero-title" data-home-section="hero">
      <div class="hfh-hero-copy"><p class="hfh-eyebrow"><span aria-hidden="true"></span> A little hello. A real connection.</p>
        <h1 id="hero-title"><span class="hfh-title-line">Talk to your favourite</span> <span class="hfh-title-line">social media influencers</span> <em>over a private phone call.</em></h1>
        <p>{homeCopy.heroDescription}</p>
        <div class="hfh-actions"><a class="hfh-button" href="/marketplace" data-home-cta="explore-hosts">Explore influencers <span aria-hidden="true">→</span></a><a class="hfh-button hfh-button--outline" href="/hosts/join" data-home-cta="become-host">Become an influencer</a></div>
        <ul class="hfh-proof" aria-label="Call safeguards"><li><svg class="modern-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 2 9 4v6c0 5-5 8-9 10-4-2-9-5-9-10V6Z"/><path d="m8 12 3 3 5-6"/></svg>Verified influencers</li><li><ModernIcon name="lock" />Your number stays private</li><li><ModernIcon name="payment" />Secure payments</li></ul>
      </div>
      <div class="hfh-collage" aria-label="Illustrative private call preview">
        <img class="hfh-hero-photo" src={publicImage(`${assets}hero.webp`, { width: 1280 })} srcset={publicImageSrcSet(`${assets}hero.webp`, [420, 640, 900, 1280, 1600])} sizes="(max-width: 767px) calc(100vw - 32px), (min-width: 1680px) 720px, 48vw" width="1536" height="1024" fetchpriority="high" alt="Illustrative fan and creator smiling during a private phone conversation" />
        <div class="hfh-photo-caption"><span class="hfh-caption-icon"><ModernIcon name="phone" /></span><div><strong>From following to connecting.</strong><span>One private conversation at a time.</span></div></div>
        <span class="hfh-photo-tag">Real people. Real talks.</span>
      </div>
    </section>
    <section class="hfh-creators hfh-torn" id="people" aria-labelledby="people-title" data-home-section="creators">
      <span id="moods" class="hfh-anchor" aria-hidden="true"></span><span id="naye-dost" class="hfh-anchor" aria-hidden="true"></span>
      <div class="hfh-section-heading"><div><h2 id="people-title">Talk to influencers you follow</h2><p>Verified influencers. Real conversations. Private calls.</p></div><a href="/marketplace" data-home-cta="view-all-hosts">View all influencers <span aria-hidden="true">→</span></a></div>
      <div class="hfh-creator-grid">{creatorPreviews.map(profile => <CreatorPreviewCard profile={profile} />)}</div>
      <p class="hfh-sample-label hfh-disclosure" id="sample-disclosure">Sample profiles · Illustrative photos, ratings, availability and prices. No audio plays and no call or payment is made.</p>
    </section>
    <section class="hfh-privacy hfh-torn" id="safety" aria-labelledby="privacy-title" data-home-section="privacy">
      <div id="privacy-note"><p class="hfh-eyebrow">A conversation, with boundaries.</p><h2 id="privacy-title">Your number stays yours.</h2><p>Our system first calls the influencer. If they accept, we call you and merge the two calls. Both calls come from a {identity.name} number, so we never reveal either person’s personal phone number.</p></div>
      <figure class="hfh-connection" aria-label={`Fan and influencer connect through ${identity.name}. Both personal phone numbers stay private.`}>
        <div class="hfh-person"><img class="hfh-call-person hfh-call-person--fan" src={publicImage(`${assets}hero.webp`, { width: 640 })} srcset={publicImageSrcSet(`${assets}hero.webp`, [420, 640, 900, 1280, 1600])} sizes="(max-width: 699px) 80px, 140px" width="1536" height="1024" loading="lazy" alt="Illustrative fan speaking on a private phone call" /><strong>Fan</strong></div>
        <span class="hfh-connector-arrow" aria-hidden="true">⇢</span>
        <div class="hfh-secure"><svg viewBox="0 0 80 88" aria-hidden="true"><path d="M40 5C31 10 18 13 8 16L12 43C15 60 27 73 40 81C55 73 66 58 69 42L73 16C61 13 50 9 40 5Z" fill="#116b70"/><path d="M26 25Q21 23 20 29C18 42 34 59 47 62Q54 64 58 60L60 55Q61 52 57 50L50 46Q47 44 45 48L43 51Q33 46 30 38L33 35Q36 33 33 30L29 26Q28 24 26 25Z" fill="white"/><path d="M46 20q14 4 17 17M46 28q7 2 9 9" fill="none" stroke="white" stroke-width="3" stroke-linecap="round"/></svg><strong>{identity.name}<br/>connects</strong></div>
        <span class="hfh-connector-arrow" aria-hidden="true">⇠</span>
        <div class="hfh-person"><img class="hfh-call-person hfh-call-person--host" src={publicImage(`${assets}hero.webp`, { width: 640 })} srcset={publicImageSrcSet(`${assets}hero.webp`, [420, 640, 900, 1280, 1600])} sizes="(max-width: 699px) 80px, 140px" width="1536" height="1024" loading="lazy" alt="Illustrative influencer speaking on a private phone call" /><strong>Influencer</strong></div>
        <figcaption>Two private calls. One conversation.</figcaption>
      </figure>
    </section>
    <div class="hfh-lanes" data-home-section="lanes">
      <section class="hfh-lane hfh-lane--women hfh-torn" id="women-only" aria-labelledby="women-title"><div class="hfh-lane-copy"><p class="hfh-eyebrow">Comfort in shared experiences</p><h2 id="women-title">Women talking to women</h2><p><strong>A private space</strong> for women to talk with verified women influencers.</p><p class="hfh-kyc" aria-describedby="community-eligibility"><svg class="modern-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 2 9 4v6c0 5-5 8-9 10-4-2-9-5-9-10V6Z"/><path d="m8 12 3 3 5-6"/></svg>Video KYC required</p><a class="hfh-button" href="/marketplace?lane=women#people" data-home-cta="women-hosts">Explore women influencers <span aria-hidden="true">→</span></a></div><div class="hfh-lane-art"><img src={publicImage(`${assets}women.webp`, { width: 640 })} srcset={publicImageSrcSet(`${assets}women.webp`, [420, 640, 900, 1280, 1600])} sizes="(max-width: 1023px) calc(100vw - 64px), (min-width: 1680px) 700px, 43vw" width="1536" height="1024" loading="lazy" alt="Two illustrative women sharing a warm conversation" /></div></section>
      <section class="hfh-lane hfh-lane--community hfh-torn" id="lgbtq" aria-labelledby="lgbtq-title"><div class="hfh-lane-copy"><p class="hfh-eyebrow">Come as you are</p><h2 id="lgbtq-title">Connect within the LGBTQ+ community</h2><p><strong>A respectful space</strong> for LGBTQ+ fans to talk with influencers from the community.</p><p class="hfh-kyc" aria-describedby="community-eligibility"><svg class="modern-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 2 9 4v6c0 5-5 8-9 10-4-2-9-5-9-10V6Z"/><path d="m8 12 3 3 5-6"/></svg>Video KYC required</p><a class="hfh-button" href="/marketplace?lane=lgbtq#people" data-home-cta="lgbtq-hosts">Explore LGBTQ+ influencers <span aria-hidden="true">→</span></a></div><div class="hfh-lane-art"><img src={publicImage(`${assets}community.webp`, { width: 640 })} srcset={publicImageSrcSet(`${assets}community.webp`, [420, 640, 900, 1280, 1600])} sizes="(max-width: 1023px) calc(100vw - 64px), (min-width: 1680px) 700px, 43vw" width="1536" height="1024" loading="lazy" alt="Two illustrative community members sharing a friendly conversation" /></div></section>
    </div>
    <p class="hfh-eligibility sr-only" id="community-eligibility">Video KYC verifies the person, not their gender or sexual orientation. Community access follows each space’s eligibility and safety rules.</p>
    <section class="hfh-how" id="how-it-works" aria-labelledby="how-title" data-home-section="how-it-works"><p class="hfh-eyebrow">Less scrolling. More talking.</p><h2 id="how-title">How it works</h2><ol class="hfh-steps"><li><span class="hfh-step-number">1</span><img class="hfh-step-art" src={publicImage(`${assets}step-choose-audio.webp`, { width: 640 })} srcset={publicImageSrcSet(`${assets}step-choose-audio.webp`, [420, 640, 900, 1280, 1600])} sizes="(max-width: 767px) calc(100vw - 80px), 30vw" width="1536" height="1024" loading="lazy" alt="Illustration of discovering creator profiles" /><div><h3>Choose an influencer</h3><p>Find the creators you follow<br class="hfh-reference-break"/> and like.</p></div></li><li><span class="hfh-step-number">2</span><img class="hfh-step-art" src={publicImage(`${assets}step-book-audio.webp`, { width: 640 })} srcset={publicImageSrcSet(`${assets}step-book-audio.webp`, [420, 640, 900, 1280, 1600])} sizes="(max-width: 767px) calc(100vw - 80px), 30vw" width="1536" height="1024" loading="lazy" alt="Illustration of starting a call with an influencer" /><div><h3>Start the call</h3><p>Tap Call. We ring the influencer first and ask if they will talk.</p></div></li><li><span class="hfh-step-number">3</span><img class="hfh-step-art" src={publicImage(`${assets}step-talk-audio.webp`, { width: 640 })} srcset={publicImageSrcSet(`${assets}step-talk-audio.webp`, [420, 640, 900, 1280, 1600])} sizes="(max-width: 767px) calc(100vw - 80px), 30vw" width="1536" height="1024" loading="lazy" alt="Illustration of two private audio calls connected phone to phone" /><div><h3>Talk privately</h3><p>If they accept, we call you<br class="hfh-reference-break"/> and merge the calls. You pay per minute at their rate.</p></div></li></ol></section>
    <section class="hfh-host-cta hfh-torn" id="earn" aria-labelledby="earn-title" data-home-section="host-cta"><div class="hfh-host-art"><img src={publicImage(`${assets}host.webp`, { width: 420 })} srcset={publicImageSrcSet(`${assets}host.webp`, [420, 640, 900, 1280, 1600])} sizes="(max-width: 767px) calc(100vw - 32px), (min-width: 1680px) 630px, 40vw" width="1536" height="1024" loading="lazy" alt="Illustrative influencer welcoming their audience" /></div><div class="hfh-host-copy"><p class="hfh-eyebrow">For the people behind the posts</p><h2 id="earn-title">Turn your audience into real conversations.</h2><p>Are you an influencer? Complete full KYC, create your page, set your per-minute rate, and share your link.</p><a class="hfh-button" href="/hosts/join" data-home-cta="apply-host">Apply to become an influencer <span aria-hidden="true">→</span></a><div class="hfh-share"><span>Your personal page</span><strong class="hfh-share-url">{identity.domain}/<wbr />yourname</strong></div></div></section>
  </main>
  <HelloFraandsFooter hideTagline />
  <nav class="mobile-bottom-nav" aria-label="Quick navigation">{[['home','#main-content','Home'],['grid','#people','Influencers'],['phone','#how-it-works','How'],['lock','#safety','Safety'],['user','#earn','Earn']].map(([icon,href,label]) => <a href={href}><ModernIcon name={icon}/><span>{label}</span></a>)}</nav>
</div>
<dialog id="preview-dialog" class="hfh-preview-dialog" aria-labelledby="preview-title" aria-describedby="preview-description"><h2 id="preview-title">Illustrative preview</h2><p id="preview-description">This sample profile is an illustration. No call or payment is made.</p><a class="hfh-button" href="/marketplace">Explore real influencers →</a><button type="button" data-close-preview autofocus>Close</button></dialog>
<script>import '../lib/hostFanHome';</script>
</body>
</html>
