---
export const prerender = true;
import brandConfig from '../../../Specs/brand.json';
import { publicImage } from '../lib/config';
import { moodGroups, moods, profiles } from '../lib/callvaalHomeReference';
import ModernIcon from '../components/home/ModernIcon.astro';
import '../styles/callvaal-notebook.css';
import ProfileCard from '../components/callvaal/ProfileCard.astro';
import HelloFraandsHeader from '../components/callvaal/Header.astro';
import HelloFraandsFooter from '../components/callvaal/Footer.astro';
import WomenOnlySection from '../components/callvaal/WomenOnlySection.astro';
import SafetySection from '../components/callvaal/SafetySection.astro';
import HomePrivacySteps from '../components/callvaal/HomePrivacySteps.astro';
const identity = brandConfig.homepageIdentity;
const title = `Baat karo. Dil halka karo. | ${identity.name}`;
const description = 'Talk to a real person in your language, right now. Your number stays private. Pay per minute. 18+.';
const canonical = `https://${identity.domain}/`;
---
<!doctype html>
<html lang="en-IN">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title><meta name="description" content={description} /><link rel="canonical" href={canonical} /><meta name="theme-color" content="#46113e" /><meta name="robots" content="index,follow" />
  <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'WebPage', name: title, description, url: canonical, inLanguage: 'en-IN' })} />
  <meta property="og:type" content="website" /><meta property="og:site_name" content={identity.name} /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} />
  <meta property="og:image" content={`${canonical}assets/callvaal/scrapbook/hero-collage-friendship.jpg`} /><meta property="og:image:alt" content={`${identity.name}: a man and woman on calls, a friendship checklist and everyday Indian keepsakes on colourful paper.`} />
  <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={`${canonical}assets/callvaal/scrapbook/hero-collage-friendship.jpg`} />
  <link rel="icon" href="/assets/callvaal/notebook/favicon.svg" type="image/svg+xml" />
  <link data-site-fonts rel="preload" href="/fonts/Comfortaa-Bold.ttf" as="font" type="font/ttf" crossorigin /><link rel="preload" href="/fonts/Nunito-Black.woff2" as="font" type="font/woff2" crossorigin />
</head>
<body>
<div class="notebook-site" data-design="callvaal-scrapbook">
  <a class="skip-link" href="#main-content">Skip to main content</a>
  <HelloFraandsHeader />
  <main id="main-content">
    <section class="notebook-hero" aria-labelledby="hero-title">
      <div class="hero-copy"><h1 id="hero-title">Baat karo.<br/><mark><em>Dil halka karo.</em></mark></h1><p class="hero-promise">Real people. Make a friend. Your number stays private.</p><p class="hero-subtitle">Someone to talk to in your language, right now — and someone to call again tomorrow. Pay per minute. Nobody sees your phone number.</p>
        <div class="hero-actions"><a class="hero-primary" href="#people">Kisi se baat karo</a><a class="hero-secondary" href="#earn">Earn by talking</a></div>
        <div class="trust-chips"><span><ModernIcon name="lock" />Number kabhi share nahi hota</span><span><ModernIcon name="user" />Har host video-KYC verified</span><span><ModernIcon name="clock" />From ₹5/min</span></div>
      </div>
      <div class="hero-art"><picture><source srcset="/assets/callvaal/scrapbook/hero-collage-friendship.avif" type="image/avif" /><source srcset="/assets/callvaal/scrapbook/hero-collage-friendship.webp" type="image/webp" /><img src="/assets/callvaal/scrapbook/hero-collage-friendship.jpg" alt="Terracotta, mustard and teal paper collage: a man and woman on calls, a handwritten Aaj kis se baat karein checklist with Neha, exam ki tension and bas baat, chai and everyday Indian keepsakes." fetchpriority="high" width="1254" height="1254" /></picture></div>
    </section>
    <aside class="service-disclaimer" aria-label="Service disclaimer">Yahan sirf baat hoti hai. No medical, legal or money advice. No miracles, no guaranteed results. Not a replacement for a doctor or counsellor. 18+ only.</aside>
    <section class="social-proof-section" aria-labelledby="social-proof-title">
      <div class="social-proof-heading"><div><p class="preview-kicker">Illustrative preview</p><h2 id="social-proof-title">Bharat bhar mein, <em>baat kaam ki.</em></h2></div></div>
      <div class="activity-preview">
        <div class="activity-preview-label"><strong>Sample activity</strong><span>Live updates coming later</span></div>
        <div class="activity-ticker" role="group" tabindex="0" aria-label="Illustrative sample activity from fictional people. Live activity updates are not available yet.">
          <div class="activity-track">
            <div class="activity-sequence">
              <span><b>Rohit from Pune</b> called Neha again · 4th call this week</span><span><b>Ananya from Guwahati</b> just talked to Priya · 32 min</span><span><b>Arjun from Kochi</b> called Sana again · 12 min</span><span><b>Meera from Jaipur</b> found a new dost · Kavya</span>
            </div>
            <div class="activity-sequence" aria-hidden="true">
              <span><b>Rohit from Pune</b> called Neha again · 4th call this week</span><span><b>Ananya from Guwahati</b> just talked to Priya · 32 min</span><span><b>Arjun from Kochi</b> called Sana again · 12 min</span><span><b>Meera from Jaipur</b> found a new dost · Kavya</span>
            </div>
          </div>
        </div>
      </div>
    </section>
    <section class="mood-section" id="moods" aria-labelledby="moods-title"><p class="preview-kicker">Find your kind of conversation</p><h2 id="moods-title">Aaj kya <em>mood hai?</em></h2>
      <div class="mood-grid">{moodGroups.map((group, index) => <div id={group === 'Naye dost' ? 'naye-dost' : undefined} class:list={['mood-group', `mood-group--${index + 1}`]}><div class="mood-group-head"><span class="mood-doodle" aria-hidden="true">{['❋','✳','✷','❖'][index]}</span><h3>{group}</h3></div><div class="mood-chips">{moods.filter(mood => mood.group === group).map(mood => <a class="mood-chip" href={`/?mood=${encodeURIComponent(mood.slug)}#people`}>{mood.label}<span aria-hidden="true">↗</span></a>)}</div>{group === 'Naye dost' && <p class="mood-note">Make a friend. Rules are the same for everyone — see <a href="#safety">Kaise safe hai</a>.</p>}{group === 'Tension' && <p class="crisis-note">If you're in crisis, call <a href="tel:14416">Tele-MANAS 14416</a> (free, 24×7) or <a href="tel:112">112</a>.</p>}{group === 'Zindagi ki baatein' && <p class="mood-note">Talk and share — not medical, legal or money advice.</p>}</div>)}</div>
    </section>
    <WomenOnlySection />
    <section class="home-privacy-band" id="privacy-note" aria-labelledby="privacy-title"><div class="home-privacy-frame">
      <span class="home-privacy-corner home-privacy-corner--top-left" aria-hidden="true">✦</span>
      <span class="home-privacy-corner home-privacy-corner--top-right" aria-hidden="true">✦</span>
      <span class="home-privacy-corner home-privacy-corner--bottom-left" aria-hidden="true">✦</span>
      <span class="home-privacy-corner home-privacy-corner--bottom-right" aria-hidden="true">✦</span>
      <h2 id="privacy-title">Aapka number. <em>Sirf aapka.</em></h2><p class="privacy-intro">Neither person sees the other’s personal phone number.</p>
      <HomePrivacySteps />
      <div class="home-privacy-notes"><div class="paper-note">Number private.<br/>Baat apni.</div><div class="paper-note">People.<br/>Conversations.<br/>A brighter you.</div></div><p class="home-privacy-bottom">No need to exchange personal numbers.<br/><button type="button" data-preview-action="privacy" data-preview-label="Number privacy">Learn about number privacy →</button></p>
    </div></section>
    <SafetySection />
    <section class="people-section" id="people" aria-labelledby="people-title"><p class="preview-kicker">Sample profiles · Illustrative</p><h2 id="people-title">Apna dost dhundo.<em>Aur kal phir call karo.</em></h2>
      <div class="people-toolbar"><div class="people-filters"><button type="button" class="filter-all" data-reset-filters>All</button><label for="mood-filter">Mood</label><select id="mood-filter"><option value="">All moods</option>{moods.map(mood => <option value={mood.slug}>{mood.label}</option>)}</select><label for="language-filter">Language</label><select id="language-filter"><option value="">Any language</option>{['Hindi','English','Kannada','Marathi'].map(language => <option>{language}</option>)}</select><label for="price-filter">Price</label><select id="price-filter"><option value="">Any price</option>{[5,20,25,30].map(value => <option value={value}>₹{value}/min or less</option>)}</select><label class="online-toggle"><input id="online-filter" type="checkbox" /> Online now</label></div><button class="view-all" type="button" data-reset-filters>View all people →</button></div>
      <p class="sr-only" data-favourites-status role="status" aria-live="polite"></p>
      <p class="selected-category-label" data-selected-mood-label hidden></p><p class="sample-label">Sample profiles · Illustrative names, KYC badges, ratings, conversation counts and prices</p><p class="sr-only" id="filter-status" role="status" aria-live="polite"></p>
      <div class="people-grid">{profiles.map(profile => <ProfileCard profile={profile} />)}</div>
      <div class="no-results" hidden><p>No sample profiles match those filters.</p><button type="button" data-reset-filters>Show all sample profiles</button></div><p class="profile-disclosure">All profiles, video-KYC badges, ratings and conversation counts shown here are illustrative. Availability, regulars, hours and conversation styles are samples too. Voice introductions are coming soon. Calls and payments are unavailable in this preview.</p>
    </section>
    <section class="earn-section" id="earn" aria-labelledby="earn-title"><img class="earn-art" src={publicImage('/assets/callvaal/scrapbook/earn-art-moods.png', { width: 900 })} alt="Torn-paper notebook with phone conversation doodles, pencil and chai" loading="lazy" width="1254" height="1254" /><div class="earn-copy"><h2 id="earn-title">Baatein karo. <em>Paise kamao.</em></h2><p>Good on the phone? Set your rate and talk from home on your own hours. At a ₹5/min caller rate, the planned host share is ₹1.80/min before tax; paid calls are not guaranteed. Your number stays private. You can end and report an abusive call, and confirmed abuse can lead to a ban.</p><p>Good hosts build regulars — people who call them every week. Regulars are where the steady earnings are.</p><ol class="earn-steps"><li><ModernIcon name="user" /><span>Sign up with WhatsApp OTP</span></li><li><ModernIcon name="lock" /><span>Video KYC + Aadhaar</span></li><li><ModernIcon name="clock" /><span>Pick your moods, languages and price</span></li><li><ModernIcon name="tax" /><span>Go online, get paid via UPI</span></li><li><ModernIcon name="user" /><span>Keep your regulars coming back</span></li></ol><button type="button" class="join-button" data-preview-action="join">Join &amp; earn →</button></div><div class="earn-note paper-note">More conversations.<br/>A brighter tomorrow.</div></section>
    <aside class="phone-strip">Planned for launch: no app needed. Calls will come to your normal number.</aside>
  </main>
  <HelloFraandsFooter />
  <nav class="mobile-bottom-nav" aria-label="Quick navigation">{[['home','#main-content','Home'],['grid','#moods','Moods'],['user','#people','People'],['lock','#safety','Safety'],['tax','#earn','Earn']].map(([icon,href,label]) => <a href={href}><ModernIcon name={icon}/><span>{label}</span></a>)}</nav>
</div>
<dialog id="preview-dialog" aria-labelledby="preview-title" aria-describedby="preview-description"><h2 id="preview-title">Preview only</h2><p id="preview-description">Calls and joining are not available yet.</p><button type="button" data-close-preview>Close</button></dialog>
<script>import '../lib/notebookHome';</script>
</body>
</html>
