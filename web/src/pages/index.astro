---
// [HF-DESI-HOME-1 2026-10-17] Owner-approved desi homepage (was a separate test site, hellofraands-desi.pages.dev).
// The body is GENERATED from web/design/desi-home.source.html by scripts/build-desi-home.py; the header and
// footer are the shared components, so every menu link is the real one and matches Explore.
export const prerender = true;
import brandConfig from '../../../Specs/brand.json';
import Header from '../components/callvaal/Header.astro';
import Footer from '../components/callvaal/Footer.astro';
import { shareImage, publicImage, publicImageSrcSet, ARTWORK_QUALITY } from '../lib/config';
import { HF_PLAY_URL } from '../lib/hfApp';
import desiBody from '../components/home/desi-home-body.html?raw';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import sharp from 'sharp';
import '../styles/desi-home.css';
import '../styles/desi-home-chrome.css';
const identity = brandConfig.homepageIdentity;
const title = `From reels. To real talks. | ${identity.name}`;
const description = 'Discover your favorite creators and book a private conversation. We call you both and connect the conversation, with both phone numbers kept private.';
const canonical = `https://${identity.domain}/`;
const ogImage = shareImage('/assets/hf-desi/hero-rickshaw-woman.webp');
// Every artwork goes through the Cloudflare image pipeline (AVIF, bounded widths, never upscaled).
const publicDir = resolve(process.cwd(), 'public'); // astro build always runs from web/
const naturalWidth = async (path: string) => (await sharp(readFileSync(publicDir + path)).metadata()).width ?? 900;
const opts = { quality: ARTWORK_QUALITY, fit: 'scale-down' };
const candidates = (w: number) => [420, 640, 900, 1280, 1600].filter(c => c <= w).concat(w < 420 ? [420] : []);
let body = desiBody.replaceAll('__HF_PLAY_URL__', HF_PLAY_URL).replaceAll('__BRAND_NAME__', identity.name);
const paths = [...new Set([...body.matchAll(/src="(\/assets\/hf-desi\/[a-z0-9-]+\.webp)"/g)].map(m => m[1]))];
let index = 0;
for (const path of paths) {
  const widths = candidates(await naturalWidth(path));
  const eager = index++ < 2; // the hero sticker and hero art are above the fold
  const attrs = `src="${publicImage(path, { ...opts, width: widths[widths.length - 1] })}" srcset="${publicImageSrcSet(path, widths, opts)}" sizes="(min-width: 900px) 50vw, 100vw" decoding="async"${eager ? ' fetchpriority="high"' : ' loading="lazy"'}`;
  body = body.replaceAll(`src="${path}"`, attrs);
}
const bgArt = { 'toran-marigold': 1400, 'border-strip': 1400, 'block-print-tile': 420, 'warli-friends': 1400 } as const;
const bgCss = ':root{' + Object.entries(bgArt).map(([name, width]) => `--dh-${name}:url(${publicImage(`/assets/hf-desi/${name}.webp`, { ...opts, width })})`).join(';') + '}';
---
<!doctype html>
<html lang="en-IN">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title><meta name="description" content={description} /><link rel="canonical" href={canonical} /><meta name="theme-color" content="#fffdf7" /><meta name="robots" content="index,follow" />
  <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'WebPage', name: title, description, url: canonical, inLanguage: 'en-IN' })} />
  <meta property="og:type" content="website" /><meta property="og:site_name" content={identity.name} /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} /><meta property="og:image:alt" content="A truck-art auto rickshaw with a smiling woman driver waving." />
  <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={ogImage} />
  <link rel="icon" href="/assets/branding/hf-favicon.png" type="image/png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Comfortaa:wght@500;700&family=Nunito:wght@400;600;700;800&display=swap" />
  <style is:inline set:html={bgCss}></style>
</head>
<body class="desi-home-page">
<div class="hf desi-home" data-desi-home>
  <a class="skip-link" href="#main-content">Skip to main content</a>
  <Header homeReference />
  <Fragment set:html={body} />
  <Footer />
</div>
<script>
  import { capture } from '../lib/analytics';
  document.querySelectorAll<HTMLAnchorElement>('[data-home-cta]').forEach(link => link.addEventListener('click', () => capture('homepage_cta_click', { surface: 'desi-home', cta: link.dataset.homeCta, href: link.getAttribute('href') })));
  capture('homepage_impression', { surface: 'desi-home', design: 'desi-home-v1' });
  document.documentElement.dataset.homepageReady = 'true';
</script>
</body>
</html>
