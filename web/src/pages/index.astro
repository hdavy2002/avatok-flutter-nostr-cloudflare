---
export const prerender = true;
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import FolkArtwork from '../components/FolkArtwork.astro';
import FolkIcon from '../components/FolkIcon.astro';
import { publicImage } from '../lib/config';
import '../styles/saathum-folk.css';

const categories = [
  { label: 'Puja & Archana', term: 'Puja', icon: 'puja', note: 'A little everyday devotion' },
  { label: 'Aarti & Darshan', term: 'Aarti', icon: 'aarti', note: 'Light up your evening' },
  { label: 'Bhajan & Kirtan', term: 'Bhajan', icon: 'bhajan', note: 'Songs for the soul' },
  { label: 'Satsang', term: 'Satsang', icon: 'satsang', note: 'Wisdom, shared together' },
  { label: 'Festivals', term: 'Festival', icon: 'festival', note: 'Celebrate, wherever you are' },
  { label: 'Yoga & Meditation', term: 'Yoga', icon: 'yoga', note: 'Make room for stillness' },
] as const;
const moments = [
  { title: 'An evening by the Ganga', label: 'Aarti & Darshan', term: 'Aarti', icon: 'aarti', copy: 'The glow of diyas. The sound of bells. A familiar feeling, wherever you call home.', detail: 'A moment of devotion' },
  { title: 'Morning puja, from home', label: 'Puja & Archana', term: 'Puja', icon: 'puja', copy: 'Begin with a prayer, a quiet intention, and a little space for what matters.', detail: 'A meaningful beginning' },
  { title: 'Bhajans that bring us together', label: 'Bhajan & Kirtan', term: 'Bhajan', icon: 'bhajan', copy: 'Familiar melodies and voices coming together. Some things always feel like home.', detail: 'A song to share' },
] as const;
const search = (term: string) => '/marketplace?q=' + encodeURIComponent(term);
---
<Base title="Saathum | Live pujas, satsangs and spiritual experiences"
  description="Live pujas, aartis and satsangs from India. Share the moments that bring you home. Explore spiritual experiences, book your place and join live."
  image={publicImage('/assets/saathum-folk/hero.png', { width: 1280, fit: 'scale-down', format: 'jpeg' })}
  imageAlt="Saathum Rajasthani folk art: an ornate elephant, sacred cow and deer in saffron, rose and gold."
  chrome={false} indiaLandingLanguage={false}>
  <Fragment slot="head">
    <meta name="theme-color" content="#fff6e6" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&display=swap" />
  </Fragment>
  <div class="folk-site" data-design="saathum-rajasthani-stickers-v1">
    <a class="folk-skip" href="#main-content">Skip to main content</a>
    <div class="folk-ribbon" aria-hidden="true"><span>✿</span><span>✧</span><span>✿</span><span>✧</span><span>✿</span><span>✧</span><span>✿</span><span>✧</span><span>✿</span><span>✧</span><span>✿</span><span>✧</span><span>✿</span><span>✧</span><span>✿</span></div>
    <SiteHeader folk indiaLandingLanguage={false} responsiveHome />
    <main id="main-content">
      <section class="folk-hero folk-wrap" aria-labelledby="folk-title" data-home-section="hero">
        <div class="folk-hero-copy">
          <p class="folk-eyebrow"><span aria-hidden="true">✦</span> LIVE FROM INDIA · JOIN FROM ANYWHERE</p>
          <h1 id="folk-title">Close to your roots.<br /><em>Wherever you are.</em></h1>
          <p class="folk-lead">Live pujas, aartis and satsangs.<br />A little closer to home. A little closer to each other.</p>
          <div class="folk-actions">
            <a class="folk-button" href="/marketplace" data-home-cta="hero-explore-events">Explore events <span aria-hidden="true">↗</span></a>
            <a class="folk-text-link" href="#experiences" data-home-cta="hero-browse-experiences">Find your experience <span aria-hidden="true">→</span></a>
          </div>
          <p class="folk-handnote">Different places. Same devotion.</p>
        </div>
        <div class="folk-hero-art s-hero-art">
          <span class="folk-seal"><span aria-hidden="true">✦</span> ROOTED IN INDIA<br />SHARED WITH LOVE</span>
          <FolkArtwork name="hero" eager sizes="(max-width: 760px) 94vw, 58vw" alt="White-bordered Rajasthani folk-art stickers of a decorated elephant, cow and deer among lotus flowers and temple motifs." />
          <span class="folk-art-note">a little piece of home</span>
        </div>
      </section>
      <div class="folk-divider" aria-hidden="true"><span>✽</span><span>✽</span><span>✽</span></div>
      <section class="folk-experiences folk-wrap" id="experiences" aria-labelledby="folk-experiences-title" data-home-section="experiences">
        <div class="folk-section-heading"><div><p class="folk-eyebrow">MANY PATHS. ONE FEELING.</p><h2 id="folk-experiences-title">Find your spiritual moment</h2></div><span class="folk-side-note">What brings you closer?</span></div>
        <div class="folk-category-grid">
          {categories.map(category => <a class={'folk-category folk-category--' + category.icon} href={search(category.term)} data-home-cta={'experience-' + category.term.toLowerCase()}>
            <FolkIcon kind={category.icon} /><h3>{category.label}</h3><p>{category.note}</p><span class="folk-circle-arrow" aria-hidden="true">↗</span>
          </a>)}
        </div>
      </section>
      <section class="folk-moments" id="home-events" aria-labelledby="folk-moments-title" data-home-section="home_events">
        <div class="folk-wrap">
          <div class="folk-section-heading"><div><p class="folk-eyebrow">SAVE A LITTLE TIME FOR THE SOUL</p><h2 id="folk-moments-title">Moments to look forward to</h2></div><a class="folk-text-link" href="/marketplace" data-home-cta="all-events">View all events <span aria-hidden="true">→</span></a></div>
          <div class="folk-moment-grid">
            {moments.map((moment, i) => <article class={'folk-moment folk-moment--' + i}>
              <a class="folk-moment-art" href={search(moment.term)} aria-label={moment.title + ' — explore ' + moment.label} data-home-cta={'moment-' + moment.term.toLowerCase()}>
                <span class="folk-sample-label">Sample event</span>
                <div class="folk-arch"><span class="folk-arch-star" aria-hidden="true">✦</span><FolkIcon kind={moment.icon} /><span class="folk-arch-petals" aria-hidden="true">✿ &nbsp; ✽ &nbsp; ✿</span></div>
                <span class="folk-event-stamp">{moment.detail}</span>
              </a>
              <div class="folk-moment-copy"><p class="folk-eyebrow">{moment.label}</p><h3><a href={search(moment.term)}>{moment.title}</a></h3><p>{moment.copy}</p><a class="folk-text-link" href={search(moment.term)} data-home-cta={'sample-explore-' + moment.term.toLowerCase()}>Explore experiences <span aria-hidden="true">↗</span></a></div>
            </article>)}
          </div>
          <p class="folk-editorial-note">A taste of the experiences you can discover. Browse the marketplace for current events and availability.</p>
          <noscript><p><a href="/marketplace">Browse all events</a> and book your place.</p></noscript>
        </div>
      </section>
      <section class="folk-belonging folk-wrap" id="benefits" aria-labelledby="folk-benefits-title" data-home-section="benefits">
        <div class="folk-belonging-art"><FolkArtwork name="rituals" alt="Rajasthani devotional stickers with a brass diya, bells, lotus and traditional musical instruments." /><span class="folk-art-note">familiar rituals, new memories</span></div>
        <div class="folk-belonging-copy"><p class="folk-eyebrow">HOME IS A FEELING</p><h2 id="folk-benefits-title">Far from home.<br /><em>Close to your traditions.</em></h2><p>Familiar voices, shared rituals, meaningful moments. Make space for the traditions you love, with people who feel the same.</p><a class="folk-text-link" href="/marketplace" data-home-cta="benefits-explore">Find your next moment <span aria-hidden="true">→</span></a></div>
      </section>
      <section class="folk-joining folk-wrap" id="joining" aria-labelledby="folk-joining-title" data-home-section="joining">
        <div class="folk-centered"><p class="folk-eyebrow">A FEW LITTLE STEPS. A LOT OF CONNECTION.</p><h2 id="folk-joining-title">Your place is waiting.</h2></div>
        <ol class="folk-step-grid" aria-label="How to join a live event">
          <li><FolkIcon kind="search" /><div><span class="folk-step-number">01 / EXPLORE</span><h3>Follow your feeling</h3><p>Discover an experience that speaks to you.</p><a href="/marketplace" class="folk-text-link" data-home-cta="joining-explore">Explore events →</a></div></li>
          <li><FolkIcon kind="ticket" /><div><span class="folk-step-number">02 / BOOK</span><h3>Make it a date</h3><p>Choose your event and book your place online.</p><a href="/help/booking-and-paying/find-a-creator-or-show" class="folk-text-link" data-home-cta="joining-book">How to book →</a></div></li>
          <li><FolkIcon kind="live" /><div><span class="folk-step-number">03 / JOIN LIVE</span><h3>Come as you are</h3><p>Join from wherever you are. Feel a little closer.</p><a href="/help/booking-and-paying/join-a-live-show" class="folk-text-link" data-home-cta="joining-help">Joining an event →</a></div></li>
        </ol>
      </section>
      <section class="folk-organise folk-wrap" id="organise-invite" aria-labelledby="folk-organise-title" data-home-section="organise_invite">
        <div class="folk-organise-panel"><div><p class="folk-eyebrow">FOR THE ONES WHO BRING US TOGETHER</p><h2 id="folk-organise-title">Bring your community together.</h2><p>Host a spiritual experience on Saathum.<br />Share your traditions with people near and far.</p><a class="folk-button" href="/organisers" data-home-cta="organise-invite">Become an organiser <span aria-hidden="true">↗</span></a></div><div class="folk-chai"><FolkArtwork name="chai" alt="A glass of cutting chai decorated with warm-colored flowers, as a white-bordered folk-art sticker." /><span class="folk-handnote">Good things begin over chai.</span></div></div>
      </section>
      <p class="folk-booking-note folk-wrap">Saathum is a marketplace where event organisers sell tickets to live online spiritual events. Attendees book and pay online; refunds follow our <a href="/refunds">published policy</a>.</p>
    </main>
    <SiteFooter folk indiaLandingLanguage={false} />
  </div>
  <script>import '../lib/railwayHome';</script>
</Base>
