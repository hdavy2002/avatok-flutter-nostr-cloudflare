---
export const prerender = true;
import Base from '../layouts/Base.astro';
import OriginalArtwork from '../components/OriginalArtwork.astro';
import { publicImage } from '../lib/config';
import '../styles/saathum-replica.css';

const categories = [
  { label: 'Puja & Archana', term: 'Puja', box: [34, 553, 168, 148] },
  { label: 'Aarti & Darshan', term: 'Aarti', box: [209, 553, 169, 148] },
  { label: 'Bhajan & Kirtan', term: 'Bhajan', box: [385, 553, 173, 148] },
  { label: 'Satsang', term: 'Satsang', box: [565, 553, 171, 148] },
  { label: 'Festivals', term: 'Festival', box: [743, 553, 170, 148] },
  { label: 'Yoga & Meditation', term: 'Yoga', box: [921, 553, 168, 148] },
];
const moments = [
  { title: 'An evening by the Ganga', label: 'Aarti & Darshan', term: 'Aarti', box: [40, 807, 340, 176] },
  { title: 'Morning puja, from home', label: 'Puja & Archana', term: 'Puja', box: [395, 807, 330, 176] },
  { title: 'Bhajans that bring us together', label: 'Bhajan & Kirtan', term: 'Bhajan', box: [742, 807, 342, 176] },
];
const search = (term: string) => '/marketplace?q=' + encodeURIComponent(term);
---
<Base title="Saathum | Live pujas, satsangs and spiritual experiences"
  description="Live pujas, aartis and satsangs from India. Share the moments that bring you home. Explore spiritual experiences, book your place and join live."
  image={publicImage('/assets/saathum-reference/approved-homepage.png', { width: 1280, fit: 'scale-down', format: 'jpeg' })}
  imageAlt="Saathum: live spiritual experiences with Indian peacock, elephant and lotus artwork."
  imageWidth={1122} imageHeight={1402} chrome={false} indiaLandingLanguage={false}>
  <Fragment slot="head">
    <meta name="theme-color" content="#faf6ea" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&display=swap" />
    <link rel="preload" as="image" href={publicImage('/assets/saathum-reference/approved-homepage.png', { width: 1280, fit: 'scale-down' })} />
  </Fragment>
  <a class="s-skip" href="#main-content">Skip to main content</a>
  <div class="s-home" data-design="saathum-reference-2026-09-22">
    <OriginalArtwork box={[0, 0, 1122, 20]} class="s-top-border" eager />
    <header class="s-header">
      <a class="s-brand" href="/" aria-label="Saathum home">
        <OriginalArtwork box={[50, 30, 45, 36]} eager /><span>Saathum</span>
      </a>
      <nav class="s-desktop-nav" aria-label="Main navigation">
        <a href="/marketplace" data-home-cta="nav-explore">Explore events</a>
        <a href="#experiences" data-home-cta="nav-experiences">Experiences</a>
        <a href="#joining" data-home-cta="nav-joining">How it works</a>
      </nav>
      <div class="s-header-actions">
        <a href="/sign-in" class="s-sign-in" data-home-cta="nav-sign-in">Sign in</a>
        <a href="/organisers" class="s-button s-button--small" data-home-cta="nav-organiser">Become an organiser</a>
        <button class="s-menu" aria-controls="avh-drawer" aria-expanded="false" aria-label="Open menu" type="button"><span aria-hidden="true">☰</span></button>
      </div>
    </header>
    <dialog id="avh-drawer" class="s-drawer" aria-labelledby="s-menu-title">
      <div class="s-drawer-heading"><h2 id="s-menu-title">Saathum</h2><button type="button" aria-label="Close menu">×</button></div>
      <nav aria-label="Mobile navigation">
        <a href="/marketplace">Explore events</a><a href="#experiences">Experiences</a><a href="#joining">How it works</a>
        <a href="/organisers">Become an organiser</a><a href="/sign-in">Sign in</a><a href="/sign-up">Create an account</a><a href="/help">Help</a>
      </nav>
    </dialog>
    <main id="main-content">
      <section class="s-hero" aria-labelledby="s-title" data-home-section="hero">
        <OriginalArtwork box={[677, 20, 218, 55]} class="s-arch-crown" eager />
        <div class="s-hero-copy">
          <p class="s-eyebrow">LIVE FROM INDIA · JOIN FROM ANYWHERE</p>
          <h1 id="s-title">Close to your roots.<br /><span>Wherever you are.</span></h1>
          <p class="s-hero-description">Live pujas, aartis and satsangs. Share the moments<br class="s-desktop-break" /> that bring you home.</p>
          <div class="s-hero-actions">
            <a class="s-button" href="/marketplace" data-home-cta="hero-explore-events">Explore events <span aria-hidden="true">→</span></a>
            <a class="s-text-link" href="#experiences" data-home-cta="hero-browse-experiences">Find your experience</a>
          </div>
        </div>
        <OriginalArtwork box={[515, 75, 607, 403]} class="s-hero-art" eager />
        <OriginalArtwork box={[0, 367, 513, 112]} class="s-diya-art" eager />
      </section>
      <OriginalArtwork box={[0, 479, 1122, 21]} class="s-floral-divider" />
      <section class="s-experiences" id="experiences" aria-labelledby="s-experiences-title" data-home-section="experiences">
        <h2 class="s-centered-title" id="s-experiences-title"><span aria-hidden="true">❧</span> Find your spiritual moment <span aria-hidden="true">❧</span></h2>
        <div class="s-category-grid">
          {categories.map((category) => (
            <a class="s-category" href={search(category.term)} data-home-cta={'experience-' + category.term.toLowerCase()}>
              <OriginalArtwork box={category.box as [number, number, number, number]} />
              <span class="s-category-label">{category.label}<span class="s-circle-arrow" aria-hidden="true">→</span></span>
            </a>
          ))}
        </div>
      </section>
      <OriginalArtwork box={[0, 747, 1122, 12]} class="s-gold-divider" />
      <section class="s-moments" id="home-events" aria-labelledby="s-moments-title" data-home-section="home_events">
        <div class="s-section-heading"><h2 id="s-moments-title"><span aria-hidden="true">❧</span> Moments to look forward to</h2><a class="s-text-link" href="/marketplace" data-home-cta="all-events">View all events <span aria-hidden="true">→</span></a></div>
        <div class="s-moment-grid">
          {moments.map((moment) => (
            <article class="s-moment">
              <a href={search(moment.term)} data-home-cta={'moment-' + moment.term.toLowerCase()} class="s-moment-image" aria-label={moment.title + ' — explore ' + moment.label}>
                <OriginalArtwork box={moment.box as [number, number, number, number]} />
                <span class="s-sample-label">Sample event</span>
              </a>
              <h3><a href={search(moment.term)}>{moment.title}</a></h3>
              <p>{moment.label}</p>
              <a class="s-text-link" href={search(moment.term)} data-home-cta={'sample-explore-' + moment.term.toLowerCase()}>Explore <span aria-hidden="true">→</span></a>
            </article>
          ))}
        </div>
        <noscript><p class="s-noscript"><a href="/marketplace">Browse all events</a> and book your place.</p></noscript>
      </section>
      <section class="s-belonging" id="benefits" aria-labelledby="s-benefits-title" data-home-section="benefits">
        <OriginalArtwork box={[0, 1057, 466, 165]} class="s-family-art" />
        <div class="s-belonging-copy"><h2 id="s-benefits-title">Far from home.<br /> Close to your traditions.</h2><p>Familiar voices, shared rituals, meaningful moments.</p></div>
        <ol class="s-steps" id="joining" aria-label="How to join a live event">
          <li><a href="/marketplace" data-home-cta="joining-explore"><svg viewBox="0 0 32 32" aria-hidden="true"><circle cx="13" cy="13" r="8" /><path d="m19 19 8 8" /></svg><span>01</span>Explore</a></li>
          <li><a href="/help/booking-and-paying/find-a-creator-or-show" data-home-cta="joining-book"><svg viewBox="0 0 32 32" aria-hidden="true"><rect x="5" y="7" width="22" height="21" rx="2" /><path d="M10 3v8m12-8v8M5 15h22m-16 5h3m4 0h3" /></svg><span>02</span>Book</a></li>
          <li><a href="/help/booking-and-paying/join-a-live-show" data-home-cta="joining-help"><svg viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="3" /><path d="M10 8a10 10 0 0 0 0 16m12-16a10 10 0 0 1 0 16M6 3a17 17 0 0 0 0 26M26 3a17 17 0 0 1 0 26" /></svg><span>03</span>Join live</a></li>
        </ol>
      </section>
      <section class="s-organise" id="organise-invite" aria-labelledby="s-organise-title" data-home-section="organise_invite">
        <OriginalArtwork box={[0, 1225, 285, 83]} class="s-elephant-left" />
        <div><h2 id="s-organise-title">Bring your community together.</h2><p>Host a spiritual experience on Saathum.</p></div>
        <a class="s-button" href="/organisers" data-home-cta="organise-invite">Become an organiser <span aria-hidden="true">→</span></a>
        <OriginalArtwork box={[815, 1225, 307, 83]} class="s-elephant-right" />
      </section>
      <OriginalArtwork box={[0, 1305, 1122, 10]} class="s-gold-divider" />
    </main>
    <footer class="s-footer bazaar-footer">
      <a class="s-brand" href="/" aria-label="Saathum home"><OriginalArtwork box={[40, 1325, 36, 30]} /><span>Saathum</span></a>
      <nav aria-label="Footer navigation"><a href="/about">About</a><span aria-hidden="true">·</span><a href="/help">Help</a><span aria-hidden="true">·</span><a href="/terms">Terms</a><span aria-hidden="true">·</span><a href="/refunds">Refund policy</a></nav>
      <details class="s-footer-details"><summary>About booking</summary><p>Saathum is a marketplace where event organisers sell tickets to live online spiritual events. Attendees book and pay online; refunds follow our <a href="/refunds">published policy</a>. Illustrative sample events above link to experience searches; current availability is shown in the marketplace.</p><a href="/pricing-fees">Organiser fees</a><span> · </span><a href="/privacy">Privacy</a><div class="s-legal-links">{[['/cookies','Cookies'],['/marketplace-terms','Marketplace terms'],['/consultation-terms','Session terms'],['/acceptable-use','Acceptable use'],['/recording','Recording'],['/biometric-retention','Biometric retention'],['/dmca','Copyright'],['/community-guidelines','Community guidelines'],['/child-safety','Child safety'],['/grievance','Grievance'],['/contact','Contact'],['/tokens','Tokens'],['/terms#status','Company status']].map(([href,label]) => <a href={href}>{label}</a>)}</div></details>
      <span class="s-footer-motto">A MORE<br />DEVOTED<br />WORLD</span>
    </footer>
    <OriginalArtwork box={[0, 1370, 1122, 32]} class="s-bottom-border" />
  </div>
  <script>
    import '../lib/railwayHome';
    import { capture } from '../lib/analytics';
    document.querySelectorAll<HTMLAnchorElement>('.s-footer a, .s-drawer a').forEach(link => {
      link.addEventListener('click', () => capture('nav_click', { route: 'homepage', design: 'saathum-reference-2026-09-22', location: link.closest('footer') ? 'footer' : 'mobile-menu', destination: link.getAttribute('href') }));
    });
    const drawer = document.querySelector<HTMLDialogElement>('#avh-drawer');
    const toggle = document.querySelector<HTMLButtonElement>('[aria-controls="avh-drawer"]');
    toggle?.addEventListener('click', () => { drawer?.showModal(); toggle.setAttribute('aria-expanded', 'true'); });
    drawer?.querySelector('[aria-label="Close menu"]')?.addEventListener('click', () => drawer.close());
    drawer?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => drawer.close()));
    drawer?.addEventListener('close', () => { toggle?.setAttribute('aria-expanded', 'false'); toggle?.focus(); });
    drawer?.addEventListener('click', event => { if (event.target === drawer) { const rect = drawer.getBoundingClientRect(); if (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom) drawer.close(); } });
  </script>
</Base>

