---
export const prerender = true;
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { creatorIdeas, formats, topics } from '../lib/creatorIdeas';
import '../styles/railway-home.css';
import '../styles/india-additions.css';
import CreatorIdeas from '../components/india-preview/CreatorIdeas.astro';
import BookingExpress from '../components/india-preview/BookingExpressIllustrated.astro';
import EarningsCalculator from '../components/india-preview/EarningsCalculatorIllustrated.astro';
import { publicImage, publicImageSrcSet } from '../lib/config';

const ideas = creatorIdeas.slice(0, 6);
const heroPath = '/assets/home/avatok-creator-constellation.png';
// The 1280 cache bucket is capped by scale-down at the source's real 1156px.
const heroSrcSet = `${publicImageSrcSet(heroPath, [420, 640, 900], { fit: 'scale-down' })}, ${publicImage(heroPath, { width: 1280, fit: 'scale-down' })} 1156w`;
const heroSizes = '(max-width:699px) 90vw, 46vw';

---
<Base
  title="avaTOK — Apna hunar. Apni kamaai."
  description="Turn your skills into live events, 1:1 sessions and small-group classes. Create your listing, set your price, and start your show on avaTOK."
  image={publicImage('/og/avatok-creator-marketplace-share.jpg', { format: 'jpeg', quality: 75, width: 1200, fit: 'scale-down' })}
  imageAlt="An avaTOK creator hosting a live session, with the words Apna hunar. Apni kamaai."
  imageWidth={1200}
  imageHeight={626}
  chrome={false}
  lang="hi-Latn"
>
  <Fragment slot="head">
    <meta property="og:image:type" content="image/jpeg" />
    <meta name="theme-color" content="#f7ead5" />
    <link rel="preload" as="image" href={publicImage(heroPath, { width: 900, fit: 'scale-down' })} imagesrcset={heroSrcSet} imagesizes={heroSizes} />
  </Fragment>
  <a class="rail-skip" href="#ideas-catalogue">Skip to earning ideas</a>
  <SiteHeader indiaLandingLanguage={false} />
  <main class="rail-home" data-design="creator-marketplace-2026-09" id="main-content">
    <section class="station-hero creator-hero" aria-labelledby="rail-title">
      <div class="creator-hero__frame">
        {/* Hero copy is visible from the first CSS paint. */}
        <div class="station-copy creator-hero__copy t-stagger" id="hero-reveal">
          <p class="station-kicker creator-hero__kicker"><span aria-hidden="true"></span> A global creator marketplace</p>
          <h1 id="rail-title" class="t-stagger-line"><span class="creator-hero__line">Apna hunar.</span><span class="creator-hero__line creator-hero__line--accent">Apni kamaai.</span></h1>
          <p class="t-stagger-line t-stagger-line--2">Jo aata hai, usse kamao. Host a live event, offer your time 1:1, or teach a small group—<strong>on your terms, at your price.</strong></p>
          <div class="station-actions">
            <a class="rail-button" href="/sign-up" data-home-cta="hero-create">Start earning free</a>
            <a class="station-outline" href="/ideas" data-home-cta="hero-ideas">Explore ideas</a>
          </div>
          <div class="creator-hero__formats" aria-label="Ways to earn on AvaTOK">
            <a href="/marketplace?group=india_goes_live" data-home-cta="hero-live">Live events</a>
            <a href="/marketplace?group=find_your_people" data-home-cta="hero-private">Private 1:1</a>
            <a href="/marketplace?group=book_their_time" data-home-cta="hero-group">Group sessions</a>
          </div>
        </div>
        <div class="station-art creator-hero__art">
            <span class="creator-hero__live" aria-hidden="true">● Live around the world</span>
          <img src={publicImage(heroPath, { width: 900, fit: 'scale-down' })} srcset={heroSrcSet} sizes={heroSizes} width="1156" height="1360" alt="Creators hosting a live stream, teaching a class, and offering a one-to-one conversation online." fetchpriority="high" decoding="async" />
          <p class="creator-hero__share"><strong>80%</strong><span>you keep</span></p>
        </div>
      </div>
      <a class="rail-next" href="#ideas-catalogue">Find your first earning idea <span aria-hidden="true">↓</span></a>
    </section>

    <BookingExpress />

    <section class="rail-ideas rail-wrap" id="ideas-catalogue" aria-labelledby="ideas-title" data-home-section="ideas">
      <p class="rail-eyebrow rail-flowered"><img src={publicImage('/ornament-flower.png', { width: 96 })} alt="" width="28" height="28" /> Kya offer karoge? <img src={publicImage('/ornament-flower.png', { width: 96 })} alt="" width="28" height="28" /></p>
      <h2 id="ideas-title">Isse bhi <span>kamaa sakte ho?</span></h2>
      <p class="rail-section-copy">A few ideas to get your first listing started.</p>
      <div class="rail-idea-grid">
        {ideas.map((idea) => (
          <article class="idea-card rail-article-card">
            <a class="idea-card-link" href={idea.href} aria-labelledby={`${idea.id}-title`} data-home-idea={idea.id}>
              <div class="idea-picture"><img src={publicImage(idea.image, { width: 640, fit: 'scale-down' })} srcset={publicImageSrcSet(idea.image, [420, 640, 900, 1280], { fit: 'scale-down' })} sizes="(max-width:699px) 90vw, (max-width:1100px) 44vw, 29vw" alt="" width="1536" height="1024" loading="lazy" decoding="async" /></div>
              <div class="idea-card-copy"><div class="idea-chips"><span class:list={['idea-format', idea.format]}>{formats[idea.format]}</span><span>{topics[idea.topic].label}</span>{idea.setting === 'home' && <span>From home</span>}</div><h3 id={`${idea.id}-title`}>{idea.title}</h3><p>{idea.description}</p><span class="idea-read-guide">Read the guide <span aria-hidden="true">↗</span></span></div>
            </a>
          </article>
        ))}
      </div>
      {/* [WEB-HOME-EXPLORE-BTN 2026-09-10] A real button, not a text link —
          the only way on from the six sample ideas is the full /ideas page. */}
      <a class="rail-button rail-button--ink rail-explore-button" href="/ideas" data-home-cta="explore-ideas">Explore more ideas <span aria-hidden="true">↗</span></a>
      <p class="rail-note">Listening sessions: adults 18+ · Companionship, not therapy or emergency support.</p>
    </section>


    {/* Creator homepage: each additional section is an independently editable component.
        The original hero and ideas remain; BookingExpress combines the approved format and onboarding sections. */}
    <div class="india-additions">
      <div class="india-page" data-india-page>
        <CreatorIdeas />
        <EarningsCalculator />
      </div>
    </div>


  </main>
  <div class="station-footer" id="payouts"><SiteFooter indiaLandingLanguage={true} /></div>
  <script>
    import '../lib/railwayHome';
    import '../lib/indiaCreators';
  </script>
</Base>


<style>
.india-additions { padding-block:40px; }
@media(max-width:699px) { .india-additions { padding-block:24px; } }
#ideas-catalogue .idea-picture { padding:8px; background:#fff; aspect-ratio:auto; }
#ideas-catalogue .idea-picture img { display:block; width:100%; height:auto; aspect-ratio:3 / 2; object-fit:contain; border-radius:8px; }
@media(max-width:699px) {
 #ideas-catalogue .idea-picture { padding:6px; }
}
</style>
