---
export const prerender = true;
import brandConfig from '../../../Specs/brand.json';
import { BRAND } from '../lib/brand';
import { publicImage } from '../lib/config';
import NotebookIcon from '../components/home/NotebookIcon.astro';
import '../styles/callvaal-notebook.css';
// Homepage identity only; domain migration and live calling are later phases.
const identity = brandConfig.homepageIdentity;
const title = `Life ka sawaal? ${identity.name}. | Real people. Useful advice.`;
const canonical = `${BRAND.webOrigin}/`;
const portrait = publicImage('/assets/callvaal/notebook/experts.png', { width: 2172, fit: 'scale-down' });
const profiles = [
  { name: 'Ananya', role: 'English tutor', price: 10, key: 'ananya', note: 'Let’s make\nEnglish easy! ♡', photoNote: 'Good\nEnglish\nBrighter\nYou.\n:)' },
  { name: 'Rohan', role: 'Career mentor', price: 15, key: 'rohan', note: 'New perspective\nbhi helps :)', photoNote: 'Better\nCareers\nHappier\nYou' },
  { name: 'Meera', role: 'Listener', price: 20, key: 'meera', note: 'You’re not alone\n♡', photoNote: 'Sometimes\nall you need\nis a\nlistening ear.\n:)' },
];
const categories = [
  { id: 'guidance', icon: 'compass', name: 'Guidance', subtitle: 'Big decisions', topics: ['Life decisions', 'Confidence', 'A fresh perspective'] },
  { id: 'learning', icon: 'notebook', name: 'Learning', subtitle: 'English & study help', topics: ['Spoken English', 'Study planning', 'Interview practice'] },
  { id: 'work-money', icon: 'briefcase', name: 'Work & money', subtitle: 'Career & business', topics: ['Career choices', 'CV feedback', 'Small-business ideas'] },
  { id: 'wellbeing', icon: 'heart', name: 'Wellbeing', subtitle: 'Talk it out', topics: ['A listening ear', 'Everyday encouragement', 'Life balance'] },
  { id: 'home-life', icon: 'home', name: 'Home & life', subtitle: 'Everyday questions', topics: ['Home organisation', 'Family routines', 'Moving to a new city'] },
  { id: 'hobbies', icon: 'headphones', name: 'Hobbies', subtitle: 'Music & more', topics: ['Music practice', 'Creative projects', 'Finding your next hobby'] },
];
const steps = [ { icon: 'upi', label: 'Add money with UPI' }, { icon: 'people', label: 'Choose your person' }, { icon: 'phone', label: 'Tap Call' }, { icon: 'ring', label: 'Pick up your phone' } ];
const faqs = [
  ['Can I call someone today?', 'Not yet. This is a preview of our new phone-conversation service. The people and rates shown above are illustrative; live profiles and calling will come with the service launch.'],
  ['Will I need to download an app?', 'The planned service works through your regular phone. You will choose a person on the website, then pick up the incoming phone call.'],
  ['How will paying by the minute work?', 'You will see the person’s rate before you call. The planned flow uses a prepaid wallet, with billing starting only when both people are connected. Final payment and billing details will be published before launch.'],
  ['Will the other person see my number?', 'The planned calling system will connect both people through a platform number, so personal phone numbers are not shared with each other.'],
  ['What can I talk about?', 'Learning, careers, everyday decisions, interests, or simply something you want to talk through. These conversations are not emergency care or a substitute for qualified medical, legal or financial advice.'],
  ['Can I share my skills here?', 'Yes, that is the idea. Tutors, mentors and people with useful experience will be able to create a profile, choose their availability and set a per-minute rate. Creator applications are coming with the next phase.'],
];
---
<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title><meta name="description" content={identity.description} /><link rel="canonical" href={canonical} /><meta name="theme-color" content="#B73226" /><meta name="robots" content="index,follow" />
    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'WebPage', name: title, description: identity.description, url: canonical, inLanguage: 'en-IN' })} />
    <meta property="og:type" content="website" /><meta property="og:site_name" content={identity.name} /><meta property="og:title" content={title} /><meta property="og:description" content={identity.description} /><meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${BRAND.webOrigin}/assets/callvaal/notebook/experts.png`} /><meta property="og:image:alt" content={`${identity.name}: illustrative profiles for real conversations.`} />
    <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={identity.description} /><meta name="twitter:image" content={`${BRAND.webOrigin}/assets/callvaal/notebook/experts.png`} />
    <link rel="icon" href="/assets/callvaal/notebook/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link data-site-fonts rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Comfortaa:wght@500;600;700&family=Nunito:wght@400;600;700;800;900;1000&family=Kalam:wght@400;700&display=swap" />
  </head>
  <body>
    <div class="notebook-site" data-design="callvaal-notebook-replica">
      <a class="skip-link" href="#main-content">Skip to main content</a>
      <header class="notebook-header notebook-inner">
        <a class="wordmark" href="/" aria-label={`${identity.name} home`}><span class="brand-bubble"><NotebookIcon kind="phone" /></span><span><strong>{identity.name}</strong><small>{identity.domain}</small></span></a>
        <nav class="notebook-nav" aria-label="Main navigation"><a href="#categories">Explore</a><a href="#launch-note">Online now</a><a href="#how-it-works">How it works</a><a href="#become-expert">Become an expert</a></nav>
        <a class="sign-in" href="/sign-in">Sign in</a>
        <span class="handnote header-note" aria-hidden="true">Good<br/>Questions<br/>Brighter<br/>Days<br/>:)</span>
      </header>
      <main id="main-content">
        <section class="notebook-hero notebook-inner" aria-labelledby="hero-title">
          <div class="hero-notes" aria-hidden="true"><span class="handnote">No app<br/>needed!<i>⤷</i></span><span class="handnote">Your number<br/>stays private<i>⤷</i></span><span class="handnote">Baat karke<br/>dekho :)<i>⤷</i></span></div>
          <div class="hero-copy"><h1 id="hero-title">Life ka sawaal?<br/><mark>{identity.name}.</mark></h1><p class="hero-promise">Real people. Useful advice. One phone call.</p><p class="hero-subtitle">Pick a person, pay per minute, and talk on your regular phone.</p><div class="hero-actions"><a class="button" href="#categories">Find your person <span aria-hidden="true">⟶</span></a><a class="button button-outline" href="#how-it-works">How it works</a></div><div class="trust-chips"><span><b class="upi">UPI<span>▰</span></b> UPI payments</span><span><b class="rupee">₹</b> per minute</span><span><NotebookIcon kind="lock"/> Private numbers</span></div></div>
          <div class="profile-stage" aria-label="Illustrative expert profiles, not available for calls"><span class="sample-tape handnote">Sample profiles</span>{profiles.map((profile, index) => <article class={`profile-card profile-${profile.key}`}><span class="photo-tape" aria-hidden="true"></span><div class="portrait-window"><img src={portrait} alt={`Illustrative portrait of ${profile.name}`} width="2172" height="724" style={`--portrait-index:${index}`} fetchpriority={index === 0 ? 'high' : 'auto'} decoding="async"/><span class="portrait-note handnote" aria-hidden="true">{profile.photoNote}</span></div><div class="profile-copy"><span class="sample-status"><i aria-hidden="true"></i> Sample profile</span><h2>{profile.name}</h2><p>{profile.role}</p><strong class="profile-price">₹{profile.price}/min</strong><a class="sample-call" href="#launch-note" aria-label={`About calling: ${profile.name} is a sample profile`}><NotebookIcon kind="phone"/> Call</a><p class="handnote profile-note">{profile.note}</p></div></article>)}<span class="handnote profile-after-note" aria-hidden="true">⤴ &nbsp; Good people.<br/>Real conversations.</span></div>
        </section>
        <section class="category-section notebook-inner" id="categories" aria-labelledby="categories-title"><h2 id="categories-title">Aaj kis cheez mein help chahiye?</h2><span class="handnote category-top-note" aria-hidden="true">⤹ &nbsp; Something for every sawaal</span><span class="handnote category-left-note" aria-hidden="true">Different<br/>people<br/>Different<br/>Journeys<br/><br/>Same<br/>Questions<br/>:)</span><div class="category-grid">{categories.map(category => <a class="category-card paper" href={`#${category.id}`}><NotebookIcon kind={category.icon}/><span><h3>{category.name}</h3><p>{category.subtitle}</p></span></a>)}</div><span class="handnote sticky sticky-coral" aria-hidden="true">You<br/>got this!</span><span class="handnote sticky sticky-mint" aria-hidden="true">Same<br/>People<br/><br/>New<br/>Perspectives<br/>:)<br/>〰</span></section>
        <section class="how-section notebook-inner" id="how-it-works" aria-labelledby="how-title"><h2 id="how-title">Bas 4 simple steps.</h2><ol class="steps">{steps.map((step, index) => <li><span class="step-number">{index + 1}</span>{step.icon === 'upi' ? <span class="upi step-upi">UPI<span>▰</span></span> : <NotebookIcon kind={step.icon}/>}<strong>{step.label}</strong>{index < 3 && <span class="step-arrow" aria-hidden="true">⤴</span>}</li>)}</ol><p class="billing-highlight"><mark>Billing starts only when both sides are connected.</mark></p><span class="handnote how-note" aria-hidden="true">Small<br/>Conversations<br/>Big Changes<br/>:)</span></section>
        <section class="expert-band" id="become-expert" aria-labelledby="expert-title"><span class="band-tape band-tape-left" aria-hidden="true"></span><span class="band-tape band-tape-right" aria-hidden="true"></span><span class="handnote band-left-note" aria-hidden="true">Real<br/>Skills<br/>Real<br/>Impact<br/>:)</span><div class="expert-copy"><h2 id="expert-title">Tumhari skill. Kisi ka solution.</h2><p>Share what you know. Earn on your own time.</p><a class="button button-yellow" href="#creator-notes">Become an expert <span aria-hidden="true">⟶</span></a></div><div class="student-doodle" aria-hidden="true"><img src={publicImage('/assets/callvaal/notebook/friends.png', { width: 900, fit: 'scale-down' })} alt="" width="1536" height="1024" loading="lazy" decoding="async" /></div><span class="handnote band-right-note" aria-hidden="true">More<br/>Good People<br/>Please.<br/>:)</span></section>
        <div class="more-pages notebook-inner"><p class="handnote page-turn" aria-hidden="true">There’s a little more in this notebook… ⤵</p>
          <section id="browse" class="extra-section" aria-labelledby="browse-title"><span class="section-tab">01 / Find your thing</span><h2 id="browse-title">Bade ya chhote sawaal. Sab welcome.</h2><p class="section-lead">A new job. A new skill. Or just a day that needs a good conversation.</p><div class="topic-grid">{categories.map(category => <article class="topic-card paper" id={category.id}><NotebookIcon kind={category.icon}/><h3>{category.name}</h3><ul>{category.topics.map(topic => <li>{topic}</li>)}</ul><a href="#launch-note">Explore what’s coming <span aria-hidden="true">↗</span></a></article>)}</div></section>
          <section id="languages" class="extra-section language-section" aria-labelledby="languages-title"><span class="section-tab">02 / Apni language, apni vibe</span><h2 id="languages-title">The right words feel like home.</h2><p class="section-lead">We’re building for conversations in the languages India speaks. Planned language options:</p><div class="language-chips">{['हिन्दी / Hindi', 'English', 'Hinglish', 'தமிழ் / Tamil', 'తెలుగు / Telugu', 'বাংলা / Bengali', 'मराठी / Marathi', 'ಕನ್ನಡ / Kannada', 'മലയാളം / Malayalam', 'ગુજરાતી / Gujarati', 'ਪੰਜਾਬੀ / Punjabi'].map(language => <span>{language}</span>)}</div><p class="handnote">No perfect English needed. Just be yourself. ♡</p></section>
          <section id="pricing" class="extra-section pricing-section" aria-labelledby="pricing-title"><div><span class="section-tab">03 / Simple maths</span><h2 id="pricing-title">Chhoti call.<br/>Clear price.</h2><p class="section-lead">Choose a rate that works for you. The planned wallet lets you add money with UPI and pay for the time you talk.</p><a class="text-link" href="#faq">A few things to know ↗</a></div><div class="price-note paper"><span class="handnote">Just an example ↓</span><p>₹10 <small>/ minute</small></p><p class="price-times">× 10 minutes</p><div class="price-total">₹100 <span>conversation cost</span></div><p class="price-disclaimer">Illustrative maths, not a live offer. Final rates, taxes and billing terms will be shown before payment at launch.</p></div></section>
          <section id="privacy-note" class="extra-section privacy-section" aria-labelledby="privacy-title"><span class="section-tab">04 / A little peace of mind</span><h2 id="privacy-title">Your conversation. Your comfort.</h2><div class="comfort-grid"><article><NotebookIcon kind="lock"/><h3>Personal numbers stay personal.</h3><p>Our planned platform number connects the call without sharing your number with the other person.</p></article><article><NotebookIcon kind="phone"/><h3>Just your regular phone.</h3><p>Choose on the website. Pick up your phone. No new app to learn for the planned calling service.</p></article><article><NotebookIcon kind="heart"/><h3>Talk at your own pace.</h3><p>Ask what matters to you, share only what you’re comfortable with, and end the conversation when you need to.</p></article></div></section>
          <section id="creator-notes" class="extra-section creator-section paper" aria-labelledby="creator-title"><span class="handnote creator-margin" aria-hidden="true">Your experience<br/>could be someone’s<br/>next step. ⤵</span><span class="section-tab">05 / Your skills belong here</span><h2 id="creator-title">Kuch aata hai?<br/>Kisi ke kaam aayega.</h2><p>Teach a little English. Help with a career decision. Share a skill you’ve spent years learning. We’re building a place for useful, personal conversations.</p><div class="creator-checks"><span>✓ Your profile</span><span>✓ Your availability</span><span>✓ Your per-minute rate</span></div><a class="button" href="#launch-note">Read the launch note <span aria-hidden="true">⟶</span></a><p class="handnote">Creator applications are coming next.</p></section>
          <section id="faq" class="extra-section faq-section" aria-labelledby="faq-title"><span class="section-tab">06 / Last-page questions</span><h2 id="faq-title">Achha, one more thing…</h2><div class="faq-list">{faqs.map(([question, answer]) => <details><summary>{question}<span aria-hidden="true">+</span></summary><p>{answer}</p></details>)}</div></section>
          <aside id="launch-note" class="launch-note paper" aria-labelledby="launch-title"><span class="handnote">A note from us ♡</span><h2 id="launch-title">A new chapter is coming.</h2><p>{identity.name} is getting ready to launch. The profiles and prices shown here are illustrative. We’re not taking calls, wallet top-ups or creator applications yet.</p><p>Already have an account? You can still <a href="/sign-in">sign in</a>.</p></aside>
        </div>
      </main>
      <footer class="notebook-footer"><a class="wordmark" href="/" aria-label={`${identity.name} home`}><span class="brand-bubble"><NotebookIcon kind="phone"/></span><span><strong>{identity.name}</strong><small>{identity.domain}</small></span></a><nav aria-label="Footer"><a href="/help">Help</a><span aria-hidden="true">·</span><a href="/privacy">Privacy</a><span aria-hidden="true">·</span><a href="/terms">Terms</a></nav><span class="handnote footer-note" aria-hidden="true">CONVERSATIONS<br/>BUILD A KINDER<br/>INDIA :)</span></footer>
    </div>
    <script>import '../lib/notebookHome';</script>
  </body>
</html>
