---
// avatok.ai home — the AvaTok launch landing (AI receptionist · private number · AI messaging).
// The design ships as a self-contained, pre-resolved static document
// (src/landing/avatok-landing.html): the x-dc runtime and all webfonts are
// inlined, a #joinlist waitlist section is wired to POST /api/waitlist (Brevo),
// and the site footer (with the real /privacy, /terms, /cookies, /dmca, /about,
// /careers, /blog, /contact links) is ported from the previous design.
//
// We strip the document's own leading <!DOCTYPE html> and let Astro emit one,
// then drop the whole document in via set:html (opaque to the Astro compiler,
// so its {{ }} bindings and CSS braces pass through untouched). Fully static.
export const prerender = true;

import landingRaw from '../landing/avatok-landing.html?raw';
import SiteFooter from '../components/SiteFooter.astro';

const landingHtml = landingRaw.replace(/^﻿?\s*<!doctype html>/i, '');

// The landing ships as one opaque document, so the shared footer cannot simply
// be appended — that would land it after </html>. The document carries a
// <!--SITE_FOOTER--> marker where its old hand-rolled 4-link footer used to be;
// we split there and render the real <SiteFooter /> inside <body>, so the home
// page carries the same ~19 policy links as every other page.
const FOOTER_MARK = '<!--SITE_FOOTER-->';
const [landingHead, landingTail = ''] = landingHtml.split(FOOTER_MARK);
if (landingTail === '') {
  throw new Error(
    'index.astro: <!--SITE_FOOTER--> marker missing from src/landing/avatok-landing.html — ' +
    'the home page would silently ship with no footer.',
  );
}
---

<Fragment set:html={landingHead} />
<SiteFooter />
<Fragment set:html={landingTail} />

<!--
  Scroll-driven 3D fold on the six spreads. A bundled <script> rather than a React
  island on purpose: it is pure DOM work with no markup of its own, and Astro emits
  it as a deferred module, so it runs after the landing document is parsed without
  the hydration timing that `client:idle` depends on.
-->
<script>
  import '../scripts/scroll-fold';
</script>
