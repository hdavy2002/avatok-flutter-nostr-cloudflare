---
import { publicImage, publicImageSrcSet } from '../lib/config';
export const prerender = true;
import Base from '../layouts/Base.astro';
import Fonts from '../components/Fonts.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/railway-home.css';
import '../styles/india-additions.css';
import FeaturedSessions from '../components/home/FeaturedSessions.astro';
import BookingExpress from '../components/india-preview/BookingExpressIllustrated.astro';
import PujaBand from '../components/home/PujaBand.astro';
import CategoriesGrid from '../components/home/CategoriesGrid.astro';
import TrustSafetyBand from '../components/home/TrustSafetyBand.astro';
import HowMoneyMoves from '../components/home/HowMoneyMoves.astro';
import EarningsCalculator from '../components/india-preview/EarningsCalculatorIllustrated.astro';

const heroSrcSet = publicImageSrcSet('/assets/home/avatok-creator-constellation.png', [420, 640, 900, 1280], { fit: 'scale-down' });
---
<Base
  title="avaTOK: live puja, online classes, 1:1 consultations and ticketed live events"
  description="Book live pujas, online classes, 1:1 video consultations and ticketed live events from verified creators. Pay securely in rupees."
  image={publicImage('/assets/home/avatok-creator-constellation.png', { width: 1280, quality: 75, fit: 'scale-down', format: 'jpeg' })}
  imageAlt="Creators hosting live events, group classes and 1:1 video consultations."
  imageWidth={1156}
  imageHeight={1360}
  chrome={false}
  lang="en-IN"
  ogLocale="en_IN"
  keywords="online puja booking, online classes, expert consultations, ticketed live events, creator marketplace India"
>
  <Fragment slot="head">
    <Fonts india />
    <meta property="og:image:type" content="image/jpeg" />
    <meta name="theme-color" content="#f7ead5" />
    <link rel="preload" as="image" href={publicImage('/assets/home/avatok-creator-constellation.png', { width: 1156, fit: 'scale-down' })} imagesrcset={heroSrcSet} />
  </Fragment>
  <a class="rail-skip" href="#main-content">Skip to main content</a>
  <SiteHeader indiaLandingLanguage={true} />
  <main class="rail-home" data-design="creator-marketplace-2026-09" id="main-content">
    <section class="station-hero creator-hero" aria-labelledby="rail-title">
      <div class="creator-hero__frame">
        {/* [UI-MOTION-1 2026-09-10] "texts-reveal" (transitions.dev, `.t-*` in
            styles/motion.css) — headline and supporting line rise in with a
            staggered blur on first paint. `.t-stagger` goes on `.station-copy`
            itself, not a new wrapper div, so `h1`/`p` stay its DIRECT children —
            railway-home.css has `.station-copy > p:not(.station-aside)` rules
            at every breakpoint that a wrapper div would have broken.
            CRITICAL: both lines are real, readable text at rest — the
            <noscript> below forces them visible if JS never runs, and
            railwayHome.ts's safety-net timeout forces `.is-shown` even if the
            reveal script itself fails, so nothing is ever permanently parked
            at opacity:0. */}
        <noscript><style>.t-stagger .t-stagger-line{opacity:1!important;transform:none!important;filter:none!important}</style></noscript>
        <div class="station-copy creator-hero__copy t-stagger" id="hero-reveal">
          <p class="station-kicker creator-hero__kicker"><span aria-hidden="true"></span> Creator marketplace · India</p>
          <h1 id="rail-title" class="t-stagger-line">Turn your skill into income.</h1>
          <p class="t-stagger-line t-stagger-line--2">avaTOK is a marketplace where verified creators sell tickets to live online events, 1:1 video consultations and small-group classes. Customers book and pay in rupees. Creators are paid to their bank account.</p>
          <div class="station-actions">
            <a class="rail-button" href="/sign-up" data-home-cta="hero-create">Start selling, free</a>
            <a class="station-outline" href="/marketplace" data-home-cta="hero-browse">Browse sessions</a>
          </div>
          <ul class="creator-hero__checks" aria-label="Why book on avaTOK">
            <li>Liveness-verified creators</li>
            <li>Secure payments in ₹</li>
            <li>Clear refund policy</li>
          </ul>
          <div class="creator-hero__formats" aria-label="Ways to earn on avaTOK">
            <a href="/marketplace?group=india_goes_live" data-home-cta="hero-live">Live events</a>
            <a href="/marketplace?group=book_their_time" data-home-cta="hero-1to1">1:1 consultations</a>
            <a href="/marketplace?group=find_your_people" data-home-cta="hero-group">Group classes</a>
          </div>
        </div>
        {/* closes the merged .station-copy.t-stagger div opened above (it used
            to close a plain .station-copy). */}
        <div class="station-art creator-hero__art">
          <img src={publicImage('/assets/home/avatok-creator-constellation.png', { width: 1156, fit: 'scale-down' })} srcset={heroSrcSet} width="1156" height="1360" alt="Creators hosting a live stream, teaching a class, and offering a one-to-one video consultation." fetchpriority="high" decoding="async" />
          <p class="creator-hero__share"><strong>80%</strong><span>of every booking goes to the creator</span></p>
        </div>
      </div>
    </section>

    <FeaturedSessions />

    <BookingExpress />

    <PujaBand />

    <CategoriesGrid />

    <TrustSafetyBand />

    <HowMoneyMoves />

    <div class="india-additions">
      <div class="india-page" data-india-page>
        <EarningsCalculator />
      </div>
    </div>

  </main>
  <div class="station-footer" id="payouts"><SiteFooter indiaLandingLanguage={true} /></div>
  <script>
    import '../lib/railwayHome';
    import '../lib/indiaCreators';
  </script>
</Base>

<style>
  .creator-hero__checks {
    display: flex; flex-wrap: wrap; gap: 10px; list-style: none; margin: 20px 0 0; padding: 0;
  }
  .creator-hero__checks li {
    padding: 7px 12px; border: 1.5px solid var(--rail-ink, #141410); border-radius: 999px;
    background: #fff; font-size: 13px; font-weight: 700;
  }
  .creator-hero__checks li::before { content: '✓ '; }
  @media (max-width: 699px) { .creator-hero__checks { justify-content: center; } }
</style>
