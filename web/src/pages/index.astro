---
export const prerender = true;
import Base from '../layouts/Base.astro';
import Fonts from '../components/Fonts.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { publicImage } from '../lib/config';
import '../styles/railway-home.css';
import '../styles/saathum-home.css';
import SpiritualEventShelves from '../islands/home/SpiritualEventShelves';
import ExperienceTopics from '../components/ExperienceTopics.astro';
---
<Base
  title="Saathum | Live pujas, satsangs and spiritual experiences"
  description="Discover live pujas, satsangs, aartis and spiritual gatherings from India. Find an experience, book your place and join from wherever you are."
  keywords="live puja online, satsang live stream, aarti darshan online, spiritual events India, book live puja tickets"
  chrome={false}
>
  <Fragment slot="head">
    <Fonts india />
    <meta name="theme-color" content="#f7ead5" />
  </Fragment>
  <a class="rail-skip" href="#main-content">Skip to main content</a>
  <SiteHeader indiaLandingLanguage={false} />
  <main class="rail-home" data-design="saathum-spiritual-2026-09" id="main-content">
    <section class="saathum-hero rail-wrap" aria-labelledby="rail-title" data-home-section="hero">
      <p class="rail-eyebrow">LIVE SPIRITUAL EXPERIENCES FROM INDIA</p>
      <h1 id="rail-title">Be there for the moments that matter.</h1>
      <p class="rail-intro-copy">Join live pujas, satsangs, aartis and spiritual gatherings from India—wherever you call home.</p>
      <div class="rail-actions saathum-hero-actions">
        <a class="rail-button" href="/marketplace" data-home-cta="hero-explore-events">Explore events</a>
        <a class="rail-text-link" href="#experiences" data-home-cta="hero-browse-experiences">Browse experiences</a>
      </div>
      <p class="rail-note saathum-hero-note">Saathum is a marketplace where event organisers sell tickets to live online spiritual events. Attendees book and pay online; refunds follow our <a href="/refunds">published policy</a>.</p>
    </section>

    <div id="home-events">
      <noscript>
        <p class="rail-note rail-wrap">JavaScript is required to show live and upcoming events here. <a href="/marketplace">Browse all events</a>.</p>
      </noscript>
      <SpiritualEventShelves client:load />
    </div>

    <ExperienceTopics />

    <section class="rail-ideas rail-wrap saathum-benefits" id="benefits" aria-labelledby="benefits-title" data-home-section="benefits">
      <h2 class="rail-flowered" id="benefits-title"><img src={publicImage('/ornament-flower.png', { width: 56, fit: 'scale-down' })} alt="" width="28" height="28" /> Far from home. Close to your traditions. <img src={publicImage('/ornament-flower.png', { width: 56, fit: 'scale-down' })} alt="" width="28" height="28" /></h2>
      <div class="rail-idea-grid saathum-panel-grid saathum-panel-grid--4">
        <article class="rail-idea">
          <div class="rail-idea-copy">
            <h3>Join when travel is difficult</h3>
            <p>Watch live from wherever you are, even when a trip home isn't possible right now.</p>
          </div>
        </article>
        <article class="rail-idea">
          <div class="rail-idea-copy">
            <h3>Hear your spiritual teacher</h3>
            <p>Take part in real time, from the teacher whose voice you already know.</p>
          </div>
        </article>
        <article class="rail-idea">
          <div class="rail-idea-copy">
            <h3>Share meaningful occasions</h3>
            <p>Invite family to join too — each person joins under the event's own ticket terms.</p>
          </div>
        </article>
        <article class="rail-idea">
          <div class="rail-idea-copy">
            <h3>Stay connected to language and tradition</h3>
            <p>Take part in the language and rhythms of the events you grew up with.</p>
          </div>
        </article>
      </div>
    </section>

    <section class="rail-formats rail-wrap saathum-talks-darshan" id="talks-darshan" aria-labelledby="talks-darshan-title" data-home-section="talks_darshan">
      <h2 id="talks-darshan-title">Special talks and darshan</h2>
      <div class="rail-format-grid">
        <a href="/marketplace?q=Satsang" data-home-cta="talks-darshan-satsang">
          <span><h3>Time with the teachings that matter to you</h3><p>Find live satsangs and spiritual talks you can book a ticket for.</p></span>
        </a>
        <a href="/marketplace?q=Darshan" data-home-cta="talks-darshan-darshan">
          <span><h3>Darshan, wherever you are</h3><p>Find live darshan and aarti events you can book a ticket for.</p></span>
        </a>
      </div>
    </section>

    <section class="rail-ideas rail-wrap saathum-joining" id="joining" aria-labelledby="joining-title" data-home-section="joining">
      <h2 id="joining-title">Joining is simple</h2>
      <ol class="saathum-panel-grid saathum-panel-grid--3 saathum-steps">
        <li class="rail-idea">
          <div class="rail-idea-copy">
            <span class="rail-badge rail-badge--yellow">Step 1</span>
            <h3>Choose an experience</h3>
            <p>Browse live pujas, satsangs, aartis and other spiritual events.</p>
          </div>
        </li>
        <li class="rail-idea">
          <div class="rail-idea-copy">
            <span class="rail-badge rail-badge--pink">Step 2</span>
            <h3>Book your place</h3>
            <p>Reserve your ticket and pay securely online.</p>
          </div>
        </li>
        <li class="rail-idea">
          <div class="rail-idea-copy">
            <span class="rail-badge rail-badge--blue">Step 3</span>
            <h3>Open your joining link</h3>
            <p>Find your joining link in your booking confirmation when it's time.</p>
          </div>
        </li>
      </ol>
      <p class="rail-note">Check the language, time and ticket details before booking. Follow the joining instructions in your confirmation.</p>
      <a class="rail-text-link" href="/help/booking-and-paying/join-a-live-show" data-home-cta="joining-help">Need help joining an event?</a>
    </section>

    <section class="rail-ideas rail-wrap saathum-organise-invite" id="organise-invite" aria-labelledby="organise-invite-title" data-home-section="organise_invite">
      <h2 id="organise-invite-title">Know a spiritual teacher or temple in your area?</h2>
      <p class="rail-section-copy">Help their community join from anywhere. Learn how to organise a live experience.</p>
      <div class="rail-last-cta">
        <a class="rail-button" href="/organisers" data-home-cta="organise-invite">Become an organiser</a>
      </div>
    </section>
  </main>
  <div class="station-footer"><SiteFooter indiaLandingLanguage={false} /></div>
  <script>
    import '../lib/railwayHome';
  </script>
</Base>
