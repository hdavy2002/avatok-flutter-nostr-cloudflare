---
export const prerender = true;
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import OriginalGlobalSections from '../components/OriginalGlobalSections.astro';
import OriginalIdeasSection from '../components/OriginalIdeasSection.astro';
import '../styles/global-home.css';
import '../styles/global-original.css';
---
<Base title="Turn your influence into live & 1:1 income · avaTOK" description="AvaTOK helps influencers earn from their audience through paid live streams and private 1:1 video sessions, with flexible pricing and local payouts." image="/assets/global-original/hero-source.png" imageAlt="A global home for creators to host paid live streams and private 1:1 video sessions." imageWidth={1536} imageHeight={1024} chrome={false}>
  <SiteHeader variant="global" />
  <main class="global-home original-home" data-design="creator-marketplace-2026-09" data-artwork="original-pixel-crops" id="main-content">
    <OriginalGlobalSections part="hero" />
    <OriginalGlobalSections part="middle" />
    <OriginalIdeasSection />
    <OriginalGlobalSections part="cta" />
  </main>
  <SiteFooter variant="global" />
</Base>
