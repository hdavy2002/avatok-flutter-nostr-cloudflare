---
export const prerender = true;
import brandConfig from '../../../Specs/brand.json';
import ModernIcon from '../components/home/ModernIcon.astro';
import HelloFraandsHeader from '../components/callvaal/Header.astro';
import HelloFraandsFooter from '../components/callvaal/Footer.astro';
import CreatorPreviewCard from '../components/callvaal/CreatorPreviewCard.astro';
import { creatorPreviews, homeCopy } from '../lib/hostFanHomeReference';
import { publicImage, publicImageSrcSet } from '../lib/config';
import '../styles/callvaal-notebook.css';
import '../styles/host-fan-home.css';
const identity = brandConfig.homepageIdentity;
const title = `${homeCopy.heroTitle} | ${identity.name}`;
const description = homeCopy.heroDescription;
const canonical = `https://${identity.domain}/`;
const assets = '/assets/callvaal/host-fan/';
---
<!doctype html>
<html lang="en-IN">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title><meta name="description" content={description} /><link rel="canonical" href={canonical} /><meta name="theme-color" content="#46113e" /><meta name="robots" content="index,follow" />
  <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'WebPage', name: title, description, url: canonical, inLanguage: 'en-IN' })} />
  <meta property="og:type" content="website" /><meta property="og:site_name" content={identity.name} /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} />
  <meta property="og:image" content={`${canonical}assets/callvaal/host-fan/hero.jpg`} /><meta property="og:image:alt" content="An illustrative creator smiling at her phone against teal and yellow scrapbook paper." />
  <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={`${canonical}assets/callvaal/host-fan/hero.jpg`} />
  <link rel="icon" href="/assets/callvaal/notebook/favicon.svg" type="image/svg+xml" />
  <link data-site-fonts rel="preload" href="/fonts/Comfortaa-Bold.ttf" as="font" type="font/ttf" crossorigin /><link rel="preload" href="/fonts/Nunito-Variable.ttf" as="font" type="font/ttf" crossorigin />
  <link rel="preload" href="/fonts/Comfortaa-Variable.ttf" as="font" type="font/ttf" crossorigin />
</head>
<body class="hfh-reference-page">
<div class="notebook-site" data-design="callvaal-scrapbook">
  <a class="skip-link" href="#main-content">Skip to main content</a>
  <HelloFraandsHeader homeReference />
  <main id="main-content" class="hfh-home">
    <section class="hfh-hero" aria-labelledby="hero-title" data-home-section="hero">
      <div class="hfh-hero-copy">
        <h1 id="hero-title"><span class="hfh-title-line">Talk to your favourite</span> <span class="hfh-title-line">social media influencers</span> <em>over a private phone call.</em></h1>
        <p>{homeCopy.heroDescription}</p>
        <div class="hfh-actions"><a class="hfh-button" href="/marketplace" data-home-cta="explore-hosts">Explore hosts <span aria-hidden="true">→</span></a><a class="hfh-button hfh-button--outline" href="/hosts/join" data-home-cta="become-host">Become a host</a></div>
        <ul class="hfh-proof" aria-label="Call safeguards"><li><svg class="modern-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 2 9 4v6c0 5-5 8-9 10-4-2-9-5-9-10V6Z"/><path d="m8 12 3 3 5-6"/></svg>Full KYC</li><li><ModernIcon name="lock" />Private numbers</li><li><ModernIcon name="payment" />Secure payments</li></ul>
      </div>
      <div class="hfh-collage" aria-label="Illustrative private call and booking preview">
        <img class="hfh-hero-photo" src={publicImage(`${assets}hero-cutout.webp`, { width: 900 })} srcset={publicImageSrcSet(`${assets}hero-cutout.webp`, [256, 420, 640, 900, 1280])} sizes="(max-width: 359px) calc(100vw - 32px), (max-width: 767px) min(62vw, 357px), (min-width: 1824px) 538px, 31vw" width="1000" height="1250" fetchpriority="high" alt="Illustrative creator in a colourful kurta smiling at her phone" />
        <p class="hfh-note hfh-note--same">Same people.<br/>Deeper conversations.<span aria-hidden="true">♡</span></p>
        <p class="hfh-note hfh-note--time">You<br/>set the time.</p>
        <div class="hfh-picker" aria-label="Sample booking times, illustration only"><strong><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="4" y="5" width="16" height="16" rx="2"/><path d="M4 10h16M8 2v6M16 2v6"/></svg>Pick a time</strong><div class="hfh-week" aria-hidden="true"><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span></div><div class="hfh-times"><span>11:00 AM</span><span class="hfh-time-selected">12:30 PM</span><span>4:00 PM</span><span>7:00 PM</span></div></div>
        <div class="hfh-share"><strong><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="m9 15 6-6m-8 4-2 2a4 4 0 0 0 6 6l4-4m2-6 2-2a4 4 0 0 0-6-6L9 7"/></svg> Your link</strong><span class="hfh-share-url">{identity.domain}/<wbr />yourname</span><span class="hfh-share-caption">♧&nbsp; Share with your fans</span></div>
        <div class="hfh-call-photo"><img src={publicImage(`${assets}host.webp`, { width: 420 })} srcset={publicImageSrcSet(`${assets}host.webp`, [160, 256, 420, 640])} sizes="(max-width: 359px) 70vw, (max-width: 767px) min(45vw, 260px), (min-width: 1824px) 305px, 20vw" width="600" height="750" alt="Illustrative host waving hello on a private call" /><div class="hfh-call-controls" aria-hidden="true"><span>♩</span><span><ModernIcon name="phone" /></span><span>▣</span></div></div>
        <p class="hfh-note hfh-note--real">Real people.<br/>Real talks.</p>
      </div>
    </section>
    <section class="hfh-creators hfh-torn" id="people" aria-labelledby="people-title" data-home-section="creators">
      <span id="moods" class="hfh-anchor" aria-hidden="true"></span><span id="naye-dost" class="hfh-anchor" aria-hidden="true"></span>
      <div class="hfh-section-heading"><div><h2 id="people-title">Book time with creators you follow</h2><p>Verified hosts. Real conversations. Pick a time that works.</p></div><a href="/marketplace" data-home-cta="view-all-hosts">View all hosts <span aria-hidden="true">→</span></a></div>
      <div class="hfh-creator-grid">{creatorPreviews.map(profile => <CreatorPreviewCard profile={profile} />)}</div>
      <p class="hfh-sample-label hfh-disclosure" id="sample-disclosure">Sample profiles · Illustrative photos, ratings, availability and prices. No audio plays and no call or payment is made.</p>
    </section>
    <section class="hfh-privacy hfh-torn" id="safety" aria-labelledby="privacy-title" data-home-section="privacy">
      <div id="privacy-note"><h2 id="privacy-title">Your number stays yours.</h2><p>Our system calls the fan and the host separately, then securely connects the calls. We never reveal either person’s personal phone number.</p></div>
      <figure class="hfh-connection" aria-label={`Fan and host connect through ${identity.name}. Both personal phone numbers stay private.`}>
        <div class="hfh-person"><img src={publicImage(`${assets}fan-call.webp`, { width: 256 })} srcset={publicImageSrcSet(`${assets}fan-call.webp`, [96, 160, 256, 420])} sizes="(max-width: 767px) min(28vw, 142px), (max-width: 1023px) 144px, (min-width: 1824px) 221px, 12vw" width="1000" height="1250" loading="lazy" alt="Illustrative fan on her phone" /><strong>Fan</strong></div>
        <span class="hfh-connector-arrow" aria-hidden="true">⇢</span>
        <div class="hfh-secure"><svg viewBox="0 0 80 88" aria-hidden="true"><path d="M40 5C31 10 18 13 8 16L12 43C15 60 27 73 40 81C55 73 66 58 69 42L73 16C61 13 50 9 40 5Z" fill="#116b70"/><path d="M26 25Q21 23 20 29C18 42 34 59 47 62Q54 64 58 60L60 55Q61 52 57 50L50 46Q47 44 45 48L43 51Q33 46 30 38L33 35Q36 33 33 30L29 26Q28 24 26 25Z" fill="white"/><path d="M46 20q14 4 17 17M46 28q7 2 9 9" fill="none" stroke="white" stroke-width="3" stroke-linecap="round"/></svg><strong>{identity.name}<br/>connects</strong></div>
        <span class="hfh-connector-arrow" aria-hidden="true">⇠</span>
        <div class="hfh-person"><img src={publicImage(`${assets}host-call.webp`, { width: 256 })} srcset={publicImageSrcSet(`${assets}host-call.webp`, [96, 160, 256, 420])} sizes="(max-width: 767px) min(28vw, 142px), (max-width: 1023px) 144px, (min-width: 1824px) 221px, 12vw" width="800" height="600" loading="lazy" alt="Illustrative host" /><strong>Host</strong></div>
        <figcaption>Two private calls. One conversation.</figcaption>
      </figure>
    </section>
    <div class="hfh-lanes" data-home-section="lanes">
      <section class="hfh-lane hfh-lane--women hfh-torn" id="women-only" aria-labelledby="women-title"><div class="hfh-lane-copy"><h2 id="women-title">Women with women</h2><p><strong>A private space</strong> for women to book conversations with verified women hosts.</p><p class="hfh-kyc" aria-describedby="community-eligibility"><svg class="modern-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 2 9 4v6c0 5-5 8-9 10-4-2-9-5-9-10V6Z"/><path d="m8 12 3 3 5-6"/></svg>Video KYC required</p><a class="hfh-button" href="/marketplace?lane=women#people" data-home-cta="women-hosts">Explore women hosts <span aria-hidden="true">→</span></a></div><div class="hfh-lane-art"><img src={publicImage(`${assets}women-reference.webp`, { width: 640 })} srcset={publicImageSrcSet(`${assets}women-reference.webp`, [256, 420, 640, 900])} sizes="(max-width: 767px) min(90vw, 480px), (max-width: 1023px) 43vw, (min-width: 1824px) 385px, 22vw" width="800" height="600" loading="lazy" alt="Two illustrative women enjoying phone conversations" /><p class="hfh-note">More<br/>women.<br/>More<br/>conversations.<span aria-hidden="true">♡</span></p></div></section>
      <section class="hfh-lane hfh-lane--community hfh-torn" id="lgbtq" aria-labelledby="lgbtq-title"><div class="hfh-lane-copy"><h2 id="lgbtq-title">LGBTQ+ with LGBTQ+</h2><p><strong>A respectful space</strong> for LGBTQ+ fans to book conversations with hosts from the community.</p><p class="hfh-kyc" aria-describedby="community-eligibility"><svg class="modern-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 2 9 4v6c0 5-5 8-9 10-4-2-9-5-9-10V6Z"/><path d="m8 12 3 3 5-6"/></svg>Video KYC required</p><a class="hfh-button" href="/marketplace?lane=lgbtq#people" data-home-cta="lgbtq-hosts">Explore LGBTQ+ hosts <span aria-hidden="true">→</span></a></div><div class="hfh-lane-art"><img src={publicImage(`${assets}community-reference.webp`, { width: 640 })} srcset={publicImageSrcSet(`${assets}community-reference.webp`, [256, 420, 640, 900])} sizes="(max-width: 767px) min(90vw, 480px), (max-width: 1023px) 43vw, (min-width: 1824px) 385px, 22vw" width="800" height="600" loading="lazy" alt="Two illustrative community members enjoying phone conversations beside a rainbow flag" /><p class="hfh-note">Different<br/>stories.<br/>Same<br/>respect.<span aria-hidden="true">♡</span></p></div></section>
    </div>
    <p class="hfh-eligibility sr-only" id="community-eligibility">Video KYC verifies the person, not their gender or sexual orientation. Community access follows each space’s eligibility and safety rules.</p>
    <section class="hfh-how" id="how-it-works" aria-labelledby="how-title" data-home-section="how-it-works"><h2 id="how-title">How it works</h2><ol class="hfh-steps"><li><span class="hfh-step-number">1</span><svg viewBox="0 0 48 48" aria-hidden="true"><path d="M33 19C34 27 28 34 20 34C12 34 5 28 5 20C5 12 11 6 19 6C27 5 33 11 33 19ZM30 31Q36 37 43 43"/></svg><div><h3>Choose a host</h3><p>Find creators you follow<br class="hfh-reference-break"/> and like.</p></div></li><li><span class="hfh-step-number">2</span><svg viewBox="0 0 48 48" aria-hidden="true"><rect x="7" y="9" width="34" height="34" rx="4"/><path d="M7 19h34M16 4v11M32 4v11"/><path stroke-width="3.5" d="M15 26h.1M24 26h.1M33 26h.1M15 33h.1M24 33h.1M33 33h.1M15 39h.1M24 39h.1M33 39h.1"/></svg><div><h3>Book and pay</h3><p>Pick a time, complete payment, get confirmation.</p></div></li><li><span class="hfh-step-number">3</span><svg viewBox="0 0 48 48" aria-hidden="true"><path d="M12 5C7 6 6 10 7 17C10 30 20 41 32 43C38 44 42 41 42 36L33 29Q31 28 28 32L26 34Q17 29 14 21L18 18Q20 16 18 13L15 6Q14 4 12 5Z"/></svg><div><h3>Talk privately</h3><p>Join the call at your<br class="hfh-reference-break"/> booked time.</p></div></li></ol></section>
    <section class="hfh-host-cta hfh-torn" id="earn" aria-labelledby="earn-title" data-home-section="host-cta"><div class="hfh-host-art"><img src={publicImage(`${assets}host-reference.webp`, { width: 420 })} srcset={publicImageSrcSet(`${assets}host-reference.webp`, [160, 256, 420, 640, 900])} sizes="(max-width: 767px) min(65vw, 260px), (max-width: 1023px) 19vw, (min-width: 1824px) 370px, 21vw" width="1200" height="400" loading="lazy" alt="Illustrative host welcoming his audience" /><p class="hfh-note">Create<br/>conversations<br/>Build your<br/>community</p></div><div class="hfh-host-copy"><h2 id="earn-title">Turn your audience into real conversations.</h2><p>Influencer or not, any adult can apply. Complete full KYC, create your page, set your rate, and share your link.</p><a class="hfh-button" href="/hosts/join" data-home-cta="apply-host">Apply to become a host <span aria-hidden="true">→</span></a></div><p class="hfh-note hfh-host-note">More<br/>than followers.<br/>Real people.<span aria-hidden="true">♡</span></p></section>
  </main>
  <HelloFraandsFooter />
  <nav class="mobile-bottom-nav" aria-label="Quick navigation">{[['home','#main-content','Home'],['grid','#people','Hosts'],['phone','#how-it-works','How'],['lock','#safety','Safety'],['user','#earn','Host']].map(([icon,href,label]) => <a href={href}><ModernIcon name={icon}/><span>{label}</span></a>)}</nav>
</div>
<dialog id="preview-dialog" class="hfh-preview-dialog" aria-labelledby="preview-title" aria-describedby="preview-description"><h2 id="preview-title">Illustrative preview</h2><p id="preview-description">This sample profile is an illustration. No call or payment is made.</p><a class="hfh-button" href="/marketplace">Explore real hosts →</a><button type="button" data-close-preview autofocus>Close</button></dialog>
<script>import '../lib/hostFanHome';</script>
</body>
</html>
