---
import { publicImage } from '../lib/config';
export const prerender = true;
import Base from '../layouts/Base.astro';
import Fonts from '../components/Fonts.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SpiritualHome from '../components/SpiritualHome.astro';
---
<Base
  title="Saathum: live Hindu spiritual experiences from India"
  description="Find and join live Hindu spiritual experiences from real temples and sacred places across India. Watch live, hear your name in the sankalp and receive the recording."
  image={publicImage('/assets/ideas/guides/ganga-ghat-se-shaam.jpg', { width: 1100, quality: 75, fit: 'cover', format: 'jpeg' })}
  imageAlt="A live evening spiritual experience beside the Ganga in India."
  imageWidth={1100}
  imageHeight={780}
  chrome={false}
  keywords="live puja, online darshan, Hindu spiritual experiences, live aarti India, pandit online, Saathum"
>
  <Fragment slot="head">
    <Fonts india />
    <meta property="og:image:type" content="image/jpeg" />
    <meta name="theme-color" content="#fbf1df" />
    <link rel="preload" as="image" href={publicImage('/assets/ideas/guides/ganga-ghat-se-shaam.jpg', { width: 1100, fit: 'cover' })} />
  </Fragment>
  <a class="spiritual-skip" href="#live-now">Skip to live experiences</a>
  <SiteHeader indiaLandingLanguage={true} />
  <main class="spiritual-home" data-design="spiritual-experiences-2026-09" id="main-content">
    <SpiritualHome />
  </main>
  <div class="station-footer"><SiteFooter indiaLandingLanguage={true} /></div>
</Base>
