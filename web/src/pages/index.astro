---
export const prerender = true;
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/railway-home.css';

const ideas = [
  { id: 'listener', title: 'Kisi ki baat suno', body: 'Be a human listener for someone who needs company.', format: 'Private 1:1', tone: 'pink', x: 35, y: 657, href: '/marketplace?group=find_your_people&q=listener' },
  { id: 'puja', title: 'Puja, live from home', body: 'Bring a local puja to NRIs missing home.', format: 'Live event', tone: 'yellow', x: 305, y: 657, href: '/marketplace?group=india_goes_live&q=puja' },
  { id: 'street-food', title: 'Apni gali dikhao', body: 'Host a street-food walk through your neighbourhood.', format: 'Live event', tone: 'yellow', x: 577, y: 657, href: '/marketplace?group=india_goes_live&q=food' },
  { id: 'chai', title: 'Chai pe charcha', body: 'Offer a friendly chat in your own language.', format: 'Private 1:1', tone: 'pink', x: 35, y: 911, href: '/marketplace?group=find_your_people&q=chat' },
  { id: 'english', title: 'English practice adda', body: 'Run a small group conversation session.', format: 'Group session', tone: 'blue', x: 305, y: 911, href: '/marketplace?group=book_their_time&q=English' },
  { id: 'festival', title: 'Festival ka front row', body: 'Take viewers along to your local celebrations.', format: 'Live event', tone: 'yellow', x: 577, y: 911, href: '/marketplace?group=india_goes_live&q=festival' },
];

---
<Base title="avaTOK — Get Paid to Listen, Chat & Live Stream From Home" description="Be a listener, stream a puja, or host a class. Create a free listing on avaTOK and offer paid live events, private 1:1 consultations and group sessions. Apna time. Apni kamaai." image="/ogimage.jpg" chrome={false}>
  <Fragment slot="head">
    <meta name="theme-color" content="#f7ead5" />
    <link rel="preload" as="image" href="/assets/railway/approved-ideas.jpg" />
  </Fragment>
  <a class="rail-skip" href="#marketplace-catalogue">Skip to earning ideas</a>
  <SiteHeader sticky={false} />
  <main class="rail-home" data-design="station-static-2026-09" id="main-content">
    <section class="station-hero" aria-labelledby="rail-title">
      <div class="station-frame">
        <div class="station-copy">
          <h1 id="rail-title">Apna time.<br /><span>Apni kamaai.</span></h1>
          <p>Be a listener. Stream a puja. Host a class.<br />Get paid for your time, live on avaTOK.</p>
          <div class="station-actions">
            <a class="rail-button" href="/sign-up" data-home-cta="hero-create">Create free</a>
            <a class="station-outline" href="#marketplace-catalogue" data-home-cta="hero-ideas">Explore ideas</a>
          </div>
          <p class="station-aside">India’s<br />stories travel<br />further here.</p>
        </div>
        <div class="station-art">
          <img src="/assets/railway/approved-ideas.jpg" width="865" height="1819" alt="A creator with her laptop at an Indian railway station, beside a blue train, an Apna Adda sign and a chai stall." fetchpriority="high" decoding="async" />
        </div>
      </div>
      <a class="rail-next" href="#marketplace-catalogue">Agla stop: your first idea <span aria-hidden="true">↓</span></a>
    </section>

    <section class="rail-ideas rail-wrap" id="marketplace-catalogue" aria-labelledby="ideas-title" data-home-section="ideas">
      <p class="rail-eyebrow rail-flowered"><img src="/ornament-flower.png" alt="" width="28" height="28" /> Kya offer karoge? <img src="/ornament-flower.png" alt="" width="28" height="28" /></p>
      <h2 id="ideas-title">Socha hai, isse bhi <span>kamaa sakte ho?</span></h2>
      <p class="rail-section-copy">A few ideas to get your first listing started.</p>
      <div class="rail-idea-grid">
        {ideas.map((idea) => (
          <a class="rail-idea" id={idea.id === 'listener' ? 'live-friends' : undefined} href={idea.href} data-home-idea={idea.id} aria-label={idea.title + ' — explore ' + idea.format.toLowerCase() + ' listings'}>
            <div class="rail-idea-art" aria-hidden="true">
              <img src="/assets/railway/approved-ideas.jpg" alt="" width="865" height="1819" loading="lazy" decoding="async" style={'left:' + (-idea.x / 254 * 100) + '%;top:' + (-idea.y / 140 * 100) + '%;'} />
            </div>
            <div class="rail-idea-copy">
              <h3>{idea.title}</h3><p>{idea.body}</p>
              <div class="rail-card-bottom"><span class:list={['rail-badge', 'rail-badge--' + idea.tone]}>{idea.format}</span><span class="rail-card-arrow" aria-hidden="true">↗</span></div>
            </div>
          </a>
        ))}
      </div>
      <a class="rail-explore" href="/marketplace" data-home-cta="explore-categories">Explore all categories <span aria-hidden="true">⟶</span></a>
      <p class="rail-note">Listening sessions: adults 18+ · Companionship, not therapy or emergency support.</p>
    </section>

    <section class="rail-formats rail-wrap" aria-labelledby="formats-title" id="consultations" data-home-section="formats">
      <h2 class="rail-flowered" id="formats-title"><img src="/ornament-flower.png" alt="" width="34" height="34" /> Ek platform. Teen tareeke. <img src="/ornament-flower.png" alt="" width="34" height="34" /></h2>
      <div class="rail-format-grid">
        <a id="live-streaming" href="/marketplace?group=india_goes_live" data-home-cta="format-live"><span class="rail-format-icon rail-badge--pink" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="6" width="12" height="12" rx="2" /><path d="m15 10 6-3v10l-6-3" /></svg></span><span><h3>Live events</h3><p>Sell tickets to your stream.</p></span><span aria-hidden="true">↗</span></a>
        <a href="/marketplace?group=book_their_time" data-home-cta="format-private"><span class="rail-format-icon rail-badge--yellow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="7" r="4" /><path d="M4 22v-3a8 8 0 0 1 16 0v3" /></svg></span><span><h3>1:1 sessions</h3><p>Offer your undivided time.</p></span><span aria-hidden="true">↗</span></a>
        <a id="group-sessions" href="/marketplace?group=book_their_time" data-home-cta="format-group"><span class="rail-format-icon rail-badge--blue" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="7" r="3" /><path d="M2 21v-3a7 7 0 0 1 14 0v3M16 4a3 3 0 0 1 0 6m2 4a5 5 0 0 1 4 5v2" /></svg></span><span><h3>Group sessions</h3><p>Teach or advise a small group.</p></span><span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <section class="rail-onboarding rail-wrap" aria-labelledby="ticket-title" id="how-avatok-works" data-home-section="start">
      <div class="rail-ticket">
        <div class="rail-ticket-stub"><span>AVATOK EXPRESS</span><span aria-hidden="true">GHAR SE<br />DUNIYA TAK</span></div>
        <div class="rail-ticket-main">
          <h2 id="ticket-title">Your first booking express</h2>
          <p>Four simple steps to get on board</p>
          <ol>
            <li><span>1</span>Create a listing</li>
            <li><span>2</span>Set your price</li>
            <li><span>3</span>Open your calendar</li>
            <li><span>4</span>Go live</li>
          </ol>
        </div>
        <div class="rail-ticket-end"><span>Same people.<br />New opportunities.</span><span aria-hidden="true">♥</span></div>
      </div>
      <div class="rail-last-cta"><a class="rail-button rail-button--ink" href="/sign-up" data-home-cta="footer-create">Create your free listing <span aria-hidden="true">↗</span></a><p class="rail-script">Chhoti shuruaat,<br />badi kahani.</p></div>
    </section>
  </main>
  <SiteFooter />
  <script>
    import '../lib/railwayHome';
  </script>
</Base>

