---
export const prerender = true;
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import GlobalIdeaCard from '../components/GlobalIdeaCard.astro';
import { globalCreatorIdeas } from '../lib/globalCreatorIdeas';
import '../styles/global-home.css';
const formats = [
  { id: 'live-streaming', kind: 'live', title: 'Go LIVE', description: 'Bring your whole community together.', badge: 'Live moments. Real connection.', link: 'Explore live sessions', href: '/marketplace', alt: 'A creator connecting with her audience beside a ring light.' },
  { id: 'live-friends', kind: 'call', title: 'Go 1:1', description: 'Give your biggest fans real time with you.', badge: 'Your time. A real conversation.', link: 'Explore 1:1 sessions', href: '/marketplace', alt: 'A friendly creator having a private video conversation.' },
  { id: 'creator-payouts', kind: 'paid', title: 'Get PAID', description: 'Turn the thing you love into creator income.', badge: 'Creative work. Real possibilities.', link: 'See how payouts work', href: '/payouts', alt: 'A smiling creator holding his phone and celebrating his creative business.' },
];
---
<Base title="Turn your influence into live & 1:1 income · avaTOK" description="AvaTOK helps influencers earn from their audience through paid live streams and private 1:1 video sessions, with flexible pricing and local payouts." image="/assets/global/creator-marketplace-og.png" imageAlt="A global home for creators to host paid live streams and private 1:1 video sessions." imageWidth={1536} imageHeight={1024} chrome={false}>
  <SiteHeader variant="global" />
  <main class="global-home" data-design="creator-marketplace-2026-09" id="main-content">
    <section class="global-hero global-shell" aria-labelledby="global-hero-title">
      <div class="global-hero__copy">
        <p class="global-handwritten global-hero__eyebrow">People. Ideas.<br />Income without borders.</p>
        <h1 id="global-hero-title">Your people are everywhere.<br /><span>Your income should be too.</span></h1>
        <p class="global-lead">Go live, get booked, and turn what you know into income — with local-currency payouts and payment options that depend on where you live.</p>
        <div class="global-hero__buttons"><a class="global-button global-button--red" href="/sign-up?role=creator&country=global">Start earning free <span aria-hidden="true">→</span></a><a class="global-button global-button--outline" href="#how-it-works"><span aria-hidden="true">▷</span> See how it works</a></div>
        <ul class="global-stickers" aria-label="Built around your creator business"><li class="global-sticker global-sticker--yellow"><span aria-hidden="true">◎</span> Local<br />currency</li><li class="global-sticker global-sticker--teal"><span aria-hidden="true">▥</span> Direct to<br />your bank*</li><li class="global-sticker global-sticker--lime"><span aria-hidden="true">♡</span> Your people.<br />Your income.</li></ul>
        <p class="global-hero__note">*Payout currencies and methods vary by country. <a href="/payouts">Check payout details →</a></p>
      </div>
      <div class="global-hero__art">
        <picture><source type="image/webp" srcset="/assets/global/hero-creators-480.webp 480w, /assets/global/hero-creators-960.webp 960w" sizes="(max-width: 760px) 100vw, 53vw" /><img class="global-hero__creators" src="/assets/global/hero-creators.png" alt="Diverse creators in colourful retro flares, patterned suits and oversized fashion, sharing music, beauty and creative energy." width="1122" height="1402" fetchpriority="high" decoding="async" /></picture>
        <div class="global-payout-sticker"><span>Creator income</span><strong>Your currency.<br />Your bank.</strong><small>More creating. Less complicated.</small><i aria-hidden="true">✦</i></div>
        <span class="global-art-note global-art-note--bottom" aria-hidden="true">Real talent.<br />Real people.<br />Real connection.</span>
      </div>
    </section>
    <div class="global-community-strip"><span class="global-handwritten">Big following or close-knit community.</span><span>One home for your next chapter.</span><a href="/india" aria-label="Open the existing India experience">🇮🇳 Looking for India? <span aria-hidden="true">→</span></a></div>
    <section class="global-formats global-shell global-section" id="formats" aria-labelledby="global-formats-title">
      <div class="global-section-heading"><h2 id="global-formats-title">Turn your following<br /><span>into a business.</span></h2><p>One place to go live, get booked, and build something of your own.</p></div>
      <div class="global-format-grid">{formats.map(format => <a class:list={['global-format', `global-format--${format.kind}`]} href={format.href} id={format.id}><div class="global-format__copy"><h3><span>{format.title}</span></h3><p>{format.description}</p></div><picture><source type="image/webp" srcset={`/assets/global/format-${format.kind}-480.webp 480w, /assets/global/format-${format.kind}-960.webp 960w`} sizes="(max-width: 760px) 90vw, 32vw" /><img src={`/assets/global/format-${format.kind}.png`} alt={format.alt} width="1122" height="1402" loading="lazy" decoding="async" /></picture><span class="global-format__badge">{format.badge}</span><span class="global-format__link">{format.link} ↗</span></a>)}</div>
    </section>
    <section class="global-payout global-section" id="payouts" aria-labelledby="global-payout-title"><div class="global-shell global-payout__layout">
      <div class="global-payout__copy"><p class="global-kicker">Different places. Same creative energy.</p><h2 id="global-payout-title">Your money<br /><span>should feel local.</span></h2><p class="global-lead">Create for your people. Get paid in your local currency, straight to your bank where supported.</p><p>Bank transfer, UPI in India, and other local options depend on your country. Check the available method, currency, fees and eligibility before you start.</p><a class="global-text-link" href="/payouts">Find out how payouts work <span aria-hidden="true">→</span></a><a class="global-payout__india" href="/india">🇮🇳 In India? Your familiar experience is right here →</a></div>
      <div class="global-payout-map"><picture><source type="image/webp" srcset="/assets/global/payout-world-480.webp 480w, /assets/global/payout-world-960.webp 960w" sizes="(max-width: 760px) 95vw, 53vw" /><img src="/assets/global/payout-world.png" alt="A colourful fabric collage of the world, connecting creative communities. Illustration, not a map of payout availability." width="1536" height="1024" loading="lazy" decoding="async" /></picture><span class="global-map-label global-map-label--one"><b>◎ Your community</b><small>Beyond borders</small></span><span class="global-map-label global-map-label--two"><b>▥ Your local bank</b><small>Where supported</small></span><span class="global-map-label global-map-label--three"><b>♡ Your creative work</b><small>Your next chapter</small></span><span class="global-handwritten global-map-note">Money flows.<br />People grow. ♡</span></div>
    </div></section>
    <section class="global-how global-section global-shell" id="how-it-works" aria-labelledby="global-how-title"><div class="global-section-heading"><p class="global-kicker">From your feed to your first booking</p><h2 id="global-how-title">Your thing.<br /><span>Three simple steps.</span></h2></div><ol class="global-how__steps"><li><span class="global-step-number">01</span><div><h3>Make it yours.</h3><p>Choose a live session or private 1:1. Set your topic, time and price.</p></div></li><li><span class="global-step-number">02</span><div><h3>Bring your people.</h3><p>Share your booking link with your YouTube, TikTok or Instagram community.</p></div></li><li><span class="global-step-number">03</span><div><h3>Show up. Connect.</h3><p>Host the moment they booked. Manage your earnings and available payout options.</p></div></li></ol></section>
    <section class="global-ideas-section global-section global-shell" id="group-sessions" aria-labelledby="global-ideas-title"><div class="global-section-heading"><p class="global-kicker">Your next creator business</p><h2 id="global-ideas-title">Turn your content into<br /><span>moments people can book.</span></h2><p>Eight starting points for YouTube, TikTok and Instagram creators.</p></div><div class="global-ideas-grid">{globalCreatorIdeas.map(idea => <GlobalIdeaCard idea={idea} />)}</div><div class="global-ideas-section__more"><a class="global-button global-button--outline" href="/global-ideas">Explore all ideas <span aria-hidden="true">→</span></a></div><p class="global-formats-tape"><span aria-hidden="true">◎</span> Live events · Private 1:1 · Group sessions · Local payouts <span aria-hidden="true">♡</span></p></section>
    <section class="global-cta" aria-labelledby="global-cta-title"><div class="global-shell global-cta__inner"><span class="global-handwritten" aria-hidden="true">A more creative<br />world. Together. ♡</span><h2 id="global-cta-title">Your people are waiting.</h2><a class="global-button global-button--light" href="/sign-up?role=creator&country=global">Create your free listing <span aria-hidden="true">→</span></a></div></section>
  </main>
  <SiteFooter variant="global" />
</Base>
