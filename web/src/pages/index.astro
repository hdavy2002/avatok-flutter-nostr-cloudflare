---
export const prerender = true;
import brandConfig from '../../../Specs/brand.json';
import ModernIcon from '../components/home/ModernIcon.astro';
import HelloFraandsHeader from '../components/callvaal/Header.astro';
import HelloFraandsFooter from '../components/callvaal/Footer.astro';
import CreatorPreviewCard from '../components/callvaal/CreatorPreviewCard.astro';
import { creatorPreviews, homeCopy } from '../lib/hostFanHomeReference';
import '../styles/callvaal-notebook.css';
import '../styles/host-fan-home.css';
const identity = brandConfig.homepageIdentity;
const title = `${homeCopy.heroTitle} | ${identity.name}`;
const description = homeCopy.heroDescription;
const canonical = `https://${identity.domain}/`;
const assets = '/assets/callvaal/host-fan/';
---
<!doctype html>
<html lang="en-IN">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title><meta name="description" content={description} /><link rel="canonical" href={canonical} /><meta name="theme-color" content="#46113e" /><meta name="robots" content="index,follow" />
  <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'WebPage', name: title, description, url: canonical, inLanguage: 'en-IN' })} />
  <meta property="og:type" content="website" /><meta property="og:site_name" content={identity.name} /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} />
  <meta property="og:image" content={`${canonical}assets/callvaal/host-fan/hero.jpg`} /><meta property="og:image:alt" content="An illustrative creator smiling at her phone against teal and yellow scrapbook paper." />
  <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={`${canonical}assets/callvaal/host-fan/hero.jpg`} />
  <link rel="icon" href="/assets/callvaal/notebook/favicon.svg" type="image/svg+xml" />
  <link data-site-fonts rel="preload" href="/fonts/Comfortaa-Bold.ttf" as="font" type="font/ttf" crossorigin /><link rel="preload" href="/fonts/Nunito-Black.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/Fredoka-Bold.woff2" as="font" type="font/woff2" crossorigin />
</head>
<body>
<div class="notebook-site" data-design="callvaal-scrapbook">
  <a class="skip-link" href="#main-content">Skip to main content</a>
  <HelloFraandsHeader />
  <main id="main-content" class="hfh-home">
    <aside class="hfh-beta"><span aria-hidden="true">⌁</span> INVITE ONLY · BETA PHASE <span aria-hidden="true">⌁</span></aside>
    <section class="hfh-hero" aria-labelledby="hero-title" data-home-section="hero">
      <div class="hfh-hero-copy">
        <h1 id="hero-title">Talk to your favourite social media influencers <em>over a private phone call.</em></h1>
        <p>{homeCopy.heroDescription}</p>
        <div class="hfh-actions"><a class="hfh-button" href="/marketplace" data-home-cta="explore-hosts">Explore hosts <span aria-hidden="true">→</span></a><a class="hfh-button hfh-button--outline" href="/hosts/join" data-home-cta="become-host">Become a host</a></div>
        <ul class="hfh-proof" aria-label="Call safeguards"><li><ModernIcon name="user" />Full KYC</li><li><ModernIcon name="lock" />Private numbers</li><li><ModernIcon name="payment" />Secure payments</li></ul>
      </div>
      <div class="hfh-collage" aria-label="Illustrative private call and booking preview">
        <img class="hfh-hero-photo" src={`${assets}hero.webp`} width="1000" height="1250" fetchpriority="high" alt="Illustrative creator in a colourful kurta smiling at her phone" />
        <p class="hfh-note hfh-note--same">Same people.<br/>Deeper conversations.<span aria-hidden="true">♡</span></p>
        <p class="hfh-note hfh-note--time">You<br/>set the time.</p>
        <div class="hfh-picker" aria-label="Sample booking times, illustration only"><strong><ModernIcon name="clock" />Pick a time</strong><div class="hfh-week" aria-hidden="true"><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span></div><div class="hfh-times"><span>11:00 AM</span><span class="hfh-time-selected">12:30 PM</span><span>4:00 PM</span><span>7:00 PM</span></div></div>
        <div class="hfh-share"><strong><span aria-hidden="true">↗</span> Your link</strong><span class="hfh-share-url">{identity.domain}/yourname</span><span class="hfh-share-caption">♧&nbsp; Share with your fans</span></div>
        <div class="hfh-call-photo"><img src={`${assets}host.webp`} width="600" height="750" alt="Illustrative host waving hello on a private call" /><div class="hfh-call-controls" aria-hidden="true"><span>♩</span><span><ModernIcon name="phone" /></span><span>▣</span></div></div>
        <p class="hfh-note hfh-note--real">Real people.<br/>Real talks.</p>
      </div>
    </section>
    <section class="hfh-creators hfh-torn" id="people" aria-labelledby="people-title" data-home-section="creators">
      <span id="moods" class="hfh-anchor" aria-hidden="true"></span><span id="naye-dost" class="hfh-anchor" aria-hidden="true"></span>
      <div class="hfh-section-heading"><div><h2 id="people-title">Book time with creators you follow</h2><p>Verified hosts. Real conversations. Pick a time that works.</p></div><a href="/marketplace" data-home-cta="view-all-hosts">View all hosts <span aria-hidden="true">→</span></a></div>
      <p class="hfh-sample-label" id="sample-disclosure">Sample profiles · Illustrative names, photos, verification badges, ratings, availability and prices.</p>
      <div class="hfh-creator-grid">{creatorPreviews.map(profile => <CreatorPreviewCard profile={profile} />)}</div>
      <p class="hfh-disclosure">These are illustrative previews. No audio plays and no call or payment is made. Explore hosts to see real profiles and availability.</p>
    </section>
    <section class="hfh-privacy hfh-torn" id="safety" aria-labelledby="privacy-title" data-home-section="privacy">
      <div id="privacy-note"><h2 id="privacy-title">Your number stays yours.</h2><p>Our system calls the fan and the host separately, then securely connects the calls. We never reveal either person’s personal phone number.</p><div class="hfh-privacy-links"><a href="/privacy" data-home-cta="privacy">How we protect your privacy →</a><a href="/safety" data-home-cta="safety">Safety →</a></div></div>
      <figure class="hfh-connection" aria-label={`Fan and host connect through ${identity.name}. Both personal phone numbers stay private.`}>
        <div class="hfh-person"><img src={`${assets}hero.webp`} width="1000" height="1250" loading="lazy" alt="Illustrative fan on her phone" /><strong>Fan</strong></div>
        <span class="hfh-connector-arrow" aria-hidden="true">⇢</span>
        <div class="hfh-secure"><svg viewBox="0 0 80 88" aria-hidden="true"><path d="M40 3 73 15l-3 28Q64 70 40 84 15 70 10 43L7 15Z" fill="#116b70"/><path d="m25 24 9-2 5 12-6 5q5 10 15 13l5-7 12 6-1 9q-1 8-14 5Q21 54 19 32q-1-6 6-8" fill="white"/><path d="M46 20q14 4 17 17M46 28q7 2 9 9" fill="none" stroke="white" stroke-width="3" stroke-linecap="round"/></svg><strong>{identity.name}<br/>connects</strong></div>
        <span class="hfh-connector-arrow" aria-hidden="true">⇠</span>
        <div class="hfh-person"><img src={`${assets}arjun.webp`} width="800" height="600" loading="lazy" alt="Illustrative host" /><strong>Host</strong></div>
        <figcaption>Two private calls. One conversation.</figcaption>
      </figure>
    </section>
    <div class="hfh-lanes" data-home-section="lanes">
      <section class="hfh-lane hfh-lane--women hfh-torn" id="women-only" aria-labelledby="women-title"><div class="hfh-lane-copy"><h2 id="women-title">Women with women</h2><p>A private space for women to book conversations with verified women hosts.</p><p class="hfh-kyc"><ModernIcon name="lock" />Video KYC required</p><a class="hfh-button" href="/marketplace?lane=women#people" data-home-cta="women-hosts">Explore women hosts <span aria-hidden="true">→</span></a></div><div class="hfh-lane-art"><img src={`${assets}women.webp`} width="800" height="600" loading="lazy" alt="Two illustrative women enjoying phone conversations" /><p class="hfh-note">More women.<br/>More conversations.<span aria-hidden="true">♡</span></p></div></section>
      <section class="hfh-lane hfh-lane--community hfh-torn" id="lgbtq" aria-labelledby="lgbtq-title"><div class="hfh-lane-copy"><h2 id="lgbtq-title">LGBTQ+ with LGBTQ+</h2><p>A respectful space for LGBTQ+ fans to book conversations with hosts from the community.</p><p class="hfh-kyc"><ModernIcon name="lock" />Video KYC required</p><a class="hfh-button" href="/marketplace?lane=lgbtq#people" data-home-cta="lgbtq-hosts">Explore LGBTQ+ hosts <span aria-hidden="true">→</span></a></div><div class="hfh-lane-art"><img src={`${assets}community.webp`} width="800" height="600" loading="lazy" alt="Two illustrative community members enjoying phone conversations beside a rainbow flag" /><p class="hfh-note">Different stories.<br/>Same respect.</p></div></section>
    </div>
    <p class="hfh-eligibility">Video KYC verifies the person, not their gender or sexual orientation. Community access follows each space’s eligibility and safety rules.</p>
    <section class="hfh-how" id="how-it-works" aria-labelledby="how-title" data-home-section="how-it-works"><h2 id="how-title">How it works</h2><ol class="hfh-steps"><li><span class="hfh-step-number">1</span><svg viewBox="0 0 48 48" aria-hidden="true"><circle cx="20" cy="20" r="14"/><path d="m30 30 13 13"/></svg><div><h3>Choose a host</h3><p>Find creators you follow and like.</p></div></li><li><span class="hfh-step-number">2</span><svg viewBox="0 0 48 48" aria-hidden="true"><rect x="7" y="9" width="34" height="33" rx="3"/><path d="M7 20h34M16 4v12M32 4v12M16 27h1m7 0h1m7 0h1M16 34h1m7 0h1m7 0h1"/></svg><div><h3>Book and pay</h3><p>Pick a time, complete payment, get confirmation.</p></div></li><li><span class="hfh-step-number">3</span><ModernIcon name="phone" /><div><h3>Talk privately</h3><p>Join the call at your booked time.</p></div></li></ol></section>
    <section class="hfh-host-cta hfh-torn" id="earn" aria-labelledby="earn-title" data-home-section="host-cta"><div class="hfh-host-art"><img src={`${assets}host.webp`} width="600" height="750" loading="lazy" alt="Illustrative host welcoming his audience" /><p class="hfh-note">Create conversations.<br/>Build your community.</p></div><div class="hfh-host-copy"><h2 id="earn-title">Turn your audience into real conversations.</h2><p>Influencer or not, any adult can apply. Complete full KYC, create your page, set your rate, and share your link.</p><a class="hfh-button" href="/hosts/join" data-home-cta="apply-host">Apply to become a host <span aria-hidden="true">→</span></a></div><p class="hfh-note hfh-host-note">More than followers.<br/>Real people.<span aria-hidden="true">♡</span></p></section>
  </main>
  <HelloFraandsFooter />
  <nav class="mobile-bottom-nav" aria-label="Quick navigation">{[['home','#main-content','Home'],['grid','#people','Hosts'],['phone','#how-it-works','How'],['lock','#safety','Safety'],['user','#earn','Host']].map(([icon,href,label]) => <a href={href}><ModernIcon name={icon}/><span>{label}</span></a>)}</nav>
</div>
<dialog id="preview-dialog" class="hfh-preview-dialog" aria-labelledby="preview-title" aria-describedby="preview-description"><h2 id="preview-title">Illustrative preview</h2><p id="preview-description">This sample profile is an illustration. No call or payment is made.</p><a class="hfh-button" href="/marketplace">Explore real hosts →</a><button type="button" data-close-preview autofocus>Close</button></dialog>
<script>import '../lib/hostFanHome';</script>
</body>
</html>
