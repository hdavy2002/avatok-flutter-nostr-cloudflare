---
export const prerender = true;
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import FolkArtwork from '../components/FolkArtwork.astro';
import FolkIcon from '../components/FolkIcon.astro';
import BookingArtwork from '../components/BookingArtwork.astro';
import GrandHero from '../components/GrandHero.astro';
import { publicImage } from '../lib/config';
import '../styles/saathum-folk.css';

const categories = [
  { name: 'puja', label: 'Puja & Archana', term: 'Puja' },
  { name: 'aarti', label: 'Aarti & Darshan', term: 'Aarti' },
  { name: 'bhajan', label: 'Bhajan & Kirtan', term: 'Bhajan' },
  { name: 'satsang', label: 'Satsang', term: 'Satsang' },
  { name: 'festival', label: 'Festivals', term: 'Festival' },
  { name: 'yoga', label: 'Yoga & Meditation', term: 'Yoga' },
] as const;

const listings = [
  { name: 'aarti', title: 'An evening by the Ganga', label: 'Aarti & Darshan', term: 'Aarti', host: 'Pandit Raghav', city: 'Varanasi', price: '₹299', schedule: 'Live now', scheduleTone: 'live', timing: 'Today · 7:30 PM', rating: '4.9', reviews: '128', description: 'A glowing riverside aarti with bells, lamps and a view of the Ganga at dusk.' },
  { name: 'puja', title: 'Morning puja, from home', label: 'Puja & Archana', term: 'Puja', host: 'Maa Sharda Seva', city: 'Haridwar', price: '₹199', schedule: 'Starts in 2h', scheduleTone: 'soon', timing: 'Today · 8:00 AM', rating: '4.8', reviews: '96', description: 'Begin the day with a personal sankalp, fresh flowers and a gentle home puja.' },
  { name: 'bhajan', title: 'Bhajans that bring us together', label: 'Bhajan & Kirtan', term: 'Bhajan', host: 'Meera & The Mandali', city: 'Jaipur', price: '₹249', schedule: 'Live now', scheduleTone: 'live', timing: 'Today · 6:00 PM', rating: '4.9', reviews: '214', description: 'Sing along to familiar bhajans with a warm live group from a Jaipur temple.' },
  { name: 'satsang', title: 'An hour of quiet satsang', label: 'Satsang', term: 'Satsang', host: 'Swami Anant', city: 'Rishikesh', price: '₹349', schedule: 'Tomorrow', scheduleTone: 'soon', timing: 'Tomorrow · 6:30 AM', rating: '4.7', reviews: '74', description: 'A small, thoughtful gathering for reflection, questions and a calmer start.' },
  { name: 'festival', title: 'Festival lights, wherever you are', label: 'Festivals', term: 'Festival', host: 'Asha Cultural House', city: 'Delhi', price: '₹399', schedule: 'This weekend', scheduleTone: 'soon', timing: 'Sat · 8:00 PM', rating: '4.8', reviews: '153', description: 'Bring the family together for stories, music and festival rituals streamed live.' },
  { name: 'yoga', title: 'Sunrise yoga by the river', label: 'Yoga & Meditation', term: 'Yoga', host: 'Anaya Wellness', city: 'Pune', price: '₹179', schedule: '3 seats left', scheduleTone: 'limited', timing: 'Sun · 6:00 AM', rating: '4.9', reviews: '61', description: 'Move, breathe and settle into a devotional sunrise practice for every level.' },
  { name: 'aarti', title: 'Deepdaan on the ghats', label: 'Aarti & Darshan', term: 'Aarti', host: 'Ganga Jyoti Trust', city: 'Varanasi', price: '₹229', schedule: 'Tonight', scheduleTone: 'soon', timing: 'Today · 8:15 PM', rating: '4.8', reviews: '89', description: 'Offer a lamp in your name and watch the evening river ceremony unfold.' },
  { name: 'puja', title: 'Ganesh puja for new beginnings', label: 'Puja & Archana', term: 'Puja', host: 'Shree Ganesh Seva', city: 'Mumbai', price: '₹299', schedule: 'Book now', scheduleTone: 'open', timing: 'Fri · 9:00 AM', rating: '4.9', reviews: '112', description: 'A joyful, guided Ganesh puja for homes, milestones and fresh starts.' },
  { name: 'bhajan', title: 'A softer evening with mantra', label: 'Bhajan & Kirtan', term: 'Bhajan', host: 'Kirtan by Nandini', city: 'Bengaluru', price: '₹149', schedule: 'Tomorrow', scheduleTone: 'soon', timing: 'Tomorrow · 7:00 PM', rating: '4.8', reviews: '47', description: 'Slow down with live mantra, harmonium and a welcoming circle of listeners.' },
] as const;

const search = (term: string) => '/marketplace?q=' + encodeURIComponent(term);
const avatarFor = (name: string) => ({ satsang: 'aarti', festival: 'puja', yoga: 'bhajan' } as Record<string, string>)[name] ?? name;
---
<Base title="Saathum | Book Hindu religious experiences online"
  description="Book live Hindu religious experiences from India. Explore pujas, aartis, bhajans and satsangs, then join from wherever you are."
  image={publicImage('/assets/saathum-grand/hero.png', { width: 1280, fit: 'scale-down', format: 'jpeg' })}
  imageAlt="A sunset Ganga aarti framed by a grand Indian arch."
  chrome={false} indiaLandingLanguage={false}>
  <Fragment slot="head">
    <meta name="theme-color" content="#fff8e8" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Comfortaa:wght@400;500;600;700&family=Nunito:wght@400;600;700;800;900&display=swap" />
  </Fragment>
  <div class="folk-site" data-design="saathum-reference-v5" style={`--folk-border-url:url(${publicImage('/assets/saathum-bright/border.png', { width: 640, fit: 'scale-down' })})`}>
    <a class="folk-skip" href="#main-content">Skip to main content</a>
    <div class="folk-ribbon" aria-hidden="true" style={`--folk-border-url:url(${publicImage('/assets/saathum-bright/border.png', { width: 640, fit: 'scale-down' })})`}></div>
    <SiteHeader folk indiaLandingLanguage={false} responsiveHome referenceHome
      links={[{ href: '/marketplace', label: 'Explore events' }, { href: '/#experiences', label: 'Experiences' }, { href: '/#joining', label: 'How it works' }]} />
    <main id="main-content">
      <section class="grand-hero" aria-labelledby="grand-title" data-home-section="hero">
        <div class="grand-hero-copy">
          <p class="grand-eyebrow">LIVE FROM INDIA · JOIN FROM ANYWHERE</p>
          <h1 id="grand-title">Close to your roots.<br /><em>Wherever you are.</em></h1>
          <p class="grand-lead">Book live pujas, aartis and satsangs from India. Join from wherever you call home.</p>
          <div class="grand-actions">
            <a class="grand-button" href="/marketplace" data-home-cta="hero-explore-events">Explore events <span aria-hidden="true">→</span></a>
            <a class="grand-link" href="#experiences" data-home-cta="hero-find-experience">Find your experience <span aria-hidden="true">→</span></a>
          </div>
          <p class="grand-quiet">Different places. Same devotion.</p>
        </div>
        <div class="grand-hero-art">
          <GrandHero eager sizes="(max-width: 600px) 94vw, 52vw" alt="A sunset Ganga aarti glowing beneath an ornate Indian arch, with a peacock and elephant in the foreground." />
        </div>
      </section>

      <div class="grand-divider" aria-hidden="true"></div>

      <section class="grand-experiences" id="experiences" aria-labelledby="grand-experiences-title" data-home-section="experiences">
        <div class="grand-section-heading">
          <h2 id="grand-experiences-title"><span aria-hidden="true">✽</span> Find your spiritual moment <span aria-hidden="true">✽</span></h2>
        </div>
        <div class="grand-category-grid">
          {categories.map(category => <a class="grand-category" href={search(category.term)} data-home-cta={'experience-' + category.term.toLowerCase()}>
            <BookingArtwork kind="category" name={category.name} alt={category.label + ' devotional scene in an ornate Indian arch.'} sizes="(max-width: 600px) 46vw, (max-width: 1100px) 30vw, 15vw" />
            <div class="grand-category-copy"><h3>{category.label}</h3><span class="grand-arrow" aria-hidden="true">↗</span></div>
          </a>)}
        </div>
      </section>

      <section class="grand-moments" id="home-events" aria-labelledby="grand-moments-title" data-home-section="home_events">
        <div class="grand-moments-inner">
          <div class="grand-section-heading">
            <h2 id="grand-moments-title"><span aria-hidden="true">✽</span> Moments to look forward to</h2>
            <a class="grand-link" href="/marketplace" data-home-cta="all-events">View all events <span aria-hidden="true">→</span></a>
          </div>
          <div class="grand-listing-grid">
            {listings.map((listing, i) => <article class="grand-listing" data-listing-index={i}>
              <div class="grand-listing-art-wrap">
                <a class="grand-listing-art" href={search(listing.term)} aria-label={listing.title + ' — explore ' + listing.label} data-home-cta={'moment-' + listing.term.toLowerCase()}>
                  <span class:list={['grand-sample-badge', 'grand-sample-badge--' + listing.scheduleTone]}>{listing.schedule}</span>
                  <BookingArtwork kind="listing" name={avatarFor(listing.name)} alt={listing.title + ' devotional experience from India.'} sizes="(max-width: 600px) 92vw, 31vw" />
                </a>
                <button class="grand-favourite" type="button" aria-label={'Add ' + listing.title + ' to favourites'} aria-pressed="false" data-favorite="true">♡</button>
              </div>
              <div class="grand-listing-copy">
                <div class="grand-listing-heading"><h3><a href={search(listing.term)}>{listing.title}</a></h3><span class="grand-listing-price">{listing.price}</span></div>
                <div class="grand-listing-host"><img src={publicImage(`/assets/saathum-booking/listing-${avatarFor(listing.name)}.png`, { width: 72, fit: 'cover' })} alt="" width="32" height="32" /> <span>{listing.host}</span></div>
                <p class="grand-listing-description">{listing.description}</p>
                <div class="grand-listing-info"><span class="grand-city-pill">● {listing.city}</span><span class="grand-listing-time">{listing.timing}</span></div>
                <div class="grand-listing-footer"><span class="grand-rating" aria-label={listing.rating + ' out of 5 from ' + listing.reviews + ' reviews'}>★ {listing.rating} <small>({listing.reviews})</small></span><a class="grand-booking-link" href={search(listing.term)} data-home-cta={'sample-book-' + listing.term.toLowerCase()}>Book now <span aria-hidden="true">→</span></a></div>
              </div>
            </article>)}
          </div>
          <p class="grand-editorial-note">These are illustrative moments. Browse the marketplace for current events, hosts and availability.</p>
          <noscript><p><a href="/marketplace">Browse all events</a> and book your place.</p></noscript>
        </div>
      </section>

      <section class="grand-belonging" id="benefits" aria-labelledby="grand-benefits-title" data-home-section="benefits">
        <div class="grand-belonging-inner">
          <div class="grand-belonging-art"><FolkArtwork name="satsang" sizes="(max-width: 600px) 90vw, 32vw" alt="A mature woman spiritual teacher seated with women participants in colorful Indian folk art." /></div>
          <div class="grand-belonging-copy"><h2 id="grand-benefits-title">Far from home.<br />Close to your traditions.</h2><p>Familiar voices, shared rituals, meaningful moments.</p></div>
          <div class="grand-joining" id="joining" data-home-section="joining">
            <h2 class="grand-visually-hidden">Three simple steps to join live.</h2>
            <ol class="grand-step-grid" aria-label="How to join a live event">
              <li><a href="/marketplace" data-home-cta="joining-explore"><FolkIcon kind="search" /><span class="grand-step-number">01</span><span class="grand-step-label">Explore</span></a></li>
              <li><a href="/help/booking-and-paying/find-a-creator-or-show" data-home-cta="joining-book"><FolkIcon kind="ticket" /><span class="grand-step-number">02</span><span class="grand-step-label">Book</span></a></li>
              <li><a href="/help/booking-and-paying/join-a-live-show" data-home-cta="joining-help"><FolkIcon kind="live" /><span class="grand-step-number">03</span><span class="grand-step-label">Join live</span></a></li>
            </ol>
          </div>
        </div>
      </section>

      <section class="grand-organise" id="organise-invite" aria-labelledby="grand-organise-title" data-home-section="organise_invite">
        <div class="grand-elephant grand-elephant--left"><img src={publicImage('/assets/saathum-booking/elephant.png', { width: 360, fit: 'scale-down' })} alt="" width="1536" height="1024" loading="lazy" decoding="async" /></div>
        <div class="grand-organise-copy"><h2 id="grand-organise-title">Bring your community together.</h2><p>Host a spiritual experience on Saathum.</p><a class="grand-button" href="/organisers" data-home-cta="organise-invite">Become an organiser <span aria-hidden="true">↗</span></a></div>
        <div class="grand-elephant grand-elephant--right"><img src={publicImage('/assets/saathum-booking/elephant.png', { width: 360, fit: 'scale-down' })} alt="" width="1536" height="1024" loading="lazy" decoding="async" /></div>
      </section>

      <p class="grand-booking-note">Saathum is a marketplace where event organisers sell tickets to live online spiritual events. Attendees book and pay online; refunds follow our <a href="/refunds">published policy</a>.</p>
    </main>
    <SiteFooter folk indiaLandingLanguage={false} />
  </div>
  <script>
    import '../lib/railwayHome';
    document.querySelectorAll<HTMLButtonElement>('[data-favorite]').forEach((button) => {
      button.addEventListener('click', () => {
        const active = button.getAttribute('aria-pressed') === 'true';
        button.setAttribute('aria-pressed', String(!active));
        button.textContent = active ? '♡' : '♥';
        button.setAttribute('aria-label', active ? 'Add to favourites' : 'Remove from favourites');
      });
    });
  </script>
</Base>
