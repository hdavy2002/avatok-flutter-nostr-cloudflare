---
export const prerender = true;
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { globalCreatorIdeas } from '../lib/globalCreatorIdeas';
import '../styles/global-home.css';
---
<Base title="Turn your influence into live & 1:1 income · avaTOK" description="AvaTOK helps influencers earn from their audience through paid live streams and private 1:1 video sessions, with flexible pricing and local payouts." image="/assets/home/avatok-creator-constellation.png" imageAlt="International creators hosting live streams and private video sessions." imageWidth={1156} imageHeight={1360} chrome={false}>
  <SiteHeader variant="global" />
  <main class="global-home" data-design="creator-marketplace-2026-09" id="main-content">
    <span id="live-streaming"></span><span id="live-friends"></span><span id="group-sessions"></span>
    <section class="global-intro"><p class="global-kicker">A GLOBAL CREATOR MARKETPLACE</p><h1>Your people are everywhere.<br /><span>Your income should be too.</span></h1><p class="global-lead">Go live, get booked, and turn what you know into income — paid out in the currency and payment method that works where you live.</p><p style="margin-top:1.5rem"><a class="global-button" href="/sign-up?role=creator&country=global">Start earning free →</a> <a class="global-button" href="#formats" style="background:transparent">See how it works</a></p></section>
    <section class="global-ideas-grid" id="formats" aria-label="Ways to earn"><article class="global-idea"><div class="global-idea__art global-idea__art--yellow"><span class="global-idea__platform">LIVE</span><span class="global-idea__scribble">Bring your whole community together.</span></div><div class="global-idea__body"><h2>Go live</h2><p>Sell access to a stream, premiere, workshop or community event.</p><a class="global-idea__link" href="/marketplace">Explore live sessions ↗</a></div></article><article class="global-idea"><div class="global-idea__art global-idea__art--blue"><span class="global-idea__platform">1:1 VIDEO</span><span class="global-idea__scribble">Give your biggest fans real time with you.</span></div><div class="global-idea__body"><h2>Go 1:1</h2><p>Offer private bookable time for advice, conversation or coaching.</p><a class="global-idea__link" href="/marketplace">Explore 1:1 sessions ↗</a></div></article><article class="global-idea"><div class="global-idea__art global-idea__art--lime"><span class="global-idea__platform">PAYOUTS</span><span class="global-idea__scribble">Keep 80%. Get paid locally.</span></div><div class="global-idea__body"><h2>Get paid</h2><p>Choose the payout method and currency that works where you live.</p><a class="global-idea__link" href="/pricing-fees">See pricing & fees ↗</a></div></article></section>
    <section class="global-intro" style="padding-top:5rem"><p class="global-kicker">YOUR NEXT CREATOR BUSINESS</p><h2 style="font-family:'Playfair Display',Georgia,serif;font-size:clamp(2.5rem,5vw,5rem);margin:.5rem auto 1rem">What could you sell to your audience?</h2><p class="global-lead">Eight starting points for YouTube, TikTok and Instagram creators.</p></section>
    <section class="global-ideas-grid" aria-label="Global creator ideas">{globalCreatorIdeas.map((idea) => <article class="global-idea"><div class:list={['global-idea__art', `global-idea__art--${idea.color}`]}><span class="global-idea__platform">{idea.platform}</span><span class="global-idea__scribble">{idea.eyebrow}<br />make it yours ↗</span></div><div class="global-idea__body"><h2>{idea.title}</h2><p>{idea.description}</p><a class="global-idea__link" href={`/blog/global-creator-ideas/${idea.slug}/`}>Read the guide ↗</a></div></article>)}</section>
    <div class="global-proof" id="payouts"><span>Local currency · Direct to your bank · You keep 80%</span><span id="language"><a href="/payouts">How payouts work →</a> · <a href="/india">🇮🇳 India experience</a> · EN</span></div>
    <section class="global-cta" id="how-it-works"><h2>Your people are waiting.</h2><a class="global-button" href="/sign-up?role=creator&country=global">Create your free listing →</a></section>
  </main>
  <SiteFooter variant="global" />
</Base>
