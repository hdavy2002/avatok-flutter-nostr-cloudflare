---
// Smart "Add me on Saa Thum" landing (owner request 2026-06-29).
// A shared QR/link points here. On a phone with Saa Thum installed, the
// `avatok://add?...` deep link opens the app straight to Add Contact; otherwise
// we fall back to the Play Store after a short delay.
//
// [WEB-SEO-4] Routed through Base so it carries canonical/robots/OG/analytics
// like every other public page. noindex=true: this is a share-link landing
// target for people who already have a QR/link, not a page anyone should find
// via search, and it immediately navigates away — there's nothing for a
// crawler to index. chrome={false}: this is a standalone deep-link bounce
// screen, not a browsing page — it deliberately has no site header/footer.
import Base from '../layouts/Base.astro';

const PLAY_STORE = 'https://play.google.com/store/apps/details?id=com.saathum.app'; // real applicationId (build.gradle.kts)
---
<Base
  title="Add me on Saa Thum"
  description="Add a friend on Saa Thum — opens straight in the app if you have it installed, or takes you to get the app."
  chrome={false}
  noindex={true}
>
  <Fragment slot="head">
    <style>
      :root { color-scheme: light; }
      .add-page, .add-page * { box-sizing: border-box; }
      .add-page {
        margin: 0; min-height: 100vh; display: grid; place-items: center;
        background: #eef0e6; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; color: #0e1116;
      }
      .add-page .card {
        width: min(92vw, 420px); background: #fff; border: 2px solid #0e1116;
        border-radius: 18px; box-shadow: 6px 6px 0 #0e1116; padding: 28px 24px; text-align: center;
      }
      .add-page h1 { font-size: 26px; margin: 0 0 6px; letter-spacing: 0.03em; }
      .add-page .brand { color: #2b59ff; }
      .add-page p { color: #4a5159; margin: 6px 0 20px; }
      .add-page .btn {
        display: inline-block; width: 100%; padding: 14px 18px; border-radius: 12px;
        background: #c8f64f; color: #0e1116; font-weight: 800; text-decoration: none;
        border: 2px solid #0e1116; box-shadow: 3px 3px 0 #0e1116;
      }
      .add-page .btn.alt { background: #fff; margin-top: 10px; }
      .add-page .foot { margin-top: 16px; font-size: 12px; color: #8a9099; }
    </style>
  </Fragment>

  <div class="add-page">
    <main class="card">
      <h1><ui-copy style="display:contents" data-i18n="web-add.fefae4eded096cdd">Add me on</ui-copy> <span class="brand">Saa Thum</span></h1>
      <p data-i18n="web-add.5180bc4749c9ddf2" id="sub">Opening Saa Thum…</p>
      <a data-i18n="web-add.3ec572aaed90208f" id="open" class="btn" href="#">Open in Saa Thum</a>
      <a data-i18n="web-add.15ef34a6e991f40a" id="store" class="btn alt" href={PLAY_STORE}>Get Saa Thum</a>
      <div data-i18n="web-add.6c268582050557ce" class="foot">saathum.com</div>
    </main>
  </div>
  <script define:vars={{ store: PLAY_STORE }}>
    const p = new URLSearchParams(location.search);
    const t = p.get('t');
    const n = p.get('n');
    const q = t ? 't=' + encodeURIComponent(t) : (n ? 'n=' + encodeURIComponent(n) : '');
    const deep = 'avatok://add' + (q ? '?' + q : '');
    const openLink = document.getElementById('open');
    openLink.setAttribute('href', deep);
    let left = false;
    const markLeft = () => { left = true; };
    window.addEventListener('pagehide', markLeft);
    window.addEventListener('blur', markLeft);
    document.addEventListener('visibilitychange', () => { if (document.hidden) markLeft(); });
    // Auto-attempt the deep link; if we're still here shortly after, the app
    // isn't installed → send to the store.
    try { location.href = deep; } catch (_) {}
    setTimeout(() => { if (!left) location.href = store; }, 1600);
  </script>
</Base>
