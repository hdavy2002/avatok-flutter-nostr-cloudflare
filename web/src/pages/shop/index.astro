---
// [SAATHUM-SHOP-WEB-STORE-1 2026-10-01] /shop — the Shop home: an exact build of the owner-approved mockup (Specs/shop-mockup, "Shop home" view).
// Spec: Specs/SPEC-2026-10-01-SAATHUM-SHOP.md §5.3.
// [SAATHUM-SHOP-EDITOR-1 2026-10-01] The page is now a list of BLOCKS (islands/shop/blocks/*) rendered from the owner's published
// Puck page (GET /api/shop/home -> page + resolved); with nothing published it renders defaultPage.ts = the page exactly as it was.
//
// NOTE FOR AI:
//  - REAL DATA ONLY from GET /api/shop/home. Never add sample products "so it looks full". With no live products the page still
//    renders its structure: hero with the mockup copy, an empty-state box under New arrivals and the featured banner (mockup copy);
//    "Shop by collection" appears once a collection has a live product and Bestsellers once a product is flagged Bestseller.
//    [SAATHUM-SHOP-EDITOR-2] New arrivals / Bestsellers = the product flags (New arrival / Bestseller in Admin -> Shop -> Products).
//  - Photos: hero / collection / banner / product photos come from the API and fill the same boxes with object-fit:cover; a missing
//    photo shows the mockup's striped `.sh-ph` placeholder (spec §0.2).
//  - SSR (prerender = false) with the same 60 s public cache header + edge cache as /marketplace (middleware.ts).
//  - Islands: only the hero (its dots) and a rail that has products (heart + quick add) are `client:idle`; everything else is plain
//    SSR HTML. NEVER import @puckeditor/core here — Puck lives only in the admin editor chunk.
//  - Markup/classes of every block are the old page's, moved into the block components; do not restyle them here.
export const prerender = false;

import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import ShopHeroBlock from '../../islands/shop/blocks/ShopHeroBlock';
import CollectionGridBlock from '../../islands/shop/blocks/CollectionGridBlock';
import ProductRailBlock from '../../islands/shop/blocks/ProductRailBlock';
import FeaturedBannerBlock from '../../islands/shop/blocks/FeaturedBannerBlock';
import PhotoBannerBlock from '../../islands/shop/blocks/PhotoBannerBlock';
import TextSectionBlock from '../../islands/shop/blocks/TextSectionBlock';
import ShopTelemetry from '../../islands/shop/ShopTelemetry';
import { buildDefaultPage } from '../../islands/shop/blocks/defaultPage';
import { isVisible, slimCtx } from '../../islands/shop/blocks/util';
import type { BlockCtx, ShopResolved } from '../../islands/shop/blocks/types';
import { API_BASE, publicImage } from '../../lib/config';
import { HOME_HEADER_LINKS } from '../../lib/homeNavigation';
import { SHOP_SEO } from '../../lib/seo/catalog';
import { getHome, type ShopHome } from '../../lib/shopApi';
import { withDeadline } from '../../lib/requestDeadline';
import { BRAND } from '../../lib/brand';
import '../../styles/saathum-folk.css';
import '../../styles/shop.css';

const SSR_DEADLINE_MS = 1800;
let home: ShopHome | null = null;
try {
  home = await withDeadline((signal) => getHome(signal), SSR_DEADLINE_MS);
} catch (err) {
  console.warn('[SHOP-SSR] home fetch failed; rendering the empty structure', err instanceof Error ? err.message : String(err));
}
Astro.response.headers.set('Cache-Control', home ? 'public, max-age=60, stale-while-revalidate=300' : 'no-store');

const collections = home?.collections ?? [];
let page = home?.page ?? null;
let resolved: ShopResolved = home?.resolved ?? { products: {}, rails: {} };
if (!page) {
  // Nothing published: the page as it always was, built from the legacy fields of the same response.
  const hero = home?.hero ?? {};
  const spots = (hero.hotspots ?? []).filter((h) => h?.product);
  const fb = home?.featured_banner ?? null;
  const products: ShopResolved['products'] = {};
  for (const h of spots) products[h.product.id] = h.product;
  if (fb?.product) products[fb.product.id] = fb.product;
  page = buildDefaultPage({
    brandName: BRAND.name,
    hero: { ...hero, hotspots: spots.map((h) => ({ product_id: h.product.id, x: h.x, y: h.y })) },
    banner: fb ? { product_id: fb.product?.id ?? '', eyebrow: fb.eyebrow, title: fb.title, text: fb.text, cta_label: fb.cta_label, image_url: fb.image_url } : null,
  });
  resolved = { products, rails: { 'new-arrivals': home?.new_arrivals ?? [], bestsellers: home?.bestsellers ?? [] } };
}
const ctx: BlockCtx = { collections, resolved };
const items = page.content;

// Layout: hero blocks sit outside the page wrapper; every run of other blocks shares one `.sh-wrap` (as the page always did).
// The page's last visible block gets the old bottom spacing: 60px under a rail with products, else a 52px spacer.
let lastIdx = -1;
items.forEach((it, i) => { if (it.type !== 'ShopHero' && isVisible(it, ctx)) lastIdx = i; });
const lastItem = lastIdx >= 0 ? items[lastIdx] : null;
const lastIsFullRail = lastItem?.type === 'ProductRail' && (resolved.rails[lastItem.props.id]?.length ?? 0) > 0;
const groups: { hero: boolean; idx: number[] }[] = [];
items.forEach((it, i) => {
  const hero = it.type === 'ShopHero';
  const g = groups[groups.length - 1];
  if (!hero && g && !g.hero) g.idx.push(i); else groups.push({ hero, idx: [i] });
});
let lastWrap = -1;
groups.forEach((g, gi) => { if (!g.hero && g.idx.includes(lastIdx)) lastWrap = gi; });

const heroItem = items.find((it) => it.type === 'ShopHero');
const heroImage = heroItem && heroItem.type === 'ShopHero' ? heroItem.props.image : '';
const content = heroImage
  ? { ...SHOP_SEO, image: { url: heroImage, alt: `The ${BRAND.name} Shop — Hindu T-shirts` } }
  : SHOP_SEO;
const railHasItems = (id: string) => (resolved.rails[id]?.length ?? 0) > 0;
---
<Base content={content} chrome={false} indiaLandingLanguage={false}>
  <Fragment slot="head">
    <meta name="theme-color" content="#fff8e8" />
    <link rel="preconnect" href={API_BASE} crossorigin />
    <link rel="preload" as="style" onload="this.onload=null;this.rel='stylesheet'" href="https://fonts.googleapis.com/css2?family=Comfortaa:wght@400;500;600;700&family=Nunito:wght@400;600;700;800;900&display=swap" />
  </Fragment>
  <div class="folk-site" data-design="reference-v5" style={`--folk-border-url:url(${publicImage('/assets/bright/border.png', { width: 640, fit: 'scale-down' })})`}>
    <a class="folk-skip" href="#main-content">Skip to main content</a>
    <SiteHeader folk indiaLandingLanguage={false} responsiveHome referenceHome links={HOME_HEADER_LINKS} />
    <main id="main-content" class="sh">
      <ShopTelemetry client:idle event="shop_home_viewed" />

      <!-- ================= SHOP HOME (blocks) ================= -->
      {groups.map((g, gi) => g.hero ? (
        items[g.idx[0]].type === 'ShopHero' && <ShopHeroBlock client:idle {...items[g.idx[0]].props} ctx={slimCtx(items[g.idx[0]], ctx)} />
      ) : (
        <div class="sh-wrap">
          {g.idx.map((i) => {
            const it = items[i];
            return (
              <Fragment>
                {it.type === 'CollectionGrid' && <CollectionGridBlock {...it.props} ctx={ctx} />}
                {it.type === 'ProductRail' && railHasItems(it.props.id) && <ProductRailBlock client:idle {...it.props} ctx={{ ...slimCtx(it, ctx), last: i === lastIdx }} />}
                {it.type === 'ProductRail' && !railHasItems(it.props.id) && <ProductRailBlock {...it.props} ctx={{ ...slimCtx(it, ctx), last: i === lastIdx }} />}
                {it.type === 'FeaturedBanner' && isVisible(it, ctx) && <FeaturedBannerBlock {...it.props} ctx={slimCtx(it, ctx)} />}
                {it.type === 'PhotoBanner' && <PhotoBannerBlock {...it.props} />}
                {it.type === 'TextSection' && <TextSectionBlock {...it.props} />}
              </Fragment>
            );
          })}
          {gi === lastWrap && !lastIsFullRail && <div style="height:52px"></div>}
        </div>
      ))}
    </main>
    <SiteFooter folk indiaLandingLanguage={false} />
  </div>
</Base>
