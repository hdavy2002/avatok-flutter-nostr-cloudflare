---
// Legacy email join link resolver.
//
// Older invites pointed at /j/<token>. The browser should land on the
// canonical session URL when possible so shared links still work without the
// app.
export const prerender = false;

import { API_BASE } from '../../lib/config';
import { sessionPath } from '../../lib/urls';

Astro.response.headers.set('Cache-Control', 'no-store');
const { token } = Astro.params;
const joinInfoUrl = `${API_BASE}/api/join-info/${encodeURIComponent(token!)}`;

let bookingId: string | null = null;
let destinationPath: string | null = null;
let error = false;
try {
  const res = await fetch(joinInfoUrl, { headers: { accept: 'application/json' } });
  if (res.ok) {
    const data = await res.json() as {
      booking_id?: string;
      destination?: { path?: string } | null;
      error?: string;
    };
    if (typeof data.booking_id === 'string' && data.booking_id) bookingId = data.booking_id;
    else error = true;
    if (typeof data.destination?.path === 'string' && /^\/(?:live|session|consult)\/[^/?#]+$/.test(data.destination.path)) {
      destinationPath = data.destination.path;
    }
  } else {
    error = true;
  }
} catch {
  error = true;
}

if (bookingId) {
  // New Worker responses identify the exact commercial or legacy room. Keep
  // the session fallback for an older deployment that only returned
  // `booking_id`, while preserving query parameters used by app-link recovery.
  const path = destinationPath ?? sessionPath(bookingId);
  return Astro.redirect(`${path}${Astro.url.search}`, 302);
}

Astro.response.status = 404;
---
<html lang="en">
  <body>
    <p>That booking link is invalid or expired.</p>
  </body>
</html>
