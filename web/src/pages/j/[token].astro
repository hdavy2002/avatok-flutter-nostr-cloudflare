---
// [JOIN-LINK-1] The link in every booking/ticket email.
//
// This page used to resolve the token server-side and 302 to /live/<id> or
// /session/<id>. That redirect carried the DESTINATION and dropped the
// IDENTITY, so the customer landed on a gated room and was asked to sign in to
// a session he had already paid for — the exact thing
// RULEBOOK-PAID-SESSIONS §7 forbids ("He never logs into a dashboard").
//
// The token is now exchanged by the JoinLink island for a Clerk sign-in ticket
// (POST /api/join-link/:token/session), redeemed in the browser, and only then
// does it navigate to the room — so the room's own `freshAppJwt()` finds a real
// session and never opens the gate. Arriving at a bare /live/:id or /session/:id
// from anywhere else still meets the email-code gate; that is rule (b) and it is
// deliberately untouched.
export const prerender = false;

import Base from '../../layouts/Base.astro';
import JoinLink from '../../islands/join/JoinLink.tsx';

const { token } = Astro.params;

if (!token) {
  return new Response('Join link required', { status: 400 });
}

// A join link is personal and single-person: never cache it, never index it.
Astro.response.headers.set('Cache-Control', 'no-store');
---

<Base headerAuth="static"
  title="Joining your session · avatok.ai"
  description="Opening your booked avaTOK session."
  navStatic={true}
>
  <meta name="robots" content="noindex, nofollow" slot="head" />
  <main class="mx-auto max-w-lg px-4 py-10">
    <JoinLink client:load token={token} />
  </main>
</Base>
