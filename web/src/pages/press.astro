---
import { BUSINESS_CONTACT } from '../lib/businessContact';
import { BRAND } from '../lib/brand';
import HelloFraandsPage from '../layouts/HelloFraandsPage.astro';
export const prerender = true;
---
<HelloFraandsPage updated="2026-10-14" title="Press" summary={`${BRAND.name} ki jaankari aur media sampark yahan milega.`}>
<h2>About {BRAND.name}</h2><p>{BRAND.name} lets adults in India book a private phone call with their favourite social media influencers, paid by the minute. When a call is booked, we call the influencer first; if they accept, we call the caller and join the two calls. Both calls come from a {BRAND.name} number, so neither person sees the other's personal phone number. The service is not dating, counselling or professional advice.</p>
<h2>Press details</h2><p>Business name: {BUSINESS_CONTACT.name}. Founder name: to be added.</p><p>Media enquiries: <a href={`mailto:${BRAND.emails.support}`}>{BRAND.emails.support}</a>.</p>
<h2>Logo downloads</h2><p>PNG logo download — coming soon.</p><p>SVG logo download — coming soon.</p><p>Download links will appear here when approved logo files are available.</p>
</HelloFraandsPage>
