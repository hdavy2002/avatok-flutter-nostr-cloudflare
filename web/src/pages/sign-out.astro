---
/*
 * /sign-out — end the Clerk session and go home.
 *
 * [WEB-HEADER-SIGNOUT-1 2026-08-28] Exists because pages that are NOT rendered
 * by SiteHeader need somewhere to send a "Sign out" link. The /marketplace and
 * listing routes are static design comps (see lib/mockupPage.ts) with their
 * header markup baked in and no Clerk island on the page, so they cannot call
 * signOut() themselves. A plain link to this route can.
 *
 * Deliberately its own page rather than a query param on the home page: signing
 * out is a state change and should have a URL you can point at, not a side
 * effect hidden in a redirect.
 */
export const prerender = false;

import Base from '../layouts/Base.astro';
import SignOutIsland from '../islands/auth/SignOutIsland.tsx';
import { BRAND } from '../lib/brand';
import { Marigold } from '../islands/dashboard-hf/v3/ui';

Astro.response.headers.set('Cache-Control', 'private, no-store');
---

<Base
  title={`Signing out · ${BRAND.name}`}
  description={`Signing you out of ${BRAND.name}.`}
  chrome={false}
  header
  noindex
>
  <!-- [HF-SIGNOUT-MSG-1] One message only (the island renders nothing), in the dashboard's desi card style. -->
  <main class="so-wrap">
    <section class="so-card" role="status" aria-live="polite">
      <span class="so-corner so-tl" aria-hidden="true"><Marigold size={64} /></span>
      <span class="so-corner so-br" aria-hidden="true"><Marigold size={52} tone={1} /></span>
      <span class="so-spin" aria-hidden="true"><Marigold size={58} tone={1} /></span>
      <h1 class="so-title">Phir milenge, dost!</h1>
      <p class="so-msg">Aapko safely sign out kar rahe hain… bas ek pal.</p>
      <p class="so-note">Chai thandi hone se pehle wapas aana.</p>
      <noscript>
        <p class="so-msg">JavaScript is required to sign out. <a href="/">Return home</a>.</p>
      </noscript>
    </section>
    <SignOutIsland client:only="react" />
  </main>

  <style>
    .so-wrap {
      width: 100%;
      box-sizing: border-box;
      min-height: 70vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 48px 16px;
      background: #fff8f0;
    }
    .so-card {
      position: relative;
      overflow: hidden;
      width: min(100%, 680px);
      padding: 64px 40px 56px;
      border-radius: 28px;
      background: #ffffff;
      border: 2px solid #f1e3d6;
      box-shadow: 0 1px 0 rgba(74, 23, 71, .04), 0 18px 40px -18px rgba(74, 23, 71, .28);
      text-align: center;
    }
    .so-card::before {
      content: '';
      position: absolute;
      inset: 0 0 auto 0;
      height: 8px;
      background: repeating-linear-gradient(90deg, #d81b72 0 28px, #f59e0b 28px 56px, #6d4fd0 56px 84px);
    }
    .so-corner { position: absolute; line-height: 0; opacity: .95; }
    .so-corner :global(svg) { width: 96px; height: 96px; }
    .so-br :global(svg) { width: 76px; height: 76px; }
    .so-spin :global(svg) { width: 84px; height: 84px; }
    .so-tl { left: -26px; top: -22px; }
    .so-br { right: -20px; bottom: -20px; }
    .so-spin { display: inline-block; line-height: 0; margin-bottom: 18px; }
    @media (prefers-reduced-motion: no-preference) {
      .so-spin { animation: so-turn 2.4s linear infinite; }
      @keyframes so-turn { to { transform: rotate(360deg); } }
    }
    .so-title {
      margin: 0 0 10px;
      font-family: 'Nunito', system-ui, sans-serif;
      font-weight: 900;
      font-size: clamp(2.1rem, 1.5rem + 2.6vw, 3.2rem);
      line-height: 1.15;
      color: #4a1747;
    }
    .so-msg {
      margin: 0;
      font-family: 'Comfortaa', system-ui, sans-serif;
      font-size: clamp(18px, 16.8px + .35vw, 22px);
      font-weight: 700;
      color: #2b1530;
    }
    .so-note {
      margin: 14px 0 0;
      font-family: 'Comfortaa', system-ui, sans-serif;
      font-size: clamp(16px, 15.2px + .25vw, 19px);
      color: #6f5b6f;
    }
  </style>
</Base>
