---
// saathum.com — Create account.
//
// [WEB-AUTH-DESIGN-1 2026-08-26] Rebuilt from design/login/README.md, replacing
// Clerk's prebuilt <SignUp/> drop-in. See sign-in.astro for the shell rationale.
//
// [HF-AUTH-ART-1 2026-10-08] Hello Fraands art: lilac panel with the notebook + chai
// sticker here, cream panel with the friendship collage on log in (owner asked to
// replace the old Ganesh / lotus / Suswagatam artwork).
export const prerender = false;

import Base from '../layouts/Base.astro';
import SiteHeader from '../components/callvaal/Header.astro';
import SignUpIsland from '../islands/auth/SignUpIsland.tsx';
import { clerkFapiHost, publicImage } from '../lib/config';
import '../styles/auth.css';
import { BRAND } from '../lib/brand';

Astro.response.headers.set('Cache-Control', 'private, no-store');

const clerkHost = clerkFapiHost();
---

<Base
  title={`Create account · ${BRAND.name}`}
  description={`Join ${BRAND.name} — book 1:1 consultations and live events, or host your own and get paid.`}
  chrome={false}
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload" as="style" onload="this.onload=null;this.rel='stylesheet'"
      href="https://fonts.googleapis.com/css2?family=Comfortaa:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@1,900&family=Instrument+Sans:wght@400;500;600;700&family=Baloo+2:wght@800&family=Kalam&display=swap"
    />
    {clerkHost && (
      <Fragment>
        <link rel="preconnect" href={`https://${clerkHost}`} crossorigin />
        <link rel="dns-prefetch" href={`https://${clerkHost}`} />
      </Fragment>
    )}
  </Fragment>

  <SiteHeader />

  <div class="auth">
    <div class="auth-shell">
      <aside class="auth-panel auth-panel--hf-lilac" aria-hidden="true">
        <span class="auth-rail">Real people · Naye dost</span>
        <img src={publicImage('/assets/callvaal/scrapbook/earn-art-moods.png', { width: 900, fit: 'scale-down' })} alt="" width="1254" height="1254" />
        <span class="auth-stamp">Number kabhi share nahi hota</span>
      </aside>

      <main class="auth-main auth-main--signup">
        <!-- See sign-in.astro: ornaments for the 768–1279 card layout, hidden
             at >=1280 where the decorative panel carries its own. -->
        <span class="auth-rail">Real people · Naye dost</span>
        <div class="auth-card">
          <header class="auth-head">
            <!-- The graphic carries the welcome line on sign-up, so there is no
                 separate Hindi text row here (README §2). -->
            <img
              src={publicImage('/assets/callvaal/scrapbook/hero-collage-moods.png', { width: 600, fit: 'scale-down' })} alt="" width="1254" height="1254"
              fetchpriority="high" style="height:130px;width:auto;"
            />
          </header>
          <SignUpIsland client:load />
        </div>
        <span class="auth-stamp">Number kabhi share nahi hota</span>
      </main>
    </div>
  </div>
</Base>
