---
// saathum.com — Create account.
//
// [WEB-AUTH-DESIGN-1 2026-08-26] Rebuilt from design/login/README.md, replacing
// Clerk's prebuilt <SignUp/> drop-in. See sign-in.astro for the shell rationale.
//
// [HF-AUTH-ART-1 2026-10-08] Hello Fraands art: lilac panel with the notebook + chai
// sticker here, cream panel with the friendship collage on log in (owner asked to
// replace the old Ganesh / lotus / Suswagatam artwork).
export const prerender = false;

import Base from '../layouts/Base.astro';
import AuthGhar from '../components/auth/AuthGhar.astro';
import SignUpIsland from '../islands/auth/SignUpIsland.tsx';
import { clerkFapiHost } from '../lib/config';
import '../styles/auth.css';
import { BRAND } from '../lib/brand';

Astro.response.headers.set('Cache-Control', 'private, no-store');

const clerkHost = clerkFapiHost();
---

<Base
  title={`Create account · ${BRAND.name}`}
  description={`Join ${BRAND.name} — book a private phone call with your favourite influencer, or join as an influencer and get paid.`}
  chrome={false}
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload" as="style" onload="this.onload=null;this.rel='stylesheet'"
      href="https://fonts.googleapis.com/css2?family=Comfortaa:wght@400;500;600;700&family=Nunito:wght@700;800;900&display=swap"
    />
    {clerkHost && (
      <Fragment>
        <link rel="preconnect" href={`https://${clerkHost}`} crossorigin />
        <link rel="dns-prefetch" href={`https://${clerkHost}`} />
      </Fragment>
    )}
  </Fragment>

  <!-- [HF-AUTH-GHAR-1 2026-10-17] No site header/footer here (owner). Shell + art: components/auth/AuthGhar.astro. -->
  <AuthGhar variant="up">
    <SignUpIsland client:load />
  </AuthGhar>
</Base>
