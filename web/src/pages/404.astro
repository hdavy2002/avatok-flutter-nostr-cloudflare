---
import { BRAND } from '../lib/brand';
import Header from '../components/callvaal/Header.astro';
import Footer from '../components/callvaal/Footer.astro';
import '../styles/callvaal-notebook.css';
// [HF-CONSISTENCY-1 2026-10-08] Same header, footer, fonts and colours as every other page.
// [WEB-OLD-PAGES-GONE-1 2026-09-27] Real 404 page. Without a 404.html in the build,
// Cloudflare Pages runs in "SPA mode" and answers EVERY unknown URL with the homepage
// and a 200 (a soft-404 — deleted pages like /add, /pricing, /vision still looked
// alive). Its presence switches Pages to proper 404s; deleted-on-purpose URLs are
// turned into 410 by src/middleware.ts before this renders.
export const prerender = true;
---
<!doctype html>
<html lang="en-IN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>Page not found · {BRAND.name}</title>
<link rel="icon" href="/assets/callvaal/notebook/favicon.svg" type="image/svg+xml" />
</head>
<body>
<div class="notebook-site hf-site" data-design="callvaal-scrapbook">
  <Header />
  <main id="main-content" class="hf-missing">
    <h1>We couldn't find that page</h1>
    <p>The link may be old or mistyped. Real people are still here to talk.</p>
    <a class="hf-missing-btn" href="/marketplace">Find someone to talk to</a>
  </main>
  <Footer />
</div>
<style>
  .hf-missing { max-width: 640px; margin: clamp(48px, 8vw, 120px) auto; text-align: center; }
  .hf-missing h1 { font-size: clamp(2rem, 4vw, 3.25rem); line-height: 1.1; color: #46113e; }
  .hf-missing p { margin: 16px 0 28px; font-size: var(--text-body); color: #785979; }
  .hf-missing-btn { display: inline-block; padding: 14px 28px; border-radius: 30px; background: #bd2740; color: #fff; font-weight: 700; text-decoration: none; }
</style>
</body>
</html>
