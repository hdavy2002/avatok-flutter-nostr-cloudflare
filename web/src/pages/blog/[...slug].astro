---
import { BRAND } from '../../lib/brand';
// [WEB-BLOG-RITUALS-1 2026-09-27] OWNER DECISION: the old blog is gone.
//   /blog            -> 301 to /rituals (the Puja & Havan Guide is the new blog;
//                       the header/footer "Blog" item links there — homeNavigation.ts)
//   /blog/<anything> -> 410 Gone. Every old article (never-miss-a-call,
//                       ai-in-every-chat, your-private-number, creator-ideas/*,
//                       global-creator-ideas/*, …) was DELETED, not archived.
// 410 (not 404, not a 301) is deliberate: it tells Google the page was removed
// on purpose so it drops out of the index fastest, and it does NOT tell Google
// the old posts and the new guides are the same content. Do not add redirects
// for old /blog slugs in public/_redirects — that file wins over this route.
export const prerender = false;

const slug = Astro.params.slug ?? '';
if (slug === '') {
  return Astro.redirect('/rituals/', 301);
}

const html = `<!doctype html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>Page removed · ${BRAND.name}</title>
<link rel="icon" href="/assets/callvaal/notebook/favicon.svg" type="image/svg+xml">
<style>
  @font-face{font-family:Comfortaa;src:url('/fonts/Comfortaa-Bold.ttf') format('truetype');font-weight:400 700;font-display:swap}
  @font-face{font-family:Nunito;src:url('/fonts/Nunito-Black.woff2') format('woff2');font-weight:700 1000;font-display:swap}
  body{margin:0;min-height:100vh;display:grid;place-items:center;background:#fffdf7;color:#46113e;font-family:Comfortaa,sans-serif;padding:24px}
  main{max-width:560px;text-align:center}
  h1{font-family:Nunito,sans-serif;font-weight:900;font-size:clamp(2rem,4vw,3rem);line-height:1.1;margin:0 0 14px}
  p{font-size:18px;line-height:1.6;margin:0 0 26px;color:#785979}
  a{display:inline-block;background:#bd2740;color:#fff;text-decoration:none;font-weight:700;font-size:18px;padding:14px 28px;border-radius:30px}
</style></head>
<body><main>
<h1>This page has been removed</h1>
<p>Read our Puja &amp; Havan Guide instead — the meaning, benefits and history of every ritual we perform.</p>
<a href="/rituals/">Go to the Blog</a>
</main></body></html>`;

return new Response(html, {
  status: 410,
  headers: {
    'content-type': 'text/html; charset=utf-8',
    'x-robots-tag': 'noindex',
    'cache-control': 'public, max-age=3600',
  },
});
---
