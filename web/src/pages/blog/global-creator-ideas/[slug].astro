---
export const prerender = true;
import Base from '../../../layouts/Base.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import GlobalIdeaCard from '../../../components/GlobalIdeaCard.astro';
import { globalCreatorIdeas, globalCreatorGuides } from '../../../lib/globalCreatorIdeas';
import { publicImage } from '../../../lib/config';
import '../../../styles/global-editorial.css';
export function getStaticPaths(){ return globalCreatorIdeas.map(idea => ({ params: { slug: idea.slug }, props: { idea } })); }
const { idea } = Astro.props;
const guide = globalCreatorGuides[idea.slug];
const guideNamespace = 'web-global-guide-' + idea.slug;
const ideaIndex = globalCreatorIdeas.findIndex(item => item.slug === idea.slug);
const related = [1, 2, 3].map(offset => globalCreatorIdeas[(ideaIndex + offset) % globalCreatorIdeas.length]);
const image = publicImage(`/assets/global-original/ideas-${idea.slug}.png`, { width: 768, fit: 'scale-down' });
const imageWidth = [396, 376, 368, 396][ideaIndex % 4];
const imageHeight = ideaIndex < 4 ? 308 : 320;
const imageAlt = `${idea.platform}: ${idea.title}. ${idea.description}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://avatok.ai').href;
const articleLd = {
  '@context': 'https://schema.org', '@type': 'BlogPosting', headline: idea.title,
  description: guide.promise, image: new URL(image, Astro.site ?? 'https://avatok.ai').href,
  mainEntityOfPage: canonical, url: canonical, inLanguage: 'en',
  author: { '@type': 'Organization', name: 'avaTOK', url: 'https://avatok.ai' },
  publisher: { '@type': 'Organization', name: 'avaTOK', url: 'https://avatok.ai' },
  articleSection: 'Global creator ideas',
};
---
<Base titleMessageKey={`${guideNamespace}.metadataTitle`} descriptionMessageKey={`${guideNamespace}.promise`} chrome={false} title={`${idea.title}: a practical creator session guide · avaTOK`} description={guide.promise} image={image} imageAlt={imageAlt} imageWidth={imageWidth} imageHeight={imageHeight} ogType="article">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(articleLd).replace(/</g, '\\u003c')} />
  <SiteHeader variant="global" />
  <main class="global-editorial" id="main-content" data-global-guide={idea.slug}>
    <article>
      <div class="ge-article-top"><a data-i18n="web-blog.f14d673628e3deb1" class="ge-back" href="/global-ideas">← All global creator ideas</a><span class="ge-series"><ui-copy style="display:contents" data-i18n="web-blog.222788e12797185f">THE CREATOR PLAYBOOK / 0</ui-copy>{ideaIndex + 1}</span></div>
      <div class="ge-article-hero">
        <div class="ge-article-heading"><p class="ge-kicker">{idea.platform} · <ui-copy style="display:contents" data-i18n={`web-global-ideas.${idea.slug}.eyebrow`}>{idea.eyebrow}</ui-copy></p><h1><ui-copy style="display:contents" data-i18n={`web-global-ideas.${idea.slug}.title`}>{idea.title}</ui-copy><span aria-hidden="true">.</span></h1><p data-i18n={`${guideNamespace}.promise`} class="ge-lead">{guide.promise}</p><p data-i18n="web-blog.e6baaa3a7f145c22" class="ge-byline">A practical guide from avaTOK · Suggested session plan</p><a data-i18n="web-blog.07ebb568ff07334f" class="ge-button" href="#session-plan">Build your session ↓</a></div>
        <figure class="ge-article-art"><img src={image} alt={imageAlt} width={imageWidth} height={imageHeight} fetchpriority="high" loading="eager" decoding="async" /></figure>
      </div>
      <div class="ge-article-layout">
        <aside class="ge-at-a-glance" aria-labelledby="session-snapshot"><p data-i18n="web-blog.2fb53bea6a33703b" class="ge-kicker">THE SHORT VERSION</p><h2 data-i18n="web-blog.61ba0925589f4b7e" id="session-snapshot">One good session.</h2><dl><dt data-i18n="web-blog.9c58bdccfc523bd0">Suggested format</dt><dd data-i18n={`${guideNamespace}.duration`}>{guide.duration}</dd><dt data-i18n="web-blog.f05270150ac2faa0">Made for</dt><dd data-i18n={`${guideNamespace}.audience`}>{guide.audience}</dd><dt data-i18n="web-blog.7939a0e7c8f9a8c9">What you are selling</dt><dd data-i18n="web-blog.b283885b5b1e52f6">Your time, perspective and a clearly described experience.</dd></dl><nav data-india-i18n-attr="aria-label:web-blog.f16ac1eadb15d486" aria-label="In this guide"><a data-i18n="web-blog.c4f291ca460de8a4" href="#before-you-open-bookings">Get ready →</a><a data-i18n="web-blog.2409814abd428d3c" href="#session-plan">The session plan →</a><a data-i18n="web-blog.8373b5eba942fb13" href="#invitation">Your invitation →</a><a data-i18n="web-blog.ac5caa28ec4739de" href="#boundaries">Set boundaries →</a><a data-i18n="web-blog.694c482763ac2108" href="#payouts-and-pricing">Pricing & payouts →</a></nav></aside>
        <div class="ge-article-body">
          <p data-i18n={`${guideNamespace}.introduction`} class="ge-opening">{guide.introduction}</p>
          <section id="before-you-open-bookings"><p data-i18n="web-blog.978e6d3ed50a0576" class="ge-section-number">01 / BEFORE YOU OPEN BOOKINGS</p><h2 data-i18n="web-blog.cc2c761f415f665d">A little preparation. A much better experience.</h2><ul>{guide.preparation.map((item,index) => <li data-i18n={`${guideNamespace}.preparation.${index}`}>{item}</li>)}</ul></section>
          <section id="session-plan"><p data-i18n="web-blog.4465a62da61bf6b7" class="ge-section-number">02 / YOUR SESSION PLAN</p><h2 data-i18n="web-blog.e5e7e33ab40e2321">Give the moment a shape.</h2><p data-i18n="web-blog.dfa93b52dad76d5b">Use this as a starting point. Adjust the timing to your audience and describe the final format accurately in your listing.</p><ol class="ge-agenda">{guide.agenda.map((item,index) => <li><span class="ge-agenda__time">{item.time}<small data-i18n="web-blog.9073b10da43c0322">MINUTES</small></span><div><h3 data-i18n={`${guideNamespace}.agenda.${index}.title`}>{item.title}</h3><p data-i18n={`${guideNamespace}.agenda.${index}.detail`}>{item.detail}</p></div></li>)}</ol></section>
          <section id="invitation"><p data-i18n="web-blog.3d3eca377964a003" class="ge-section-number">03 / THE INVITATION</p><h2 data-i18n="web-blog.f060edac7cf10c65">Tell customers exactly what they can book.</h2><p data-i18n="web-blog.ac34a9073897837a">Adapt this sample to the experience you can actually deliver. Add your date, time zone, price and booking terms before sharing the link on your social profile.</p><blockquote class="ge-invitation"><p data-i18n={`${guideNamespace}.invitation`}>{guide.invitation}</p><cite data-i18n="web-blog.b8b732428a4668c7">Sample listing copy — make it sound like you.</cite></blockquote></section>
          <section id="boundaries"><p data-i18n="web-blog.0d7dd2f443b58656" class="ge-section-number">04 / KEEP IT GOOD FOR EVERYONE</p><h2 data-i18n="web-blog.51ceec84056206c8">Clear boundaries make better sessions.</h2><ul>{guide.boundaries.map((item,index) => <li data-i18n={`${guideNamespace}.boundaries.${index}`}>{item}</li>)}</ul><p><ui-copy style="display:contents" data-i18n="web-blog.fca0e874ac18402a">Follow the</ui-copy> <a data-i18n="web-blog.2ca80718096be9ac" href="/community-guidelines">community guidelines</a> <ui-copy style="display:contents" data-i18n="web-blog.6201111b83a0cb5b">and</ui-copy> <a data-i18n="web-blog.9b160f155164b234" href="/recording">recording policy</a><ui-copy style="display:contents" data-i18n="web-blog.cf218f572b8db49e">. Make cancellation, recording and guest participation expectations clear before anyone pays.</ui-copy></p></section>
          <section id="payouts-and-pricing"><p data-i18n="web-blog.df83077741f8ef87" class="ge-section-number">05 / PRICE THE WHOLE EXPERIENCE</p><h2 data-i18n="web-blog.0db4518f0e7c197d">Your time includes the time off camera.</h2><p><ui-copy style="display:contents" data-i18n="web-blog.cc14c4af0694ca64">Account for preparation, the live session and any promised follow-up. Review the current</ui-copy> <a data-i18n="web-blog.9ca93831c6f31695" href="/pricing-fees">fees</a> <ui-copy style="display:contents" data-i18n="web-blog.6201111b83a0cb5b">and</ui-copy> <a data-i18n="web-blog.c7afd9ff2ab00b7e" href="/refunds">refund terms</a> <ui-copy style="display:contents" data-i18n="web-blog.db8271d3048925b5">before setting a price. Do not assume a ticket price is the amount you will receive after fees or currency conversion.</ui-copy></p><p><ui-copy style="display:contents" data-i18n="web-blog.9d60841e0a7891df">Check</ui-copy> <a data-i18n="web-blog.204f791f672a2ce4" href="/payouts">payout availability</a> <ui-copy style="display:contents" data-i18n="web-blog.d01a12663d5f3cd9">for your country before offering paid bookings. Supported currencies, verification requirements, bank transfers and other payout methods vary by country. An idea on this page does not mean payments or payouts are available everywhere; UPI is India-specific, not a worldwide payout option.</ui-copy></p></section>
          <section><p data-i18n="web-blog.cbdd36c6ad35e7c9" class="ge-section-number">06 / AFTER THE GOODBYES</p><h2 data-i18n="web-blog.8a2fc585a267cd51">Close the loop.</h2><p data-i18n={`${guideNamespace}.followUp`}>{guide.followUp}</p></section>
        </div>
      </div>
    </article>
    <section class="ge-start ge-start--article"><div><p data-i18n="web-blog.7f66a1e3fb319e1c" class="ge-kicker">YOUR IDEA. YOUR PEOPLE.</p><h2 data-i18n="web-blog.d8a288359713252f">Make this one yours.</h2><p data-i18n="web-blog.9f057a8b538c9019">Start with a clear promise, an honest description and a session you are excited to host.</p></div><div class="ge-start__actions"><a data-i18n="web-blog.24bca8259f00fdd3" class="ge-button" href="/sign-up?role=creator&country=global">Start creating →</a><a data-i18n="web-blog.2e03b5f6a52c1773" class="ge-text-link" href="/global-ideas">Explore all eight ideas ↗</a></div></section>
    <section class="ge-related" aria-labelledby="related-ideas"><div class="ge-related-heading"><div><p data-i18n="web-blog.eebb3703f7501ea4" class="ge-kicker">KEEP THE IDEAS COMING</p><h2 data-i18n="web-blog.ee324d4bc9a8a9d2" id="related-ideas">Another way to connect.</h2></div><a data-i18n="web-blog.ee16f071d9a52963" class="ge-text-link" href="/global-ideas">All global ideas →</a></div><div class="ge-related-grid">{related.map(item => <GlobalIdeaCard idea={item} headingLevel="h3" />)}</div></section>
  </main>
  <SiteFooter variant="global" />
</Base>

<style>
/* The source artwork contains English lettering; the translated heading above replaces it. */
:global(html:not([lang="en"])) .ge-article-art { display: none; }
:global(html:not([lang="en"])) .ge-article-hero { grid-template-columns: minmax(0,1fr); }
</style>
