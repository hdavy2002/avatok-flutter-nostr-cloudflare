---
import { publicImage, publicImageSrcSet } from '../../../lib/config';
export const prerender = true;
import Base from '../../../layouts/Base.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import GlobalIdeaCard from '../../../components/GlobalIdeaCard.astro';
import { globalCreatorIdeas, globalCreatorGuides } from '../../../lib/globalCreatorIdeas';
import '../../../styles/global-editorial.css';
export function getStaticPaths(){ return globalCreatorIdeas.map(idea => ({ params: { slug: idea.slug }, props: { idea } })); }
const { idea } = Astro.props;
const guide = globalCreatorGuides[idea.slug];
const ideaIndex = globalCreatorIdeas.findIndex(item => item.slug === idea.slug);
const related = [1, 2, 3].map(offset => globalCreatorIdeas[(ideaIndex + offset) % globalCreatorIdeas.length]);
const image = `/assets/global-original/ideas-${idea.slug}.png`;
const imageWidth = [396, 376, 368, 396][ideaIndex % 4];
const imageHeight = ideaIndex < 4 ? 308 : 320;
const imageAlt = `${idea.platform}: ${idea.title}. ${idea.description}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://avatok.ai').href;
const articleLd = {
  '@context': 'https://schema.org', '@type': 'BlogPosting', headline: idea.title,
  description: guide.promise, image: new URL(image, Astro.site ?? 'https://avatok.ai').href,
  mainEntityOfPage: canonical, url: canonical, inLanguage: 'en',
  author: { '@type': 'Organization', name: 'avaTOK', url: 'https://avatok.ai' },
  publisher: { '@type': 'Organization', name: 'avaTOK', url: 'https://avatok.ai' },
  articleSection: 'Global creator ideas',
};
---
<Base chrome={false} title={`${idea.title}: a practical creator session guide · avaTOK`} description={guide.promise} image={image} imageAlt={imageAlt} imageWidth={imageWidth} imageHeight={imageHeight} ogType="article">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(articleLd).replace(/</g, '\\u003c')} />
  <SiteHeader variant="global" />
  <main class="global-editorial" id="main-content" data-global-guide={idea.slug}>
    <article>
      <div class="ge-article-top"><a class="ge-back" href="/global-ideas">← All global creator ideas</a><span class="ge-series">THE CREATOR PLAYBOOK / 0{ideaIndex + 1}</span></div>
      <div class="ge-article-hero">
        <div class="ge-article-heading"><p class="ge-kicker">{idea.platform} · {idea.eyebrow}</p><h1>{idea.title}<span aria-hidden="true">.</span></h1><p class="ge-lead">{guide.promise}</p><p class="ge-byline">A practical guide from avaTOK · Suggested session plan</p><a class="ge-button" href="#session-plan">Build your session ↓</a></div>
        <figure class="ge-article-art"><img src={publicImage(image, { width: 900, fit: 'scale-down' })} srcset={publicImageSrcSet(image, [420, 640, 900, 1280], { fit: 'scale-down' })} sizes="(max-width: 699px) 90vw, 40vw" alt={imageAlt} width={imageWidth} height={imageHeight} fetchpriority="high" loading="eager" decoding="async" /></figure>
      </div>
      <div class="ge-article-layout">
        <aside class="ge-at-a-glance" aria-labelledby="session-snapshot"><p class="ge-kicker">THE SHORT VERSION</p><h2 id="session-snapshot">One good session.</h2><dl><dt>Suggested format</dt><dd>{guide.duration}</dd><dt>Made for</dt><dd>{guide.audience}</dd><dt>What you are selling</dt><dd>Your time, perspective and a clearly described experience.</dd></dl><nav aria-label="In this guide"><a href="#before-you-open-bookings">Get ready →</a><a href="#session-plan">The session plan →</a><a href="#invitation">Your invitation →</a><a href="#boundaries">Set boundaries →</a><a href="#payouts-and-pricing">Pricing & payouts →</a></nav></aside>
        <div class="ge-article-body">
          <p class="ge-opening">{guide.introduction}</p>
          <section id="before-you-open-bookings"><p class="ge-section-number">01 / BEFORE YOU OPEN BOOKINGS</p><h2>A little preparation. A much better experience.</h2><ul>{guide.preparation.map(item => <li>{item}</li>)}</ul></section>
          <section id="session-plan"><p class="ge-section-number">02 / YOUR SESSION PLAN</p><h2>Give the moment a shape.</h2><p>Use this as a starting point. Adjust the timing to your audience and describe the final format accurately in your listing.</p><ol class="ge-agenda">{guide.agenda.map(item => <li><span class="ge-agenda__time">{item.time}<small>MINUTES</small></span><div><h3>{item.title}</h3><p>{item.detail}</p></div></li>)}</ol></section>
          <section id="invitation"><p class="ge-section-number">03 / THE INVITATION</p><h2>Tell fans exactly what they can book.</h2><p>Adapt this sample to the experience you can actually deliver. Add your date, time zone, price and booking terms before sharing the link on your social profile.</p><blockquote class="ge-invitation"><p>{guide.invitation}</p><cite>Sample listing copy — make it sound like you.</cite></blockquote></section>
          <section id="boundaries"><p class="ge-section-number">04 / KEEP IT GOOD FOR EVERYONE</p><h2>Clear boundaries make better sessions.</h2><ul>{guide.boundaries.map(item => <li>{item}</li>)}</ul><p>Follow the <a href="/community-guidelines">community guidelines</a> and <a href="/recording">recording policy</a>. Make cancellation, recording and guest participation expectations clear before anyone pays.</p></section>
          <section id="payouts-and-pricing"><p class="ge-section-number">05 / PRICE THE WHOLE EXPERIENCE</p><h2>Your time includes the time off camera.</h2><p>Account for preparation, the live session and any promised follow-up. Review the current <a href="/pricing-fees">fees</a> and <a href="/refunds">refund terms</a> before setting a price. Do not assume a ticket price is the amount you will receive after fees or currency conversion.</p><p>Check <a href="/payouts">payout availability</a> for your country before offering paid bookings. Supported currencies, verification requirements, bank transfers and other payout methods vary by country. An idea on this page does not mean payments or payouts are available everywhere; UPI is India-specific, not a worldwide payout option.</p></section>
          <section><p class="ge-section-number">06 / AFTER THE GOODBYES</p><h2>Close the loop.</h2><p>{guide.followUp}</p></section>
        </div>
      </div>
    </article>
    <section class="ge-start ge-start--article"><div><p class="ge-kicker">YOUR IDEA. YOUR PEOPLE.</p><h2>Make this one yours.</h2><p>Start with a clear promise, an honest description and a session you are excited to host.</p></div><div class="ge-start__actions"><a class="ge-button" href="/sign-up?role=creator&country=global">Start creating →</a><a class="ge-text-link" href="/global-ideas">Explore all eight ideas ↗</a></div></section>
    <section class="ge-related" aria-labelledby="related-ideas"><div class="ge-related-heading"><div><p class="ge-kicker">KEEP THE IDEAS COMING</p><h2 id="related-ideas">Another way to connect.</h2></div><a class="ge-text-link" href="/global-ideas">All global ideas →</a></div><div class="ge-related-grid">{related.map(item => <GlobalIdeaCard idea={item} headingLevel="h3" />)}</div></section>
  </main>
  <SiteFooter variant="global" />
</Base>
