---
import { authoredKey } from '../../lib/i18n/authoredKey';
export const prerender = true;
import Content from '../../layouts/Content.astro';

const posts = [
  // [WEB-REPOSITION-2 2026-08-28] All three rewritten as creator-platform posts.
  // The SLUGS are deliberately unchanged even though they no longer match the
  // titles: these URLs are indexed, and keeping them beats a 404. If you ever
  // want tidy slugs, add redirects from the old paths rather than renaming.
  {
    slug: 'never-miss-a-call',
    title: 'Never miss a booking',
    date: '2026-08-28',
    excerpt:
      'Publish a listing, open the hours you are actually free, and let people book a real slot. No back-and-forth, no double-booking, no waiting on someone who was never going to show.',
    tag: 'Getting booked',
  },
  {
    slug: 'ai-in-every-chat',
    title: 'How to price your first listing',
    date: '2026-08-28',
    excerpt:
      'One token is one rupee — beyond that the number is yours. Why you should price the outcome instead of the hour, start where you can raise it, and know what you actually keep.',
    tag: 'Getting started',
  },
  {
    slug: 'your-private-number',
    title: 'Work in public without giving out your number',
    date: '2026-08-28',
    excerpt:
      'What you publish on Saathum is a listing, not a phone number. Be findable, get booked and get paid while your personal line stays personal.',
    tag: 'Privacy',
  },
];

const fmt = (d: string) =>
  new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Content
  kicker="Blog"
  title="The Saathum blog"
  description="Notes from the Saathum team on creating, earning, live sessions, privacy and building Saathum."
  image="/og/blog.png"
  lead="Notes from the team on earning as a creator, live sessions, privacy and building Saathum."
  width="wide"
>
  {/* [UI-MOTION-1 2026-09-10] "learn-more-hover" — `.t-learn` on the whole
      card (it already has its own :hover lift), chevron replaces the plain
      "→" glyph. Hover-only decoration; the link text carries the meaning. */}
  <a class="post t-learn" href="/ideas"><span data-i18n="web-blog.b7b14f324ca59c58" class="badge">Creator idea guides</span><h2 data-i18n="web-blog.6e4a98e629adc193">109 creator ideas. Your next paid session.</h2><p data-i18n="web-blog.649b7af478723410">Explore individual guides for live streams, 1:1 sessions, group classes and daily-life diaries — with practical preparation and equipment advice.</p><span class="post-date"><ui-copy style="display:contents" data-i18n="web-blog.83c68a5b29cb445a">Browse the illustrated guides</ui-copy> <span class="t-learn-chevron" aria-hidden="true"><svg width="20" height="16" viewBox="0 0 20 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M2 8H10" /><path class="t-learn-arm t-learn-arm-top" d="M10 8L18 1" /><path class="t-learn-arm t-learn-arm-bot" d="M10 8L18 15" /></svg></span></span></a>
  <div class="posts">
    {posts.map((p) => (
      <a class="post t-learn" href={`/blog/${p.slug}`}>
        <span class="badge"><ui-copy style="display:contents" data-i18n={authoredKey(p.tag)}>{p.tag}</ui-copy></span>
        <h3 class="post-title"><ui-copy style="display:contents" data-i18n={authoredKey(p.title)}>{p.title}</ui-copy></h3>
        <p class="post-ex"><ui-copy style="display:contents" data-i18n={authoredKey(p.excerpt)}>{p.excerpt}</ui-copy></p>
        <span class="post-date">{fmt(p.date)} <ui-copy style="display:contents" data-i18n="web-blog.7806d55f21e970ce">· Read</ui-copy> <span class="t-learn-chevron" aria-hidden="true"><svg width="20" height="16" viewBox="0 0 20 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M2 8H10" /><path class="t-learn-arm t-learn-arm-top" d="M10 8L18 1" /><path class="t-learn-arm t-learn-arm-bot" d="M10 8L18 15" /></svg></span></span>
      </a>
    ))}
  </div>
</Content>

<style>
  .posts { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin-top: 28px; }
  .post {
    display: block; text-decoration: none !important;
    border: 2.5px solid var(--ink, #231b14); background: var(--card, #fff);
    border-radius: 16px; padding: 22px 24px; box-shadow: 3px 3px 0 var(--ink, #231b14);
    transition: transform .12s ease, box-shadow .12s ease;
  }
  .post:hover { transform: translate(-2px,-2px); box-shadow: 5px 6px 0 var(--ink, #231b14); }
  .badge {
    display: inline-block; font-family: 'Space Mono', monospace; font-weight: 700; font-size: 12px;
    letter-spacing: 0.04em; text-transform: uppercase; color: var(--blue-ink, #007d7f);
    background: var(--blue, #cdeff0); border: 2px solid var(--ink, #231b14); border-radius: 999px; padding: 2px 10px;
  }
  .post-title { margin: 14px 0 0 !important; font-family: 'Fredoka', sans-serif; font-size: 22px; color: var(--ink, #231b14); }
  .post-ex { margin: 10px 0 0; font-size: 16px; font-weight: 600; color: var(--ink-soft, #6a6258); line-height: 1.55; }
  .post-date { display: inline-block; margin-top: 16px; font-family: 'Space Mono', monospace; font-weight: 700; font-size: 13px; color: var(--blue-ink, #007d7f); }
  @media (max-width: 640px) { .posts { grid-template-columns: 1fr; } }
</style>
