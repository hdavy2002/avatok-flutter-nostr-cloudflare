---
export const prerender = true;
import Content from '../../layouts/Content.astro';

const posts = [
  // [WEB-REPOSITION-2 2026-08-28] All three rewritten as creator-platform posts.
  // The SLUGS are deliberately unchanged even though they no longer match the
  // titles: these URLs are indexed, and keeping them beats a 404. If you ever
  // want tidy slugs, add redirects from the old paths rather than renaming.
  {
    slug: 'never-miss-a-call',
    title: 'Never miss a booking',
    date: '2026-08-28',
    excerpt:
      'Publish a listing, open the hours you are actually free, and let people book a real slot. No back-and-forth, no double-booking, no waiting on someone who was never going to show.',
    tag: 'Getting booked',
  },
  {
    slug: 'ai-in-every-chat',
    title: 'How to price your first listing',
    date: '2026-08-28',
    excerpt:
      'One token is one rupee — beyond that the number is yours. Why you should price the outcome instead of the hour, start where you can raise it, and know what you actually keep.',
    tag: 'Getting started',
  },
  {
    slug: 'your-private-number',
    title: 'Work in public without giving out your number',
    date: '2026-08-28',
    excerpt:
      'What you publish on avaTOK is a listing, not a phone number. Be findable, get booked and get paid while your personal line stays personal.',
    tag: 'Privacy',
  },
];

const fmt = (d: string) =>
  new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Content
  kicker="Blog"
  title="The AvaTok blog"
  description="Notes from the avaTOK team on creating, earning, live sessions, privacy and building avaTOK."
  image="/og/blog.png"
  lead="Notes from the team on earning as a creator, live sessions, privacy and building avaTOK."
  width="wide"
>
  <div class="posts">
    {posts.map((p) => (
      <a class="post" href={`/blog/${p.slug}`}>
        <span class="badge">{p.tag}</span>
        <h3 class="post-title">{p.title}</h3>
        <p class="post-ex">{p.excerpt}</p>
        <span class="post-date">{fmt(p.date)} · Read →</span>
      </a>
    ))}
  </div>
</Content>

<style>
  .posts { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin-top: 28px; }
  .post {
    display: block; text-decoration: none !important;
    border: 2.5px solid var(--ink, #231b14); background: var(--card, #fff);
    border-radius: 16px; padding: 22px 24px; box-shadow: 3px 3px 0 var(--ink, #231b14);
    transition: transform .12s ease, box-shadow .12s ease;
  }
  .post:hover { transform: translate(-2px,-2px); box-shadow: 5px 6px 0 var(--ink, #231b14); }
  .badge {
    display: inline-block; font-family: 'Space Mono', monospace; font-weight: 700; font-size: 12px;
    letter-spacing: 0.04em; text-transform: uppercase; color: var(--blue-ink, #007d7f);
    background: var(--blue, #cdeff0); border: 2px solid var(--ink, #231b14); border-radius: 999px; padding: 2px 10px;
  }
  .post-title { margin: 14px 0 0 !important; font-family: 'Fredoka', sans-serif; font-size: 22px; color: var(--ink, #231b14); }
  .post-ex { margin: 10px 0 0; font-size: 16px; font-weight: 600; color: var(--ink-soft, #6a6258); line-height: 1.55; }
  .post-date { display: inline-block; margin-top: 16px; font-family: 'Space Mono', monospace; font-weight: 700; font-size: 13px; color: var(--blue-ink, #007d7f); }
  @media (max-width: 640px) { .posts { grid-template-columns: 1fr; } }
</style>
