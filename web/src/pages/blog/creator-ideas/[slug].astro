---
import { publicImage, publicImageSrcSet } from '../../../lib/config';
export const prerender = true;
import Base from '../../../layouts/Base.astro';
import TruckBorder from '../../../components/TruckBorder.astro';
import { creatorIdeas, topics, formats } from '../../../lib/creatorIdeas';
import { creatorGuides } from '../../../lib/creatorGuides';
import '../../../styles/creator-ideas.css';
import '../../../styles/creator-guide.css';
export function getStaticPaths() {
  return creatorIdeas.map(idea => ({ params: { slug: idea.slug }, props: { idea } }));
}
const { idea } = Astro.props;
const guide = creatorGuides[idea.id];
const guideNamespace = 'web-guide-' + idea.id;
if (!guide) throw new Error('Missing creator guide: ' + idea.id);
const related = creatorIdeas.filter(item => item.id !== idea.id && item.topic === idea.topic).slice(0,3);
const duration = idea.format === 'private' ? '30–45 minutes' : idea.topic === 'daily' ? 'A planned live window' : '45–60 minutes';
const sessionAdvice = idea.format === 'private'
  ? 'One booking reserves time for one person. Price the preparation and follow-up as well as the call. Start with a clearly described appointment you can deliver reliably.'
  : idea.format === 'group'
  ? 'Offer a limited number of places that leaves everyone time to participate. Choose the group size from the activity and the time you can give each person, not just the number of people interested.'
  : idea.topic === 'daily'
  ? 'Describe the viewing window and what people will see. A drop-in diary needs a clear start, occasional context for newcomers and an honest description of how access is charged in the listing.'
  : 'Sell access to a planned live event with a named theme, start time and duration. Build the experience around what viewers can see, hear or ask during that session.';
const articleTitle = idea.title + ' — Creator Idea & Practical Guide · avaTOK';
const articleDescription = idea.description + ' Learn what to offer, how to start and what equipment you need.';
const jsonLd = { '@context':'https://schema.org', '@type':'BlogPosting', '@id':'https://avatok.ai'+idea.href+'#article', url:'https://avatok.ai'+idea.href, headline:idea.title, description:articleDescription, datePublished:'2026-09-09', dateModified:'2026-09-09', articleSection:topics[idea.topic].label, isPartOf:{'@id':'https://avatok.ai/ideas/#collection'}, image:'https://avatok.ai'+idea.image, author:{'@type':'Organization',name:'avaTOK',url:'https://avatok.ai/about'}, publisher:{'@id':'https://avatok.ai/#organization'}, mainEntityOfPage:'https://avatok.ai'+idea.href, inLanguage:'en-IN' };
---
<Base titleMessageKey={`${guideNamespace}.metadataTitle`} descriptionMessageKey={`${guideNamespace}.metadataDescription`} title={articleTitle} description={articleDescription} image={idea.image} imageAlt={'Illustration of ' + idea.title} imageWidth={1536} imageHeight={1024} ogType="article">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Creator ideas',item:'https://avatok.ai/ideas/'},{'@type':'ListItem',position:2,name:idea.title,item:'https://avatok.ai'+idea.href}]})} />
  <meta slot="head" property="article:published_time" content="2026-09-09T00:00:00+05:30" />
  <meta slot="head" property="article:modified_time" content="2026-09-09T00:00:00+05:30" />
  <main class="idea-page creator-guide" id="main-content" data-creator-guide={idea.id}>
    <div class="guide-shell">
      <nav data-india-i18n-attr="aria-label:web-blog.2bd873d6c734e63e" class="guide-breadcrumb" aria-label="Breadcrumb"><a data-i18n="web-blog.695af2f72a76fdce" href="/ideas">All creator ideas</a><span aria-hidden="true">/</span><span data-i18n={`web-ideas.topic.${idea.topic}`}>{topics[idea.topic].label}</span></nav>
      <header class="guide-heading">
        <p data-i18n="web-blog.9e549c3bc070237f" class="idea-kicker">From idea to income</p>
        <div class="idea-chips"><span data-i18n={`web-ideas.format.${idea.format}`} class:list={['idea-format',idea.format]}>{formats[idea.format]}</span><span data-i18n={`web-ideas.topic.${idea.topic}`}>{topics[idea.topic].label}</span>{idea.setting === 'home' && <span data-i18n="web-blog.50fb1f69cb64b60d">From home</span>}</div>
        <h1 data-i18n={`web-ideas.${idea.id}.title`}>{idea.title}</h1>
        <p data-i18n={`web-ideas.${idea.id}.description`} class="guide-lead">{idea.description}</p>
        <p class="guide-byline"><ui-copy style="display:contents" data-i18n="web-blog.125466b821c6448a">By</ui-copy> <a href="/about">avaTOK</a> · <time data-i18n="web-blog.c042c24abbadef33" datetime="2026-09-09">9 September 2026</time> <ui-copy style="display:contents" data-i18n="web-blog.21d05a229569269a">· Practical ideas, your own style</ui-copy></p>
      </header>
      <figure class="guide-hero"><img data-india-i18n-attr={`alt:${guideNamespace}.imageAlt`} src={publicImage(idea.image, { width: 900, fit: 'scale-down' })} srcset={publicImageSrcSet(idea.image, [420, 640, 900, 1600], { fit: 'scale-down' })} sizes="(max-width:699px) 90vw, (max-width:1440px) 92vw, 1320px" alt={'Illustration of ' + idea.title + ': ' + idea.description} width="1536" height="1024" fetchpriority="high" /><figcaption data-i18n="web-blog.8bc706a4f367eaee">Illustrated idea · Make the session your own.</figcaption></figure>
      <div class="guide-layout">
        <aside data-india-i18n-attr="aria-label:web-blog.f053cd17498c579e" class="guide-sidebar" aria-label="Guide navigation">
          <p data-i18n="web-blog.9086727f52ab7463" class="idea-kicker">Your route map</p>
          <nav><a data-i18n="web-blog.220971553c47e889" href="#offer">What you can offer</a><a data-i18n="web-blog.cee86ebcace09311" href="#plan">Plan your first session</a><a data-i18n="web-blog.e17c85cc990b6b6f" href="#equipment">What you need</a><a data-i18n="web-blog.0ba5946f42c5f61c" href="#return">Why people come back</a><a data-i18n="web-blog.91ce0326583bbd3b" href="#earnings">The earning idea</a><a data-i18n="web-blog.233f84ec9be9cbbc" href="#start">Find your first audience</a></nav>
          <p class="guide-note"><ui-copy style="display:contents" data-i18n="web-blog.46fbb010bf4312cd">Start with one good session.</ui-copy><br /><ui-copy style="display:contents" data-i18n="web-blog.4082715edc4c8a9a">Then make it a regular thing.</ui-copy></p>
        </aside>
        <div class="guide-body">
          <section id="offer"><p data-i18n="web-blog.b58400776d151481" class="idea-kicker">01 · The idea</p><h2 data-i18n="web-blog.7d806966053e2ea3">What are people paying for?</h2><p data-i18n={`${guideNamespace}.offer`}>{guide.offer}</p><div class="guide-audience"><strong data-i18n="web-blog.b84fc4cd7fbda43c">Who this could suit</strong><p data-i18n={`${guideNamespace}.audience`}>{guide.audience}.</p></div><p data-i18n={`web-guide-shared.advice.${idea.format}.${idea.topic === 'daily' ? 'daily' : 'other'}`}>{sessionAdvice}</p></section>
          <section id="plan"><p data-i18n="web-blog.7ec5ba3b92e996f8" class="idea-kicker">02 · Getting started</p><h2 data-i18n="web-blog.cee86ebcace09311">Plan your first session</h2><p class="guide-duration"><ui-copy style="display:contents" data-i18n="web-blog.4fbb7fb2ea4b65e4">A starting format:</ui-copy> <strong data-i18n={`web-guide-shared.duration.${idea.format}.${idea.topic === 'daily' ? 'daily' : 'other'}`}>{duration}</strong><ui-copy style="display:contents" data-i18n="web-blog.c6efd6a91933ade6">. Adjust this to the activity and explain it before anyone books.</ui-copy></p><ol class="guide-steps">{guide.steps.map((step,index) => <li data-i18n={`${guideNamespace}.steps.${index}`}>{step}.</li>)}</ol><p data-i18n="web-blog.e3082a4bdc895941">Try a short rehearsal before opening bookings. Check what the camera shows, whether your voice is clear, and whether the plan fits the time you are offering.</p></section>
          <section id="equipment"><p data-i18n="web-blog.31c052109afa8ce4" class="idea-kicker">03 · Start with your phone</p><h2 data-i18n="web-blog.8b434bf7be344e1b">What equipment do you need?</h2><p data-i18n={`${guideNamespace}.equipment`}>{guide.equipment}</p><p data-i18n="web-blog.d789fadc42d752ee">Start with what you already have. Test the internet connection, charge the device and choose a camera angle that shows the activity clearly. Upgrade only when you know what would improve the experience.</p></section>
          <section id="return"><p data-i18n="web-blog.dc74faff52c69313" class="idea-kicker">04 · Coming back</p><h2 data-i18n="web-blog.480f4ec2f2316d50">Why would followers come back?</h2><p data-i18n={`${guideNamespace}.returnReason`}>{guide.returnReason}</p><p data-i18n="web-blog.1cc8b91403588a77">Tell people what the next session will offer and invite them to follow your calendar. Share your next available date so they can choose another booking. Make each return visit worth their time.</p></section>
          <section id="earnings"><p data-i18n="web-blog.0826343b240f2f9a" class="idea-kicker">05 · The earning idea</p><h2 data-i18n="web-blog.f2a70a90a8923c5a">Earn from a booking, not just a view</h2><p data-i18n="web-blog.ed834f605061f898">Your social posts can help people discover you. A paid session gives interested people a specific experience to book: your time, teaching, hosting or performance.</p><p data-i18n="web-blog.fb7be9aa246435ed">A small paying audience can be a useful place to start. Income depends on people choosing to book, the experience you deliver and the costs of running it. Use each session to learn what your audience values.</p><p><ui-copy style="display:contents" data-i18n="web-blog.57732093ec38c495">For pricing information, visit</ui-copy> <a data-i18n="web-blog.5e2a4b33bff1936b" href="/pricing">Pricing &amp; Fees</a> <ui-copy style="display:contents" data-i18n="web-blog.5c990ef672ed7cad">and review the details shown before you publish your listing.</ui-copy></p></section>
          <section id="start"><p data-i18n="web-blog.016e6b99c30886b2" class="idea-kicker">06 · Your audience</p><h2 data-i18n="web-blog.233f84ec9be9cbbc">Find your first audience</h2><p data-i18n={`${guideNamespace}.promotion`}>{guide.promotion}</p><p data-i18n="web-blog.c2c183b88e170f75">Start with a specific invitation: who the session is for, what will happen, the language, duration and date. After hosting, ask for feedback and use it to improve the next session.</p></section>
          <div class="guide-ticket"><p data-i18n="web-blog.feae369e1c169fd5" class="guide-note">Your idea. Your identity.</p><h2 data-i18n="web-blog.db7df927fb8133ba">Make your first listing clear.</h2><p data-i18n="web-blog.81c443a6b380add6">Choose one promise you can keep, set your availability and give people a reason to join.</p><a data-i18n="web-blog.94abff159453d156" class="idea-button" href="/sign-up" data-guide-cta={idea.id}>Start creating ↗</a><a data-i18n="web-blog.11637e1080803d62" class="guide-back" href="/ideas">Keep exploring ideas</a></div>
        </div>
      </div>
    </div>
    <TruckBorder kind="lotus" />
    <section class="guide-shell guide-related" aria-labelledby="related-title"><p data-i18n="web-blog.9978d34dfe5ad489" class="idea-kicker">What's next</p><h2 data-i18n="web-blog.025ebdbda6245493" id="related-title">More ideas in your corner</h2><div class="idea-grid">{related.map(item => <article class="idea-card"><a class="idea-card-link" href={item.href}><div class="idea-picture"><img src={publicImage(item.cardImage, { width: 900, fit: 'scale-down' })} width="1536" height="1024" alt="" loading="lazy" decoding="async" /></div><div class="idea-card-copy"><span data-i18n={`web-ideas.format.${item.format}`} class:list={['idea-format',item.format]}>{formats[item.format]}</span><h3 data-i18n={`web-ideas.${item.id}.title`}>{item.title}</h3><p data-i18n={`web-ideas.${item.id}.description`}>{item.description}</p><span data-i18n="web-blog.23324d592027957b" class="idea-read-guide">Read the guide ↗</span></div></a></article>)}</div></section>
  </main>
  <script>
    import { capture } from '../../../lib/analytics';
    const guide = document.querySelector<HTMLElement>('[data-creator-guide]');
    if (guide) {
      capture('creator_guide_view', { idea_id: guide.dataset.creatorGuide });
      guide.querySelector('[data-guide-cta]')?.addEventListener('click', () => capture('creator_guide_start', { idea_id: guide.dataset.creatorGuide }));
    }
  </script>
</Base>

