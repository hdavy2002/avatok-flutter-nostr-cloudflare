---
// Checkout shell. SSR-loads the listing so the page shows WHAT is being booked
// instantly (and rides the edge cache), then hydrates the BookingFlow island
// (client:load — checkout is interactive immediately). Browsing the listing is
// free; the email gate fires inside BookingFlow at the identify step, not here.
export const prerender = false;

import Base from '../../layouts/Base.astro';
import { Avatar, Pill } from '../../components';
import { cfImage } from '../../lib/config';
import { getListing, ApiError } from '../../lib/apiClient';
import { durationLabel, languageLabel } from '../../lib/card';
import type { CoverMedia, Listing } from '../../lib/types';
import BookingFlow from '../../islands/checkout/BookingFlow.tsx';

const { id } = Astro.params;

let listing: Listing | null = null;
let notFound = false;
try {
  listing = await getListing(id!);
} catch (e) {
  if (e instanceof ApiError && (e.status === 404 || e.status === 410)) notFound = true;
  else throw e;
}

if (notFound || !listing) {
  return new Response('Listing not found', { status: 404 });
}

// The checkout shell itself is public/cacheable; the island handles auth.
Astro.response.headers.set('Cache-Control', 'public, max-age=60, stale-while-revalidate=300');

const kind = (listing.kind ?? 'content') as string;
const isFreeEntry = Boolean(listing.free_entry);
const verb =
  kind === 'agent' ? 'Book a session' : kind === 'event' || kind === 'live' ? 'Get your ticket' : 'Book';

// [WEB-CHECKOUT-BUG-3] `listing.poster` is a LEGACY/hand-built-only alias the
// real worker response has never sent (see lib/card.ts's header comment) — it
// sends `cover_media`, an array of {type,url}. Reading `.poster` straight off
// the wire listing left this whole card blank: no image (bare placeholder
// box), and the raw `kind` string ("LIVE_EVENT") standing in for a real label.
function firstCoverUrl(media: CoverMedia[] | null | undefined): string | null {
  for (const m of media ?? []) {
    const url = m?.url ?? (m as unknown as { r2_key?: string } | null)?.r2_key;
    if (typeof url === 'string' && url) return url;
  }
  return null;
}
const coverUrl = listing.poster || firstCoverUrl(listing.cover_media);

/** Humanised kind label — mirrors islands/dashboard/CreatorListings.tsx's
 *  KIND_LABELS so the checkout summary and the creator dashboard agree. */
const KIND_LABELS: Record<string, string> = {
  live_event: 'Live event',
  live: 'Live event',
  event: 'Live event',
  consult: '1:1 consult',
  consult_1to1: '1:1 consult',
  agent: 'AI agent',
};
const kindLabel = isFreeEntry ? 'Free show' : (KIND_LABELS[kind] ?? 'Session');

// [LIST-DETAIL-BUG-1] Same host-timezone rule as the listing details page —
// format server-side in `listing.timezone` (default Asia/Kolkata), never the
// Worker's own UTC clock. Signature: formatListingTime(ms, timeZone): string.
const tz = listing.timezone || 'Asia/Kolkata';
function toMs(t?: number | null): number | null { if (t == null) return null; return t < 1e12 ? t * 1000 : t; }
function tzAbbr(ms: number, timeZone: string): string {
  try {
    const parts = new Intl.DateTimeFormat('en-US', { timeZone, timeZoneName: 'short' }).formatToParts(new Date(ms));
    return parts.find((p) => p.type === 'timeZoneName')?.value ?? '';
  } catch { return ''; }
}
function formatListingTime(ms: number, timeZone: string): string {
  const d = new Date(ms);
  if (Number.isNaN(d.getTime())) return '';
  try {
    const datePart = new Intl.DateTimeFormat('en-IN', { timeZone, weekday: 'short', day: 'numeric', month: 'short' }).format(d);
    const timePart = new Intl.DateTimeFormat('en-IN', { timeZone, hour: 'numeric', minute: '2-digit' }).format(d);
    const abbr = tzAbbr(ms, timeZone);
    return `${datePart} · ${timePart}${abbr ? ` ${abbr}` : ''}`;
  } catch { return d.toISOString(); }
}
const startMs = toMs(listing.starts_at);
const startsAtLabel = startMs != null ? formatListingTime(startMs, tz) : null;

const durationTag = durationLabel(listing.duration_min ?? null);
const langTag = languageLabel(listing.spoken_lang ?? null);

const hostName = listing.creator?.name || (listing.creator?.handle ? `@${listing.creator.handle}` : null);
---

<Base headerAuth="static" title={`${verb} · ${listing.title} · avatok.ai`} description={`${verb} with ${listing.creator?.name ?? 'a creator'} on avatok.ai.`} navStatic={true}>
  <main class="mx-auto max-w-5xl px-4 py-8">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-[minmax(0,340px)_1fr]">
      <!-- What you're booking (server-rendered, instant) -->
      <aside class="md:sticky md:top-20 self-start">
        <div class="overflow-hidden rounded-zine border-zine border-ink bg-paper2 shadow-zine">
          <div class="relative aspect-[4/5] w-full">
            {coverUrl ? (
              <img
                src={cfImage(coverUrl, { width: 680, fit: 'cover' })}
                alt={listing.title}
                class="h-full w-full object-cover"
                onerror="this.onerror=null;this.closest('.relative').classList.add('bk-poster-fallback');this.remove();"
              />
            ) : (
              <div class="bk-poster-fallback flex h-full w-full items-center justify-center font-mono uppercase text-inkMute text-[15px] tracking-[0.08em] font-bold">
                {kindLabel}
              </div>
            )}
            {listing.category && <span class="absolute right-3 top-3"><Pill kind="plain">{listing.category}</Pill></span>}
          </div>
        </div>
        <div class="mt-4 flex flex-col gap-2">
          <span class="font-mono font-bold uppercase text-[14px] tracking-[0.1em] text-blueInk">{kindLabel}</span>
          <h1 class="font-display font-semibold text-[26px] leading-tight text-ink">{listing.title}</h1>
          {listing.creator && (
            <a href={`/c/${encodeURIComponent(listing.creator.handle ?? listing.creator.id)}`} class="flex items-center gap-3 no-underline">
              <Avatar src={listing.creator.avatar} name={hostName ?? 'avaTOK creator'} size={40} />
              <span class="font-display font-semibold text-[16px] text-ink">{hostName ?? 'avaTOK creator'}</span>
            </a>
          )}
          {(startsAtLabel || durationTag || langTag) && (
            <div class="flex flex-wrap items-center gap-2 border-t-zine border-inkMute pt-2">
              {startsAtLabel && (
                <span class="font-mono font-bold text-[13px] text-inkSoft" data-listing-time data-ms={startMs} data-tz={tz}>
                  {startsAtLabel}
                </span>
              )}
              {durationTag && <Pill kind="plain">{durationTag}</Pill>}
              {langTag && <Pill kind="plain">{langTag}</Pill>}
            </div>
          )}
        </div>
      </aside>

      <!-- The interactive checkout (pick → identify → pay → confirm) -->
      <section>
        <header class="mb-5">
          <span class="font-mono font-bold uppercase text-[14px] tracking-[0.1em] text-blueInk">Checkout</span>
          <h2 class="mt-1 font-display font-semibold text-[28px] leading-tight text-ink">{verb}</h2>
          <p class="mt-1 font-body font-bold text-[14px] text-inkSoft">
            No app, no account hassle — just your email to send the confirmation.
          </p>
        </header>
        <BookingFlow client:load listing={listing} />
      </section>
    </div>
  </main>
</Base>

<style>
  /* [WEB-CHECKOUT-BUG-3] Striped placeholder for a missing/broken cover image —
     matches the bazaar cream-card border-ink look instead of a bare empty box. */
  .bk-poster-fallback {
    background-image: repeating-linear-gradient(
      45deg,
      rgba(22, 22, 20, 0.06) 0 10px,
      rgba(22, 22, 20, 0.12) 10px 20px
    );
  }
</style>

<script>
  // [LIST-DETAIL-BUG-1] Same host-time enhancer as the listing details page —
  // never replace the host time, only append "(your time: …)" when the
  // viewer's own zone differs from the listing's.
  (function enhanceListingTimesForViewer() {
    let viewerTz = 'Asia/Kolkata';
    try { viewerTz = Intl.DateTimeFormat().resolvedOptions().timeZone || viewerTz; } catch {}
    document.querySelectorAll('[data-listing-time]:not([data-viewer-enhanced])').forEach((el) => {
      el.setAttribute('data-viewer-enhanced', '1');
      const ms = Number(el.getAttribute('data-ms'));
      const listingTz = el.getAttribute('data-tz');
      if (!Number.isFinite(ms) || !listingTz || listingTz === viewerTz) return;
      try {
        const viewerStr = new Intl.DateTimeFormat('en-IN', {
          timeZone: viewerTz, weekday: 'short', day: 'numeric', month: 'short', hour: 'numeric', minute: '2-digit',
        }).format(new Date(ms));
        const note = document.createElement('span');
        note.style.opacity = '0.7';
        note.style.marginLeft = '0.4em';
        note.textContent = `(your time: ${viewerStr})`;
        el.appendChild(note);
      } catch { /* leave the host time as-is */ }
    });
  })();
</script>
