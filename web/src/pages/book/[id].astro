---
// Public event page — /book/<id>. THIS is Saa Thum's listing detail page.
//
// [WEB-OLD-CHECKOUT-GONE-1 2026-09-27] OWNER DECISION: the old checkout is gone. Only
// `live_event` listings render (EventPage.astro, "Book with my sankalp" →
// /book/<id>/checkout, the new checkout). Every other kind used to hydrate the
// old BookingFlow island (pick → identify → pay → confirm); that island and the
// whole islands/checkout folder were deleted, so other kinds now 404.
// /<handle>/<slug>, /l/<id> and /e/<id> all 301 here (lib/urls.ts listingPath).
//
// [SAATHUM-EVENT-PAGE 2026-09-26] For a `live_event` listing this now renders
// the full marketing/event page from the owner-approved mockup (EventPage.astro)
// — SSR, edge-cached, link-preview friendly — with "Book with my sankalp"
// linking to the checkout flow at /book/<id>/checkout (built separately,
// [SAATHUM-CHECKOUT-UI]).
export const prerender = false;

import Base from '../../layouts/Base.astro';
import { getListing, ApiError } from '../../lib/apiClient';
import { listingContent } from '../../lib/seo/sources';
import { listingOg } from '../../lib/og';
import type { Listing } from '../../lib/types';
import EventPage from '../../components/eventpage/EventPage.astro';

const { id } = Astro.params;

let listing: Listing | null = null;
let notFound = false;
try {
  listing = await getListing(id!);
} catch (e) {
  if (e instanceof ApiError && (e.status === 404 || e.status === 410)) notFound = true;
  else throw e;
}

if (notFound || !listing) {
  return new Response('Listing not found', { status: 404 });
}

// The checkout shell itself is public/cacheable; the island handles auth.
Astro.response.headers.set('Cache-Control', 'public, max-age=60, stale-while-revalidate=300');

const isLiveEvent = (listing.kind ?? '') === 'live_event';
if (!isLiveEvent) return new Response('Listing not found', { status: 404 });

// ── Event page SEO ─────────────────────────────────────────────────────────
const og = listingOg(listing);
const eventContent = listingContent(listing, og.image ? { url: og.image, alt: listing.title } : undefined);
---

<Base content={eventContent}>
  <EventPage listing={listing} />
</Base>
