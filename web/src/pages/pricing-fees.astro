---
export const prerender = true;
import Base from '../layouts/Base.astro';
import PricingCalculatorPreview from '../components/pricing/PricingCalculatorPreview.astro';
import '../styles/pricing-preview.css';
---

<Base title="Plan your usage · avaTOK" description="Plan your avaTOK usage with an interactive calculator. Explore monthly and yearly estimates using clearly labelled sample rates.">
  <main class="pricing-preview">
    <div class="pp-container">
      <header class="pp-intro">
        <div class="pp-intro-copy">
          <div class="pp-eyebrow"><span class="pp-preview-badge">Usage calculator</span><span>Plan your usage</span></div>
          <h1>Make room for your<br class="pp-desktop-break" /> next big idea<span>.</span></h1>
          <p>A quick conversation or a regular gathering. Shape your sessions and see how your usage adds up.</p>
        </div>
        <img class="pp-chai-art" src="/assets/pricing-preview/chai-kettle.jpeg" alt="" width="150" height="175" />
      </header>
      <PricingCalculatorPreview />
      <img class="pp-end-art" src="/assets/pricing-preview/floral-signal.jpeg" alt="" width="65" height="86" loading="lazy" />
      <p class="pp-footnote">An early look at our calculator. Options and rates are being finalized.</p>
    </div>
  </main>
</Base>
