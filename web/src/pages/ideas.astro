---
import { publicImage, publicImageSrcSet } from '../lib/config';
export const prerender = true;
import Base from '../layouts/Base.astro';
import TruckBorder from '../components/TruckBorder.astro';
import { creatorIdeas, topics, formats } from '../lib/creatorIdeas';
import '../styles/creator-ideas.css';
const travelArt = creatorIdeas.find(idea => idea.id === 'idea-8')!;
const pageTitle = '115 Creator & Work-from-Home Ideas · Saathum';
const pageDescription = 'Explore 115 creator ideas: live streaming, 1:1 sessions, group classes and daily-life vlogs, with practical guides and phone-first tips.';
const kitchenArt = creatorIdeas.find(idea => idea.id === 'idea-19')!;
const collection = { '@context':'https://schema.org', '@type':'CollectionPage', '@id':'https://saathum.com/ideas/#collection', url:'https://saathum.com/ideas/', name:pageTitle, description:pageDescription, inLanguage:'en-IN', image:'https://saathum.com'+kitchenArt.image, isPartOf:{'@id':'https://saathum.com/#website'}, mainEntity:{'@type':'ItemList', numberOfItems:creatorIdeas.length, itemListElement:creatorIdeas.map((idea,index)=>({'@type':'ListItem',position:index+1,url:'https://saathum.com'+idea.href,name:idea.title}))} };
---
<Base title={pageTitle} description={pageDescription} image={kitchenArt.image} imageAlt="A creator sharing a regional meal from a home kitchen" imageWidth={1536} imageHeight={1024}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(collection)} />
  <main class="idea-page" id="main-content">
    <section class="idea-hero idea-shell" aria-labelledby="idea-title">
      <div class="idea-hero-copy">
        <p data-i18n="web-ideas.db1a5a50e709de32" class="idea-kicker">The creator idea adda</p>
        <h1 id="idea-title"><span data-i18n="web-ideas.0b1e7a16adcc752e" class="idea-title-line">Apna idea.</span><span data-i18n="web-ideas.21faa4208e1c5719" class="idea-title-line idea-title-line--accent">Apna adda.</span></h1>
        <p><ui-copy style="display:contents" data-i18n="web-ideas.69e79d0fadf11b09">Ghar ki rasoi. Ladakh ki ride. Dil ki baat.</ui-copy><br /> <ui-copy style="display:contents" data-i18n="web-ideas.51b74fd1e9edbe9a">There’s more than one way to be a creator.</ui-copy></p>
        <a class="idea-button" href="#idea-catalogue"><ui-copy style="display:contents" data-i18n="web-ideas.7e95a9e7a7f0dcec">Find your idea</ui-copy> <span aria-hidden="true">↓</span></a>
        <p class="idea-handwritten"><ui-copy style="display:contents" data-i18n="web-ideas.53ad7d9a35fb191e">Tumhari duniya.</ui-copy><br /><ui-copy style="display:contents" data-i18n="web-ideas.f4da23d557644d4f">Kisi ka favourite corner.</ui-copy></p>
      </div>
      <div class="idea-hero-art" aria-hidden="true">
        <div class="idea-postcard"><div class="idea-picture"><img src={publicImage(travelArt.cardImage, { width: 900, fit: 'scale-down' })} width="1536" height="1024" alt="" fetchpriority="high" /></div><span data-i18n="web-ideas.fe270c5195d223a2">Pahadon se, live.</span></div>
        <div class="idea-postcard"><div class="idea-picture"><img src={publicImage(kitchenArt.cardImage, { width: 900, fit: 'scale-down' })} width="1536" height="1024" alt="" /></div><span data-i18n="web-ideas.d84479ca1a990640">Ghar se, dil se.</span></div>
        <div class="idea-stamp"><ui-copy style="display:contents" data-i18n="web-ideas.002b4cf3dd8e1c9d">Desi ideas.</ui-copy><br /><ui-copy style="display:contents" data-i18n="web-ideas.49437db6fc4b38bb">Endless possibilities.</ui-copy></div>
      </div>
    </section>
    <section data-india-i18n-attr="aria-label:web-ideas.c9a5cd535f8b84f8" class="idea-shell idea-intro" aria-label="Work-from-home creator ideas"><div style="grid-column:1/-1"><h2 data-i18n="web-ideas.af98ed0c64daf294">Explore a side business from home</h2><p data-i18n="web-ideas.68bc5f98fa46dfab">Looking for work-from-home ideas? Explore ways students, first-time creators and experienced hosts can offer their skills, conversations or everyday experiences. Many ideas start with a camera phone and reliable internet. These are independent creator business ideas, not salaried job vacancies or guaranteed earnings. Use the From home filter to find activities you can host indoors.</p></div></section>
    <TruckBorder kind="lotus" />
    <section data-india-i18n-attr="aria-label:web-ideas.b06e83de4a48db1b" class="idea-shell idea-intro" aria-label="Ways to create">
      <div><span data-i18n="web-ideas.ac1ff7008dcb9abb" class="idea-format live">Live stream</span><p data-i18n="web-ideas.7a41d49f2ae36de1">Show a place, a performance, or your everyday life. Let people join your world.</p></div>
      <div><span data-i18n="web-ideas.f6c57ba0202cdd2c" class="idea-format private">1:1 session</span><p data-i18n="web-ideas.a1aaca300cff73d2">Give one person your time, a useful skill, or a good conversation.</p></div>
      <div><span data-i18n="web-ideas.0923ad219c90c036" class="idea-format group">Group session</span><p data-i18n="web-ideas.59dded3c510de56d">Bring a small group together to learn, practise, make, or simply connect.</p></div>
    </section>
    <section class="idea-shell idea-daily" aria-labelledby="daily-title">
      <span data-i18n="web-ideas.c0bc3f3d64cfe725" class="idea-daily-label">Daily Life Live</span>
      <div><h2 data-i18n="web-ideas.562bc6b3e90d5793" id="daily-title">Koi show nahi. Bas tumhara din.</h2><p data-i18n="web-ideas.6fe1e0314756393d">Your village morning, study desk, shop, kitchen or balcony garden. An idea for an open-ended live vlog where viewers drop in, spend a little time, and come and go.</p></div>
      <a href="#idea-catalogue" data-daily-link><ui-copy style="display:contents" data-i18n="web-ideas.29afca04d02cab04">See daily-life ideas</ui-copy> <span aria-hidden="true">↗</span></a>
    </section>
    <section class="idea-shell idea-catalogue" id="idea-catalogue" aria-labelledby="catalogue-title">
      <div class="idea-section-heading"><div><p data-i18n="web-ideas.2393a28d5a04d104" class="idea-kicker">Socho. Chuno. Shuru karo.</p><h2 data-i18n="web-ideas.c326b964b43d7e0a" id="catalogue-title">What could your adda be?</h2></div><p>{creatorIdeas.length} <ui-copy style="display:contents" data-i18n="web-ideas.8a889b802f32d223">ideas to make your own.</ui-copy><br /><ui-copy style="display:contents" data-i18n="web-ideas.6ffc354c8ea39949">Inspiration for your next listing.</ui-copy></p></div>
      <div class="idea-controls" data-idea-controls hidden>
        <div data-india-i18n-attr="aria-label:web-ideas.016e94d8271cbc62" class="idea-format-filters" role="group" aria-label="Filter by session format">
          <button data-i18n="web-ideas.d85d120d65c189e6" type="button" data-format="all" aria-pressed="true">All ideas</button>
          {Object.entries(formats).map(([key,label]) => <button type="button" data-i18n={`web-ideas.format.${key}`} data-format={key} aria-pressed="false">{label}</button>)}
        </div>
        <div class="idea-search-row">
          <label class="idea-search"><ui-copy style="display:contents" data-i18n="web-ideas.76668e1f3eb53bea">Find your thing</ui-copy><input data-india-i18n-attr="placeholder:web-ideas.77cf5163ba980e29" id="idea-search" type="search" placeholder="Try puja, Ladakh, cooking, English…" autocomplete="off" /></label>
          <label><ui-copy style="display:contents" data-i18n="web-ideas.c45c5e6323138e45">Pick a topic</ui-copy><select id="idea-topic"><option data-i18n="web-ideas.29366ff59789ad75" value="all">All topics</option>{Object.entries(topics).map(([key,topic]) => <option data-i18n={`web-ideas.topic.${key}`} value={key}>{topic.label}</option>)}</select></label>
          <label class="idea-home-toggle"><input type="checkbox" id="idea-home" /> <ui-copy style="display:contents" data-i18n="web-ideas.50fb1f69cb64b60d">From home</ui-copy></label>
        </div>
        <p class="idea-result-count" id="idea-results" aria-live="polite"></p>
      </div>
      <div class="idea-grid">
        {creatorIdeas.map((idea) => <article class="idea-card" id={idea.id} data-idea-card data-format={idea.format} data-topic={idea.topic} data-setting={idea.setting}>
          <a class="idea-card-link" href={idea.href} aria-labelledby={`${idea.id}-title`} data-idea-guide={idea.id}><div class="idea-picture" aria-hidden="true"><img src={publicImage(idea.cardImage, { width: 900, fit: 'scale-down' })} srcset={publicImageSrcSet(idea.cardImage, [420, 640, 900, 1600], { fit: 'scale-down' })} sizes="(max-width:699px) 90vw, (max-width:1100px) 44vw, 29vw" alt="" width="1536" height="1024" loading="lazy" decoding="async" />{idea.badge && <span class="idea-editorial-badge">{idea.badge}</span>}</div>
          <div class="idea-card-copy"><div class="idea-chips"><span data-i18n={`web-ideas.format.${idea.format}`} class:list={['idea-format',idea.format]}>{formats[idea.format]}</span><span data-i18n={`web-ideas.topic.${idea.topic}`}>{topics[idea.topic].label}</span>{idea.setting === 'home' && <span data-i18n="web-ideas.50fb1f69cb64b60d">From home</span>}</div><h3 data-i18n={`web-ideas.${idea.id}.title`} id={`${idea.id}-title`}>{idea.title}</h3><p data-i18n={`web-ideas.${idea.id}.description`}>{idea.description}</p><span class="idea-read-guide"><ui-copy style="display:contents" data-i18n="web-ideas.83b3b277abbf82ba">Read the guide</ui-copy> <span aria-hidden="true">↗</span></span></div></a>
        </article>)}
      </div>
      <div class="idea-empty" hidden><h3 data-i18n="web-ideas.d94ce86a34fcd2ae">No ideas match just yet.</h3><p data-i18n="web-ideas.41267becc0bfb952">Try another word or explore a different topic.</p><button data-i18n="web-ideas.4ebcbee222cd385e" type="button" id="idea-reset">Show all ideas</button></div>
      <div class="idea-more-row"><button data-i18n="web-ideas.7bb51e00ed4b3288" class="idea-button idea-more" type="button" hidden>Show more ideas</button></div>
      <noscript><p class="idea-result-count">All {creatorIdeas.length} ideas are shown. Browser JavaScript enables search and filters.</p></noscript>
    </section>
    <section class="idea-shell idea-closing"><p data-i18n="web-ideas.d91eb6e64423d0ef" class="idea-handwritten">Chhoti shuruaat. Apni pehchaan.</p><h2 data-i18n="web-ideas.d8dd507634389836">Found your kind of adda?</h2><p data-i18n="web-ideas.841c0e677a091ef8">Give it your own voice, language and story.</p><div><a data-i18n="web-ideas.eff3d8eb55587294" class="idea-button" href="/sign-up" data-ideas-cta="start">Start creating</a><a data-i18n="web-ideas.202106bc05c50ec9" class="idea-market-link" href="/marketplace" data-ideas-cta="marketplace">Explore the marketplace ↗</a></div></section>
  </main>
  <script>
    import '../lib/creatorIdeasPage';
  </script>
</Base>
