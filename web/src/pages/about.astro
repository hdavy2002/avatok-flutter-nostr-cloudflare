---
// [WEB-ABOUT-BLOG-1 2026-09-30] OWNER: removed the woman-in-saree sticker; /about is now a
// blog article — intro (eyebrow, h1, lead, pill), then a WIDE hero photo
// (design/about-page/davy.png, cropped to /assets/about/about-hero-davy.jpg)
// in a white sticker border, then the unchanged story in the white card. Exact
// replica of the approved mock design/about-page/saathum-about-blog-mock.src.html
// (build-about-blog-mock.py). Story text unchanged. The share card is the hero photo.
// The notes below about the sticker-left layout are superseded by this block.
// [WEB-ABOUT-HIMALAYA-1 2026-09-29] OWNER: new origin story — the snowstorm night with a
// Himalayan pujari, the village that helped the next morning, and Saa Thum's mission to
// support remote mountain temples. Copy = design/about-page/saathum-about-himalaya-mock.src.html
// (same design; only the words changed). The girmitiya story is now one short section.
// [WEB-ABOUT-FOLK-1 2026-09-27] /about rebuilt to the owner-approved mockup
// design/about-page/saathum-about-mock.src.html (built by
// design/about-page/build-about-mock.py). OWNER: "exact replica of what you
// have shown me, not an inspired version." Replaces the archived
// layouts/Content.astro version and returns /about to the menus
// (lib/homeNavigation.ts) and out of lib/archivedPages.ts.
//
// NOTE FOR AI:
//  - Shell: the same folk shell as layouts/LegalFolk.astro — Base
//    chrome={false}, the `.folk-site[data-design="reference-v5"]`
//    wrapper carrying --folk-border-url, SiteHeader/SiteFooter `folk`,
//    Comfortaa+Nunito, theme-color #fff8e8. The mockup's own header/footer
//    are NOT copied — the live components are the header and footer.
//  - Page CSS: styles/about-folk.css (scoped under `.ab`). Every rule there
//    is the mockup's rule, `ab-` prefixed. The gold ribbon is the live
//    `.grand-divider`. There is no hero band on this page: the layout is the
//    die-cut sticker (design/desi-art/saathum.png, served from
//    /assets/about/about-sticker.png) pinned on the LEFT and the
//    story card on the RIGHT; on <=1100px the sticker stacks on top.
//  - SEO/OG: this page builds its own PublicContent (kind 'page') the same
//    way LegalFolk does, and its `image` is the sticker path itself, which
//    is what the /og/page/about.png renderer paints (resolve.ts reads the
//    `site:og-art` meta; prepare-og-art.mjs pre-renders any
//    /assets/saathum*/ artwork). So the social card = title + sticker.
//  - Exactly one <h1>. Emails stay plain text "support (@) saathum.com",
//    never mailto. Brand text is "Saa Thum". Address is Dehradun,
//    Uttarakhand (owner, 2026-09-29; was Mumbai) — no entity name on the page.
//  - The story is the owner's About copy (girmitiya diaspora, 1834–1917);
//    keep the history factual and keep the "no fear, no guaranteed
//    outcomes" promise intact when editing.
export const prerender = true;
import type { PublicContent } from '../lib/seo/types';
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { publicImage, publicImageSrcSet } from '../lib/config';
import { HOME_HEADER_LINKS } from '../lib/homeNavigation';
import '../styles/saathum-folk.css';
import '../styles/about-folk.css';
import { BRAND } from '../lib/brand';

const title = 'Our Story: A Snowstorm, a Pujari and a Promise';
const description = `How a Himalayan pujari who sheltered one of our co-founders from a blizzard inspired ${BRAND.name}, and why each havan you book now helps mountain temples.`;
const updated = '2026-09-29';
const HERO = '/assets/about/about-hero-davy.jpg';
const HERO_ALT = 'Wrapped in a woollen blanket with snow still on his shoulders, our co-founder grips a steel glass of ginger tea while the smiling pujari cooks rotis over the fire inside the stone temple.';

const content: PublicContent = {
  kind: 'page',
  key: '/about',
  canonicalPath: '/about',
  title,
  summary: description,
  visibility: 'public',
  modifiedAt: new Date(updated).toISOString(),
  image: { url: HERO, alt: HERO_ALT, revision: 'about-hero-davy-1' },
};

const heroSrc = publicImage(HERO, { width: 1200, fit: 'scale-down' });
const heroSrcSet = publicImageSrcSet(HERO, [480, 768, 1086], { fit: 'scale-down' });
const emblemSrc = publicImage('/assets/logo/emblem-diya-lotus.png', { width: 200, fit: 'scale-down' });
const namasteSrc = publicImage('/assets/how-it-works/namaste.webp', { width: 340, fit: 'scale-down' });
---
<Base content={content} chrome={false} indiaLandingLanguage={false}>
  <Fragment slot="head">
    <meta name="theme-color" content="#fff8e8" />
    <link rel="preload" as="style" onload="this.onload=null;this.rel='stylesheet'" href="https://fonts.googleapis.com/css2?family=Comfortaa:wght@400;500;600;700&family=Nunito:wght@400;600;700;800;900&display=swap" />
  </Fragment>
  <div class="folk-site" data-design="reference-v5" style={`--folk-border-url:url(${publicImage('/assets/bright/border.png', { width: 640, fit: 'scale-down' })})`}>
    <a class="folk-skip" href="#main-content">Skip to main content</a>
    <SiteHeader folk indiaLandingLanguage={false} responsiveHome referenceHome links={HOME_HEADER_LINKS} />
    <main id="main-content" class="ab">
      <section class="ab-about ab-wrap" aria-labelledby="page-title">
        <header class="ab-col ab-intro">
          <p class="ab-eyebrow">About {BRAND.name}</p>
          <h1 id="page-title">A blizzard, a lamp in a doorway, <em>and a pujari who let a stranger in.</em></h1>
          <p class="ab-lead">{BRAND.name} began far up in the Himalayas, with a glass of steaming tea, a borrowed quilt, and a mountain priest who owned very little yet shared every bit of it.</p>
          <div class="ab-story-meta"><span class="ab-pill"><span class="ab-dot"></span>Himalayan temples · Uttarakhand &amp; Himachal</span></div>
        </header>

        <figure class="ab-hero">
          <div class="ab-hero-frame"><img src={heroSrc} srcset={heroSrcSet} sizes="(max-width: 1240px) calc(100vw - 48px), 1150px" alt={HERO_ALT} width="1086" height="815" decoding="async" fetchpriority="high" /></div>
          <figcaption>Ginger tea, a borrowed quilt, and a fire that burned all night.</figcaption>
        </figure>

        <article class="ab-story">
          <div class="ab-prose">
          <h2>When the weather turned</h2>
          <p class="ab-drop">For years, one of our co-founders has trekked the high paths of the Himalayas. On one of those walks the weather changed within an hour. Grey cloud swallowed the valley and then everything went white. A wind tore down from the ridge hard enough to steal his breath, and snow drove in sideways, burying the trail ahead faster than he could find it.</p>
          <p>Through the whirling snow he caught a tiny glow of orange further down the slope. It was a diya, lit in the doorway of a stone temple barely larger than a village home, its slate roof already sagging under fresh snow.</p>
          
          <h2>Tea, rotis and a night of stories</h2>
          <p>The pujari asked no questions. He saw a half-frozen stranger knocking snow off his boots and simply drew him in beside the fire. Soon a steel glass of ginger tea was warming his hands, almost too hot to hold. Rotis came off the tawa with a bowl of dal, then blanket after blanket, and at last a heavy cotton quilt scented with woodsmoke and camphor.</p>
          <p>The storm hammered the stone walls until morning, and by the fire the two men talked. The pujari described the temple his family had tended for generations, the festivals that still draw the whole valley up the hill, and the sadhus who meditate in caves higher on the mountain. All winter long he climbs to them with food, on tracks few would dare even in summer.</p>
          <p>Pilgrims almost never make it here, he said with a smile. The buses stop at the famous shrines. Up here there is just the mountain, the temple bell, and whoever the snow happens to bring to the door.</p>
          
          <div class="ab-quote">
          <p>They owned almost nothing, <span>and still they gave me all of it.</span></p>
          <img src={emblemSrc} alt="" aria-hidden="true" width="2048" height="2048" loading="lazy" decoding="async" />
          </div>
          
          <h2>A village that came running</h2>
          <p>Morning broke clear, and the snow-covered valley glittered. He started down the path, but only a short way on, the new snow slid off a hidden sheet of ice and he fell heavily. His injured leg could not hold him.</p>
          <p>Before he could shout for help, the village was already on its way. One person hurried to fetch the pujari. An elderly woman heated mustard oil with turmeric and bound his leg in cloth. Young men shaped a walking stick from a deodar branch and took turns supporting him, one slow step after another, all the way to the road. Children raced ahead to sweep snow off the steepest bends, and at every turn a fresh pair of hands reached for his arm.</p>
          <p>No one wanted anything back. When he reached for his wallet, they only laughed and folded a small packet of prasad into his palm.</p>
          
          <h2>Shrines the pilgrimage trail passes by</h2>
          <p>All the way home, that little temple stayed on his mind. In the months after, he went searching, and discovered there were many more like it. Scattered through the Himalayas are modest temples to Shiva and Parvati, to Vishnu, to Ram and Sita and to the gentle Devis of the mountains, each with a tradition centuries old, each cared for by a pujari and a village who expect nothing in return.</p>
          <p>The usual pilgrimage routes never come near them. Their caretakers endure some of the harshest winters in the country, cut off by snow and living on very little, and they still carry food to the sadhus in the caves above.</p>
          
          <h2>So we built {BRAND.name}</h2>
          <p>{BRAND.name} is here to carry those temples to your home, and to repay a little of what their keepers give.</p>
          <p>Our small team hikes far into the hills with a camera and settles in beside the altar. There the temple's own pujari performs your havan or puja, speaking your <strong>sankalp with your name and your gotra</strong>, your wish and your family's names, just as he would if you were seated next to him. When the mountain network holds we stream it live, and we always film the complete ritual so you have a video to keep. Dry prasad from the temple is packed that same day and sent to you by courier.</p>
          <p>Each booking brings a Himalayan pujari and his village a fair and dependable income through the hard winter months, and lets them share a lifetime of devotion with families far away. Think of it as our way of paying back one glass of tea on a night of snow.</p>
          
          <h2>Why {BRAND.name}?</h2>
          <p>{BRAND.nameMeaningLong}</p>
          
          <h2>For families living far from India</h2>
          <p>A great many of the families who book with us live overseas — in the UK, the Caribbean, Fiji, Mauritius, North America and further still. Some have never set eyes on the Himalayas. With {BRAND.name}, a grandmother in Port of Spain or a family in Leicester can hear their own names spoken at a mountain altar and watch the sacred flames climb against the snowy peaks.</p>
          
          <h2>Our promises to you</h2>
          <ul class="ab-promise">
          <li>Positive temples only: Shiva and Parvati, Vishnu, Ram and Sita, Krishna and the gentle Himalayan Devis. Never animal sacrifice, never dark or cult practices.</li>
          <li>Benefic rituals only. No fear, no curses, and never a warning that something bad will happen if you don't book.</li>
          <li>No promised outcomes. A havan is an offering and a prayer, never a guarantee.</li>
          <li>The temple, the pujari and his village receive a fair share of every booking.</li>
          <li>The price you see is the price you pay. If mountain weather holds up your video or prasad, we let you know on WhatsApp and by email.</li>
          </ul>
          
          <p>On that snowy night, a stranger stood by our co-founder when he needed it most. Now we hope to stand by you, and by them.</p>
          
          <div class="ab-where">
          <div>
          <span class="ab-tag">Where we are</span>
          <p><strong>{BRAND.name}, Dehradun, Uttarakhand, India</strong>Our crew travels throughout Uttarakhand and Himachal. Email support (@) {BRAND.domain}; every family gets a reply.</p>
          </div>
          <a class="ab-btn" href="/temples">Meet our temples <span aria-hidden="true">→</span></a>
          </div>
          </div>
        </article>
      </section>
      <div class="grand-divider" aria-hidden="true"></div>

      <section class="ab-ask" aria-labelledby="ask-title">
        <div class="ab-wrap ab-ask-inner">
          <img src={namasteSrc} alt="" aria-hidden="true" width="550" height="640" loading="lazy" decoding="async" />
          <div>
            <h2 id="ask-title">Pray in the Himalayas with us, <span>wherever you live.</span></h2>
            <p>Book a havan at a mountain temple, or write to support (@) {BRAND.domain} and share your family's story with us.</p>
          </div>
          <div class="ab-ask-actions">
            <a class="ab-btn ab-btn--paper" href="/contact">Contact us</a>
            <a class="ab-btn ab-btn--paper" href="/marketplace">Join a havan</a>
          </div>
        </div>
      </section>
    </main>
    <SiteFooter folk indiaLandingLanguage={false} />
  </div>
</Base>
