---
import { BRAND } from '../lib/brand';
import { BUSINESS_CONTACT } from '../lib/businessContact';
import HelloFraandsPage from '../layouts/HelloFraandsPage.astro';
export const prerender = true;
---
<HelloFraandsPage updated="2026-10-14" title="About us" summary="Asli logon se baat, apni marzi aur apne waqt par.">
<h2>A place for a conversation</h2>
<p>Hello Fraands lets adults talk to a real person privately, by the minute. Choose a mood, a language and a host. Personal phone numbers are hidden from the other person. Calls are not recorded; AI keeps an eye on every live call for safety.</p>
<p>This is not professional advice, dating, therapy or a crisis line. Hosts offer conversation and company. Read our <a href="/disclaimer">service disclaimer</a> and <a href="/recording-policy">recording &amp; AI safety policy</a>.</p>
<h2>Who runs Hello Fraands</h2>
<dl><dt>Business name</dt><dd>{BUSINESS_CONTACT.name}</dd><dt>Public postal address</dt><dd>{BUSINESS_CONTACT.postalAddress}</dd><dt>Support</dt><dd><a href={`mailto:${BRAND.emails.support}`}>{BRAND.emails.support}</a></dd></dl>
<p>For complaints, use our <a href="/grievance">grievance process</a>.</p>
</HelloFraandsPage>
