---
// [WEB-ABOUT-HIMALAYA-1 2026-09-29] OWNER: new origin story — the snowstorm night with a
// Himalayan pujari, the village that helped the next morning, and Saa Thum's mission to
// support remote mountain temples. Copy = design/about-page/saathum-about-himalaya-mock.src.html
// (same design; only the words changed). The girmitiya story is now one short section.
// [WEB-ABOUT-FOLK-1 2026-09-27] /about rebuilt to the owner-approved mockup
// design/about-page/saathum-about-mock.src.html (built by
// design/about-page/build-about-mock.py). OWNER: "exact replica of what you
// have shown me, not an inspired version." Replaces the archived
// layouts/Content.astro version and returns /about to the menus
// (lib/homeNavigation.ts) and out of lib/archivedPages.ts.
//
// NOTE FOR AI:
//  - Shell: the same folk shell as layouts/LegalFolk.astro — Base
//    chrome={false}, the `.folk-site[data-design="saathum-reference-v5"]`
//    wrapper carrying --folk-border-url, SiteHeader/SiteFooter `folk`,
//    Comfortaa+Nunito, theme-color #fff8e8. The mockup's own header/footer
//    are NOT copied — the live components are the header and footer.
//  - Page CSS: styles/about-folk.css (scoped under `.ab`). Every rule there
//    is the mockup's rule, `ab-` prefixed. The gold ribbon is the live
//    `.grand-divider`. There is no hero band on this page: the layout is the
//    die-cut sticker (design/desi-art/saathum.png, served from
//    /assets/saathum-about/about-sticker.png) pinned on the LEFT and the
//    story card on the RIGHT; on <=1100px the sticker stacks on top.
//  - SEO/OG: this page builds its own PublicContent (kind 'page') the same
//    way LegalFolk does, and its `image` is the sticker path itself, which
//    is what the /og/page/about.png renderer paints (resolve.ts reads the
//    `saathum:og-art` meta; prepare-og-art.mjs pre-renders any
//    /assets/saathum*/ artwork). So the social card = title + sticker.
//  - Exactly one <h1>. Emails stay plain text "support (@) saathum.com",
//    never mailto. Brand text is "Saa Thum". Address is West Andheri,
//    Mumbai (owner, 2026-09-27) — no entity name on the page.
//  - The story is the owner's About copy (girmitiya diaspora, 1834–1917);
//    keep the history factual and keep the "no fear, no guaranteed
//    outcomes" promise intact when editing.
export const prerender = true;
import type { PublicContent } from '../lib/seo/types';
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { publicImage, publicImageSrcSet } from '../lib/config';
import { HOME_HEADER_LINKS } from '../lib/homeNavigation';
import '../styles/saathum-folk.css';
import '../styles/about-folk.css';

const title = 'About us — it began on a snowbound night in a Himalayan temple';
const description = 'Saa Thum was born in a snowstorm, when a Himalayan pujari sheltered our co-founder for the night. Today our crew travels to remote, positive mountain temples to perform havans in your name, and every booking supports the pujaris and villages who keep them alive.';
const updated = '2026-09-29';
const STICKER = '/assets/saathum-about/about-sticker.png';
const OG_ART = '/assets/saathum-about/about-og-woman.jpg';

const content: PublicContent = {
  kind: 'page',
  key: '/about',
  canonicalPath: '/about',
  title,
  summary: description,
  visibility: 'public',
  modifiedAt: new Date(updated).toISOString(),
  // [ABOUT-OG-CROP-1 2026-09-27] Share card uses a woman-only crop of the
  // sticker (no सा थम lettering, no diya). The full 1000x2020 sticker was
  // centre-cropped by the card's arch and cut her head off on WhatsApp.
  image: { url: OG_ART, alt: 'A smiling woman in a red silk saree greeting you with joined hands — Saa Thum', revision: 'about-og-woman-1' },
};

const stickerSrc = publicImage(STICKER, { width: 920, fit: 'scale-down' });
const stickerSrcSet = publicImageSrcSet(STICKER, [340, 460, 920], { fit: 'scale-down' });
const emblemSrc = publicImage('/assets/saathum-logo/saathum-emblem-diya-lotus.png', { width: 200, fit: 'scale-down' });
const namasteSrc = publicImage('/assets/saathum-how-it-works/namaste.webp', { width: 340, fit: 'scale-down' });
---
<Base content={content} chrome={false} indiaLandingLanguage={false}>
  <Fragment slot="head">
    <meta name="theme-color" content="#fff8e8" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Comfortaa:wght@400;500;600;700&family=Nunito:wght@400;600;700;800;900&display=swap" />
  </Fragment>
  <div class="folk-site" data-design="saathum-reference-v5" style={`--folk-border-url:url(${publicImage('/assets/saathum-bright/border.png', { width: 640, fit: 'scale-down' })})`}>
    <a class="folk-skip" href="#main-content">Skip to main content</a>
    <SiteHeader folk indiaLandingLanguage={false} responsiveHome referenceHome links={HOME_HEADER_LINKS} />
    <main id="main-content" class="ab">
      <section class="ab-about ab-wrap" aria-labelledby="page-title">
        <div class="ab-about-inner">
          <figure class="ab-art">
            <img src={stickerSrc} srcset={stickerSrcSet} sizes="(max-width: 1100px) min(340px, 100vw), 460px" alt="A smiling woman in a red silk saree greeting you with joined hands, the words सा थम, and a lit brass diya resting on a pink lotus." width="1000" height="2020" decoding="async" fetchpriority="high" />
            <figcaption>सा थम · Saa Thum · “with you”</figcaption>
          </figure>

          <article class="ab-story">
          <p class="ab-eyebrow">About Saa Thum</p>
          <h1 id="page-title">It began on a snowbound night, <em>in a temple no map remembers.</em></h1>
          <p class="ab-lead">Saa Thum was born high in the Himalayas, from a cup of hot tea, a borrowed quilt and the kindness of a pujari who had almost nothing and gave it all.</p>
          <div class="ab-story-meta"><span class="ab-pill"><span class="ab-dot"></span>Himalayan temples · Uttarakhand &amp; Himachal</span></div>
          
          <div class="ab-prose">
          <h2>Caught by the storm</h2>
          <p class="ab-drop">One of our co-founders has spent years walking the high trails of the Himalayas. On one of those treks the sky turned in the space of an hour. The light went grey, then white. The wind came down off the ridge so hard it pushed the breath back into his chest, and the snow began to fall sideways, filling the path in front of him faster than he could follow it.</p>
          <p>Somewhere below, through the swirl, he saw a small flicker of orange. It was a diya, burning in the doorway of a stone temple no bigger than a village house, its slate roof already heavy with snow.</p>
          
          <h2>A cup of tea, a quilt, and a long night</h2>
          <p>The pujari did not ask who he was or where he was going. He took one look at the stranger at his door, stamping frozen boots, and pulled him inside next to the fire. Within minutes there was a steel glass of ginger tea in his hands, so hot he could barely hold it. Then came rotis from the tawa, a bowl of dal, and one blanket after another, until finally a thick cotton quilt that smelled of woodsmoke and old camphor.</p>
          <p>Outside, the storm roared against the walls all night. Inside, the two of them talked. The pujari spoke about the temple his family had looked after for generations, the festivals the whole valley still climbs up for, and the sadhus meditating in caves further up the mountain. Through every winter he carries food up to them, on paths that most people would not walk in summer.</p>
          <p>Hardly any pilgrims ever come, he said, smiling. The buses go to the famous shrines. Up here it is only the mountain, the bell, and whoever the snow sends to the door.</p>
          
          <div class="ab-quote">
          <p>They had so little, <span>and they gave me everything they had.</span></p>
          <img src={emblemSrc} alt="" aria-hidden="true" width="2048" height="2048" loading="lazy" decoding="async" />
          </div>
          
          <h2>The morning the village carried him</h2>
          <p>By dawn the storm had passed and the whole valley shone. He set off down the trail, but a few hundred metres on, the fresh snow gave way on a hidden patch of ice, and he went down hard. His leg would not take his weight.</p>
          <p>The village came to him before he could even call out. Someone ran for the pujari. A grandmother warmed turmeric and mustard oil and wrapped his leg in a cloth. Young men cut him a walking stick from a deodar branch, and between them they helped him, step by careful step, down to the road. Children ran ahead to clear the snow from the steepest turns, and at every bend someone new was waiting to take his arm.</p>
          <p>Nobody asked for anything in return. When he tried to pay, they laughed and pressed a packet of prasad into his hand instead.</p>
          
          <h2>The temples the pilgrim routes forget</h2>
          <p>On the long drive home, he could not stop thinking about that temple. Over the months that followed he went looking, and he found it was not alone. All across the Himalayas there are small temples of Shiva and Parvati, of Vishnu, of Ram and Sita, of the gentle mountain Devis, each with its own old tradition, each kept alive by a pujari and a village who ask for nothing.</p>
          <p>Ordinary pilgrimage never reaches them. And the people who keep them alive face the hardest winters in India, with no road in the snow and very little income, while still feeding the sadhus in the caves above.</p>
          
          <h2>So we built Saa Thum</h2>
          <p>Saa Thum exists to bring those temples to you, and to give something back to the people who keep them alive.</p>
          <p>Our small crew travels deep into the mountains, carries the camera up the trail, and sets up beside the altar. The temple's own pujari performs your havan or puja with your <strong>sankalp in your name and your gotra</strong>, with your wish and the names of your family, exactly as if you were sitting beside him. We live stream it when the mountain network allows, and we always record the whole ritual, so the video is yours to keep. Dry prasad from the temple is packed the same day and couriered to your door.</p>
          <p>Every booking gives a Himalayan pujari and his village a fair, steady income through the long winters, and a way to share a lifetime of devotion with families far away. It is our way of returning a cup of tea on a snowbound night.</p>
          
          <h2>For families far from home</h2>
          <p>Many of the families who book with us live far from India, in the UK, the Caribbean, Fiji, Mauritius, North America and beyond. Some have never seen the Himalayas. Through Saa Thum, a grandmother in Port of Spain or a family in Leicester can hear their names spoken at a mountain temple, and watch the fire rise with the snow peaks behind it.</p>
          
          <h2>What we promise</h2>
          <ul class="ab-promise">
          <li>We only work with positive temples: Shiva and Parvati, Vishnu, Ram and Sita, Krishna and the gentle Himalayan Devis. No animal sacrifice, no dark or cult practices, ever.</li>
          <li>We only perform benefic rituals. No fear, no curses, no “do this or something bad will happen”.</li>
          <li>We never promise outcomes. A havan is an offering and a prayer, not a guarantee.</li>
          <li>A fair share of every booking goes to the temple, the pujari and his village.</li>
          <li>What you see is what you pay. And if the mountains delay your video or prasad, we tell you on WhatsApp and by email.</li>
          </ul>
          
          <p>Saa Thum means “with you”. That night in the snow, a stranger was with our co-founder when he needed it most. Now we would like to be with you, and with them.</p>
          
          <div class="ab-where">
          <div>
          <span class="ab-tag">Where we are</span>
          <p><strong>Saa Thum, West Andheri, Mumbai, India</strong>Our crew works across Uttarakhand and Himachal. Write to us at support (@) saathum.com. We reply to every family.</p>
          </div>
          <a class="ab-btn" href="/temples">See our temples <span aria-hidden="true">→</span></a>
          </div>
          </div>
          </article>
        </div>
      </section>
      <div class="grand-divider" aria-hidden="true"></div>

      <section class="ab-ask" aria-labelledby="ask-title">
        <div class="ab-wrap ab-ask-inner">
          <img src={namasteSrc} alt="" aria-hidden="true" width="550" height="640" loading="lazy" decoding="async" />
          <div>
            <h2 id="ask-title">Come to the mountains with us, <span>from wherever you are.</span></h2>
            <p>Join a havan at a Himalayan temple, or write to support (@) saathum.com and tell us your family's story.</p>
          </div>
          <div class="ab-ask-actions">
            <a class="ab-btn ab-btn--paper" href="/contact">Contact us</a>
            <a class="ab-btn ab-btn--paper" href="/marketplace">Join a havan</a>
          </div>
        </div>
      </section>
    </main>
    <SiteFooter folk indiaLandingLanguage={false} />
  </div>
</Base>
