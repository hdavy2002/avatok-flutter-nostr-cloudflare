---
// AvaAdmin — Overview / bird's-eye home (§5.1). SSR shell; the island fetches
// and verifies admin client-side (the Worker is the real boundary).
export const prerender = false;
import Base from '../../layouts/Base.astro';
import OverviewCards from '../../islands/admin/OverviewCards.tsx';
import ListingsPanel from '../../islands/admin/ListingsPanel.tsx';
import LiveFeed from '../../islands/admin/LiveFeed.tsx';
import AgentsPanel from '../../islands/admin/AgentsPanel.tsx';
import AnalyticsCards from '../../islands/admin/AnalyticsCards.tsx';
import AlertsInbox from '../../islands/admin/AlertsInbox.tsx';
import AuditLog from '../../islands/admin/AuditLog.tsx';
Astro.response.headers.set('Cache-Control', 'private, no-store');

const TABS = [
  ['Overview', '/admin'], ['Listings', '/admin/listings'], ['Live', '/admin/live'], ['Users', '/admin/users'],
  ['Money', '/admin/money'], ['Creators', '/admin/creators'], ['Analytics', '/admin/analytics'], ['System', '/admin/system'],
];
const current = '/admin';
---
<Base headerAuth="in" noindex title="AvaAdmin · Mission control" description="Platform mission control.">
  <main class="mx-auto max-w-[1500px] px-4 py-6 lg:px-6">
    <div class="grid gap-6 lg:grid-cols-[230px_minmax(0,1fr)] lg:items-start">
      <aside class="lg:sticky lg:top-6">
        <div class="rounded-2xl border-zine border-ink bg-card p-4 shadow-zine-sm">
          <div class="mb-5 border-b border-ink/20 pb-4">
            <span class="font-mono text-[12px] font-bold uppercase tracking-[0.12em] text-blueInk">AvaAdmin</span>
            <h1 class="mt-1 font-display text-[30px] font-semibold leading-none text-ink">Mission control</h1>
            <p class="mt-2 font-mono text-[11px] font-bold uppercase tracking-[0.08em] text-inkMute">Everything happening, live.</p>
          </div>
          <nav aria-label="Admin sections" class="flex gap-2 overflow-x-auto lg:flex-col lg:overflow-visible">
            {TABS.map(([label, href]) => (
              <a href={href} class={`shrink-0 rounded-full border-zine border-ink px-3 py-2 font-mono text-[11px] font-bold uppercase tracking-[0.04em] transition-colors ${href === current ? 'bg-lime text-ink shadow-zine-xs' : 'bg-paper text-inkSoft hover:bg-lime/40'}`}>{label}</a>
            ))}
          </nav>
          <div class="mt-5 hidden border-t border-ink/20 pt-4 lg:block">
            <p class="font-mono text-[11px] font-bold uppercase tracking-[0.08em] text-inkMute">Quick links</p>
            <div class="mt-2 flex flex-col gap-1 font-mono text-[12px] font-bold text-inkSoft">
              <a href="/admin/money" class="hover:text-ink">Finance &amp; payouts →</a>
              <a href="/admin/users" class="hover:text-ink">Find a user →</a>
              <a href="/marketplace" class="hover:text-ink">View marketplace →</a>
            </div>
          </div>
        </div>
      </aside>

      <div class="min-w-0">
        <header class="mb-6 flex flex-wrap items-end justify-between gap-3">
          <div><span class="font-mono text-[13px] font-bold uppercase tracking-[0.1em] text-blueInk">Live command center</span><h2 class="mt-1 font-display text-[34px] font-semibold leading-tight text-ink">The whole bazaar, at a glance.</h2></div>
          <span class="rounded-full border border-ink bg-card px-3 py-1 font-mono text-[11px] font-bold uppercase tracking-[0.06em] text-inkMute">auto-refreshing panels</span>
        </header>

        <div class="flex flex-col gap-10">
          <section id="overview"><OverviewCards client:load /></section>
          <section id="listings" class="border-t-2 border-dashed border-ink/20 pt-8"><div class="mb-3 flex flex-wrap items-baseline justify-between gap-2"><h3 class="font-display text-[25px] font-semibold text-ink">Listing approvals &amp; posters</h3><a href="/admin/listings" class="font-mono text-[11px] font-bold uppercase text-blueInk">Open queue →</a></div><ListingsPanel client:visible /></section>
          <section id="live" class="border-t-2 border-dashed border-ink/20 pt-8"><div class="mb-3 flex flex-wrap items-baseline justify-between gap-2"><h3 class="font-display text-[25px] font-semibold text-ink">Live operations</h3><a href="/admin/live" class="font-mono text-[11px] font-bold uppercase text-blueInk">Full feed →</a></div><LiveFeed client:visible /></section>
          <section id="creators" class="border-t-2 border-dashed border-ink/20 pt-8"><div class="mb-3 flex flex-wrap items-baseline justify-between gap-2"><h3 class="font-display text-[25px] font-semibold text-ink">Creators &amp; AI agents</h3><a href="/admin/creators" class="font-mono text-[11px] font-bold uppercase text-blueInk">Creator ops →</a></div><AgentsPanel client:visible /></section>
          <section id="analytics" class="border-t-2 border-dashed border-ink/20 pt-8"><div class="mb-3 flex flex-wrap items-baseline justify-between gap-2"><h3 class="font-display text-[25px] font-semibold text-ink">Analytics pulse</h3><a href="/admin/analytics" class="font-mono text-[11px] font-bold uppercase text-blueInk">Deep analytics →</a></div><AnalyticsCards client:visible /></section>
          <section id="system" class="border-t-2 border-dashed border-ink/20 pt-8"><h3 class="mb-3 font-display text-[25px] font-semibold text-ink">Alerts, roles &amp; audit</h3><AlertsInbox client:visible /><div class="mt-8"><h4 class="mb-3 font-display text-[20px] font-semibold text-ink">Recent admin activity</h4><AuditLog client:visible /></div></section>
        </div>
      </div>
    </div>
  </main>
</Base>
