---
// [AUMFE-HELP-LEGAL-PREVIEW-1] ADMIN-ONLY preview of the hidden "Talk to a guide" help topics.
// Why: every article in src/content/help/talk-to-a-guide is `draft: true`, so getHelpEntries()
// leaves it out of the public help centre, the search index and the sitemap. The owner needs to read
// them in the real help-centre styling before a payment gateway is approved.
//
// NOTE FOR AI:
//  - Server-rendered (prerender = false) behind the Admin 2 shell: AdminNav asks GET /api/admin/whoami
//    and hides everything below until the verdict is "ok". The page is noindex.
//  - It reads the collection WITHOUT the draft filter and only the talk-to-a-guide section. Nothing
//    here is prerendered, so no static HTML under dist/ contains these articles.
//  - Markdown is rendered by Astro's render(), which already runs lib/remarkBrand.mjs, so
//    {{brand.name}} / {{brand.domain}} are filled in the body; the frontmatter is filled below.
//  - To publish: remove `draft: true` from the article files; delete this page when no longer needed.
export const prerender = false;
import { getCollection, render } from 'astro:content';
import Admin2 from '../../../layouts/Admin2.astro';
import PreviewRibbon from '../../../components/PreviewRibbon.tsx';
import { fillBrandTokensDeep } from '../../../lib/brandTokens';
import { dateLabel, readMinutes, AUDIENCE_LABEL } from '../../../components/help/helpSkin';
import '../../../styles/saathum-folk.css';
import '../../../styles/help-skin.css';

const raw = await getCollection('help', (e) => e.data.section === 'talk-to-a-guide');
const entries = raw
  .map((e) => ({ ...e, data: fillBrandTokensDeep(e.data) }))
  .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title));
const rendered = await Promise.all(
  entries.map(async (entry) => ({ entry, Body: (await render(entry)).Content })),
);
const slugOf = (id: string) => id.replace(/^.*\//, '');
---

<Admin2
  title="Help preview"
  heading="Help preview: Talk to a guide"
  subtitle={`Hidden until a payment gateway is approved. ${entries.length} articles, shown with the real help-centre styling. Customers cannot see this page.`}
  active="preview-help"
>
  <meta name="robots" content="noindex,nofollow" slot="head" />
  <a id="top" aria-hidden="true"></a>
  <div class="mb-5"><PreviewRibbon client:load force /></div>

  <div class="folk-site" data-design="reference-v5">
    <div class="hs pv-help">
      <nav class="pv-list" aria-label="Articles in this preview">
        <b>Articles</b>
        <ol>
          {rendered.map(({ entry }) => (
            <li><a href={`#a-${slugOf(entry.id)}`}>{entry.data.title}</a></li>
          ))}
        </ol>
      </nav>

      <div class="pv-articles">
        {rendered.map(({ entry, Body }) => (
          <section id={`a-${slugOf(entry.id)}`} class="pv-art">
            <article class="hs-article">
              <p class="pv-meta">
                Draft · Talk to a guide · Read in {readMinutes(entry)} min · Updated {dateLabel(entry.data.updated)} · {AUDIENCE_LABEL[entry.data.audience]}
              </p>
              <h2 class="pv-title">{entry.data.title}</h2>
              <p class="pv-desc">{entry.data.description}</p>
              <div class="hs-prose">
                <Body />
                {entry.data.faq.length > 0 && (
                  <div class="hs-mini-faq" role="group" aria-label="Quick answers">
                    {entry.data.faq.map((f, i) => (
                      <details open={i === 0}><summary>{f.q}</summary><p>{f.a}</p></details>
                    ))}
                  </div>
                )}
              </div>
              <p class="pv-top"><a href="#top">Back to the list</a></p>
            </article>
          </section>
        ))}
      </div>
    </div>
  </div>
</Admin2>

<style is:global>
  .pv-help { display: grid; grid-template-columns: 260px minmax(0, 1fr); gap: 28px; align-items: start; }
  .pv-help .pv-list { position: sticky; top: 16px; background: #fff; border: 5px solid #fff; border-radius: 18px; box-shadow: 0 8px 22px #17343c1a; padding: 14px 16px; max-height: calc(100vh - 32px); overflow: auto; }
  .pv-help .pv-list b { display: block; margin-bottom: 8px; font-weight: 900; }
  .pv-help .pv-list ol { margin: 0; padding-left: 20px; display: grid; gap: 6px; font-size: 15px; font-weight: 700; }
  .pv-help .pv-art { margin-bottom: 28px; scroll-margin-top: 16px; }
  .pv-help .pv-meta { font-size: 13px; font-weight: 800; letter-spacing: .04em; text-transform: uppercase; color: #8a5a2b; padding-top: 14px; }
  .pv-help .pv-title { font-size: clamp(26px, 2.4vw, 36px); font-weight: 900; margin: 6px 0 8px; line-height: 1.15; }
  .pv-help .pv-desc { font-size: 17px; font-weight: 600; opacity: .8; margin-bottom: 8px; }
  .pv-help .pv-top { margin-top: 18px; font-size: 14px; font-weight: 800; }
  @media (max-width: 900px) {
    .pv-help { grid-template-columns: 1fr; }
    .pv-help .pv-list { position: static; max-height: none; }
  }
</style>
