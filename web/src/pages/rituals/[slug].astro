---
// [SAATHUM-GUIDE-1 2026-09-25] One knowledge article per ritual. Reuses the old
// creator-guide layout (creator-guide.css) so the design stays identical.
// NOTE FOR AI: content comes from lib/ritualGuides.ts. The image path is fixed
// by slug (/assets/saathum-rituals/<slug>.png) — drop the file in and it shows.
// Copy rules: benefic only, "traditionally sought" benefits, no guaranteed
// outcomes, no medical claims.
import { publicImage, publicImageSrcSet } from '../../lib/config';
export const prerender = true;
import Base from '../../layouts/Base.astro';
import TruckBorder from '../../components/TruckBorder.astro';
import { rituals, ritualCategories, ritualTypes, relatedRituals, commitmentFor, muhuratFor, type Ritual } from '../../lib/ritualGuides';
import { storyFor } from '../../lib/ritualStories';
import type { PublicContent } from '../../lib/seo/types';
import '../../styles/creator-ideas.css';
import '../../styles/creator-guide.css';
export function getStaticPaths() {
  return rituals.map(ritual => ({ params: { slug: ritual.slug }, props: { ritual } }));
}
const { ritual } = Astro.props as { ritual: Ritual };
const kind = ritualTypes[ritual.type].toLowerCase();
const related = relatedRituals(ritual, 3);
const bookHref = '/marketplace?q=' + encodeURIComponent(ritual.title.replace(/\s*\(.*\)\s*/, ' ').trim());
const articleTitle = `${ritual.title} — Meaning, Story, Benefits & How to Join Live · Saathum`;
const articleDescription = `${ritual.description} Why it is offered to ${ritual.deity}, the story behind it, who it is for, and how to join live from anywhere.`;
const content: PublicContent = {
  kind: 'article',
  key: ritual.slug,
  canonicalPath: ritual.href,
  title: articleTitle,
  summary: articleDescription,
  visibility: 'public',
  publishedAt: '2026-09-25',
  modifiedAt: '2026-09-25',
  image: { url: ritual.image, alt: ritual.imageAlt, revision: ritual.slug },
  breadcrumbs: [
    { name: 'Puja & Havan Guide', path: '/rituals' },
    { name: ritual.title, path: ritual.href },
  ],
  article: { authorName: 'Saathum', section: ritualCategories[ritual.category], keywords: ritual.tags },
};
const keepReady = ['A small lamp or diya', 'An incense stick', 'A fresh flower', 'A glass of water', 'A small sweet to offer'];
// [SAATHUM-GUIDE-2 2026-09-25] Owner's havan-first model: a HAVAN is an open, shared
// live event anyone can join (many devotees, one fire, nothing personal); a PUJA
// is the limited private option for one family. Copy branches on this.
const isHavan = ritual.type === 'havan';
const story = storyFor(ritual.slug);
const HAVAN_FROM = '₹99'; // owner-stated starting price for shared havans
---
<Base content={content}>
  <main class="idea-page creator-guide" id="main-content" data-ritual-article={ritual.slug}>
    <div class="guide-shell">
      <nav class="guide-breadcrumb" aria-label="Breadcrumb"><a href="/rituals">Puja &amp; Havan Guide</a><span aria-hidden="true">/</span><a href={'/rituals?for=' + ritual.category + '#idea-catalogue'}>{ritualCategories[ritual.category]}</a></nav>
      <header class="guide-heading">
        <p class="idea-kicker">{ritual.deity}</p>
        <div class="idea-chips"><span class:list={['idea-format', ritual.type === 'havan' ? 'live' : 'private']}>{ritualTypes[ritual.type]}</span><span>{ritualCategories[ritual.category]}</span><span>{ritual.duration}</span></div>
        <h1>{ritual.title}</h1>
        <p class="guide-lead">{ritual.description}</p>
        <p class="guide-byline">{isHavan ? 'An open live havan anyone can join · Performed by experienced temple priests · Prasad by courier' : 'A private puja for your family · Performed by experienced temple priests · Prasad by courier'}</p>
      </header>
      <figure class="guide-hero"><img src={publicImage(ritual.image, { width: 900, fit: 'scale-down' })} srcset={publicImageSrcSet(ritual.image, [420, 640, 900, 1600], { fit: 'scale-down' })} sizes="(max-width:699px) 90vw, (max-width:1440px) 92vw, 1320px" alt={ritual.imageAlt} width="1536" height="1024" fetchpriority="high" /><figcaption>{ritual.deity} · May every blessing find its way to you.</figcaption></figure>
      <div class="guide-layout">
        <aside class="guide-sidebar" aria-label="Article navigation">
          <p class="idea-kicker">In this guide</p>
          <nav><a href="#about">About this {kind}</a><a href="#why-deity">Why {ritual.deity}</a><a href="#blessings">Blessings devotees seek</a><a href="#who">Who it is for</a><a href="#when">Best time</a>{isHavan && <a href="#together">The power of many</a>}<a href="#altar">Our temple priests</a><a href="#value">{isHavan ? 'Why it costs so little' : 'Everything arranged'}</a><a href="#from-home">Taking part from home</a><a href="#prasad">Prasad by courier</a><a href="#good-to-know">Good to know</a></nav>
          <p class="guide-note">Only joy.<br />Only blessings.</p>
        </aside>
        <div class="guide-body">
          <section id="about"><p class="idea-kicker">01 · The ritual</p><h2>About the {ritual.title}</h2><p>{ritual.description}</p><p>{isHavan
            ? 'In a havan, the priest offers ghee, grains and sacred herbs into the consecrated fire with every mantra. In tradition, Agni — the fire — carries each offering and prayer to the divine. It is one of the oldest and most joyful ways to pray, and it has been performed in India since Vedic times.'
            : 'In a puja, the deity is lovingly welcomed and honoured with flowers, lamp, incense, food and prayer — the way you would welcome a most beloved guest into your home.'}</p></section>
          <section id="why-deity"><p class="idea-kicker">02 · The deity</p><h2>Why it is offered to {ritual.deity}</h2><p>{story.why}</p><div class="guide-audience"><strong>The story behind it</strong><p>{story.story}</p></div></section>
          <section id="blessings"><p class="idea-kicker">03 · Blessings</p><h2>The blessings devotees seek</h2><p>Families have turned to the {ritual.title} for generations. These are the blessings traditionally sought from it:</p><ol class="guide-steps">{ritual.benefits.map(benefit => <li>{benefit}.</li>)}</ol>{ritual.note && <div class="guide-audience"><strong>Please note</strong><p>{ritual.note}</p></div>}<p>A ritual is an act of faith, hope and gratitude. We describe blessings the way tradition describes them; Saathum never promises a particular outcome.</p></section>
          <section id="who"><p class="idea-kicker">04 · For you?</p><h2>Who it is for</h2><div class="guide-audience"><strong>Especially lovely for</strong><p>{ritual.whoFor}</p></div><p>{isHavan ? 'Anyone can join — you do not need to know any mantras or rituals. Join for yourself, or pray for someone you love: a child before exams, parents far away, a friend starting something new.' : 'A private puja is booked for one family. You can book it for yourself, or for someone you love, wherever they live.'}</p></section>
          <section id="when"><p class="idea-kicker">05 · Timing</p><h2>The best time for it</h2><p>{ritual.bestTime}</p><div class="guide-maths"><h3>At a glance</h3><dl><div><dt>Duration</dt><dd>{ritual.duration}</dd></div><div><dt>Commitment</dt><dd>{commitmentFor(ritual).split(' — ')[0]}</dd></div><div><dt>Muhurat</dt><dd>{muhuratFor(ritual).split(' — ')[0]}</dd></div><div><dt>Format</dt><dd>{isHavan ? 'Open live havan' : 'Private puja'}</dd></div></dl><small>{commitmentFor(ritual)}. {muhuratFor(ritual)}.</small></div></section>
          {isHavan && <section id="together"><p class="idea-kicker">06 · Together</p><h2>The power of many — sab ki aahuti, sab ka ashirwad</h2><p>A Saathum havan is an open, shared havan. One sacred fire, one set of mantras, and devotees joining from homes across India and around the world. In Hindu tradition, praying together has always been held especially dear: the very last hymn of the Rig Veda calls on people to <em>“sam gacchadhvam, sam vadadhvam”</em> — come together, speak together, let your minds be in harmony.</p><p>The Bhagavata Purana teaches that in this age, the chanting of the divine name is the simplest and most powerful path — and it lists <em>shravanam</em>, listening with devotion, as the very first of the nine forms of bhakti. So when you sit quietly and hear the mantras of this havan, you are not a spectator. You are taking part, alongside everyone else who has joined.</p><p>Every person who joins adds their prayer to the same fire. That is the heart of Saathum: many hopes, one havan, blessings for all.</p></section>}
          <section id="altar"><p class="idea-kicker">{isHavan ? '07' : '06'} · At the altar</p><h2>Performed by experienced temple priests</h2><p>Your {kind} is performed by temple priests with years of experience, at a properly prepared altar — with the correct mantras, the correct sequence and full devotion. Never rushed, never cut short.</p><div class="guide-audience"><strong>Traditional offerings used</strong><p>{ritual.offerings}</p></div><p>When you join, you also support these priests and their families. It lets them give their whole working lives to havan and puja, free from worldly worries — so the sacred traditions they have spent years learning are kept alive.</p></section>
          <section id="value"><p class="idea-kicker">{isHavan ? '08' : '07'} · Value</p>{isHavan
            ? <Fragment><h2>Why it costs so little</h2><p>Arranging a havan at home on your own is a big undertaking: the pandit’s dakshina, buying the havan samagri and sacred wood, finding and preparing a proper place, and taking the day off to organise it all. Because a Saathum havan is shared by many devotees, those costs are shared too.</p><div class="guide-audience"><strong>Open havans start from {HAVAN_FROM}</strong><p>Priests, samagri, altar, live stream and replay — all included. You simply join and pray.</p></div></Fragment>
            : <Fragment><h2>Everything is arranged for you</h2><p>No pandit to find, no samagri to buy, no place to prepare. Our temple priests arrange the altar, the offerings and the live stream. You simply watch, pray and receive the blessing.</p></Fragment>}</section>
          <section id="from-home"><p class="idea-kicker">{isHavan ? '09' : '08'} · From anywhere</p><h2>Taking part from home, live</h2><p>Distance is no barrier to devotion. Wherever you are — in India or abroad — you can be part of the {kind} as it happens.</p><ol class="guide-steps"><li>{isHavan ? 'Join the havan on the date you like.' : 'Book the puja for your family.'}</li><li>On the day, open the live stream on your phone, tablet or TV.</li><li>Sit facing the screen, light a lamp if you wish, and listen to the mantras with a calm, open heart. Chant along if you know them.</li><li>Fold your hands for the aarti at the end and receive the blessing.</li><li>Missed a moment? Watch the replay for 7 days.</li></ol><div class="guide-audience"><strong>Keep ready at home (optional)</strong><p>{keepReady.join(' · ')}.</p></div></section>
          <section id="prasad"><p class="idea-kicker">{isHavan ? '10' : '09'} · Prasad</p><h2>Prasad by courier</h2><p>After the {kind}, blessed prasad and sacred items — such as a sacred thread, kumkum or vibhuti, where the ritual uses them — are packed with care and sent by courier. We deliver across India, and internationally too, so families living abroad can receive the blessing at home.</p></section>
          <section id="good-to-know"><p class="idea-kicker">{isHavan ? '11' : '10'} · Good to know</p><h2>Before you join</h2><p>Many families avoid new rituals during a period of mourning (sutak) in the family, and during solar or lunar eclipse hours. Some traditions also avoid new-beginning rituals during Pitru Paksha and Kharmas. If you are unsure, ask us — we will help you choose a good date.</p><p>Changed plans? You get a full refund if you cancel at least 24 hours before the scheduled start — see our <a href="/refunds">refund policy</a>.</p></section>
          <div class="guide-ticket"><p class="guide-note">{isHavan ? 'Sab ki aahuti, sab ka ashirwad.' : 'Faith, brought home to you.'}</p><h2>{isHavan ? 'Join the ' + ritual.title : 'Book the ' + ritual.title}</h2><p>{isHavan ? `Open havans from ${HAVAN_FROM}. Watch live, pray together, and receive prasad by courier.` : 'Choose a date and watch it performed live — with prasad sent by courier.'}</p><a class="idea-button" href={bookHref} data-ritual-book={ritual.slug}>{isHavan ? 'Join this havan ↗' : 'Book this puja ↗'}</a><a class="guide-back" href="/rituals">Explore more havans &amp; pujas</a></div>
        </div>
      </div>
    </div>
    <TruckBorder kind="lotus" />
    {related.length > 0 && <section class="guide-shell guide-related" aria-labelledby="related-title"><p class="idea-kicker">You may also love</p><h2 id="related-title">More rituals for {ritualCategories[ritual.category].toLowerCase()}</h2><div class="idea-grid">{related.map(item => <article class="idea-card"><a class="idea-card-link" href={item.href}><div class="idea-picture"><img src={publicImage(item.image, { width: 900, fit: 'scale-down' })} width="1536" height="1024" alt="" loading="lazy" decoding="async" /></div><div class="idea-card-copy"><span class:list={['idea-format', item.type === 'havan' ? 'live' : 'private']}>{ritualTypes[item.type]}</span><h3>{item.title}</h3><p>{item.description}</p><span class="idea-read-guide">Read more ↗</span></div></a></article>)}</div></section>}
  </main>
  <script>
    import { capture } from '../../lib/analytics';
    const article = document.querySelector<HTMLElement>('[data-ritual-article]');
    if (article) {
      capture('ritual_article_view', { ritual: article.dataset.ritualArticle });
      article.querySelector('[data-ritual-book]')?.addEventListener('click', () => capture('ritual_article_book', { ritual: article.dataset.ritualArticle }));
    }
  </script>
</Base>
