---
// [SAATHUM-GUIDE-1 2026-09-25] One knowledge article per ritual. Reuses the old
// creator-guide layout (creator-guide.css) so the design stays identical.
// NOTE FOR AI: content comes from lib/ritualGuides.ts. The image path is fixed
// by slug (/assets/rituals/<slug>.png) — drop the file in and it shows.
// Copy rules: benefic only, "traditionally sought" benefits, no guaranteed
// outcomes, no medical claims.
import { publicImage, publicImageSrcSet } from '../../lib/config';
export const prerender = true;
import Base from '../../layouts/Base.astro';
import TruckBorder from '../../components/TruckBorder.astro';
import { rituals, ritualCategories, ritualTypes, relatedRituals, commitmentFor, muhuratFor, ritualArticleTitle, ritualArticleSummary, type Ritual } from '../../lib/ritualGuides';
import { storyFor } from '../../lib/ritualStories';
import { ritualAd } from '../../lib/ritualAdHooks';
import { fetchPricing, ritualPrice, rupees } from '../../lib/pricing';
import type { PublicContent } from '../../lib/seo/types';
import '../../styles/creator-ideas.css';
import '../../styles/creator-guide.css';
import PreetiMount from '../../components/PreetiMount.astro';
import { BRAND } from '../../lib/brand';
export function getStaticPaths() {
  return rituals.map(ritual => ({ params: { slug: ritual.slug }, props: { ritual } }));
}
const { ritual } = Astro.props as { ritual: Ritual };
// [PRICING-1] Build-time price; /pricing.js refreshes [data-site-price] live.
const pricing = await fetchPricing();
const livePrice = ritualPrice(pricing, ritual);
const kind = ritualTypes[ritual.type].toLowerCase();
const related = relatedRituals(ritual, 3);
const bookHref = '/marketplace?q=' + encodeURIComponent(ritual.title.replace(/\s*\(.*\)\s*/, ' ').trim());
const articleTitle = ritualArticleTitle(ritual);
const articleDescription = ritualArticleSummary(ritual);
const content: PublicContent = {
  kind: 'article',
  key: ritual.slug,
  canonicalPath: ritual.href,
  title: articleTitle,
  summary: articleDescription,
  visibility: 'public',
  publishedAt: '2026-09-25',
  modifiedAt: '2026-09-25',
  image: { url: ritual.image, alt: ritual.imageAlt, revision: ritual.slug },
  breadcrumbs: [
    { name: 'Puja & Havan Guide', path: '/rituals/' },
    { name: ritual.title, path: ritual.href },
  ],
  article: { authorName: BRAND.name, section: ritualCategories[ritual.category], keywords: ritual.tags },
  // [OG-AD-HOOK-1] Must match lib/seo/resolve.ts (same helper) or the og:image
  // URL's revision hash would differ from what the OG endpoint computes.
  ad: ritualAd(ritual, pricing),
  // [WEB-OG-SHARE-1 2026-09-29] A shared guide invites the reader in; the search
  // title/description above stay as they are.
  shareTitle: `${ritual.title}: why devotees offer it, and how to join`,
  shareDescription: `The ${ritual.title} guide: what it means, why it is offered to ${ritual.deity}, the legend behind it, the blessings sought, and how to join in from anywhere.`,
};
const keepReady = ['A small diya or lamp', 'A stick of incense', 'One fresh flower', 'A glass of water', 'A little sweet to offer'];
// [SAATHUM-GUIDE-2 2026-09-25] Owner's havan-first model: a HAVAN is an open, shared
// live event anyone can join (many devotees, one fire, nothing personal); a PUJA
// is the limited private option for one family. Copy branches on this.
const isHavan = ritual.type === 'havan';
const story = storyFor(ritual.slug);
---
<Base content={content}>
  <main class="idea-page creator-guide" id="main-content" data-ritual-article={ritual.slug}>
    <div class="guide-shell">
      <nav class="guide-breadcrumb" aria-label="Breadcrumb"><a href="/rituals/">Puja &amp; Havan Guide</a><span aria-hidden="true">/</span><a href={'/rituals/?for=' + ritual.category + '#idea-catalogue'}>{ritualCategories[ritual.category]}</a></nav>
      <header class="guide-heading">
        <p class="idea-kicker">{ritual.deity}</p>
        <div class="idea-chips"><span class:list={['idea-format', ritual.type === 'havan' ? 'live' : 'private']}>{ritualTypes[ritual.type]}</span><span>{ritualCategories[ritual.category]}</span><span>{ritual.duration}</span></div>
        <h1>{ritual.title}</h1>
        <p class="guide-lead">{ritual.description}</p>
        <p class="guide-byline">{isHavan ? 'Open to every devotee · Led by seasoned temple priests · Prasad sent by courier' : 'A private puja for one family · Led by seasoned temple priests · Prasad sent by courier'}</p>
      </header>
      <figure class="guide-hero"><img src={publicImage(ritual.image, { width: 900, fit: 'scale-down' })} srcset={publicImageSrcSet(ritual.image, [420, 640, 900, 1600], { fit: 'scale-down' })} sizes="(max-width:699px) 90vw, (max-width:1440px) 92vw, 1320px" alt={ritual.imageAlt} width="1536" height="1024" fetchpriority="high" /><figcaption>{ritual.deity} · Blessings, carried from the mountains to you.</figcaption></figure>
      <div class="guide-layout">
        <aside class="guide-sidebar" aria-label="Article navigation">
          <p class="idea-kicker">In this guide</p>
          <nav><a href="#about">What this {kind} is</a><a href="#why-deity">Why {ritual.deity}</a><a href="#blessings">Blessings sought</a><a href="#who">Who it suits</a><a href="#when">When to hold it</a>{isHavan && <a href="#together">Praying together</a>}<a href="#altar">The temple priests</a><a href="#value">{isHavan ? 'Why it is affordable' : 'Nothing to arrange'}</a><a href="#from-home">Joining from home</a><a href="#prasad">Prasad to your door</a><a href="#good-to-know">Before you book</a></nav>
          <p class="guide-note">Gentle rites.<br />Warm blessings.</p>
        </aside>
        <div class="guide-body">
          <section id="about"><p class="idea-kicker">01 · The ritual</p><h2>What the {ritual.title} is</h2><p>{ritual.description}</p><p>{isHavan
            ? 'During a havan, the priest pours ghee, grain and sacred herbs into a consecrated fire as each mantra is chanted. Tradition holds that Agni, the fire, bears every offering and every prayer to the divine. Havans reach back to Vedic times, and they remain among the oldest and most joyful forms of worship in India.'
            : 'During a puja, the deity is received and honoured with flowers, a lamp, incense, food and prayer — much as a family would greet a dearly loved guest at the door.'}</p></section>
          <section id="why-deity"><p class="idea-kicker">02 · The deity</p><h2>Why devotees offer it to {ritual.deity}</h2><p>{story.why}</p><div class="guide-audience"><strong>The story behind it</strong><p>{story.story}</p></div></section>
          <section id="blessings"><p class="idea-kicker">03 · Blessings</p><h2>Blessings devotees have long sought</h2><p>Generations of families have offered the {ritual.title}. Tradition links it with these blessings:</p><ol class="guide-steps">{ritual.benefits.map(benefit => <li>{benefit}.</li>)}</ol>{ritual.note && <div class="guide-audience"><strong>Please note</strong><p>{ritual.note}</p></div>}<p>Every ritual is an offering of faith, hope and thanks. We describe its blessings in tradition's own words, and {BRAND.name} never promises any particular result.</p></section>
          <section id="who"><p class="idea-kicker">04 · For you?</p><h2>Who it suits</h2><div class="guide-audience"><strong>Especially meaningful for</strong><p>{ritual.whoFor}</p></div><p>{isHavan ? 'Everyone is welcome, and there are no mantras or rituals to learn first. Join for yourself, or hold someone dear in prayer: a child facing exams, parents in another city, a friend making a fresh start.' : 'Each private puja is booked by one family. Book it for yourself or for someone you love, wherever in the world they live.'}</p></section>
          <section id="when"><p class="idea-kicker">05 · Timing</p><h2>When to hold it</h2><p>{ritual.bestTime}</p><div class="guide-maths"><h3>Quick facts</h3><dl><div><dt>Duration</dt><dd>{ritual.duration}</dd></div><div><dt>Commitment</dt><dd>{commitmentFor(ritual).split(' — ')[0]}</dd></div><div><dt>Muhurat</dt><dd>{muhuratFor(ritual).split(' — ')[0]}</dd></div><div><dt>Format</dt><dd>{isHavan ? 'Open havan, live' : 'Private puja'}</dd></div></dl><small>{commitmentFor(ritual)}. {muhuratFor(ritual)}.</small></div></section>
          {isHavan && <section id="together"><p class="idea-kicker">06 · Together</p><h2>Praying as one — ek agni, sabki prarthana</h2><p>Every {BRAND.name} havan is open and shared: a single sacred fire, a single chain of mantras, and devotees taking part from homes in India and across the globe. Hindu tradition has always held collective prayer especially dear. The closing hymn of the Rig Veda urges <em>“sam gacchadhvam, sam vadadhvam”</em> — move together, speak together, let your minds be in harmony.</p><p>According to the Bhagavata Purana, chanting the divine name is the simplest and most powerful path in this age, and the first of the nine forms of bhakti it names is <em>shravanam</em>, listening with devotion. So as you sit quietly with the mantras of this havan, you are no onlooker. You are part of it, together with everyone else who has joined.</p><p>Each person who joins adds a prayer to the one fire. That is what {BRAND.name} is about: countless hopes, one havan, blessings shared by all.</p></section>}
          <section id="altar"><p class="idea-kicker">{isHavan ? '07' : '06'} · At the altar</p><h2>At the altar of a Himalayan temple</h2><p>The {kind} takes place at a quiet Himalayan temple, led by the temple's own pujari, a priest of long experience, at a properly prepared altar — the right mantras, in the right order, with complete devotion. Our crew makes the journey to film it for you. It is never hurried and never shortened.</p><div class="guide-audience"><strong>Offerings traditionally used</strong><p>{ritual.offerings}</p></div><p>Your booking also helps these mountain pujaris, their families and their villages through harsh Himalayan winters, and keeps alive the sacred traditions they have spent years mastering.</p></section>
          <section id="value"><p class="idea-kicker">{isHavan ? '08' : '07'} · Value</p>{isHavan
            ? <Fragment><h2>Why it is affordable</h2><p>Holding a havan at home by yourself takes real effort: dakshina for the pandit, havan samagri and sacred wood to buy, a suitable space to find and prepare, and a day off to organise it all. Since each {BRAND.name} havan is shared among many devotees, so are those costs.</p><div class="guide-audience"><strong>Open havans start from <span data-site-price={ritual.slug} data-site-type={ritual.type}>{livePrice ? rupees(livePrice) : ''}</span></strong><p>The priests, samagri, altar and havan video are all covered. You just join and pray.</p></div></Fragment>
            : <Fragment><h2>Nothing for you to arrange</h2><p>No pandit to search for, no samagri to buy, no space to prepare. The temple priests set up the altar and offerings, and we send you the video. All you do is pray and receive the blessing.</p></Fragment>}</section>
          <section id="from-home"><p class="idea-kicker">{isHavan ? '09' : '08'} · From anywhere</p><h2>Joining from home</h2><p>Devotion does not depend on distance. From anywhere in India or overseas, you can be part of the {kind}.</p><ol class="guide-steps"><li>{isHavan ? 'Pick a date and join the havan.' : 'Book the puja for your family.'}</li><li>At the scheduled hour, light a lamp at home if you like and pray quietly together.</li><li>Once it is over, we email you the {kind} video.</li><li>Sit facing the screen, take in the mantras with a calm, open heart, and chant along if you know them.</li><li>Fold your hands for the closing aarti and receive the blessing.</li></ol><div class="guide-audience"><strong>Useful to have at home (optional)</strong><p>{keepReady.join(' · ')}.</p></div></section>
          <section id="prasad"><p class="idea-kicker">{isHavan ? '10' : '09'} · Prasad</p><h2>Prasad to your door</h2><p>Once the {kind} is complete, blessed prasad and sacred items — a sacred thread, kumkum or vibhuti, where the ritual uses them — are carefully packed and sent by courier. We ship across India and internationally as well, so families abroad can receive the blessing at home.</p></section>
          <section id="good-to-know"><p class="idea-kicker">{isHavan ? '11' : '10'} · Good to know</p><h2>Before you book</h2><p>Many families hold off on new rituals while the family is in mourning (sutak) and during solar or lunar eclipse hours. Some traditions also avoid rituals of new beginnings in Pitru Paksha and Kharmas. Not sure? Ask us, and we will help you pick a good date.</p><p>Plans changed? Cancel at least 24 hours before the scheduled start and you receive a full refund — see our <a href="/refunds">refund policy</a>.</p></section>
          <div class="guide-ticket"><p class="guide-note">{isHavan ? 'Ek agni, sabki prarthana.' : BRAND.slogan}</p><h2>{isHavan ? 'Join the ' + ritual.title : 'Book the ' + ritual.title}</h2><p>{isHavan ? <Fragment>Open havans from <span data-site-price={ritual.slug} data-site-type={ritual.type}>{livePrice ? rupees(livePrice) : ''}</span>. Pray as one, receive the video, and have prasad couriered to you.</Fragment> : 'Pick a date and we send the video, with prasad by courier.'}</p><a class="idea-button" href={bookHref} data-ritual-book={ritual.slug}>{isHavan ? 'Join this havan ↗' : 'Book this puja ↗'}</a><a class="guide-back" href="/rituals/">Explore more havans &amp; pujas</a></div>
        </div>
      </div>
    </div>
    <TruckBorder kind="lotus" />
    {related.length > 0 && <section class="guide-shell guide-related" aria-labelledby="related-title"><p class="idea-kicker">You might also like</p><h2 id="related-title">Other rituals for {ritualCategories[ritual.category].toLowerCase()}</h2><div class="idea-grid">{related.map(item => <article class="idea-card"><a class="idea-card-link" href={item.href}><div class="idea-picture"><img src={publicImage(item.image, { width: 900, fit: 'scale-down' })} width="1536" height="1024" alt="" loading="lazy" decoding="async" /></div><div class="idea-card-copy"><span class:list={['idea-format', item.type === 'havan' ? 'live' : 'private']}>{ritualTypes[item.type]}</span><h3>{item.title}</h3><p>{item.description}</p><span class="idea-read-guide">Read more ↗</span></div></a></article>)}</div></section>}
  </main>
  <script>
    import { capture } from '../../lib/analytics';
    import '../../lib/pricingClient';
    const article = document.querySelector<HTMLElement>('[data-ritual-article]');
    if (article) {
      capture('ritual_article_view', { ritual: article.dataset.ritualArticle });
      article.querySelector('[data-ritual-book]')?.addEventListener('click', () => capture('ritual_article_book', { ritual: article.dataset.ritualArticle }));
    }
  </script>
  <PreetiMount kind="article" pageRef={ritual.slug} />
</Base>
