---
// [SAATHUM-GUIDE-1 2026-09-25] The Puja & Havan Guide — knowledge page for
// every ritual Saa Thum performs. Rebrand of the old creator /ideas page: same
// layout and styles (creator-ideas.css), new content. /ideas now 301s here.
// NOTE FOR AI: this page EXPLAINS rituals; it never sells a slot. Booking
// (prices, dates) lives on /marketplace ("Our Pujas"). Data: lib/ritualGuides.ts.
import { publicImage, publicImageSrcSet } from '../../lib/config';
export const prerender = true;
import Base from '../../layouts/Base.astro';
import TruckBorder from '../../components/TruckBorder.astro';
import { rituals, ritualCategories, ritualTypes, ritualBySlug } from '../../lib/ritualGuides';
import type { PublicContent } from '../../lib/seo/types';
import '../../styles/creator-ideas.css';
import { fetchPricing, rupees } from '../../lib/pricing';
import PreetiMount from '../../components/PreetiMount.astro';
import { BRAND, brandUrl } from '../../lib/brand';
// [PRICING-1] Build-time price; lib/pricingClient.ts refreshes it live.
const pricingNow = await fetchPricing();
const havanFrom = pricingNow.havan_from ? rupees(pricingNow.havan_from) : '';
const havanArt = ritualBySlug('ganapati-havan')!;
const gangaArt = ritualBySlug('ganga-puja')!;
const havanCount = rituals.filter(r => r.type === 'havan').length;
const pujaCount = rituals.filter(r => r.type === 'puja').length;
const pageTitle = 'Havan & Puja Guide: Meanings, Blessings, Dates';
const pageDescription = `${havanCount} havans and ${pujaCount} pujas explained: the deity behind each, blessings devotees traditionally seek, the best time, and how to join from India or abroad.`;
const content: PublicContent = {
  kind: 'page',
  key: 'rituals',
  canonicalPath: '/rituals',
  title: pageTitle,
  summary: pageDescription,
  visibility: 'public',
  image: { url: havanArt.image, alt: havanArt.imageAlt, revision: 'ritual-guide-v1' },
};
const collection = { '@context':'https://schema.org', '@type':'CollectionPage', '@id':brandUrl('/rituals/#collection'), url:brandUrl('/rituals/'), name:pageTitle, description:pageDescription, inLanguage:'en-IN', image:BRAND.webOrigin+havanArt.image, isPartOf:{'@id':brandUrl('/#website')}, mainEntity:{'@type':'ItemList', numberOfItems:rituals.length, itemListElement:rituals.map((ritual,index)=>({'@type':'ListItem',position:index+1,url:BRAND.webOrigin+ritual.href,name:ritual.title}))} };
---
<Base content={content}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(collection)} />
  <main class="idea-page ritual-guide-page" id="main-content">
    <section class="idea-hero idea-shell" aria-labelledby="idea-title">
      <div class="idea-hero-copy">
        <p class="idea-kicker">The Puja &amp; Havan Guide</p>
        <h1 id="idea-title"><span class="idea-title-line">Know the ritual.</span><span class="idea-title-line idea-title-line--accent">Offer it with heart.</span></h1>
        <p>The meaning of every havan and puja, the deity it honours and the legend behind it,<br /> plus how to join in — whichever country you call home.</p>
        <a class="idea-button" href="#idea-catalogue">Browse the rituals <span aria-hidden="true">↓</span></a>
        <p class="idea-handwritten">Ek agni,<br />anek prarthanayein.</p>
      </div>
      <div class="idea-hero-art" aria-hidden="true">
        <div class="idea-postcard"><div class="idea-picture"><img src={publicImage(havanArt.image, { width: 900, fit: 'scale-down' })} width="1536" height="1024" alt="" fetchpriority="high" /></div><span>Agni, the sacred flame.</span></div>
        <div class="idea-postcard"><div class="idea-picture"><img src={publicImage(gangaArt.image, { width: 900, fit: 'scale-down' })} width="1536" height="1024" alt="" /></div><span>Diyas on the Ganga, lit for you.</span></div>
        <div class="idea-stamp">Peace. Joy.<br />Abundance.</div>
      </div>
    </section>
    <section class="idea-shell idea-intro" aria-label="About this guide"><div style="grid-column:1/-1"><h2>A ritual for every prayer</h2><p>Across the generations, Hindu families have lit the sacred fire to mark a beginning, to say thank you, to hold a loved one in prayer, or just to bring calm into the house. Here you will find every ritual {BRAND.name} arranges, each with its deity and the reason it is honoured, the legend attached to it, the blessings devotees have long sought, who it is meant for, and the most auspicious time to hold it. A seasoned pujari at a quiet Himalayan temple performs each one while our crew records it for you. Our temples are positive ones, and every ritual is gentle and benefic. Blessings are described as tradition describes them; no outcome is ever promised.</p></div></section>
    <TruckBorder kind="lotus" />
    <section class="idea-shell idea-intro" aria-label="Havan, puja and joining together">
      <div><span class="idea-format live">Havan</span><p>Worship through fire, and anyone may join. With each mantra, ghee, grain and herbs are offered into a single sacred flame for devotees in every country. Open havans start from <span data-site-price="havan" data-site-type="havan">{havanFrom}</span>.</p></div>
      <div><span class="idea-format private">Puja</span><p>Flowers, a lamp, incense and food offered to the deity — booked privately by one family, with only a few slots available.</p></div>
      <div><span class="idea-format group">Together</span><p>Our tradition treasures prayer offered together. Each person who joins adds a prayer to the one fire — and helps sustain the temple priests who tend it.</p></div>
    </section>
    <section class="idea-shell idea-daily" aria-labelledby="daily-title">
      <span class="idea-daily-label">From anywhere</span>
      <div><h2 id="daily-title">Pray at home. Watch the video. Receive prasad.</h2><p>Join in from a flat in Delhi, a home in Dubai or a house in Dallas. Light a diya, pray alongside, and watch the video we send. Prasad and sacred items reach your door by courier — within India and internationally.</p></div>
      <a href="/how-it-works">How it works <span aria-hidden="true">↗</span></a>
    </section>
    <section class="idea-shell idea-catalogue" id="idea-catalogue" aria-labelledby="catalogue-title">
      <div class="idea-section-heading"><div><p class="idea-kicker">Learn. Choose. Pray.</p><h2 id="catalogue-title">Which ritual suits your prayer?</h2></div><p>{havanCount} havans · {pujaCount} pujas<br />Every one explained in depth.</p></div>
      <div class="idea-controls" data-idea-controls hidden>
        <div class="idea-format-filters" role="group" aria-label="Filter by ritual type">
          <button type="button" data-format="all" aria-pressed="true">All rituals</button>
          {Object.entries(ritualTypes).map(([key,label]) => <button type="button" data-format={key} aria-pressed="false">{label}s</button>)}
        </div>
        <div class="idea-search-row">
          <label class="idea-search">Search<input id="idea-search" type="search" placeholder="Try exams, Lakshmi, new home, Shiva…" autocomplete="off" /></label>
          <label>Your intention<select id="idea-topic"><option value="all">All intentions</option>{Object.entries(ritualCategories).map(([key,label]) => <option value={key}>{label}</option>)}</select></label>
        </div>
        <p class="idea-result-count" id="idea-results" aria-live="polite"></p>
      </div>
      <div class="idea-grid">
        {rituals.map((ritual) => <article class="idea-card" id={ritual.slug} data-idea-card data-format={ritual.type} data-topic={ritual.category} data-tags={[ritual.deity, ...ritual.tags].join(' ')}>
          <a class="idea-card-link" href={ritual.href} aria-labelledby={`${ritual.slug}-title`} data-ritual-guide={ritual.slug}><div class="idea-picture" aria-hidden="true"><img src={publicImage(ritual.image, { width: 900, fit: 'scale-down' })} srcset={publicImageSrcSet(ritual.image, [420, 640, 900, 1600], { fit: 'scale-down' })} sizes="(max-width:699px) 90vw, (max-width:1100px) 44vw, 29vw" alt="" width="1536" height="1024" loading="lazy" decoding="async" /></div>
          <div class="idea-card-copy"><div class="idea-chips"><span class:list={['idea-format', ritual.type === 'havan' ? 'live' : 'private']}>{ritualTypes[ritual.type]}</span><span>{ritualCategories[ritual.category]}</span></div><h3 id={`${ritual.slug}-title`}>{ritual.title}</h3><p>{ritual.description}</p><span class="idea-read-guide">Read more <span aria-hidden="true">↗</span></span></div></a>
        </article>)}
      </div>
      <div class="idea-empty" hidden><h3>Nothing matches that yet.</h3><p>Try a different word, or pick another intention.</p><button type="button" id="idea-reset">Show all rituals</button></div>
      <div class="idea-more-row"><button class="idea-button idea-more" type="button" hidden>Show more rituals</button></div>
      <noscript><p class="idea-result-count">All {rituals.length} rituals are shown. Browser JavaScript enables search and filters.</p></noscript>
    </section>
    <section class="idea-shell idea-closing"><p class="idea-handwritten">One flame carries every prayer.</p><h2>Ready to take part?</h2><p>Open havans start from <span data-site-price="havan" data-site-type="havan">{havanFrom}</span>, or book a private puja just for your family. The temple priests handle everything else.</p><div><a class="idea-button" href="/marketplace" data-ritual-cta="book">Join a havan</a><a class="idea-market-link" href="/how-it-works" data-ritual-cta="how-it-works">How it works ↗</a></div></section>
  </main>
  <script>
    import '../../lib/ritualGuidePage';
    import '../../lib/pricingClient';
  </script>
  <PreetiMount kind="article" />
</Base>
