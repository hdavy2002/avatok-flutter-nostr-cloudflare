---
export const prerender = false;
import Base from '../layouts/Base.astro';
import HostBookings from '../islands/host-bookings/HostBookings';
import CustomerBooking from '../islands/host-bookings/CustomerBooking';
import '../styles/hf-bookings.css';
import { BRAND } from '../lib/brand';
Astro.response.headers.set('Cache-Control', 'private, no-store');
const role = Astro.url.searchParams.get('role') === 'host' ? 'host' : 'customer';
// [HF-CHANNEL-QA-1] A fan coming from an influencer page (?host=<slug>[&date&duration&slot]) gets the booking form, not the calendar redirect.
const bookHost = role === 'customer' && /^[a-z0-9-]{3,40}$/.test(Astro.url.searchParams.get('host') ?? '');
---
<Base title={`Appointment calendar · ${BRAND.name}`} description="View your appointments." noindex keywords="">
  {bookHost ? <CustomerBooking client:only="react" /> : <HostBookings client:only="react" role={role} />}
</Base>
