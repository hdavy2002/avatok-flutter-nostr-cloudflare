---
// [LIST-PAGE-2] Public listing details at the pretty URL: /<username>/<slug>.
//
// Owner decision 2026-08-26 said this route would serve the bazaar mockup
// "for now" (look-and-feel only, hardcoded mock data). That "for now" is over:
// SPEC-2026-09-01-LISTING-CONTENT-AND-BOOKING.md §G retires the mock and wires
// this route to real data through the SAME `ListingDetailView` component /l/<id>
// renders — one component, three URLs (this one, /l/<id>, /e/<id>).
export const prerender = false;

import Base from '../../layouts/Base.astro';
import ListingDetailsComp from '../../components/ListingDetailsComp.astro';
import { getListingBySlug, getListingReviews, getListingSlots, getExplore, getCreator, ApiError } from '../../lib/apiClient';
import { listingOg } from '../../lib/og';
import type { Listing, ReviewList, ListingSlot, Card, Creator } from '../../lib/types';

const { username, slug } = Astro.params;

// Astro matches static routes before dynamic ones, so /about, /blog, /sign-in
// and friends still win over this catch-all. This guard is for the rest: a bare
// handle must not swallow asset-ish or malformed paths and answer 200.
const looksLikeHandle = /^[a-z0-9][a-z0-9._-]{1,30}$/i.test(username ?? '');
const looksLikeSlug = /^[a-z0-9][a-z0-9._-]{1,80}$/i.test(slug ?? '');
if (!looksLikeHandle || !looksLikeSlug) return new Response('Not found', { status: 404 });

let listing: Listing | null = null;
let notFound = false;
try {
  listing = await getListingBySlug(username!, slug!);
} catch (e) {
  if (e instanceof ApiError && (e.status === 404 || e.status === 410)) notFound = true;
  else throw e;
}
if (notFound || !listing) return new Response('Listing not found', { status: 404 });

Astro.response.headers.set('Cache-Control', 'public, max-age=60, stale-while-revalidate=300');
const og = listingOg(listing);

let reviewList: ReviewList | null = null;
try { reviewList = await getListingReviews(listing.id, {}); } catch { reviewList = null; }

let slots: ListingSlot[] | null = null;
try { slots = await getListingSlots(listing.id); } catch { slots = null; }

let browseMore: Card[] = [];
try {
  const page = await getExplore({ section: listing.section ?? undefined, category: listing.category ?? undefined, limit: 9 });
  browseMore = page.listings ?? [];
} catch { browseMore = []; }

let creatorProfile: Creator | null = null;
if (listing.creator?.uid) {
  try { creatorProfile = await getCreator(listing.creator.uid); } catch { creatorProfile = null; }
}
const creatorListings: Card[] = creatorProfile?.listings ?? [];
const isOwner = Boolean(listing.viewer?.is_owner);
---

<Base title={og.title} description={og.description} image={og.image}>
  <Fragment slot="head">
    {og.extra.map((m) => (m.property ? <meta property={m.property} content={m.content} /> : <meta name={m.name} content={m.content} />))}
  </Fragment>

  {isOwner && (
    <div style="max-width:100rem; margin:0 auto; padding:10px clamp(14px,4vw,40px) 0; display:flex; align-items:center; gap:12px; font-family:'Nunito',sans-serif; font-weight:800; font-size:12px; letter-spacing:.08em;">
      <span>YOU OWN THIS LISTING</span>
      <a href={`/dashboard/listings/new?id=${encodeURIComponent(listing.id)}`} style="text-decoration:underline;">EDIT LISTING →</a>
    </div>
  )}

  <ListingDetailsComp listing={listing} reviews={reviewList} slots={slots} browse={browseMore} creatorListings={creatorListings} creatorProfile={creatorProfile} />
</Base>
