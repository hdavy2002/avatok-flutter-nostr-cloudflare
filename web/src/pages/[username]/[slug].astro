---
// [WEB-OLD-CHECKOUT-GONE-1 2026-09-27] OWNER DECISION: the old listing detail page
// (ListingDetailsComp — "Meet the host", "How the show works", truck borders) is
// retired. /<handle>/<slug> now looks the listing up and 301s to the new event
// page /book/<id>, so every shared or indexed link keeps working.
export const prerender = false;

import { ApiError, getListingBySlug } from '../../lib/apiClient';
import { listingPath } from '../../lib/urls';

const { username, slug } = Astro.params;
const looksLikeHandle = /^[a-z0-9][a-z0-9._-]{1,30}$/i.test(username ?? '');
const looksLikeSlug = /^[a-z0-9][a-z0-9._-]{1,80}$/i.test(slug ?? '');
if (!looksLikeHandle || !looksLikeSlug) return new Response('Not found', { status: 404 });

let id: string | null = null;
try {
  const listing = await getListingBySlug(username!, slug!);
  id = listing?.id ?? null;
} catch (e) {
  if (!(e instanceof ApiError && (e.status === 404 || e.status === 410))) throw e;
}
if (!id) return new Response('Listing not found', { status: 404 });
return Astro.redirect(listingPath({ id }), 301);
---
