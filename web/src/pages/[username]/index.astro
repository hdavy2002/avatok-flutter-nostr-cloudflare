---
// [DEMO-PROFILE-1 2026-08-26] Creator profile: /<username>
//
// Owner decision: every creator name, avatar and profile affordance on the
// front page and the listing detail should land here. FOR NOW the page is the
// bazaar comp from design/live-streaming/ ("Saathum Creator Profile.dc.html") —
// look and feel only, hardcoded mock data, backend wiring comes later.
//
// WHY A DIRECTORY ROUTE
//   Astro reads pages/[username]/index.astro as the ONE-segment /<username> and
//   pages/[username]/[slug].astro as the two-segment /<username>/<listing>, so
//   the profile and the listing can share a namespace without either shadowing
//   the other. Static routes still win over both — /about, /blog, /sign-in and
//   friends are matched before any dynamic segment — which is the only reason a
//   bare-handle route at the site root is safe.
//
//   The real data-driven creator page is untouched at /c/<handle>
//   (pages/c/[handle].astro); nothing here replaces it, and links already shared
//   to it keep working.
export const prerender = false;

import { renderMockupPage } from '../../lib/mockupPage';
import { creatorPath } from '../../lib/urls';
import { getCreator, ApiError } from '../../lib/apiClient';
// Staged into web/src/generated/ by prebuild — see scripts/copy-design-demo.mjs
// for why it is generated rather than committed, and why it is not in public/.
import mockupHtml from '../../generated/creator-profile.dc.html?raw';

const { username } = Astro.params;

// Astro matches static routes first, so this guard is only for the rest: a bare
// handle must not swallow asset-ish or malformed paths and answer 200.
if (!/^[a-z0-9][a-z0-9._-]{1,30}$/i.test(username ?? '')) {
  return new Response('Not found', { status: 404 });
}

// [TAKEDOWN-USERNAME-404-1 2026-09-20] The shape guard above only rejects malformed
// paths — it let ANY syntactically valid handle render the hardcoded demo profile at
// 200, including handles nobody has claimed. Same handle-or-uid lookup /c/[handle].astro
// already uses (routes/listings.ts getCreator), so a made-up handle now 404s for real.
try {
  await getCreator(username!);
} catch (e) {
  if (e instanceof ApiError && (e.status === 404 || e.status === 410)) {
    return new Response('Not found', { status: 404 });
  }
  throw e;
}

// Cards on a profile belong to THIS creator, so both link kinds are scoped to
// the handle in the URL rather than the shared demo creator.
const handle = encodeURIComponent(username!);
return renderMockupPage({
  siteUrl: Astro.url,
  html: mockupHtml,
  title: `@${username} · Saathum`,
  listingHref: `/${handle}/mock-listing`,
  profileHref: creatorPath(username!),
});
---
