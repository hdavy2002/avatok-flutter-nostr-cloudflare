---
// REMOVED [DASH2-ARCHIVE-1 2026-09-25] v1 page archived at src/pages/archive/dashboard-v1/affiliate.astro.
// dashboard2Enabled ON  -> redirect to the nearest Dashboard 2 screen.
// dashboard2Enabled OFF -> render the archived v1 page exactly as before.
// 302 (not 301) while the flag decides: a cached 301 would outlive a flag flip.
export const prerender = false;
import { isDashboard2Enabled } from '../../lib/serverFlags';
import V1 from '../archive/dashboard-v1/affiliate.astro';
if (await isDashboard2Enabled(Astro)) return Astro.redirect(`/dashboard${Astro.url.search}`, 302);
Astro.response.headers.set('Cache-Control', 'private, no-store');
---
<V1 />
