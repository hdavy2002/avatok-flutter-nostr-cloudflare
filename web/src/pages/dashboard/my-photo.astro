---
// [HF-MOD-WEB-PHOTOS] Dashboard screen "my-photo": one shell for every account screen (lib/dashboardRoutes.ts).
export const prerender = false;
import Base from '../../layouts/Base.astro';
import DashboardLoading from '../../components/DashboardLoading.astro'; // [HF-DASH-LOADING-1]
import DashboardApp from '../../islands/dashboard-hf/DashboardApp';
import { BRAND } from '../../lib/brand';
Astro.response.headers.set('Cache-Control', 'private, no-store');
---
<Base title={`My photo & cover | ${BRAND.name}`} description="Choose your profile photo and cover. New pictures are checked for safety before anyone sees them." noindex keywords="">
  <DashboardApp client:only="react" section="my-photo" ><div slot="fallback"><DashboardLoading /></div></DashboardApp>
</Base>
