---
// Customer Appointments — creator's booked 1:1 appointment schedule.
export const prerender = false;
import Dashboard from '../../layouts/Dashboard.astro';
import CommercialSchedule from '../../islands/dashboard/CommercialSchedule.tsx';
---
<Dashboard title="Customer Appointments · avatok.ai" heading="Customer Appointments" subtitle="Your customer appointments. Start each one from the avaTOK app." active="consult">
  <CommercialSchedule client:load role="creator" kind="consult_1to1"
    description="Each customer and time slot stays separate, so Start and Join always open the selected appointment."
    emptyTitle="No customer appointments yet"
    emptyBody="Publish a 1:1 consult listing and make availability available for customers to book." />
</Dashboard>
