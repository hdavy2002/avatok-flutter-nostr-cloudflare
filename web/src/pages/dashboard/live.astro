---
// My Live Events — creator's account-owned live event schedule.
export const prerender = false;
import Dashboard from '../../layouts/Dashboard.astro';
import CommercialSchedule from '../../islands/dashboard/CommercialSchedule.tsx';
---
<Dashboard title="My Live Events · avatok.ai" heading="My Live Events" subtitle="Host your paid broadcasts from the browser." active="live">
  <CommercialSchedule client:load role="creator" kind="live_event"
    description="Events are listed as soon as you publish them, even before the first ticket or host session exists."
    emptyTitle="No live events yet"
    emptyBody="Create a live event to give your audience a ticketed show to join." />
</Dashboard>
