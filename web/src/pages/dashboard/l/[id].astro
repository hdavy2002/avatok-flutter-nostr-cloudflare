---
// [SPEC-2026-09-01-LISTING-CONTENT-AND-BOOKING A1.3] /dashboard/l/:id is
// REMOVED — every listing details page is public and chrome-free, never
// inside the dashboard. This route now only 301s to the real page. The
// creator's edit affordance lives as a small bar on the public page when the
// viewer owns the listing, so nothing is lost by dropping the dashboard twin.
export const prerender = false;
const { id } = Astro.params;
return Astro.redirect(`/l/${encodeURIComponent(id!)}${Astro.url.search}`, 301);
---
