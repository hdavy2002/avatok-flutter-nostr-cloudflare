---
// [SPEC-2026-09-01-LISTING-CONTENT-AND-BOOKING A1.1] /dashboard/marketplace is
// REMOVED — marketplace is a public, full-width page for everyone, logged in
// or not, never inside the dashboard shell. This route now only 301s to the
// real page, preserving any query string (?vertical=, ?q=) so old links and
// bookmarks keep working.
export const prerender = false;
return Astro.redirect(`/marketplace${Astro.url.search}`, 301);
