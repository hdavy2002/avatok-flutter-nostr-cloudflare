---
// avatok.ai — Forgot password.
//
// [WEB-AUTH-FACTORS-1 2026-08-26] The log-in screen's "FORGOT PASSWORD" link
// (README §1) had no page behind it and 404'd. Same shell as sign-in.astro; the
// handoff doesn't draw this screen, so it reuses the log-in furniture verbatim
// (marigold panel, horn artwork) and only the form differs.
export const prerender = false;

import Base from '../layouts/Base.astro';
import ForgotPasswordIsland from '../islands/auth/ForgotPasswordIsland.tsx';
import { clerkFapiHost } from '../lib/config';
import '../styles/auth.css';

Astro.response.headers.set('Cache-Control', 'private, no-store');

const clerkHost = clerkFapiHost();
---

<Base
  title="Forgot password · avaTOK"
  description="Reset your avaTOK password."
  chrome={false}
  noindex={true}
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Anton&family=Playfair+Display:ital,wght@1,900&family=Silkscreen:wght@700&family=Baloo+2:wght@800&family=Kalam&display=swap"
    />
    {clerkHost && (
      <Fragment>
        <link rel="preconnect" href={`https://${clerkHost}`} crossorigin />
        <link rel="dns-prefetch" href={`https://${clerkHost}`} />
      </Fragment>
    )}
  </Fragment>

  <div class="auth">
    <div class="auth-shell">
      <aside class="auth-panel auth-panel--marigold" aria-hidden="true">
        <span class="auth-rail">Creator Marketplace</span>
        <img src="/auth/horn-ok-please.png" alt="" width="996" height="354" />
        <p class="auth-aside">Chai ho jaye?<br />Woh bhi ho jayega.</p>
        <span class="auth-stamp">Desi · Dil Se · Global</span>
      </aside>

      <main class="auth-main">
        <span class="auth-rail">Creator Marketplace</span>
        <div class="auth-card">
          <header class="auth-head">
            <a class="auth-wordmark" href="/" aria-label="avaTOK home">
              <span class="wm-ava">ava</span><span class="wm-tok">TOK</span>
            </a>
            <img src="/auth/horn-ok-please.png" alt="" width="996" height="354" fetchpriority="high" />
          </header>
          <ForgotPasswordIsland client:load />
        </div>
        <span class="auth-stamp">Desi · Dil Se · Global</span>
      </main>
    </div>
  </div>
</Base>
