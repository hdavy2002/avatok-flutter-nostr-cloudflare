---
export const prerender = true;
import Content from '../layouts/Content.astro';

const roles = [
  {
    id: 'senior-fullstack-engineer',
    title: 'Senior Full-Stack Engineer',
    team: 'Platform',
    type: 'Full-time · Remote',
    summary:
      'Own features end to end across our TypeScript + Cloudflare Workers backend and Astro/React web client. You ship to production daily and care about performance at the edge.',
    skills: ['TypeScript', 'Cloudflare Workers / D1', 'React + Astro', 'API design', 'SQL'],
  },
  {
    id: 'flutter-mobile-engineer',
    title: 'Flutter Mobile Engineer',
    team: 'Apps',
    type: 'Full-time · Remote',
    summary:
      'Build the AvaTok mobile experience in Flutter — calls, the AI receptionist, messaging, and Ava AI features — with a local-first, offline-aware architecture across iOS and Android.',
    skills: ['Flutter / Dart', 'iOS & Android', 'Realtime / WebRTC', 'State management', 'Native channels'],
  },
  {
    id: 'machine-learning-engineer',
    title: 'Machine Learning Engineer',
    team: 'AI',
    type: 'Full-time · Remote',
    summary:
      'Take models from prototype to production — the AI receptionist voice, transcription, in-chat assistance, and safety. You build robust, low-latency ML pipelines that serve real users.',
    skills: ['Python', 'PyTorch / TensorFlow', 'LLMs & speech', 'Inference optimization', 'MLOps'],
  },
  {
    id: 'ai-research-engineer',
    title: 'AI Research Engineer',
    team: 'AI',
    type: 'Full-time · Remote',
    summary:
      'Push the frontier of human–AI interaction. Prototype with the latest models, evaluate rigorously, and turn research into features that ship — from agentic workflows to multimodal understanding.',
    skills: ['Applied ML research', 'LLM evaluation', 'RAG / agents', 'Prompt & model tuning', 'Multimodal'],
  },
  {
    id: 'backend-platform-engineer',
    title: 'Backend / Platform Engineer',
    team: 'Platform',
    type: 'Full-time · Remote',
    summary:
      'Design the systems that move money and media at scale — wallets, payouts, queues, and storage — on a serverless, globally distributed stack. Reliability and correctness are your craft.',
    skills: ['TypeScript / Go', 'Distributed systems', 'Queues & workers', 'Payments', 'Observability'],
  },
];

const applyHref = (title: string) =>
  `mailto:support@avatok.ai?subject=${encodeURIComponent('Application: ' + title)}&body=${encodeURIComponent(
    'Hi avaTOK team,\n\nI’d like to apply for the ' + title + ' role.\n\n- Name:\n- Location / timezone:\n- LinkedIn / portfolio / GitHub:\n- Link to CV/resume:\n- A note on why you’re a great fit:\n\nThanks!',
  )}`;
---

<Content
  kicker="Company"
  title="Careers at AvaTok"
  lead="Help us build a modern messenger powered by Sarvam AI, a made-in-India large language model built from scratch. We're an India-first team that ships fast and cares deeply about users and craft."
  width="wide"
>
  <p>
    AvaTok is built in India by <strong>Ava Global International Pvt Ltd</strong>, headquartered in Mumbai,
    with its Delaware subsidiary, <strong>AvaGlobal International, Inc.</strong>, supporting international
    operations. We hire builders who take ownership, communicate clearly, and want their work
    in the hands of real users. Don't see a perfect match? Email us anyway at
    <a href="mailto:support@avatok.ai">support@avatok.ai</a>.
  </p>

  <div class="jobs">
    {roles.map((r) => (
      <section class="job" id={r.id}>
        <div class="job-head">
          <div>
            <h3 class="job-title">{r.title}</h3>
            <div class="job-meta"><span class="badge">{r.team}</span><span class="job-type">{r.type}</span></div>
          </div>
          <button class="apply" type="button" data-apply-role={r.title}>Apply →</button>
        </div>
        <p class="job-sum">{r.summary}</p>
        <div class="job-skills">{r.skills.map((s) => <span class="chip">{s}</span>)}</div>
      </section>
    ))}
  </div>

  <p class="hiring-note">
    avaTOK / Ava Global International Pvt Ltd is an equal-opportunity employer. We welcome applicants of
    every background and are committed to a fair, inclusive hiring process. To apply, hit any
    <strong>Apply</strong> button or email <a href="mailto:support@avatok.ai">support@avatok.ai</a>.
  </p>

  <dialog class="apply-dialog" id="apply-dialog" aria-labelledby="apply-title">
    <form class="apply-form" id="apply-form" method="dialog">
      <button class="dialog-close" type="button" data-close-apply aria-label="Close application form">×</button>
      <p class="form-kicker">Join the team</p>
      <h2 id="apply-title">Apply to avaTOK</h2>
      <p class="form-intro">Send us your resume and a few details. We’ll get back to you if your experience is a match.</p>
      <input type="hidden" name="role" id="apply-role" />
      <label>Role<input type="text" id="apply-role-label" readonly /></label>
      <div class="form-grid">
        <label>Your name<input name="name" autocomplete="name" required maxlength="120" /></label>
        <label>Email<input name="email" type="email" autocomplete="email" required maxlength="200" /></label>
      </div>
      <label>Portfolio or LinkedIn <span>(optional)</span><input name="portfolio" type="url" autocomplete="url" placeholder="https://…" maxlength="300" /></label>
      <label>Resume <span>(PDF, DOC, or DOCX · max 8 MB)</span><input name="resume" type="file" accept=".pdf,.doc,.docx,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document" required /></label>
      <label>Anything you’d like us to know <span>(optional)</span><textarea name="note" rows="3" maxlength="2000" placeholder="A short note about you or your work"></textarea></label>
      <input class="company-trap" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <p class="form-status" id="apply-status" role="status" aria-live="polite"></p>
      <button class="send-application" type="submit">Send application ↗</button>
    </form>
  </dialog>
</Content>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('#apply-dialog');
  const form = document.querySelector<HTMLFormElement>('#apply-form');
  const roleInput = document.querySelector<HTMLInputElement>('#apply-role');
  const roleLabel = document.querySelector<HTMLInputElement>('#apply-role-label');
  const status = document.querySelector<HTMLElement>('#apply-status');
  const setStatus = (message: string, error = false) => {
    if (status) { status.textContent = message; status.dataset.error = error ? 'true' : 'false'; }
  };
  document.querySelectorAll<HTMLButtonElement>('[data-apply-role]').forEach((button) => {
    button.addEventListener('click', () => {
      const role = button.dataset.applyRole || 'AvaTOK role';
      form?.reset();
      if (roleInput) roleInput.value = role;
      if (roleLabel) roleLabel.value = role;
      setStatus('');
      dialog?.showModal();
    });
  });
  document.querySelector<HTMLButtonElement>('[data-close-apply]')?.addEventListener('click', () => dialog?.close());
  dialog?.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;
    const submit = form.querySelector<HTMLButtonElement>('.send-application');
    if (submit) { submit.disabled = true; submit.textContent = 'Sending…'; }
    setStatus('Sending your application…');
    try {
      const response = await fetch('/api/careers-apply', { method: 'POST', body: new FormData(form) });
      const result = await response.json().catch(() => ({}));
      if (!response.ok || !result.ok) throw new Error(result.error || 'Please try again.');
      form.reset();
      setStatus('Thanks — your application is on its way. We’ll be in touch if you’re selected.');
      if (submit) submit.textContent = 'Application sent ✓';
    } catch (error) {
      setStatus(error instanceof Error ? error.message : 'Something went wrong. Please try again.', true);
      if (submit) { submit.disabled = false; submit.textContent = 'Send application ↗'; }
    }
  });
</script>

<style>
  .jobs { display: flex; flex-direction: column; gap: 18px; margin-top: 28px; }
  .job {
    border: 2.5px solid var(--ink, #231b14);
    background: var(--card, #fff);
    border-radius: 16px;
    padding: 22px 24px;
    box-shadow: 3px 3px 0 var(--ink, #231b14);
  }
  .job-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
  .job-title { margin: 0 !important; font-family: 'Fredoka', sans-serif; font-size: 22px; color: var(--ink, #231b14); }
  .job-meta { display: flex; align-items: center; gap: 10px; margin-top: 8px; flex-wrap: wrap; }
  .badge {
    font-family: 'Space Mono', monospace; font-weight: 700; font-size: 12px; letter-spacing: 0.04em;
    text-transform: uppercase; color: var(--blue-ink, #007d7f); background: var(--blue, #cdeff0);
    border: 2px solid var(--ink, #231b14); border-radius: 999px; padding: 2px 10px;
  }
  .job-type { font-family: 'Space Mono', monospace; font-weight: 700; font-size: 13px; color: var(--ink-soft, #6a6258); }
  .apply {
    flex: none; font-family: 'Space Mono', monospace; font-weight: 700; font-size: 13px;
    text-transform: uppercase; letter-spacing: 0.04em; text-decoration: none !important;
    color: var(--ink, #231b14) !important; background: var(--lime, #bfeb56); cursor: pointer;
    border: 2.5px solid var(--ink, #231b14); border-radius: 999px; padding: 8px 16px;
    box-shadow: 2px 2px 0 var(--ink, #231b14); transition: transform .12s ease, box-shadow .12s ease;
  }
  .apply:hover { transform: translate(-1px,-1px); box-shadow: 3px 4px 0 var(--ink, #231b14); color: var(--ink, #231b14) !important; }
  .job-sum { margin: 14px 0 0; font-size: 16px; font-weight: 600; color: var(--ink-soft, #6a6258); line-height: 1.55; }
  .job-skills { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 16px; }
  .chip {
    font-size: 13px; font-weight: 700; color: var(--ink, #231b14); background: var(--paper-2, #f0ece0);
    border: 1.5px solid var(--ink, #231b14); border-radius: 8px; padding: 4px 10px;
  }
  .hiring-note { margin-top: 32px; }
  .apply-dialog { width: min(620px, calc(100% - 28px)); max-height: min(760px, calc(100dvh - 28px)); padding: 0; border: 2px solid var(--ink, #231b14); border-radius: 22px; background: var(--card, #fffdf7); box-shadow: 8px 8px 0 var(--blue-ink, #4d5cff); color: var(--ink, #231b14); }
  .apply-dialog::backdrop { background: rgba(24, 22, 19, .55); backdrop-filter: blur(3px); }
  .apply-form { position: relative; display: grid; gap: 13px; padding: 30px; }
  .dialog-close { position: absolute; top: 12px; right: 14px; width: 34px; height: 34px; border: 1.5px solid var(--ink, #231b14); border-radius: 50%; background: var(--paper-2, #f0ece0); font-size: 24px; line-height: 1; cursor: pointer; }
  .form-kicker { margin: 0; color: var(--blue-ink, #4d5cff); font-family: 'Space Mono', monospace; font-size: 12px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  .apply-form h2 { margin: 0; font-family: 'Fredoka', sans-serif; font-size: clamp(30px, 5vw, 42px); line-height: 1; }
  .form-intro { margin: 0 34px 4px 0; color: var(--ink-soft, #6a6258); line-height: 1.45; }
  .apply-form label { display: grid; gap: 6px; font-weight: 700; font-size: 14px; }
  .apply-form label span { color: var(--ink-soft, #6a6258); font-weight: 500; }
  .apply-form input, .apply-form textarea { width: 100%; box-sizing: border-box; border: 1.5px solid var(--ink, #231b14); border-radius: 10px; padding: 11px 12px; background: #fff; color: var(--ink, #231b14); font: inherit; }
  .apply-form input[readonly] { background: var(--paper-2, #f0ece0); }
  .apply-form textarea { resize: vertical; min-height: 82px; }
  .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .company-trap { position: absolute !important; left: -10000px !important; width: 1px !important; height: 1px !important; opacity: 0 !important; }
  .form-status { min-height: 22px; margin: 0; color: var(--blue-ink, #007d7f); font-size: 14px; line-height: 1.4; }
  .form-status[data-error="true"] { color: #b42318; }
  .send-application { justify-self: start; border: 2px solid var(--ink, #231b14); border-radius: 999px; padding: 12px 18px; background: var(--yellow, #ffd45d); color: var(--ink, #231b14); font: 700 14px 'Space Mono', monospace; cursor: pointer; box-shadow: 3px 3px 0 var(--ink, #231b14); }
  .send-application:disabled { cursor: wait; opacity: .7; }
  @media (max-width: 640px) { .apply-form { padding: 25px 18px 20px; } .form-grid { grid-template-columns: 1fr; } .apply-dialog { box-shadow: 5px 5px 0 var(--blue-ink, #4d5cff); } }
</style>
