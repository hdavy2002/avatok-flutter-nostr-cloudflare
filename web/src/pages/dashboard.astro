---
// /dashboard — [SAATHUM-BOOK-TO-MARKETPLACE-1 2026-09-29, owner decision] The Dashboard 2
// "Book events" page is removed: browsing and booking happen on the public /marketplace.
// A link that carries a filter (?cat=, ?q=) goes to /marketplace with it; a bare /dashboard
// (the header "Dashboard" button) lands on My events.
export const prerender = false;
const search = Astro.url.search;
return Astro.redirect(search ? `/marketplace${search}` : '/dashboard/my-events', 302);
---
