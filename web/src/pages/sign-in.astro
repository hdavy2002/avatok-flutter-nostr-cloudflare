---
// saathum.com — Log in.
//
// [WEB-AUTH-DESIGN-1 2026-08-26] Rebuilt from design/login/README.md, replacing
// Clerk's prebuilt <SignIn/> drop-in (which could not be themed this far).
//
// Astro page shell + ONE React island for the form. The shell is server-rendered
// so the artwork, wordmark and layout paint immediately; only the interactive
// form hydrates. `chrome={false}` keeps Base's footer disabled. [HF-AUTH-GHAR-1] No site header either (owner).
// [HF-AUTH-PCO-3 2026-10-17] Prerendered: the page is the same for everyone (the Clerk island does the work in the
// browser), and the art-slot check in components/auth/authSkin.ts needs build-time file access.
export const prerender = true;

import Base from '../layouts/Base.astro';
import AuthGhar from '../components/auth/AuthGhar.astro';
import LoginIsland from '../islands/auth/LoginIsland.tsx';
import { clerkFapiHost } from '../lib/config';
import '../styles/auth.css';
import { BRAND } from '../lib/brand';


const clerkHost = clerkFapiHost();
---

<Base
  title={`Log in · ${BRAND.name}`}
  description={`Log in to ${BRAND.name} — talk to your favourite influencer on a private call. Your number stays private.`}
  chrome={false}
  header
>
  <Fragment slot="head">
    <!-- The six brand faces (README §Type). Loaded here rather than globally so
         the rest of the site doesn't pay for fonts only auth uses. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload" as="style" onload="this.onload=null;this.rel='stylesheet'"
      href="https://fonts.googleapis.com/css2?family=Comfortaa:wght@400;500;600;700&family=Nunito:wght@700;800;900&display=swap"
    />
    {clerkHost && (
      <Fragment>
        <link rel="preconnect" href={`https://${clerkHost}`} crossorigin />
        <link rel="dns-prefetch" href={`https://${clerkHost}`} />
      </Fragment>
    )}
  </Fragment>

  <!-- [HF-AUTH-GHAR-1 2026-10-17] No site footer here (owner); the site header shows on every page (owner 2026-10-24, HF-HEADER-EVERYWHERE-1). Shell + art: components/auth/AuthGhar.astro. -->
  <AuthGhar variant="in">
    <header class="auth-head">
      <p class="auth-hindi">We've been waiting for you</p>
    </header>
    <LoginIsland client:load />
  </AuthGhar>
</Base>
