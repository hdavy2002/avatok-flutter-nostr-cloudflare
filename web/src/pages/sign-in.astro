---
// saathum.com — Log in.
//
// [WEB-AUTH-DESIGN-1 2026-08-26] Rebuilt from design/login/README.md, replacing
// Clerk's prebuilt <SignIn/> drop-in (which could not be themed this far).
//
// Astro page shell + ONE React island for the form. The shell is server-rendered
// so the artwork, wordmark and layout paint immediately; only the interactive
// form hydrates. `chrome={false}` keeps Base's footer disabled; the shared
// SiteHeader renders above the auth screen and its own ornaments.
export const prerender = false;

import Base from '../layouts/Base.astro';
import IndiaLanguageSelector from '../components/IndiaLanguageSelector.astro';
import SiteHeader from '../components/SiteHeader.astro';
import LoginIsland from '../islands/auth/LoginIsland.tsx';
import { clerkFapiHost, publicImage } from '../lib/config';
import '../styles/auth.css';

Astro.response.headers.set('Cache-Control', 'private, no-store');

const clerkHost = clerkFapiHost();
---

<Base
  title="Log in · Saathum"
  description="Log in to Saathum — a global creator marketplace for live events, private sessions and AI voice."
  chrome={false}
>
  <Fragment slot="head">
    <!-- The six brand faces (README §Type). Loaded here rather than globally so
         the rest of the site doesn't pay for fonts only auth uses. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Comfortaa:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@1,900&family=Instrument+Sans:wght@400;500;600;700&family=Baloo+2:wght@800&family=Kalam&display=swap"
    />
    {clerkHost && (
      <Fragment>
        <link rel="preconnect" href={`https://${clerkHost}`} crossorigin />
        <link rel="dns-prefetch" href={`https://${clerkHost}`} />
      </Fragment>
    )}
  </Fragment>

  <SiteHeader authMobileOnly indiaLandingLanguage />

  <div class="auth">
    <div class="auth-shell">
      <!-- Decorative left panel — desktop (>=1280px) only. Hidden, never
           shrunk, below that (README §Responsive). -->
      <aside class="auth-panel auth-panel--marigold" aria-hidden="true">
        <span data-i18n="web-auth.1ffe0e40e1c3005e" class="auth-rail">Creator Marketplace</span>
        <img src={publicImage('/auth/horn-ok-please.png', { width: 996, fit: 'scale-down' })} alt="" width="996" height="354" />
        <p class="auth-aside"><ui-copy style="display:contents" data-i18n="web-auth.147f03f49b15afba">Chai ho jaye?</ui-copy><br /><ui-copy style="display:contents" data-i18n="web-auth.eef3540404312d17">Woh bhi ho jayega.</ui-copy></p>
        <span data-i18n="web-auth.1dbccd09995a56ce" class="auth-stamp">Desi · Dil Se · Global</span>
      </aside>

      <main class="auth-main">
        <!-- Rail and stamp for the 768–1279 card layout. The panel above owns
             its own copies for >=1280; these two are hidden there. Duplicated
             rather than shared because the panel is display:none below 1280,
             which would take the ornaments with it. -->
        <span data-i18n="web-auth.1ffe0e40e1c3005e" class="auth-rail">Creator Marketplace</span>
        <div class="auth-card">
          <div class="auth-language"><IndiaLanguageSelector id="auth-language" /></div>
          <header class="auth-head">
            <a data-india-i18n-attr="aria-label:web-auth.394186beed5b531d" class="auth-wordmark" href="/" aria-label="Saathum home">
              <span class="wm-ava">ava</span><span class="wm-tok">TOK</span>
            </a>
            <img src={publicImage('/auth/horn-ok-please.png', { width: 996, fit: 'scale-down' })} alt="" width="996" height="354" fetchpriority="high" />
            <p class="auth-hindi" lang="hi">आपका इंतज़ार था</p>
          </header>
          <LoginIsland client:load />
        </div>
        <span data-i18n="web-auth.1dbccd09995a56ce" class="auth-stamp">Desi · Dil Se · Global</span>
      </main>
    </div>
  </div>
</Base>
