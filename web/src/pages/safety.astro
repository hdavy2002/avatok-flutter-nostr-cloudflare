.safety-cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr));gap:1rem}.safety-cards a{display:grid;gap:.5rem;padding:1.2rem;border:1px solid #ded8cf;border-radius:16px;text-decoration:none}.safety-cards span{font-size:.95rem}
