---
// [HF-JOIN-PAT-1/2 2026-10-18] /hosts/join — "Pat-Katha" (the scroll story). Owner: a brand-new Indian layout and
// artwork found nowhere else on the site; little reading — the Indian art explains it. The page is a Bengal Patachitra
// scroll a patua unrolls panel by panel, telling one creator's story (Neha, a home-cooking creator from Indore):
//   Pat 1 Khaata (free account) → Pat 2 Upgrade (free, from the dashboard) → Pat 3 Apna daam (set your rate) → Pat 4 Phone bajega (take calls)
// Crafts: Patachitra panels on handmade paper, Channapatna lacquer rollers and buttons, Kantha stitch borders, Gond
// dot-art medallions and section ground, a Bandhani hero, a Bidri silver-inlay earnings ledger, Ikat privacy section and
// a Kalamkari closing panel. Art: /assets/hf-join/ (slots + CSS stand-ins in components/join/joinSkin.ts). Prompt pack:
// SaatHum project doc claude/hello-fraands-join-artwork-prompts.md. Styles: styles/join-pat.css (scoped `.jp`).
// Owner model (2026-10-18): influencers create an account, then upgrade to influencer for FREE in the dashboard; they set
// their own per-minute rate (no range shown); fans are charged per minute of the phone call; [HF-WIRE-15 2026-10-19] we keep
// ₹2 a minute plus 40% of the rate above ₹2 and the influencer keeps the rest (HF-REEL-30); Indian influencers
// only for now. Do not describe registration/verification steps. Never per-second billing, never the payment gateway.
// Contracts (scripts/check-hello-fraands-pages.mjs) read the earnings paragraph verbatim and the .jp-coins list.
export const prerender = true;

import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/callvaal/Header.astro';
import SiteFooter from '../../components/callvaal/Footer.astro';
import { publicImage } from '../../lib/config';
import { BRAND } from '../../lib/brand';
import type { PublicContent } from '../../lib/seo/types';
import { JOIN_ART, JOIN_BG, JOIN_SKINS } from '../../components/join/joinSkin';
import '../../styles/desi-home-chrome.css';
import '../../styles/join-pat.css';

const content: PublicContent = {
  kind: 'collection',
  key: 'hosts-join',
  canonicalPath: '/hosts/join',
  title: 'Join & earn',
  summary: `Are you an influencer in India? Join ${BRAND.name} for free, set your own per-minute rate, and earn when your fans call you. Your real number stays private.`,
  visibility: 'public',
};
const img = (p: string, w: number) => publicImage(p, { width: w, fit: 'scale-down' });
const vars = [
  ...JOIN_BG.map((o) => `--jp-${o.key}:url(${img(o.path, o.width)}) ${o.tail}`),
  ...JOIN_SKINS.map((o) => `--jp-${o.key}:url(${img(o.path, o.width)})`),
].join(';');
const skins = [...JOIN_BG, ...JOIN_SKINS].map((o) => o.key).join(' ');
const rate = 20; const callCost = 2; const cut = (rate - callCost) * 0.4; const perMin = rate - callCost - cut;
const medals = [JOIN_ART.medal1, JOIN_ART.medal2, JOIN_ART.medal3, JOIN_ART.medal4];
const pats = [
  { n: 1, word: 'Khaata', title: 'Create your free account', alt: 'Patachitra-style painting: Neha opening a beautifully painted account book on her phone', art: JOIN_ART.pat1, css: 'Khaata' },
  { n: 2, word: 'Upgrade', title: 'Become an influencer, free', alt: 'Patachitra-style painting: Neha stepping up onto a decorated stage, a garland placed around her neck', art: JOIN_ART.pat2, css: 'Upgrade' },
  { n: 3, word: 'Apna daam', title: 'Set your own rate', alt: 'Patachitra-style painting: Neha writing her price on a slate, surrounded by her cooking pots', art: JOIN_ART.pat3, css: 'Apna daam' },
  { n: 4, word: 'Phone bajega', title: 'Go online, take calls', alt: "Patachitra-style painting: Neha's phone ringing in her kitchen while a fan waits on a swing across a painted wall", art: JOIN_ART.pat4, css: 'Phone bajega' },
];
---
<Base content={content} chrome={false} indiaLandingLanguage={false}>
  <Fragment slot="head">
    <meta name="theme-color" content="#8f1240" />
    <link rel="preload" as="style" onload="this.onload=null;this.rel='stylesheet'" href="https://fonts.googleapis.com/css2?family=Comfortaa:wght@500;600;700&family=Nunito:wght@700;800;900&display=swap" />
  </Fragment>
  <div class="jp desi-home" style={vars} data-skins={skins || undefined}>
    <a class="jp-skip" href="#main-content">Skip to main content</a>
    <SiteHeader />
    <main id="main-content" class="jp-main">

      <!-- HERO: Bandhani ground, the patua opens the scroll -->
      <section class="jp-hero" aria-labelledby="jp-title">
        <div class="jp-wrap jp-hero-grid">
          <div class="jp-hero-copy">
            <p class="jp-masthead"><span>Pat-katha</span><span>For influencers in India</span></p>
            <h1 id="jp-title">Your fans want to talk. <span class="jp-pop">Get paid for every minute.</span></h1>
            <p class="hf-hindi jp-hindi"><em>Apne fans se private call par kamaayein, apna number private rakhkar.</em></p>
            <ul class="jp-facts" aria-label="At a glance">
              <li data-tone="haldi"><b>Free to join</b><span>No fee, no subscription.</span></li>
              <li data-tone="sky"><b>Your rate</b><span>You set your price per minute.</span></li>
              <li data-tone="rani"><b>Number hidden</b><span>Fans never see it.</span></li>
            </ul>
            <div class="jp-ctas">
              <a class="jp-btn" href="/sign-up">Join for free →</a>
              <a class="jp-btn jp-btn--blue" href="#earn">See earnings</a>
            </div>
          </div>
          <div class="jp-hero-art">
            {JOIN_ART.hero
              ? <img src={img(JOIN_ART.hero, 1100)} alt="Patachitra-style illustration of a scroll singer unrolling a painted scroll that shows Neha, a cooking creator, on a call with her fans" width="1100" height="1300" fetchpriority="high" decoding="async" />
              : <div class="jp-css-hero" aria-hidden="true"><span>1</span><span>2</span><span>3</span><span>4</span></div>}
          </div>
        </div>
      </section>
      <div class="jp-band jp-band--kantha" aria-hidden="true"></div>

      <!-- THE SCROLL: four Patachitra panels on handmade paper, Gond-dot ground -->
      <section class="jp-scroll" aria-labelledby="jp-steps">
        <div class="jp-wrap">
          <header class="jp-scroll-head">
            <p class="jp-kicker">Neha's scroll · 4 panels</p>
            <h2 id="jp-steps">How to join</h2>
            <p class="jp-scroll-sub">Neha cooks for her Instagram fans in Indore. This is how she started taking their calls.</p>
          </header>
          <div class="jp-scroll-body">
            {JOIN_ART.roller ? <img class="jp-roller jp-roller--top" src={img(JOIN_ART.roller, 1400)} alt="" width="1400" height="110" loading="lazy" decoding="async" /> : <div class="jp-roller jp-roller--top jp-css-roller" aria-hidden="true"></div>}
            <ol class="jp-pats">
              {pats.map((p) => (
                <li class:list={['jp-pat', { 'jp-pat--flip': p.n % 2 === 0 }]} id={`pat-${p.n}`} data-pat={p.n}>
                  <figure class="jp-frame">
                    {p.art ? <img src={img(p.art, 1000)} alt={p.alt} width="1000" height="750" loading="lazy" decoding="async" /> : <div class="jp-css-pat" aria-hidden="true">{p.css}</div>}
                  </figure>
                  <div class="jp-card">
                    <span class="jp-medal" data-pat={p.n}>{medals[p.n - 1] && <img src={img(medals[p.n - 1]!, 300)} alt="" width="300" height="300" loading="lazy" decoding="async" />}<b>{p.n}</b></span>
                    <p class="jp-kicker">Pat {p.n} · {p.word}</p>
                    <h3>{p.title}</h3>
                    {p.n === 1 && <p>Sign up on {BRAND.name}. It's free.</p>}
                    {p.n === 2 && <p>Open your dashboard and upgrade to influencer. That's free too.</p>}
                    {p.n === 3 && (
                      <>
                        <p>Choose your price per minute, as you see fit.</p>
                        <div class="jp-profile" aria-label="Example profile">
                          <span class="jp-avatar" aria-hidden="true">N</span>
                          <span class="jp-profile-who"><b>Neha</b><small>Home cooking · Hindi</small></span>
                          <span class="jp-rate">₹{rate}/min</span>
                        </div>
                      </>
                    )}
                    {p.n === 4 && (
                      <>
                        <p>Go online when you are free. We ring you first. You choose.</p>
                        <div class="jp-keys" aria-label="Example call">
                          <span class="jp-key jp-key--yes"><b>1</b>Accept</span>
                          <span class="jp-key jp-key--no"><b>2</b>Decline</span>
                        </div>
                      </>
                    )}
                  </div>
                </li>
              ))}
            </ol>
            {JOIN_ART.roller ? <img class="jp-roller jp-roller--bottom" src={img(JOIN_ART.roller, 1400)} alt="" width="1400" height="110" loading="lazy" decoding="async" /> : <div class="jp-roller jp-roller--bottom jp-css-roller" aria-hidden="true"></div>}
          </div>
        </div>
      </section>
      <div class="jp-band jp-band--bidri" aria-hidden="true"></div>

      <!-- EARNINGS: Bidri silver-inlay ledger -->
      <section class="jp-ledger" id="earn" aria-labelledby="jp-earn">
        <div class="jp-wrap">
          <p class="jp-kicker">Har minute ka hisaab</p>
          <h2 id="jp-earn">What you earn</h2>
          <p class="jp-ledger-lead">Fans are charged per minute of the phone call. We keep ₹2 a minute plus 40% of the rate above ₹2. You keep the rest. The part we keep includes platform fees and GST. Being online does not guarantee calls.</p>
          <ol class="jp-split" aria-label={`One connected minute at ₹${rate}`}>
            <li><small>Fan pays</small><b>₹{rate}</b></li>
            <li><small>Phone call</small><b>−₹{callCost}</b></li>
            <li><small>40% of the rest</small><b>−₹{cut.toFixed(2)}</b><em>incl. platform fees &amp; GST</em></li>
            <li class="jp-split-you"><small>You earn</small><b>₹{perMin.toFixed(2)}</b></li>
          </ol>
          <div class="jp-ledger-grid">
            <ul class="jp-coins" aria-label={`At ₹${rate} a minute`}>
              <li><small>1 hour</small><b>₹648</b></li>
              <li><small>1,000 minutes</small><b>₹10,800</b></li>
              <li><small>3,000 minutes</small><b>₹32,400</b></li>
            </ul>
            <form class="jp-calc" aria-labelledby="jp-calc-title" onsubmit="return false">
              <p class="jp-calc-title" id="jp-calc-title">Try your numbers</p>
              <label>Your rate (₹ a minute)<input type="number" name="rate" min="1" step="1" value={rate} inputmode="numeric" /></label>
              <label>Minutes talked<input type="number" name="mins" min="1" max="100000" step="1" value="60" inputmode="numeric" /></label>
              <p class="jp-calc-out" aria-live="polite">You earn <output name="total">₹648</output></p>
            </form>
          </div>
          <p class="jp-ledger-more">Before TDS or your own taxes. <a href="/hosts/rates">Rates &amp; withdrawals</a></p>
        </div>
      </section>
      <div class="jp-band jp-band--ikat" aria-hidden="true"></div>

      <!-- PRIVACY: Ikat ground, three promises -->
      <section class="jp-promise" aria-labelledby="jp-private">
        <div class="jp-wrap">
          <p class="jp-kicker">Teen vaade</p>
          <h2 id="jp-private">Three promises</h2>
          <ul class="jp-promises">
            <li data-tone="haldi">
              {JOIN_ART.shield1 ? <img src={img(JOIN_ART.shield1, 400)} alt="" width="400" height="400" loading="lazy" decoding="async" /> : <span class="jp-css-promise" aria-hidden="true">☎</span>}
              <h3>Number hidden</h3>
              <p>Calls go through our masked line.</p>
            </li>
            <li data-tone="rani">
              {JOIN_ART.shield2 ? <img src={img(JOIN_ART.shield2, 400)} alt="" width="400" height="400" loading="lazy" decoding="async" /> : <span class="jp-css-promise" aria-hidden="true">☺</span>}
              <h3>Avatar, not photo</h3>
              <p>Fans see the avatar you choose.</p>
            </li>
            <li data-tone="sky">
              {JOIN_ART.shield3 ? <img src={img(JOIN_ART.shield3, 400)} alt="" width="400" height="400" loading="lazy" decoding="async" /> : <span class="jp-css-promise" aria-hidden="true">✓</span>}
              <h3>You decide</h3>
              <p>When to go online. Which calls to take.</p>
            </li>
          </ul>
        </div>
      </section>
      <div class="jp-band jp-band--kantha" aria-hidden="true"></div>

      <!-- CLOSE: Kalamkari ground, the scroll rolls up -->
      <section class="jp-close" aria-labelledby="jp-apply">
        <div class={`jp-wrap jp-close-grid${JOIN_ART.cta ? ' has-art' : ''}`}>
          {JOIN_ART.cta && <img class="jp-close-art" src={img(JOIN_ART.cta, 900)} alt="Patachitra-style painting: the scroll singer rolling up the scroll as Neha waves goodbye to a happy fan" width="900" height="720" loading="lazy" decoding="async" />}
          <div class="jp-close-copy">
            <p class="jp-kicker">Ab aapki baari</p>
            <h2 id="jp-apply">Your scroll starts here.</h2>
            <p>Open to influencers in India. Calls are for conversation, not professional advice. Read the <a href="/hosts/rules">influencer rules</a> and <a href="/hosts/agreement">agreement</a>.</p>
            <p>Joining is free, and anyone can join in one of two ways. Connect a channel: sign in with YouTube, or put a short code in your Instagram bio (20 or more followers, and 1,000 or more views on YouTube). Or do a video KYC: Aadhaar and a short selfie video. Individuals are welcome to chat, keep company or share their day. Your channel videos stay on YouTube and Instagram and play in their own players; we do not copy or store them. You can choose to take calls only from video-KYC customers, for free. We never share any customer&rsquo;s details with anyone.</p>
            <div class="jp-ctas">
              <a class="jp-btn" href="/sign-up">Join for free →</a>
              <a class="jp-btn jp-btn--blue" href="/hosts/rates">Rates &amp; withdrawals</a>
            </div>
          </div>
        </div>
      </section>
    </main>
    <SiteFooter />
  </div>
</Base>

<script>
  // Earnings calculator: we keep ₹2 a minute plus 40% of the rate above ₹2 (same rule as the paragraph above).
  const form = document.querySelector<HTMLFormElement>('.jp-calc');
  if (form) {
    const update = () => {
      const r = Math.max(0, Math.round(Number((form.elements.namedItem('rate') as HTMLInputElement).value) || 0));
      const m = Math.max(0, Math.round(Number((form.elements.namedItem('mins') as HTMLInputElement).value) || 0));
      const total = Math.max(0, Math.round(Math.max(0, r - 2) * 0.6 * m));
      (form.elements.namedItem('total') as HTMLOutputElement).value = '₹' + total.toLocaleString('en-IN');
    };
    form.addEventListener('input', update);
    update();
  }
</script>
