---
// [HF-HOST-ONBOARD-1] Host onboarding (Phase 1 clickable mock). Standalone page, not indexed.
import brandConfig from '../../../../Specs/brand.json';
import SiteHeader from '../../components/callvaal/Header.astro'; // [HF-HEADER-EVERYWHERE-1] the front-page header on every website page
import HostOnboarding from '../../islands/host-onboarding/HostOnboarding';
import '../../styles/callvaal-notebook.css';
import '../../styles/profile-card.css';
import '../../styles/host-onboarding/base.css';
import '../../styles/host-onboarding/verify.css';
import '../../styles/host-onboarding/profile.css';
import '../../styles/host-onboarding/finish.css';
import '../../styles/host-onboarding/spaces.css'; // [HF-CREATOR-SPACES-1]
export const prerender = true;
const identity = brandConfig.homepageIdentity;
---
<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{`Become an influencer | ${identity.name}`}</title>
    <meta name="robots" content="noindex,nofollow" />
    <meta name="theme-color" content="#46113e" />
    <link rel="icon" href="/assets/branding/hf-favicon.png" type="image/png" />
    <link data-site-fonts rel="preload" href="/fonts/Comfortaa-Bold.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/fonts/Nunito-Black.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body class="hf-flow-page">
    <SiteHeader />
    <HostOnboarding client:only="react" />
    <noscript><p style="padding:24px;font-family:sans-serif;font-size:1rem">Please turn on JavaScript to become an influencer.</p></noscript>
  </body>
</html>
