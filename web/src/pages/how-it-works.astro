---
// [WEB-HIW-2 2026-09-27] /how-it-works rebuilt to the owner-approved mockup
// design/how-it-works/saathum-how-it-works-mock.src.html. OWNER: "I want this
// exact replica on the main site … not an inspired design. Use the same
// graphics as in the mock." Replaces the [SAATHUM-REBRAND-1] Content.astro
// article (the old how-it-works-sticker-v2.png is no longer referenced).
//
// NOTE FOR AI:
//  - Same shell as pages/marketplace.astro and pages/help/index.astro: Base
//    chrome={false}, the `.folk-site[data-design="reference-v5"]`
//    wrapper carrying --folk-border-url, SiteHeader/SiteFooter `folk`,
//    Comfortaa+Nunito, theme-color #fff8e8. The mockup's own header/footer are
//    NOT copied — the live components are the header and footer.
//  - Page CSS: styles/how-it-works.css (scoped under `.hw`). Every rule there
//    is the mockup's rule, `hw-` prefixed. The gold ribbon is the live
//    `.grand-divider` (1:1 the same rule as the mockup's `.ribbon`).
//  - Graphics: public/assets/how-it-works/ (the mock's die-cut stickers
//    and hero painting), plus the live elephant and diya art, all through
//    publicImage() so the built-image-source deploy check can verify them.
//  - "Don't box in": .hw-wrap is max 1280px (1480px >= 1800px) with the band
//    backgrounds full width, exactly as the mockup.
//  - Exactly one <h1>. FAQ is plain <details>; no FAQPage JSON-LD (the help
//    centre landing owns the site's one FAQPage block).
//  - Emails are plain text "name (@) saathum.com", never mailto. Brand: "Saa Thum".
export const prerender = true;

import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { publicImage, publicImageSrcSet } from '../lib/config';
import { HOME_HEADER_LINKS } from '../lib/homeNavigation';
import { HOW_IT_WORKS_SEO } from '../lib/seo/catalog';
import '../styles/saathum-folk.css';
import '../styles/how-it-works.css';
import { BRAND } from '../lib/brand';

const A = '/assets/how-it-works/';
// Die-cut stickers: every one is shown at <= 230px, so a 640px variant covers 2x.
const sticker = (name: string) => publicImage(`${A}${name}.webp`, { width: 640, fit: 'scale-down' });
const IMG = {
  havan: sticker('havan'),
  puja: sticker('puja'),
  satsang: sticker('satsang'),
  meditation: sticker('meditation'),
  link: sticker('link'),
  namaste: sticker('namaste'),
  ontime: sticker('ontime'),
  elephant: publicImage('/assets/booking/elephant.png', { width: 420, fit: 'scale-down' }),
};
const heroSrc = publicImage(`${A}hero.png`, { width: 1280, fit: 'scale-down' });
const heroSrcSet = publicImageSrcSet(`${A}hero.png`, [640, 900, 1280], { fit: 'scale-down' });
---
<Base content={HOW_IT_WORKS_SEO} chrome={false} indiaLandingLanguage={false}>
  <Fragment slot="head">
    <meta name="theme-color" content="#fff8e8" />
    <link rel="preload" as="style" onload="this.onload=null;this.rel='stylesheet'" href="https://fonts.googleapis.com/css2?family=Comfortaa:wght@400;500;600;700&family=Nunito:wght@400;600;700;800;900&display=swap" />
  </Fragment>
  <div class="folk-site" data-design="reference-v5" style={`--folk-border-url:url(${publicImage('/assets/bright/border.png', { width: 640, fit: 'scale-down' })})`}>
    <a class="folk-skip" href="#main-content">Skip to main content</a>
    <SiteHeader folk indiaLandingLanguage={false} responsiveHome referenceHome links={HOME_HEADER_LINKS} />
    <main id="main-content" class="hw">
      <!-- HERO -->
      <section class="hw-hero hw-wrap" aria-labelledby="hiw-title">
        <div class="hw-hero-inner">
          <div>
            <p class="hw-eyebrow">How it works</p>
            <h1 id="hiw-title">From your booking to the temple altar. <em>Step by step.</em></h1>
            <p class="hw-lead">You pick an event, our crew makes the trip to a quiet Himalayan temple, and the pujari who serves there performs it at the altar while we film. Below you will find what happens at each stage, and how best to sit for every kind of event.</p>
            <div class="hw-hero-actions">
              <a class="hw-btn" href="/marketplace">Browse events <span aria-hidden="true">→</span></a>
              <a class="hw-link" href="#kinds">The four event types <span aria-hidden="true">↓</span></a>
            </div>
            <p class="hw-hero-quiet">Each event happens on its scheduled date. Nothing is pre-recorded.</p>
          </div>
          <div class="hw-hero-art">
            <img class="hw-painting" src={heroSrc} srcset={heroSrcSet} sizes="(max-width: 1100px) min(640px, 100vw), 50vw" alt="A family gathered at home one morning, a lit diya beside the tablet on which they watch a havan." width="1000" height="667" fetchpriority="high" decoding="async" />
            <img class="hw-stamp hw-stamp--a" src={IMG.puja} alt="" aria-hidden="true" width="640" height="505" decoding="async" />
            <img class="hw-stamp hw-stamp--b" src={IMG.link} alt="" aria-hidden="true" width="384" height="640" decoding="async" />
          </div>
        </div>
      </section>
      <div class="grand-divider" aria-hidden="true"></div>

      <!-- FOUR KINDS -->
      <section class="hw-kinds" id="kinds" aria-labelledby="kinds-title">
        <div class="hw-wrap">
          <div class="hw-sec-head">
            <div><h2 id="kinds-title"><span aria-hidden="true">✽</span>Four event types, four ways to take part.</h2>
            <p>On a listing card they can look alike, yet each asks something different of you. This is what sets them apart.</p></div>
          </div>
          <div class="hw-kind-grid">
            <article class="hw-kind hw-kind--havan">
              <span class="hw-tag">Havan</span>
              <img src={IMG.havan} alt="" width="640" height="558" loading="lazy" decoding="async" />
              <h3>One fire, many families</h3>
              <p>Priests feed a sacred fire with offerings as Vedic mantras are chanted. Families from many places share a single havan, and a common sankalp is recited for all of them before the fire is kindled.</p>
              <div class="hw-meta"><span>Open to everyone</span><span>60 to 120 min</span><span>Sankalp + prasad</span></div>
            </article>
            <article class="hw-kind hw-kind--puja">
              <span class="hw-tag">Puja</span>
              <img src={IMG.puja} alt="" width="640" height="505" loading="lazy" decoding="async" />
              <h3>Worship offered on your behalf</h3>
              <p>A priest offers a lamp, flowers and prayer at a real temple altar, reciting one sankalp for all who join. Simpler than a havan, and well suited to a festival or a day that matters.</p>
              <div class="hw-meta"><span>Open to everyone</span><span>20 to 60 min</span><span>Sankalp + prasad</span></div>
            </article>
            <article class="hw-kind hw-kind--satsang">
              <span class="hw-tag">Satsang &amp; sermon</span>
              <img src={IMG.satsang} alt="" width="640" height="531" loading="lazy" decoding="async" />
              <h3>Listening, side by side</h3>
              <p>A speaker leads a talk, a reading or devotional songs. No ritual is performed and no sankalp is said; you save a seat, listen, and keep whatever moves you.</p>
              <div class="hw-meta"><span>One seat per family</span><span>45 to 90 min</span><span>No prasad</span></div>
            </article>
            <article class="hw-kind hw-kind--meditation">
              <span class="hw-tag">Meditation</span>
              <img src={IMG.meditation} alt="" width="640" height="461" loading="lazy" decoding="async" />
              <h3>Stillness, with a guide</h3>
              <p>A guide takes you through breathing and quiet. All you need is a calm corner and headphones. Nothing is done for you here; the practice is yours.</p>
              <div class="hw-meta"><span>Anyone can join</span><span>20 to 45 min</span><span>No prasad</span></div>
            </article>
          </div>
        </div>
      </section>

      <!-- BOOKING -->
      <section class="hw-book" aria-labelledby="book-title">
        <div class="hw-wrap">
          <div class="hw-sec-head"><div><h2 id="book-title"><span aria-hidden="true">✽</span>Book in about a minute</h2><p>Three quick steps on your phone, with no app to install.</p></div></div>
          <ol class="hw-steps">
            <li><img src={IMG.ontime} alt="" width="443" height="494" loading="lazy" decoding="async" /><div><h3>Choose an event and a date</h3><p>Under Explore, search by wish, deity or festival. Each card tells you who leads it, when it begins, and the starting-from price.</p></div></li>
            <li><img src={IMG.namaste} alt="" width="550" height="640" loading="lazy" decoding="async" /><div><h3>Share your details</h3><p>For a havan or puja, give your name, gotra, your wish and as many as six family names for the priest to read at the altar. For a satsang or meditation, simply save your seat.</p></div></li>
            <li><img src={IMG.link} alt="" width="384" height="640" loading="lazy" decoding="async" /><div><h3>Pay with UPI</h3><p>The checkout total is exactly what you pay. Prasad delivery, dakshina and chadhava are optional, and you decide on each. Cancel free of charge until 24 hours before the start.</p></div></li>
          </ol>
          <p class="hw-book-note">As soon as you pay, the booking shows up under <b>My events</b> with a countdown to the start.</p>
        </div>
      </section>

      <!-- ON THE DAY -->
      <section class="hw-day hw-wrap" aria-labelledby="day-title">
        <div class="hw-sec-head"><div><h2 id="day-title"><span aria-hidden="true">✽</span>What happens on the day</h2><p>The sequence below is the same for every event type.</p></div></div>
        <div class="hw-day-card">
          <ol class="hw-timeline">
            <li><span class="hw-when">After booking</span><span class="hw-dot" aria-hidden="true"></span><div><b>A confirmation email reaches you</b><span>You will find it under My events too, showing your event's date and time.</span></div></li>
            <li><span class="hw-when">At the time</span><span class="hw-dot" aria-hidden="true"></span><div><b>The temple pujari performs it</b><span>At a havan or puja, the pujari recites the event's sankalp on behalf of every devotee. Our crew films throughout and streams live if the mountain network permits. You don't need to do or tap anything.</span></div></li>
            <li><span class="hw-when">From home</span><span class="hw-dot" aria-hidden="true"></span><div><b>Pray wherever you are</b><span>You may light a lamp at the same hour, join your hands and pray quietly with your family.</span></div></li>
            <li><span class="hw-when">After</span><span class="hw-dot" aria-hidden="true"></span><div><b>The video lands in your inbox</b><span>Download it from that email or from My events at any time. Should snow or a landslide knock out the network, we let you know on WhatsApp and email and send it once our crew returns to the studio. Prasad, if you chose it, is packed that same day.</span></div></li>
          </ol>
          <div class="hw-day-art">
            <img src={IMG.link} alt="" width="384" height="640" loading="lazy" decoding="async" />
            <p class="hw-day-note">No email yet? Look in your spam folder, or open My events.</p>
          </div>
        </div>
      </section>

      <!-- SIT WELL -->
      <section class="hw-sit" aria-labelledby="sit-title">
        <div class="hw-wrap">
          <div class="hw-sec-head"><div><h2 id="sit-title"><span aria-hidden="true">✽</span>Getting ready for each event type</h2><p>A few small preparations help a lot. Treat these as friendly suggestions, not rules.</p></div></div>
          <div class="hw-sit-grid">
            <article class="hw-sit-card hw-sit-card--ritual hw-sit-card--wide">
              <div>
                <div class="hw-tags"><span>Havan</span><span>Puja</span></div>
                <h3>Sit with reverence, and let the mantras ring out</h3>
                <ul>
                  <li>Find a tidy, peaceful spot. Plenty of families gather before their home mandir, but any quiet corner works.</li>
                  <li>Raise the volume or plug in a speaker so everyone in the room hears the mantras clearly.</li>
                  <li>If possible, light a little diya or some incense. When aarti starts, stand or join your hands just as you would at a temple.</li>
                  <li>Silence your phones and sit together as a family. Children are very welcome; the tradition belongs to them as well.</li>
                  <li>The sankalp comes early in the ritual, so be there from the start.</li>
                </ul>
              </div>
              <img src={IMG.namaste} alt="" width="550" height="640" loading="lazy" decoding="async" />
            </article>
            <article class="hw-sit-card hw-sit-card--satsang">
              <div>
                <div class="hw-tags"><span>Satsang</span><span>Sermon</span></div>
                <h3>Headphones in, microphone muted, heart open</h3>
                <ul>
                  <li>Use headphones to hear every word, and leave your microphone on mute.</li>
                  <li>Sit at ease, ideally upright. Keep a notebook close for any line worth remembering.</li>
                  <li>When kirtan begins, sing along quietly. No one else hears you, so sing without holding back.</li>
                </ul>
              </div>
              <img src={IMG.satsang} alt="" width="640" height="531" loading="lazy" decoding="async" />
            </article>
            <article class="hw-sit-card hw-sit-card--meditation">
              <div>
                <div class="hw-tags"><span>Meditation</span></div>
                <h3>A calm room, headphones and no disturbances</h3>
                <ul>
                  <li>Choose a room where nobody will interrupt you for the whole session. Lower the lights and shut the door.</li>
                  <li>Put on headphones and mute your microphone. Switch your phone to Do Not Disturb.</li>
                  <li>Sit on a cushion or chair with a straight back; avoid lying down, as sleep comes easily.</li>
                </ul>
              </div>
              <img src={IMG.meditation} alt="" width="640" height="461" loading="lazy" decoding="async" />
            </article>
          </div>
          <p class="hw-sit-foot">For any event, arrive a few minutes early. Settling in is part of the practice itself.</p>
        </div>
      </section>

      <!-- AFTER -->
      <section class="hw-after hw-wrap" aria-labelledby="after-title">
        <div class="hw-sec-head"><div><h2 id="after-title"><span aria-hidden="true">✽</span>Once the event is over</h2></div></div>
        <div class="hw-after-grid">
          <article class="hw-after-card">
            <svg class="hw-ico" viewBox="0 0 100 100" fill="none" aria-hidden="true"><circle cx="50" cy="50" r="44" fill="#ffe1a2" stroke="#fff" stroke-width="7"/><g stroke="#8c3327" stroke-width="2.7" stroke-linecap="round" stroke-linejoin="round"><rect x="21" y="29" width="58" height="40" rx="6" fill="#fff6e6"/><path d="m44 39 17 10-17 10Z" fill="#ad3028"/><path d="M38 79h24m-12-9v9"/></g></svg>
            <h3>Keep the video</h3>
            <p>All the events you joined remain under My events. Save the full video to your phone, watch it again, or pass it on to relatives who could not be there.</p>
          </article>
          <article class="hw-after-card">
            <svg class="hw-ico" viewBox="0 0 100 100" fill="none" aria-hidden="true"><circle cx="50" cy="50" r="44" fill="#ffe1a2" stroke="#fff" stroke-width="7"/><g stroke="#8c3327" stroke-width="2.7" stroke-linecap="round" stroke-linejoin="round"><path d="M20 77h60M28 74V47h44v27M24 47h52L50 27Z" fill="#d87332"/><path d="M42 76V58a8 8 0 0 1 16 0v18" fill="#fff6e6"/></g></svg>
            <h3>Prasad, delivered</h3>
            <p>Chose prasad with your havan or puja? Dry prasad from the temple is packed that day and couriered anywhere in India, or overseas by international courier. Mountain weather can occasionally slow it down. Follow it from My events.</p>
          </article>
          <article class="hw-after-card">
            <svg class="hw-ico" viewBox="0 0 100 100" fill="none" aria-hidden="true"><circle cx="50" cy="50" r="44" fill="#ffe1a2" stroke="#fff" stroke-width="7"/><g stroke="#8c3327" stroke-width="2.7" stroke-linecap="round" stroke-linejoin="round"><path d="M23 33h54v12c-11 0-11 14 0 14v12H23V59c11 0 11-14 0-14Z" fill="#fff6e6"/><path d="M60 35v6m0 7v6m0 7v7m-24-17 6 6 10-13"/></g></svg>
            <h3>Need some help?</h3>
            <p>The <a href="/help">help centre</a> covers the usual questions, or email <b>support (@) {BRAND.domain}</b>. A real person answers within a day.</p>
          </article>
        </div>
      </section>

      <!-- PROMISE -->
      <section class="hw-promise hw-wrap" aria-labelledby="promise-title">
        <img src={IMG.elephant} alt="" width="1536" height="1024" loading="lazy" decoding="async" />
        <div class="hw-promise-copy"><h2 id="promise-title">Gentle temples, gentle prayers.</h2><p>Every event we hold is benefic. We will never warn that misfortune follows if you don't book, and we promise no outcomes. You should come away lighter, never anxious.</p></div>
        <img class="hw-flip" src={IMG.elephant} alt="" width="1536" height="1024" loading="lazy" decoding="async" />
      </section>

      <!-- FAQ -->
      <section class="hw-faq hw-wrap" aria-labelledby="faq-title">
        <div class="hw-sec-head"><h2 id="faq-title"><span aria-hidden="true">✽</span>Questions families ask</h2></div>
        <div class="hw-faq-box">
          <details open><summary>Must I watch the whole havan or puja?</summary><p>No. It is performed completely whether you watch or not, and we email you the video afterwards to keep.</p></details>
          <details><summary>How will I receive the video?</summary><p>It comes to you by email when the event ends, and you can download it from My events at any time.</p></details>
          <details><summary>Where does my havan or puja take place?</summary><p>At the Himalayan temple named on the event page, performed by the pujari who serves there. Our temples are all positive ones, of Shiva and Parvati, Vishnu, Ram and Sita, Krishna and the gentle Himalayan Devis. See <a href="/temples">Our temples</a>.</p></details>
          <details><summary>What if weather holds up my video or prasad?</summary><p>In the mountains, landslides, snowstorms and heavy rain can knock out the network or block roads. Our crew films the entire ritual regardless and uploads it once back in the studio, and any delay is shared with you on WhatsApp and by email.</p></details>
          <details><summary>What is a gotra, and what if I don't know it?</summary><p>Your gotra is your family lineage. An elder may know it; if no one does, our priests follow custom and use "Kashyap", just as any temple would. Leaving it blank is fine too.</p></details>
          <details><summary>Can relatives in another city watch too?</summary><p>Yes. Send the video to family members wherever they live.</p></details>
          <details><summary>Can I speak to the priest or speaker during the event?</summary><p>Microphones remain muted so everyone hears the mantras and the talk clearly. At a havan or puja the sankalp covers everyone; for a satsang, email us your question ahead of time.</p></details>
          <details><summary>Is the card price what I finally pay?</summary><p>Cards show a "starting from" price. At checkout you add any extras you want (prasad delivery, dakshina, chadhava) and see the full amount, GST included, before paying.</p></details>
        </div>
      </section>

      <p class="hw-note">Each ritual is performed with devotion by the pujari of one of our partner temples. Benefits described are those traditionally sought by devotees; {BRAND.name} makes no claims of guaranteed outcomes.</p>
    </main>
    <SiteFooter folk indiaLandingLanguage={false} />
  </div>
</Base>
