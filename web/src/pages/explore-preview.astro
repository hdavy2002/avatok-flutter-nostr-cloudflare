---
export const prerender = true;
import brandConfig from '../../../Specs/brand.json';
import { publicImage } from '../lib/config';
import { profiles } from '../lib/callvaalHomeReference';
import ExplorePreviewCard from '../components/callvaal/ExplorePreviewCard.astro';
import Header from '../components/callvaal/Header.astro';
import Footer from '../components/callvaal/Footer.astro';
import '../styles/desi-home.css';
import '../styles/desi-home-chrome.css';
import '../styles/explore-preview.css';
const identity = brandConfig.homepageIdentity;
const title = `Explore concept | ${identity.name}`;
const metas = [
  { platform: 'Instagram', topic: 'Lifestyle', handle: '@neha.talks' },
  { platform: 'YouTube', topic: 'Education', handle: '@priya.speaks' },
  { platform: 'Instagram', topic: 'Fashion', handle: '@sana.stories' },
  { platform: 'Facebook', topic: 'Wellness', handle: '@kavya.life' },
  { platform: 'YouTube', topic: 'Music', handle: '@ananya.music' },
  { platform: 'YouTube', topic: 'Gaming', handle: '@rohan.plays' },
  { platform: 'Instagram', topic: 'Music', handle: '@arjun.notes' },
  { platform: 'YouTube', topic: 'Travel', handle: '@dev.travels' },
];
const creators = profiles.map((profile, index) => ({ profile, ...metas[index]! }));
const heroPhoto = '/assets/callvaal/scrapbook/portrait-7.png';
const toran = `url(${publicImage('/assets/hf-desi/toran-marigold.webp', { width: 1400, quality: 70, fit: 'scale-down' })})`;
const strip = `url(${publicImage('/assets/hf-desi/border-strip.webp', { width: 1400, quality: 70, fit: 'scale-down' })})`;
const tile = `url(${publicImage('/assets/hf-desi/block-print-tile.webp', { width: 420, quality: 70, fit: 'scale-down' })})`;
---
<!doctype html>
<html lang="en-IN">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title><meta name="description" content={`A local design preview for the ${identity.name} creator marketplace.`} /><meta name="robots" content="noindex,nofollow" /><meta name="theme-color" content="#fff2cf" />
  <link rel="icon" href="/assets/branding/hf-favicon.png" type="image/png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Comfortaa:wght@500;700&family=Nunito:wght@400;600;700;800;900&display=swap" />
  <style is:inline define:vars={{toran,strip,tile}}></style>
</head>
<body class="desi-home-page ex-page">
<div class="hf desi-home ex-preview">
  <a class="skip-link" href="#main-content">Skip to main content</a>
  <Header homeReference />
  <main id="main-content">
    <div class="ex-toran" aria-hidden="true"></div>
    <section class="ex-hero">
      <div class="ex-wrap ex-hero-grid">
        <div class="ex-hero-copy">
          <span class="eyebrow">Explore · reel se real tak</span>
          <h1 class="disp">Find influencers.<br /><span class="ex-highlight">Watch. Connect.</span><br />Talk.</h1>
          <p>A first look at a video-led space to discover creators, watch their clips and book a private conversation.</p>
          <form class="ex-search" role="search" autocomplete="off">
            <label for="ex-query" class="sr-only">Search sample creators, handles, topics or languages</label>
            <span aria-hidden="true">⌕</span><input id="ex-query" type="search" placeholder="Search creators, handles, topics..." aria-controls="ex-suggestions" aria-expanded="false" />
            <button type="submit">Search</button>
            <div class="ex-suggestions" id="ex-suggestions" hidden></div>
          </form>
          <p class="ex-trust">✦ Sample creators & prices <span aria-hidden="true">·</span> ✦ Private-number calls <span aria-hidden="true">·</span> ✦ 18+ only</p>
        </div>
        <div class="ex-hero-art" aria-hidden="true">
          <div class="ex-hero-sun"></div>
          <div class="ex-hero-portrait"><img src={publicImage(heroPhoto, { width: 700 })} alt="" width="700" height="700" fetchpriority="high" /></div>
          <img class="ex-hero-sticker" src={publicImage('/assets/hf-desi/sticker-reels-se-real.webp', { width: 360 })} alt="" width="360" height="280" />
          <span class="ex-hero-scribble">Real people.<br />Real baatein.</span>
        </div>
      </div>
    </section>
    <div class="ex-strip" aria-hidden="true"></div>
    <section class="ex-discover">
      <div class="ex-wrap">
        <div class="ex-section-heading"><div><span class="eyebrow">Apni vibe dhundo</span><h2 class="disp">What are you into?</h2></div><p>One tap gets you closer to the creators and conversations you enjoy.</p></div>
        <div class="ex-category-row" aria-label="Browse by category">
          {['All','Lifestyle','Fashion','Beauty','Food','Travel','Comedy','Music','Fitness','Gaming','Education','Spirituality','Wellness'].map((category, index) => <button type="button" class:list={['ex-category', `ex-category--${index % 4}`]} data-category-button={category.toLowerCase()} aria-pressed={index === 0 ? 'true' : 'false'}><span aria-hidden="true">{['✦','☀','❀','✿','◒','➝','☺','♫','✹','✸','✎','✧','♥'][index]}</span>{category}</button>)}
        </div>
      </div>
    </section>
    <section class="ex-market" id="people">
      <div class="ex-wrap">
        <div class="ex-market-heading"><div><span class="eyebrow">Scroll. Spot. Say hello.</span><h2 class="disp">Meet the creators.</h2><p>Tap a card to see how discovery and booking could feel.</p></div><img src={publicImage('/assets/hf-desi/sticker-kya-scene-hai.webp', { width: 320 })} alt="" width="320" height="240" loading="lazy" /></div>
        <div class="ex-controls" aria-label="Explore filters">
          <label>Platform<select id="ex-platform"><option value="">All platforms</option><option>Instagram</option><option>YouTube</option><option>Facebook</option></select></label>
          <label>Language<select id="ex-language"><option value="">Any language</option><option>Hindi</option><option>English</option><option>Marathi</option><option>Kannada</option></select></label>
          <label>Gender<select id="ex-gender"><option value="">Any gender</option><option value="woman">Woman</option><option value="man">Man</option></select></label>
          <label>Availability<select id="ex-availability"><option value="">Any time</option><option value="online">Online now</option><option value="busy">On a call</option><option value="offline">Offline</option></select></label>
          <label>Min price<select id="ex-min-price"><option value="">Any minimum</option><option value="20">₹20/min</option><option value="25">₹25/min</option><option value="30">₹30/min</option></select></label>
          <label>Max price<select id="ex-price"><option value="">Any maximum</option><option value="20">Up to ₹20/min</option><option value="25">Up to ₹25/min</option><option value="30">Up to ₹30/min</option></select></label>
          <label>Sort<select id="ex-sort"><option value="recommended">Recommended</option><option value="price-low">Price: low to high</option><option value="price-high">Price: high to low</option><option value="name">Name A–Z</option></select></label>
          <button class="ex-clear" type="button" id="ex-clear">Clear filters</button>
        </div>
        <p class="ex-sample-note">Design samples only: portraits, handles, availability and prices are illustrative. Video and booking controls show the proposed flow.</p>
        <div class="ex-viewbar"><p id="ex-results" role="status" aria-live="polite">8 sample creators</p><div class="ex-view-toggle" role="group" aria-label="View mode"><button type="button" data-view="grid" aria-pressed="true">Grid</button><button type="button" data-view="reels" aria-pressed="false">Reels</button><button type="button" data-view="list" aria-pressed="false">List</button></div></div>
        <section class="ex-creator-section" data-ex-section aria-labelledby="ex-featured"><div class="ex-subheading"><div><span aria-hidden="true">✦</span><h3 id="ex-featured">Featured creators</h3></div><span>Fresh faces, familiar feeling</span></div><div class="ex-card-grid" data-ex-grid>{creators.slice(0,5).map((creator, index) => <ExplorePreviewCard {...creator} label={index === 0 ? 'Featured' : undefined} />)}</div></section>
        <section class="ex-creator-section" data-ex-section aria-labelledby="ex-popular"><div class="ex-subheading"><div><span aria-hidden="true">✹</span><h3 id="ex-popular">Popular right now</h3></div><span>More stories to explore</span></div><div class="ex-card-grid" data-ex-grid>{creators.slice(5).map(creator => <ExplorePreviewCard {...creator} />)}</div></section>
        <p class="ex-empty" id="ex-empty" hidden>No sample creators match those filters. Try another search.</p>
      </div>
    </section>
    <div class="ex-strip" aria-hidden="true"></div>
    <section class="ex-now"><div class="ex-wrap ex-now-grid"><div><span class="eyebrow">Available for calls</span><h2 class="disp">Baat abhi?</h2><p>In the finished experience, this lane will use real availability from connected influencers. For now, tap a sample name to see the booking idea.</p><button type="button" class="ex-dark-button" id="ex-show-online">See online samples <span aria-hidden="true">↗</span></button></div><div class="ex-now-list">{creators.filter(item => item.profile.availability === 'online').slice(0,3).map(item => <button type="button" class="ex-now-item" data-book={item.profile.id} data-name={item.profile.name} data-price={item.profile.price} data-availability="online"><img src={publicImage(`/assets/callvaal/scrapbook/${item.profile.portrait}`, { width: 160 })} alt="" width="80" height="80" loading="lazy" /><span><strong>{item.profile.name}</strong><small>{item.topic} · {item.profile.languages}</small></span><b>₹{item.profile.price}/min ↗</b></button>)}</div></div></section>
    <section class="ex-new"><div class="ex-wrap ex-new-grid"><div><span class="eyebrow">New on the scene</span><h2 class="disp">Naye chehre.<br /><span class="ex-highlight">Nayi baatein.</span></h2><p>A space for creators who have just joined and connected their social accounts.</p><button type="button" class="ex-light-button" id="ex-show-new">Explore sample creators <span aria-hidden="true">↗</span></button></div><img src={publicImage('/assets/hf-desi/train-creators.webp', { width: 900 })} alt="Illustrated train of creators in Indian folk-art style" width="900" height="460" loading="lazy" /></div></section>
    <div class="ex-footer-toran" aria-hidden="true"></div>
  </main>
  <div class="ex-mobile-cta"><span>Sample call · from ₹20/min</span><button type="button" data-book="neha" data-name="Neha" data-price="20" data-availability="online">Book call ↗</button></div>
  <Footer />
</div>
<dialog id="ex-booking" class="ex-booking" aria-labelledby="ex-booking-title"><div class="ex-booking-inner"><button type="button" class="ex-close" data-close-booking aria-label="Close booking preview">×</button><span class="eyebrow">Booking preview · no payment</span><h2 id="ex-booking-title">A call with <span id="ex-booking-name">a creator</span></h2><p class="ex-booking-note">This is a design demo. No call, schedule, payment or notification will be created.</p><div class="ex-step-indicator" aria-label="Booking progress"><span data-step-indicator="1">1 Choose</span><span data-step-indicator="2">2 Review</span><span data-step-indicator="3">3 Finish</span></div><div data-booking-step="1"><h3>How would you like to talk?</h3><div class="ex-book-options"><button type="button" data-call-choice="now">Call now <small>Only when the creator is available</small></button><button type="button" data-call-choice="schedule">Schedule <small>Choose a time later</small></button></div><button type="button" class="ex-next" data-booking-next>Continue</button></div><div data-booking-step="2" hidden><h3>Review your sample call</h3><label>Duration<select id="ex-duration"><option value="5">5 minutes</option><option value="10" selected>10 minutes</option><option value="15">15 minutes</option></select></label><label id="ex-schedule-label">Preferred time<input id="ex-schedule-time" type="datetime-local" /></label><p class="ex-review" id="ex-review"></p><p class="ex-booking-note">Taxes and cancellation terms would be shown here before a real payment.</p><div class="ex-book-actions"><button type="button" data-booking-back>Back</button><button type="button" class="ex-next" data-booking-next>See finish state</button></div></div><div data-booking-step="3" hidden><h3>Design preview complete ✦</h3><p>No booking was placed or paid for. In the live journey, this step will show the confirmed call details.</p><button type="button" class="ex-next" data-close-booking>Done</button></div></div></dialog>
<dialog id="ex-video-dialog" class="ex-video-dialog"><button type="button" data-close-video aria-label="Close video preview">×</button><h2>Video preview concept</h2><p id="ex-video-copy">A connected creator’s authorized Instagram, YouTube or Facebook embed would play here with its original platform controls. This sample portrait is not a video.</p><button type="button" data-close-video>Got it</button></dialog>
<script>import '../lib/explorePreview';</script>
</body>
</html>