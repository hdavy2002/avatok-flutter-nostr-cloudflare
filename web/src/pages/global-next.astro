---
export const prerender = true;
import Base from '../layouts/Base.astro';
import { publicImage } from '../lib/config';
import GlobalHeader from '../components/GlobalHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import content from '../content/disco-landing.html?raw';
import '../styles/disco-landing.css';
// This is repository-authored HTML, not user content. Retain every attribute;
// route its public raster references through the same hashed image policy.
const imageContent = content.replace(/<img\b[^>]*>/g, tag =>
  tag.replace(/\bsrc="([^"]+)"/, (_attribute, source: string) =>
    `src="${publicImage(source, { width: tag.includes('fetchpriority="high"') ? 1280 : 640, fit: 'scale-down' })}"`));
---
<Base title="Your people. Your moment. Your income. · avaTOK" description="A marketplace for creators and their biggest fans. Host paid live streams, book private 1:1 video meetups, and explore local payouts with avaTOK." chrome={false} noindex={true} image="/assets/global-original/hero-source.png">
  <GlobalHeader design="disco" homePath="/global-next" />
  <Fragment set:html={imageContent} />
  <SiteFooter variant="global" />
</Base>
