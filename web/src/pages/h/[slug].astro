---
// [HF-HOST-PLATFORM-1 2026-10-09] Public page of a real, approved host: /h/<slug>.
// SSR (prerender = false): GET /api/hosts/public/:slug is fetched here so the HTML is complete for search and share.
// [HF-CHANNEL-WEB-1 2026-10-23] Rebuilt as the "Galli Pop" channel page (owner-approved mock): hero (photo + information, no decorative border),
// sticky section nav, MERCH first, "Now Showing" videos, inline booking calendar, About, Reviews, "Before you call". Skin: styles/hf-channel.css (.gp).
// Every photo on this page is AI-generated from an avatar the host chose, and is labelled so. The voice introduction is the host's OWN recording (admin-approved).
// Flag hostsPublicEnabled off -> the API answers 404 -> this page is a friendly 404 (noindex).
export const prerender = false;
import Base from '../../layouts/Base.astro';
import brandConfig from '../../../../Specs/brand.json';
import { API_BASE, publicImage } from '../../lib/config';
import { moods } from '../../lib/callvaalHomeReference';
import HostCallActions from '../../islands/calls/HostCallActions';
import SaveHostButton from '../../components/hosts/SaveHostButton';
import { relDate } from '../../lib/hfCallsApi';
import { SAME_RATE_LINE, chargeForSeconds, stdRateLabel, type PriceTier } from '../../lib/hfStdPlan';
import { formatPaise } from '../../lib/money';
import { langLabels } from '../../lib/hfLanguages'; // [HF-DAILY-FLOWS-1]
import { brandUrl } from '../../lib/brand';
import { fetchMerchHost } from '../../lib/merchPublic';
import { profileJsonLd } from '../../lib/merchSeo';
import { artUrl, ART_DIMS } from '../../lib/hfChannelArt';
import { compact, langTag, splitName, type ChannelReel } from '../../lib/channelKit';
import MerchGrid from '../../islands/channel/MerchGrid';
import VideoPlayer from '../../islands/channel/VideoPlayer';
import InlineBooking from '../../islands/channel/InlineBooking';
import BagDrawer from '../../islands/channel/BagDrawer';
import { VoiceIntro, ShareButton } from '../../islands/channel/HeroBits';
import Sticker from '../../components/channel/Sticker.astro';
import type { PublicContent } from '../../lib/seo/types';
import '../../styles/hf-channel.css';

interface Card {
  slug: string; displayName: string; tagline: string | null; avatarUrl: string | null; languages: string[]; style: string | null; topics: string[];
  /** [HF-STD-PLAN-1] pricePerMin is a number and may be fractional (3.99). */
  pricePerMin: number; pricePaisePerMin?: number; priceLabel?: string; priceTiers?: PriceTier[]; plan?: string; lgbtqFriendly: boolean;
  introAudioUrl: string | null; introSeconds: number | null; introMime: string | null;
  aboutPolished: string | null; about?: string | null; quote: string | null;
  /** [HF-DAILY-FLOWS-1] The influencer's visible reels (embeds only: we link out, never host the video). Absent while the reels flag is off. */
  reels?: { id: string; platform: string; url: string; embedUrl?: string | null; thumbUrl: string | null; title: string | null; views?: number | null }[];
  followers?: number; handle?: string | null;
  gallery: { url: string; caption: string | null }[];
  /** [HF-CALLS-1] presence + public rating aggregates (reviews agent) */
  status?: 'online' | 'busy' | 'offline'; womenOnly?: boolean;
  identityVerified?: boolean; callEligible?: boolean;
  rating?: number | null; reviewCount?: number; ratingBreakdown?: Record<'5' | '4' | '3' | '2' | '1', number>; talkedTo?: number; regulars?: number;
  reviews?: { firstName: string; stars: number; text: string; topic: string | null; minutes: number | null; regular: boolean; date: string | number }[];
}
const STYLE_LABEL: Record<string, string> = {
  warm: 'Steady & encouraging', energetic: 'Cheerful & chatty', calm: 'Calm listener',
  playful: 'Funny & light', straightforward: 'Straight-talking', thoughtful: 'Gentle & patient',
};

const identity = brandConfig.homepageIdentity;
const { slug } = Astro.params;
let host: Card | null = null;
if (slug && /^[a-z0-9-]{3,40}$/.test(slug)) {
  try {
    const res = await fetch(`${API_BASE}/api/hosts/public/${slug}`, { headers: { accept: 'application/json' } });
    if (res.ok) host = (await res.json()) as Card;
  } catch (err) {
    console.warn('[HF-HOST-PLATFORM-1] influencer profile fetch failed', err instanceof Error ? err.message : String(err));
  }
}
// [HF-MERCH-FAN-WEB-1] Live merch of this influencer. null while the merch feature is off, so no strip appears.
const merch = host ? await fetchMerchHost(host.slug) : null;
const merchProducts = merch?.products ?? [];
if (!host) Astro.response.status = 404;
else Astro.response.headers.set('cache-control', 'public, max-age=60');

const moodLabel = (s: string) => moods.find(m => m.slug === s)?.label ?? s;
const name = host?.displayName ?? '';
const paisePerMin = host?.pricePaisePerMin ?? Math.round(Number(host?.pricePerMin ?? 0) * 100);
const standard = host?.plan === 'standard';
const rateLabel = standard ? (host?.priceLabel || stdRateLabel(paisePerMin || undefined)) : `₹${Number(host?.pricePerMin ?? 0).toLocaleString('en-IN')}/min`;
const tenMin = standard ? formatPaise(chargeForSeconds(host?.priceTiers, 600)) : null;
const topics = (host?.topics ?? []).map(moodLabel);
const langs = langLabels(host?.languages);
const reels = (host?.reels ?? []).filter(r => r && typeof r.url === 'string' && /^https:\/\//.test(r.url)).slice(0, 12);
const reviewCount = host?.reviewCount ?? 0;
const rating = host?.rating ?? null;
const reviews = host?.reviews ?? [];
const talkedTo = host?.talkedTo ?? 0;
const identityVerified = host?.identityVerified === true;
const callEligible = identityVerified && host?.callEligible === true;
const callHost = host && callEligible ? { slug: host.slug, displayName: host.displayName, pricePerMin: host.pricePerMin, pricePaisePerMin: paisePerMin || undefined, priceTiers: host.priceTiers, plan: host.plan, status: host.status ?? 'offline', womenOnly: !!host.womenOnly } : null;
const audioUrl = host?.introAudioUrl ?? null;
const description = host ? `${name} on ${identity.name}. ${host.tagline ?? 'A real person to talk to, in your language.'} From ${rateLabel}. Your number stays private.` : 'This influencer page is not available.';
// [HF-MERCH-FAN-WEB-1] Public-page discovery: an indexable record (canonical, share image) plus ProfilePage + Person JSON-LD.
const seoContent: PublicContent | undefined = host ? {
  kind: 'page', key: `h/${host.slug}`, canonicalPath: `/h/${host.slug}`, title: `${name} — talk to a real person`, summary: description, visibility: 'public',
  image: host.avatarUrl ? { url: host.avatarUrl, alt: `${name}, an AI avatar chosen by the influencer` } : undefined,
  breadcrumbs: [{ name: 'Home', path: '/' }, { name: 'Explore', path: '/marketplace' }, { name, path: `/h/${host.slug}` }],
} : undefined;
const jsonLd = host ? [profileJsonLd({ slug: host.slug, name, description: host.tagline ?? description, imageUrl: host.avatarUrl, rating: reviewCount > 0 ? rating : null, reviewCount })] : [];

// ---- [HF-CHANNEL-WEB-1] view model for the channel page ----
const [firstName, restName] = splitName(name);
const rateMatch = /^(.*?)(\/min)$/.exec(rateLabel);
const rateBig = rateMatch ? rateMatch[1] : rateLabel;
const rateSmall = rateMatch ? rateMatch[2] : '';
const statusNow = host?.status ?? 'offline';
const badgeText = !callEligible ? 'Calls unavailable' : statusNow === 'online' ? 'Online now' : statusNow === 'busy' ? 'On a call' : 'Offline';
const badgeClass = !callEligible || statusNow === 'offline' ? 'cv-status-offline' : statusNow === 'busy' ? 'cv-status-busy' : '';
const stats: { b: string; s: string }[] = [];
if (reviewCount > 0 && rating != null) stats.push({ b: `${rating.toFixed(1)}★`, s: `${reviewCount} ${reviewCount === 1 ? 'review' : 'reviews'}` });
if (talkedTo > 0) stats.push({ b: String(talkedTo), s: talkedTo === 1 ? 'person talked to' : 'people talked to' });
if (host?.followers && host.followers > 0) stats.push({ b: compact(host.followers), s: 'followers' });
const tags = (host?.languages ?? []).map(langTag).filter(Boolean);
if (tags.length) stats.push({ b: [...new Set(tags)].slice(0, 3).join(' · '), s: 'languages' });
const eyebrow = `Creator${topics[0] ? ` · ${topics[0]}` : ''}`;
const merchOn = !!(merch && merchProducts.length > 0);
const channelReels: ChannelReel[] = reels.slice(0, 24).map(r => ({ id: r.id, platform: r.platform, url: r.url, embedUrl: r.embedUrl ?? null, thumbUrl: r.thumbUrl, title: r.title, views: r.views ?? null }));
const bookOn = !!callHost; // the calendar itself hides when bookings are switched off
const bandArt = artUrl('bandTruck');
const showArt = artUrl('nowShowingBg');
const noPhotoArt = artUrl('noPhoto');
const heroFallback = noPhotoArt ? `this.onerror=null;this.removeAttribute('fetchpriority');this.alt='';this.src='${noPhotoArt}';var a=this.parentElement&&this.parentElement.querySelector('.ai');if(a)a.remove()` : undefined;
const emptyMerchArt = artUrl('emptyMerch');
// Merch feature on but nothing live yet: show the 'coming soon' art instead of hiding the section.
const merchSoon = !!(merch && merchProducts.length === 0);
const aboutText = host?.aboutPolished || host?.about || '';
const aboutPlain = aboutText ? aboutText.replace(/\s+/g, ' ').trim() : '';
const pageUrl = host ? brandUrl(`/h/${host.slug}`) : '';
const navItems = [
  ...(merchOn ? [{ id: 'merch', label: 'Merch', count: merchProducts.length }] : merchSoon ? [{ id: 'merch', label: 'Merch', count: null }] : []),
  ...(channelReels.length ? [{ id: 'videos', label: 'Videos' }] : []),
  ...(bookOn ? [{ id: 'book', label: 'Book a time' }] : []),
  { id: 'about', label: 'About' },
  { id: 'reviews', label: 'Reviews' },
] as { id: string; label: string; count?: number }[];
---
<Base title={host ? `${name} — talk to a real person | ${identity.name}` : `Influencer not found | ${identity.name}`} description={description} image={host?.avatarUrl ?? undefined} noindex={!host} keywords="" lang="en-IN" content={seoContent} extraJsonLd={jsonLd} ogType={host ? 'profile' : 'website'} bag>
  <Fragment slot="head"><meta name="theme-color" content="#fff9f0" /></Fragment>
  {!host ? (
    <div class="gp">
      <main class="sec" id="profile-main"><div class="wrap gone">
        <p class="eyebrow">Not found</p>
        <h1>We could not find this influencer</h1>
        <p class="sub" style="margin-bottom:22px">The page may have moved, or the influencer is not taking calls right now. See everyone who is.</p>
        <a class="btn btn-r" href="/marketplace">Explore influencers</a>
      </div></main>
    </div>
  ) : (
    <div class="gp has-pbar" id="gp-root" data-host-slug={host.slug} data-merch={merchProducts.length} data-reels={channelReels.length} data-call={callHost ? '1' : '0'} data-status={statusNow}>
      <main id="profile-main">
        <section class="hero" aria-labelledby="nm">
          <div class="wrap hero-grid">
            <div class="photo-wrap">
              <div class="colorblock" aria-hidden="true"></div>
              <div class="photo">
                {host.avatarUrl ? <img src={publicImage(host.avatarUrl, { width: 1200 })} width="1200" height="1500" alt={`${name}, an AI avatar chosen by the influencer`} fetchpriority="high" decoding="async" onerror={heroFallback} /> : noPhotoArt ? <img src={noPhotoArt} width={ART_DIMS.noPhoto.w} height={ART_DIMS.noPhoto.h} alt="" decoding="async" /> : <span class="initial" aria-hidden="true">{firstName.charAt(0).toUpperCase()}</span>}
                <span class={`cv-online ${badgeClass}`.trim()}><span aria-hidden="true"></span>{badgeText}</span>
                {/* [HF-PROFILE-AI-LABEL-OFF-1 2026-10-24] owner: no visible 'AI avatar' label on the photo */}
              </div>
            </div>
            <div class="info">
              <p class="eyebrow">{eyebrow}</p>
              <h1 id="nm">{firstName}{restName && <>{' '}<br />{restName}</>}</h1>
              {host.tagline && <p class="tag">{host.tagline}</p>}
              {stats.length > 0 && <div class="stats">{stats.map(x => <div class="stat"><b>{x.b}</b><span>{x.s}</span></div>)}</div>}
              <div class="ratecard">
                <div class="rate">{rateBig}{rateSmall && <small>{rateSmall}</small>}</div>
                <div class="acts">
                  {callHost ? <HostCallActions client:idle variant="rail" refresh host={callHost} callLabel="Call now" bookHref="#book" /> : <p role="status" style="font-size:15px;color:var(--muted)">Calls and bookings are unavailable for this profile.</p>}
                </div>
                {tenMin && <p class="est">10 min ≈ {tenMin}</p>}
                {standard && <p class="est">{SAME_RATE_LINE}</p>}
              </div>
              <p class="priv"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>Your number stays private. Calls are bridged through {identity.name}.</p>
              <div class="actrow">
                {audioUrl && <VoiceIntro client:visible src={audioUrl} seconds={host.introSeconds ?? null} name={name} />}
                <SaveHostButton client:only="react" slug={host.slug} name={host.displayName} surface="profile" variant="icon" />
                <ShareButton client:idle url={pageUrl} text={`Talk to ${name}`} />
              </div>
            </div>
          </div>
        </section>

        <nav class="snav" aria-label="Sections"><div class="wrap">
          {navItems.map((it, i) => <a class={i === 0 ? 'on' : ''} href={`#${it.id}`} aria-current={i === 0 ? 'location' : undefined}>{it.label}{it.count != null && <span class="count">{it.count}</span>}</a>)}
        </div></nav>

        {merchOn && <>
          <section class="sec" id="merch" aria-labelledby="mh">
            <div class="wrap">
              <div class="sec-h">
                <div><p class="eyebrow">The merch shop</p><h2 class="h2" id="mh">{firstName}’s <span class="paint">drop</span></h2><p class="sub" style="margin-top:8px">Printed to order for you. Price includes GST and free delivery across India.</p></div>
                <Sticker k="merch" />
              </div>
              <MerchGrid client:load host={{ slug: host.slug, displayName: name }} products={merchProducts} />
            </div>
          </section>
          <div class={`band${bandArt ? ' art' : ''}`} aria-hidden="true" style={bandArt ? `background-image:url(${bandArt})` : undefined}></div>
        </>}

        {merchSoon && <>
          <section class="sec" id="merch" aria-labelledby="mh">
            <div class="wrap soon">
              <p class="eyebrow">The merch shop</p>
              <h2 class="h2" id="mh">Merch coming soon</h2>
              <p class="sub" style="margin-top:8px">{firstName} is cooking up something. Check back soon.</p>
              {emptyMerchArt && <img class="soon-img" src={emptyMerchArt} width={ART_DIMS.emptyMerch.w} height={ART_DIMS.emptyMerch.h} alt="" loading="lazy" decoding="async" />}
            </div>
          </section>
          <div class={`band${bandArt ? ' art' : ''}`} aria-hidden="true" style={bandArt ? `background-image:url(${bandArt})` : undefined}></div>
        </>}

        {channelReels.length > 0 && (
          <section class={`sec show${showArt ? ' art' : ''}`} id="videos" aria-labelledby="vh" style={showArt ? `background-image:url(${showArt})` : undefined}>
            <div class="wrap">
              <div class="sec-h">
                <div><p class="eyebrow">Videos</p><h2 class="h2 poster-title" id="vh">Now Showing</h2></div>
                <Sticker k="videos" />
              </div>
              <VideoPlayer client:visible hostSlug={host.slug} hostName={name} reels={channelReels} />
            </div>
          </section>
        )}

        {bookOn && <>
          <section class="sec" id="book" aria-labelledby="bh">
            <div class="wrap book-grid">
              <div>
                <p class="eyebrow">Book a time</p>
                <h2 class="h2" id="bh">Pick a slot.<br />Skip the wait.</h2>
                <p class="sub" style="margin:16px 0 22px">Choose a day and time. {firstName} confirms it, and you pay only after they say yes.</p>
                <div style="display:flex;gap:10px;flex-wrap:wrap"><span class="chip">{rateLabel}</span><span class="chip">India time</span></div>
                <div style="margin-top:30px"><Sticker k="booking" /></div>
              </div>
              <InlineBooking client:idle hostSlug={host.slug} hostName={name} paisePerMin={paisePerMin} plan={host.plan} priceTiers={host.priceTiers} />
            </div>
          </section>
          <div class={`band${bandArt ? ' art' : ' rick'}`} data-book-band aria-hidden="true" style={bandArt ? `background-image:url(${bandArt})` : undefined}></div>
        </>}

        <section class="sec" id="about" aria-labelledby="ah" style="background:#fff">
          <div class="wrap about-grid">
            <div>
              <p class="eyebrow">About</p>
              <h2 class="h2" id="ah" style="margin-bottom:22px">Meet {firstName}</h2>
              {host.quote && <p class="quote">“{host.quote}”</p>}
              {aboutPlain && <p class="sub" style={host.quote ? 'margin-top:18px;max-width:640px' : 'max-width:640px;font-size:clamp(18px,1.4vw,22px)'}>{aboutPlain}</p>}
              {topics.length > 0 && <>
                <p class="nun" style="margin:28px 0 12px">Let’s talk about</p>
                <div style="display:flex;gap:10px;flex-wrap:wrap">{topics.map(t => <span class="chip">{t}</span>)}</div>
              </>}
            </div>
            <div class="facts">
              {langs.length > 0 && <div class="fact"><span class="ic" aria-hidden="true">🗣︎</span><span><b>Languages</b>{langs.join(', ')}</span></div>}
              {host.style && <div class="fact"><span class="ic" aria-hidden="true">☕︎</span><span><b>Style</b>{STYLE_LABEL[host.style] ?? host.style}</span></div>}
              {host.lgbtqFriendly && <div class="fact"><span class="ic" aria-hidden="true">🌈︎</span><span><b>Welcome</b>LGBTQ+ friendly</span></div>}
              {identityVerified && <div class="fact"><span class="ic" aria-hidden="true">✓</span><span><b>Verified</b>WhatsApp number verified by OTP</span></div>}
              <div class="fact"><span class="ic" aria-hidden="true">🔒︎</span><span><b>Private</b>Numbers never shared</span></div>
            </div>
          </div>
        </section>

        <section class="sec" id="reviews" aria-labelledby="rh">
          <div class="wrap rev-grid">
            <div>
              <p class="eyebrow">Reviews</p>
              {reviewCount > 0 && rating != null ? <>
                <p class="bigr" id="rh">{rating.toFixed(1)}</p>
                <p class="stars" style="font-size:22px" role="img" aria-label={`${rating.toFixed(1)} out of 5 stars`}>{'★'.repeat(Math.round(rating))}{'☆'.repeat(5 - Math.round(rating))}</p>
                <p class="sub">{reviewCount} {reviewCount === 1 ? 'review' : 'reviews'}{talkedTo > 0 && <> · {talkedTo} {talkedTo === 1 ? 'person' : 'people'}</>}</p>
              </> : <h2 class="h2" id="rh" style="font-size:clamp(30px,3vw,44px)">No reviews yet</h2>}
              <div style="margin-top:22px"><Sticker k="reviews" /></div>
            </div>
            {reviewCount > 0 && reviews.length > 0
              ? <div class="revs">{reviews.map(r => <div class="rev"><b class="nun">{r.firstName || 'A caller'}</b> <span class="stars" role="img" aria-label={`${r.stars} out of 5 stars`}>{'★'.repeat(r.stars)}{'☆'.repeat(5 - r.stars)}</span>{r.text && <p>{r.text}</p>}<p style="font-size:13px;color:var(--muted)">{[r.topic ? moodLabel(r.topic) : '', r.minutes ? `${r.minutes} min call` : '', relDate(r.date)].filter(Boolean).join(' · ')}</p></div>)}</div>
              : <p class="empty">Be the first to talk to {firstName} and tell others how it went.</p>}
          </div>
        </section>

        <section class="sec" aria-labelledby="ruh" style="padding-top:0">
          <div class="wrap">
            <h2 class="h2" id="ruh" style="font-size:clamp(28px,3vw,36px);margin-bottom:22px">Before you call</h2>
            <div class="rules3">
              <div class="r3"><span class="n">01</span><h3>Just a conversation</h3><p>No professional advice or promised results.</p></div>
              <div class="r3"><span class="n">02</span><h3>Keep it friendly</h3><p>18+ only. Be kind and respectful; abusive or sexual talk is not allowed and gets reported.</p></div>
              <div class="r3"><span class="n">03</span><h3>Pay only for talk time</h3><p>Charged per minute only while you are connected. Ringing, a missed or a declined call costs ₹0.</p></div>
            </div>
            <p class="note">Yahan sirf baat hoti hai. No medical, legal or money advice. Not a replacement for a doctor or counsellor. In crisis, call Tele-MANAS 14416 or 112. 18+ only.</p>
          </div>
        </section>
      </main>

      <div class="pbar" aria-label="Call options">
        <div class="rate">{rateBig}{rateSmall && <small>{rateSmall}</small>}</div>
        <div class="acts3">{callHost ? <HostCallActions client:idle variant="bar" host={callHost} callLabel="Call now" bookHref="#book" /> : <span style="font-size:14px;color:var(--muted)">Calls unavailable</span>}</div>
      </div>
      <BagDrawer client:load checkoutEnabled={merch?.checkoutEnabled === true} />
    </div>
  )}
</Base>
<script>
  import { capture } from '../../lib/analytics';
  const root = document.getElementById('gp-root');
  if (root) {
    const gp = root;
    // The shared site header is sticky: the section nav sits right under it.
    const hdr = () => { const h = document.querySelector<HTMLElement>('.cv-header'); if (h) gp.style.setProperty('--hdr', `${Math.round(h.getBoundingClientRect().height)}px`); };
    hdr(); window.addEventListener('resize', hdr); window.addEventListener('load', hdr);
    const hdrEl = document.querySelector('.cv-header');
    if (hdrEl && 'ResizeObserver' in window) new ResizeObserver(hdr).observe(hdrEl);
    void document.fonts?.ready.then(hdr);
    capture('channel_viewed', { host_slug: gp.dataset.hostSlug, merch_count: Number(gp.dataset.merch) || 0, reels_count: Number(gp.dataset.reels) || 0, call_eligible: gp.dataset.call === '1', status: gp.dataset.status, utm_medium: new URLSearchParams(location.search).get('utm_medium') ?? undefined });
    // Highlight the section being read.
    const links = [...gp.querySelectorAll<HTMLAnchorElement>('.snav a[href^="#"]')];
    const map = new Map<Element, HTMLAnchorElement>();
    links.forEach(a => { const el = document.getElementById(a.getAttribute('href')!.slice(1)); if (el) map.set(el, a); });
    if ('IntersectionObserver' in window && map.size) {
      const io = new IntersectionObserver(entries => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          const on = map.get(e.target);
          links.forEach(a => { const is = a === on; a.classList.toggle('on', is); if (is) a.setAttribute('aria-current', 'location'); else a.removeAttribute('aria-current'); });
        }
      }, { rootMargin: '-35% 0px -60% 0px' });
      map.forEach((_a, el) => io.observe(el));
    }
  }
</script>
