---
// [WEB-LEGAL-FOLK-1 2026-09-27] /contact rebuilt to the owner-approved mockup
// design/legal-pages/saathum-contact-mock.src.html. OWNER: "exact replica of
// what you have shown me, not an inspired version." Replaces the
// layouts/Content.astro version — same form fields/attributes and the same
// real /api/contact handler, on the new folk shell.
//
// NOTE FOR AI:
//  - Shell + CSS: layouts/LegalFolk.astro (props documented there, including
//    the contact-page addendum) + its styles/legal-folk.css. Same
//    conventions as pages/refunds.astro. `contact={true}` renders this
//    page's slot directly after the hero + ribbon, with NO rail and NO ask
//    band — this page supplies its own `.lg-contact` section.
//  - The contact page has no "Last updated" date, so `updated` is omitted
//    and `metaPill="support (@) saathum.com"` replaces the hero-meta pill
//    text instead (see LegalFolk.astro's addendum note).
//  - Form field names/attributes/options/maxlengths/honeypot and the
//    delivery note are UNCHANGED from the previous contact.astro. The
//    mock's demo <script> is replaced by the real /api/contact POST
//    handler with the same status messages as before — only the status
//    element's class changed, to the shared `lg-cstatus` (+ .ok/.err)
//    rule in legal-folk.css.
//  - Every control keeps a stable id (c-name/c-email/c-category/c-subject/
//    c-message) as in the mock, for label association and future JS hooks.
//  - Side-card images go through publicImage() directly (width 320,
//    fit scale-down) since LegalFolk has no side-card prop — contact is the
//    only page on this layout using `.lg-side-card`.
//  - Emails stay plain text "support (@) saathum.com" — no email link —
//    except the existing delivery-note "support@saathum.com" which is not a
//    link and stays exactly as the previous page had it.
export const prerender = true;
import LegalFolk from '../layouts/LegalFolk.astro';
import { publicImage } from '../lib/config';
import { BRAND } from '../lib/brand';

const linkImg = publicImage('/assets/saathum-how-it-works/link.webp', { width: 320, fit: 'scale-down' });
const ontimeImg = publicImage('/assets/saathum-how-it-works/ontime.webp', { width: 320, fit: 'scale-down' });
const privacyImg = publicImage('/assets/saathum-editorial-stickers-v2/privacy-sticker-v2.png', { width: 320, fit: 'scale-down' });
---

<LegalFolk
  title="Contact us"
  titleHtml="Contact <em>us</em>"
  eyebrow="Talk to a human"
  lead={`Questions, feedback, press, partnerships, or a problem to report? Your message goes straight to the ${BRAND.name} support team.`}
  description={`Get in touch with ${BRAND.name} — support, press, partnerships, or to report something that isn't right.`}
  image="/og/contact.png"
  metaPill={`support (@) ${BRAND.domain}`}
  sticker={{
    src: '/assets/saathum-legal/contact-welcome.png',
    width: 790,
    height: 1009,
    alt: 'A smiling woman in a silk saree welcoming you with joined hands, a lit diya on a lotus below.',
  }}
  contact
>
  <section class="lg-contact lg-wrap">
    <div class="lg-contact-inner">
      <form id="contact-form" class="lg-cform" novalidate>
        <p class="lg-intro">You can always email us directly at support (@) {BRAND.domain}, or use the form below. For anything about your data, see our <a href="/privacy">Privacy Policy</a>.</p>
        <label class="lg-honeypot" aria-hidden="true"><span>Company website</span><input type="text" name="company" tabindex="-1" autocomplete="off" /></label>
        <div class="lg-row">
          <label><span>Your name</span><input id="c-name" type="text" name="name" autocomplete="name" required maxlength="120" /></label>
          <label><span>Email</span><input id="c-email" type="email" name="email" autocomplete="email" required maxlength="200" /></label>
        </div>
        <label><span>What can we help with?</span>
          <select id="c-category" name="category">
            <option value="Support">Product support</option>
            <option value="Feedback">Feedback or an idea</option>
            <option value="Safety">Safety or abuse report</option>
            <option value="Privacy">Privacy request</option>
            <option value="Press">Press or media</option>
            <option value="Partnership">Partnership</option>
            <option value="Other">Something else</option>
          </select>
        </label>
        <label><span>Subject</span><input id="c-subject" type="text" name="subject" maxlength="160" placeholder="What’s this about?" /></label>
        <label><span>Message</span><textarea id="c-message" name="message" rows="6" required maxlength="5000" placeholder="How can we help?"></textarea></label>
        <!-- [WEB-CONTACT-GUARD-1 2026-09-27] Maths question + Cloudflare Turnstile, both verified
             server-side in pages/api/contact.ts. Same label/input styling as the fields above. -->
        <label><span id="c-maths-q">Quick check: loading a question…</span><input id="c-maths" type="text" name="captcha_answer" inputmode="numeric" pattern="[0-9]*" autocomplete="off" required maxlength="3" placeholder="Your answer" /></label>
        <input type="hidden" name="captcha_token" id="c-maths-token" />
        <div class="cf-turnstile" data-sitekey="0x4AAAAAAFFIeuYrBZzXkZT6" data-theme="light" data-size="flexible"></div>
        <button type="submit" class="lg-btn">Send message <span aria-hidden="true">→</span></button>
        <p class="lg-cstatus" id="contact-status" role="status" aria-live="polite"></p>
        <p class="lg-delivery-note">Every form submission is delivered through Brevo to <strong>{BRAND.emails.support}</strong>.</p>
      </form>
      <aside class="lg-side">
        <div class="lg-side-card lg-side-card--red">
          <div><span class="lg-tag">Email</span><h3>Write to us directly</h3><p><strong>support (@) {BRAND.domain}</strong></p><p>Your message goes straight to the {BRAND.name} support team.</p></div>
          <img src={linkImg} alt="" aria-hidden="true" width="384" height="640" loading="lazy" decoding="async" />
        </div>
        <div class="lg-side-card lg-side-card--terra">
          <div><span class="lg-tag">Help centre</span><h3>Answers in plain English</h3><p>Booking, your video, prasad, refunds and your account — <a href="/help">browse the Help centre</a>.</p></div>
          <img src={ontimeImg} alt="" aria-hidden="true" width="443" height="494" loading="lazy" decoding="async" />
        </div>
        <div class="lg-side-card lg-side-card--plum">
          <div><span class="lg-tag">Your data</span><h3>Privacy requests</h3><p>Pick “Privacy request” in the form, or read our <a href="/privacy">Privacy Policy</a>.</p></div>
          <img src={privacyImg} alt="" aria-hidden="true" width="1206" height="1304" loading="lazy" decoding="async" />
        </div>
      </aside>
    </div>
  </section>
</LegalFolk>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const statusEl = document.getElementById('contact-status');
  const mathsQ = document.getElementById('c-maths-q');
  const mathsInput = document.getElementById('c-maths') as HTMLInputElement | null;
  const mathsToken = document.getElementById('c-maths-token') as HTMLInputElement | null;
  type TurnstileApi = { reset: (el?: string | HTMLElement) => void };

  // [WEB-CONTACT-GUARD-1] Fresh server-signed maths question (page is prerendered).
  async function loadMaths() {
    if (!mathsQ || !mathsToken || !mathsInput) return;
    mathsInput.value = '';
    try {
      const res = await fetch('/api/contact', { cache: 'no-store' });
      const out = await res.json();
      if (!res.ok || !out.ok) throw new Error();
      mathsQ.textContent = 'Quick check: ' + out.question;
      mathsToken.value = out.token;
    } catch {
      mathsQ.textContent = 'Quick check: could not load a question — please refresh the page.';
      mathsToken.value = '';
    }
  }
  function resetGuards() {
    const ts = (window as unknown as { turnstile?: TurnstileApi }).turnstile;
    const widget = form?.querySelector('.cf-turnstile') as HTMLElement | null;
    if (ts && widget) { try { ts.reset(widget); } catch { /* widget not rendered yet */ } }
    loadMaths();
  }
  loadMaths();

  if (form && statusEl) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      const data = Object.fromEntries(new FormData(form).entries());
      if (!data.name || !data.email || !data.message) {
        statusEl.className = 'lg-cstatus err';
        statusEl.textContent = 'Please fill in your name, email, and message.';
        return;
      }
      if (!String(data.captcha_answer || '').trim()) {
        statusEl.className = 'lg-cstatus err';
        statusEl.textContent = 'Please answer the maths question.';
        return;
      }
      if (!data['cf-turnstile-response']) {
        statusEl.className = 'lg-cstatus err';
        statusEl.textContent = 'Please wait for the security check to finish, then press Send again.';
        return;
      }
      btn.disabled = true;
      const prev = btn.textContent;
      btn.textContent = 'Sending…';
      statusEl.className = 'lg-cstatus';
      statusEl.textContent = '';
      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(data),
        });
        const out = await res.json().catch(() => ({}));
        if (res.ok && out.ok) {
          form.reset();
          statusEl.className = 'lg-cstatus ok';
          statusEl.textContent = 'Thanks! Your message is on its way — we’ll be in touch.';
        } else {
          statusEl.className = 'lg-cstatus err';
          statusEl.textContent = out.error || 'Could not send your message. Please email support@saathum.com.';
        }
      } catch {
        statusEl.className = 'lg-cstatus err';
        statusEl.textContent = 'Network error. Please email support@saathum.com.';
      } finally {
        btn.disabled = false;
        btn.textContent = prev;
        resetGuards();
      }
    });
  }
</script>
