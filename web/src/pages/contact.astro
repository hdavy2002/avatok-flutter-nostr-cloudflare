---
export const prerender = true;
import Content from '../layouts/Content.astro';
---

<Content
  kicker="Talk to a human"
  title="Contact us"
  description="Get in touch with avaTOK — support, press, partnerships, or to report something that isn't right."
  image="/og/contact.png"
  lead="Questions, feedback, press, partnerships, or a problem to report? Your message goes straight to the avaTOK support team."
  width="wide"
  tone="pink"
>
  <p>
    You can always email us directly at <a href="mailto:support@avatok.ai">support@avatok.ai</a>, or
    use the form below. For copyright issues see our <a href="/dmca">DMCA / Copyright</a> policy; for
    anything about your data, see our <a href="/privacy">Privacy Policy</a>.
  </p>

  <form id="contact-form" class="cform" novalidate>
    <label class="honeypot" aria-hidden="true">
      <span>Company website</span>
      <input type="text" name="company" tabindex="-1" autocomplete="off" />
    </label>
    <div class="row">
      <label>
        <span>Your name</span>
        <input type="text" name="name" autocomplete="name" required maxlength="120" />
      </label>
      <label>
        <span>Email</span>
        <input type="email" name="email" autocomplete="email" required maxlength="200" />
      </label>
    </div>
    <label>
      <span>What can we help with?</span>
      <select name="category">
        <option value="Support">Product support</option>
        <option value="Feedback">Feedback or an idea</option>
        <option value="Safety">Safety or abuse report</option>
        <option value="Privacy">Privacy request</option>
        <option value="Press">Press or media</option>
        <option value="Partnership">Partnership</option>
        <option value="Other">Something else</option>
      </select>
    </label>
    <label>
      <span>Subject</span>
      <input type="text" name="subject" maxlength="160" placeholder="What’s this about?" />
    </label>
    <label>
      <span>Message</span>
      <textarea name="message" rows="6" required maxlength="5000" placeholder="How can we help?"></textarea>
    </label>
    <button type="submit" class="cbtn">Send message</button>
    <p class="cstatus" id="contact-status" role="status" aria-live="polite"></p>
    <p class="delivery-note">Every form submission is delivered through Brevo to <strong>support@avatok.ai</strong>.</p>
  </form>
</Content>

<style>
  .cform { width: min(100%, 820px); margin: 36px auto 0; padding: clamp(22px, 4vw, 42px); display: flex; flex-direction: column; gap: 20px; border: 1px solid #181816; border-radius: 24px; background: #fffdf7; box-shadow: 12px 12px 0 #4f5cff; }
  .cform .row { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  .cform label { display: flex; flex-direction: column; gap: 8px; font-weight: 800; color: #181816; font-size: 17px; }
  .cform input, .cform textarea, .cform select {
    width: 100%; font-family: 'DM Sans', sans-serif; font-size: 17px; font-weight: 600; color: #181816;
    background: #fff; border: 1px solid #181816; border-radius: 15px;
    padding: 14px 16px; outline: none; box-shadow: 3px 3px 0 #181816; transition: box-shadow .12s ease, transform .12s ease;
  }
  .cform input:focus, .cform textarea:focus, .cform select:focus { box-shadow: 5px 5px 0 #4f5cff; transform: translate(-1px,-1px); }
  .cform textarea { resize: vertical; }
  .cform .honeypot { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  .cbtn {
    align-self: center; font-family: 'DM Sans', sans-serif; font-weight: 800; font-size: 17px;
    color: #181816; background: #ffd95e; border: 1px solid #181816; border-radius: 999px;
    padding: 14px 28px; cursor: pointer; box-shadow: 4px 4px 0 #181816;
    transition: transform .12s ease, box-shadow .12s ease;
  }
  .cbtn:hover:not(:disabled) { transform: translate(-2px,-2px); box-shadow: 6px 6px 0 #181816; }
  .cbtn:disabled { opacity: .6; cursor: default; }
  .cstatus { font-weight: 800; margin: 0; min-height: 1.2em; text-align: center; }
  .cstatus.ok { color: #176b43; }
  .cstatus.err { color: #b42525; }
  .delivery-note { margin: 0; font-size: 14px; color: rgba(24,24,22,.65); text-align: center; }
  @media (max-width: 560px) { .cform { box-shadow: 7px 7px 0 #4f5cff; } .cform .row { grid-template-columns: 1fr; } }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const statusEl = document.getElementById('contact-status');
  if (form && statusEl) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      const data = Object.fromEntries(new FormData(form).entries());
      if (!data.name || !data.email || !data.message) {
        statusEl.className = 'cstatus err';
        statusEl.textContent = 'Please fill in your name, email, and message.';
        return;
      }
      btn.disabled = true;
      const prev = btn.textContent;
      btn.textContent = 'Sending…';
      statusEl.className = 'cstatus';
      statusEl.textContent = '';
      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(data),
        });
        const out = await res.json().catch(() => ({}));
        if (res.ok && out.ok) {
          form.reset();
          statusEl.className = 'cstatus ok';
          statusEl.textContent = 'Thanks! Your message is on its way — we’ll be in touch.';
        } else {
          statusEl.className = 'cstatus err';
          statusEl.textContent = out.error || 'Could not send your message. Please email support@avatok.ai.';
        }
      } catch {
        statusEl.className = 'cstatus err';
        statusEl.textContent = 'Network error. Please email support@avatok.ai.';
      } finally {
        btn.disabled = false;
        btn.textContent = prev;
      }
    });
  }
</script>
