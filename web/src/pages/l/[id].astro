---
// Public listing detail — SSR, edge-cached, link-preview friendly.
// [SPEC-2026-09-01-LISTING-CONTENT-AND-BOOKING A1.3] Every listing details
// page is public and chrome-free for everyone, logged in or not — this page
// used to bounce a signed-in visitor to /dashboard/l/<id> via <AuthRedirect/>;
// that redirect is REMOVED. An unregistered buyer signs in inline (email +
// code) in the booking box and never leaves this page. /dashboard/l/<id>
// itself now just 301s here.
export const prerender = false;

import Base from '../../layouts/Base.astro';
import { getListingCompanions } from '../../lib/listingCompanions';
import { scheduleStateOf } from '../../lib/card';
import ListingDetailsComp from '../../components/ListingDetailsComp.astro';
import { getListing, ApiError } from '../../lib/apiClient';
import { listingOg, listingJsonLd, listingBreadcrumbLd } from '../../lib/og';
import { listingPath } from '../../lib/urls';
import type { Listing } from '../../lib/types';

const { id } = Astro.params;

let listing: Listing | null = null;
let notFound = false;
try {
  // [LIST-DETAIL-2] getListing() now unwraps the worker's envelope itself (see
  // apiClient.ts), so this is already a flat Listing — listingOg() below reads
  // real title/description/poster/price values.
  listing = await getListing(id!);
} catch (e) {
  if (e instanceof ApiError && (e.status === 404 || e.status === 410)) notFound = true;
  else throw e;
}
if (notFound || !listing) return new Response('Listing not found', { status: 404 });

// [LIST-PAGE-2] SPEC-2026-09-01 §G — /l/<id> 301s to the pretty /<handle>/<slug>
// URL once both exist, so every already-shared /l/<id> link keeps working
// forever while new shares/crawls converge on the canonical pretty URL.
const canonicalPath = listingPath({
  id: listing.id,
  handle: listing.creator?.handle ?? null,
  slug: listing.slug ?? null,
});
if (canonicalPath !== `/l/${encodeURIComponent(listing.id)}`) {
  return Astro.redirect(canonicalPath, 301);
}

Astro.response.headers.set('Cache-Control', 'public, max-age=60, stale-while-revalidate=300');
const og = listingOg(listing);
// [LISTING-EXPIRY-1] A finished or cancelled show keeps a readable page for anyone
// holding the link, but is no longer something to rank in search.
const closedListing = ['ended', 'cancelled', 'expired'].includes(scheduleStateOf(listing));
// [LISTING-SEO-1 2026-09-06] Event + breadcrumb structured data, so Google can
// build a rich result and answer engines can state what this page IS rather
// than guessing from the prose. Built from the SAME listing object the page
// renders, so the markup and the visible page can never disagree — a mismatch
// is what gets rich results suppressed.
const pageUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://avatok.ai').toString();
const eventLd = listingJsonLd(listing, pageUrl);
const crumbLd = listingBreadcrumbLd(listing, pageUrl);

// [LISTING-DETAILS-COMP-1] Same fail-soft companion fetches ListingDetailView
// already used — a 404/503/network error on any of these hides its section
// rather than breaking a public page for a real listing.
const { reviewList, slots, browseMore, creatorProfile, creatorListings } = await getListingCompanions(listing);
const isOwner = Boolean(listing.viewer?.is_owner);
---

<Base title={og.title} description={og.description} image={og.image} noindex={closedListing}>
  <Fragment slot="head">
    {og.extra.map((m) => (m.property ? <meta property={m.property} content={m.content} /> : <meta name={m.name} content={m.content} />))}
    <script type="application/ld+json" set:html={JSON.stringify(eventLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(crumbLd)} />
  </Fragment>

  {/* [BETA-TESTMODE-1 2026-09-14] Beta status on the listing itself, so a buyer knows
      before he reaches checkout. Deliberately makes NO claim about test mode: this page
      is public and cannot verify which credentials the gateway rail is on
      (GET /api/pay/methods is authenticated). The "no real money will be charged"
      sentence lives in BetaTestNotice at checkout, where the server has told us the
      selected rail is on test keys. Do not "improve" this by asserting test mode here. */}
  <div style="max-width:100rem; margin:0 auto; padding:10px clamp(14px,4vw,40px) 0; display:flex; align-items:center; gap:10px; flex-wrap:wrap; font-family:'Nunito',sans-serif; font-weight:800; font-size:12px; letter-spacing:.08em; text-transform:uppercase;">
    <span style="display:inline-block; padding:4px 10px; border:2px solid #0e1116; border-radius:999px; background:#f7d046;">Beta demonstration</span>
    <span style="text-transform:none; letter-spacing:0; font-size:13px; font-weight:700;">A demo listing published for avaTOK&rsquo;s beta soft launch. Payment details for the beta are shown at checkout.</span>
  </div>

  {isOwner && (
    <div style="max-width:100rem; margin:0 auto; padding:10px clamp(14px,4vw,40px) 0; display:flex; align-items:center; gap:12px; font-family:'Nunito',sans-serif; font-weight:800; font-size:12px; letter-spacing:.08em;">
      <span>YOU OWN THIS LISTING</span>
      <a href={`/dashboard/listings/new?id=${encodeURIComponent(listing.id)}`} style="text-decoration:underline;">EDIT LISTING →</a>
    </div>
  )}

  <ListingDetailsComp listing={listing} reviews={reviewList} slots={slots} browse={browseMore} creatorListings={creatorListings} creatorProfile={creatorProfile} />
</Base>
