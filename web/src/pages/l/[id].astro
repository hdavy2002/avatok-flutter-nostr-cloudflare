---
// [WEB-OLD-CHECKOUT-GONE-1 2026-09-27] OWNER DECISION: the old listing detail page is retired.
// /l/<id> 301s to the new event page /book/<id>. No lookup needed — the id is the id.
export const prerender = false;

import { listingPath } from '../../lib/urls';

const { id } = Astro.params;
if (!id) return new Response('Listing not found', { status: 404 });
return Astro.redirect(listingPath({ id }), 301);
