---
import { BRAND } from '../lib/brand';
import HelloFraandsPage from '../layouts/HelloFraandsPage.astro';
const grievanceEmail = BRAND.emails.grievance;
---
<HelloFraandsPage updated="2026-10-14" title="Report a user" summary="Kisi call ya vyavahar ki shikayat yahan taiyaar karein.">
<p>If a call makes you uncomfortable, end it. This form prepares an email to our grievance contact. Your email app must open and you must send the message yourself; nothing is submitted by this page.</p>
<p>A safety report is reviewed before any strike is confirmed. For immediate danger, call <a href="tel:112">Emergency 112</a>. This form is not an emergency service.</p>
<h2>Tell us what happened</h2>
<form id="report-form" data-recipient={grievanceEmail}>
<label for="report-contact">Your phone number or email (required)</label>
<input id="report-contact" name="contact" autocomplete="email" maxlength="200" required />
<label for="report-profile">Other person's profile name (required)</label>
<input id="report-profile" name="profile" maxlength="200" required />
<label for="report-call">Call ID (required)</label>
<input id="report-call" name="call" aria-describedby="call-help" maxlength="200" required />
<p id="call-help">Look in your dashboard's call history and open the relevant call details. If you cannot find the ID, enter “Not available” and give the call date and time below.</p>
<label for="report-details">What happened? (required)</label>
<textarea id="report-details" name="details" rows="7" maxlength="6000" required aria-describedby="details-help"></textarea>
<p id="details-help">Include the call date, time, and what concerned you. Do not include an OTP, password, Aadhaar number, or UPI PIN.</p>
<label for="report-file">Supporting file (optional)</label>
<input id="report-file" name="evidence" type="file" aria-describedby="file-help" />
<p id="file-help">Files are not uploaded by this form. Attach the selected file yourself in your email app before sending. Share only material needed to explain the report.</p>
<button type="submit" disabled>Prepare report email</button>
<p id="report-status" role="status" aria-live="polite"></p>
</form>
<noscript><p>JavaScript is needed to prepare the email. Send your contact details, the other person's profile name, call ID, and what happened directly to <a href={`mailto:${BRAND.emails.grievance}`}>{BRAND.emails.grievance}</a>. Do not email passwords or identity documents.</p></noscript>
<p>You can email <a href={`mailto:${BRAND.emails.grievance}`}>{BRAND.emails.grievance}</a> directly if your email app does not open. For follow-up and appeals, visit <a href="/grievance">Grievance redressal</a>.</p>
<style>
form{display:grid;gap:.7rem;margin:2rem 0}label{font-weight:700;margin-top:.65rem}input,textarea{width:100%;box-sizing:border-box;font:inherit;padding:.85rem;border:1px solid #bdb5aa;border-radius:10px;background:#fff;color:#24211e}input[type=file]{padding:.65rem}form p{font-size:.9rem;margin:0 0 .6rem}button{justify-self:start;border:0;border-radius:999px;padding:.9rem 1.35rem;font:inherit;font-weight:700;background:#292521;color:#fff;cursor:pointer}input:focus-visible,textarea:focus-visible,button:focus-visible{outline:3px solid #936329;outline-offset:3px}
</style>
<script>
const form = document.querySelector<HTMLFormElement>('#report-form');
// [HF-DAILY-FLOWS-1] The report is STORED by the server (and mailed to the grievance inbox). Only if that is not possible (offline, or
// the server answers 503 not_ready) does the page fall back to the old email draft below, so a report is never lost.
async function sendToServer(data: FormData): Promise<{ ok: true; id: string } | { ok: false; code: string; message: string }> {
  const { hfCall, looksSignedOut } = await import('../lib/hfCallsApi');
  const payload = { contact: String(data.get('contact') || ''), profile: String(data.get('profile') || ''), call: String(data.get('call') || ''), details: String(data.get('details') || '') };
  let r = await hfCall<{ ok: true; id: string }>('POST', '/api/hf/reports', payload, { auth: !looksSignedOut() });
  if (!r.ok && r.code === 'no_session') r = await hfCall<{ ok: true; id: string }>('POST', '/api/hf/reports', payload, { auth: false });
  return r.ok ? { ok: true, id: r.data.id } : { ok: false, code: r.code, message: r.message };
}
form?.addEventListener('submit', async (event) => {
  event.preventDefault();
  if (!form.reportValidity()) return;
  const data = new FormData(form);
  const statusEl = document.querySelector<HTMLElement>('#report-status');
  const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
  if (submitBtn) submitBtn.disabled = true;
  try {
    const sent = await sendToServer(data);
    if (sent.ok) {
      if (statusEl) statusEl.textContent = 'Thank you. Your report is with our team. Reference: ' + sent.id + '. Please keep it for follow-up. For immediate danger, call 112.';
      form.reset();
      return;
    }
    if (sent.code === 'invalid_field' || sent.code === 'rate limited') {
      if (statusEl) statusEl.textContent = sent.message || 'Please check the form and try again in a little while.';
      return;
    }
  } catch { /* fall through to the email draft */ } finally { if (submitBtn) submitBtn.disabled = false; }
  const fileInput = form.querySelector<HTMLInputElement>('#report-file');
  const file = fileInput?.files?.[0];
  const body = [
    'Report a user',
    'My contact: ' + String(data.get('contact') || ''),
    'Profile name: ' + String(data.get('profile') || ''),
    'Call ID: ' + String(data.get('call') || ''),
    '',
    'What happened:',
    String(data.get('details') || ''),
    '',
    file ? 'Supporting file to attach: ' + file.name : 'No supporting file selected.',
  ].join('\n');
  const recipient = form.dataset.recipient || '';
  window.location.href = 'mailto:' + encodeURIComponent(recipient) + '?subject=' + encodeURIComponent('User report — call ' + String(data.get('call') || '')) + '&body=' + encodeURIComponent(body);
  const status = document.querySelector<HTMLElement>('#report-status');
  if (status) status.textContent = 'Your report email is prepared. Send it in your email app' + (file ? ' and attach your selected file' : '') + '. Nothing has been sent by this page.';
});
// No JavaScript means the complaint cannot become a GET URL with private details.
const recipient = form?.dataset.recipient || '';
if (recipient.includes('@') && !recipient.includes('{{')) {
  form?.querySelector<HTMLButtonElement>('button[type="submit"]')?.removeAttribute('disabled');
} else {
  const status = document.querySelector<HTMLElement>('#report-status');
  if (status) status.textContent = 'Reporting address is not available right now.';
}
</script>
</HelloFraandsPage>
