---
// [WEB-HELP-SKIN-2 2026-09-27] Help centre LANDING, rebuilt to the owner-approved
// "help skin v2" mockup (design/help-centre/saathum-help-skin-v2.src.html, view
// "Help home"). Owner rule: an approved mockup is reproduced EXACTLY, including
// on large screens. Replaces the [WEB-HELP-2] zine landing (HelpHero /
// HelpTiles / HelpFaqStrip and the `.help-page` token block — all deleted).
//
// NOTE FOR AI:
//  - Same shell as pages/marketplace.astro: Base chrome={false}, the
//    `.folk-site[data-design="reference-v5"]` wrapper carrying
//    --folk-border-url, SiteHeader/SiteFooter `folk`, Comfortaa+Nunito,
//    theme-color #fff8e8. Page CSS: styles/help-skin.css (scoped under `.hs`).
//  - REAL CONTENT ONLY, from lib/help.ts. The mockup renamed "For creators" to
//    "Sankalp & prasad" and invented article titles, counts and a ₹ price —
//    none of that is used. Tiles/panels = live sections (drafts excluded by
//    getHelpTree); FAQ cards = real `faq[]` items; hero stats = real counts.
//  - Tile grid is `repeat(sections + 1)` (the +1 is the contact tile) so a
//    smaller number of live sections widens the tiles instead of leaving an
//    empty column.
//  - Every section id is an element id here (the panels) — layouts/Help.astro's
//    breadcrumb and rail link to /help#<section>, and check-help.mjs asserts
//    every /help#x link resolves to an id on this page.
//  - The ONE FAQPage JSON-LD block of the help centre lives here (unchanged
//    since [WEB-HELP-1]); articles must never emit it (check-help.mjs).
//  - Emails are plain text "name (@) <domain>", never mailto. Brand comes from BRAND only.
//  - [HELLO-FRAANDS-HELP-RESTORE-1 2026-10-08] Restored for Hello Fraands: shared header/footer, Hello Fraands art and copy.
//  - [HF-HELP-GHAR-1 2026-10-17] Owner-approved "Gaon ka Ghar" design (design canvas "Help Centre"):
//    a happy village home at Sankranti — tiled-roof house hero with a round window, rangoli doorstep, topics as kites,
//    top questions as palm-leaf pothi (<details>), every article in a stitched bahi-khata, aangan for "talk to a person",
//    meme stickers. Multi-colour palette (kumkum, saffron, haldi, peacock, firozi, jamuni, rani). Art: /assets/hf-help/
//    via components/help/helpSkin.ts. Styles: styles/help-desi.css (scoped `.gh`). Phones: everything centred.
export const prerender = true;

import Base from '../../layouts/Base.astro';
// [HELLO-FRAANDS-HELP-RESTORE-1] Shared site header/footer replace the old folk chrome.
import SiteHeader from '../../components/callvaal/Header.astro';
import SiteFooter from '../../components/callvaal/Footer.astro';
import HelpSearch from '../../components/HelpSearch.astro';
import { getHelpTree, helpUrl, type HelpEntry, type HelpSectionId } from '../../lib/help';
import { publicImage } from '../../lib/config';
import { ORG } from '../../lib/org';
import { HELP_SEO } from '../../lib/seo/catalog';
import {
  SECTION_ART, SECTION_TONE, CONTACT_KITE, HELP_ART, HELP_STICKERS, HELP_BG, readMinutes, countLabel,
} from '../../components/help/helpSkin';
import { SECTIONS } from '../../lib/help';
import '../../styles/desi-home-chrome.css';
import '../../styles/help-desi.css';
import { BRAND } from '../../lib/brand';

const tree = await getHelpTree();
const allEntries = tree.flatMap((s) => s.entries);
const articleCount = allEntries.length;

type FaqItem = { q: string; a: string; entry: HelpEntry; sectionId: HelpSectionId; section: string };
const faqItems: FaqItem[] = tree.flatMap((section) =>
  section.entries.flatMap((entry) =>
    entry.data.faq.map((f) => ({ ...f, entry, sectionId: section.id, section: section.label })),
  ),
);

// [WEB-HELP-1, kept verbatim] The ONLY FAQPage JSON-LD block in the help centre.
const faqLd =
  faqItems.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        '@id': `${ORG.url}help#faq`,
        mainEntity: faqItems.map((f) => ({
          '@type': 'Question',
          name: f.q,
          acceptedAnswer: { '@type': 'Answer', text: f.a },
        })),
      }
    : null;

// Six FAQ cards, taken round-robin across the live sections (each section's
// items in their own order) so the band shows every topic, not six answers
// from the first article.
const bySection = tree.map((s) => faqItems.filter((f) => f.sectionId === s.id));
const faqCards: FaqItem[] = [];
for (let round = 0; faqCards.length < 6 && bySection.some((l) => l.length > round); round++) {
  for (const list of bySection) if (list[round] && faqCards.length < 6) faqCards.push(list[round]);
}

// "People ask about:" chips — short labels onto real articles; a chip whose
// article is archived simply disappears.
const QUICK: { id: string; label: string }[] = [
  { id: 'safety-and-privacy/your-number-stays-private', label: 'Is my number private?' },
  { id: 'safety-and-privacy/spot-otp-and-bank-scams', label: 'OTP & bank scams' },
  { id: 'calling/price-and-minutes', label: 'How much does a call cost?' },
  { id: 'wallet-and-payments/withdraw-your-balance', label: 'Take my balance out' },
  { id: 'for-women/women-only-space', label: 'Who can call you' },
];
const quick = QUICK.flatMap((c) => {
  const e = allEntries.find((x) => x.id === c.id);
  return e ? [{ href: helpUrl(e), label: c.label }] : [];
});

const bgVars = HELP_BG.map((o) => `--gh-${o.key}:url(${publicImage(o.path, { width: o.width, fit: 'scale-down' })})`).join(';');
const img = (path: string, width: number) => publicImage(path, { width, fit: 'scale-down' });
const sticker = (s: { src: string; alt: string }, cls = '') => ({ src: img(s.src, 720), alt: s.alt, cls });
const toneStyle = (id: HelpSectionId) => `--tone:${SECTION_TONE[id][0]};--tone-ink:${SECTION_TONE[id][1]}`;
const pages = [tree.slice(0, 3), tree.slice(3)];
---
<Base content={HELP_SEO} chrome={false} indiaLandingLanguage={false}>
  <Fragment slot="head">
    <meta name="theme-color" content="#8fd8f0" />
    <link rel="preload" as="image" href={img(HELP_ART.hero, 1100)} fetchpriority="high" />
    <link rel="preload" as="style" onload="this.onload=null;this.rel='stylesheet'" href="https://fonts.googleapis.com/css2?family=Comfortaa:wght@500;600;700&family=Nunito:wght@700;800;900&display=swap" />
  </Fragment>
  {faqLd && <script type="application/ld+json" set:html={JSON.stringify(faqLd).replace(/</g, '\\u003c')} />}
  <div class="gh desi-home" style={bgVars}>
    <a class="gh-skip" href="#main-content">Skip to main content</a>
    <SiteHeader />
    <main id="main-content" class="hs gh-home">

      <!-- ① Ghar: the happy village home -->
      <section class="gh-hero" aria-labelledby="help-title">
        <div class="gh-wrap gh-house-wrap">
          <img class="gh-sticker gh-hero-sticker" src={sticker(HELP_STICKERS.hero).src} alt={HELP_STICKERS.hero.alt} width="420" height="245" />
          <img class="gh-roof" src={img(HELP_ART.roof, 2000)} alt="" width="2000" height="300" aria-hidden="true" />
          <div class="gh-wall">
            <div class="gh-wall-inner">
              <div class="gh-hero-copy">
                <p class="gh-eyebrow">Help centre · Ghar jaisa, seedha jawab</p>
                <h1 id="help-title">Namaste!<br />How can we <span class="gh-hl">help you?</span></h1>
                <p class="gh-lead">Calls, your private number, safety, the wallet or becoming an influencer. Clear, simple answers in easy English, with examples.</p>
                <HelpSearch id="hero" />
                {quick.length > 0 && (
                  <div class="gh-quick" aria-label="Popular questions">
                    <span>Log poochte hain:</span>
                    {quick.map((c) => <a href={c.href}>{c.label}</a>)}
                  </div>
                )}
              </div>
              <div class="gh-window">
                <img class="gh-window-art" src={img(HELP_ART.hero, 1100)} alt="Illustration of a happy village home at Sankranti: two young women in kurtas and jeans fly kites on the rooftop while a rangoli brightens the doorstep" width="1100" height="1100" fetchpriority="high" decoding="async" />
                <img class="gh-window-ring" src={img(HELP_ART.heroRing, 1024)} alt="" width="1024" height="1024" aria-hidden="true" />
              </div>
            </div>
          </div>
        </div>
        <div class="gh-rangoli" aria-hidden="true"></div>
      </section>

      <!-- ② Topics as kites -->
      <section class="gh-band gh-kites" aria-labelledby="topics-title">
        <div class="gh-wrap">
          <div class="gh-head">
            <div><p class="gh-eyebrow">Apna sawaal chuno</p><h2 id="topics-title">Pick a kite. <span class="gh-blue">Every topic flies here.</span></h2></div>
            <img class="gh-sticker" src={sticker(HELP_STICKERS.kites).src} alt={HELP_STICKERS.kites.alt} width="420" height="245" loading="lazy" />
          </div>
          <div class="gh-kite-grid">
            {tree.map((s) => (
              <a class="gh-kite" href={`#${s.id}`} style={toneStyle(s.id)}>
                <img src={img(SECTION_ART[s.id], 440)} alt="" width="220" height="275" loading="lazy" decoding="async" />
                <span class="gh-tag"><b>{s.label}</b><small>{SECTIONS[s.id].hindi}</small><em>{countLabel(s.entries.length)}</em></span>
              </a>
            ))}
            <a class="gh-kite gh-kite--contact" href="/contact" style="--tone:#2a1f5c;--tone-ink:#fff4dc">
              <img src={img(CONTACT_KITE, 440)} alt="" width="220" height="275" loading="lazy" decoding="async" />
              <span class="gh-tag"><b>Still need help?</b><small>Likho, hum jawab denge</small><em>A real person replies</em></span>
            </a>
          </div>
        </div>
      </section>

      <!-- ③ Top questions: palm-leaf pothi -->
      {faqCards.length > 0 && (
        <section class="gh-band gh-band--jamuni gh-faq" id="faq" aria-labelledby="faq-title">
          <div class="gh-wrap">
            <div class="gh-head">
              <div><p class="gh-eyebrow">Sabse zyada poocha gaya</p><h2 id="faq-title">The six things people <span class="gh-yellow">ask us most.</span></h2></div>
              <img class="gh-sticker" src={sticker(HELP_STICKERS.faq).src} alt={HELP_STICKERS.faq.alt} width="420" height="245" loading="lazy" />
            </div>
            <div class="gh-leaves">
              {faqCards.map((f, i) => (
                <details class="gh-leaf" open={i === 0} style={toneStyle(f.sectionId)}>
                  <summary>
                    <span class="gh-num" aria-hidden="true">{i + 1}</span>
                    <span class="gh-q"><span class="gh-pill">{f.section}</span><b>{f.q}</b></span>
                    <svg class="gh-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
                  </summary>
                  <div class="gh-answer">
                    <p>{f.a}</p>
                    <div class="gh-answer-foot"><span>Read in {readMinutes(f.entry)} min</span><a class="gh-btn2" href={helpUrl(f.entry)} aria-label={`Read the full answer: ${f.entry.data.title}`}>Full answer →</a></div>
                  </div>
                </details>
              ))}
            </div>
            <p class="gh-note">These answers explain how {BRAND.name} works. Conversations are friendly talk, not medical, legal or money advice, and no outcome is promised.</p>
          </div>
        </section>
      )}

      <!-- ④ Every article: the bahi-khata -->
      <section class="gh-band gh-books" id="every-article" aria-labelledby="all-title">
        <div class="gh-wrap">
          <div class="gh-head">
            <div><p class="gh-eyebrow gh-eyebrow--blue">Bahi-khata · poora hisaab</p><h2 id="all-title">Every article, <span class="gh-red">in one book.</span></h2></div>
            <img class="gh-sticker" src={sticker(HELP_STICKERS.book).src} alt={HELP_STICKERS.book.alt} width="420" height="245" loading="lazy" />
          </div>
          <div class="gh-book">
            <img class="gh-ribbons" src={img(HELP_ART.ribbons, 300)} alt="" width="150" height="250" loading="lazy" aria-hidden="true" />
            <div class="gh-spread">
              {pages.map((pg) => (
                <div class="gh-page">
                  {pg.map((s) => (
                    <div class="gh-ledger" id={s.id} style={toneStyle(s.id)}>
                      <div class="gh-ledger-head"><img src={img(SECTION_ART[s.id], 120)} alt="" width="40" height="50" loading="lazy" decoding="async" /><h3>{s.label}</h3><small>{SECTIONS[s.id].hindi} · {countLabel(s.entries.length)}</small></div>
                      <ul>
                        {s.entries.map((e) => <li><a href={helpUrl(e)}>{e.data.title}<i aria-hidden="true">→</i></a></li>)}
                      </ul>
                    </div>
                  ))}
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!-- ⑤ Aangan: talk to a real person -->
      <section class="gh-band gh-band--peacock gh-aangan" aria-labelledby="stuck-title">
        <div class="gh-wrap gh-aangan-grid">
          <div class="gh-aangan-copy">
            <p class="gh-eyebrow gh-eyebrow--yellow">Jawab nahi mila? Aangan mein aao</p>
            <h2 id="stuck-title">No answer here?<br />Ask a <span class="gh-yellow">real person.</span></h2>
            <p>Email us in Hindi or English. For a call or billing question, add your call ID, date and time. Never send an OTP or UPI PIN. We will never ask for them.</p>
            <a class="gh-btn" href="/contact">Contact us →</a>
            <img class="gh-sticker" src={sticker(HELP_STICKERS.stuck).src} alt={HELP_STICKERS.stuck.alt} width="420" height="245" loading="lazy" />
          </div>
          <div class="gh-aangan-art">
            <img class="gh-aangan-scene" src={img(HELP_ART.stillStuck, 900)} alt="Illustration of a friendly support helper with a laptop on a charpai under a neem tree, giving a thumbs up" width="900" height="900" loading="lazy" decoding="async" />
            <img class="gh-aangan-ring" src={img(HELP_ART.aanganRing, 1200)} alt="" width="1200" height="1200" loading="lazy" aria-hidden="true" />
          </div>
        </div>
        <ul class="gh-wrap gh-ways" aria-label="Ways to reach us">
          <li><span class="gh-way-ico" style="background:#19a7ce"><svg viewBox="0 0 24 24" fill="none" stroke="#2a1f5c" stroke-width="2.4" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg></span><div><b>Help desk</b><span><code>support (@) {BRAND.domain}</code></span></div></li>
          <li><span class="gh-way-ico" style="background:#ffc93c"><svg viewBox="0 0 24 24" fill="none" stroke="#2a1f5c" stroke-width="2.4" aria-hidden="true"><path d="M4 4h16v12H8l-4 4z" /></svg></span><div><b>Contact form</b><span>Rather use a form? Our <a href="/contact">contact page</a> goes to the same people.</span></div></li>
          <li><span class="gh-way-ico" style="background:#e0338a"><svg viewBox="0 0 24 24" fill="none" stroke="#2a1f5c" stroke-width="2.4" aria-hidden="true"><path d="M3 20h18M5 20V10h14v10M4 10l8-6 8 6" /></svg></span><div><b>Grievance redressal</b><span>Support could not resolve it? See our <a href="/grievance">grievance redressal</a> page.</span></div></li>
        </ul>
        <p class="gh-booking-note">{BRAND.name} connects you with your favourite influencers for private phone calls, paid per minute. Calls are not refunded; see our <a href="/refunds">refund policy</a>. Not medical, legal or money advice. In crisis, call <a href="tel:14416">Tele-MANAS 14416</a> or <a href="tel:112">112</a>.</p>
      </section>
    </main>
    <SiteFooter />
  </div>
</Base>
