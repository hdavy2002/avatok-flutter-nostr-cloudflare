---
// [HELLO-FRAANDS-HELP-1 2026-10-08] Help centre LANDING in the current-brand
// notebook look (same fonts, palette and paper cards as the home page and /faq).
// Replaces the Aum Fe "help skin v2" (temple art, folk chrome).
//
// NOTE FOR AI:
//  - Base with the default chrome renders the shared current-brand header/footer.
//    Page CSS: styles/hello-fraands-help.css, scoped under `.hf-help`.
//  - REAL CONTENT ONLY, from lib/help.ts (sections, articles, each article's faq[]).
//  - Every live section id is an element id here (the panels) — layouts/Help.astro's
//    breadcrumb links to /help#<section>, and scripts/check-help.mjs asserts every
//    /help#x link resolves to an id on this page.
//  - The ONE FAQPage JSON-LD block of the help centre lives here; articles must
//    never emit it (check-help.mjs).
//  - Emails are plain text "support (@) <domain>", never mailto. Brand from BRAND only.
export const prerender = true;

import Base from '../../layouts/Base.astro';
import HelpSearch from '../../components/HelpSearch.astro';
import { getHelpTree, helpUrl, type HelpEntry, type HelpSectionId } from '../../lib/help';
import { ORG } from '../../lib/org';
import { HELP_SEO } from '../../lib/seo/catalog';
import { readMinutes, countLabel } from '../../components/help/helpSkin';
import '../../styles/hello-fraands-help.css';
import { BRAND } from '../../lib/brand';

const tree = await getHelpTree();
const allEntries = tree.flatMap((s) => s.entries);
const articleCount = allEntries.length;

type FaqItem = { q: string; a: string; entry: HelpEntry; sectionId: HelpSectionId; section: string; tone: string };
const faqItems: FaqItem[] = tree.flatMap((section) =>
  section.entries.flatMap((entry) =>
    entry.data.faq.map((f) => ({ ...f, entry, sectionId: section.id, section: section.label, tone: section.tone })),
  ),
);

const faqLd =
  faqItems.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        '@id': `${ORG.url}help#faq`,
        mainEntity: faqItems.map((f) => ({
          '@type': 'Question',
          name: f.q,
          acceptedAnswer: { '@type': 'Answer', text: f.a },
        })),
      }
    : null;

// Six cards, the first question of each section's articles taken round-robin,
// so the band shows every topic rather than six answers from one article.
const bySection = tree.map((s) => faqItems.filter((f) => f.sectionId === s.id));
const faqCards: FaqItem[] = [];
for (let round = 0; faqCards.length < 6 && bySection.some((l) => l.length > round); round++) {
  for (const list of bySection) if (list[round] && faqCards.length < 6) faqCards.push(list[round]);
}

// "People ask about" chips — short labels onto real articles; a chip whose
// article is missing simply disappears.
const QUICK: { id: string; label: string }[] = [
  { id: 'safety-and-privacy/your-number-stays-private', label: 'Is my number private?' },
  { id: 'safety-and-privacy/spot-otp-and-bank-scams', label: 'OTP & bank scams' },
  { id: 'calling/price-and-minutes', label: 'How much does a call cost?' },
  { id: 'wallet-and-payments/withdraw-your-balance', label: 'Take my balance out' },
  { id: 'for-women/women-only-space', label: 'Women-only space' },
  { id: 'hosts/host-earnings', label: 'How much do hosts earn?' },
];
const quick = QUICK.flatMap((c) => {
  const e = allEntries.find((x) => x.id === c.id);
  return e ? [{ href: helpUrl(e), label: c.label }] : [];
});
---
<Base content={HELP_SEO} indiaLandingLanguage={false}>
  <Fragment slot="head">
    <meta name="theme-color" content="#46113e" />
  </Fragment>
  {faqLd && <script type="application/ld+json" set:html={JSON.stringify(faqLd).replace(/</g, '\\u003c')} />}
  <main id="main-content" class="hf-help hf-help-home">

    <section class="hfh-hero" aria-labelledby="help-title">
      <p class="hfh-kicker">{BRAND.name} help centre · {articleCount} articles</p>
      <h1 id="help-title">Kaise madad <mark><em>karein?</em></mark></h1>
      <p class="hfh-lead">Simple answers about calls, your private number, safety, the wallet and hosting. Written in easy English, with examples.</p>
      <HelpSearch id="hero" placeholder="Try “OTP”, “refund”, “number”, “earn”…" />
      {quick.length > 0 && (
        <div class="hfh-quick" aria-label="Popular questions">
          <span>People ask:</span>
          {quick.map((c) => <a href={c.href}>{c.label}</a>)}
        </div>
      )}
      <div class="hfh-note paper-note" aria-hidden="true">Koi sawaal<br />chhota nahi hota.</div>
    </section>

    <section class="hfh-topics" aria-labelledby="topics-title">
      <h2 id="topics-title" class="hfh-h2">Choose a <em>topic</em></h2>
      <div class="hfh-tile-grid">
        {tree.map((s) => (
          <a class={`hfh-tile tone-${s.tone}`} href={`#${s.id}`}>
            <span class="hfh-tile-icon" aria-hidden="true">{s.icon}</span>
            <strong>{s.label}</strong>
            <em>{s.hindi}</em>
            <small>{countLabel(s.entries.length)}</small>
          </a>
        ))}
        <a class="hfh-tile hfh-tile--faq" href="/faq">
          <span class="hfh-tile-icon" aria-hidden="true">?</span>
          <strong>Quick FAQs</strong>
          <em>Chhote sawaal, seedhe jawaab</em>
          <small>Short answers on one page</small>
        </a>
      </div>
    </section>

    {faqCards.length > 0 && (
      <section class="hfh-faq" id="faq" aria-labelledby="faq-title">
        <h2 id="faq-title" class="hfh-h2">What people ask <em>most</em></h2>
        <div class="hfh-faq-grid">
          {faqCards.map((f) => (
            <article class="hfh-card">
              <span class={`hfh-pill tone-${f.tone}`}>{f.section}</span>
              <h3>{f.q}</h3>
              <p>{f.a}</p>
              <div class="hfh-card-foot"><span>Read in {readMinutes(f.entry)} min</span><a href={helpUrl(f.entry)} aria-label={`Read more: ${f.entry.data.title}`}>Read more →</a></div>
            </article>
          ))}
        </div>
      </section>
    )}

    <section class="hfh-all" id="every-article" aria-labelledby="all-title">
      <h2 id="all-title" class="hfh-h2">All articles, <em>by topic</em></h2>
      <div class="hfh-panel-grid">
        {tree.map((s) => (
          <div class={`hfh-panel tone-${s.tone}`} id={s.id}>
            <div class="hfh-panel-top">
              <span class="hfh-panel-icon" aria-hidden="true">{s.icon}</span>
              <div><h3>{s.label}</h3><p>{s.blurb}</p></div>
            </div>
            <ul>
              {s.entries.map((e) => <li><a href={helpUrl(e)}>{e.data.title}<i aria-hidden="true">→</i></a></li>)}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <section class="hfh-cta" aria-labelledby="stuck-title">
      <h2 id="stuck-title">Jawaab nahi mila?</h2>
      <p>Write to us in Hindi or English and a real person will reply. Add your call ID, date and time if it is about a call. Never send an OTP, UPI PIN or card details — we will never ask for them.</p>
      <p class="hfh-cta-mail">Email: <code>support (@) {BRAND.domain}</code></p>
      <div class="hfh-cta-actions"><a class="hfh-btn hfh-btn--primary" href="/report">Report a problem</a><a class="hfh-btn hfh-btn--ghost" href="/grievance">Grievance redressal</a></div>
      <p class="hfh-crisis">In danger? Call <a href="tel:112">112</a>. Need mental-health support? Call <a href="tel:14416">Tele-MANAS 14416</a> (free, 24×7).</p>
    </section>
  </main>
</Base>
