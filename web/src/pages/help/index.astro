---
// [WEB-HELP-2 2026-09-11] Redesigned help-centre LANDING page — full-bleed,
// built directly on Base.astro (SiteHeader + SiteFooter, the same
// composition marketplace.astro uses) instead of the boxed layouts/Content.astro
// frame [WEB-HELP-1] used. The owner rejected that boxed editorial look for
// this page specifically; Content.astro itself is untouched and keeps
// serving the 23 legal/about pages that still want it. Article pages
// (layouts/Help.astro, pages/help/[...slug].astro) are a separate,
// simultaneous rewrite — not touched here.
//
// Visual design lifted from the approved mockup: design/help-centre/Main.dc.html
// (desktop 1440) and Phone.dc.html (390) — see HelpHero.astro, HelpTiles.astro
// and HelpFaqStrip.astro for the section-by-section notes on what was copied
// 1:1 vs. adapted. This file owns: the page shell, the `.help-page` colour/
// type token block those three components (and HelpSearch) read from, the
// FAQ data assembly + its ONE FAQPage JSON-LD block (unchanged from
// [WEB-HELP-1] — still the only page in the help centre that emits it; see
// Help.astro's comment and [WEB-SEO-6]'s matching rule for /about), and the
// policies link row.
export const prerender = true;

import Base from '../../layouts/Base.astro';
import HelpHero from '../../components/help/HelpHero.astro';
import HelpTiles from '../../components/help/HelpTiles.astro';
import HelpFaqStrip from '../../components/help/HelpFaqStrip.astro';
import { getHelpTree, helpUrl } from '../../lib/help';
import { ORG } from '../../lib/org';

const tree = await getHelpTree();

type FaqItem = { q: string; a: string; source: string; section: string };
const faqItems: FaqItem[] = tree.flatMap((section) =>
  section.entries.flatMap((entry) =>
    entry.data.faq.map((f) => ({ ...f, source: helpUrl(entry), section: section.label })),
  ),
);

// [WEB-HELP-1, kept verbatim] The ONLY FAQPage JSON-LD block on this page —
// check-help.mjs asserts `"@type":"FAQPage"` appears exactly once in the
// built landing page and exactly zero times on every article page.
const faqLd =
  faqItems.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        '@id': `${ORG.url}help#faq`,
        mainEntity: faqItems.map((f) => ({
          '@type': 'Question',
          name: f.q,
          acceptedAnswer: { '@type': 'Answer', text: f.a },
        })),
      }
    : null;

const POLICY_LINKS = [
  { href: '/terms', label: 'Terms of service' },
  { href: '/privacy', label: 'Privacy policy' },
  { href: '/tokens', label: 'Tokens' },
  { href: '/refunds', label: 'Refunds' },
  { href: '/payouts', label: 'Payouts' },
  { href: '/pricing-fees', label: 'Pricing & fees' },
  { href: '/marketplace-terms', label: 'Marketplace terms' },
];
---

<Base
  title="Help centre"
  description="Guides for booking, paying, creating and getting paid on avaTOK — search or browse by topic."
  image="/og-editorial.png"
>
  {faqLd && <script type="application/ld+json" set:html={JSON.stringify(faqLd).replace(/</g, '\\u003c')} />}

  <main class="help-page">
    <HelpHero />
    <HelpTiles tree={tree} />
    <HelpFaqStrip items={faqItems} />

    <nav class="help-policies" aria-label="Policies">
      <span class="help-policies-label">Policies</span>
      {POLICY_LINKS.map((p, i) => (
        <>
          {i > 0 && <span class="help-policies-dot" aria-hidden="true"> · </span>}
          <a href={p.href}>{p.label}</a>
        </>
      ))}
    </nav>
  </main>
</Base>

<style>
  /* [WEB-HELP-2 2026-09-11] The colour/type custom-property set this whole
     page (and its three help/*.astro children, plus HelpSearch's own
     styles) reads from — mirrors the names layouts/Content.astro scopes on
     `.editorial-page` so HelpSearch (var(--white)/--ink/--blue/--paper/--sky)
     keeps working unmodified now that this page no longer mounts inside
     Content.astro. Values are identical to Content.astro's, not
     reinvented.
     `--help-*` below are the mockup colours that have NO live equivalent
     anywhere in the token set — several hexes exist in ava-tokens.css, but
     that import is dead in production (see global.css's own comment on it),
     so a var(--ava-*) reference would resolve to nothing. Each is commented
     with the mockup's hex so a future re-copy of the design bundle can be
     diffed against it. */
  .help-page {
    /* [WEB-HELP-2 review] Aliased to the live --zine-* tokens (exact hex
       matches, verified against src/styles/tokens.css) instead of repeating
       the literal hex here — one source of truth if the palette ever
       shifts. --pink/--yellow keep their literal hex: no --zine-* token
       matches either value. */
    --paper: var(--zine-paper); --ink: var(--zine-ink); --blue: var(--zine-blueInk);
    --sky: var(--zine-blue); --pink: #f03060; --red: var(--zine-coral);
    --lime: var(--zine-lime); --yellow: #f0d018; --lav: var(--zine-lilac); --white: var(--zine-card);
    --sans: 'Instrument Sans', system-ui, sans-serif;
    --sans-label: 'Nunito', system-ui, sans-serif;
    --serif: 'Playfair Display', Georgia, serif;
    --display: 'Comfortaa', 'Baloo 2', system-ui, sans-serif;

    --help-tan: #c9a86a;          /* mockup: getting-started image-band bg */
    --help-indigo: #3b3f7a;       /* mockup: booking-and-paying tile bg */
    --help-indigo-deep: #2c2f5e;  /* mockup: booking-and-paying image-band bg */
    --help-brick: #b8382a;        /* mockup: creators tile bg + FAQ banner bg */
    --help-brick-deep: #a4352a;   /* mockup: creators image-band bg */
    --help-tan-deep: #b09a76;     /* mockup: billing image-band bg */
    --help-marigold: #ea9101;     /* mockup: account & safety image-band bg */
    --help-answer-red: #b82a19;   /* mockup: FAQ "Read more" link colour */
    --help-faq-eyebrow: #fbe4df;  /* mockup: "Popular questions" label on brick */

    display: block;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--sans);
    font-weight: 500;
  }
  .help-page * { box-sizing: border-box; }
  .help-page a { color: inherit; }

  .help-policies {
    max-width: 110rem;
    margin: 0 auto;
    padding: 0 2.5rem 4.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 0.375rem;
    row-gap: 0.375rem;
    font-family: var(--sans-label);
    font-weight: 700;
    font-size: 0.8125rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--zine-inkMute);
  }
  .help-policies-label { font-weight: 800; margin-right: 0.5rem; }
  .help-policies-dot { color: var(--zine-placeholder); }
  .help-policies a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
  .help-policies a:hover { color: var(--blue); }

  @media (max-width: 599px) {
    .help-policies { padding: 0 1rem 3rem; }
  }
</style>
