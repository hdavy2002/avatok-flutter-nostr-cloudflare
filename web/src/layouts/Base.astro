---
import '../styles/tokens.css';
import '../styles/global.css';
// [WEB-HEADER-1 2026-08-26] SiteHeader replaces Nav.astro site-wide. Nav's five
// menu links pointed at homepage anchors deleted in the redesign (#features,
// #receptionist, #number, #messaging, #faq — all verified absent), so the menu
// was dead on every page that rendered it. SiteHeader carries the real menu and
// matches the home page poster, so the site now has ONE header everywhere.
// Nav.astro is left in the tree for now, unreferenced, in case a page needs the
// old zine chrome back; delete it once that's ruled out.
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

export interface Props {
  title?: string;
  description?: string;
  /** Absolute or path OpenGraph image. */
  image?: string;
  /** Set false to hide the nav/footer chrome (e.g. immersive viewer pages). */
  chrome?: boolean;
  /**
   * [WEB-HEADER-4] Forwarded to SiteHeader. Any page that mounts its OWN Clerk
   * island MUST pass 'static' (or 'in' for signed-in-only pages) — two
   * <ClerkProvider>s on one page throw and the header CTA silently disappears.
   */
  headerAuth?: 'auto' | 'in' | 'static';
  /**
   * Render header CTAs as static Log in / Sign up links (no Clerk island).
   * REQUIRED on pages whose body mounts its own Clerk island, to avoid the
   * "multiple <ClerkProvider>" crash. See Nav.astro.
   */
  navStatic?: boolean;
  /**
   * Emit <meta name="robots" content="noindex,nofollow">. Used for the app-only
   * surfaces (dashboard / vision / admin): they stay reachable by URL but are
   * kept out of search results — web is the public booking funnel.
   */
  noindex?: boolean;
  /** Hide the header auth CTAs (Log in / Sign up) entirely. */
  hideNavCtas?: boolean;
  /**
   * [WEB-SEO-1] Per-page keywords. Google ignores this tag, but the answer
   * engines we care about (and several Indian/regional crawlers) still read it,
   * and it costs nothing. Pages that don't set it inherit the site defaults.
   */
  keywords?: string;
}

const {
  title = 'AvaTok',
  // [WEB-SEO-1 2026-08-27] The old default described the receptionist/private
  // number product. What avaTOK actually sells today is: earn from home by
  // listening, chatting, being a home friend or live streaming. Every page that
  // does not set its own description inherits this, so it is worth getting right.
  description = 'avaTOK is a free platform to earn from home — create a free listing and get paid to listen, chat, be a home friend, host private sessions or live stream. People subscribe to your calendar and book you.',
  image,
  chrome = true,
  headerAuth = 'auto',
  navStatic = false,
  noindex = false,
  hideNavCtas = false,
  keywords = 'avaTOK, work from home India, earn money online from home, get paid to listen, online friend, talk to someone online, paid chat, live streaming platform India, creator marketplace India, side income from home',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://avatok.ai').toString();
// og:image must be an ABSOLUTE url — Facebook, WhatsApp, LinkedIn and Slack all
// drop a relative path, which is why shared links used to render with no card.
//
// [WEB-SEO-1 2026-08-27] It also now DEFAULTS to the brand card instead of being
// undefined. Before this, any page that forgot to pass `image` emitted no
// og:image at all and shared as a bare grey link with `twitter:card=summary`.
const ogImage = new URL(image ?? '/ogimage.jpg', Astro.site ?? 'https://avatok.ai').toString();

// [WEB-SEO-1] Site-wide Organization/WebSite graph. Answer engines read this to
// decide what avaTOK *is*; the home page carries its own richer copy (it emits
// its own <head>), so keep the two consistent.
const orgLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://avatok.ai/#organization',
      name: 'avaTOK',
      alternateName: ['AvaTOK', 'AvaTok', 'avatok.ai'],
      url: 'https://avatok.ai/',
      logo: 'https://avatok.ai/avatok-logo.png',
      image: 'https://avatok.ai/ogimage.jpg',
      description:
        'avaTOK is a free platform where anyone can earn money from home by listening, chatting, being a home friend, hosting private sessions or live streaming. Creators publish a free listing and people book them through their calendar.',
      areaServed: 'IN',
      email: 'support@avatok.ai',
    },
    {
      '@type': 'WebSite',
      '@id': 'https://avatok.ai/#website',
      url: 'https://avatok.ai/',
      name: 'avaTOK',
      inLanguage: 'en-IN',
      publisher: { '@id': 'https://avatok.ai/#organization' },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/app-logo2.png" type="image/png" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    {noindex
      ? <meta name="robots" content="noindex, nofollow" />
      : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />

    <!-- Per-page social meta — pages can add more via the `head` slot. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="avaTOK" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {/* [WEB-SEO-1] Organization + WebSite structured data on every page. */}
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(orgLd)} />}

    {/* [WEB-THEME-1] The Fredoka + Nunito preloads that were here are gone:
        those faces are no longer referenced by any token, so preloading them
        made every page fetch two fonts it never rendered. */}

    {/* [WEB-THEME-1] Brand faces. Also loaded by SiteHeader for the home
        page, which bypasses this layout; duplicate <link>s to the same
        href are de-duplicated by the browser, so this is not a double
        download. Needed here for chrome={false} pages (auth, dashboard)
        that never render SiteHeader. */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Anton&family=Playfair+Display:ital,wght@1,900&family=Instrument+Sans:wght@400;500;600;700&family=Nunito:wght@600;700;800;900&family=Baloo+2:wght@700;800&family=Kalam:wght@400;700&display=swap" />
    {/* [WEB-POSTHOG-1] PostHog core — every page through Base.astro gets it.
        The landing page (index.astro) emits its own document and never
        touches this layout, so it loads the same script separately. */}
    <script>
      import { initAnalytics } from '../lib/analytics';
      initAnalytics();
    </script>
    <slot name="head" />
  </head>
  <body class="min-h-screen bg-paper text-ink font-body">
    {chrome && <SiteHeader auth={headerAuth} />}
    <slot />
    {chrome && <SiteFooter />}
  </body>
</html>
