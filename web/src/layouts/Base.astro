---
import '../styles/tokens.css';
import '../styles/global.css';
// [UI-MOTION-1 2026-09-10] Imported HERE, not via @import in global.css — see
// the long note at that file's old import site. A JS-side import is bundled by
// Vite unconditionally; a late @import is silently dropped.
import '../styles/motion.css';
// [WEB-HEADER-1 2026-08-26] SiteHeader replaces Nav.astro site-wide. Nav's five
// menu links pointed at homepage anchors deleted in the redesign (#features,
// #receptionist, #number, #messaging, #faq — all verified absent), so the menu
// was dead on every page that rendered it. SiteHeader carries the real menu and
// matches the home page poster, so the site now has ONE header everywhere.
// Nav.astro is left in the tree for now, unreferenced, in case a page needs the
// old zine chrome back; delete it once that's ruled out.
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { EMBED_UA_MARKER } from '../lib/embed';

export interface Props {
  title?: string;
  description?: string;
  /** Absolute or path OpenGraph image. */
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  ogType?: "website" | "article";
  /** Set false to hide the nav/footer chrome (e.g. immersive viewer pages). */
  chrome?: boolean;
  /**
   * [WEB-HEADER-4] Forwarded to SiteHeader. Any page that mounts its OWN Clerk
   * island MUST pass 'static' (or 'in' for signed-in-only pages) — two
   * <ClerkProvider>s on one page throw and the header CTA silently disappears.
   */
  headerAuth?: 'auto' | 'in' | 'static';
  /**
   * Render header CTAs as static Log in / Sign up links (no Clerk island).
   * REQUIRED on pages whose body mounts its own Clerk island, to avoid the
   * "multiple <ClerkProvider>" crash. See Nav.astro.
   */
  navStatic?: boolean;
  /**
   * Emit <meta name="robots" content="noindex,nofollow">. Used for the app-only
   * surfaces (dashboard / vision / admin): they stay reachable by URL but are
   * kept out of search results — web is the public booking funnel.
   */
  noindex?: boolean;
  /** Hide the header auth CTAs (Log in / Sign up) entirely. */
  hideNavCtas?: boolean;
  /**
   * [WEB-SEO-1] Optional legacy keywords. Discovery relies on visible content, crawl access
   * and descriptive page metadata; this tag is not a ranking guarantee.
   */
  keywords?: string;
}

const {
  title = 'AvaTok',
  // [WEB-SEO-1 2026-08-27] The old default described the receptionist/private
  // number product. What avaTOK actually sells today is: earn from home by
  // listening, chatting, being a home friend or live streaming. Every page that
  // does not set its own description inherits this, so it is worth getting right.
  description = 'avaTOK is a free platform to earn from home — create a free listing and get paid to listen, chat, be a home friend, host private sessions or live stream. People subscribe to your calendar and book you.',
  image,
  imageAlt = title,
  imageWidth,
  imageHeight,
  ogType = "website",
  chrome = true,
  headerAuth = 'auto',
  navStatic = false,
  noindex = false,
  hideNavCtas = false,
  keywords = 'avaTOK, work from home India, earn money online from home, get paid to listen, online friend, talk to someone online, paid chat, live streaming platform India, creator marketplace India, side income from home',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://avatok.ai').toString();
// [WEB-SEO-2] See the <title> note below. Case-insensitive so "AvaTOK",
// "avatok.ai" and "AvaTok" all count as already branded.
const pageTitle = /avatok/i.test(title) ? title : `${title} · avaTOK`;
// og:image must be an ABSOLUTE url — Facebook, WhatsApp, LinkedIn and Slack all
// drop a relative path, which is why shared links used to render with no card.
//
// [WEB-SEO-1 2026-08-27] It also now DEFAULTS to the brand card instead of being
// undefined. Before this, any page that forgot to pass `image` emitted no
// og:image at all and shared as a bare grey link with `twitter:card=summary`.
const ogImage = new URL(image ?? '/ogimage.jpg', Astro.site ?? 'https://avatok.ai').toString();

// [WEB-SEO-1] Site-wide Organization/WebSite graph. Answer engines read this to
// decide what avaTOK *is*; keep it consistent with the visible copy on /about.
//
// [WEB-SEO-2 2026-09-10] Enriched for Google's knowledge panel and sitelinks.
// The panel Google draws beside a brand search is assembled from the Knowledge
// Graph, and the Knowledge Graph is fed by exactly the fields added here:
// a square logo (>=112px, ImageObject), `sameAs` official profiles, a parent
// organisation, founding date, contact point and a locality. The WebSite node
// gains a SearchAction so Google can offer a sitelinks search box that posts to
// /marketplace?q=. None of this is a ranking signal — it is what lets Google
// SHOW more once the pages rank.
//
// NAMING RULE (owner decision 2026-09-10, consistent with the no-company rule
// in CLAUDE.md): the Organization is the BRAND, avaTOK. `parentOrganization`
// is AvaGlobal Inc (Delaware), which handles international traffic and does
// exist. The Indian entity, Ava Global International Pvt Ltd (Mumbai), is in
// process and is NOT named until it is registered — naming it now would
// contradict /terms#status. When it is registered, add it as `legalName` here
// and update LegalStatus.astro / SiteFooter.astro in the same change.
//
// `sameAs` must only list profiles that resolve today. The Play listing is
// Closed Alpha and returns 404 to the public, so it is deliberately absent —
// a 404 in sameAs is worse than no entry. Add it when the app is public.
const orgLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://avatok.ai/#organization',
      name: 'avaTOK',
      alternateName: ['AvaTOK', 'AvaTok', 'Avatok', 'avatok.ai'],
      url: 'https://avatok.ai/',
      logo: {
        '@type': 'ImageObject',
        '@id': 'https://avatok.ai/#logo',
        url: 'https://avatok.ai/app-logo2.png',
        contentUrl: 'https://avatok.ai/app-logo2.png',
        width: 251,
        height: 256,
        caption: 'avaTOK',
      },
      image: { '@id': 'https://avatok.ai/#logo' },
      description:
        'avaTOK is an India-focused creator marketplace for paid live streaming and 1:1 video sessions. Creators publish listings, people book or join, and creators get paid — including for skills, conversations and experiences hosted from home.',
      slogan: 'Apna hunar. Apni kamaai.',
      foundingDate: '2025',
      parentOrganization: {
        '@type': 'Organization',
        name: 'AvaGlobal Inc',
        address: { '@type': 'PostalAddress', addressRegion: 'Delaware', addressCountry: 'US' },
      },
      address: { '@type': 'PostalAddress', addressLocality: 'Mumbai', addressRegion: 'Maharashtra', addressCountry: 'IN' },
      areaServed: { '@type': 'Country', name: 'India' },
      knowsLanguage: ['en', 'hi'],
      email: 'support@avatok.ai',
      contactPoint: [
        {
          '@type': 'ContactPoint',
          contactType: 'customer support',
          email: 'support@avatok.ai',
          url: 'https://avatok.ai/contact',
          areaServed: 'IN',
          availableLanguage: ['English', 'Hindi'],
        },
      ],
      sameAs: [
        'https://www.youtube.com/@avatok',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': 'https://avatok.ai/#website',
      url: 'https://avatok.ai/',
      name: 'avaTOK',
      alternateName: 'avatok.ai',
      description,
      inLanguage: 'en-IN',
      publisher: { '@id': 'https://avatok.ai/#organization' },
      potentialAction: {
        '@type': 'SearchAction',
        target: {
          '@type': 'EntryPoint',
          urlTemplate: 'https://avatok.ai/marketplace?q={search_term_string}',
        },
        'query-input': 'required name=search_term_string',
      },
    },
    {
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: title,
      description,
      isPartOf: { '@id': 'https://avatok.ai/#website' },
      about: { '@id': 'https://avatok.ai/#organization' },
      inLanguage: 'en-IN',
      primaryImageOfPage: { '@type': 'ImageObject', url: ogImage },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/app-logo2.png" type="image/png" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    {noindex
      ? <meta name="robots" content="noindex, nofollow" />
      : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}
    {/* [WEB-SEO-2] Every title carries the brand once. Sitelinks (the row of
        page links under the main result) are built from titles; "Contact us"
        or "Tokens & Wallet" with no brand read as generic and get dropped. A
        page that already names avaTOK keeps its title untouched. */}
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />

    <!-- Per-page social meta — pages can add more via the `head` slot. -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="avaTOK" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:alt" content={imageAlt} />
    {imageWidth && <meta property="og:image:width" content={imageWidth} />}
    {imageHeight && <meta property="og:image:height" content={imageHeight} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    {/* [WEB-SEO-1] Organization + WebSite structured data on every page. */}
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(orgLd)} />}

    {/* [WEB-THEME-1] The Fredoka + Nunito preloads that were here are gone:
        those faces are no longer referenced by any token, so preloading them
        made every page fetch two fonts it never rendered. */}

    {/* [WEB-THEME-1] Brand faces. Also loaded by SiteHeader for the home
        page, which bypasses this layout; duplicate <link>s to the same
        href are de-duplicated by the browser, so this is not a double
        download. Needed here for chrome={false} pages (auth, dashboard)
        that never render SiteHeader. */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Comfortaa:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,700;0,900;1,700;1,900&family=Instrument+Sans:wght@400;500;600;700&family=Nunito:wght@400;600;700;800;900&family=Baloo+2:wght@600;700;800&family=Kalam:wght@400;700&display=swap" />
    {/* [WEB-POSTHOG-1] PostHog core — every page through Base.astro gets it.
        The landing page (index.astro) emits its own document and never
        touches this layout, so it loads the same script separately. */}
    <script>
      import { initAnalytics } from '../lib/analytics';
      initAnalytics();
    </script>
    {/* [LIST-DETAIL-EMBED-1 2026-09-09] Hide the site's header and footer inside
        the app's WebView — CLIENT-SIDE, on purpose.

        The app shows the website's listing page inside a native screen that
        already has a title bar and a back arrow, and a second header is the
        tell that gives away that a native screen is a web page.

        WHY NOT SERVER-SIDE. The first cut of this read the user agent in this
        frontmatter and rendered a different document. It worked — and it was a
        cache-poisoning bug. `/l/<id>` ships
        `Cache-Control: public, max-age=60, stale-while-revalidate=300` and
        Cloudflare's cache key does NOT include the user agent, so whichever
        client missed the cache first decided what everyone got for the next
        minute: a browser could be served the chrome-less document (a public
        page with no navigation and no footer) or the app could be served the
        full one. `Vary: User-Agent` is not a fix — it is ignored for cache-key
        purposes on this plan, and would wreck the hit rate if it weren't.

        So the DOCUMENT is identical for every client and stays fully
        cacheable; only the local rendering differs. That also means no
        UA-conditional HTML for a crawler to read as cloaking, and the page
        keeps its ordinary robots tag.

        `is:inline` and in <head>: it must run before first paint, or the
        header paints and then vanishes. The attribute lands on <html>, which
        exists by the time this script runs.

        The `ready` ping lives here too, rather than in a React island. It is
        the host's proof that the WebView loaded OUR page (see
        listing_web_detail.dart), and an island would make that proof depend on
        Astro hydration — which is exactly the thing most likely to be missing
        when something has gone wrong. Auth needs no island either:
        lib/clerk.tsx:getActiveToken installs the token bridge on demand. */}
    <script is:inline define:vars={{ marker: EMBED_UA_MARKER }}>
      try {
        if (navigator.userAgent.indexOf(marker) !== -1) {
          document.documentElement.setAttribute('data-avatok-embed', '');
          if (window.AvatokHost && window.AvatokHost.postMessage) {
            window.AvatokHost.postMessage(JSON.stringify({ type: 'ready' }));
          }
        }
      } catch (e) { /* no navigator, or the host is gone — the page still renders */ }
    </script>
    <style is:global>
      html[data-avatok-embed] header.avh,
      html[data-avatok-embed] footer.bazaar-footer { display: none !important; }
      /* The app's WebView is a phone screen with no browser chrome to absorb an
         overscroll, and a horizontal one there reads as a broken page. */
      html[data-avatok-embed], html[data-avatok-embed] body { overscroll-behavior-x: none; }
    </style>
    <slot name="head" />
  </head>
  <body class="min-h-screen bg-paper text-ink font-body">
    {chrome && <SiteHeader auth={headerAuth} />}
    <slot />
    {chrome && <SiteFooter />}
  </body>
</html>
