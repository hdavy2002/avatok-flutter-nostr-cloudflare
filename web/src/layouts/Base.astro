---
import '../styles/tokens.css';
import '../styles/global.css';
// [UI-MOTION-1 2026-09-10] Imported HERE, not via @import in global.css — see
// the long note at that file's old import site. A JS-side import is bundled by
// Vite unconditionally; a late @import is silently dropped.
import '../styles/motion.css';
// Shared CallVaal chrome is static so pages can keep their own auth islands.
import SiteHeader from '../components/callvaal/Header.astro';
import SiteFooter from '../components/callvaal/Footer.astro';
import SeoHead from '../components/SeoHead.astro';
import { EMBED_UA_MARKER } from '../lib/embed';
import { ORG } from '../lib/org';
import { CLERK_PUBLISHABLE_KEY } from '../lib/env';
import { clerkFapiHost } from '../lib/config';
import { clerkJsScriptUrl } from '@clerk/shared/loadClerkJsScript';
import type { PublicContent } from '../lib/seo/types';

export interface Props {
  title?: string;
  titleMessageKey?: string;
  descriptionMessageKey?: string;
  description?: string;
  /** Absolute or path OpenGraph image. */
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  ogType?: "website" | "article" | "profile" | "video.other"; // [HF-EXPLORE-PUBLIC-1] video.other for /r/<id>
  /** Normal content fields used to derive all search/share metadata. */
  content?: PublicContent;
  /** Set false to hide the nav/footer chrome (e.g. immersive viewer pages). */
  chrome?: boolean;
  /** [HF-HEADER-EVERYWHERE-1] Owner 2026-10-24: the front-page header shows on every website page. true = show the
   *  site header even when chrome={false} (auth pages keep no footer). */
  header?: boolean;
  /**
   * Shared chrome uses plain links without an auth island. 'auto' and 'static'
   * use the existing client-side session hint to choose Sign in or Dashboards /
   * Sign out; 'in' explicitly shows the signed-in links.
   */
  headerAuth?: 'auto' | 'in' | 'static';
  /**
   * Legacy compatibility flag for static header links (no Clerk island).
   * The shared header is always island-free, including pages whose body mounts
   * Clerk. Session hints still select the appropriate navigation links.
   */
  navStatic?: boolean;
  /**
   * Emit <meta name="robots" content="noindex,nofollow">. Used for the app-only
   * surfaces (dashboard / vision / admin): they stay reachable by URL but are
   * kept out of search results — web is the public booking funnel.
   */
  noindex?: boolean;
  /** Hide the header auth CTAs (Log in / Sign up) entirely. */
  hideNavCtas?: boolean;
  /**
   * [WEB-SEO-1] Optional legacy keywords. Discovery relies on visible content, crawl access
   * and descriptive page metadata; this tag is not a ranking guarantee.
   */
  keywords?: string;
  /** Optional document language metadata; defaults preserve existing pages. */
  lang?: string;
  dir?: 'ltr' | 'rtl';
  /** Opt-in India chrome language selector/localization. */
  indiaLandingLanguage?: boolean;
  /** [HF-MERCH-FAN-WEB-1] Extra schema.org nodes (each emitted as its own JSON-LD script) for pages with richer facts than PublicContent holds. */
  extraJsonLd?: Record<string, unknown>[];
  /** [HF-CHANNEL-WEB-1] Show the Bag button (with the item count) in the shared header. */
  bag?: boolean;
  /** [HF-CLERK-EARLY-1] Force (true) or suppress (false) the early clerk-js download for signed-in visitors.
   *  Default: on for pages that show nothing without a session (dashboard, bookings, account, wallet). */
  clerkEarly?: boolean;
  /** [HF-SIGNIN-SPEED-1] With clerkEarly: start clerk-js even without a session cookie (the sign-in/sign-up form needs it to submit). */
  clerkEarlyAnon?: boolean;
}

const {
  title = ORG.name,
  titleMessageKey,
  descriptionMessageKey,
  // [WEB-SEO-1 2026-08-27] The old default described the receptionist/private
  // number product. What Saa Thum actually sells today is: earn from home by
  // listening, chatting, being a home friend or live streaming. Every page that
  // does not set its own description inherits this, so it is worth getting right.
  // rebrand: reviewed — [SAATHUM-REBRAND-1] brief §5.1
  description = ORG.description,
  image,
  imageAlt = title,
  imageWidth,
  imageHeight,
  ogType = "website",
  content,
  chrome = true,
  header = false,
  headerAuth = 'auto',
  navStatic = false,
  noindex: noindexProp = false,
  hideNavCtas = false,
  keywords = `${ORG.name}, conversations, shared interests, listening, boundaries`,
  lang = 'en',
  dir = 'ltr',
  indiaLandingLanguage = true,
  extraJsonLd,
  bag = false,
  clerkEarly,
  clerkEarlyAnon = false,
} = Astro.props;

// [HF-CLERK-EARLY-1] Pages that cannot show anything without a session. For a visitor whose Clerk cookie says
// "signed in" (checked in the browser, below) clerk-js is CRITICAL there, so its download starts from <head>
// instead of after island hydration -> lazy chunk -> ClerkProvider mount (~1.2 s later on /dashboard).
// Signed-out visitors and every public page keep the "load later" rule (WEB-PERF).
const AUTH_FIRST_PATH = /^\/(dashboard|bookings|account|wallet)(\/|$)/;
const wantsClerkEarly = clerkEarly ?? AUTH_FIRST_PATH.test(Astro.url.pathname);
let clerkEarlyUrl: string | undefined;
let clerkEarlyHost: string | undefined;
if (wantsClerkEarly && CLERK_PUBLISHABLE_KEY && clerkFapiHost()) {
  try {
    // Same function @clerk/clerk-react's loader calls, with the same inputs (no proxyUrl/domain/clerkJSUrl are
    // configured in lib/clerk.tsx), so the URL is byte-identical to the one the SDK would request.
    clerkEarlyUrl = clerkJsScriptUrl({ publishableKey: CLERK_PUBLISHABLE_KEY });
    clerkEarlyHost = clerkFapiHost();
  } catch { /* leave the normal late path in charge */ }
}

---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    {/* [BRAND-LOGO-1 2026-09-27] Diya-in-white-circle favicon. */}
    <link rel="icon" href="/assets/branding/hf-favicon.png" type="image/png" />
    {/* [WEB-SEO-AUTO-1] One resolver emits the complete metadata set. New
        public routes pass ordinary content data; unclassified routes fail
        closed to noindex instead of inheriting misleading homepage metadata. */}
    <SeoHead
      content={content}
      title={title}
      titleMessageKey={titleMessageKey}
      description={description}
      descriptionMessageKey={descriptionMessageKey}
      image={image}
      imageAlt={imageAlt}
      imageWidth={imageWidth}
      imageHeight={imageHeight}
      ogType={ogType}
      noindex={noindexProp}
      keywords={keywords}
      extraJsonLd={extraJsonLd}
    />

    {/* [WEB-THEME-1] The Fredoka + Nunito preloads that were here are gone:
        those faces are no longer referenced by any token, so preloading them
        made every page fetch two fonts it never rendered. */}

    {/* [WEB-THEME-1] Brand faces. Also loaded by SiteHeader for the home
        page, which bypasses this layout; duplicate <link>s to the same
        href are de-duplicated by the browser, so this is not a double
        download. Needed here for chrome={false} pages (auth, dashboard)
        that never render SiteHeader. */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" onload="this.onload=null;this.rel='stylesheet'" href="https://fonts.googleapis.com/css2?family=Comfortaa:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,700;0,900;1,700;1,900&family=Instrument+Sans:wght@400;500;600;700&family=Nunito:wght@400;600;700;800;900&family=Baloo+2:wght@600;700;800&family=Kalam:wght@400;700&display=swap" />
    {indiaLandingLanguage && <link rel="preload" as="style" onload="this.onload=null;this.rel='stylesheet'" href="https://fonts.googleapis.com/css2?family=Noto+Sans:wght@400;600;700&display=swap" />}
    {/* [HF-CLERK-EARLY-1] Signed-in visitor on an auth-first page: start clerk-js NOW. The script tag carries the
        exact attributes @clerk/clerk-react's loadClerkJsScript sets (data-clerk-js-script, publishable key,
        crossorigin=anonymous); the SDK finds this tag / window.Clerk and reuses it instead of fetching again, and
        ClerkProvider (single instance, lib/clerk.tsx) still calls Clerk.load() when it mounts. The cookie test is the
        same as lib/sessionHint.ts. Anything throwing here just leaves the normal late path. */}
    {clerkEarlyUrl && clerkEarlyHost && (
      <link rel="preconnect" href={`https://${clerkEarlyHost}`} crossorigin />
    )}
    {clerkEarlyUrl && (
      <script is:inline define:vars={{ clerkUrl: clerkEarlyUrl, clerkKey: CLERK_PUBLISHABLE_KEY, embedMarker: EMBED_UA_MARKER, clerkAnon: clerkEarlyAnon }}>
        try {
          var m = document.cookie.match(/(?:^|;\s*)__client_uat(?:_[A-Za-z0-9]+)?=([^;]*)/);
          if ((clerkAnon || (m && m[1] && m[1] !== '0')) && navigator.userAgent.indexOf(embedMarker) === -1 && !document.querySelector('script[data-clerk-js-script]')) {
            var s = document.createElement('script');
            s.async = true;
            s.crossOrigin = 'anonymous';
            s.setAttribute('data-clerk-js-script', 'true');
            s.setAttribute('data-clerk-publishable-key', clerkKey);
            s.src = clerkUrl;
            document.head.appendChild(s);
          }
        } catch (e) { /* the SDK loads clerk-js itself when the provider mounts */ }
      </script>
    )}
    {/* [WEB-POSTHOG-1] PostHog core — every page through Base.astro gets it.
        The landing page (index.astro) emits its own document and never
        touches this layout, so it loads the same script separately. */}
    {/* [HF-SIGNIN-SPEED-1] Same auth-first pages + same cookie test as the clerk-js download above: fetch the site's own
        Clerk chunk (lib/clerk -> clerk-react + bridge) in parallel NOW. Before this, that chunk was only requested after
        the client:only dashboard app rendered <SessionBridge/> (React.lazy), serialising it behind the app bundle. It only
        warms the module cache; nothing mounts until the island asks, so the single-provider rule is untouched. */}
    <script>
      try {
        const m = document.cookie.match(/(?:^|;\s*)__client_uat(?:_[A-Za-z0-9]+)?=([^;]*)/);
        if (m && m[1] && m[1] !== '0' && /^\/(dashboard|bookings|account|wallet)(\/|$)/.test(location.pathname)) {
          void import('../lib/clerk').catch(() => {});
        }
      } catch { /* hint only */ }
    </script>
    <script>
      import { initAnalytics } from '../lib/analytics';
      import { initImageTelemetry } from '../lib/imageTelemetry';
      import '../scripts/hover-prefetch';
      initAnalytics();
      initImageTelemetry();
    </script>
    {/* [LIST-DETAIL-EMBED-1 2026-09-09] Hide the site's header and footer inside
        the app's WebView — CLIENT-SIDE, on purpose.

        The app shows the website's listing page inside a native screen that
        already has a title bar and a back arrow, and a second header is the
        tell that gives away that a native screen is a web page.

        WHY NOT SERVER-SIDE. The first cut of this read the user agent in this
        frontmatter and rendered a different document. It worked — and it was a
        cache-poisoning bug. `/l/<id>` ships
        `Cache-Control: public, max-age=60, stale-while-revalidate=300` and
        Cloudflare's cache key does NOT include the user agent, so whichever
        client missed the cache first decided what everyone got for the next
        minute: a browser could be served the chrome-less document (a public
        page with no navigation and no footer) or the app could be served the
        full one. `Vary: User-Agent` is not a fix — it is ignored for cache-key
        purposes on this plan, and would wreck the hit rate if it weren't.

        So the DOCUMENT is identical for every client and stays fully
        cacheable; only the local rendering differs. That also means no
        UA-conditional HTML for a crawler to read as cloaking, and the page
        keeps its ordinary robots tag.

        `is:inline` and in <head>: it must run before first paint, or the
        header paints and then vanishes. The attribute lands on <html>, which
        exists by the time this script runs.

        The `ready` ping lives here too, rather than in a React island. It is
        the host's proof that the WebView loaded OUR page (see
        listing_web_detail.dart), and an island would make that proof depend on
        Astro hydration — which is exactly the thing most likely to be missing
        when something has gone wrong. Auth needs no island either:
        lib/clerk.tsx:getActiveToken installs the token bridge on demand. */}
    <script is:inline define:vars={{ marker: EMBED_UA_MARKER }}>
      try {
        if (navigator.userAgent.indexOf(marker) !== -1) {
          document.documentElement.setAttribute('data-site-embed', '');
          if (window.SaathumHost && window.SaathumHost.postMessage) {
            window.SaathumHost.postMessage(JSON.stringify({ type: 'ready' }));
          }
        }
      } catch (e) { /* no navigator, or the host is gone — the page still renders */ }
    </script>
    <style is:global>
      html[data-site-embed] header.avh,
      html[data-site-embed] footer.bazaar-footer,
      html[data-site-embed] [data-callvaal-chrome],
      html[data-site-embed] .cv-mobile-booking { display: none !important; }
      /* The app's WebView is a phone screen with no browser chrome to absorb an
         overscroll, and a horizontal one there reads as a broken page. */
      html[data-site-embed], html[data-site-embed] body { overscroll-behavior-x: none; }
    </style>
    <slot name="head" />
  </head>
  <body data-i18n-namespace="web-common" class="min-h-screen bg-paper text-ink font-body">
    {(chrome || header) && <SiteHeader auth={navStatic ? 'static' : headerAuth} hideAuth={hideNavCtas} bag={bag} />}
    <script>
      import { initUiLocale } from '../lib/i18n/dom';
      initUiLocale();
    </script>
    <slot />
    {chrome && <SiteFooter />}
  </body>
</html>
