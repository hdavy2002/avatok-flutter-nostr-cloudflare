---
// [WEB-HELP-2 2026-09-11] Redesigned help-ARTICLE layout, replacing the
// WEB-HELP-1 version. Per design/help-centre/Article.dc.html (1440) and
// PhoneArticle.dc.html (390) — the approved mockup, values lifted verbatim
// (px converted to rem at a 16px root).
//
// WHY Base.astro DIRECTLY, NOT Content.astro: the mockup's band/rail/article/
// on-this-page composition doesn't fit Content.astro's single-column
// "editorial" shape (fixed max-width, decorative circle, kicker/lead
// pattern) at all — forcing it through Content.astro would mean fighting
// that layout with overrides rather than building the one the mockup shows.
// pages/marketplace.astro is the precedent for a page composing Base.astro's
// SiteHeader/SiteFooter chrome directly with its own full-bleed bands.
//
// Props are unchanged from WEB-HELP-1 (entry/tree/prev/next) plus `headings`
// — [...slug].astro now passes the `headings` array `render(entry)` already
// returns, so this layout never has to re-parse the article body to build
// "On this page".
import Base from './Base.astro';
import HelpSearch from '../components/HelpSearch.astro';
import HelpRailNav from '../components/HelpRailNav.astro';
import HelpOnThisPage from '../components/help/HelpOnThisPage.astro';
// [WEB-HELP-2] The chai truck-art strip the mockup shows between the header
// and the band (Article.dc.html / PhoneArticle.dc.html, both #3a3a9e teacup
// rows) — same component marketplace.astro/BazaarHero.astro use, not a
// bespoke re-draw.
import TruckBorder from '../components/TruckBorder.astro';
import { SECTIONS, helpUrl, type HelpEntry, type HelpTreeSection, type HelpSectionId } from '../lib/help';
import { ORG } from '../lib/org';

export interface Props {
  entry: HelpEntry;
  tree: HelpTreeSection[];
  prev?: HelpEntry;
  next?: HelpEntry;
  headings: { depth: number; slug: string; text: string }[];
}

const { entry, tree, prev, next, headings } = Astro.props;
const sectionId = entry.data.section as HelpSectionId;
const section = SECTIONS[sectionId];

// [WEB-HELP-2] Section "stamp" art — the mockup shows one for billing
// (khasta-kachori.jpg) and booking-and-paying (pani-puri.jpg) only; every
// other section has no matching prop in web/public/help/art, so the slot is
// simply omitted there rather than reusing an unrelated image.
const STAMPS: Partial<Record<HelpSectionId, string>> = {
  billing: '/help/art/khasta-kachori.jpg',
  'booking-and-paying': '/help/art/pani-puri.jpg',
};
const stampSrc = STAMPS[sectionId];

// [WEB-HELP-2] A hand-rolled day + 3-letter-month formatter, not
// toLocaleDateString — the locale API depends on the ICU data actually
// built into whatever Node runs `astro build`, which isn't guaranteed
// across environments, so "en-GB" can silently render wrong (or throw) on a
// build image with reduced ICU. A 12-entry lookup has no such dependency.
const MONTHS_SHORT = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const updatedLabel = `${entry.data.updated.getDate()} ${MONTHS_SHORT[entry.data.updated.getMonth()]}`;
// [WEB-HELP-2] The mockup's "Updated 11 Sep 2026 · For buyers and creators"
// meta line maps straight onto the content schema's existing `audience`
// field (content.config.ts) — no new data needed.
const AUDIENCE_LABEL: Record<'buyer' | 'creator' | 'both', string> = {
  buyer: 'For buyers',
  creator: 'For creators',
  both: 'For buyers and creators',
};
const audienceLabel = AUDIENCE_LABEL[entry.data.audience];

// [WEB-HELP-2] Depth-2 headings only, per the mockup's "On this page" list
// (it skips h3s). Fewer than 2 of them and the component earns no place —
// Help.astro decides that once here rather than each render site re-deriving
// the same rule.
const otpHeadings = headings.filter((h) => h.depth === 2);
const showOtp = otpHeadings.length >= 2;

// [WEB-HELP-1 2026-09-11, kept] Related-policy links only make sense where
// the article is the plain-English cousin of an actual policy page — billing
// and booking-and-paying. Every other section has no single matching policy.
const RELATED_POLICIES: { href: string; label: string }[] = [
  { href: '/tokens', label: 'Tokens' },
  { href: '/refunds', label: 'Refunds' },
  { href: '/payouts', label: 'Payouts' },
  { href: '/marketplace-terms', label: 'Marketplace terms' },
];
const showRelatedPolicies = sectionId === 'billing' || sectionId === 'booking-and-paying';

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Help', item: `${ORG.url}help` },
    { '@type': 'ListItem', position: 2, name: section.label, item: `${ORG.url}help#${sectionId}` },
    { '@type': 'ListItem', position: 3, name: entry.data.title, item: `${ORG.url}${helpUrl(entry).slice(1)}` },
  ],
};
// [WEB-HELP-1, kept] JSON-LD must never let a literal "</script" close the
// tag early if a title/field ever contains it.
const breadcrumbLdJson = JSON.stringify(breadcrumbLd).replace(/</g, '\\u003c');
---

<Base title={entry.data.title} description={entry.data.description}>
  <script type="application/ld+json" set:html={breadcrumbLdJson} />

  <div class="help-page">
    <section class="help-band">
      <TruckBorder kind="chai" />
      <div class="help-band-inner">
        <div class="help-band-text">
          <p class="help-breadcrumb">
            <a href="/help">Help centre</a>
            <span aria-hidden="true">/</span>
            <span class="help-breadcrumb-current">{section.label}</span>
          </p>
          <h1>{entry.data.title}</h1>
          <div class="help-band-desc-row">
            <p class="help-desc">{entry.data.description}</p>
            {stampSrc && (
              <img
                class="help-stamp help-stamp-mobile"
                src={stampSrc}
                width="84"
                height="126"
                alt=""
              />
            )}
          </div>
          <p class="help-updated">Updated {updatedLabel} · {audienceLabel}</p>
        </div>

        <div class="help-band-aside">
          <div class="help-band-search"><HelpSearch size="band" id="band" /></div>
          {stampSrc && (
            <img
              class="help-stamp help-stamp-desktop"
              src={stampSrc}
              width="150"
              height="225"
              alt=""
            />
          )}
        </div>
      </div>
    </section>

    <div class="help-layout">
      {/* [WEB-HELP-2] A plain <div>, not <aside> — HelpRailNav.astro already
          renders its own <nav aria-label="Help sections"> inside here, so an
          outer landmark would just nest a second, differently-worded
          landmark around the first one for no reason. */}
      <div class="help-rail-col">
        {/* Desktop (>=1024px): a plain, always-visible nav — see the
            [WEB-HELP-1] note kept in HelpRailNav.astro for why this can't be
            a <details> forced open with CSS. Rendering it twice (this div +
            the <details> below) from the same tree/entry props keeps the two
            from ever diverging. */}
        <div class="help-rail-desktop">
          <HelpRailNav tree={tree} entry={entry} />
        </div>

        {/* <1024px: collapsible "Browse help" control, matching
            PhoneArticle.dc.html — carries its own search box since the band
            search above is hidden at this width. */}
        <details class="help-rail-toggle">
          <summary>
            <span class="help-rail-toggle-title">Browse help</span>
            <span class="help-rail-toggle-icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"></path></svg>
            </span>
          </summary>
          <div class="help-rail-body">
            <div class="help-rail-search"><HelpSearch variant="rail" id="mobile" /></div>
            <HelpRailNav tree={tree} entry={entry} />
          </div>
        </details>
      </div>

      <main class="help-main">
        {/* 1024-1199px only: "On this page" collapses above the article
            instead of sitting in its own column (there isn't room for a
            third column yet). */}
        {showOtp && (
          <details class="help-otp-collapse">
            <summary>On this page</summary>
            <HelpOnThisPage headings={otpHeadings} />
          </details>
        )}

        <article class="help-article">
          <slot />
        </article>

        <nav class="help-prevnext" aria-label="More in this section">
          {prev && (
            <a class="help-prevnext-link help-prev" href={helpUrl(prev)}>
              <span class="help-prevnext-dir">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H6"></path><path d="M11 6l-6 6 6 6"></path></svg>
                Previous
              </span>
              <span class="help-prevnext-title">{prev.data.title}</span>
            </a>
          )}
          {next && (
            <a class="help-prevnext-link help-next" href={helpUrl(next)}>
              <span class="help-prevnext-dir">
                Next
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h13"></path><path d="M13 6l6 6-6 6"></path></svg>
              </span>
              <span class="help-prevnext-title">{next.data.title}</span>
            </a>
          )}
        </nav>

        {showRelatedPolicies && (
          <div class="help-related">
            <span class="help-related-label">Related policies</span>
            {RELATED_POLICIES.map((p) => (
              <a class="help-related-chip" href={p.href}>{p.label}</a>
            ))}
            <img
              class="help-related-kettle"
              src="/help/art/kettle.png"
              width="220"
              height="246"
              alt=""
              loading="lazy"
            />
          </div>
        )}
      </main>

      {/* [WEB-HELP-2] Plain <div> — HelpOnThisPage.astro already renders its
          own <nav aria-label="On this page">, so an outer aside with the
          SAME label would announce "On this page" twice for one landmark. */}
      {showOtp && (
        <div class="help-otp-col">
          <HelpOnThisPage headings={otpHeadings} />
        </div>
      )}
    </div>
  </div>
</Base>

<style>
  /* [WEB-HELP-2 2026-09-11] Scoped to this layout. `--ava-*` custom
     properties (src/styles/ava-tokens.css) are NOT actually reaching
     production: global.css's `@import './ava-tokens.css'` sits after a real
     rule, so the CSS spec drops it (see the note at global.css's import
     site — verified with `grep -- '--ava-' dist/_astro/*.css` finding
     consumers but zero definitions). This layout, HelpRailNav.astro and
     HelpOnThisPage.astro all reference `--ava-*` names, so every one of
     those references was resolving to nothing (no border, no colour, no
     shadow, no radius) in the built site. Rather than reviving the dead
     import site-wide (a visual change to every OTHER page, deliberately
     left alone), alias just the names this help subtree consumes to their
     real values, scoped to `.help-page` — custom properties inherit
     through the DOM, so HelpRailNav.astro and HelpOnThisPage.astro (both
     always rendered inside this element) pick these up too. Aliased to
     `src/styles/tokens.css`'s `--zine-*` set (generated at build time, so
     it can never silently go stale like the dead import did) wherever a
     `--zine-*` token carries the exact same value; the few with no
     `--zine-*` match keep their literal hex, each commented. */
  .help-page {
    --ava-ink: var(--zine-ink);
    --ava-ink-soft: #2A1C16; /* no --zine-* equivalent (--zine-inkSoft is a different colour, #5A3D33) */
    --ava-bone: var(--zine-card);
    --ava-oat: var(--zine-lilac);
    --ava-butter: var(--zine-blue);
    --ava-signal: var(--zine-coral);
    --ava-signal-deep: #B82A19; /* no --zine-* equivalent */
    --ava-brick: #B8382A; /* mockup creators-section swatch, Article.dc.html line 33 — no --zine-* equivalent */
    --ava-teal-deep: var(--zine-blueInk);
    --ava-text-body: var(--zine-inkSoft);
    --ava-text-label: var(--zine-inkMute);
    --ava-text-placeholder: var(--zine-placeholder);
    --ava-font-sans: 'Instrument Sans', system-ui, sans-serif;
    --ava-font-stub: 'Nunito', system-ui, sans-serif;
    --ava-border: 0.15625rem solid var(--ava-ink); /* 2.5px */
    --ava-border-strong: 0.1875rem solid var(--ava-ink); /* 3px */
    --ava-border-hairline: 0.09375rem solid rgba(22, 22, 20, 0.2); /* 1.5px */
    --ava-rule: 0.125rem solid rgba(22, 22, 20, 0.18); /* 2px */
    --ava-shadow-sm: 0.25rem 0.3125rem 0 var(--ava-ink); /* 4px 5px 0 */
    --ava-shadow-md: 0.3125rem 0.375rem 0 var(--ava-ink); /* 5px 6px 0 */
    --ava-radius-lg: 1rem; /* 16px */
    --ava-radius-xl: 1.25rem; /* 20px */
    --ava-focus-ring: 0.1875rem solid var(--ava-signal); /* 3px */
    --ava-focus-offset: 0.125rem; /* 2px */
    --ava-hover-lift: translate(-0.125rem, -0.125rem); /* -2px, -2px */

    --help-indigo: #3b3f7a; /* mockup Article.dc.html line 30 booking-and-paying swatch — same value the landing page uses; no --zine-* equivalent */

    /* [WEB-HELP-2] HelpSearch.astro (owned by the concurrent WEB-HELP-2
       landing-page agent, not touched here — it's also getting its own
       self-contained fallbacks, so this is belt and braces) still styles
       itself entirely off --ink/--white/--blue/--sans/--paper/--sky/--red/
       --display — the names Content.astro's .editorial-page block used to
       provide as an ancestor. This layout no longer wraps in Content.astro,
       so without these the search box would render with undefined custom
       properties. Custom properties inherit through the DOM regardless of
       Astro's per-component style scoping, so defining the SAME values
       Content.astro used (not new colours) here keeps HelpSearch working
       unchanged. Remove once HelpSearch.astro is migrated off these names. */
    --ink: var(--ava-ink);
    --white: var(--ava-bone);
    --blue: var(--ava-teal-deep);
    --sans: var(--ava-font-sans);
    --paper: var(--zine-paper);
    --sky: var(--zine-blue);
    --red: var(--zine-coral);
    --display: 'Comfortaa', 'Baloo 2', system-ui, sans-serif;
  }

  /* ---------- Band ---------- */
  .help-band {
    background: var(--ava-oat);
    border-top: var(--ava-border-strong);
    border-bottom: var(--ava-border-strong);
  }
  .help-band-inner {
    max-width: 110rem; /* 1760px, per the mockup */
    margin: 0 auto;
    padding: 1.25rem 1rem 1.625rem;
    display: flex;
    flex-direction: column;
  }
  .help-band-text { min-width: 0; }
  .help-breadcrumb {
    margin: 0 0 0.875rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--ava-font-stub);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ava-text-body);
  }
  .help-breadcrumb a {
    color: var(--ava-text-body);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
  .help-breadcrumb a:focus-visible { outline: var(--ava-focus-ring); outline-offset: var(--ava-focus-offset); }
  .help-breadcrumb-current { color: var(--ava-ink); }

  .help-page h1 {
    margin: 0;
    font-family: 'Comfortaa', 'Baloo 2', system-ui, sans-serif;
    font-weight: 400;
    text-transform: uppercase;
    /* [WEB-HELP-2] CLAUDE.md's type rules floor display-headline tracking at
       0.055em letter-spacing / 0.2em word-spacing (never negative, never
       below that on bold/display type) — the mockup's own mobile h1 uses a
       tighter 0.04em/0.12em, but the house rule wins over literal mockup
       fidelity here. Same values the desktop breakpoint already used, so
       there's now nothing to override there. */
    letter-spacing: 0.055em;
    word-spacing: 0.2em;
    font-size: 1.875rem;
    line-height: 1.15;
    color: var(--ava-ink);
    overflow-wrap: anywhere; /* long titles never clip against the viewport edge */
  }

  .help-band-desc-row {
    margin-top: 0.875rem;
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }
  .help-desc {
    flex: 1;
    min-width: 0;
    margin: 0;
    font-family: var(--ava-font-sans);
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.5;
    color: var(--ava-ink-soft);
    text-wrap: pretty;
  }
  .help-updated {
    margin: 0.875rem 0 0;
    font-family: var(--ava-font-stub);
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ava-text-body);
  }

  .help-stamp {
    display: block;
    flex: none;
    object-fit: cover;
    object-position: 50% 50%;
    border: var(--ava-border-strong);
    background: var(--ava-bone);
  }
  .help-stamp-mobile {
    width: 5.25rem; /* 84px */
    height: 7.875rem; /* 126px */
    border-radius: 0.5rem;
    box-shadow: var(--ava-shadow-sm);
    transform: rotate(-3deg);
    margin: 0.25rem 0.25rem 0 0;
  }
  .help-band-aside { display: none; }

  @media (min-width: 1024px) {
    .help-band-inner {
      padding: 2.25rem 2rem 2.75rem;
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: 3rem;
    }
    .help-band-text { flex: 1 1 0; }
    .help-breadcrumb { margin-bottom: 1.125rem; font-size: 0.8125rem; }
    .help-page h1 {
      /* letter-spacing/word-spacing now match the base rule above — no
         override needed at this breakpoint. */
      font-size: clamp(2.5rem, 4.2vw, 3.875rem);
      line-height: 1.12;
    }
    .help-desc { max-width: 62ch; font-size: 1.1875rem; }
    .help-updated { font-size: 0.75rem; }
    .help-stamp-mobile { display: none; }

    .help-band-aside {
      display: flex;
      flex: none;
      align-items: flex-end;
      gap: 2.25rem;
    }
    .help-band-search { padding-bottom: 0.25rem; width: 27.5rem; max-width: 100%; }
    .help-stamp-desktop {
      width: 9.375rem; /* 150px */
      height: 14.0625rem; /* 225px */
      border-radius: 0.625rem;
      box-shadow: var(--ava-shadow-md);
      transform: rotate(-3deg);
    }
  }

  /* ---------- Below the band: rail / article / on-this-page ---------- */
  .help-layout {
    max-width: 110rem;
    margin: 0 auto;
    padding: 2rem 1rem 4rem;
  }
  .help-rail-desktop { display: none; }

  .help-rail-toggle {
    border: var(--ava-border);
    border-radius: var(--ava-radius-xl);
    background: var(--ava-bone);
    box-shadow: var(--ava-shadow-sm);
    padding: 0.5rem 1rem;
    margin-bottom: 1.5rem;
  }
  .help-rail-toggle summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.2rem;
    min-height: 2.5rem;
  }
  .help-rail-toggle summary::-webkit-details-marker { display: none; }
  .help-rail-toggle summary:focus-visible { outline: var(--ava-focus-ring); outline-offset: var(--ava-focus-offset); border-radius: 0.5rem; }
  .help-rail-toggle-title {
    font-family: 'Comfortaa', 'Baloo 2', system-ui, sans-serif;
    font-weight: 700;
    font-size: 1.0625rem;
    letter-spacing: 0.04em; /* CLAUDE.md type rules: bold UI labels 0.04em-0.08em */
    color: var(--ava-ink);
  }
  .help-rail-toggle-icon {
    margin-left: auto;
    flex: none;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    border: 2px solid var(--ava-ink);
    background: var(--ava-butter);
    color: var(--ava-ink);
    transition: transform 0.15s ease;
  }
  .help-rail-toggle[open] .help-rail-toggle-icon { transform: rotate(180deg); }
  .help-rail-body { padding: 0 0.2rem 1.1rem; }
  .help-rail-search { margin-bottom: 1.1rem; }

  .help-main { min-width: 0; }
  .help-otp-col { display: none; } /* shown only at >=1200px, below */
  .help-otp-collapse {
    display: none;
    border: var(--ava-border-hairline);
    border-radius: var(--ava-radius-lg);
    padding: 0.5rem 1rem;
    margin-bottom: 2rem;
  }
  .help-otp-collapse summary {
    list-style: none;
    cursor: pointer;
    padding: 0.6rem 0.2rem;
    font-family: var(--ava-font-stub);
    font-weight: 800;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ava-text-label);
  }
  .help-otp-collapse summary::-webkit-details-marker { display: none; }
  .help-otp-collapse[open] summary { margin-bottom: 0.5rem; }
  .help-otp-collapse summary:focus-visible { outline: var(--ava-focus-ring); outline-offset: var(--ava-focus-offset); }

  .help-article {
    max-width: 74ch;
    font-size: 1.0625rem; /* 17px mobile, mockup's mobile article body */
  }
  .help-article :global(> :first-child) { margin-top: 0; }
  /* [WEB-HELP-1, kept] Tailwind-style preflight (global.css) sets p{margin:0}
     and strips list markers — restore both, scoped to the article body. */
  .help-article :global(> * + *) { margin-top: 1.375rem; }
  .help-article :global(ul),
  .help-article :global(ol) { padding-left: 1.25rem; }
  .help-article :global(ul) { list-style: disc; }
  .help-article :global(ol) { list-style: decimal; }
  .help-article :global(p) {
    font-family: var(--ava-font-sans);
    font-weight: 500;
    line-height: 1.65;
    color: var(--ava-text-body);
    text-wrap: pretty;
  }
  .help-article :global(h2) {
    margin-top: 2.75rem;
    font-family: 'Comfortaa', 'Baloo 2', sans-serif;
    font-weight: 700;
    font-size: 1.5rem;
    line-height: 1.2;
    letter-spacing: 0.04em; /* CLAUDE.md type rules: bold UI labels 0.04em-0.08em */
    color: var(--ava-ink);
    text-wrap: pretty;
  }
  .help-article :global(h3) {
    margin-top: 2rem;
    font-family: 'Comfortaa', 'Baloo 2', sans-serif;
    font-weight: 700;
    font-size: 1.1875rem;
    line-height: 1.25;
    letter-spacing: 0.04em; /* CLAUDE.md type rules: bold UI labels 0.04em-0.08em */
    color: var(--ava-ink);
  }
  .help-article :global(a) {
    color: var(--ava-teal-deep);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
    font-weight: 600;
  }
  .help-article :global(strong) { font-weight: 700; color: var(--ava-ink); }

  .help-prevnext {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.125rem;
    margin-top: 2.75rem;
    padding-top: 1.75rem;
    border-top: var(--ava-rule);
  }
  .help-prevnext-link {
    display: flex;
    flex-direction: column;
