---
// [WEB-HELP-SKIN-2 2026-09-27] Help ARTICLE layout, rebuilt to the owner-approved
// "help skin v2" mockup (design/help-centre/saathum-help-skin-v2.src.html, view
// "Article page"). Replaces the [WEB-HELP-2] zine article layout (truck-art
// strip, lavender band, --ava-* alias block — all gone).
//
// NOTE FOR AI:
//  - Same shell as pages/help/index.astro and pages/marketplace.astro: Base
//    chrome={false}, `.folk-site[data-design="saathum-reference-v5"]` wrapper,
//    SiteHeader/SiteFooter `folk`. Styles: styles/help-skin.css (`.hs`).
//  - Terracotta band: breadcrumb, h1 (plain cream — the mockup's marigold
//    keyword needs per-article markup we don't have), lead = description,
//    meta pills (reading time, updated date, audience), compact search.
//  - Below: rail (HelpRailNav) | white article card | "On this page" + the
//    "Ready to book?" nudge (HelpOnThisPage). Toc hidden <=1400px, rail becomes
//    a chip row <=1100px, phone rules <=600px — all in help-skin.css.
//  - The mini-FAQ is built from the entry's own `faq[]` as plain <details>. It
//    must NOT emit FAQPage JSON-LD: the landing page is the only emitter and
//    check-help.mjs fails an article that carries it.
//  - BreadcrumbList JSON-LD comes from Base via `content.breadcrumbs` — exactly
//    once per article (check-help.mjs). Do not add a second one here.
//  - "Did this answer your question?" buttons are inert for now (no endpoint);
//    wire them to PostHog before calling them feedback.
import Base from './Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import HelpSearch from '../components/HelpSearch.astro';
import HelpRailNav from '../components/HelpRailNav.astro';
import HelpOnThisPage from '../components/help/HelpOnThisPage.astro';
import { SECTIONS, helpUrl, type HelpEntry, type HelpTreeSection, type HelpSectionId } from '../lib/help';
import { publicImage } from '../lib/config';
import { HOME_HEADER_LINKS } from '../lib/homeNavigation';
import { ORG } from '../lib/org';
import type { PublicContent } from '../lib/seo/types';
import { readMinutes, dateLabel, AUDIENCE_LABEL } from '../components/help/helpSkin';
import '../styles/saathum-folk.css';
import '../styles/help-skin.css';

export interface Props {
  entry: HelpEntry;
  tree: HelpTreeSection[];
  prev?: HelpEntry;
  next?: HelpEntry;
  headings: { depth: number; slug: string; text: string }[];
}

const { entry, tree, prev, next, headings } = Astro.props;
const sectionId = entry.data.section as HelpSectionId;
const section = SECTIONS[sectionId];
const updated = dateLabel(entry.data.updated);
const articleCount = tree.reduce((sum, s) => sum + s.entries.length, 0);

const canonicalPath = helpUrl(entry);
const content: PublicContent = {
  kind: 'help',
  key: entry.id,
  canonicalPath,
  title: entry.data.title,
  summary: entry.data.description,
  visibility: 'public',
  modifiedAt: entry.data.updated.toISOString(),
  breadcrumbs: [
    { name: 'Help', path: '/help' },
    { name: section.label, path: `/help#${sectionId}` },
    { name: entry.data.title, path: canonicalPath },
  ],
  article: {
    authorName: ORG.name,
    section: section.label,
    keywords: entry.data.keywords,
  },
};
---
<Base content={content} chrome={false} indiaLandingLanguage={false}>
  <Fragment slot="head">
    <meta name="theme-color" content="#fff8e8" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Comfortaa:wght@400;500;600;700&family=Nunito:wght@400;600;700;800;900&display=swap" />
  </Fragment>
  <div class="folk-site" data-design="saathum-reference-v5" style={`--folk-border-url:url(${publicImage('/assets/saathum-bright/border.png', { width: 640, fit: 'scale-down' })})`}>
    <a class="folk-skip" href="#main-content">Skip to main content</a>
    <SiteHeader folk indiaLandingLanguage={false} responsiveHome referenceHome links={HOME_HEADER_LINKS} />
    <main id="main-content" class="hs hs-article-page">
      <section class="hs-aband" aria-labelledby="art-title">
        <div class="hs-aband-inner">
          <div>
            <nav class="hs-crumbs" aria-label="Breadcrumb"><a href="/help">Help</a><i aria-hidden="true">/</i><a href={`/help#${sectionId}`}>{section.label}</a><i aria-hidden="true">/</i><span aria-current="page">{entry.data.title}</span></nav>
            <h1 id="art-title">{entry.data.title}</h1>
            <p class="hs-lead">{entry.data.description}</p>
            <div class="hs-aband-meta"><span>Read in {readMinutes(entry)} min</span><span>Updated {updated}</span><span>{AUDIENCE_LABEL[entry.data.audience]}</span></div>
          </div>
          <HelpSearch id="band" compact label="Search help" button="Go" placeholder={`Search all ${articleCount} articles…`} />
        </div>
      </section>
      <div class="grand-divider" aria-hidden="true"></div>

      <div class="hs-wrap hs-article-wrap">
        <HelpRailNav tree={tree} entry={entry} />

        <div>
          <article class="hs-article">
            <div class="hs-prose">
              <slot />

              {entry.data.faq.length > 0 && (
                <div class="hs-mini-faq" role="group" aria-label="Quick answers">
                  {entry.data.faq.map((f, i) => (
                    <details open={i === 0}><summary>{f.q}</summary><p>{f.a}</p></details>
                  ))}
                </div>
              )}

              <div class="hs-helpful"><span>Did this answer your question?</span><button type="button">Yes</button><button type="button">Not really</button><small>Updated {updated}</small></div>
            </div>
          </article>
          {(prev || next) && (
            <nav class="hs-prevnext" aria-label="More in this section">
              {prev && <a href={helpUrl(prev)}><small>← Previous</small><b>{prev.data.title}</b></a>}
              {next && <a class="hs-next" href={helpUrl(next)}><small>Next →</small><b>{next.data.title}</b></a>}
            </nav>
          )}
        </div>

        <aside class="hs-toc-col" aria-label="Page tools">
          <HelpOnThisPage headings={headings}>
            <div class="hs-toc-cta"><b>Ready to book?</b><span>Performed live by temple priests, in your name.</span><a href="/marketplace">Join a havan →</a></div>
          </HelpOnThisPage>
        </aside>
      </div>
    </main>
    <SiteFooter folk indiaLandingLanguage={false} />
  </div>
</Base>
