---
// [HELLO-FRAANDS-HELP-1 2026-10-08] Help ARTICLE layout in the current-brand
// notebook look. Replaces the Aum Fe help skin (folk chrome, temple CTA).
//
// NOTE FOR AI:
//  - Base with the default chrome = shared current-brand header/footer. Base also
//    emits the BreadcrumbList JSON-LD from `content.breadcrumbs` (check-help.mjs
//    requires exactly one per article, and NO FAQPage on articles).
//  - Styles: styles/hello-fraands-help.css, scoped under `.hf-help`.
//  - Left rail = every topic and its articles; right rail = this page's `##` headings.
import Base from './Base.astro';
import HelpSearch from '../components/HelpSearch.astro';
import { SECTIONS, helpUrl, type HelpEntry, type HelpTreeSection, type HelpSectionId } from '../lib/help';
import { ORG } from '../lib/org';
import type { PublicContent } from '../lib/seo/types';
import { readMinutes, dateLabel, AUDIENCE_LABEL } from '../components/help/helpSkin';
import { BRAND } from '../lib/brand';
import '../styles/hello-fraands-help.css';

export interface Props {
  entry: HelpEntry;
  tree: HelpTreeSection[];
  prev?: HelpEntry;
  next?: HelpEntry;
  headings: { depth: number; slug: string; text: string }[];
}

const { entry, tree, prev, next, headings } = Astro.props;
const sectionId = entry.data.section as HelpSectionId;
const section = SECTIONS[sectionId];
const updated = dateLabel(entry.data.updated);
const articleCount = tree.reduce((sum, s) => sum + s.entries.length, 0);
const toc = headings.filter((h) => h.depth === 2);

const canonicalPath = helpUrl(entry);
const content: PublicContent = {
  kind: 'help',
  key: entry.id,
  canonicalPath,
  title: entry.data.title,
  summary: entry.data.description,
  visibility: 'public',
  modifiedAt: entry.data.updated.toISOString(),
  breadcrumbs: [
    { name: 'Help', path: '/help' },
    { name: section.label, path: `/help#${sectionId}` },
    { name: entry.data.title, path: canonicalPath },
  ],
  article: {
    authorName: ORG.name,
    section: section.label,
    keywords: entry.data.keywords,
  },
};
---
<Base content={content} indiaLandingLanguage={false}>
  <Fragment slot="head">
    <meta name="theme-color" content="#46113e" />
  </Fragment>
  <main id="main-content" class="hf-help hf-help-article">
    <section class={`hfh-aband tone-${section.tone}`} aria-labelledby="art-title">
      <nav class="hfh-crumbs" aria-label="Breadcrumb"><a href="/help">Help</a><i aria-hidden="true">/</i><a href={`/help#${sectionId}`}>{section.label}</a><i aria-hidden="true">/</i><span aria-current="page">{entry.data.title}</span></nav>
      <h1 id="art-title">{entry.data.title}</h1>
      <p class="hfh-lead">{entry.data.description}</p>
      <div class="hfh-meta"><span>Read in {readMinutes(entry)} min</span><span>Updated {updated}</span><span>{AUDIENCE_LABEL[entry.data.audience]}</span></div>
      <HelpSearch id="band" compact label="Search help" button="Go" placeholder={`Search all ${articleCount} articles…`} />
    </section>

    <div class="hfh-article-wrap">
      <nav class="hfh-rail" aria-label="Help topics">
        <details open>
          <summary>All help topics</summary>
          {tree.map((s) => (
            <div class:list={['hfh-rail-group', { 'is-current': s.id === sectionId }]}>
              <a class="hfh-rail-head" href={`/help#${s.id}`}><span aria-hidden="true">{s.icon}</span>{s.label}</a>
              {s.id === sectionId && (
                <ul>
                  {s.entries.map((e) => <li><a href={helpUrl(e)} aria-current={e.id === entry.id ? 'page' : undefined}>{e.data.title}</a></li>)}
                </ul>
              )}
            </div>
          ))}
        </details>
      </nav>

      <div class="hfh-main">
        <article class="hfh-article">
          <div class="hfh-prose">
            <slot />
          </div>
          {entry.data.faq.length > 0 && (
            <div class="hfh-mini-faq" role="group" aria-label="Quick answers">
              <h2>Quick answers</h2>
              {entry.data.faq.map((f, i) => (
                <details open={i === 0}><summary><span>{f.q}</span><b aria-hidden="true">+</b></summary><p>{f.a}</p></details>
              ))}
            </div>
          )}
        </article>
        {(prev || next) && (
          <nav class="hfh-prevnext" aria-label="More in this topic">
            {prev && <a href={helpUrl(prev)}><small>← Previous</small><b>{prev.data.title}</b></a>}
            {next && <a class="hfh-next" href={helpUrl(next)}><small>Next →</small><b>{next.data.title}</b></a>}
          </nav>
        )}
        <aside class="hfh-still">
          <b>Still need help?</b>
          <span>Write to <code>support (@) {BRAND.domain}</code> with your call ID, date and time. Never send an OTP or UPI PIN.</span>
          <a href="/report">Report a problem →</a>
        </aside>
      </div>

      {toc.length > 1 && (
        <aside class="hfh-toc" aria-label="On this page">
          <b>On this page</b>
          <ul>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul>
          <a class="hfh-toc-faq" href="/faq">See all FAQs →</a>
        </aside>
      )}
    </div>
  </main>
</Base>
