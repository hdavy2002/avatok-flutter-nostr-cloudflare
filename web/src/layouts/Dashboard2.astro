---
// Dashboard 2 shell — [DASH2-FOUNDATION 2026-09-25]. Contract:
// Specs/SPEC-2026-09-25-DASHBOARD-2.md.
//
// Customer-only dashboard skinned with the landing tokens (saathum-tokens.css)
// and shadcn/ui (components/ui/*). Usage:
//
//   <Dashboard2 title="My events" active="my-events" subtitle="…">
//     <MyEvents client:load />
//   </Dashboard2>
//
// - `active` ∈ 'book' | 'my-events' | 'past' | 'billing' | 'profile'.
// - DashNav owns the page's ONLY <ClerkProvider> and the auth guard. Screen
//   islands must not mount their own ClerkIsland; use getActiveTokenWaited().
// - A sonner <Toaster/> is mounted here; call `toast()` from components/ui/sonner.
// - Everything shadcn reads is scoped under `.dash2` — nothing leaks to the site.
import Base from './Base.astro';
import DashNav from '../islands/dashboard2/DashNav.tsx';
import DashToaster from '../islands/dashboard2/DashToaster.tsx';
import InstallPrompt from '../islands/dashboard2/InstallPrompt.tsx';
import type { DashKey } from '../islands/dashboard2/nav';
import { publicImage } from '../lib/config';
import '../styles/saathum-tokens.css';

export interface Props {
  /** Page title (tab) and default heading. */
  title: string;
  /** Visible heading; defaults to `title`. */
  heading?: string;
  /** One-line caption under the heading. */
  subtitle?: string;
  active: DashKey;
}
const { title, heading, subtitle, active } = Astro.props;

Astro.response.headers.set('Cache-Control', 'private, no-store');

const ribbon = publicImage('/assets/saathum-bright/border.png', { width: 640, fit: 'scale-down' });
---

<Base title={`${title} · Saathum`} chrome={false} noindex={true} indiaLandingLanguage={false}>
  <Fragment slot="head">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    {/* [DASH2-PWA 2026-09-25] Installable dashboard: manifest + iOS home-screen tags. */}
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Saathum" />
    <meta name="theme-color" content="hsl(42, 100%, 95%)" />
  </Fragment>
  {/* Radix portals (dialogs, popovers, selects, tooltips) render into <body>,
      outside the .dash2 root, so body carries the scope too. Runs before paint. */}
  <script is:inline>document.body.classList.add('dash2');</script>

  <div class="dash2 dash2-root min-h-screen bg-background text-foreground" data-dash2-screen={active} style={`--folk-border-url:url(${ribbon})`}>
    <DashNav client:load active={active} />

    <div class="flex min-h-screen flex-col pt-[calc(var(--dash-topbar-h,56px)+env(safe-area-inset-top,0px))] sm:pl-[var(--dash-rail-w,72px)] sm:pt-0 lg:pl-[var(--dash-sidebar-w,260px)]">
      <main class="dash-safe-bottom mx-auto w-full max-w-6xl flex-1 px-4 pt-6 sm:px-8 sm:pt-10">
        <header class="mb-6 sm:mb-8">
          <h1 class="font-dash text-[26px] font-bold leading-[1.15] tracking-[0.01em] text-grand-teal sm:text-[32px]">{heading ?? title}</h1>
          {subtitle && <p class="mt-2 max-w-2xl text-[15px] font-semibold leading-relaxed text-muted-foreground">{subtitle}</p>}
          <div class="dash-ribbon mt-5" aria-hidden="true"></div>
        </header>
        <slot />
      </main>
    </div>

    <DashToaster client:load />
    <InstallPrompt client:idle />
  </div>

  <script>
    // dash2_view {screen, load_ms} — one per Dashboard 2 page load.
    import { capture } from '../lib/analytics';
    const screen = document.querySelector<HTMLElement>('[data-dash2-screen]')?.dataset.dash2Screen;
    if (screen) capture('dash2_view', { screen, load_ms: Math.round(performance.now()) });
  </script>
</Base>
