---
// Universal site footer — used by BOTH layouts:
//   • Base.astro      (marketing / app pages, when `chrome` is true)
//   • Content.astro   (editorial legal + policy pages)
// Before 2026-08-05 these were two different footers listing different links,
// so the legal pages exposed only 4 of ~19 policies. One component now, so a
// new policy gets added in exactly one place.
//
// Self-contained: styles are scoped and define their own tokens locally, so
// nothing leaks into app pages. Fonts are @font-face'd in global.css.
//
// [AVA-IDGATE-1] /biometric-retention MUST stay linked here. BIPA §15(a)
// requires the retention schedule to be PUBLICLY AVAILABLE; a page reachable
// only by direct URL is a weak reading of that. Do not remove that link.
//
// Mobile: each column becomes a <details> accordion so ~19 links stay usable
// on a phone instead of turning the footer into an endless scroll.

const year = new Date().getFullYear();

const columns = [
  {
    title: 'Product',
    links: [
      { href: '/#messaging', label: 'AI Messaging' },
      { href: '/#receptionist', label: 'AI Receptionist' },
      { href: '/#number', label: 'Private Number' },
      { href: '/#pricing', label: 'Pricing' },
    ],
  },
  {
    title: 'Money',
    links: [
      { href: '/pricing-fees', label: 'Pricing & Fees' },
      { href: '/tokens', label: 'Tokens & Wallet' },
      { href: '/payouts', label: 'Payouts & Withdrawals' },
      { href: '/refunds', label: 'Refunds & Cancellations' },
    ],
  },
  {
    title: 'Marketplace',
    links: [
      { href: '/marketplace-terms', label: 'Marketplace Terms' },
      { href: '/consultation-terms', label: 'Consultation Terms' },
      { href: '/acceptable-use', label: 'Acceptable Use' },
      { href: '/recording', label: 'Recording & Consent' },
    ],
  },
  {
    title: 'Legal',
    links: [
      { href: '/terms', label: 'Terms of Service' },
      { href: '/privacy', label: 'Privacy Policy' },
      { href: '/cookies', label: 'Cookie Policy' },
      { href: '/dmca', label: 'DMCA / Copyright' },
      { href: '/biometric-retention', label: 'Biometric Data Schedule' },
    ],
  },
  {
    title: 'Safety & Support',
    links: [
      { href: '/community-guidelines', label: 'Community Guidelines' },
      { href: '/child-safety', label: 'Child Safety Standards' },
      { href: '/grievance', label: 'Grievance Redressal' },
      { href: '/contact', label: 'Contact & Report' },
      { href: '/about', label: 'About us' },
      { href: '/careers', label: 'Careers' },
    ],
  },
];
---

<footer class="ava-footer">
  <div class="wrap">

    <div class="top">
      <div class="brand-col">
        <a class="brand" href="/">
          <img src="/app-logo2.png" alt="" width="38" height="38" />
          <span class="wm">ava<span class="tok">TOK</span></span>
        </a>
        <p class="desc">
          AI-powered messaging, calling, and a marketplace for digital services — built for real life.
        </p>
      </div>

      {columns.map((col) => (
        <nav class="col" aria-label={col.title}>
          <h4>{col.title}</h4>
          {col.links.map((l) => <a href={l.href}>{l.label}</a>)}
        </nav>
      ))}

      {columns.map((col) => (
        <details class="acc">
          <summary>{col.title}</summary>
          <div>{col.links.map((l) => <a href={l.href}>{l.label}</a>)}</div>
        </details>
      ))}
    </div>

    <div class="entities">
      <div class="ent">
        <h5>India</h5>
        <p>
          <strong>Ava Global International Pvt Ltd</strong>, Mumbai, India.<br />
          Serves customers, transactions and payouts in India. GST compliant. Payouts are made to a
          verified UPI address linked to your Indian bank account.
        </p>
      </div>
      <div class="ent">
        <h5>International</h5>
        <p>
          <strong>Ava Global International, Inc.</strong>, Delaware, USA.<br />
          Serves international customers, transactions and payouts outside India.
        </p>
      </div>
      <div class="ent">
        <h5>Good to know</h5>
        <p>
          Top-ups are converted into tokens. <strong>1 token = 1 US cent (US$0.01).</strong> Tokens
          are non-refundable except where the law or your app store requires. Unused tokens can be withdrawn — a transfer fee and, in India, GST
          apply, shown before you confirm. See <a href="/tokens">Tokens</a>,
          <a href="/refunds">Refunds</a> and <a href="/payouts">Payouts</a>.
        </p>
      </div>
    </div>

    <div class="bottom">
      <span>© {year} Ava Global International Pvt Ltd &amp; Ava Global International, Inc. All rights reserved.</span>
      <span class="mini">
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms</a>
        <a href="/cookies">Cookies</a>
        <a href="/grievance">Grievance</a>
      </span>
    </div>

    <p class="made">Made in India <span class="heart" role="img" aria-label="with love">♥</span></p>
  </div>
</footer>

<style>
  .ava-footer {
    --paper: #f3efe3;
    --ink: #181816;
    --ink-soft: #5c5f66;
    --rule: rgba(24, 24, 22, 0.16);
    --accent: #16aeb4;

    border-top: 2px solid var(--ink);
    background: var(--paper);
    color: var(--ink);
    padding: 56px 0 30px;
    font-family: 'Nunito', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    font-size: 15px;
    line-height: 1.6;

    /* Defensive resets. The home page injects a self-contained landing document
       whose CSS includes a bare `footer { display:flex; flex-direction:column;
       align-items:center; text-align:center; gap:22px }` rule. That element
       selector would otherwise reach into this component and collapse the whole
       layout into a centred column. Pin the properties it sets. */
    display: block;
    flex-direction: initial;
    justify-content: initial;
    align-items: initial;
    gap: 0;
    text-align: left;
  }
  .ava-footer .wrap { width: 100%; max-width: 1180px; margin: 0 auto; padding: 0 26px; }
  .ava-footer a { color: inherit; text-decoration: none; }
  .ava-footer a:hover { color: var(--accent); text-decoration: underline; }

  /* ---------- top ---------- */
  .ava-footer .top {
    display: grid;
    grid-template-columns: 1.4fr repeat(5, 1fr);
    gap: 30px;
    padding-bottom: 34px;
    border-bottom: 1px solid var(--rule);
  }
  .ava-footer .brand { display: flex; align-items: center; gap: 9px; }
  .ava-footer .brand img { width: 38px; height: 38px; border-radius: 50%; }
  .ava-footer .wm { font-size: 23px; font-weight: 800; letter-spacing: -.04em; }
  .ava-footer .tok { color: var(--accent); }
  .ava-footer .desc { margin: 12px 0 0; max-width: 290px; color: var(--ink-soft); font-size: 14px; }

  .ava-footer .col { display: flex; flex-direction: column; gap: 9px; }
  .ava-footer .col h4 {
    margin: 0 0 4px; font-size: 12px; font-weight: 800;
    letter-spacing: .1em; text-transform: uppercase; color: var(--ink);
  }
  .ava-footer .col a { font-size: 14px; color: var(--ink-soft); }

  .ava-footer .acc { display: none; }

  /* ---------- entities ---------- */
  .ava-footer .entities {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px;
    padding: 28px 0; border-bottom: 1px solid var(--rule);
  }
  .ava-footer .ent h5 {
    margin: 0 0 7px; font-size: 12px; font-weight: 800;
    letter-spacing: .1em; text-transform: uppercase;
  }
  .ava-footer .ent p { margin: 0; font-size: 13px; line-height: 1.65; color: var(--ink-soft); }
  .ava-footer .ent a { color: var(--ink); font-weight: 700; text-decoration: underline; }

  /* ---------- bottom ---------- */
  .ava-footer .bottom {
    display: flex; flex-wrap: wrap; gap: 12px 22px;
    align-items: center; justify-content: space-between;
    padding-top: 22px; font-size: 13px; color: var(--ink-soft);
  }
  .ava-footer .mini { display: flex; flex-wrap: wrap; gap: 18px; }
  .ava-footer .mini a { font-weight: 700; }
  .ava-footer .made { margin: 16px 0 0; text-align: center; font-size: 13px; color: var(--ink-soft); }
  .ava-footer .heart { color: #e53935; }

  /* Long labels ("Payouts & Withdrawals") must never force a column wider than
     its track and blow out the grid. */
  .ava-footer .col a,
  .ava-footer .acc a { overflow-wrap: anywhere; }

  /* ---------- tablet ----------
     Breakpoint is 1180px, NOT 1020px. iPad landscape and the 12.9" iPad Pro in
     portrait are both exactly 1024px CSS px — at a 1020px breakpoint they fell
     into the six-column desktop grid, leaving ~128px per column and wrapping
     every two-word link onto three lines. 1180px puts every iPad on the
     three-column layout. iPad portrait (768/834) and iPad mini (744) also land
     here, above the 720px accordion breakpoint, which is what we want: tablets
     get real columns, phones get accordions. */
  @media (max-width: 1180px) {
    .ava-footer .top { grid-template-columns: 1fr 1fr 1fr; gap: 26px 22px; }
    .ava-footer .brand-col { grid-column: 1 / -1; }
    .ava-footer .desc { max-width: 520px; }
  }

  /* Entity block gets cramped at three-up well before the columns do. */
  @media (max-width: 900px) {
    .ava-footer .entities { grid-template-columns: 1fr 1fr; gap: 22px; }
  }

  /* ---------- phone: columns become accordions ---------- */
  /* Phone type is deliberately much larger than desktop. At the previous
     13–15px the footer read as fine print next to the 18px body copy on the
     policy pages, which is the wrong signal for links people are meant to
     actually use. Tap targets are sized with it. */
  @media (max-width: 720px) {
    .ava-footer { padding: 40px 0 30px; font-size: 18px; }
    .ava-footer .wrap { padding: 0 18px; }
    .ava-footer .top { display: block; padding-bottom: 8px; border-bottom: 0; }
    .ava-footer .brand-col { margin-bottom: 22px; }
    .ava-footer .col { display: none; }
    .ava-footer .wm { font-size: 27px; }
    .ava-footer .desc { font-size: 17px; line-height: 1.5; }

    .ava-footer .acc { display: block; border-top: 1px solid var(--rule); }
    .ava-footer .acc summary {
      list-style: none; cursor: pointer; padding: 17px 2px;
      font-size: 19px; font-weight: 800; letter-spacing: .02em;
      display: flex; align-items: center; justify-content: space-between;
    }
    .ava-footer .acc summary::-webkit-details-marker { display: none; }
    .ava-footer .acc summary::after { content: '+'; font-size: 26px; font-weight: 600; line-height: 1; }
    .ava-footer .acc[open] summary::after { content: '–'; }
    .ava-footer .acc div { display: flex; flex-direction: column; gap: 4px; padding: 2px 2px 14px; }
    /* padding, not gap, so each row is a ≥44px tap target */
    .ava-footer .acc a { font-size: 19px; line-height: 1.35; padding: 9px 0; color: var(--ink-soft); }

    .ava-footer .entities { grid-template-columns: 1fr; gap: 24px; padding: 24px 0; border-top: 1px solid var(--rule); }
    .ava-footer .ent h5 { font-size: 15px; }
    .ava-footer .ent p { font-size: 16px; line-height: 1.6; }

    .ava-footer .bottom { flex-direction: column; align-items: flex-start; gap: 14px; font-size: 16px; }
    .ava-footer .mini { gap: 14px 22px; }
    .ava-footer .mini a { font-size: 17px; padding: 4px 0; }
    .ava-footer .made { font-size: 16px; }
  }
</style>
