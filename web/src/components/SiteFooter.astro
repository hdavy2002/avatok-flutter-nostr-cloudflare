---
// rebrand: reviewed — [SAATHUM-REBRAND-1 2026-09-25]
import { HOME_FOOTER_COLUMNS } from '../lib/homeNavigation';
import { isArchivedPath } from '../lib/archivedPages';
import '../styles/folk-chrome.css';
// [SAATHUM-CHROME-1] Landing-page footer rules, carried by the footer itself.
import '../styles/saathum-folk.css';
import { publicImage } from '../lib/config';
// [WEB-FOOTER-2 2026-08-26 / WEB-FOOTER-3 2026-09-02] Site footer, matching
// the design comp (`design/live-streaming/SiteFooter.dc.html`) exactly:
// blue "chai" truck-art strip on top, dark panel with three columns — the Horn
// OK Please art, the legal bar, then the green "auto" + "tassels" strips
// below. [SHV2-S8 2026-09-21] The three columns were BAZAAR / CREATORS /
// COMPANY; they are now Explore / For organisers / Trust for the Saathum
// attendee+organiser pivot (Spec A3) — same three-column skeleton, new
// content, per the style-fidelity rule (B2 §11).
//
// [WEB-FOOTER-3] REVERSES the [WEB-FOOTER-2] decision to spread ~26 links
// across six columns to avoid a "compliance regression dressed as a design
// change". The owner has now explicitly asked for the comp's three-column
// look (SPEC-2026-09-01-LISTING-CONTENT-AND-BOOKING.md A1.2). COMPANY keeps
// Terms of Service and Privacy Policy from the old Legal column.
//
// [WEB-FOOTER-4 2026-09-02] RESTORES the standalone legal/policy pages that
// WEB-FOOTER-3 unlinked (Grievance Redressal, Child Safety Standards, Cookie
// Policy, DMCA, Biometric Data Schedule, Marketplace/Consultation Terms,
// Acceptable Use, Recording & Consent, Refunds, Pricing & Fees, Tokens &
// Wallet, Community Guidelines, Contact & Report) — they must stay reachable
// from every page (Grievance Redressal is required to be discoverable for an
// intermediary under India's IT Rules 2021; Child Safety Standards is a Play
// listing requirement). Rather than re-adding columns (which the owner
// explicitly rejected), these live in one slim, visually quiet link row
// (`.bf-legal-links`) between the three-column comp block and the bottom
// legal bar, inside `.bazaar-footer` so the existing nav_click delegation
// covers it. Terms/Privacy stay duplicated in the COMPANY column too — fine.
import TruckBorder from './TruckBorder.astro';
import GlobalFooter from './GlobalFooter.astro';

export interface Props { folk?: boolean; variant?: 'india' | 'global'; indiaLandingLanguage?: boolean; }
// [SAATHUM-CHROME-1 2026-09-23] OWNER DECISION: the landing-page footer is the
// ONE standard footer site-wide — folk defaults ON. The truck-art footer (chai/
// auto/tassels strips, Horn OK Please) is retired for the india variant.
const { folk = true, variant = 'india', indiaLandingLanguage = true } = Astro.props;

const year = new Date().getFullYear();

// [WEB-FOOTER-4] Slim compliance link row — see note above. Keep in this
// order; it's the order the owner specified.
const legalLinks = [
  // [WEB-HELP-1 2026-09-11] Help centre listed first in the policy strip per plan §8.
  { href: '/help', label: 'Help centre' },
  { href: '/terms', label: 'Terms' },
  { href: '/privacy', label: 'Privacy' },
  { href: '/cookies', label: 'Cookies' },
  { href: '/refunds', label: 'Refunds' },
  { href: '/marketplace-terms', label: 'Marketplace Terms' },
  { href: '/consultation-terms', label: 'Consultation Terms' },
  { href: '/acceptable-use', label: 'Acceptable Use' },
  { href: '/recording', label: 'Recording & Consent' },
  { href: '/biometric-retention', label: 'Biometric Data' },
  { href: '/dmca', label: 'DMCA' },
  { href: '/community-guidelines', label: 'Community Guidelines' },
  { href: '/child-safety', label: 'Child Safety' },
  { href: '/grievance', label: 'Grievance Redressal' },
  { href: '/contact', label: 'Contact & Report' },
];
// [SAATHUM-ARCHIVE-1 2026-09-25] Archived pages stay live but leave the menus.
const visibleLegalLinks = legalLinks.filter((l) => !isArchivedPath(l.href));

// [SHV2-S8 2026-09-21] Saathum attendee/organiser/trust footer (Spec A3).
// Replaces Bazaar/Creators/Company: "Live streaming" (/#live-streaming) and
// "1:1 consultations" (/#live-friends) were both dead anchors after the
// redesign (D2 also drops 1:1 entirely) and are retargeted here to working
// marketplace destinations by simply not carrying them forward.
const columns = [
  {
    title: 'Explore',
    links: [
      { href: '/marketplace', label: 'Our Pujas' },
      { href: '/#experiences', label: 'Experiences' },
      { href: '/help', label: 'Help' },
      // "Joining a live event" — help.ts/getHelpEntries() would build this
      // async; this content path is stable and already hardcoded elsewhere
      // on the site (e.g. pricing-fees.astro's helpHref), so it's linked
      // directly the same way.
      { href: '/help/booking-and-paying/join-a-live-show', label: 'Joining a live event' },
    ],
  },
  {
    title: 'For organisers',
    links: [
      { href: '/organisers', label: 'For organisers' },
      { href: '/dashboard', label: 'Creator dashboard' },
      { href: '/organisers#guides', label: 'Guides' },
    ],
  },
  {
    title: 'Trust',
    links: [
      { href: '/refunds', label: 'Refunds & cancellations' },
      { href: '/contact', label: 'Contact' },
      { href: '/terms', label: 'Terms' },
      { href: '/privacy', label: 'Privacy' },
      // The approved operating-entity disclosure already lives at
      // /terms#status (LegalStatus.astro, variant="full", under the "Who we
      // are, and where we are in our journey" heading) — linked here rather
      // than duplicated, per A3/D7.
      { href: '/terms#status', label: 'Who we are' },
    ],
  },
];
const globalColumns = [
  { title: 'Explore', links: [{ href: '/marketplace', label: 'Marketplace' }, { href: '/global-ideas', label: 'Ideas' }, { href: '/#formats', label: 'Live & 1:1' }] },
  { title: 'Creators', links: [{ href: '/sign-up?role=creator&country=global', label: 'Start selling' }, { href: '/dashboard', label: 'Creator dashboard' }, { href: '/community-guidelines', label: 'Safety' }] },
  { title: 'Company', links: [{ href: '/about', label: 'About' }, { href: '/help', label: 'Help centre' }, { href: '/careers', label: 'Careers' }, { href: '/contact', label: 'Contact' }, { href: '/terms', label: 'Terms of Service' }, { href: '/privacy', label: 'Privacy Policy' }] },
];
// [SAATHUM-ARCHIVE-1 2026-09-25] Drop archived pages from the non-folk columns too.
const footerColumns = (variant === 'global' ? globalColumns : columns).map((col) => ({ ...col, links: col.links.filter((l) => !isArchivedPath(l.href.split('#')[0])) }));
// [SHV2-S8 2026-09-21] Bazaar/Live streaming/1:1 consultations/Explore
// marketplace entries removed — dead since `columns` no longer carries those
// labels (see above). Everything else here is still used by `globalColumns`
// and/or `legalLinks`, both untouched by this change. The new `columns`
// labels above deliberately carry NO key here: D9 takes the India/Saathum
// shell English-only, and AC-18 forbids replaying an old key's stored
// translation over new wording (dom.ts would do exactly that on a locale
// switch) — see the gating on `variant === 'global'` below.
const chromeKey = (value: string) => ({
  Creators:'chrome.creators', Company:'chrome.company', Explore:'chrome.explore',
  'Start selling':'chrome.startSelling', 'Creator dashboard':'chrome.creatorDashboard', Payouts:'chrome.payouts', Safety:'chrome.safety',
  About:'chrome.about', 'Help centre':'chrome.help', Careers:'chrome.careers', Contact:'chrome.contact', 'Terms of Service':'chrome.terms', 'Privacy Policy':'chrome.privacy',
  Terms:'chrome.terms', Privacy:'chrome.privacy', Cookies:'chrome.cookies', Refunds:'chrome.refunds',
  'Marketplace Terms':'chrome.marketplaceTerms', 'Consultation Terms':'chrome.consultationTerms', 'Acceptable Use':'chrome.acceptableUse', 'Recording & Consent':'chrome.recordingConsent', 'Biometric Data':'chrome.biometricData', DMCA:'chrome.dmca', 'Community Guidelines':'chrome.communityGuidelines', 'Child Safety':'chrome.childSafety', 'Grievance Redressal':'chrome.grievance', 'Contact & Report':'chrome.contactReport', 'Pricing & Fees':'chrome.pricingFees', 'Tokens & Wallet':'chrome.tokensWallet',
}[value]);
---

{variant === 'global' ? <GlobalFooter columns={columns} legalLinks={visibleLegalLinks} year={year} /> : <div class:list={[folk && 'folk-site saathum-chrome']} data-design={folk ? 'saathum-reference-v5' : undefined} style="display:contents"><footer class:list={['bazaar-footer', folk && 'bazaar-footer--folk', variant === 'global' && 'bazaar-footer--global']} style={folk ? `--folk-border-url:url(${publicImage('/assets/saathum-bright/border.png', { width: 640, fit: 'scale-down' })})` : undefined}>
  {!folk && <TruckBorder kind="chai" count={40} />}

  <div class="bf-main">
    <div class="bf-brand">
      {/* [SHV2-S8 2026-09-21] Diya + "Saathum" replacing the "ava"/"TOK"
          two-span wordmark (AC-03: consistent branding in header, drawer AND
          footer). Reuses this file's own Comfortaa heading face and the
          existing #fdf1d3 ink already used one line below. */}
      <a class="bf-logo" href="/" aria-label="Saathum home" data-india-i18n-attr={indiaLandingLanguage ? 'aria-label:chrome.home' : undefined}>
        {folk ? <img class="folk-lotus-mark" data-folk-artwork="lotus" src={publicImage('/assets/saathum-bright/lotus.png', { width: 100, fit: 'scale-down' })} alt="" width="44" height="44" /> : <img src={publicImage('/diya-logo.png', { width: 100, fit: 'scale-down' })} alt="" width="34" height="34" />}
        <span class="bf-logo-text">Saathum</span>
      </a>
      {/* [SHV2-S8] Tagline changed (A3) — the old chrome.tagline key is not
          reused here for the india copy (AC-18); the global copy is untouched
          and keeps its key. */}
      <p class="bf-tag" data-india-i18n={variant === 'global' && indiaLandingLanguage ? "chrome.tagline" : undefined}>{variant === 'global' ? 'A global home for creator-led income. Go live, get booked, and get paid locally.' : "Faith, brought home to you."}</p>
      {!folk && <span class="bf-script" data-india-i18n={indiaLandingLanguage ? "chrome.voice" : undefined}>{variant === 'global' ? 'Made for creators everywhere.' : 'Your voice, out to the world.'}</span>}
    </div>

    {/* The homepage keeps its original Bazaar / Creators / Company menus
        visible: each group stacks its links vertically, while the policy
        links below remain a compact horizontal strip. */}
    {folk && <div class="bf-folk-columns">
      {HOME_FOOTER_COLUMNS.map((col) => (
        <nav class="bf-col" aria-label={col.title}>
          <h2 class="bf-col-title">{col.title}</h2>
          {col.links.map((l) => <a href={l.href}>{l.label}</a>)}
        </nav>
      ))}
    </div>}

    {/* [SHV2-S8] Column titles/links are only localised for the untouched
        'global' variant — see the chromeKey note above. */}
    {!folk && footerColumns.map((col) => (
      <nav class="bf-col" aria-label={col.title} data-india-i18n-attr={variant === 'global' && indiaLandingLanguage ? `aria-label:${chromeKey(col.title)}` : undefined}>
        <h2 class="bf-col-title" data-india-i18n={variant === 'global' && indiaLandingLanguage ? chromeKey(col.title) : undefined}>{col.title}</h2>
        {col.links.map((l) => <a href={l.href} data-india-i18n={variant === 'global' && indiaLandingLanguage ? chromeKey(l.label) : undefined}>{l.label}</a>)}
      </nav>
    ))}

    {!folk && <div class="bf-art">
      {/* Already on the site for the auth screens, so this costs no new asset. */}
      <img data-india-i18n-attr="alt:web-common.bc1848dfbe79762d" src={publicImage('/auth/horn-ok-please.png', { width: 500, fit: 'scale-down' })} alt="Horn OK Please" width="250" height="150" loading="lazy" />
      <span class="bf-art-line" data-india-i18n={indiaLandingLanguage ? "chrome.goodbye" : undefined}>{variant === 'global' ? 'CREATORS EVERYWHERE · SEE YOU SOON' : 'BYE FOR NOW · SEE YOU SOON'}</span>
      <span class="bf-art-hi" data-india-i18n={indiaLandingLanguage ? "chrome.comeAgain" : undefined}>{variant === 'global' ? 'See you worldwide!' : 'Come back soon!'}</span>
    </div>}
  </div>

  {/* [WEB-BANNER-OFF-1 2026-09-02] The status + address block was removed at the
      owner's request. The same disclosure still lives on /terms#status; the
      Grievance Redressal page (/grievance) still exists but is no longer
      linked from this footer — see the WEB-FOOTER-3 note above the columns.
      NOTE: a payment-gateway reviewer looks for exactly this block — if the
      Cashfree/gateway application asks for a visible operating address, restore
      it here (the .bf-entity styles below are kept for that). */}

  {/* [SAATHUM-ARCHIVE-1 2026-09-25] The folk (live) footer carries every kept
      policy link in its Legal column (homeNavigation.ts), so this duplicate
      strip is hidden there. Archived pages are filtered out everywhere. */}
  {!folk && <nav class="bf-legal-links" aria-label="Legal and safety" data-india-i18n-attr={indiaLandingLanguage ? 'aria-label:chrome.legal' : undefined}>
    {visibleLegalLinks.map((l, i) => (
      <>
        <a href={l.href} data-india-i18n={indiaLandingLanguage ? chromeKey(l.label) : undefined}>{l.label}</a>
        {i < visibleLegalLinks.length - 1 && <span class="bf-legal-links-sep" aria-hidden="true"> · </span>}
      </>
    ))}
  </nav>}

  <div class="bf-legal">
    <div class="bf-legal-inner">
      <span data-india-i18n={!folk && indiaLandingLanguage ? 'chrome.roadMotto' : undefined}>{folk ? 'Made in India with Love ❤️ and cutting chai.' : variant === 'global' ? 'GOOD CREATORS · BRIGHTER TOMORROWS' : 'GOOD VIBES ONLY, NO EVIL EYE · USE DIPPER AT NIGHT'}</span>
      <span>© {year}{' '}<ui-copy style="display:contents" data-i18n={folk ? undefined : "web-common.15da1f1c2e9b5f56"}>SAATHUM ·</ui-copy>{' '}<span data-india-i18n={!folk && indiaLandingLanguage ? 'chrome.madeWith' : undefined}>{folk ? 'Performed with devotion in India.' : variant === 'global' ? 'MADE FOR CREATORS EVERYWHERE' : 'MADE WITH ♥ AND CUTTING CHAI'}</span></span>
    </div>
  </div>

  <div class="bf-rule"></div>
  {!folk && <TruckBorder kind="auto" count={40} />}
  {!folk && <TruckBorder kind="tassels" count={44} />}
</footer></div>}

<script>
  // [WEB-POSTHOG-1] Footer link clicks -> nav_click{item, location:'footer'}.
  // Same delegated pattern as SiteHeader (see its nav_click wiring) so this
  // keeps working across every column and the logo, with no per-link rewiring
  // when the link set changes.
  document.querySelectorAll<HTMLAnchorElement>('.bazaar-footer a').forEach((el) => {
    el.addEventListener('click', () => {
      const item = (el.textContent || el.getAttribute('href') || 'unknown').trim();
      import('../lib/analytics').then(({ capture }) => capture('nav_click', { item, location: 'footer' }));
    });
  });
</script>

<style>
  .bf-entity {
    max-width: 100rem;
    margin: 0 auto;
    padding: 0 clamp(16px, 4vw, 40px) 26px;
  }

  .bf-entity-line {
    margin: 0 0 8px;
    font-family: 'Nunito', system-ui, sans-serif;
    font-size: 13.5px;
    font-weight: 700;
    line-height: 1.55;
    letter-spacing: 0.04em;
    color: #cdc3aa;
    max-width: 78ch;
  }

  .bf-entity-line strong { font-weight: 900; letter-spacing: 0.05em; color: #fdf1d3; }
  .bf-entity-line a { color: #ffc94d; text-underline-offset: 3px; }

  /* Colours are literals rather than tokens because this footer is a direct port
     of the comp, which is the source of truth for the bazaar palette. */
  .bazaar-footer {
    background: #161614;
    color: #fdf1d3;
    border-top: 3px solid #161614;
  }

  .bf-main {
    max-width: 100rem;
    margin: 0 auto;
    padding: 56px clamp(16px, 4vw, 40px) 44px;
    display: flex;
    gap: 3rem;
    flex-wrap: wrap;
    align-items: flex-start;
  }

  .bf-brand { flex: 1 1 17.5rem; }

  .bf-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 14px;
    text-decoration: none;
  }
  .bf-logo img { display: block; width: 34px; height: 34px; }
  /* [SHV2-S8 2026-09-21] Diya + "Saathum" replacing the "ava"/"TOK" two-span
     wordmark. Same Comfortaa face and #fdf1d3 ink the old first span used. */
  .bf-logo-text {
    font-family: 'Comfortaa', 'Baloo 2', sans-serif;
    word-spacing: 0.22em;
    font-weight: 700;
    font-size: 1.875rem;
    color: #fdf1d3;
  }

  .bf-tag {
    margin: 0 0 18px;
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.5;
    color: #c9b8a4;
    max-width: 36ch;
  }
  /* [SAATHUM-TAGLINE-2 2026-09-25] Owner: the tagline sits on ONE line on
     desktop. Phones still wrap. Selector outranks the 30ch/48ch caps in
     saathum-folk.css and folk-chrome.css. */
  @media (min-width: 900px) {
    .bf-tag,
    :global(.folk-site .bazaar-footer.bazaar-footer--folk .bf-brand p.bf-tag) {
      max-width: none;
      white-space: nowrap;
    }
  }

  .bf-script {
    font-family: 'Kalam', cursive;
    font-size: 1.25rem;
    color: #e8a08f;
    transform: rotate(-2deg);
    display: inline-block;
  }

  .bf-col { flex: 1 1 9.375rem; display: flex; flex-direction: column; }

  .bf-col-title {
    font-family: 'Nunito', system-ui, sans-serif;
    font-weight: 800;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #e8a08f;
    margin: 0 0 14px;
  }

  .bf-col a {
    color: #c9b8a4;
    font-size: 0.9062rem;
    font-weight: 500;
    text-decoration: none;
    padding: 0.28rem 0;
  }
  .bf-col a:hover { color: #f0d018; }
  .bf-col a:focus-visible { outline: 2px solid #f0d018; outline-offset: 2px; }

  .bf-art {
    flex: 1 1 15rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    text-align: center;
  }
  .bf-art img { width: min(250px, 100%); height: auto; display: block; }
  .bf-art-line {
    font-family: 'Nunito', system-ui, sans-serif;
    font-weight: 800;
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    color: #c9b8a4;
  }
  .bf-art-hi {
    font-family: 'Baloo 2', system-ui, sans-serif;
    font-weight: 700;
    font-size: 1.125rem;
    color: #f0d018;
  }

  .bf-legal-links {
    max-width: 100rem;
    margin: 0 auto;
    padding: 0 clamp(16px, 4vw, 40px) 22px;
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.3rem;
    row-gap: 0.35rem;
    font-family: 'Nunito', system-ui, sans-serif;
    font-weight: 700;
    font-size: 11px;
    line-height: 1.6;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .bf-legal-links a {
    color: #a89880;
    text-decoration: none;
  }
  .bf-legal-links a:hover { color: #f0d018; }
  .bf-legal-links a:focus-visible { outline: 2px solid #f0d018; outline-offset: 2px; }

  .bf-legal-links-sep { color: #6f6350; }

  @media (min-width: 480px) {
    .bf-legal-links { font-size: 12px; }
  }

  .bf-legal { border-top: 1.5px solid rgba(253, 241, 211, 0.22); }
  .bf-legal-inner {
    max-width: 100rem;
    margin: 0 auto;
    padding: 18px clamp(16px, 4vw, 40px);
    display: flex;
    gap: 1.125rem;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    font-family: 'Nunito', system-ui, sans-serif;
    font-weight: 800;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: #fdf1d3;
  }

  .bf-rule { border-top: 2px solid #f0d018; }

  @media (max-width: 700px) {
    .bf-main { gap: 2rem; padding-top: 40px; }
    .bf-col { flex-basis: 45%; }
  }
</style>
