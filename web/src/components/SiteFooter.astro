---
// [WEB-FOOTER-2 2026-08-26] Site footer, rebuilt to the bazaar design.
//
// Owner: use the footer from the design comp (truck-art strips, Horn OK Please
// art, the Kalam sign-off, dark panel). This is that design.
//
// ─── EVERY EXISTING LINK IS STILL HERE, ON PURPOSE ──────────────────────────
// The comp draws three short columns (~12 links). This footer carried 26,
// several of which are not editorial choices:
//   * Grievance Redressal — named grievance officer contact is required of an
//     intermediary under India's IT Rules 2021;
//   * Child Safety Standards — required by the Play Store listing, which links
//     to it directly;
//   * Privacy Policy, Terms, Refunds, DMCA, Biometric Data Schedule — linked
//     from the app listing and from consent flows.
// Dropping them to match the comp's link count would have been a compliance
// regression dressed as a design change, so the comp's LOOK is adopted and the
// link set is kept whole, spread over five columns instead of three. If the
// owner wants fewer links, that is a decision to take on the legal ones
// deliberately, not a side effect of restyling.
import TruckBorder from './TruckBorder.astro';

const year = new Date().getFullYear();

const columns = [
  {
    title: 'Bazaar',
    links: [
      { href: '/#live-friends', label: 'Live Friends' },
      { href: '/#live-streaming', label: 'Live Streaming' },
      { href: '/#consultations', label: '1:1 Consultations' },
      { href: '/#voice-agents', label: 'AI Voice Agents' },
      { href: '/marketplace', label: 'Explore Marketplace' },
    ],
  },
  {
    title: 'For creators',
    links: [
      { href: '/sign-up', label: 'Create free' },
      { href: '/dashboard', label: 'Creator dashboard' },
      { href: '/blog', label: 'Blog' },
    ],
  },
  {
    title: 'Money',
    links: [
      { href: '/pricing-fees', label: 'Pricing & Fees' },
      { href: '/tokens', label: 'Tokens & Wallet' },
      { href: '/payouts', label: 'Payouts & Withdrawals' },
      { href: '/refunds', label: 'Refunds & Cancellations' },
    ],
  },
  {
    title: 'Marketplace',
    links: [
      { href: '/marketplace-terms', label: 'Marketplace Terms' },
      { href: '/consultation-terms', label: 'Consultation Terms' },
      { href: '/acceptable-use', label: 'Acceptable Use' },
      { href: '/recording', label: 'Recording & Consent' },
    ],
  },
  {
    title: 'Legal',
    links: [
      { href: '/terms', label: 'Terms of Service' },
      { href: '/privacy', label: 'Privacy Policy' },
      { href: '/cookies', label: 'Cookie Policy' },
      { href: '/dmca', label: 'DMCA / Copyright' },
      { href: '/biometric-retention', label: 'Biometric Data Schedule' },
    ],
  },
  {
    title: 'Safety & Support',
    links: [
      { href: '/community-guidelines', label: 'Community Guidelines' },
      { href: '/child-safety', label: 'Child Safety Standards' },
      { href: '/grievance', label: 'Grievance Redressal' },
      { href: '/contact', label: 'Contact & Report' },
      { href: '/about', label: 'About us' },
      { href: '/careers', label: 'Careers' },
    ],
  },
];
---

<footer class="bazaar-footer">
  <TruckBorder kind="chai" count={40} />

  <div class="bf-main">
    <div class="bf-brand">
      <a class="bf-logo" href="/" aria-label="avaTOK home"><span>ava</span><span>TOK</span></a>
      <p class="bf-tag">India's live creator bazaar. Seat book karo, kursi kheencho, apna time lo.</p>
      <span class="bf-script">Aapki awaaz, duniya tak.</span>
    </div>

    {columns.map((col) => (
      <nav class="bf-col" aria-label={col.title}>
        <h2 class="bf-col-title">{col.title}</h2>
        {col.links.map((l) => <a href={l.href}>{l.label}</a>)}
      </nav>
    ))}

    <div class="bf-art">
      {/* Already on the site for the auth screens, so this costs no new asset. */}
      <img src="/auth/horn-ok-please.png" alt="Horn OK Please" width="250" height="150" loading="lazy" />
      <span class="bf-art-line">OK TATA · PHIR MILENGE</span>
      <span class="bf-art-hi">फिर आना!</span>
    </div>
  </div>

  <div class="bf-legal">
    <div class="bf-legal-inner">
      <span>BURI NAZAR WALE, TERA MUH KALA · USE DIPPER AT NIGHT</span>
      <span>© {year} AVATOK · MADE WITH ♥ AND CUTTING CHAI</span>
    </div>
  </div>

  <div class="bf-rule"></div>
  <TruckBorder kind="auto" count={40} />
  <TruckBorder kind="tassels" count={44} />
</footer>

<style>
  /* Colours are literals rather than tokens because this footer is a direct port
     of the comp, which is the source of truth for the bazaar palette. */
  .bazaar-footer {
    background: #161614;
    color: #fdf1d3;
    border-top: 3px solid #161614;
  }

  .bf-main {
    max-width: 100rem;
    margin: 0 auto;
    padding: 56px clamp(16px, 4vw, 40px) 44px;
    display: flex;
    gap: 3rem;
    flex-wrap: wrap;
    align-items: flex-start;
  }

  .bf-brand { flex: 1 1 17.5rem; }

  .bf-logo {
    display: flex;
    align-items: baseline;
    gap: 0.0625rem;
    font-family: 'Anton', Impact, sans-serif;
    word-spacing: 0.22em;
    /* Anton ships one weight; see the font-synthesis note in global.css. */
    font-weight: 400;
    font-size: 1.875rem;
    margin-bottom: 14px;
    text-decoration: none;
  }
  .bf-logo span:first-child { color: #fdf1d3; }
  .bf-logo span:last-child {
    color: #d93825;
    font-family: 'Playfair Display', Georgia, serif;
    font-style: italic;
    font-weight: 900;
    font-size: 1.8125rem;
  }

  .bf-tag {
    margin: 0 0 18px;
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.5;
    color: #c9b8a4;
    max-width: 36ch;
  }

  .bf-script {
    font-family: 'Kalam', cursive;
    font-size: 1.25rem;
    color: #e8a08f;
    transform: rotate(-2deg);
    display: inline-block;
  }

  .bf-col { flex: 1 1 9.375rem; display: flex; flex-direction: column; }

  .bf-col-title {
    font-family: 'Nunito', system-ui, sans-serif;
    font-weight: 800;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #e8a08f;
    margin: 0 0 14px;
  }

  .bf-col a {
    color: #c9b8a4;
    font-size: 0.9062rem;
    font-weight: 500;
    text-decoration: none;
    padding: 0.28rem 0;
  }
  .bf-col a:hover { color: #f0d018; }
  .bf-col a:focus-visible { outline: 2px solid #f0d018; outline-offset: 2px; }

  .bf-art {
    flex: 1 1 15rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    text-align: center;
  }
  .bf-art img { width: min(250px, 100%); height: auto; display: block; }
  .bf-art-line {
    font-family: 'Nunito', system-ui, sans-serif;
    font-weight: 800;
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    color: #c9b8a4;
  }
  .bf-art-hi {
    font-family: 'Baloo 2', system-ui, sans-serif;
    font-weight: 700;
    font-size: 1.125rem;
    color: #f0d018;
  }

  .bf-legal { border-top: 1.5px solid rgba(253, 241, 211, 0.22); }
  .bf-legal-inner {
    max-width: 100rem;
    margin: 0 auto;
    padding: 18px clamp(16px, 4vw, 40px);
    display: flex;
    gap: 1.125rem;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    font-family: 'Nunito', system-ui, sans-serif;
    font-weight: 800;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: #fdf1d3;
  }

  .bf-rule { border-top: 2px solid #f0d018; }

  @media (max-width: 700px) {
    .bf-main { gap: 2rem; padding-top: 40px; }
    .bf-col { flex-basis: 45%; }
  }
</style>
