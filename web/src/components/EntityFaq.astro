---
/**
 * [SAATHUM-BRAND-1 2026-09-20] "What is Saathum?" — entity definition block.
 *
 * Was [WEB-SEO-6]'s name-disambiguation block for "Saathum": a Google AI
 * Overview conflated the Saathum brand with an unrelated industrial-conductor
 * company (avatok.tech) and an old avatar-video app that shared the name, so
 * this component existed to tell the Knowledge Graph which entity saathum.com
 * meant. Saathum has no known name collision, so the disambiguation angle
 * ("not to be confused with...") is gone; this now just defines the brand in
 * plain crawlable prose, as both visible HTML and FAQPage JSON-LD.
 *
 * Every fact here comes from src/lib/org.ts so the wording cannot drift from
 * the Organization graph (Base.astro) or the legal-status copy.
 *
 * Mount on entity home pages only — /about today — not on every page;
 * repeating a FAQPage site-wide reads as spam.
 */
import { ORG } from '../lib/org';

const faqs: Array<{ q: string; a: string }> = [
  {
    q: 'What is Saathum?',
    a: `Saathum (saathum.com) is a live streaming and 1:1 video consultation platform for devotional and spiritual life — puja and darshan, temple tours, satsang and festivals, and astrology and spiritual-guidance sessions. Creators publish a listing, people book or join it, and the creator gets paid.`,
  },
  {
    q: 'Who runs Saathum?',
    a: `Saathum was founded by American and Indian founders and is operated by ${ORG.legalName}, a Delaware corporation. Its registered-agent address is ${ORG.address.street}, ${ORG.address.locality}, ${ORG.address.region} ${ORG.address.postalCode}. Contact: ${ORG.email}.`,
  },
  {
    q: 'What can I do on Saathum?',
    a: `Two things. Earn: create a free listing and get paid to host a live devotional event or run 1:1 astrology and spiritual-guidance consultations. Book: browse the marketplace, join a live event or book a creator's time in a slot they have opened on their calendar.`,
  },
  {
    q: 'Is Saathum free?',
    a: `Creating an account and publishing a listing is free. Buyers pay in tokens when they book or join a paid session. Saathum uses 100 Tokens = $1 as an internal accounting anchor; local-currency checkout uses a server-owned FX quote, and withdrawal semantics are not yet available.`,
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${ORG.url}about#faq`,
  about: { '@id': `${ORG.url}#organization` },
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<section class="entity-faq" id="what-is-saathum" aria-labelledby="entity-faq-title">
  <h2 data-i18n="web-common.0ff34d5107c1600d" id="entity-faq-title">What is Saathum?</h2>
  <p>
    <strong>Saathum</strong> <ui-copy style="display:contents" data-i18n="web-common.b29ef72e7a79fd4d">is the name of this platform, at</ui-copy> <a data-i18n="web-common.4d319a0fb45f536c" href="https://saathum.com/">saathum.com</a><ui-copy style="display:contents" data-i18n="web-common.cdb4ee2aea69cc6a">.</ui-copy>
  </p>
  <dl>
    {faqs.map((f) => (
      <>
        <dt>{f.q}</dt>
        <dd>{f.a}</dd>
      </>
    ))}
  </dl>
</section>
<script type="application/ld+json" set:html={JSON.stringify(faqLd)} />

<style>
  .entity-faq dl { margin: 0; }
  .entity-faq dt { font-weight: 700; margin-top: 1.1em; }
  .entity-faq dd { margin: 0.35em 0 0 0; }
</style>
