---
import brandConfig from '../../../../Specs/brand.json';
import { categories } from '../../lib/callvaalHomeReference';
import '../../styles/callvaal-chrome.css';
const identity = brandConfig.homepageIdentity;
const groups = [
  ['Company', ['About us', 'How it works', 'Contact us', 'Help centre', 'FAQs', 'Careers', 'Press & media', 'Accessibility']],
  ['Explore', ['All categories', 'Find your person', ...categories.map(category => category.name)]],
  ['Partners', ['Join & earn', 'Partner requirements', 'Verification guide', 'Partner help', 'Rates & earnings', 'Payouts & taxes', 'Partner agreement', 'Partner code of conduct']],
  ['Trust & Safety', ['Safety centre', 'Community guidelines', 'Report a user', 'Report a concern', 'Block & report guide', 'Grievance redressal', 'Professional standards', 'Emergency support']],
  ['Legal & Payments', ['Terms of use', 'Privacy policy', 'Cookie policy', 'Refund policy', 'Cancellation policy', 'Payment & wallet terms', 'Service disclaimer', 'Data deletion']],
] as const;
const anchors: Record<string, string> = {
  'All categories': '/#categories', 'Find your person': '/#people',
  'How it works': '/#privacy-note', 'Join & earn': '/#earn',
  'Safety centre': '/talk-safely', 'About us': '/about', 'Contact us': '/contact',
  'Help centre': '/help', 'Terms of use': '/terms', 'Privacy policy': '/privacy',
  'Cookie policy': '/cookies', 'Refund policy': '/refunds',
  'Grievance redressal': '/grievance', 'Service disclaimer': '/disclaimer',
};
---
<footer class="cv-footer" data-callvaal-chrome>
  <div class="cv-footer-brand"><a class="cv-wordmark" href="/" aria-label={`${identity.name} home`}>{identity.name}<span aria-hidden="true">′</span></a><p>Real people.<br/>Useful conversations.</p></div>
  <nav class="cv-footer-columns" aria-label="Footer">{groups.map(([heading, links]) => <details class="cv-footer-group" open><summary>{heading}</summary><ul>{links.map(label => {
    const category = heading === 'Explore' ? categories.find(category => category.name === label) : undefined;
    return <li>{category ? <a href={`/?category=${category.id}#people`}>{label}</a> : anchors[label] ? <a href={anchors[label]}>{label}</a> : <button type="button" data-footer-preview={label}>{label}</button>}</li>;
  })}</ul></details>)}</nav>
  <p class="cv-footer-copyright">© {new Date().getFullYear()} {identity.name}. All rights reserved. · Concept preview</p>
</footer>
<dialog class="cv-preview-dialog" id="cv-footer-dialog" aria-labelledby="cv-footer-dialog-title" aria-describedby="cv-footer-dialog-description"><h2 id="cv-footer-dialog-title">Concept preview</h2><p id="cv-footer-dialog-description">This page is not published for this service yet.</p><form method="dialog"><button autofocus>Close</button></form></dialog>
<script>
  import { capture } from '../../lib/analytics';
  const mobile = window.matchMedia('(max-width: 699px)');
  const groups = document.querySelectorAll<HTMLDetailsElement>('.cv-footer-group');
  function updateGroups() { groups.forEach(group => { group.open = !mobile.matches; }); }
  groups.forEach(group => group.querySelector('summary')?.addEventListener('click', event => { if (!mobile.matches) event.preventDefault(); }));
  mobile.addEventListener('change', updateGroups);
  updateGroups();
  const dialog = document.querySelector<HTMLDialogElement>('#cv-footer-dialog');
  let trigger: HTMLButtonElement | null = null;
  document.querySelectorAll<HTMLButtonElement>('[data-footer-preview]').forEach(button => button.addEventListener('click', () => {
    if (!dialog) return;
    trigger = button;
    const heading = dialog.querySelector('h2');
    if (heading) heading.textContent = button.dataset.footerPreview || 'Concept preview';
    dialog.showModal();
    capture('nav_click', { surface: 'callvaal-chrome', section: 'footer', label: button.dataset.footerPreview, preview: true });
  }));
  dialog?.addEventListener('close', () => { trigger?.focus(); trigger = null; });
  document.querySelectorAll<HTMLAnchorElement>('.cv-footer a').forEach(link => link.addEventListener('click', () => capture('nav_click', { surface: 'callvaal-chrome', section: 'footer', href: link.getAttribute('href') })));
</script>
