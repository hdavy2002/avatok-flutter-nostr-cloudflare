---
import brandConfig from '../../../../Specs/brand.json';
import AppTabBar from './AppTabBar.astro';
import '../../styles/callvaal-chrome.css';
interface Props { hideTagline?: boolean; }
const { hideTagline: _hideTagline = false } = Astro.props; // kept for callers; the footer no longer shows a tagline
const identity = brandConfig.homepageIdentity;
// [HF-HOME-POLISH-2] Owner 2026-10-17: six links per column so the desktop rows line up. KYC guide, Talk safely,
// Age policy, Cookies and Intermediary policy moved into the related pages (requirements, safety centre, privacy).
// [HF-VERIFIED-ONLY-1] Owner 2026-10-18: the gated women-only / LGBTQ+ lanes ended; labels are "Women's safety" and "LGBTQ+ safety".
const groups = [
  ['Company', [
    ['About us', '/about'], ['How it works', '/how-it-works'], ['FAQs', '/faq'], ['Help centre', '/help'], ['Contact us', '/contact'], ['Press', '/press'],
  ]],
  ['Influencers', [
    ['Join & earn', '/hosts/join'], ['Influencer requirements', '/hosts/requirements'], ['Influencer rules', '/hosts/rules'], ['Welfare & crisis guide', '/hosts/crisis-script'], ['Rates & payouts', '/hosts/rates'], ['Influencer agreement', '/hosts/agreement'],
  ]],
  ['Trust & Safety', [
    ['Safety centre', '/safety'], ['Community guidelines', '/community-guidelines'], ['Report a user', '/report'], ['Grievance redressal', '/grievance'], ['Emergency support', '/emergency'], ["Women's safety", '/women-only'],
  ]],
  ['Legal & Payments', [
    ['Terms of use', '/terms'], ['Service disclaimer', '/disclaimer'], ['Privacy policy', '/privacy'], ['Wallet terms', '/wallet-terms'], ['Refunds', '/refunds'], ['Data deletion', '/data-deletion'],
  ]],
  ['Explore', [
    ['Explore all influencers', '/marketplace'], ['Find an influencer', '/#naye-dost'], ['Popular topics', '/#moods'], ['Influencers you follow', '/#people'], ['LGBTQ+ safety', '/lgbtq'], ['Earn with us', '/hosts/join'],
  ]],
] as const;
---
<footer class="cv-footer notebook-footer" data-callvaal-chrome>
  {/* [HF-DESI-HOME-MOBILE-1] 2026-10-17: disclaimer is the owner's own wording from the desi design footer. */}
  {/* [HF-DASH-LAYOUT-1] Owner 2026-10-16: no logo and no tagline in the footer (the header already carries the logo). */}
  <nav class="cv-footer-columns footer-columns" aria-label="Footer">
    {groups.map(([heading, links]) => <details class="cv-footer-group footer-group" data-callvaal-footer-group open><summary>{heading}</summary><ul>{links.map(([label, href]) => <li><a href={href}>{label}</a></li>)}</ul></details>)}
  </nav>
  <div class="cv-footer-bottom">
    <p class="cv-footer-disclaimer"><strong>Disclaimer:</strong> {identity.name} connects you with the social media influencers you follow over private phone calls, with both phone numbers kept private. Our platform is not for consultations with doctors, lawyers, therapists, counsellors or financial advisors, and nothing said on a call is professional advice. We are not responsible for the relationship or rapport you build with any influencer, or for any outcome of a call. Sexual harassment, threats and abuse are prohibited; reports are reviewed, and serious or repeated violations can lead to removal. No human listens in. Spammy, sexual or threatening behaviour is not allowed, and you can press # at any time to end a call and block the person. 18+ only. If you are in crisis, call <a href="tel:14416">Tele-MANAS 14416</a> or <a href="tel:112">112</a>.</p>
    <div class="cv-footer-credits">
      <p class="cv-footer-made">Developed in India with <span class="cv-footer-heart" role="img" aria-label="love">♥</span></p>
    </div>
  </div>
</footer>
<AppTabBar />
<script>
  import { capture } from '../../lib/analytics';
  const mobile = window.matchMedia('(max-width: 699px)');
  const groups = document.querySelectorAll<HTMLDetailsElement>('.cv-footer-group');
  function updateGroups() { groups.forEach(group => { group.open = !mobile.matches; }); }
  groups.forEach(group => group.querySelector('summary')?.addEventListener('click', event => { if (!mobile.matches) event.preventDefault(); }));
  mobile.addEventListener('change', updateGroups);
  updateGroups();
  document.querySelectorAll<HTMLAnchorElement>('.cv-footer a').forEach(link => link.addEventListener('click', () => capture('nav_click', { surface: 'hello-fraands-chrome', section: 'footer', href: link.getAttribute('href') })));
</script>
