---
import brandConfig from '../../../../Specs/brand.json';
import BrandLogo from './BrandLogo.astro';
import '../../styles/callvaal-chrome.css';
const identity = brandConfig.homepageIdentity;
const groups = [
  ['Company', [
    ['About us', '/about'], ['How it works', '/how-it-works'], ['FAQs', '/faq'], ['Help centre', '/help'], ['Contact us', '/contact'], ['Press', '/press'],
  ]],
  ['Hosts', [
    ['Join & earn', '/hosts/join'], ['Host requirements', '/hosts/requirements'], ['Host rules', '/hosts/rules'], ['Welfare & crisis guide', '/hosts/crisis-script'], ['Rates & payouts', '/hosts/rates'], ['Host agreement', '/hosts/agreement'], ['KYC guide', '/hosts/kyc'],
  ]],
  ['Trust & Safety', [
    ['Safety centre', '/safety'], ['Community guidelines', '/community-guidelines'], ['Talk safely', '/talk-safely'], ['Recording & AI safety', '/recording-policy'], ['Report a user', '/report'], ['Grievance redressal', '/grievance'], ['Emergency support', '/emergency'], ['Women-only space', '/women-only'], ['LGBTQ+ space', '/lgbtq'], ['Age policy', '/age-policy'],
  ]],
  ['Legal & Payments', [
    ['Terms of use', '/terms'], ['Service disclaimer', '/disclaimer'], ['Privacy policy', '/privacy'], ['Wallet terms', '/wallet-terms'], ['Refunds', '/refunds'], ['Cookies', '/cookies'], ['Data deletion', '/data-deletion'], ['Intermediary policy', '/intermediary-policy'],
  ]],
  ['Explore', [
    ['Explore all hosts', '/marketplace'], ['Naye dost', '/#naye-dost'], ['All moods', '/#moods'], ['Apna dost dhundo', '/#people'], ['Sirf ladkiyon ke liye', '/#women-only'], ['Earn with us', '/#earn'],
  ]],
] as const;
---
<footer class="cv-footer notebook-footer" data-callvaal-chrome>
  <div class="cv-footer-brand footer-brand"><a class="cv-wordmark" href="/" aria-label={`${identity.name} home`}><BrandLogo /></a><p>Real people. Naye dost.<br/>Baat se baat banti hai.</p></div>
  <nav class="cv-footer-columns footer-columns" aria-label="Footer">
    {groups.map(([heading, links]) => <details class="cv-footer-group footer-group" data-callvaal-footer-group open><summary>{heading}</summary><ul>{links.map(([label, href]) => <li><a href={href}>{label}</a></li>)}</ul></details>)}
  </nav>
  <div class="cv-footer-bottom">
    <p class="cv-footer-disclaimer">{identity.name} is a preview of a planned place to talk. Hosts will be real people, not doctors, lawyers, therapists, counsellors or financial advisors, and nothing said on a call is professional advice. Sexual harassment, threats and abuse are prohibited; reports are reviewed and serious or repeated violations can lead to removal. Calls are not recorded; AI keeps an eye on every live call and ends abusive or scam calls. 18+ only. In crisis, call <a href="tel:14416">Tele-MANAS 14416</a> or <a href="tel:112">112</a>.</p>
    <p class="cv-footer-copyright footer-copyright"><span class="cv-age-badge">18+</span> © {'{{DATE_YEAR}}'} {'{{COMPANY_NAME}}'} · CIN {'{{CIN}}'} · Grievance officer: <a href="/grievance">{'{{GRIEVANCE_EMAIL}}'}</a></p>
  </div>
</footer>
<script>
  import { capture } from '../../lib/analytics';
  const mobile = window.matchMedia('(max-width: 699px)');
  const groups = document.querySelectorAll<HTMLDetailsElement>('.cv-footer-group');
  function updateGroups() { groups.forEach(group => { group.open = !mobile.matches; }); }
  groups.forEach(group => group.querySelector('summary')?.addEventListener('click', event => { if (!mobile.matches) event.preventDefault(); }));
  mobile.addEventListener('change', updateGroups);
  updateGroups();
  document.querySelectorAll<HTMLAnchorElement>('.cv-footer a').forEach(link => link.addEventListener('click', () => capture('nav_click', { surface: 'hello-fraands-chrome', section: 'footer', href: link.getAttribute('href') })));
</script>
