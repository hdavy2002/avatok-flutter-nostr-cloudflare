---
import brandConfig from '../../../../Specs/brand.json';
import ModernIcon from '../home/ModernIcon.astro';
import BrandLogo from './BrandLogo.astro';
import '../../styles/callvaal-chrome.css';
import { APP_UA_MARKER } from '../../lib/nativeBridge';
interface Props { hideAuth?: boolean; auth?: 'auto' | 'in' | 'static'; homeReference?: boolean; /** [HF-CHANNEL-WEB-1] Show the Bag button with its item count (channel, product, bag and checkout pages). */ bag?: boolean; }
const { hideAuth = false, auth = 'auto', homeReference = false, bag = false } = Astro.props;
// All modes keep plain links (no Clerk island); static pages still reflect the session hint.
const authMode = auth === 'in' ? 'in' : 'auto';
const path = Astro.url.pathname;
const onDashboard = Astro.url.pathname.replace(/\/$/, '') === '/dashboard';
const identity = brandConfig.homepageIdentity;
const homeAnchor = (id: string) => `${Astro.url.pathname === '/' ? '' : '/'}#${id}`;
---
{/* [HF-APP-3] App mode flag, set before first paint (this is the first thing in <body>, ahead of any visible markup):
    inside the Android shell (UA marker or window.Capacitor) the CSS under html.hf-app turns on the tab bar and hides the
    footer / marketing links. The document stays identical for every client, so it remains fully cacheable. */}
<script is:inline define:vars={{ marker: APP_UA_MARKER }}>
  (function () {
    try {
      var root = document.documentElement;
      if ((navigator.userAgent || '').indexOf(marker) !== -1 || window.Capacitor) {
        root.classList.add('hf-app');
      }
    } catch (e) {}
  })();
</script>
{/* Match the existing SiteHeader session hint before paint. This only selects
    navigation links; it never authorizes a request or loads a Clerk island. */}
<script is:inline>
  (function () {
    function syncAuthHint() {
      try {
        var match = document.cookie.match(/(?:^|;\s*)__client_uat(?:_[A-Za-z0-9]+)?=([^;]*)/);
        var signedIn = !!(match && match[1] && match[1] !== '0');
        if (!signedIn) {
          try { signedIn = !!localStorage.getItem('saathum_guest_jwt'); } catch (e) {}
        }
        document.documentElement.setAttribute('data-site-auth', signedIn ? 'in' : 'out');
      } catch (e) {
        document.documentElement.setAttribute('data-site-auth', 'out');
      }
    }
    syncAuthHint();
    window.addEventListener('pageshow', syncAuthHint);
    window.addEventListener('focus', syncAuthHint);
    window.addEventListener('storage', syncAuthHint);
    window.addEventListener('site:active-session-changed', syncAuthHint);
  })();
</script>
<header class="cv-header" data-callvaal-chrome data-auth-mode={authMode} data-home-reference={homeReference || undefined}>
  <a class="cv-wordmark" href="/" aria-label={`${identity.name} home`}><BrandLogo /></a>
  <div class="cv-mobile-actions">{bag && <a class="cv-bag-m" href="/bag" aria-label="Bag, 0 items"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 8h14l-1.2 12H6.2z"/><path d="M9 8a3 3 0 0 1 6 0"/></svg><b data-bag-count data-zero="1">0</b></a>}<a href={homeAnchor('people')} aria-label="Who's online"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="10" cy="10" r="6.5"/><path d="m15 15 6 6"/></svg></a><button class="cv-menu-toggle menu-toggle" data-callvaal-menu-toggle type="button" aria-expanded="false" aria-controls="main-navigation" aria-label="Open navigation"><ModernIcon name="menu" /></button></div>
  <nav class="cv-navigation notebook-nav" id="main-navigation" data-callvaal-navigation aria-label="Main navigation">{/* [HF-HEADER-STD-1 2026-10-19] Owner: one standard header on every page — Home, Explore, How it works, Help, then
      Sign in and the "Join us" CTA while signed out; once signed in only Dashboard and Sign out show (the session hint
      above flips html[data-site-auth] before paint). [HF-EXPLORE-NAV-1 2026-10-25] owner: Explore = public reels (/explore/ — the trailing slash dodges browsers that cached the old 301 to /marketplace), new "Search" = /marketplace. Earlier: [HF-LOGO-1], [HF-BLOG-ARCHIVE-1], [HF-HELP-NAV-1], [HF-HOW-NAV-1]. */}<a href="/" aria-current={path === '/' ? 'page' : undefined}>Home</a><a href="/explore/" aria-current={path.startsWith('/explore') || path.startsWith('/r/') ? 'page' : undefined}>Explore</a><a href="/marketplace" aria-current={path.startsWith('/marketplace') ? 'page' : undefined}>Search</a><a href="/how-it-works" aria-current={path.startsWith('/how-it-works') ? 'page' : undefined}>How it works</a><a href="/help" aria-current={path.startsWith('/help') ? 'page' : undefined}>Help</a>{!hideAuth && <>{auth !== 'in' && <a class="cv-sign-in cv-auth-out" href="/sign-in"><ModernIcon name="user" />Sign in</a>}<a class="cv-sign-in cv-auth-in cv-dashboards" href="/dashboard" aria-current={onDashboard ? 'page' : undefined}><ModernIcon name="user" />Dashboard</a><a class="cv-auth-in" href="/sign-out">Sign out</a></>}{auth !== 'in' && <a class="cv-join cv-auth-out" href="/hosts/join" aria-current={path.startsWith('/hosts/join') ? 'page' : undefined}>Join us</a>}{bag && <a class="cv-bag" href="/bag" aria-label="Bag, 0 items">Bag <b data-bag-count data-zero="1">0</b></a>}</nav>
</header>
<script>
  import { capture } from '../../lib/analytics';
  import { isAppMode } from '../../lib/nativeBridge';
  import { initBagBadge } from '../../lib/bagBadge';
  initBagBadge(); // [HF-CHANNEL-WEB-1] no-op unless this header has the Bag button
  // [HF-APP-3] back button, external links and app telemetry; loaded only inside the app shell.
  if (isAppMode()) void import('../../lib/appMode').then((m) => m.initAppMode());
  const toggle = document.querySelector<HTMLButtonElement>('.cv-menu-toggle');
  const nav = document.querySelector<HTMLElement>('.cv-navigation');
  function closeMenu(focus = false) {
    toggle?.setAttribute('aria-expanded', 'false');
    toggle?.setAttribute('aria-label', 'Open navigation');
    if (nav) nav.dataset.open = 'false';
    if (focus) toggle?.focus();
  }
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
    if (nav) nav.dataset.open = String(open);
  });
  document.addEventListener('keydown', event => { if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') closeMenu(true); });
  document.addEventListener('click', event => { if (event.target instanceof Node && !document.querySelector('.cv-header')?.contains(event.target)) closeMenu(); });
  document.querySelectorAll<HTMLAnchorElement>('.cv-header a').forEach(link => link.addEventListener('click', () => {
    closeMenu();
    capture('nav_click', { surface: 'callvaal-chrome', section: 'header', href: link.getAttribute('href') });
  }));
  window.matchMedia('(max-width: 699px)').addEventListener('change', () => closeMenu());
</script>
