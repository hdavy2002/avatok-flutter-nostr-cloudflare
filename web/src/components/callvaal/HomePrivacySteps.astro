---
import brandConfig from '../../../../Specs/brand.json';
const identity = brandConfig.homepageIdentity;
---
<ol class="home-privacy-steps">
  <li class="home-privacy-step home-privacy-step--choose">
    <span class="home-step-number" aria-hidden="true">1</span>
    <div class="home-step-photo">
      <picture>
        <source srcset="/assets/privacy/step-1.avif" type="image/avif" />
        <source srcset="/assets/privacy/step-1.webp" type="image/webp" />
        <img src="/assets/privacy/step-1.jpg" alt="A hand tapping Call on an audio-only contact screen." width="1200" height="900" loading="lazy" decoding="async" />
      </picture>
    </div>
    <h3>Tap Call</h3>
    <p>Choose a person and tap Call.</p>
  </li>
  <li class="home-privacy-step home-privacy-step--connect">
    <span class="home-step-number" aria-hidden="true">2</span>
    <div class="home-step-photo">
      <picture>
        <source srcset="/assets/privacy/step-2.avif" type="image/avif" />
        <source srcset="/assets/privacy/step-2.webp" type="image/webp" />
        <img src="/assets/privacy/step-2.jpg" alt="A woman reaching for her ringing phone, with an inset of a second phone lighting up on a desk." width="1200" height="900" loading="lazy" decoding="async" />
      </picture>
    </div>
    <h3>We ring the host first</h3>
    <p>{identity.name} calls the host first; then the caller after acceptance.</p>
  </li>
  <li class="home-privacy-step home-privacy-step--private">
    <span class="home-step-number" aria-hidden="true">3</span>
    <div class="home-step-photo">
      <picture>
        <source srcset="/assets/privacy/step-3.avif" type="image/avif" />
        <source srcset="/assets/privacy/step-3.webp" type="image/webp" />
        <img src="/assets/privacy/step-3.jpg" alt="A woman and a man smiling on their separate phone calls, shown side by side." width="1200" height="900" loading="lazy" decoding="async" />
      </picture>
      <span class="home-step-connector" aria-hidden="true"><span class="home-step-lock"></span></span>
    </div>
    <h3>Connected. Numbers hidden.</h3>
    <p>Both hear a short safety notice. The calls connect privately.</p>
  </li>
</ol>
