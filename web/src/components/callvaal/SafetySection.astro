---
import '../../styles/callvaal-safety-section.css';
const photos = [
  { name: 'safety-1', alt: 'Woman in a cotton kurta talking on the phone at home', className: 'hf-safety-photo--one' },
  { name: 'safety-2', alt: 'Hand holding a phone during a call', className: 'hf-safety-photo--two' },
  { name: 'safety-3', alt: 'Man talking calmly on the phone', className: 'hf-safety-photo--three' },
];
const rules = [
  { title: 'Spam & fraud', text: "OTP maangna, link bhejna, 'account verify karo' — turant band.", color: 'pink', icon: 'phone' },
  { title: 'Harassment & gaali', text: 'Threats, abuse, or not stopping when asked.', color: 'lilac', icon: 'hand' },
  { title: 'Buying & selling', text: 'No products, remedies, tips, or asking for money.', color: 'mint', icon: 'tag' },
  { title: 'Number & social exchange', text: 'No WhatsApp, Instagram, UPI IDs or meeting requests.', color: 'yellow', icon: 'social' },
];
---
<section class="hf-safety" id="safety" aria-labelledby="safety-title">
  <div class="hf-safety-inner">
    <span class="hf-safety-preview">Preview</span>
    <div class="hf-safety-intro">
      <div class="hf-safety-copy">
        <span class="hf-safety-eyebrow">KAISE SAFE HAI</span>
        <h2 id="safety-title">Dil khol ke bolo.<br /><span class="hf-safety-headline"><em>AI dhyaan rakhta hai.</em><svg viewBox="0 0 440 20" preserveAspectRatio="none" aria-hidden="true"><path d="M4 13C126 3 244 21 435 7"/></svg></span></h2>
        <p class="hf-safety-lead">AI-powered security on every call. Spam, abuse and fraud can end the call automatically. Your number stays private, always.</p>
        <div class="hf-safety-chips" aria-label="Safety features">
          <span><svg viewBox="0 0 32 32" aria-hidden="true"><rect x="7" y="14" width="18" height="14" rx="3"/><path d="M11 14V9a5 5 0 0 1 10 0v5m-5 5v4"/></svg>Number kabhi share nahi hota</span>
          <span><svg viewBox="0 0 32 32" aria-hidden="true"><path d="M16 2 28 7v8c0 8-5 13-12 16C9 28 4 23 4 15V7Z"/><path d="m10 16 4 4 8-9"/></svg>Har host video-KYC verified</span>
          <span><svg viewBox="0 0 32 32" aria-hidden="true"><path d="M2 17h5l3-8 4 16 4-22 4 26 3-12h5"/><path d="M5 30 28 3"/></svg>Spam ya gaali — call khud band</span>
        </div>
      </div>
      <div class="hf-safety-collage" aria-label="Three people on private phone calls with safety stickers">
        <svg class="hf-safety-wave" viewBox="0 0 520 170" fill="none" aria-hidden="true"><path d="M14 102C106 23 151 110 235 68S370 35 505 100" stroke="#FFFDF7" stroke-width="4" stroke-linecap="round" stroke-dasharray="3 12"/></svg>
        {photos.map(photo => <figure class={`hf-safety-photo ${photo.className}`}>
          <picture>
            <source type="image/avif" srcset={`/assets/safety/${photo.name}.avif`} />
            <source type="image/webp" srcset={`/assets/safety/${photo.name}.webp`} />
            <img src={`/assets/safety/${photo.name}.jpg`} alt={photo.alt} width="1200" height="1200" loading="lazy" decoding="async" />
          </picture>
        </figure>)}
        <span class="hf-safety-sticker hf-safety-ai"><svg viewBox="0 0 32 32" aria-hidden="true"><path d="M16 2 28 7v8c0 8-5 13-12 16C9 28 4 23 4 15V7Z"/><path d="m10 16 4 4 8-9"/></svg>AI on duty</span>
        <span class="hf-safety-hash-sticker"><b aria-hidden="true">#</b><span>dabao #</span></span>
        <span class="hf-safety-stamp">Call ended</span>
        <span class="hf-safety-round-sticker">24×7</span>
      </div>
    </div>
    <aside class="hf-safety-key" aria-labelledby="hf-safety-key-title">
      <span class="hf-safety-keycap" aria-hidden="true">#</span>
      <div><h3 id="hf-safety-key-title">Dabao <span aria-hidden="true">#</span><span class="hf-safety-sr-only">the hash key</span>. Call band, user block.</h3><p>Press <span aria-hidden="true">#</span><span class="hf-safety-sr-only">the hash key</span> any time during a call. The call ends, that person can never reach you again. Works for everyone, on any phone — no app needed.</p></div>
      <span class="hf-safety-sticker hf-safety-key-sticker">Blocked</span>
    </aside>
    <div class="hf-safety-rules">
      {rules.map(rule => <article class={`hf-safety-rule hf-safety-rule--${rule.color}`}>
        <svg viewBox="0 0 36 36" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" role="img" aria-label={rule.title}><title>{rule.title}</title>
          {rule.icon === 'phone' && <><path d="M8 5h19v26H8zM14 26h7M13 10h9M12 18l4-4 4 4M4 33 32 3"/></>}
          {rule.icon === 'hand' && <path d="M10 19V9a2 2 0 0 1 4 0v7-10a2 2 0 0 1 4 0v10-8a2 2 0 0 1 4 0v8-5a2 2 0 0 1 4 0v12c0 6-4 9-9 9-4 0-6-2-8-5l-5-7c-2-4 2-5 6-1Z"/>}
          {rule.icon === 'tag' && <><path d="M4 5h14l14 14-13 13L4 17zM10 11h.1M14 28l9-9M4 33 33 4"/></>}
          {rule.icon === 'social' && <><path d="M4 19a14 14 0 1 1 20 13H11l-7 2 2-7A14 14 0 0 1 4 19Z"/><path d="M15 23c-3-2-2-9 3-9 4 0 5 5 2 7-3 2-4-3-1-5M3 34 33 3"/></>}
        </svg>
        <h3>{rule.title}</h3><p>{rule.text}</p><span class="hf-safety-sticker hf-safety-rule-sticker">Call ends</span>
      </article>)}
    </div>
    <div class="hf-safety-trust">
      <p><span aria-hidden="true">✓</span> AI monitors calls for safety; flagged moments can be checked by a person.</p>
      <p><span aria-hidden="true">✓</span> Teen confirmed strikes, hamesha ke liye ban.</p>
      <span class="hf-safety-sticker hf-safety-trust-sticker">24×7</span>
      <a href="#women-only">Sirf ladkiyon ke liye <span aria-hidden="true">→</span></a>
    </div>
    <p class="hf-safety-crisis">In crisis? <a href="tel:14416">Tele-MANAS 14416</a> (free, 24×7) · <a href="tel:112">112</a></p>
  </div>
</section>
