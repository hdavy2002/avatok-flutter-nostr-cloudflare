---
import Base from '../../layouts/Base.astro';
import ModernIcon from '../home/ModernIcon.astro';
import DetailIcon from './DetailIcon.astro';
import brandConfig from '../../../../Specs/brand.json';
import { publicImage, publicImageSrcSet } from '../../lib/config';
import type { CallvaalProfileDetail } from '../../lib/callvaalProfileDetails';
import '../../styles/callvaal-detail.css';

interface Props { profile: CallvaalProfileDetail; }
const { profile } = Astro.props;
const identity = brandConfig.homepageIdentity;
const { portrait, gallery, topicTags: tags, services, reviews = [] } = profile;
const hasReviews = Boolean(profile.rating || reviews.length);
const rate = `₹${profile.ratePerMinute}/min`;
// Keep the JSON inert even if future fixture text contains markup-like characters.
const galleryJson = JSON.stringify(gallery.map(photo => ({ src: publicImage(photo.path, { width: 1280 }), srcset: publicImageSrcSet(photo.path, [640, 900, 1280]), alt: photo.alt, width: photo.width, height: photo.height }))).replace(/</g, '\\u003c');
---
<Base title={`${profile.displayName} — ${profile.roleLabel} | ${identity.name}`} description={profile.description} image={portrait.path} noindex={true} keywords="" lang="en-IN">
  <Fragment slot="head"><meta name="theme-color" content="#fffdf7" /></Fragment>
  <a class="cv-detail-skip" href="#profile-main">Skip to profile</a>
  <main class="cv-detail-main" id="profile-main" data-profile-id={profile.id} data-profile-name={profile.displayName} data-profile-category={profile.categoryId} data-profile-path={`/people/${profile.id}`}>
    <nav class="cv-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">›</span><a href={`/?category=${profile.categoryId}#people`}>{profile.categoryLabel}</a><span aria-hidden="true">›</span><span aria-current="page">{profile.displayName}</span></nav>
    <div class="cv-detail-layout">
      <div class="cv-detail-content">
        <section class="cv-profile-hero" aria-labelledby="profile-name">
          <div class="cv-profile-photo">
            <img src={publicImage(portrait.path, { width: 900 })} srcset={publicImageSrcSet(portrait.path, [420, 640, 900, 1280])} sizes="(max-width: 699px) calc(100vw - 32px), (max-width: 1099px) 32vw, 370px" width={portrait.width} height={portrait.height} alt={portrait.alt} fetchpriority="high" />
            {profile.availabilityLabel && <span class="cv-online" aria-label={`Illustrative availability: ${profile.availabilityLabel.toLowerCase()}`}><span aria-hidden="true"></span>{profile.availabilityLabel}</span>}
            <div class="cv-yellow-note" aria-hidden="true">{profile.yellowNote.map((line, index) => <Fragment>{index > 0 && <br/>}{line}</Fragment>)}<span>☺</span></div>
          </div>
          <div class="cv-identity">
            <div class:list={['cv-name-row', { 'cv-name-row-unverified': !profile.verification }]}><div><h1 id="profile-name">{profile.displayName}</h1><p class="cv-role">{profile.roleLabel}</p></div></div>
            {profile.verification?.status === 'illustrative' && <span class="cv-verified" role="img" aria-label={`Illustrative Verified ${profile.verification.registry} badge. This sample profile has not been verified.`}><span aria-hidden="true">✓ Verified · {profile.verification.registry}</span></span>}
            <ul class="cv-profile-facts">
              <li><DetailIcon name="chat"/><span>{profile.languages.join(', ')}</span></li>
              {profile.experienceYears !== undefined && <li><ModernIcon name="career"/><span>{profile.experienceYears}+ years experience</span></li>}
              {profile.rating && <li><span class="cv-star" aria-hidden="true">★</span><span><strong>{profile.rating.average}</strong> ({profile.rating.count} reviews)</span></li>}
              {profile.conversationCount !== undefined && <li><ModernIcon name="user"/><span>Talked to {profile.conversationCount} people</span></li>}
            </ul>
            {profile.personalQuote && <blockquote class="cv-profile-quote"><p>“{profile.personalQuote}”</p><cite>– {profile.displayName}</cite></blockquote>}
          </div>
          <div class="cv-profile-actions"><button type="button" data-profile-save aria-pressed="false" aria-label={`Save ${profile.displayName} for this visit`}><ModernIcon name="bookmark"/><span data-save-label>Save</span></button><button type="button" data-profile-share aria-label={`Share ${profile.displayName}'s sample profile`}><DetailIcon name="share"/><span>Share</span></button></div>
        </section>
        <p class="cv-sample-disclosure">{profile.sampleDisclosure}</p>
        <nav class="cv-profile-tabs" aria-label="Profile sections"><a href="#about" aria-current="location">About</a><a href="#services">Services</a>{hasReviews && <a href="#reviews">Reviews</a>}{gallery.length > 0 && <a href="#gallery">Gallery</a>}</nav>
        <div class="cv-information-grid">
          <section class="cv-info-card" id="about" aria-labelledby="about-heading">
            <h2 id="about-heading">About {profile.displayName}</h2><p>{profile.about}</p>
            {tags.length > 0 && <div class="cv-topic-tags-row"><ul class="cv-topic-tags cv-topic-tags-main">{tags.map(tag => <li>{tag}</li>)}</ul>{tags.length > 2 && <details class="cv-more-topics"><summary><span class="cv-see-more">See more</span><span class="cv-see-less">See less</span></summary><ul class="cv-topic-tags">{tags.slice(2).map(tag => <li>{tag}</li>)}</ul></details>}</div>}
          </section>
          <section class="cv-info-card" id="services" aria-labelledby="services-heading"><h2 id="services-heading">How I can help</h2><ul class="cv-service-list">{services.map(service => <li><span aria-hidden="true">✓</span>{service}</li>)}</ul></section>
        </div>
        {profile.serviceDisclosure && <p class="cv-service-disclosure">{profile.serviceDisclosure}</p>}
        {gallery.length > 0 && <section class="cv-gallery-section" id="gallery" aria-labelledby="gallery-heading"><div class="cv-section-heading"><h2 id="gallery-heading">Gallery</h2><button type="button" data-gallery-index="0">View all <span aria-hidden="true">→</span></button></div><div class="cv-gallery-grid">{gallery.map((photo, index) => <button type="button" data-gallery-index={index} aria-label={`Open gallery photo ${index + 1}: ${photo.alt}`}><img src={publicImage(photo.path, { width: 640 })} srcset={publicImageSrcSet(photo.path, [420, 640, 900])} sizes={index === 0 ? "(max-width: 699px) calc(100vw - 32px), (max-width: 1099px) 28vw, 320px" : "(max-width: 699px) 43vw, (max-width: 1099px) 28vw, 320px"} alt={photo.alt} width={photo.width} height={photo.height} loading="lazy" /></button>)}</div></section>}
        {hasReviews && <section class="cv-reviews-section" id="reviews" aria-labelledby="reviews-heading"><h2 id="reviews-heading">Reviews</h2><div class:list={['cv-reviews-grid', { 'cv-reviews-without-summary': !profile.rating }]}>
          {profile.rating && <div class="cv-review-summary"><strong><span class="cv-star" aria-hidden="true">★</span> {profile.rating.average}</strong><p>Based on {profile.rating.count} reviews</p></div>}
          {reviews.map(review => <article class="cv-review-card" aria-label={`Sample review by ${review.name}`}><span class="cv-review-avatar" aria-hidden="true">{review.initials}</span><div><div class="cv-review-heading"><h3>{review.name}</h3>{review.date && review.iso && <time datetime={review.iso}>{review.date}</time>}</div>{profile.reviewLabel && <span class="cv-review-sample">{profile.reviewLabel}</span>}{review.rating !== undefined && <span class="cv-review-stars" aria-label={`${review.rating} out of 5 stars`}>{'★'.repeat(review.rating)}{'☆'.repeat(5 - review.rating)}</span>}<p>{review.text}</p></div></article>)}
        </div></section>}
        {profile.preparationTips.length > 0 && <section class="cv-before-section" aria-labelledby="before-heading"><h2 id="before-heading">Before you call</h2><div class="cv-before-grid">{profile.preparationTips.map(tip => <div class="cv-before-card">{tip.icon === 'user' ? <ModernIcon name="user"/> : <DetailIcon name={tip.icon}/>}<div><h3>{tip.title}</h3><p>{tip.text}</p></div></div>)}</div></section>}
      </div>
      <aside class="cv-booking-rail" aria-label="Sample consultation options">
        <div class="cv-booking-card"><strong class="cv-rate">{rate}</strong><button class="cv-call-button" type="button" data-profile-preview="call"><ModernIcon name="phone"/>Call now</button><button class="cv-book-button" type="button" data-profile-preview="book"><DetailIcon name="calendar"/>Book a time</button>{profile.nextAvailableLabel && <p class="cv-next-slot"><DetailIcon name="calendar"/>Next available {profile.nextAvailableLabel}</p>}<ul class="cv-booking-benefits">{profile.benefits.map(benefit => <li>{benefit.icon === 'lock' ? <ModernIcon name="lock"/> : <DetailIcon name={benefit.icon}/>}<div><strong>{benefit.title}</strong><span>{benefit.text}</span></div></li>)}</ul><div class="cv-pink-note" aria-hidden="true">{profile.pinkNote.map((line, index) => <Fragment>{index > 0 && <br/>}{line}</Fragment>)}</div><small class="cv-booking-sample">Concept preview · No live calls or bookings</small></div>
        <p class="cv-rail-scribble" aria-hidden="true">Baat se<br/>baat banti<br/>hai.</p>
      </aside>
    </div>
    <p class="cv-detail-status" role="status" aria-live="polite" data-profile-status></p>
  </main>
  <div class="cv-mobile-booking" aria-label="Sample call options"><strong>{rate}</strong><button class="cv-call-button" type="button" data-profile-preview="call"><ModernIcon name="phone"/>Call now</button></div>
  <dialog class="cv-detail-dialog" id="cv-profile-preview" aria-labelledby="cv-profile-preview-title" aria-describedby="cv-profile-preview-description"><button class="cv-dialog-close" type="button" data-dialog-close aria-label="Close preview">×</button><h2 id="cv-profile-preview-title">Call {profile.displayName}</h2><p id="cv-profile-preview-description">{profile.previewDisclosure}{profile.serviceDisclosure && ` ${profile.serviceDisclosure}`}</p><form method="dialog"><button class="cv-book-button">Got it</button></form></dialog>
  <dialog class="cv-detail-dialog cv-gallery-dialog" id="cv-gallery-dialog" aria-labelledby="cv-gallery-caption"><button class="cv-dialog-close" type="button" data-dialog-close aria-label="Close gallery">×</button><figure><img data-gallery-image alt="" width={portrait.width} height={portrait.height}/><figcaption id="cv-gallery-caption" aria-live="polite"></figcaption></figure><div class="cv-gallery-controls"><button type="button" data-gallery-step="-1" aria-label="Previous photo">←</button><span data-gallery-count></span><button type="button" data-gallery-step="1" aria-label="Next photo">→</button></div></dialog>
  <dialog class="cv-detail-dialog" id="cv-share-dialog" aria-labelledby="cv-share-title"><button class="cv-dialog-close" type="button" data-dialog-close aria-label="Close share dialog">×</button><h2 id="cv-share-title">Share this sample profile</h2><p>Copy this link to share:</p><label class="cv-visually-hidden" for="cv-share-url">Profile link</label><input id="cv-share-url" type="url" readonly/><button type="button" class="cv-book-button" data-copy-link>Copy link</button><p role="status" data-share-status></p></dialog>
  <script type="application/json" id="cv-gallery-data" set:html={galleryJson} />
  <script>import './profileDetail';</script>
</Base>
