---
import Base from '../../layouts/Base.astro';
import ModernIcon from '../home/ModernIcon.astro';
import DetailIcon from './DetailIcon.astro';
import brandConfig from '../../../../Specs/brand.json';
import { publicImage, publicImageSrcSet } from '../../lib/config';
import { callActionLabel, moods } from '../../lib/callvaalHomeReference';
import { shortCallDisclaimer, type CallvaalProfileDetail } from '../../lib/callvaalProfileDetails';
import '../../styles/callvaal-detail.css';

// [HF-PROFILE-DETAIL-2] The card's fields (tagline, talked-to, regulars, voice
// intro, languages, conversation style, topics, 10-minute estimate) now appear
// here too, plus sample reviews and a demo "write a review" form.
interface Props { profile: CallvaalProfileDetail; }
const { profile } = Astro.props;
const { card, portrait, gallery, reviews, rating } = profile;
const identity = brandConfig.homepageIdentity;
const moodLabel = (slug: string) => moods.find(mood => mood.slug === slug)?.label ?? slug;
const topics = card.moods.map(moodLabel);
const rate = `₹${card.price}/min`;
const tenMinutes = `10 min ≈ ₹${card.price * 10}`;
const callLabel = card.availability === 'online' ? 'Call now' : callActionLabel[card.availability];
const callAction = card.availability === 'online' ? 'call' : 'notify';
const hasRegulars = card.regulars.startsWith('Regulars:');
const talkCategories = [
  { slug: 'womens-issues', label: 'Women’s Issues' }, { slug: 'uncensored-talk', label: 'Uncensored Talk' },
  { slug: 'dating-relationships', label: 'Dating & Relationship Questions' }, { slug: 'shaadi-marriage', label: 'Shaadi & Marriage' },
  { slug: 'late-night-chat', label: 'Late-night Conversations' }, { slug: 'friendship-company', label: 'Friendship & Everyday Company' },
  { slug: 'breakups-moving-on', label: 'Breakups & Moving On' }, { slug: 'family-relationships', label: 'Family & Relationships' },
  { slug: 'work-study-stress', label: 'Work & Study Stress' }, { slug: 'new-city-fresh-starts', label: 'New City & Fresh Starts' },
  { slug: 'lgbtq-conversations', label: 'LGBTQ+ Conversations' }, { slug: 'confidence-self-expression', label: 'Confidence & Self-expression' },
  { slug: 'music-movies-culture', label: 'Music, Movies & Pop Culture' }, { slug: 'creator-life', label: 'Creator Life & Social Media' },
  { slug: 'everyday-chat', label: 'Everyday Chat' }, { slug: 'language-culture', label: 'Language & Culture' },
];
const selectedTalkCategories = ['womens-issues', 'late-night-chat', 'friendship-company'];
const calendarDays = Array.from({ length: 35 }, (_, index) => {
  const day = index - 3;
  if (day < 1 || day > 31) return null;
  return { day, available: day >= 15 && ![19, 23, 26].includes(day) };
});
const profileBenefits = profile.id === 'neha' ? [
  { icon: 'lock' as const, title: 'Your number stays private', text: `${identity.name} connects callers and influencers through incoming calls, so neither sees the other’s phone number. We never share personal details with anyone.` },
  { icon: 'shield' as const, title: 'Video-KYC badge', text: 'Influencers are video-KYC verified against their social media channels.' },
  { icon: 'sparkle' as const, title: 'AI-generated avatars', text: 'All images are AI-generated avatars to protect influencers’ privacy.' },
  { icon: 'chat' as const, title: 'Your pace, your choice', text: 'Share only what feels comfortable' },
] : profile.benefits;
const stars = (n: number) => '★'.repeat(n) + '☆'.repeat(5 - n);
const maxBar = Math.max(...rating.breakdown);
const waveform = [20, 35, 55, 30, 65, 90, 50, 35, 70, 45, 25, 55, 80, 40, 65, 100, 70, 45, 30, 60, 80, 50, 35, 65, 40, 25, 50, 75, 45, 30, 55, 70, 40, 25, 60, 85, 50, 30, 45, 65];
// Keep the JSON inert even if future fixture text contains markup-like characters.
const galleryJson = JSON.stringify(gallery.map(photo => ({ src: publicImage(photo.path, { width: 1280 }), srcset: publicImageSrcSet(photo.path, [640, 900, 1280]), alt: photo.alt, width: photo.width, height: photo.height }))).replace(/</g, '\\u003c');
---
<Base title={`${profile.displayName} — ${profile.roleLabel} | ${identity.name}`} description={profile.description} image={portrait.path} noindex={true} keywords="" lang="en-IN">
  <Fragment slot="head"><meta name="theme-color" content="#fffdf7" /></Fragment>
  <a class="cv-detail-skip" href="#profile-main">Skip to profile</a>
  <main class="cv-detail-main" id="profile-main" data-profile-id={profile.id} data-profile-name={profile.displayName} data-profile-path={`/people/${profile.id}`}>
    <nav class="cv-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">›</span><a href="/marketplace">Explore</a><span aria-hidden="true">›</span><span aria-current="page">{profile.displayName}</span></nav>
    <div class="cv-detail-layout">
      <div class="cv-detail-content">
        <section class="cv-profile-hero" aria-labelledby="profile-name">
          <div class="cv-profile-photo">
            <img src={publicImage(portrait.path, { width: 900 })} srcset={publicImageSrcSet(portrait.path, [420, 640, 900, 1280])} sizes="(max-width: 699px) calc(100vw - 32px), (max-width: 1099px) 32vw, 370px" width={portrait.width} height={portrait.height} alt={portrait.alt} fetchpriority="high" />
            <span class:list={['cv-online', `cv-status-${card.availability}`]} aria-label={`Illustrative availability: ${profile.availabilityLabel.toLowerCase()}`}><span aria-hidden="true"></span>{profile.availabilityLabel}</span>
            <div class="cv-yellow-note" aria-hidden="true">{profile.yellowNote.map((line, index) => <Fragment>{index > 0 && <br/>}{line}</Fragment>)}<span>☺</span></div>
          </div>
          <div class="cv-identity">
            <div class="cv-name-row"><div><h1 id="profile-name">{profile.displayName}</h1><p class="cv-role">{card.tagline}</p></div></div>
            <span class="cv-verified" role="img" aria-label="Illustrative video-KYC badge. This sample profile has not been verified."><span aria-hidden="true">{profile.id === 'neha' ? 'video-KYC ✓' : 'video-KYC ✓ · Sample'}</span></span>
            <ul class="cv-profile-stats">
              <li><span class="cv-star" aria-hidden="true">★</span><a href="#reviews"><strong>{rating.average}</strong><span>{rating.count} reviews</span></a></li>
              <li><ModernIcon name="user"/><p><strong>{card.talkedTo} people</strong><span>have talked to {profile.displayName}</span></p></li>
              <li><ModernIcon name={hasRegulars ? 'user' : 'clock'}/><p><strong>{card.regulars}</strong><span>{hasRegulars ? 'keep coming back' : 'sample availability'}</span></p></li>
            </ul>
            <div class="cv-voice" data-voice aria-label={`Demo voice introduction for ${profile.displayName}`}>
              <button type="button" data-voice-play aria-pressed="false" aria-label={`Play ${profile.displayName}’s introduction`}><span class="cv-voice-play"><ModernIcon name="play" /></span><span class="cv-voice-pause" aria-hidden="true">❚❚</span></button>
              <div><span>Hear my introduction</span><div class="cv-voice-wave" aria-hidden="true">{waveform.map(height => <i style={`height:${height}%`}></i>)}</div></div>
              <small data-voice-time>0:20</small>
            </div>
            <p class="cv-voice-caption" data-voice-caption hidden>{profile.intro} <span>(Demo — no recording is playing.)</span></p>
            <blockquote class="cv-profile-quote"><p>“{profile.personalQuote}”</p><cite>– {profile.displayName}</cite></blockquote>
          </div>
          <div class="cv-profile-actions"><button type="button" data-profile-save aria-pressed="false" aria-label={`Save ${profile.displayName} for this visit`}><ModernIcon name="bookmark"/><span data-save-label>Save</span></button><button type="button" data-profile-share aria-label={`Share ${profile.displayName}'s sample profile`}><DetailIcon name="share"/><span>Share</span></button></div>
          {profile.id === 'neha' && <div class="hf-availability" role="group" aria-label="Profile availability"><span class="hf-availability-label">Availability</span><button type="button" class="hf-status-button hf-status-online" aria-pressed="true" data-hf-status="online">Online now</button><button type="button" class="hf-status-button hf-status-offline" aria-pressed="false" data-hf-status="offline">Offline</button><button type="button" class="hf-join-now" data-profile-preview="call">Join now</button></div>}
        </section>
        <nav class="cv-profile-tabs" aria-label="Profile sections"><a href="#about" aria-current="location">About</a><a href="#moods">Topics</a><a href="#reviews">Reviews</a></nav>
        {profile.id === 'neha' && <section class="hf-category-section" aria-labelledby="hf-category-title"><div class="hf-category-heading"><div><span class="hf-category-eyebrow">Creator profile</span><h2 id="hf-category-title">Categories</h2></div><p>Neha is comfortable talking about these categories.</p></div><div class="hf-category-options">{talkCategories.map(category => <label class="hf-category-option"><input type="checkbox" name="neha-categories" value={category.slug} checked={selectedTalkCategories.includes(category.slug)} /><span>{category.label}</span></label>)}</div></section>}
        <div class="cv-information-grid">
          <section class="cv-info-card" id="about" aria-labelledby="about-heading">
            <h2 id="about-heading">About {profile.displayName}</h2><p>{profile.about}</p>
            <dl class="cv-detail-facts">
              <div><dt><ModernIcon name="globe" />Languages</dt><dd>{card.languages}</dd></div>
              <div><dt><ModernIcon name="sparkle" />Conversation style</dt><dd>{card.conversationStyle || 'Details coming soon'}</dd></div>
            </dl>
          </section>
          <section class="cv-info-card" id="moods" aria-labelledby="moods-heading"><h2 id="moods-heading">Let’s talk <em>about</em></h2><ul class="cv-detail-topics">{topics.map(topic => <li><DetailIcon name="chat" /><span>{topic}</span></li>)}</ul><p class="cv-mood-note">Pick a topic, bring a story, or just say hello.</p></section>
        </div>
        <p class="cv-service-disclosure">{profile.serviceDisclosure}</p>
        {gallery.length > 0 && <section class="cv-gallery-section" id="gallery" aria-labelledby="gallery-heading"><div class="cv-section-heading"><h2 id="gallery-heading">Gallery</h2><button type="button" data-gallery-index="0">View all <span aria-hidden="true">→</span></button></div><div class="cv-gallery-grid">{gallery.map((photo, index) => <button type="button" data-gallery-index={index} aria-label={`Open gallery photo ${index + 1}: ${photo.alt}`}><img src={publicImage(photo.path, { width: 640 })} srcset={publicImageSrcSet(photo.path, [420, 640, 900])} sizes="(max-width: 699px) 43vw, (max-width: 1099px) 28vw, 320px" alt={photo.alt} width={photo.width} height={photo.height} loading="lazy" /></button>)}</div></section>}
        <section class="cv-reviews-section" id="reviews" aria-labelledby="reviews-heading">
          <div class="cv-section-heading"><h2 id="reviews-heading">Reviews</h2><button type="button" class="cv-write-review" data-review-open><DetailIcon name="chat" />Write a review</button></div>
          <div class="cv-reviews-layout">
            <div class="cv-review-summary">
              <strong><span class="cv-star" aria-hidden="true">★</span> {rating.average}</strong>
              <span class="cv-review-stars" aria-hidden="true">{stars(Math.round(rating.average))}</span>
              <p>Based on <span data-review-count>{rating.count}</span> reviews</p>
              <ul class="cv-rating-bars" aria-label="Rating breakdown">
                {rating.breakdown.map((count, index) => <li><span>{5 - index} ★</span><span class="cv-rating-bar" aria-hidden="true"><i style={`width:${maxBar ? Math.round(count / maxBar * 100) : 0}%`}></i></span><span>{count}</span><span class="cv-visually-hidden">{`${count} reviews with ${5 - index} stars`}</span></li>)}
              </ul>
              <p class="cv-review-rule">Only people who have talked to {profile.displayName} can leave a review.</p>
            </div>
            <div class="cv-review-list" data-review-list>
              {reviews.map(review => <article class="cv-review-card" aria-label={`Sample review by ${review.name}`}>
                <span class="cv-review-avatar" aria-hidden="true">{review.initials}</span>
                <div>
                  <div class="cv-review-heading"><h3>{review.name}{review.regular && <span class="cv-review-regular">Regular</span>}</h3><time datetime={review.iso}>{review.date}</time></div>
                  <span class="cv-review-stars" aria-label={`${review.rating} out of 5 stars`}>{stars(review.rating)}</span>
                  <p>{review.text}</p>
                  <p class="cv-review-meta">{[review.mood, review.minutes ? `${review.minutes} min call` : '', profile.reviewLabel].filter(Boolean).join(' · ')}</p>
                </div>
              </article>)}
            </div>
          </div>
        </section>
        {profile.id === 'neha' && <nav class="hf-profile-pagination" aria-label="Profile section pagination"><span data-hf-page-count>Section 1 of 3</span><a data-hf-page-nav="previous" href="#about" aria-disabled="true">← Previous</a><a data-hf-page-index="0" href="#about" aria-current="location">1 About</a><a data-hf-page-index="1" href="#reviews">2 Reviews</a><a data-hf-page-index="2" href="#before-heading">3 Before you call</a><a data-hf-page-nav="next" href="#reviews">Next →</a></nav>}
        <section class="cv-before-section" aria-labelledby="before-heading"><h2 id="before-heading">Before you call</h2><div class="cv-before-grid">{profile.preparationTips.map(tip => <div class="cv-before-card">{tip.icon === 'user' ? <ModernIcon name="user"/> : <DetailIcon name={tip.icon}/>}<div><h3>{tip.title}</h3><p>{tip.text}</p></div></div>)}</div></section>
        {profile.id === 'neha' && <p class="cv-sample-disclosure">{profile.sampleDisclosure}</p>}
      </div>
      <aside class="cv-booking-rail" aria-label="Sample conversation options">
        {profile.id === 'neha' && <section class="hf-calendar-card" aria-labelledby="hf-calendar-title"><div class="hf-calendar-heading"><span>Plan a conversation</span><h2 id="hf-calendar-title">Choose a time</h2></div><div class="hf-calendar-month"><button type="button" aria-label="Previous month" disabled>‹</button><strong>October 2026</strong><button type="button" aria-label="Next month">›</button></div><div class="hf-calendar-weekdays" aria-hidden="true">{['S','M','T','W','T','F','S'].map(day => <span>{day}</span>)}</div><div class="hf-calendar-grid" role="group" aria-label="Available dates in October 2026">{calendarDays.map(day => day ? <button type="button" class:list={['hf-calendar-day', day.available ? 'is-available' : 'is-unavailable', day.day === 15 ? 'is-selected' : '']} disabled={!day.available} aria-pressed={day.day === 15} data-hf-day={day.day}>{day.day}</button> : <span class="hf-calendar-blank" aria-hidden="true"></span>)}</div><p class="hf-calendar-selection" aria-live="polite">Thursday, October 15 selected</p><div class="hf-time-options" role="group" aria-label="Available times">{['7:00 pm','7:30 pm','8:00 pm'].map((time,index) => <button type="button" class:list={['hf-time-option', index === 0 ? 'is-selected' : '']} aria-pressed={index === 0} data-hf-time={time}>{time}</button>)}</div><p class="hf-time-selection" aria-live="polite">Selected time: 7:00 pm</p></section>}
        <div class="cv-booking-card"><strong class="cv-rate">{rate}</strong><p class="cv-rate-estimate">{tenMinutes}</p><button class="cv-call-button" type="button" data-profile-preview={callAction}><ModernIcon name={callAction === 'call' ? 'phone' : 'bell'}/>{callLabel}</button><button class="cv-book-button" type="button" data-profile-preview="book"><DetailIcon name="calendar"/>Book a time</button>{profile.nextAvailableLabel && <p class="cv-next-slot"><DetailIcon name="calendar"/>Next available {profile.nextAvailableLabel}</p>}<ul class="cv-booking-benefits">{profileBenefits.map(benefit => <li>{benefit.icon === 'lock' || benefit.icon === 'sparkle' ? <ModernIcon name={benefit.icon}/>: <DetailIcon name={benefit.icon}/>}<div><strong>{benefit.title}</strong><span>{benefit.text}</span></div></li>)}</ul>{profile.id === 'neha' ? <figure class="cv-call-photo"><img src={publicImage('/assets/callvaal/neha-call-split.png', { width: 640 })} srcset={publicImageSrcSet('/assets/callvaal/neha-call-split.png', [420, 640, 900])} sizes="(max-width: 699px) calc(100vw - 48px), 300px" alt="Two women in separate places, each talking on a phone call" width="900" height="500" loading="lazy"/><figcaption>Two people, connected by a call</figcaption></figure> : <div class="cv-pink-note" aria-hidden="true">{profile.pinkNote.map((line, index) => <Fragment>{index > 0 && <br/>}{line}</Fragment>)}</div>}{profile.id !== 'neha' && <small class="cv-booking-sample">Concept preview · No live calls or bookings</small>}</div>
        <p class="cv-rail-scribble" aria-hidden="true">Baat se<br/>baat banti<br/>hai.</p>
      </aside>
    </div>
    <p class="cv-detail-status" role="status" aria-live="polite" data-profile-status></p>
  </main>
  <div class="cv-mobile-booking" aria-label="Sample call options"><div><strong>{rate}</strong><small>{tenMinutes}</small></div><button class="cv-call-button" type="button" data-profile-preview={callAction}><ModernIcon name={callAction === 'call' ? 'phone' : 'bell'}/>{callLabel}</button></div>
  <dialog class="cv-detail-dialog" id="cv-profile-preview" aria-labelledby="cv-profile-preview-title" aria-describedby="cv-profile-preview-description"><h2 id="cv-profile-preview-title">Before you call</h2><p id="cv-profile-preview-description">{shortCallDisclaimer}</p><p>{profile.previewDisclosure}</p><form method="dialog"><button class="cv-book-button" data-disclaimer-ack value="acknowledged">Got it</button></form></dialog>
  <dialog class="cv-detail-dialog cv-review-dialog" id="cv-review-dialog" aria-labelledby="cv-review-title">
    <button class="cv-dialog-close" type="button" data-dialog-close aria-label="Close review form">×</button>
    <h2 id="cv-review-title">Review your call with {profile.displayName}</h2>
    <p class="cv-review-demo-note">Demo: your review shows on this page only and is not saved. On the live site, only people who have had a call with {profile.displayName} can review, and every review is checked before it appears.</p>
    <form data-review-form novalidate>
      <fieldset class="cv-star-picker"><legend>Your rating</legend>
        <div>{[5, 4, 3, 2, 1].map(n => <Fragment><input type="radio" name="rating" id={`cv-rate-${n}`} value={n} required /><label for={`cv-rate-${n}`} aria-label={`${n} star${n > 1 ? 's' : ''}`}>★</label></Fragment>)}</div>
      </fieldset>
      <label for="cv-review-mood">What did you talk about? <span>(optional)</span></label>
      <select id="cv-review-mood" name="mood"><option value="">Choose a topic</option>{topics.map(topic => <option value={topic}>{topic}</option>)}</select>
      <label for="cv-review-name">Your first name <span>(optional — only your first name is shown)</span></label>
      <input id="cv-review-name" name="name" type="text" maxlength="30" autocomplete="given-name" placeholder="e.g. Rahul" />
      <label for="cv-review-text">Your review</label>
      <textarea id="cv-review-text" name="text" rows="4" minlength="10" maxlength="400" required placeholder={`How was your conversation with ${profile.displayName}?`}></textarea>
      <p class="cv-review-hint">Keep it kind and about the conversation. Never share phone numbers, addresses or other personal details.</p>
      <p class="cv-review-error" role="alert" data-review-error></p>
      <button type="submit" class="cv-call-button">Post review</button>
    </form>
  </dialog>
  <dialog class="cv-detail-dialog cv-gallery-dialog" id="cv-gallery-dialog" aria-labelledby="cv-gallery-caption"><button class="cv-dialog-close" type="button" data-dialog-close aria-label="Close gallery">×</button><figure><img data-gallery-image alt="" width={portrait.width} height={portrait.height}/><figcaption id="cv-gallery-caption" aria-live="polite"></figcaption></figure><div class="cv-gallery-controls"><button type="button" data-gallery-step="-1" aria-label="Previous photo">←</button><span data-gallery-count></span><button type="button" data-gallery-step="1" aria-label="Next photo">→</button></div></dialog>
  <dialog class="cv-detail-dialog" id="cv-share-dialog" aria-labelledby="cv-share-title"><button class="cv-dialog-close" type="button" data-dialog-close aria-label="Close share dialog">×</button><h2 id="cv-share-title">Share this sample profile</h2><p>Copy this link to share:</p><label class="cv-visually-hidden" for="cv-share-url">Profile link</label><input id="cv-share-url" type="url" readonly/><button type="button" class="cv-book-button" data-copy-link>Copy link</button><p role="status" data-share-status></p></dialog>
  <script type="application/json" id="cv-gallery-data" set:html={galleryJson} />
  <script>import './profileDetail';</script>
</Base>
