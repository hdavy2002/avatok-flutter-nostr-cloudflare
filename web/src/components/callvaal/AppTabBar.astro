---
// [HF-APP-3] Bottom tab bar for the Android app shell. Always in the markup, display:none unless <html class="hf-app">
// (CSS in styles/callvaal-chrome.css), so the plain website renders exactly as before and cached HTML is identical for everyone.
// Every account shares Dashboard; Calls opens wallet call history.
import ModernIcon from '../home/ModernIcon.astro';
const tabs = [
  { id: 'home', href: '/', label: 'Home', icon: 'home' },
  { id: 'calls', href: '/wallet#hfw-hist', label: 'Calls', icon: 'phone' },
  { id: 'wallet', href: '/wallet', label: 'Wallet', icon: 'payment' },
  { id: 'dashboard', href: '/dashboard', label: 'Dashboard', icon: 'user' },
];
---
<nav class="hf-tabbar" aria-label="App navigation" data-hf-tabbar>
  {tabs.map((t) => <a href={t.href} data-hf-tab={t.id}><ModernIcon name={t.icon} /><span>{t.label}</span></a>)}
</nav>
<script>
  // Highlight the current tab. Runs on every page but only touches the DOM in app mode.
  import { isAppMode } from '../../lib/nativeBridge';
  if (isAppMode()) {
    const path = location.pathname.replace(/\/+$/, '') || '/';
    let current = '';
    if (path === '/') current = 'home';
    else if (path === '/hosts/dashboard') current = 'dashboard';
    else if (path === '/wallet') current = location.hash === '#hfw-hist' ? 'calls' : 'wallet';
    else if (path.startsWith('/dashboard') || path.startsWith('/account')) current = 'dashboard';
    else if (path === '/marketplace' || path.startsWith('/h/') || path.startsWith('/people')) current = 'home';
    document.querySelector(`[data-hf-tab="${current}"]`)?.setAttribute('aria-current', 'page');

  }
</script>
