---
import '../../styles/callvaal-women-section.css';
import { publicImage, publicImageSrcSet } from '../../lib/config';
---
{/* Public preview stays visible to everyone. Launch auth must gate lane entry AND
    server-returned listings to signed-in gender_verified F/T accounts; hiding UI
    alone is insufficient. Once auth is wired, verified users enter the lane and
    others see verification. This preview starts no KYC and exposes no listings. */}
<section class="hf-women" id="women-only" aria-labelledby="hf-women-title">
  <div class="hf-women-copy">
    <p class="hf-women-eyebrow"><span aria-hidden="true">✳</span> WOMEN-ONLY SPACE</p>
    <h2 id="hf-women-title"><span>Only for women.</span><em>A place to talk freely.</em></h2>
    <p class="hf-women-intro">A women-only space. Periods, PCOS worries, saas-bahu, pregnancy nerves, 3am with a newborn — talk to another woman who gets it.</p>
    <p class="hf-women-plan">A public preview of a private lane. At launch, both callers and hosts will need verification before entering. Video KYC, Aadhaar checks and calls that keep personal numbers private are planned.</p>
    <ul class="hf-women-proof" aria-label="Planned safeguards at launch">
      <li><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 2 3 6v6c0 5 9 10 9 10s9-5 9-10V6Z"/><path d="m7 12 3 3 7-7"/></svg><span>Video KYC + Aadhaar, both sides<small>Planned for launch</small></span></li>
      <li><svg aria-hidden="true" viewBox="0 0 24 24"><rect x="6" y="2" width="12" height="20" rx="3"/><path d="M10 5h4m-4 14h4m-5-8 3 3 4-5"/></svg><span>Number never shared<small>Planned private call connection</small></span></li>
    </ul>
    <p class="hf-women-disclaimer"><em>Talk and share — not medical advice.</em></p>
    <div class="hf-women-actions"><button type="button" class="hf-women-enter" data-women-preview aria-haspopup="dialog" aria-controls="hf-women-dialog">Verify &amp; enter <span aria-hidden="true">↗</span></button><a href="/women-only">How the women-only space works →</a></div>
    <p class="hf-women-verification-note">Verification is planned as a one-time check. We will explain data handling before you begin.</p>
    <p class="hf-women-host">Hosts here earn the same rates. <a href="#earn">Earn with us →</a></p>
  </div>
  <figure class="hf-women-art">
    <div class="hf-women-art-backdrop" aria-hidden="true"></div>
    <div class="hf-women-photo hf-women-photo--young">
      <img src={publicImage('/assets/callvaal/scrapbook/women-photo-young.png', { width: 900 })}
        srcset={publicImageSrcSet('/assets/callvaal/scrapbook/women-photo-young.png', [420, 640, 900])}
        sizes="(max-width: 760px) 46vw, 260px" width="1024" height="1536" loading="lazy" decoding="async"
        alt="Illustrative portrait of a young adult Indian woman smiling while talking on the phone" />
    </div>
    <div class="hf-women-photo hf-women-photo--midage">
      <img src={publicImage('/assets/callvaal/scrapbook/women-photo-midage.png', { width: 900 })}
        srcset={publicImageSrcSet('/assets/callvaal/scrapbook/women-photo-midage.png', [420, 640, 900])}
        sizes="(max-width: 760px) 46vw, 260px" width="1024" height="1536" loading="lazy" decoding="async"
        alt="Illustrative portrait of a middle-aged Indian woman in a magenta sari smiling while talking on the phone" />
    </div>
    <svg class="hf-women-flower hf-women-flower--top" viewBox="0 0 100 100" aria-hidden="true"><path d="M50 27C28 3 13 20 27 42 1 43 1 65 29 66 20 91 42 98 52 74 68 96 88 82 72 63 99 56 90 32 65 39 73 13 53 7 50 27Z" fill="#ee91b6" stroke="#fff" stroke-width="7" stroke-linejoin="round"/><circle cx="50" cy="52" r="13" fill="#ffe28a" stroke="#fff" stroke-width="4"/></svg>
    <svg class="hf-women-flower hf-women-flower--bottom" viewBox="0 0 100 100" aria-hidden="true"><path d="M50 27C28 3 13 20 27 42 1 43 1 65 29 66 20 91 42 98 52 74 68 96 88 82 72 63 99 56 90 32 65 39 73 13 53 7 50 27Z" fill="#c5a4dd" stroke="#fff" stroke-width="7" stroke-linejoin="round"/><circle cx="50" cy="52" r="13" fill="#ffe28a" stroke="#fff" stroke-width="4"/></svg>
    <span class="hf-women-sticker hf-women-sticker--round" aria-hidden="true">Apni<br />jagah ♡</span>
    <span class="hf-women-sticker hf-women-sticker--note" aria-hidden="true">Baat apni si.</span>
    <span class="hf-women-paper-note" aria-hidden="true">Apni baat, apni log.</span>
    <figcaption>Illustrative portraits of two adult women talking by phone.</figcaption>
  </figure>
  <aside class="hf-women-before" aria-labelledby="hf-women-before-title">
    <h3 id="hf-women-before-title">Before you call, a little care.</h3>
    <p>Keep your address, OTPs, passwords and money details to yourself. You can leave any conversation that feels uncomfortable. At launch, use the in-call report option for harassment.</p>
    <a href="/talk-safely">Read the safe-talking guide →</a>
  </aside>
  <aside class="hf-women-help" aria-label="Help beyond a conversation">
    <strong>Need urgent help?</strong><a href="tel:112">Emergency <b>112</b></a><a href="tel:181">Women’s helpline <b>181</b></a><a href="tel:14416">Tele-MANAS <b>14416</b></a><a href="tel:1930">Cyber fraud <b>1930</b></a>
    <span>This conversation space is not an emergency service.</span>
  </aside>
</section>
<dialog class="hf-women-dialog" id="hf-women-dialog" aria-labelledby="hf-women-dialog-title" aria-describedby="hf-women-dialog-note">
  <p class="hf-women-eyebrow">A little check, before you enter</p><h2 id="hf-women-dialog-title">Ek baar verify karein</h2>
  <p id="hf-women-dialog-note">This is a preview. A one-time video KYC and Aadhaar check (OTP, or DigiLocker if OTP doesn't work) is planned before you enter. Verification and entry are not available yet.</p>
  <ol><li>At launch, callers and hosts will complete video KYC and Aadhaar checks.</li><li>Lane entry and listings will be restricted to eligible verified accounts, including trans women.</li><li>The planned application design uses the verification result. Full provider data handling and retention details will be published before checks begin.</li></ol>
  <p>Take your time. We will explain the process and ask for consent before you start.</p>
  <div class="hf-women-dialog-actions"><span class="hf-women-verification-preview" tabindex="0" aria-label="Start verification — Coming at launch"><button type="button" disabled aria-describedby="hf-women-verification-tooltip">Start verification</button><span role="tooltip" id="hf-women-verification-tooltip">Coming at launch</span></span><button type="button" data-women-later autofocus>Later</button></div>
</dialog>
<script>
  const womenDialog = document.querySelector<HTMLDialogElement>('#hf-women-dialog');
  const womenEntry = document.querySelector<HTMLButtonElement>('[data-women-preview]');
  if (womenDialog && womenEntry) {
    // Native showModal supplies focus containment and Escape-to-close.
    womenEntry.addEventListener('click', () => {
      if (!womenDialog.open) womenDialog.showModal();
    });
    womenDialog.querySelector<HTMLButtonElement>('[data-women-later]')?.addEventListener('click', () => womenDialog.close());
    womenDialog.addEventListener('close', () => womenEntry.focus());
  }
</script>
