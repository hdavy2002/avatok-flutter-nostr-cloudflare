---
// [WEB-GATEWAY-A 2026-09-18] Puja & darshan band. Per Specs/WEBGW-A-BRIEF.md
// §3c: no temple affiliation is claimed anywhere here, and no specific temple
// is named. The CTA links to the `india_goes_live` marketplace group — the
// group that carries the `live_puja` / `live_puja_ritual` categories
// (web/src/lib/listingTaxonomy.ts) — because the marketplace has no
// finer-grained, URL-addressable category filter today; see the stream report.
import { publicImage } from '../../lib/config';

const cards = [
  {
    title: 'Live puja with sankalp',
    body: 'A pandit performs your sankalp puja live on video, using the name and gotra details you share beforehand.',
  },
  {
    title: 'Live darshan and aarti streams',
    body: 'Join a live aarti or darshan stream from a creator, ticketed and scheduled like any other live event.',
  },
  {
    title: '1:1 consultation with a pandit',
    body: 'Book a 1:1 video consultation with a pandit for guidance, muhurat timing or a specific ritual question.',
  },
];
---

<section class="rail-wrap puja-band" id="puja-darshan" aria-labelledby="puja-band-title" data-home-section="puja-darshan">
  <div class="puja-band__frame">
    <div class="puja-band__copy">
      <p class="rail-eyebrow">Devotion, live</p>
      <h2 id="puja-band-title">Book a live puja with a verified pandit</h2>
      <p class="puja-band__lede">The pandit performs the puja in your name, you join by live video, and a recording is shared afterwards.</p>
      <div class="puja-band__cards">
        {cards.map((card) => (
          <article class="puja-band__card">
            <h3>{card.title}</h3>
            <p>{card.body}</p>
          </article>
        ))}
      </div>
      <a class="rail-button rail-button--ink" href="/marketplace?group=india_goes_live" data-home-cta="puja-browse">Browse puja and darshan <span aria-hidden="true">↗</span></a>
    </div>
    <div class="puja-band__art" role="img" aria-label="A pandit performing a live puja on camera, watched by a devotee joining from home.">
      <img src={publicImage('/ornament-flower.png', { width: 200, fit: 'scale-down' })} alt="" width="100" height="94" aria-hidden="true" />
    </div>
  </div>
</section>

<style>
  .puja-band { padding-block: 12px 20px; }
  .puja-band__frame {
    display: grid; grid-template-columns: minmax(0, 1fr) 220px; align-items: start; gap: 40px;
    padding: clamp(28px, 3vw, 44px); background: var(--zine-card, #fdf1d3); border: 2px solid var(--zine-ink, #161614);
    border-radius: var(--zine-rXl, 28px); box-shadow: 6px 7px 0 var(--zine-ink, #161614);
  }
  .puja-band__lede { font-size: clamp(16px, 1.6vw, 20px); line-height: 1.55; max-width: 62ch; margin: 10px 0 26px; }
  .puja-band__cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; margin-bottom: 28px; }
  .puja-band__card { padding: 18px 20px; background: #fff7e8; border: 1px solid #ccbb9f; border-radius: var(--zine-rSm, 16px); }
  .puja-band__card h3 { font-family: 'Comfortaa', 'Baloo 2', sans-serif; font-weight: 400; text-transform: none; font-size: 19px; line-height: 1.3; margin: 0 0 8px; }
  .puja-band__card p { font-size: 15px; line-height: 1.55; margin: 0; }
  .puja-band__art { display: grid; place-items: center; align-self: center; width: 100%; aspect-ratio: 1; border: 2px dashed #bc8732; border-radius: var(--zine-rLg, 24px); background: #fff4df; }
  @media (max-width: 900px) {
    .puja-band__frame { grid-template-columns: 1fr; }
    .puja-band__art { order: -1; max-width: 200px; margin: 0 auto; aspect-ratio: 2/1; }
    .puja-band__cards { grid-template-columns: 1fr; }
  }
</style>
