---
interface Props {
  name: 'app-store' | 'google-play' | 'macos-finder' | 'windows';
}

const { name } = Astro.props;
---
<svg class="platform-logo" viewBox="0 0 48 48" width="48" height="48" aria-hidden="true" focusable="false">
  {name === 'app-store' && (
    <>
      <rect width="48" height="48" rx="10" fill="#0d96f6" />
      <path d="M16.1 35.5h-4.8m25.4 0h-12M15.4 31.2 25.8 13m-3.2 0 13 22.5M12.8 27h22.4" fill="none" stroke="#fff" stroke-width="4.2" stroke-linecap="round" stroke-linejoin="round" />
    </>
  )}
  {name === 'google-play' && (
    <>
      <path d="M8 6.9v34.2l18-17.1z" fill="#31d17c" />
      <path d="m8 6.9 22.4 12.7L26 24z" fill="#2fa7f7" />
      <path d="M8 41.1 30.4 28.4 26 24z" fill="#f7cf3c" />
      <path d="m30.4 19.6 7.3 4.1c1 .6 1 1.1 0 1.7l-7.3 4.1L26 24z" fill="#f05252" />
    </>
  )}
  {name === 'macos-finder' && (
    <>
      <path d="M6 7.5A3.5 3.5 0 0 1 9.5 4H24v40H9.5A3.5 3.5 0 0 1 6 40.5z" fill="#55b9f3" />
      <path d="M24 4h14.5A3.5 3.5 0 0 1 42 7.5v33a3.5 3.5 0 0 1-3.5 3.5H24z" fill="#1676d2" />
      <path d="M24 4c-1.4 6.3-3.7 12.1-7.2 17.3" fill="none" stroke="#102f52" stroke-width="1.8" stroke-linecap="round" />
      <path d="M15.3 18v.1m17.4-.1v.1" fill="none" stroke="#102f52" stroke-width="2.8" stroke-linecap="round" />
      <path d="M14.5 30.2c4.7 4.1 14.3 4.1 19 0" fill="none" stroke="#102f52" stroke-width="1.8" stroke-linecap="round" />
    </>
  )}
  {name === 'windows' && (
    <>
      <path d="m5 8.3 17-2.4v16.4H5z" fill="#39a9f4" />
      <path d="m25 5.5 18-2.5v19.3H25z" fill="#1689df" />
      <path d="M5 25.3h17v16.5L5 39.4z" fill="#1689df" />
      <path d="M25 25.3h18v19.4l-18-2.5z" fill="#0875c9" />
    </>
  )}
</svg>
