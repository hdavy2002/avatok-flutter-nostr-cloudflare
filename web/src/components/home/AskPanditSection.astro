---
// [PANDIT-BOXED-LAYOUT] Promotional preview only; consultation and sign-in stay on /pandit.
import '../../styles/ask-pandit.css';
import { ARTWORK_QUALITY, publicImage, publicImageSrcSet } from '../../lib/config';

const illustrations = '/assets/pandit-boxed/illustrations.png';
const artwork = publicImage(illustrations, { width: 900, fit: 'scale-down', quality: ARTWORK_QUALITY });
const artworkSrcSet = publicImageSrcSet(illustrations, [420, 640, 900, 1280], { fit: 'scale-down', quality: ARTWORK_QUALITY });
const recommendations = [
  { title: 'Chakra T-shirt', detail: 'Your colour & chakra', x: 1, y: 0 },
  { title: 'Shani Puja', detail: 'A personal suggestion', x: 0, y: 1 },
  { title: 'Shanti Havan', detail: 'A practice for peace', x: 1, y: 1 },
];
const steps = [
  ['Share birth details', 'Quick and secure'],
  ['Ask your question', 'In your language'],
  ['Find your guidance', 'Personalised for you'],
];
---
<section class="ap-band" id="ask-pandit" aria-labelledby="ap-title" data-home-section="ask-pandit">
  <div class="ap-inner">
    <div class="ap-frame">
      <div class="ap-ornament" aria-hidden="true">
        <span class="ap-edge ap-edge-top"></span><span class="ap-edge ap-edge-bottom"></span>
        <span class="ap-edge ap-edge-left"></span><span class="ap-edge ap-edge-right"></span>
        <span class="ap-corner ap-corner-tl"></span><span class="ap-corner ap-corner-tr"></span>
        <span class="ap-corner ap-corner-bl"></span><span class="ap-corner ap-corner-br"></span>
      </div>
      <div class="ap-content">
        <header class="ap-heading">
          <div class="ap-divider" aria-hidden="true"><span></span><i></i><span></span></div>
          <p class="ap-eyebrow">Ask Pandit ji</p>
          <h2 class="ap-title" id="ap-title"><span>A little guidance.</span><span>A path that feels yours.</span></h2>
          <p class="ap-lede">Your birth chart. Your colours.<br class="ap-mobile-break" /> Your spiritual practice.</p>
          <div class="ap-divider ap-divider-small" aria-hidden="true"><span></span><i></i><span></span></div>
        </header>
        <div class="ap-showcase">
          <div class="ap-consultation" role="group" aria-labelledby="ap-example-title">
            <h3 class="ap-rule-label" id="ap-example-title">Example consultation</h3>
            <div class="ap-preview">
              <figure class="ap-pandit">
                <span class="ap-art ap-portrait" aria-hidden="true">
                  <img src={artwork} srcset={artworkSrcSet} sizes="(max-width: 760px) 220px, (max-width: 1000px) 320px, 360px" style="--ap-art-x: 0; --ap-art-y: 0" alt="" width="1254" height="1254" loading="lazy" decoding="async" />
                </span>
                <figcaption>Pandit ji</figcaption>
              </figure>
              <div class="ap-conversation">
                <a class="ap-bubble ap-bubble-user" href="/pandit" data-home-cta="ask-pandit-example" aria-label="Ask Pandit ji what to wear or which puja to explore">
                  <span class="ap-speaker">You</span>
                  <p>Pandit ji, what should I wear? Is there a puja for me?</p>
                </a>
                <div class="ap-bubble ap-bubble-pandit">
                  <span class="ap-speaker">Pandit ji</span>
                  <p>You could explore a navy chakra tee, Shani puja or a havan for your Saturday practice.</p>
                </div>
              </div>
            </div>
          </div>
          <div class="ap-suggestions" role="group" aria-labelledby="ap-suggested-title">
            <h3 class="ap-suggested" id="ap-suggested-title">Suggested for you</h3>
            <div class="ap-cards">
              {recommendations.map((card) => (
                <a class="ap-card" href="/pandit" data-home-cta="ask-pandit-preview" aria-label={`Explore ${card.title} with Pandit ji`}>
                  <span class="ap-art ap-card-art" aria-hidden="true">
                    <img src={artwork} srcset={artworkSrcSet} sizes="(max-width: 760px) 280px, (max-width: 1000px) 440px, 360px" style={`--ap-art-x: ${card.x}; --ap-art-y: ${card.y}`} alt="" width="1254" height="1254" loading="lazy" decoding="async" />
                  </span>
                  <span class="ap-card-copy"><strong>{card.title}</strong><span class="ap-card-detail">{card.detail}</span></span>
                </a>
              ))}
            </div>
          </div>
        </div>
        <div class="ap-action">
          <a class="ap-cta" href="/pandit" data-home-cta="ask-pandit-start"><span>Start my free consultation</span><span class="ap-arrow" aria-hidden="true">⟶</span></a>
          <p class="ap-cta-note">
            <svg viewBox="0 0 24 24" width="23" height="23" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true" focusable="false"><path d="M20.7 11.6a8.7 8.7 0 0 1-12.9 7.7L3 20.7l1.4-4.5a8.7 8.7 0 1 1 16.3-4.6Z"></path><path d="m8.4 7.2 1.5 2.6-1 1.3c.8 1.5 1.7 2.4 3.2 3.1l1.2-1 2.6 1.5c.2 1.5-1 2.1-2.1 2-3.5-.5-6.8-3.6-7.2-7.1-.1-1.2.6-2.4 1.8-2.4Z"></path></svg>
            <span>Sign in with WhatsApp · 2 minutes</span>
          </p>
        </div>
        <ol class="ap-steps" aria-label="Your consultation in three steps">
          {steps.map(([title, detail], index) => <li><span class="ap-step-n" aria-hidden="true">{index + 1}</span><div><strong>{title}</strong><span>{detail}</span></div></li>)}
        </ol>
      </div>
    </div>
  </div>
</section>
