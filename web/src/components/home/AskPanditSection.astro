---
// [AUMFE-PANDIT-WEB-1 2026-10-01] Homepage "Ask Pandit ji" band — a replica of the approved mockup (Main.dc.html).
//
// NOTE FOR AI:
//  - STATIC HTML on purpose: no island, no script, no API call (site-speed rule, areas/web-performance).
//    The chat itself lives on /pandit (islands/pandit/). Never import React here.
//  - Styles: styles/ask-pandit.css (own `ap-` classes + literal colours; no CSS variables that exist only on some pages).
//  - The three example chips open /pandit?ask=<question>; the page puts that text in the message box.
//  - COPY: scripts/check-homepage.mjs (AC-17) forbids the words kundli / astrology / tarot / palmistry in homepage content,
//    so this band says "birth chart" where the mockup says "kundli". /pandit itself may use them.
//  - The avatar is /images/pandit-ji.jpg (public/images/). Brand name/domain are never typed here.
import '../../styles/ask-pandit.css';
import { publicImage } from '../../lib/config';

const panditPhoto = publicImage('/images/pandit-ji.jpg', { width: 96, fit: 'cover' });

const examples = [
  'Aaj kaunsa rang shubh hai?',
  'Is my Mangal dosha strong?',
  'Shani ke liye kaunsi puja?',
];
const askHref = (q: string) => '/pandit?ask=' + encodeURIComponent(q);
---
<section class="ap-band" id="ask-pandit" aria-labelledby="ap-title" data-home-section="ask-pandit">
  <div class="ap-inner">
    <div class="ap-copy">
      <div class="ap-kicker">
        <span class="ap-new">NEW</span>
        <span class="ap-eyebrow">ASK PANDIT JI · YOUR VIRTUAL PANDIT</span>
      </div>
      <h2 id="ap-title" class="ap-title">Your stars, your colours. Ask Pandit ji what to wear.</h2>
      <p class="ap-lede">Share your birth details once. Pandit ji reads your birth chart, remembers you, and suggests the right colour, chakra design and puja for what you are going through — in your own language.</p>

      <div class="ap-chips">
        {examples.map((q) => <a class="ap-chip" href={askHref(q)} data-home-cta="ask-pandit-example">“{q}”</a>)}
      </div>

      <div class="ap-cta-row">
        <a class="ap-cta" href="/pandit" data-home-cta="ask-pandit-start">Start my free consultation
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
        <span class="ap-cta-note">Sign in with WhatsApp · 2 minutes</span>
      </div>
      <p class="ap-langs">हिन्दी · English · Hinglish · தமிழ் · తెలుగు · বাংলা · मराठी · ગુજરાતી · ಕನ್ನಡ</p>
    </div>

    <div class="ap-preview-wrap">
      <div class="ap-preview" aria-label="Example conversation">
        <div class="ap-preview-head">
          <img src={panditPhoto} alt="Pandit ji" width="48" height="48" loading="lazy" decoding="async" />
          <div class="ap-preview-who">
            <strong>Pandit ji</strong>
            <span>● Online · remembers you</span>
          </div>
        </div>
        <div class="ap-preview-body">
          <div class="ap-bubble ap-bubble-user">Pandit ji, office mein bahut rukaavat aa rahi hai. Kya pehnu?</div>
          <div class="ap-bubble ap-bubble-bot">Rahul ji, aapki Shani dasha chal rahi hai. Shanivaar ko gehra neela shubh maana jaata hai, aur Manipura chakra aatmavishwas ke liye<span class="ap-caret"></span></div>
          <div class="ap-preview-cards">
            <div class="ap-mini">
              <svg width="84" height="84" viewBox="0 0 120 120" aria-hidden="true"><path d="M30 12 L46 5 Q60 16 74 5 L90 12 L112 32 L97 47 L88 40 L88 112 L32 112 L32 40 L23 47 L8 32 Z" fill="#1d2f5e"></path><circle cx="60" cy="58" r="14" fill="none" stroke="#F6B93B" stroke-width="3"></circle><circle cx="60" cy="58" r="5" fill="#F6B93B"></circle></svg>
              <span>Shani Navy Tee</span>
            </div>
            <div class="ap-mini">
              <svg width="84" height="84" viewBox="0 0 120 120" aria-hidden="true"><path d="M30 12 L46 5 Q60 16 74 5 L90 12 L112 32 L97 47 L88 40 L88 112 L32 112 L32 40 L23 47 L8 32 Z" fill="#F6B93B"></path><circle cx="60" cy="58" r="14" fill="none" stroke="#A54C2E" stroke-width="3"></circle><path d="M60 44 L64 54 L74 58 L64 62 L60 72 L56 62 L46 58 L56 54 Z" fill="#A54C2E"></path></svg>
              <span>Manipura Chakra Tee</span>
            </div>
            <div class="ap-mini ap-mini-puja">
              <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="#c82c25" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3c2 3 4 4.5 4 8a4 4 0 0 1-8 0c0-3.5 2-5 4-8z"></path><path d="M4 21h16M6 21l1-4h10l1 4"></path></svg>
              <span>Shani Shanti Havan · Live</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <ol class="ap-steps">
      <li><span class="ap-step-n">1</span><div><strong>Share birth details</strong><span>Date, time and place — once. We build your birth chart.</span></div></li>
      <li><span class="ap-step-n">2</span><div><strong>Talk like you would to a pandit</strong><span>Ask about work, marriage, health, peace of mind.</span></div></li>
      <li><span class="ap-step-n">3</span><div><strong>Wear it, perform it</strong><span>Get your colours, chakra designs and the right puja or havan.</span></div></li>
    </ol>
  </div>
</section>
<div class="grand-divider" aria-hidden="true"></div>
