---
// [WEB-GATEWAY-A 2026-09-18] "What creators host on avaTOK" — eight category
// tiles. Two reuse the two non-retired photos from the old four-tile idea
// grid (CreatorIdeas.astro's `ideaTwoTitle`/`ideaThreeTitle` images); the
// other two photos from that grid (`ideaOneTitle` "Dance adda",
// `ideaFourTitle` "Style desk") are retired per the brief and must not be
// reused anywhere. The other six tiles use their listingTaxonomy sub-category
// emoji instead of inventing new artwork.
//
// Each tile links to the marketplace GROUP (not sub-category) that carries
// it — there is no URL-addressable sub-category filter on /marketplace today
// (only `?group=`), so group-level is the finest real filter that exists; see
// the stream report.
import { publicImage } from '../../lib/config';

const categories = [
  { label: 'Puja & darshan', emoji: '🪔', group: 'india_goes_live' },
  { label: 'Music & dance', emoji: '🎵', group: 'india_goes_live' },
  { label: 'Cooking', image: '/assets/ideas/guides/chai-stall-chronicles-card.jpg', group: 'india_goes_live' },
  { label: 'Fitness & yoga', emoji: '🧘', group: 'india_goes_live' },
  { label: 'Languages', emoji: '🗣️', group: 'book_their_time' },
  { label: 'Exam & study help', image: '/assets/ideas/guides/study-with-me-club-card.jpg', group: 'book_their_time' },
  { label: 'Career mentoring', emoji: '🧭', group: 'book_their_time' },
  { label: 'Travel & culture', emoji: '🛵', group: 'india_goes_live' },
] as const;
---

<section class="rail-wrap categories-grid" id="categories" aria-labelledby="categories-title" data-home-section="categories">
  <p class="rail-eyebrow">The bazaar</p>
  <h2 id="categories-title">What creators host on avaTOK</h2>
  <div class="categories-grid__grid">
    {categories.map((cat) => (
      <a class="categories-grid__tile" href={`/marketplace?group=${cat.group}`} data-home-cta={`category-${cat.label.toLowerCase().replace(/[^a-z]+/g, '-')}`}>
        {'image' in cat
          ? <span class="categories-grid__photo"><img src={publicImage(cat.image, { width: 480, fit: 'scale-down' })} alt="" loading="lazy" /></span>
          : <span class="categories-grid__emoji" aria-hidden="true">{cat.emoji}</span>}
        <span class="categories-grid__label">{cat.label}</span>
      </a>
    ))}
  </div>
</section>

<style>
  .categories-grid { padding-block: 20px 12px; }
  .categories-grid__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 18px; margin-top: 28px; }
  .categories-grid__tile {
    display: flex; flex-direction: column; align-items: center; gap: 12px; text-align: center;
    padding: 22px 14px; background: #fff7e8; border: 1px solid #ccbb9f; border-radius: var(--zine-rLg, 24px);
    transition: transform .2s, box-shadow .2s;
  }
  .categories-grid__tile:hover { transform: translateY(-4px); box-shadow: 0 10px 20px #34281110; }
  .categories-grid__tile:focus-visible { outline: 3px solid #176491; outline-offset: 4px; }
  .categories-grid__emoji { display: grid; place-items: center; width: 64px; height: 64px; font-size: 30px; border-radius: 50%; background: var(--zine-blue, #f4d8a0); }
  .categories-grid__photo { display: block; width: 64px; height: 64px; border-radius: 50%; overflow: hidden; }
  .categories-grid__photo img { width: 100%; height: 100%; object-fit: cover; }
  .categories-grid__label { font-family: 'Comfortaa', 'Baloo 2', sans-serif; font-weight: 400; font-size: 16px; line-height: 1.3; }
  @media (max-width: 900px) { .categories-grid__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 620px) { .categories-grid__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
