---
import type { ReferenceRect } from '../../lib/callvaalHomeReference';
interface Props { rect: ReferenceRect; label?: string; class?: string }
const { rect, label, class: className = '' } = Astro.props;
---
<svg class={`reference-crop ${className}`} viewBox={rect.join(' ')} width={rect[2]} height={rect[3]} preserveAspectRatio={className.includes('person-portrait') ? 'xMidYMid slice' : 'xMidYMid meet'} role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'} focusable="false" xmlns="http://www.w3.org/2000/svg">
  <svg x={rect[0]} y={rect[1]} width={rect[2]} height={rect[3]} viewBox={rect.join(' ')} overflow="hidden">
    <image href="/assets/callvaal/notebook/approved-reference.png" width="1024" height="1536" />
  </svg>
</svg>
