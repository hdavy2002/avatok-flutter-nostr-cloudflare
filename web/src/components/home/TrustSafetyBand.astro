---
// [WEB-GATEWAY-A 2026-09-18] "A professional space, by design." Every card
// heading and body below was rewritten from what the linked policy page
// ACTUALLY says (not the brief's placeholder wording, which did not survive
// contact with the policy pages) — see the stream report for the discrepancy
// on each one:
//   - biometric-retention.astro: creators complete a liveness check, not
//     document ID verification.
//   - marketplace-terms.astro: listings are moderated reactively (removed on
//     breach/report), not reviewed before publish.
//   - acceptable-use.astro: bans commercial sexual services and sexually
//     explicit public content; "zero tolerance" is child-safety's phrase, not
//     acceptable-use's, so it is not reused here.
//   - community-guidelines.astro / acceptable-use.astro: reporting/blocking
//     is one tap, from inside the app generally — not scoped to "any
//     session" specifically.
//   - child-safety.astro: fully supports the brief's wording as given.
//   - grievance.astro: timelines below (24 hours / 15 days) are the page's
//     own stated figures, not invented.
const cards = [
  {
    title: 'Every creator completes a liveness check',
    body: 'Before posting publicly, listing an item or going live, creators complete a short liveness check confirming a real person is behind the account.',
    href: '/biometric-retention',
  },
  {
    title: 'Listings that break the rules are removed',
    body: 'We remove, hide or refuse any listing that breaks our marketplace terms, including in response to credible reports.',
    href: '/marketplace-terms',
  },
  {
    title: 'No sexual services or explicit content',
    body: 'Commercial sexual services and sexually explicit material are prohibited across every avaTOK surface.',
    href: '/acceptable-use',
  },
  {
    title: 'Report or block in one tap',
    body: 'Report an account, conversation, listing or piece of content from inside the app, and block anyone immediately.',
    href: '/community-guidelines',
  },
  {
    title: 'Child safety comes first',
    body: 'avaTOK has zero tolerance for child sexual abuse and exploitation. Confirmed violations mean permanent account termination and a report to NCMEC and law enforcement.',
    href: '/child-safety',
  },
  {
    title: 'Grievance redressal',
    body: 'Our Grievance Officer acknowledges a complaint within 24 hours and resolves it within 15 days.',
    href: '/grievance',
  },
];
---

<section class="trust-band" id="trust-safety" aria-labelledby="trust-band-title" data-home-section="trust-safety">
  <div class="rail-wrap">
    <p class="rail-eyebrow">Trust &amp; safety</p>
    <h2 id="trust-band-title">A professional space, by design.</h2>
    <p class="trust-band__lede">avaTOK is for skills, learning, devotion and entertainment. Adult, sexual or dating content is prohibited and removed.</p>
    <div class="trust-band__grid">
      {cards.map((card) => (
        <a class="trust-band__card" href={card.href} data-home-cta="trust-card">
          <h3>{card.title}</h3>
          <p>{card.body}</p>
          <span class="trust-band__link" aria-hidden="true">Read the policy →</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .trust-band {
    padding-block: clamp(40px, 5vw, 68px); margin-block: 12px;
    background: var(--zine-blueInk, #1e5f66); color: var(--zine-card, #fdf1d3);
    border-radius: var(--zine-rXl, 28px);
  }
  .trust-band h2 { color: #fff; }
  .trust-band .rail-eyebrow { color: var(--zine-lime, #feb302); }
  .trust-band__lede { max-width: 62ch; font-size: clamp(16px, 1.6vw, 20px); line-height: 1.55; margin: 10px 0 30px; color: #eaf3f2; }
  .trust-band__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
  .trust-band__card {
    display: flex; flex-direction: column; gap: 8px; padding: 22px 22px 20px; text-decoration: none;
    background: #164b51; border: 1px solid #2c7078; border-radius: var(--zine-rLg, 24px); color: inherit;
    transition: transform .2s, box-shadow .2s;
  }
  .trust-band__card:hover { transform: translateY(-4px); box-shadow: 0 10px 20px #0006; }
  .trust-band__card:focus-visible { outline: 3px solid var(--zine-lime, #feb302); outline-offset: 4px; }
  .trust-band__card h3 { font-family: 'Comfortaa', 'Baloo 2', sans-serif; font-weight: 400; text-transform: none; font-size: 20px; line-height: 1.3; margin: 0; color: #fff; }
  .trust-band__card p { font-size: 15px; line-height: 1.55; margin: 0; color: #d7e8e6; }
  .trust-band__link { margin-top: auto; padding-top: 6px; font-weight: 700; font-size: 14px; color: var(--zine-lime, #feb302); }
  @media (max-width: 900px) { .trust-band__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .trust-band__grid { grid-template-columns: 1fr; } }
</style>
