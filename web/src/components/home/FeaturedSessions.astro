---
// [WEB-GATEWAY-A 2026-09-18] "Book a session" — up to 8 published/live listings
// from the same public explore API the marketplace page uses, rendered with the
// real marketplace card (ListingTile) server-side, same pattern as
// components/listing/BrowseMore.astro. Renders nothing when the API has fewer
// than 1 listing — no invented placeholder inventory (see marketplace.astro's
// own note on this).
import { ListingTile } from '../../components';
import { getMarketplaceSeed } from '../../lib/marketplaceSeed';

const seed = await getMarketplaceSeed();
const items = (seed.page?.listings ?? []).slice(0, 8);
---

{items.length > 0 && (
  <section class="rail-wrap featured-sessions" id="featured" aria-labelledby="featured-title" data-home-section="featured">
    <div class="featured-sessions__head">
      <h2 id="featured-title">Book a session</h2>
      <a class="rail-text-link" href="/marketplace" data-home-cta="featured-see-all">See all sessions <span aria-hidden="true">→</span></a>
    </div>
    <div class="featured-sessions__grid" data-section="home_featured">
      {items.map((c, i) => (
        <ListingTile listing={c} position={i} section="home_featured" />
      ))}
    </div>
  </section>
)}

<style>
  .featured-sessions { padding-block: 24px 8px; }
  .featured-sessions__head { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-bottom: 22px; }
  .featured-sessions__head h2 { font-size: clamp(28px, 3.4vw, 46px); }
  .featured-sessions__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; }
  @media (max-width: 1100px) { .featured-sessions__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 820px) { .featured-sessions__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 520px) { .featured-sessions__grid { grid-template-columns: 1fr; } }
</style>
