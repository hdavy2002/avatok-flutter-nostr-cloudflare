---
// [HF-AUTH-GHAR-1 2026-10-17] Shared "Gaon ka Ghar" shell for /sign-in and /sign-up. Owner: Indian treatment, NO site
// header or footer on these two pages, the same layout on both — only the picture, sticker and copy differ. Layout:
// ≥1280px a sky panel with the round hero picture + rangoli doorstep beside the form; below that the form card stands
// alone on the sky, centred. The form card wears a tiled roof (it is the little house you are entering).
// Art + fallbacks: components/auth/authSkin.ts. Styles: styles/auth-ghar.css (scoped `.auth--ghar`).
import BrandLogo from '../callvaal/BrandLogo.astro';
import { publicImage } from '../../lib/config';
import { AUTH_ART, AUTH_BG, AUTH_SKINS } from './authSkin';
import '../../styles/auth-ghar.css';

export interface Props { variant: 'in' | 'up' }
const { variant } = Astro.props;
const img = (p: string, w: number) => publicImage(p, { width: w, fit: 'scale-down' });
const vars = [...AUTH_BG.map((o) => `--au-${o.key}:url(${img(o.path, o.width)})`), ...AUTH_SKINS.map((o) => `--au-btn-${o.key}:url(${img(o.path, o.width)})`)].join(';');
const skins = AUTH_SKINS.map((o) => o.key).join(' ');
const hero = variant === 'in' ? AUTH_ART.signInHero : AUTH_ART.signUpHero;
const sticker = variant === 'in' ? { src: AUTH_ART.stickerSignIn, alt: 'Wapas aa gaye? Waah!' } : { src: AUTH_ART.stickerSignUp, alt: 'Aapka swagat hai!' };
const caption = variant === 'in' ? ['Wapas aa gaye!', 'Your favourite influencers are a call away.'] : ['Aao, ghar mein swagat hai.', 'Join free. Talk to the influencers you love.'];
---
<div class:list={['auth', 'auth--ghar', { 'au-noroof': !AUTH_ART.roof }]} style={vars} data-skins={skins || undefined}>
  <div class="au-top">
    <a class="au-logo" href="/" aria-label="Home"><BrandLogo /></a>
    <a class="au-help" href="/help">Need help?</a>
  </div>
  <div class="auth-shell">
    <aside class="auth-panel au-panel" aria-hidden="true">
      <div class="au-panel-inner">
        {sticker.src && <img class="au-sticker" src={img(sticker.src, 640)} alt="" width="420" height="245" />}
        {hero && <div class="au-hero">
          <img class="au-hero-art" src={img(hero, 1000)} alt="" width="1000" height="1000" fetchpriority="high" decoding="async" />
          {AUTH_ART.heroRing && <img class="au-hero-ring" src={img(AUTH_ART.heroRing, 1024)} alt="" width="1024" height="1024" />}
        </div>}
        <p class="au-caption"><b>{caption[0]}</b><span>{caption[1]}</span></p>
      </div>
      <div class="au-rangoli"></div>
    </aside>

    <main class:list={['auth-main', 'au-main', { 'auth-main--signup': variant === 'up' }]}>
      <div class="au-house">
        {AUTH_ART.roof && <img class="au-roof" src={img(AUTH_ART.roof, 1400)} alt="" width="2000" height="300" aria-hidden="true" />}
        <div class="auth-card au-card">
          <slot />
        </div>
      </div>
      {AUTH_ART.stickerPrivate
        ? <img class="au-private" src={img(AUTH_ART.stickerPrivate, 640)} alt="Number kabhi share nahi hota" width="360" height="210" loading="lazy" />
        : <p class="au-private-text">Number kabhi share nahi hota</p>}
    </main>
  </div>
</div>
