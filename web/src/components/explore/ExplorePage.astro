---
// [HF-EXPLORE-V2-3 2026-10-17] The Explore page (video-first creator marketplace), shared by /marketplace (live,
// indexed) and /explore-preview (noindex test copy). Owner decision 2026-10-17: this design replaces the old /marketplace.
// Sample creators only; wiring to D1/search comes later. Fresh "Bazaar Pop" artwork lives in /assets/hf-explore/
// (prompt pack: SaatHum project doc claude/hello-fraands-explore-category-icon-prompts.md).
interface Props { canonical?: string; indexable?: boolean }
const { canonical, indexable = false } = Astro.props;
import brandConfig from '../../../../Specs/brand.json';
import Header from '../callvaal/Header.astro';
import Footer from '../callvaal/Footer.astro';
import { publicImage, shareImage } from '../../lib/config';
import '../../styles/desi-home-chrome.css';
import '../../styles/explore-preview.css';

const identity = brandConfig.homepageIdentity;
const title = `Explore creators. Watch their reels, book a private call | ${identity.name}`;
const description = `Discover Instagram, YouTube and Facebook creators on ${identity.name}. Watch their latest reels and book a private phone call. Your number stays private. 18+.`;
const A = '/assets/hf-explore';
const img = (path: string, width: number, quality = 70) => publicImage(`${A}/${path}`, { width, quality, fit: 'scale-down' });
const bg = (path: string, width: number) => `url(${img(path, width, 70)})`;

// Every image the client script needs, resolved through the Cloudflare image pipeline at build time.
const creatorKeys = [...Array.from({ length: 12 }, (_, i) => `sample-${String(i + 1).padStart(2, '0')}`), ...Array.from({ length: 6 }, (_, i) => `art-0${i + 1}`)];
const cats = ['all', 'lifestyle', 'comedy', 'fashion', 'beauty', 'food', 'travel', 'music', 'fitness', 'gaming', 'education', 'spirituality'];
const IMG: Record<string, string> = {
  rosette: img('cards/rosette.png', 128), verified: img('cards/verified.png', 96),
  unavailable: img('illustrations/video-unavailable.png', 420), empty: img('illustrations/empty-search.png', 640),
  success: img('illustrations/booking-success.png', 640), stkDone: img('stickers/sticker-ho-gaya.png', 420),
  tileyellow: img('cards/frame-tile-yellow.png', 256), tilepink: img('cards/frame-tile-pink.png', 256),
  tilelavender: img('cards/frame-tile-lavender.png', 256), tilepeach: img('cards/frame-tile-peach.png', 256),
};
for (const k of creatorKeys) { IMG[k] = img(`creators/${k}.png`, 640); IMG[`${k}-sm`] = img(`creators/${k}.png`, 160); }
for (const c of cats) { IMG[`cat-${c}`] = img(`categories/cat-${c}.png`, 256); }

const cssVars = ':root{' + [
  ['toran-top', bg('ornaments/toran-top.png', 1600)], ['toran-bottom', bg('ornaments/toran-bottom.png', 1600)],
  ['divider', bg('ornaments/divider-strip.png', 1280)], ['wash', bg('ornaments/wash-tile.png', 640)],
  ['bunting', bg('ornaments/bunting.png', 1600)], ['dots', bg('ornaments/marquee-dot-strip.png', 1280)],
  ['btn', bg('buttons/btn-book-skin.png', 900)], ['chip', bg('buttons/chip-skin.png', 640)],
].map(([k, v]) => `--xp-${k}:${v}`).join(';') + '}';

const sticker = (name: string) => img(`stickers/sticker-${name}.png`, 640);
const arrows = (rail: string) => `<div class="act"><button class="arrow" type="button" data-rail="${rail}" data-dir="-1" aria-label="Scroll back"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"><path d="M15 5l-7 7 7 7"/></svg></button><button class="arrow" type="button" data-rail="${rail}" data-dir="1" aria-label="Scroll forward"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"><path d="M9 5l7 7-7 7"/></svg></button></div>`;
const marquee = ['HORN OK PLEASE', 'REEL SE REAL TAK', 'EK CALL TOH BANTA HAI', 'BAS KARO SCROLL. BAAT KARO.'];
---
<!doctype html>
<html lang="en-IN">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title><meta name="description" content={description} /><meta name="robots" content={indexable ? 'index,follow' : 'noindex,nofollow'} />
  {canonical && <link rel="canonical" href={canonical} />}
  {indexable && canonical && <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'CollectionPage', name: title, description, url: canonical, inLanguage: 'en-IN' })} />}
  {indexable && canonical && <><meta property="og:type" content="website" /><meta property="og:site_name" content={identity.name} /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} /><meta name="twitter:card" content="summary_large_image" /><meta property="og:image" content={shareImage('/assets/hf-explore/hero/hero-creator.png')} /><meta property="og:image:alt" content="Illustration of a young creator making a heart with her hands, with phone screens playing reels around her." /><meta name="twitter:image" content={shareImage('/assets/hf-explore/hero/hero-creator.png')} /></>}<meta name="theme-color" content="#fffdf7" />
  <link rel="icon" href="/assets/branding/hf-favicon.png" type="image/png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Comfortaa:wght@500;600;700&family=Nunito:wght@700;800;900&display=swap" />
  <link rel="preload" as="image" href={img('hero/hero-creator.png', 1280)} fetchpriority="high" />
  <style is:inline set:html={cssVars}></style>
</head>
<body class="desi-home-page">
<div class="hf desi-home xp" id="xp" data-brand={identity.name}>
  <a class="skip-link" href="#main-content">Skip to main content</a>
  <Header />
  <main id="main-content">
    <div class="toran" aria-hidden="true"></div>

    <section class="hero">
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <span class="eyebrow">Explore · Reel se Real tak</span>
          <h1><span class="l">Find influencers.</span><span class="l m">Watch. Connect.</span><span class="l"><span class="hl">Talk.</span></span></h1>
          <p class="lede">Watch their latest Reels and Shorts, then book a private call with the creators you already love.</p>
          <div class="search" id="searchBox">
            <form id="searchForm" role="search" autocomplete="off">
              <svg class="lead" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><circle cx="10" cy="10" r="6.5"/><path d="m15 15 6 6"/></svg>
              <label class="sr-only" for="q">Search creators</label>
              <input id="q" type="search" placeholder="Search creators, names, topics, languages..." role="combobox" aria-expanded="false" aria-controls="suggest" aria-autocomplete="list" />
              <button class="go" type="submit"><svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" aria-hidden="true"><circle cx="10" cy="10" r="6.5"/><path d="m15 15 6 6"/></svg><span>Search</span></button>
            </form>
            <div class="suggest" id="suggest" role="listbox" hidden></div>
          </div>
        </div>
        <div class="art">
          <img class="doodles" src={img('hero/hero-doodles.png', 640)} alt="" width="640" height="640" aria-hidden="true" />
          <img class="main" src={img('hero/hero-creator.png', 1280)} alt="Illustration of a young creator making a heart with her hands inside a jharokha window, with phone screens playing reels around her" width="1280" height="1280" fetchpriority="high" />
        </div>
      </div>
    </section>

    <div class="bp-strip" aria-hidden="true"></div>
    <div class="fbar" id="fbar">
      <div class="wrap">
        <div class="frow" id="frow" role="toolbar" aria-label="Filters"></div>
        <div class="views" role="group" aria-label="View">
          <button type="button" data-view="grid" aria-pressed="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="7.5" height="7.5" rx="2"/><rect x="13.5" y="3" width="7.5" height="7.5" rx="2"/><rect x="3" y="13.5" width="7.5" height="7.5" rx="2"/><rect x="13.5" y="13.5" width="7.5" height="7.5" rx="2"/></svg><span>Grid</span></button>
          <button type="button" data-view="reels" aria-pressed="false"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="6" y="2.5" width="12" height="19" rx="3"/><path d="M10.5 9.5v5l4-2.5z" fill="currentColor"/></svg><span>Reels</span></button>
          <button type="button" data-view="list" aria-pressed="false"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M8 6h13M8 12h13M8 18h13M3.5 6h.01M3.5 12h.01M3.5 18h.01"/></svg><span>List</span></button>
        </div>
      </div>
    </div>

    <div class="wrap"><div class="cats" id="cats" role="group" aria-label="Categories"></div></div>

    <section class="sec" id="results" hidden>
      <div class="wrap">
        <div class="shead"><div><span class="eyebrow">Your search</span><h2 id="resTitle">Results</h2></div></div>
        <div class="results-bar" id="pills"></div>
        <div id="resBody"></div>
      </div>
    </section>

    <div id="shelves">
      <section class="sec" style="padding-top:clamp(28px,3vw,48px)">
        <div class="wrap">
          <div class="shead">
            <div><span class="eyebrow">Hand-picked this week</span><h2>Featured <span class="hl">creators.</span></h2></div>
            <img class="sticker" src={sticker('ekdum-jhakaas')} alt="Ekdum jhakaas!" width="420" height="245" loading="lazy" />
            <Fragment set:html={arrows('featured')} />
          </div>
          <div class="shelf" data-shelf="featured"></div>
        </div>
      </section>

      <div class="marq" aria-hidden="true"><div class="dotstrip"></div><div class="track">{[...marquee, ...marquee].map(t => <><span>{t}</span><i>✹</i></>)}</div><div class="dotstrip"></div></div>

      <section class="sec magenta">
        <div class="wrap">
          <div class="shead">
            <div><span class="eyebrow">Everyone’s watching</span><h2>Popular right now.</h2><p>The creators getting the most views and calls on {identity.name} this week.</p></div>
            <img class="sticker" src={sticker('sab-dekh-rahe-hain')} alt="Sab dekh rahe hain" width="420" height="245" loading="lazy" />
            <Fragment set:html={arrows('popular')} />
          </div>
          <div class="shelf" data-shelf="popular"></div>
        </div>
      </section>

      <section class="sec paper">
        <div class="wrap">
          <div class="shead">
            <div><span class="eyebrow">Phone uthao</span><h2>Available for <span class="hl">calls.</span></h2><p>Online now or free later today. Tap Book call and pick Call now or a time that suits you.</p>
              <div class="stats"><div><b><span class="pulse"></span><span id="onlineCt">312</span></b>online right now</div><div><b>1,240</b>creators to call</div><div><b>₹10</b>calls from, per min</div></div></div>
            <img class="sticker" src={sticker('abhi-free-hai')} alt="Abhi free hai!" width="420" height="245" loading="lazy" />
            <a class="seeall" href="#results" data-quick="online">See everyone online <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8"/></svg></a>
          </div>
          <div class="shelf" data-shelf="available"></div>
        </div>
      </section>

      <section class="sec">
        <div class="wrap">
          <div class="shead">
            <div><span class="eyebrow">Naye dost</span><h2>New on <span style="color:var(--orange)">{identity.name}.</span></h2><p>Fresh faces who joined in the last 30 days. Be their first caller.</p></div>
            <img class="sticker" src={sticker('naye-chehre')} alt="Naye chehre" width="420" height="245" loading="lazy" />
            <Fragment set:html={arrows('new')} />
          </div>
          <div class="shelf" data-shelf="new"></div>
        </div>
      </section>

      <section class="sec orange">
        <div class="wrap">
          <div class="shead"><div><span class="eyebrow">Apna scene chuno</span><h2>Browse by category.</h2></div><img class="sticker" src={sticker('phone-karo-na')} alt="Phone karo na!" width="420" height="245" loading="lazy" /></div>
          <div class="tiles" id="tiles"></div>
        </div>
      </section>

      <section class="sec ink" style="padding-top:0">
        <div class="bunting" aria-hidden="true" style="margin-bottom:clamp(32px,4vw,64px)"></div>
        <div class="wrap">
          <div class="shead">
            <div><span class="eyebrow">Spotted on socials</span><h2>Not on {identity.name} <span style="color:var(--yellow)">yet.</span></h2><p>Creators we found on Instagram, YouTube and Facebook. They can’t take calls until they join. Ask them, and we’ll send the invite.</p></div>
            <img class="sticker" src={sticker('bulao-inko')} alt="Bulao inko!" width="420" height="245" loading="lazy" />
            <img class="side-art" src={img('illustrations/discover-invite.png', 640)} alt="" width="640" height="512" loading="lazy" aria-hidden="true" />
          </div>
          <div class="shelf" data-shelf="discovered"></div>
        </div>
      </section>
    </div>

    <section class="sec" id="join" style="background:var(--yellow);border-bottom:3px solid var(--ink)">
      <div class="wrap join-band">
        <img class="join-art" src={img('illustrations/join-creator.png', 900)} alt="Illustration of a creator with a ring light waving into a phone call" width="900" height="900" loading="lazy" />
        <div>
          <span class="eyebrow">For creators</span>
          <h2>Your fans want to talk.<br />Get paid for it.</h2>
          <p style="max-width:620px;margin:16px auto 0 0;font-size:clamp(17px,1.2vw,22px)">Connect your Instagram, YouTube or Facebook account. We import your profile and reels, you set your price and hours.</p>
          <div class="join-cta">
            <a class="skin-btn" href="/hosts/join">Join &amp; earn <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8"/></svg></a>
            <img class="sticker" src={sticker('baat-karo-kamao')} alt="Baat karo, kamao" width="420" height="245" loading="lazy" />
          </div>
        </div>
      </div>
    </section>
    <div class="foot-fringe" aria-hidden="true"></div>
  </main>
  <Footer />
</div>
<div id="drawerRoot" hidden></div>
<script type="application/json" id="xp-img" set:html={JSON.stringify(IMG)}></script>
<script>
import { initExplorePreview } from '../../lib/explorePreview';
initExplorePreview();
</script>
</body>
</html>
