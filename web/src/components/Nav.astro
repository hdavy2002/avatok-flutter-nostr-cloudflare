---
// Site header — replicates the old avatok.ai SiteHeader (the chrome that wraps
// the landing + every public page): a sticky cream bar with the teal-A logo +
// wordmark on the left, the primary nav in the middle, and auth-aware CTAs on
// the right (wallet pill + Open studio + Sign out, or Log in + Sign up). The
// right side is a small React island (HeaderCtas) since it depends on session.
import HeaderCtas from '../islands/site/HeaderCtas.tsx';

interface Props {
  /**
   * Render the right-side CTAs as plain Log in / Sign up links instead of the
   * Clerk-backed HeaderCtas island. REQUIRED on any page whose body already
   * mounts a Clerk island (sign-in/up, book, consult, watch, agent, vision):
   * @clerk/clerk-react throws "multiple <ClerkProvider>" if two islands each
   * mount a provider on the same page, which blanks the page. Static CTAs keep
   * the header to a single (body) provider.
   */
  staticCtas?: boolean;
  /** Hide the right-side auth CTAs entirely (used on the public marketing /
   *  legal pages, consistent with the landing which no longer shows sign-up). */
  hideCtas?: boolean;
}
const { staticCtas = false, hideCtas = false } = Astro.props;

const ghostCta =
  'rounded-full border-zine border-ink bg-card px-4 py-2 font-mono font-bold uppercase text-[12px] tracking-[0.06em] text-ink no-underline shadow-zine-xs hover:-translate-y-[1px] transition-transform duration-zine';
const primaryCta =
  'rounded-full border-zine border-ink bg-lime px-4 py-2 font-mono font-bold uppercase text-[12px] tracking-[0.06em] text-ink no-underline shadow-zine-xs hover:-translate-y-[1px] transition-transform duration-zine';

// Primary nav.
//
// [WEB-NAV-MARKETPLACE-1 2026-08-26] Marketplace added as the FIRST item and is
// the only entry pointing at a real route (`src/pages/marketplace.astro`).
//
// ⚠️ THE FIVE ANCHOR LINKS BELOW ARE DEAD AND HAVE BEEN SINCE THE HOMEPAGE WAS
// REDESIGNED. They target `#features` / `#receptionist` / `#number` /
// `#messaging` / `#faq`, and NONE of those ids exist in the current landing
// document (`src/landing/avatok-desi-editorial-marketplace.html` or
// `…-listings-catalogue.html`) — verified by grep, 0 hits each. Clicking any of
// them just lands at the top of the home page. This header is used by 21 pages,
// so that is a broken menu across most of the site.
//
// The real section ids on today's homepage are `#live-streaming`,
// `#consultations` and `#marketplace-catalogue` (`#voice-agents` was removed
// [MKT-3GROUP-WEB-1 2026-09-05] — "Voices with character" is gone from the
// front page). Replacing the
// five below with those is a one-line change, but it is a product decision
// about what belongs in the menu, so it is deliberately NOT made here.
const links: { href: string; label: string }[] = [
  { href: '/marketplace', label: 'Marketplace' },
  { href: '/#features', label: 'Features' },
  { href: '/#receptionist', label: 'Receptionist' },
  { href: '/#number', label: 'Number' },
  { href: '/#messaging', label: 'Messaging' },
  { href: '/#faq', label: 'FAQ' },
];
const linkClass =
  'font-body font-extrabold text-[14px] text-inkSoft hover:text-ink no-underline transition-colors';
---

<header class="sticky top-0 z-40 border-b-zine border-ink bg-paper2/95 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center gap-5 px-4 py-3">
    <a href="/" class="flex items-center gap-2 no-underline" aria-label="avatok.ai home">
      <img src="/app-logo2.png" alt="" width="36" height="36" class="h-[36px] w-[36px] rounded-full object-cover" />
      <span class="font-display font-semibold text-[22px] leading-none tracking-[-0.4px] text-ink">
        ava<span class="text-blueInk">tok</span>
      </span>
    </a>

    <!-- Center nav (desktop) -->
    <nav class="hidden items-center gap-6 lg:flex">
      {links.map((l) => <a href={l.href} class={linkClass}>{l.label}</a>)}
    </nav>

    <!-- Right CTAs -->
    <div class="ml-auto hidden items-center gap-2 sm:flex">
      {hideCtas ? null : staticCtas ? (
        <>
          <a href="/sign-in" class={ghostCta}>Log in</a>
          <a href="/sign-up" class={primaryCta}>Sign up</a>
        </>
      ) : (
        <HeaderCtas client:load />
      )}
    </div>

    <!-- Mobile hamburger -->
    <button
      id="nav-burger"
      type="button"
      aria-label="Open menu"
      aria-expanded="false"
      class="ml-auto flex h-9 w-9 items-center justify-center rounded-zineBadge border-zine border-ink bg-card shadow-zine-xs sm:hidden"
    >
      <svg width="18" height="14" viewBox="0 0 18 14" aria-hidden="true">
        <path d="M1 1h16M1 7h16M1 13h16" stroke="var(--zine-ink)" stroke-width="2.4" stroke-linecap="round"></path>
      </svg>
    </button>
  </div>

  <!-- Mobile sheet -->
  <div id="nav-sheet" class="hidden border-t-zine border-ink bg-paper2 sm:hidden">
    <div class="mx-auto flex max-w-6xl flex-col gap-1 px-4 py-3">
      {links.map((l) => (
        <a href={l.href} class="rounded-zineField px-3 py-2.5 font-body font-extrabold text-[15px] text-ink no-underline hover:bg-card">{l.label}</a>
      ))}
      {!hideCtas && (
        <div class="mt-2 flex gap-2 border-t-zine border-ink pt-3">
          <a href="/sign-in" class="flex-1 rounded-full border-zine border-ink bg-card px-3 py-2.5 text-center font-mono font-bold uppercase text-[14px] tracking-[0.06em] text-ink no-underline shadow-zine-xs">Log in</a>
          <a href="/sign-up" class="flex-1 rounded-full border-zine border-ink bg-lime px-3 py-2.5 text-center font-mono font-bold uppercase text-[14px] tracking-[0.06em] text-ink no-underline shadow-zine-xs">Sign up</a>
        </div>
      )}
    </div>
  </div>

  <script>
    const burger = document.getElementById('nav-burger');
    const sheet = document.getElementById('nav-sheet');
    burger?.addEventListener('click', () => {
      const open = sheet?.classList.toggle('hidden') === false;
      burger.setAttribute('aria-expanded', String(open));
      burger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    });
  </script>
</header>
