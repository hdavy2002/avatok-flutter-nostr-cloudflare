---
// [LIST-PAGE-2 / LIST-DESIGN-1] THE real, public, chrome-free listing details page — every
// listing type (live event, consult, AI agent, free) renders through this ONE
// component, replacing the hardcoded-mock comp that used to serve
// `/<handle>/<slug>`. Comp: design/live-streaming/avaTOK Listing Details.dc.html.
// Specs: Specs/SPEC-2026-09-01-LISTING-CONTENT-AND-BOOKING.md (§A1.3, §B, §D, §G),
// Specs/SPEC-2026-09-02-LISTING-TRUST-AND-VIBE.md (§1, §3, §5).
//
// [LIST-DESIGN-1 2026-09-02] Markup/styling pass to match the comp pixel-for-
// pixel where feasible: full-width (100rem) boxed container, two-row layout
// (hero player+meta, then sticky booking aside + main content), truck-art
// strips (CSS approximation — see web/src/styles/listing-details.css), the
// LIVE band, stats board, red-second-word section titles, etc. All data
// bindings below are unchanged from LIST-PAGE-2 — only markup/classes moved.
//
// Rendered on /l/<id>, /<handle>/<slug> and /e/<id> — all three pass the same
// flat `Listing` (apiClient.getListing / getListingBySlug already unwrap the
// worker's envelope). `mode="dashboard"` is unused today (the pivot moved
// editing to a slim "you own this" bar instead of a separate dashboard twin —
// see `viewer.is_owner` below) but kept for API compatibility with existing
// callers.
//
// LAYOUT SWITCH — chosen from `listing.kind` + `free_entry`, never guessed from
// content shape:
//   kind === 'agent'                       -> AI_AGENT  (TRUST §3.3)
//   kind === 'consult'                     -> CONSULT   (TRUST §3.2)
//   free_entry truthy (any other kind)     -> LIVE layout + free-lane overrides (§3.4)
//   everything else (live_event/event/…)   -> LIVE_EVENT (the comp, §3.1)
import '../styles/listing-details.css';
import { Avatar } from '../components';
import { cfImage } from '../lib/config';
import { durationLabel, languageLabel } from '../lib/card';
import { inrOrFree } from '../lib/money';
import { getListingReviews, getListingSlots, getExplore } from '../lib/apiClient';
import { freeBox, houseRules, sectionTitles, shareCopy } from '../lib/copy';
import type { CoverMedia, Listing, ReviewList, ListingSlot, Card as CardModel } from '../lib/types';
import HostCard from './listing/HostCard.astro';
import ReviewsSection from './listing/ReviewsSection.astro';
import PromisesBand from './listing/PromisesBand.astro';
import BrowseMore from './listing/BrowseMore.astro';
import TruckBorder from './TruckBorder.astro';
import BookingBoxIsland from '../islands/listing/BookingBox';
import ShareBoxIsland from '../islands/listing/ShareBox';
import QrCodeIsland from '../islands/listing/QrCode';
import AskHostIsland from '../islands/listing/AskHost';

interface Props { listing: Listing; mode?: 'public' | 'dashboard' }
const { listing } = Astro.props;

const id = listing.id;
const kind = (listing.kind ?? 'content') as string;
const isLive = listing.live === true || (listing as { status?: string }).status === 'live';
const isFreeEntry = Boolean(listing.free_entry);
const isAgent = kind === 'agent';
const isConsult = kind === 'consult';
const layout: 'agent' | 'consult' | 'live' = isAgent ? 'agent' : isConsult ? 'consult' : 'live';

const isOwner = Boolean(listing.viewer?.is_owner);

// ── Data this component fetches beyond the base `Listing` the caller already
// has — reviews (paginated, with histogram) and slots (gated behind
// listingSlotsEnabled). Both fail soft: a 404/503/network error hides the
// section rather than crashing the page — this is a public page and must
// render for a real listing even when a companion table isn't migrated yet.
let reviewList: ReviewList | null = null;
try { reviewList = await getListingReviews(id, {}); } catch { reviewList = null; }

let slots: ListingSlot[] | null = null;
try { slots = await getListingSlots(id); } catch { slots = null; }

let browseMore: CardModel[] = [];
try {
  const page = await getExplore({ section: listing.section ?? undefined, category: listing.category ?? undefined, limit: 9 });
  browseMore = page.listings ?? [];
} catch { browseMore = []; }
if (browseMore.length === 0 && listing.category) {
  try {
    const page = await getExplore({ category: listing.category, limit: 9 });
    browseMore = page.listings ?? [];
  } catch { browseMore = []; }
}

// ── Creator ─────────────────────────────────────────────────────────────────
// [LIST-DETAIL-BUG-5] `??` only falls through on null/undefined — a creator row
// with `name: ''` / `handle: ''` (empty string, not absent) used to slip past
// the fallback chain untouched, leaving `creatorName` an empty string. That fed
// an empty `name` into <Avatar>, whose own fallback renders a bare "?" instead
// of initials, and produced blank/placeholder text wherever creatorName was
// printed directly. `||` treats "" the same as missing, which is what we want
// here — nobody's real display name is deliberately blank.
const creator = listing.creator ?? null;
const creatorSlug = creator?.handle || creator?.uid || creator?.id || null;
const creatorAvatarUrl = creator?.avatar || creator?.avatar_url || null;
const creatorHandle = creator?.handle || null;
const creatorDisplayName = creator?.name || null;
const creatorName = creatorDisplayName || (creatorHandle ? `@${creatorHandle}` : 'avaTOK creator');
const hostFirstName = creatorDisplayName ? (creatorDisplayName.split(' ')[0] || creatorDisplayName) : (creatorHandle || 'the host');
// Initials for the avatar fallback: from the real name if there is one, else
// from the handle, else the honest "AC" (avaTOK Creator) rather than a "?".
const hostInitials = creatorDisplayName
  ? creatorDisplayName.split(/\s+/).map((w) => w[0]).filter(Boolean).slice(0, 2).join('').toUpperCase()
  : creatorHandle
    ? creatorHandle.replace(/^@/, '').slice(0, 2).toUpperCase()
    : 'AC';

// [LIST-PAGE-2 gap 2] Two-tone Anton title (comp: "ANTAKSHARI FRIDAY" / red
// "WITH SUNNY."). Only splits when there's enough to split — a 1-2 word title
// has no natural "lede vs accent" break, so it renders plain.
// [LIST-DETAIL-BUG-2] `titleAccent` always appended a "." even when the last
// word already ended in punctuation ("TRY KARO!" -> "TRY KARO!."), and the gap
// between the lead and accent spans relied on a bare whitespace text node
// between two template expressions, which is exactly the whitespace JSX/Astro
// is liable to collapse away ("ANTAKSHARI FRIDAY" + "WITH DAVY." rendering with
// no space). Render uses an explicit `{' '}` for the former; this only fixes
// the latter (no redundant "..").
const titleWords = listing.title.trim().split(/\s+/).filter(Boolean);
const titleLead = titleWords.length >= 3 ? titleWords.slice(0, -2).join(' ') : null;
const titleAccentRaw = titleWords.length >= 3 ? titleWords.slice(-2).join(' ') : null;
const titleAccent = titleAccentRaw ? (/[.!?]$/.test(titleAccentRaw) ? titleAccentRaw : `${titleAccentRaw}.`) : null;

const trust = listing.creator_trust_stats ?? null;
const respMin = listing.response_time_min ?? trust?.avg_response_min ?? null;

function hostSinceLabel(ms?: number | null): string | null {
  if (!trust?.first_session_at && !ms) return null;
  const t = trust?.first_session_at ?? ms;
  const d = new Date(Number(t));
  if (Number.isNaN(d.getTime())) return null;
  return d.toLocaleDateString('en-IN', { month: 'short', year: 'numeric' }).toUpperCase();
}
const hostSince = hostSinceLabel(listing.created_at ?? null);

const hostChips: string[] = [];
if (listing.rating_avg != null) hostChips.push(`★ ${Number(listing.rating_avg).toFixed(1)} HOST RATING`);
if (trust?.shows_hosted) hostChips.push(`${trust.shows_hosted} SHOWS`);
if (respMin != null) hostChips.push(`~${respMin} MIN REPLY`);

// ── Media ───────────────────────────────────────────────────────────────────
const covers = (listing.cover_media ?? []).filter((m): m is CoverMedia => !!m && typeof m === 'object' && !!(m.url || m.r2_key));
const posterUrl = covers[0]?.url ?? covers[0]?.r2_key ?? null;
const thumbUrls = covers.slice(1, 4).map((m) => m.url ?? m.r2_key ?? '').filter(Boolean);

function youtubeEmbedUrl(url?: string | null): string | null {
  if (!url) return null;
  try {
    const u = new URL(url);
    const host = u.hostname.replace(/^www\./, '').replace(/^m\./, '');
    let vid: string | null = null;
    if (host === 'youtu.be') vid = u.pathname.slice(1);
    else if (host === 'youtube.com') {
      if (u.pathname === '/watch') vid = u.searchParams.get('v');
      else if (u.pathname.startsWith('/embed/')) vid = u.pathname.slice('/embed/'.length);
      else if (u.pathname.startsWith('/shorts/')) vid = u.pathname.slice('/shorts/'.length);
    }
    vid = vid ? vid.split(/[?&]/)[0] : null;
    return vid && /^[\w-]{6,20}$/.test(vid) ? `https://www.youtube-nocookie.com/embed/${vid}` : null;
  } catch { return null; }
}
const videoEmbed = youtubeEmbedUrl(listing.video_url);

// ── Live band / countdown ───────────────────────────────────────────────────
// [LIST-DETAIL-BUG-1] This is SSR'd on Cloudflare's Worker clock, which is
// UTC — `toLocaleDateString()`/`toLocaleString()` with no `timeZone` format in
// whatever zone the RUNTIME happens to be in, not the host's. A creator who
// entered 21:00 IST saw the page print "3:30 pm" (21:00 IST - 5:30 = 15:30
// UTC). Every server-rendered clock on this page must pass `timeZone: tz`
// explicitly. `tz` defaults to Asia/Kolkata — avaTOK has no international
// hosts today (see CLAUDE.md "no company" / India-only market) and the field
// is optional on older listings.
const tz = listing.timezone || 'Asia/Kolkata';

function toMs(t?: number | null): number | null { if (t == null) return null; return t < 1e12 ? t * 1000 : t; }
const startMs = toMs(listing.starts_at);
const endMs = toMs(listing.ends_at);

/** IANA zone abbreviation for a given instant, e.g. "IST", "GMT+5:30". */
function tzAbbr(ms: number, timeZone: string): string {
  try {
    const parts = new Intl.DateTimeFormat('en-US', { timeZone, timeZoneName: 'short' }).formatToParts(new Date(ms));
    return parts.find((p) => p.type === 'timeZoneName')?.value ?? '';
  } catch { return ''; }
}

/**
 * The ONE date+time formatter for this page — signature:
 *   formatListingTime(ms: number, timeZone: string): string
 * "Sat 5 Sept · 9:00 PM IST" — always rendered in `timeZone` (the listing's
 * host timezone), regardless of what clock the server or the reader is on.
 */
function formatListingTime(ms: number, timeZone: string): string {
  const d = new Date(ms);
  if (Number.isNaN(d.getTime())) return '';
  try {
    const datePart = new Intl.DateTimeFormat('en-IN', { timeZone, weekday: 'short', day: 'numeric', month: 'short' }).format(d);
    const timePart = new Intl.DateTimeFormat('en-IN', { timeZone, hour: 'numeric', minute: '2-digit' }).format(d);
    const abbr = tzAbbr(ms, timeZone);
    return `${datePart} · ${timePart}${abbr ? ` ${abbr}` : ''}`;
  } catch { return d.toISOString(); }
}

/** Just the clock face, tz-aware — "9:00 PM IST" — for spots that only need the time. */
function formatListingClock(ms: number, timeZone: string): string {
  const d = new Date(ms);
  if (Number.isNaN(d.getTime())) return '';
  try {
    const timePart = new Intl.DateTimeFormat('en-IN', { timeZone, hour: 'numeric', minute: '2-digit' }).format(d);
    const abbr = tzAbbr(ms, timeZone);
    return abbr ? `${timePart} ${abbr}` : timePart;
  } catch { return d.toLocaleTimeString('en-IN'); }
}

const startsAtLabel = startMs != null ? formatListingTime(startMs, tz) : null;

// ── Chips / facts ────────────────────────────────────────────────────────────
const langTag = languageLabel(listing.spoken_lang ?? null);
const durationTag = durationLabel(listing.duration_min ?? null);
const attrs = (listing.attrs ?? {}) as Record<string, unknown>;
const howItWorks = Array.isArray(attrs.content_how_it_works) ? (attrs.content_how_it_works as { label: string; body: string }[]) : [];
const houseRulesList = Array.isArray(attrs.content_house_rules) ? (attrs.content_house_rules as { heading: string; body: string }[]) : [];
const houseRulesIntro = typeof attrs.content_house_rules_intro === 'string' ? attrs.content_house_rules_intro : null;
const whatYouGet = Array.isArray(attrs.content_what_you_get) ? (attrs.content_what_you_get as string[]) : [];
const whoFor = Array.isArray(attrs.content_who_for) ? (attrs.content_who_for as string[]) : [];
const notFor = Array.isArray(attrs.content_not_for) ? (attrs.content_not_for as string[]) : [];
const faq = Array.isArray(attrs.content_faq) ? (attrs.content_faq as { q: string; a: string }[]) : [];
const sampleQa = Array.isArray(attrs.content_sample_qa) ? (attrs.content_sample_qa as { q: string; a: string }[]) : [];
const sampleChat = Array.isArray(attrs.content_sample_chat) ? (attrs.content_sample_chat as { who: string; line: string }[]) : [];
const canDo = Array.isArray(attrs.content_can_do) ? (attrs.content_can_do as string[]) : [];
const cantDo = Array.isArray(attrs.content_cant_do) ? (attrs.content_cant_do as string[]) : [];
const credential = typeof listing.credential === 'string' ? listing.credential : null;
const joinLeadMinutes = Number.isFinite(Number(attrs.content_join_lead_minutes)) ? Number(attrs.content_join_lead_minutes) : null;

function cancellationHours(): number | null {
  const a = Number(attrs.commercial_refund_window_hours);
  if (Number.isFinite(a)) return a;
  const b = Number(attrs.commercial_cancellation_window_hours);
  return Number.isFinite(b) ? b : null;
}
const refundHours = cancellationHours();
const isRefund = attrs.commercial_refund_window_hours != null;
const prepText = typeof attrs.commercial_preparation_instructions === 'string' ? attrs.commercial_preparation_instructions.trim() || null : null;

const price = listing.price ?? null;
const priceStr = isFreeEntry ? 'FREE' : inrOrFree(price ?? 0);
const billingSuffix: Record<string, string> = { minute: '/ MIN', '10min': '/ 10 MIN', chat: '/ CHAT', night: '/ NIGHT', game: '/ GAME', session: '' };
const priceUnit = isFreeEntry ? null : (listing.billing_unit && billingSuffix[listing.billing_unit] ? billingSuffix[listing.billing_unit] : (durationTag ? `/ ${(listing.billing_unit ?? 'SEAT').toUpperCase()}` : ''));

const seatsLeft = listing.seats_left ?? null;
const freeSpotsLeft = listing.capacity != null && listing.seats_taken != null
  ? Math.max(0, listing.capacity - listing.seats_taken)
  : (listing.seats_left ?? null);

const detailUrl = new URL(Astro.request.url);
detailUrl.search = '';
const shareUrl = detailUrl.href;

// ── Eyebrow line: "01 · GROUP SHOWS · TICKETED · WEEKLY" style tag row ─────
const eyebrowParts = [listing.category, isFreeEntry ? 'FREE' : 'TICKETED', listing.schedule_mode === 'recurring' ? 'WEEKLY' : null]
  .filter((s): s is string => !!s)
  .map((s) => s.toUpperCase());

const hasVideo = !!videoEmbed;
const sectionCount = [
  !!creator, howItWorks.length > 0, houseRulesList.length > 0, !!listing.description, hasVideo, (reviewList?.total ?? 0) > 0,
].filter(Boolean).length;
const listingViewProps = {
  listing_id: id, kind, free_entry: isFreeEntry,
  status: (listing as { status?: string | null }).status ?? null,
  seats_left: seatsLeft, has_video: hasVideo, section_count: sectionCount,
};
---

<div class="ld" data-listing-id={id}>
  {isOwner && (
    <div class="ld-owner-bar">
      <span>You own this listing</span>
      <a href={`/dashboard/listings/new?id=${encodeURIComponent(id)}`} data-cta="edit_listing">Edit listing →</a>
    </div>
  )}

  <div class="ld-breadcrumb-bar">
    <div class="ld-wrap ld-breadcrumb">
      <span>BAZAAR</span>
      {listing.section && <><span class="ld-breadcrumb-sep">›</span><span>{String(listing.section).toUpperCase()}</span></>}
      <span class="ld-breadcrumb-sep">›</span>
      <span class="ld-breadcrumb-current">{listing.title.toUpperCase()}</span>
      <span class="ld-breadcrumb-num">LISTING #{id.slice(0, 8).toUpperCase()}</span>
    </div>
  </div>

  {isLive && (
    <div class="ld-live-band" data-section="live_band">
      <div class="ld-wrap ld-live-band-row">
        <span class="ld-live-lead"><span class="ld-live-dot"></span>LIVE NOW</span>
        {listing.watching != null && <span class="ld-live-sub">{listing.watching} WATCHING</span>}
        {endMs && <span class="ld-live-sub" data-listing-time data-ms={endMs} data-tz={tz}>ENDS {formatListingClock(endMs, tz)}</span>}
        <a href={`/watch/${encodeURIComponent(id)}`} class="ld-join-now" data-cta="join_now">▸ JOIN NOW</a>
      </div>
    </div>
  )}

  <!-- hero row: player + title/meta -->
  <div class="ld-wrap ld-hero">
    <div class="ld-hero-player">
      <div class="ld-stage-card">
        <div class="ld-stage-viewport">
        {isLive && videoEmbed ? (
          <div class="ld-stage-media" data-video-block>
            <iframe src={videoEmbed} title={`${listing.title} — live`} allow="encrypted-media; picture-in-picture" allowfullscreen />
          </div>
        ) : posterUrl ? (
          <div class="ld-stage-media">
            <img
              src={cfImage(posterUrl, { width: 900, fit: 'cover' })}
              alt={listing.title}
              data-gallery-open
              onerror="this.onerror=null;this.closest('.ld-stage-media').classList.add('ld-stage-placeholder');this.remove();"
            />
          </div>
        ) : (
          <div class="ld-stage-media ld-stage-placeholder" aria-hidden="true"></div>
        )}
        <div class="ld-stage-pills">
          {isLive && <span class="ld-pill ld-pill--live">LIVE NOW</span>}
          {isLive && listing.watching != null && <span class="ld-pill">◉ {listing.watching}</span>}
          {(listing.joined_count ?? 0) > 0 && <span class="ld-pill">✓ {listing.joined_count} BOOKED</span>}
          <span class="ld-stage-actions">
            <button type="button" class="ld-icon-btn" id="share-toggle" aria-label="Share">⤴</button>
            <button type="button" class="ld-icon-btn" id="fav-toggle" aria-label="Favourite">♡</button>
          </span>
        </div>
        <div class="ld-scallop"></div>
        </div>
        <div class="ld-stage-footer">
          {creator && (
            <a href={creatorSlug ? `/c/${encodeURIComponent(creatorSlug)}` : '#'} class="ld-host-line">
              <span class="ld-host-line-avatar"><Avatar src={creatorAvatarUrl} name={creatorName} size={30} /></span>
              <span class="ld-host-line-name">{creatorName}{!isAgent && creator.kyc_verified ? ' ✓' : ''}</span>
            </a>
          )}
          <span class="ld-host-line-meta">
            {hostSince && <>HOST SINCE {hostSince}</>}
            {hostSince && respMin != null && ' · '}
            {respMin != null && <>REPLIES IN ~{respMin} MIN</>}
          </span>
        </div>
      </div>

      {thumbUrls.length > 0 && (
        <div class="ld-thumb-row">
          {thumbUrls.map((u) => (
            <img src={cfImage(u, { width: 200, fit: 'cover' })} alt="" class="ld-thumb" data-gallery-open />
          ))}
          {videoEmbed && !isLive && <div class="ld-thumb-video">▶</div>}
        </div>
      )}

      <div class="ld-share-box" data-section="share">
        <div class="ld-share-title-row">
          <span class="ld-share-title">{shareCopy.title}</span>
        </div>
        <div class="ld-share-box-row">
          <ShareBoxIsland client:load listingId={id} url={shareUrl} title={listing.title} />
          <div class="ld-qr-wrap">
            <QrCodeIsland client:visible url={shareUrl} />
          </div>
        </div>
      </div>
    </div>

    <div class="ld-hero-meta">
      {eyebrowParts.length > 0 && <div class="ld-eyebrow-tag">{eyebrowParts.join(' · ')}</div>}
      <h1 class="ld-title">
        {titleAccent ? (
          <>{titleLead}{' '}<span class="ld-title-accent">{titleAccent}</span></>
        ) : (
          listing.title
        )}
      </h1>

      <div class="ld-chip-row">
        {listing.rating_avg != null && (
          <span class="ld-chip">★ {Number(listing.rating_avg).toFixed(1)}{listing.review_count ? ` · ${listing.review_count}` : ''}</span>
        )}
        {(listing.creator?.follower_count ?? 0) > 0 && <span class="ld-chip">♡ {listing.creator!.follower_count} REGULARS</span>}
        {durationTag && langTag && <span class="ld-chip">{durationTag} · {langTag}</span>}
        {!durationTag && langTag && <span class="ld-chip">{langTag}</span>}
        <span class={`ld-chip ${listing.adults_only ? '' : 'ld-chip--strong'}`}>{listing.adults_only ? '18+' : '✓ 100% REAL HUMAN · NO AI'}</span>
        {isAgent && <span class="ld-chip ld-chip--ai">AI VOICE AGENT</span>}
      </div>

      {(listing.blurb || listing.description) && <p class="ld-blurb">{listing.blurb || listing.description}</p>}

      {(listing.joined_count || seatsLeft != null || trust?.shows_hosted || trust?.comeback_pct != null) && (
        <div class="ld-stats-board" data-section="stats">
          {listing.joined_count != null && <div><b>{listing.joined_count}</b><span>✓ BOOKED THIS SHOW</span></div>}
          {isLive && listing.watching != null && <div><b>{listing.watching}</b><span>WATCHING</span></div>}
          {trust?.shows_hosted != null && trust.shows_hosted > 0 && <div><b>{trust.shows_hosted}</b><span>SHOWS HOSTED</span></div>}
          {trust?.comeback_pct != null && <div><b>{Math.round(trust.comeback_pct)}%</b><span>♡ COME BACK AGAIN</span></div>}
        </div>
      )}

      {priceUnit != null && (
        <div class="ld-price-row">
          <span class="ld-price-big">{priceStr} <span class="ld-price-unit">{priceUnit}</span></span>
          <span class="ld-price-note">FEES &amp; GST SHOWN BEFORE YOU BOOK</span>
        </div>
      )}
      {isFreeEntry && (
        <div class="ld-price-row">
          <span class="ld-price-big">FREE</span>
          <span class="ld-price-note">{freeBox.hostPays}</span>
        </div>
      )}

      {whatYouGet.length > 0 && (
        <div class="ld-what-you-get" data-section="what_you_get">
          <h2 class="ld-eyebrow-label">WHAT YOU GET</h2>
          <ul>{whatYouGet.map((s) => <li>{s}</li>)}</ul>
        </div>
      )}
      {(whoFor.length > 0 || notFor.length > 0) && (
        <div class="ld-who-for-grid">
          {whoFor.length > 0 && <div><h3>THIS IS FOR</h3><ul>{whoFor.map((s) => <li>{s}</li>)}</ul></div>}
          {notFor.length > 0 && <div><h3>NOT FOR</h3><ul>{notFor.map((s) => <li>{s}</li>)}</ul></div>}
        </div>
      )}

      {layout === 'agent' && (canDo.length > 0 || cantDo.length > 0) && (
        <div class="ld-who-for-grid" data-section="agent_honesty">
          {canDo.length > 0 && <div><h3>SHE CAN</h3><ul>{canDo.map((s) => <li>{s}</li>)}</ul></div>}
          {cantDo.length > 0 && <div><h3>SHE CAN'T</h3><ul>{cantDo.map((s) => <li>{s}</li>)}</ul></div>}
        </div>
      )}

      {layout === 'agent' && sampleChat.length > 0 && (
        <div class="ld-sample-chat" data-section="sample_chat">
          <h2 class="ld-eyebrow-label">SAMPLE CHAT</h2>
          {sampleChat.slice(0, 6).map((m) => (
            <div class={`ld-chat-line ${m.who === 'agent' ? 'ld-chat-line--agent' : 'ld-chat-line--user'}`}>{m.line}</div>
          ))}
        </div>
      )}

      {layout === 'consult' && credential && creator?.kyc_verified && (
        <p class="ld-credential-line">{credential}</p>
      )}
      {layout === 'consult' && prepText && (
        <div class="ld-prep-box" data-section="prep">
          <h2 class="ld-eyebrow-label">WHAT WE'LL COVER</h2>
          <p>{prepText}</p>
        </div>
      )}
      {layout === 'consult' && sampleQa.length > 0 && (
        <div class="ld-sample-qa" data-section="sample_qa">
          <h2 class="ld-eyebrow-label">SAMPLE Q&amp;A</h2>
          {sampleQa.slice(0, 3).map((qa) => (
            <div class="ld-qa-pair"><p class="ld-qa-q">Q. {qa.q}</p><p class="ld-qa-a">A. {qa.a}</p></div>
          ))}
        </div>
      )}

      {!isFreeEntry && (
        <div class="ld-masala-quote-row">
          <img src="/ld/desi-swag.png" alt="" class="ld-masala-sticker" loading="lazy" />
          <div class="ld-masala-quote">"Booked seat, booked mood." — a regular</div>
        </div>
      )}
    </div>
  </div>

  <!-- content row: sticky booking aside + main sections -->
  <div class="ld-wrap ld-content-row">
    <aside class="ld-aside" data-section="booking_box">
      <div class="ld-booking-card">
        <div class="ld-strip-frame ld-strip-frame--top"><TruckBorder kind="tassels" count={40} /></div>
        {isLive ? (
          <div class="ld-booking-live-header">
            <span class="ld-live-dot"></span>
            <span class="ld-booking-live-lead">LIVE NOW{listing.watching != null ? ` · ${listing.watching}` : ''}</span>
            <span class="ld-booking-live-sub">BOOK &amp; JOIN INSTANTLY</span>
          </div>
        ) : startsAtLabel ? (
          <div class="ld-booking-next-header"><span data-listing-time data-ms={startMs} data-tz={tz}>NEXT SHOW · {startsAtLabel}</span></div>
        ) : null}
        <div class="ld-booking-body">
          <div class="ld-booking-title-row">
            <span class="ld-booking-title">{isFreeEntry ? 'RESERVE A SPOT' : (kind === 'consult' ? 'BOOK A SLOT' : 'BOOK A SEAT')}</span>
            {priceUnit != null && <span class="ld-booking-price">{priceStr} {priceUnit}</span>}
          </div>
          <BookingBoxIsland
            client:load
            listingId={id}
            kind={kind}
            isLive={isLive}
            isFreeEntry={isFreeEntry}
            price={price}
            maxPerBooking={listing.max_per_booking ?? 4}
            watching={listing.watching ?? null}
            seatsLeft={seatsLeft}
            freeSpotsLeft={freeSpotsLeft}
            startsAtLabel={startsAtLabel}
            startsAtMs={startMs}
            timezone={tz}
            slots={slots}
            joinLeadMinutes={joinLeadMinutes}
            recurrenceDays={listing.recurrence_days ?? null}
            scheduleMode={listing.schedule_mode ?? null}
          />
        </div>
      </div>
      <div class="ld-handwriting">Seat gayi toh gaana bhi gaya.<br />— Bazaar rule #7</div>
    </aside>

    <main class="ld-main">
      {howItWorks.length > 0 && (
        <section data-section="how_it_works">
          <h2 class="ld-section-title">How the show <span class="ld-accent">works.</span></h2>
          <div class="ld-strip-frame"><TruckBorder kind="jhalar" count={40} /></div>
          <div class="ld-step-grid">
            {howItWorks.map((s, i) => (
              <div class="ld-card ld-step-card">
                <div class="ld-step-tag">STEP {i + 1} · {s.label.toUpperCase()}</div>
                <p>{s.body}</p>
              </div>
            ))}
          </div>
        </section>
      )}

      {creator && (
        <section data-section="host">
          <div class="ld-section-head">
            <h2 class="ld-section-title">Meet the <span class="ld-accent">host.</span></h2>
            <span class="ld-section-note">ID VERIFIED · PAST SESSIONS SHOWN UNEDITED</span>
          </div>
          <div class="ld-strip-frame"><TruckBorder kind="tassels" count={40} /></div>
          <HostCard
            creator={creator}
            creatorSlug={creatorSlug}
            avatarUrl={creatorAvatarUrl}
            city={listing.location}
            bio={listing.description ?? null}
            chips={hostChips}
            isAgent={isAgent}
            hostSinceLabel={hostSince}
            trust={trust}
            hostInitials={hostInitials}
          />
        </section>
      )}

      {creator && !isOwner && !isAgent && (
        <AskHostIsland client:visible listingId={id} hostName={hostFirstName} />
      )}

      {(houseRulesList.length > 0 || houseRulesIntro) && (
        <section class="ld-house-rules" data-section="house_rules">
          <div class="ld-section-head">
            <h2 class="ld-section-title">{houseRules.title}</h2>
            <img src="/ld/jatt-sticker.png" alt="" class="ld-caution-sticker" loading="lazy" />
            <span class="ld-section-note">SET BY THE HOST · SHOWN BEFORE EVERY BOOKING</span>
          </div>
          <div class="ld-strip-frame"><TruckBorder kind="eyes" count={40} /></div>
          <div class="ld-rules-card">
            {houseRulesIntro && (
              <div class="ld-rules-intro-row">
                <span class="ld-rules-avatar">{hostInitials}</span>
                <p class="ld-rules-quote">"{houseRulesIntro}"</p>
              </div>
            )}
            <div class="ld-rules-grid">
              {houseRulesList.map((r, i) => (
                <div class="ld-rule-card">
                  <span class="ld-rule-num">{i + 1}</span>
                  <span>
                    <span class="ld-rule-head">{r.heading.toUpperCase()}</span>
                    <span class="ld-rule-text">{r.body}</span>
                  </span>
                </div>
              ))}
            </div>
            <div class="ld-rules-baseline-row">
              <span class="ld-rules-baseline-text">{houseRules.platformBaseline}</span>
              <a href="/terms" class="ld-rules-baseline-link">READ PLATFORM RULES</a>
            </div>
          </div>
        </section>
      )}

      {faq.length > 0 && (
        <section data-section="faq">
          <h2 class="ld-section-title">FAQ</h2>
          <div class="ld-faq-list">
            {faq.map((f) => (
              <details class="ld-faq-item"><summary>{f.q}</summary><p>{f.a}</p></details>
            ))}
          </div>
        </section>
      )}

      <ReviewsSection listingId={id} reviewList={reviewList} />

      <PromisesBand refundHours={isRefund ? refundHours : null} cancelHours={!isRefund ? refundHours : null} />
    </main>
  </div>

  <BrowseMore cards={browseMore} excludeId={id} />
</div>

<script define:vars={{ listingViewProps }}>
  // [WEB-POSTHOG-1] §2.4 listing_view / listing_section_view / listing_cta_click /
  // listing_gallery_open / listing_video_play. Contract:
  // Specs/SPEC-2026-09-02-TELEMETRY-CATALOG.md §2.4.
  import('../lib/analytics').then(({ capture }) => {
    capture('listing_view', listingViewProps);
    if (listingViewProps.kind) capture('creator_view', { listing_id: listingViewProps.listing_id });

    const seenSections = new Set();
    const sectionObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const section = entry.target.getAttribute('data-section');
          if (!section || seenSections.has(section)) continue;
          seenSections.add(section);
          capture('listing_section_view', { section, listing_id: listingViewProps.listing_id });
          sectionObserver.unobserve(entry.target);
        }
      },
      { threshold: 0.4 },
    );
    document.querySelectorAll('[data-section]').forEach((el) => sectionObserver.observe(el));

    document.querySelectorAll('[data-cta]').forEach((el) => {
      el.addEventListener('click', () => {
        capture('listing_cta_click', { cta: el.getAttribute('data-cta'), listing_id: listingViewProps.listing_id });
      });
    });

    document.querySelectorAll('[data-gallery-open]').forEach((el) => {
      el.addEventListener('click', () => capture('listing_gallery_open', { listing_id: listingViewProps.listing_id }));
    });

    let videoFired = false;
    const fireVideoPlay = () => {
      if (videoFired) return;
      videoFired = true;
      capture('listing_video_play', { listing_id: listingViewProps.listing_id });
    };
    const videoBlock = document.querySelector('[data-video-block]');
    if (videoBlock) {
      const vo = new IntersectionObserver((entries) => {
        for (const entry of entries) if (entry.isIntersecting) { fireVideoPlay(); vo.disconnect(); }
      }, { threshold: 0.6 });
      vo.observe(videoBlock);
    }
  });

  // [LIST-DETAIL-BUG-1] Every host-timezone time on this page — hero/live-band,
  // the booking box header, and (client-side, inside the BookingBox React
  // island) the calendar/slot labels — carries `data-listing-time` +
  // `data-ms`/`data-tz`. Never REPLACE the host time (a buyer must always see
  // when the host says the show starts); only APPEND "(your time: …)" when the
  // viewer's own zone actually differs. Runs after hydration and watches for
  // BookingBox's client-rendered slot list, which mounts/re-renders after this
  // script's first pass.
  (function enhanceListingTimesForViewer() {
    let viewerTz = 'Asia/Kolkata';
    try { viewerTz = Intl.DateTimeFormat().resolvedOptions().timeZone || viewerTz; } catch {}

    function run() {
      document.querySelectorAll('[data-listing-time]:not([data-viewer-enhanced])').forEach((el) => {
        el.setAttribute('data-viewer-enhanced', '1');
        const ms = Number(el.getAttribute('data-ms'));
        const listingTz = el.getAttribute('data-tz');
        if (!Number.isFinite(ms) || !listingTz || listingTz === viewerTz) return;
        try {
          const viewerStr = new Intl.DateTimeFormat('en-IN', {
            timeZone: viewerTz, weekday: 'short', day: 'numeric', month: 'short', hour: 'numeric', minute: '2-digit',
          }).format(new Date(ms));
          const note = document.createElement('span');
          note.className = 'ld-your-time';
          note.style.opacity = '0.7';
          note.style.marginLeft = '0.4em';
          note.textContent = `(your time: ${viewerStr})`;
          el.appendChild(note);
        } catch { /* Intl not available for this zone — leave the host time as-is */ }
      });
    }

    run();
    const mo = new MutationObserver(run);
    mo.observe(document.body, { childList: true, subtree: true });
  })();
</script>
