---
// [LIST-PAGE-2] THE real, public, chrome-free listing details page — every
// listing type (live event, consult, AI agent, free) renders through this ONE
// component, replacing the hardcoded-mock comp that used to serve
// `/<handle>/<slug>`. Comp: design/live-streaming/avaTOK Listing Details.dc.html.
// Specs: Specs/SPEC-2026-09-01-LISTING-CONTENT-AND-BOOKING.md (§A1.3, §B, §D, §G),
// Specs/SPEC-2026-09-02-LISTING-TRUST-AND-VIBE.md (§1, §3, §5).
//
// Rendered on /l/<id>, /<handle>/<slug> and /e/<id> — all three pass the same
// flat `Listing` (apiClient.getListing / getListingBySlug already unwrap the
// worker's envelope). `mode="dashboard"` is unused today (the pivot moved
// editing to a slim "you own this" bar instead of a separate dashboard twin —
// see `viewer.is_owner` below) but kept for API compatibility with existing
// callers.
//
// LAYOUT SWITCH — chosen from `listing.kind` + `free_entry`, never guessed from
// content shape:
//   kind === 'agent'                       -> AI_AGENT  (TRUST §3.3)
//   kind === 'consult'                     -> CONSULT   (TRUST §3.2)
//   free_entry truthy (any other kind)     -> LIVE layout + free-lane overrides (§3.4)
//   everything else (live_event/event/…)   -> LIVE_EVENT (the comp, §3.1)
import { Avatar } from '../components';
import { cfImage } from '../lib/config';
import { durationLabel, languageLabel } from '../lib/card';
import { inrOrFree } from '../lib/money';
import { getListingReviews, getListingSlots, getExplore } from '../lib/apiClient';
import { freeBox, houseRules, sectionTitles, shareCopy } from '../lib/copy';
import type { CoverMedia, Listing, ReviewList, ListingSlot, Card as CardModel } from '../lib/types';
import HostCard from './listing/HostCard.astro';
import ReviewsSection from './listing/ReviewsSection.astro';
import PromisesBand from './listing/PromisesBand.astro';
import BrowseMore from './listing/BrowseMore.astro';
import BookingBoxIsland from '../islands/listing/BookingBox';
import ShareBoxIsland from '../islands/listing/ShareBox';
import QrCodeIsland from '../islands/listing/QrCode';
import AskHostIsland from '../islands/listing/AskHost';

interface Props { listing: Listing; mode?: 'public' | 'dashboard' }
const { listing } = Astro.props;

const id = listing.id;
const kind = (listing.kind ?? 'content') as string;
const isLive = listing.live === true || (listing as { status?: string }).status === 'live';
const isFreeEntry = Boolean(listing.free_entry);
const isAgent = kind === 'agent';
const isConsult = kind === 'consult';
const layout: 'agent' | 'consult' | 'live' = isAgent ? 'agent' : isConsult ? 'consult' : 'live';

const isOwner = Boolean(listing.viewer?.is_owner);

// ── Data this component fetches beyond the base `Listing` the caller already
// has — reviews (paginated, with histogram) and slots (gated behind
// listingSlotsEnabled). Both fail soft: a 404/503/network error hides the
// section rather than crashing the page — this is a public page and must
// render for a real listing even when a companion table isn't migrated yet.
let reviewList: ReviewList | null = null;
try { reviewList = await getListingReviews(id, {}); } catch { reviewList = null; }

let slots: ListingSlot[] | null = null;
try { slots = await getListingSlots(id); } catch { slots = null; }

let browseMore: CardModel[] = [];
try {
  const page = await getExplore({ section: listing.section ?? undefined, category: listing.category ?? undefined, limit: 9 });
  browseMore = page.listings ?? [];
} catch { browseMore = []; }
if (browseMore.length === 0 && listing.category) {
  try {
    const page = await getExplore({ category: listing.category, limit: 9 });
    browseMore = page.listings ?? [];
  } catch { browseMore = []; }
}

// ── Creator ─────────────────────────────────────────────────────────────────
const creator = listing.creator ?? null;
const creatorSlug = creator?.handle || creator?.uid || creator?.id || null;
const creatorAvatarUrl = creator?.avatar ?? creator?.avatar_url ?? null;
const creatorName = creator?.name ?? (creator?.handle ? `@${creator.handle}` : 'avaTOK creator');
const hostFirstName = creatorName.split(' ')[0] || creatorName;

// [LIST-PAGE-2 gap 2] Two-tone Anton title (comp: "ANTAKSHARI FRIDAY" / red
// "WITH SUNNY."). Only splits when there's enough to split — a 1-2 word title
// has no natural "lede vs accent" break, so it renders plain.
const titleWords = listing.title.trim().split(/\s+/).filter(Boolean);
const titleLead = titleWords.length >= 3 ? titleWords.slice(0, -2).join(' ') : null;
const titleAccent = titleWords.length >= 3 ? `${titleWords.slice(-2).join(' ')}.` : null;

const trust = listing.creator_trust_stats ?? null;
const respMin = listing.response_time_min ?? trust?.avg_response_min ?? null;

function hostSinceLabel(ms?: number | null): string | null {
  if (!trust?.first_session_at && !ms) return null;
  const t = trust?.first_session_at ?? ms;
  const d = new Date(Number(t));
  if (Number.isNaN(d.getTime())) return null;
  return d.toLocaleDateString('en-IN', { month: 'short', year: 'numeric' }).toUpperCase();
}
const hostSince = hostSinceLabel(listing.created_at ?? null);

const hostChips: string[] = [];
if (listing.rating_avg != null) hostChips.push(`★ ${Number(listing.rating_avg).toFixed(1)} HOST RATING`);
if (trust?.shows_hosted) hostChips.push(`${trust.shows_hosted} SHOWS`);
if (respMin != null) hostChips.push(`~${respMin} MIN REPLY`);

// ── Media ───────────────────────────────────────────────────────────────────
const covers = (listing.cover_media ?? []).filter((m): m is CoverMedia => !!m && typeof m === 'object' && !!(m.url || m.r2_key));
const posterUrl = covers[0]?.url ?? covers[0]?.r2_key ?? null;
const thumbUrls = covers.slice(1, 4).map((m) => m.url ?? m.r2_key ?? '').filter(Boolean);

function youtubeEmbedUrl(url?: string | null): string | null {
  if (!url) return null;
  try {
    const u = new URL(url);
    const host = u.hostname.replace(/^www\./, '').replace(/^m\./, '');
    let vid: string | null = null;
    if (host === 'youtu.be') vid = u.pathname.slice(1);
    else if (host === 'youtube.com') {
      if (u.pathname === '/watch') vid = u.searchParams.get('v');
      else if (u.pathname.startsWith('/embed/')) vid = u.pathname.slice('/embed/'.length);
      else if (u.pathname.startsWith('/shorts/')) vid = u.pathname.slice('/shorts/'.length);
    }
    vid = vid ? vid.split(/[?&]/)[0] : null;
    return vid && /^[\w-]{6,20}$/.test(vid) ? `https://www.youtube-nocookie.com/embed/${vid}` : null;
  } catch { return null; }
}
const videoEmbed = youtubeEmbedUrl(listing.video_url);

// ── Live band / countdown ───────────────────────────────────────────────────
function toMs(t?: number | null): number | null { if (t == null) return null; return t < 1e12 ? t * 1000 : t; }
const startMs = toMs(listing.starts_at);
const endMs = toMs(listing.ends_at);
function formatStartsAt(ms: number | null): string | null {
  if (ms == null) return null;
  const d = new Date(ms);
  if (Number.isNaN(d.getTime())) return null;
  return `${d.toLocaleDateString('en-IN', { weekday: 'short' })}, ${d.toLocaleString('en-IN', { dateStyle: 'medium', timeStyle: 'short' })}`;
}
const startsAtLabel = formatStartsAt(startMs);

// ── Chips / facts ────────────────────────────────────────────────────────────
const langTag = languageLabel(listing.spoken_lang ?? null);
const durationTag = durationLabel(listing.duration_min ?? null);
const attrs = (listing.attrs ?? {}) as Record<string, unknown>;
const howItWorks = Array.isArray(attrs.content_how_it_works) ? (attrs.content_how_it_works as { label: string; body: string }[]) : [];
const houseRulesList = Array.isArray(attrs.content_house_rules) ? (attrs.content_house_rules as { heading: string; body: string }[]) : [];
const houseRulesIntro = typeof attrs.content_house_rules_intro === 'string' ? attrs.content_house_rules_intro : null;
const whatYouGet = Array.isArray(attrs.content_what_you_get) ? (attrs.content_what_you_get as string[]) : [];
const whoFor = Array.isArray(attrs.content_who_for) ? (attrs.content_who_for as string[]) : [];
const notFor = Array.isArray(attrs.content_not_for) ? (attrs.content_not_for as string[]) : [];
const faq = Array.isArray(attrs.content_faq) ? (attrs.content_faq as { q: string; a: string }[]) : [];
const sampleQa = Array.isArray(attrs.content_sample_qa) ? (attrs.content_sample_qa as { q: string; a: string }[]) : [];
const sampleChat = Array.isArray(attrs.content_sample_chat) ? (attrs.content_sample_chat as { who: string; line: string }[]) : [];
const canDo = Array.isArray(attrs.content_can_do) ? (attrs.content_can_do as string[]) : [];
const cantDo = Array.isArray(attrs.content_cant_do) ? (attrs.content_cant_do as string[]) : [];
const credential = typeof listing.credential === 'string' ? listing.credential : null;
const joinLeadMinutes = Number.isFinite(Number(attrs.content_join_lead_minutes)) ? Number(attrs.content_join_lead_minutes) : null;

function cancellationHours(): number | null {
  const a = Number(attrs.commercial_refund_window_hours);
  if (Number.isFinite(a)) return a;
  const b = Number(attrs.commercial_cancellation_window_hours);
  return Number.isFinite(b) ? b : null;
}
const refundHours = cancellationHours();
const isRefund = attrs.commercial_refund_window_hours != null;
const prepText = typeof attrs.commercial_preparation_instructions === 'string' ? attrs.commercial_preparation_instructions.trim() || null : null;

const price = listing.price ?? null;
const priceStr = isFreeEntry ? 'FREE' : inrOrFree(price ?? 0);
const billingSuffix: Record<string, string> = { minute: '/ MIN', '10min': '/ 10 MIN', chat: '/ CHAT', night: '/ NIGHT', game: '/ GAME', session: '' };
const priceLine = isFreeEntry ? null : `${priceStr} ${listing.billing_unit && billingSuffix[listing.billing_unit] ? billingSuffix[listing.billing_unit] : (durationTag ? `/ ${(listing.billing_unit ?? 'SEAT').toUpperCase()}` : '')}`.trim();

const seatsLeft = listing.seats_left ?? null;
const freeSpotsLeft = listing.capacity != null && listing.seats_taken != null
  ? Math.max(0, listing.capacity - listing.seats_taken)
  : (listing.seats_left ?? null);

const detailUrl = new URL(Astro.request.url);
detailUrl.search = '';
const shareUrl = detailUrl.href;

// ── Eyebrow line: "01 · GROUP SHOWS · TICKETED · WEEKLY" style tag row ─────
const eyebrowParts = [listing.category, isFreeEntry ? 'FREE' : 'TICKETED', listing.schedule_mode === 'recurring' ? 'WEEKLY' : null]
  .filter((s): s is string => !!s)
  .map((s) => s.toUpperCase());

const hasVideo = !!videoEmbed;
const sectionCount = [
  !!creator, howItWorks.length > 0, houseRulesList.length > 0, !!listing.description, hasVideo, (reviewList?.total ?? 0) > 0,
].filter(Boolean).length;
const listingViewProps = {
  listing_id: id, kind, free_entry: isFreeEntry,
  status: (listing as { status?: string | null }).status ?? null,
  seats_left: seatsLeft, has_video: hasVideo, section_count: sectionCount,
};
---

<div class="listing-page" data-listing-id={id}>
  {isOwner && (
    <div class="owner-bar">
      <span>You own this listing</span>
      <a href={`/dashboard/listings/new?id=${encodeURIComponent(id)}`} data-cta="edit_listing">Edit listing →</a>
    </div>
  )}

  <div class="breadcrumb">
    <span>BAZAAR {listing.section ? `› ${String(listing.section).toUpperCase()}` : ''} › {listing.title.toUpperCase()}</span>
    <span class="listing-num">LISTING #{id.slice(0, 8).toUpperCase()}</span>
  </div>

  {isLive && (
    <div class="live-band" data-section="live_band">
      <span class="live-dot"></span>
      <span>LIVE NOW</span>
      {listing.watching != null && <span>· {listing.watching} WATCHING</span>}
      {endMs && <span>· ENDS {new Date(endMs).toLocaleTimeString('en-IN', { hour: 'numeric', minute: '2-digit' })}</span>}
      <a href={`/watch/${encodeURIComponent(id)}`} class="join-now" data-cta="join_now">JOIN NOW</a>
    </div>
  )}

  <div class="layout-grid">
    <!-- LEFT COLUMN -->
    <div class="left-col">
      <div class="plate-strip">{kind.toUpperCase()} · {id.slice(0, 6).toUpperCase()}</div>

      <div class="stage-card">
        {isLive && videoEmbed ? (
          <div class="stage-media" data-video-block>
            <iframe src={videoEmbed} title={`${listing.title} — live`} allow="encrypted-media; picture-in-picture" allowfullscreen />
          </div>
        ) : posterUrl ? (
          <div class="stage-media">
            <img src={cfImage(posterUrl, { width: 900, fit: 'cover' })} alt={listing.title} data-gallery-open />
          </div>
        ) : (
          <div class="stage-media stage-placeholder" aria-hidden="true"></div>
        )}
        <div class="stage-pills">
          {isLive && <span class="pill pill-live">LIVE NOW</span>}
          {isLive && listing.watching != null && <span class="pill">{listing.watching} WATCHING</span>}
          {(listing.joined_count ?? 0) > 0 && <span class="pill">{listing.joined_count} BOOKED</span>}
        </div>
        <div class="stage-actions">
          <button type="button" class="icon-btn" id="share-toggle" aria-label="Share">⤴</button>
          <button type="button" class="icon-btn" id="fav-toggle" aria-label="Favourite">♡</button>
        </div>
      </div>

      {creator && (
        <div class="host-line">
          <Avatar src={creatorAvatarUrl} name={creatorName} size={32} />
          <span class="host-line-name">{creatorName}</span>
          {!isAgent && creator.kyc_verified && <span class="kyc-tick">✓</span>}
          {hostSince && <span class="host-line-dot">· HOST SINCE {hostSince}</span>}
          {respMin != null && <span class="host-line-dot">· REPLIES IN ~{respMin} MIN</span>}
        </div>
      )}

      {thumbUrls.length > 0 && (
        <div class="thumb-row">
          {thumbUrls.map((u) => (
            <img src={cfImage(u, { width: 200, fit: 'cover' })} alt="" class="thumb" data-gallery-open />
          ))}
          {videoEmbed && !isLive && <div class="thumb thumb-video">▶</div>}
        </div>
      )}

      <div class="share-box" data-section="share">
        <h2 class="eyebrow">{shareCopy.title}</h2>
        <div class="share-box-row">
          <ShareBoxIsland client:load listingId={id} url={shareUrl} title={listing.title} />
          <QrCodeIsland client:visible url={shareUrl} />
        </div>
      </div>
    </div>

    <!-- RIGHT COLUMN -->
    <div class="right-col">
      {eyebrowParts.length > 0 && <div class="eyebrow-tag">{eyebrowParts.join(' · ')}</div>}
      <h1 class="listing-title">
        {titleAccent ? (
          <>{titleLead} <span class="title-accent">{titleAccent}</span></>
        ) : (
          listing.title
        )}
      </h1>

      <div class="chip-row">
        {listing.rating_avg != null && (
          <span class="chip">★ {Number(listing.rating_avg).toFixed(1)}{listing.review_count ? ` · ${listing.review_count}` : ''}</span>
        )}
        {(listing.creator?.follower_count ?? 0) > 0 && <span class="chip">♡ {listing.creator!.follower_count} REGULARS</span>}
        {durationTag && langTag && <span class="chip">{durationTag} · {langTag}</span>}
        {!durationTag && langTag && <span class="chip">{langTag}</span>}
        <span class="chip chip-strong">{listing.adults_only ? '18+' : '✓ 100% REAL HUMAN · NO AI'}</span>
        {isAgent && <span class="chip chip-ai">AI VOICE AGENT</span>}
      </div>

      {(listing.blurb || listing.description) && <p class="blurb">{listing.blurb || listing.description}</p>}

      {(listing.joined_count || seatsLeft != null || trust?.shows_hosted || trust?.comeback_pct != null) && (
        <div class="stats-board" data-section="stats">
          {listing.joined_count != null && <div><b>{listing.joined_count}</b><span>BOOKED</span></div>}
          {isLive && listing.watching != null && <div><b>{listing.watching}</b><span>WATCHING</span></div>}
          {trust?.shows_hosted != null && trust.shows_hosted > 0 && <div><b>{trust.shows_hosted}</b><span>SHOWS HOSTED</span></div>}
          {trust?.comeback_pct != null && <div><b>{Math.round(trust.comeback_pct)}%</b><span>COME BACK</span></div>}
        </div>
      )}

      {priceLine && (
        <p class="price-line">{priceLine} · <span class="price-note">FEES &amp; GST SHOWN BEFORE YOU BOOK</span></p>
      )}
      {isFreeEntry && <p class="price-line">FREE · {freeBox.hostPays}</p>}

      {whatYouGet.length > 0 && (
        <div class="what-you-get" data-section="what_you_get">
          <h2 class="eyebrow">WHAT YOU GET</h2>
          <ul>{whatYouGet.map((s) => <li>{s}</li>)}</ul>
        </div>
      )}
      {(whoFor.length > 0 || notFor.length > 0) && (
        <div class="who-for-grid">
          {whoFor.length > 0 && <div><h3>THIS IS FOR</h3><ul>{whoFor.map((s) => <li>{s}</li>)}</ul></div>}
          {notFor.length > 0 && <div><h3>NOT FOR</h3><ul>{notFor.map((s) => <li>{s}</li>)}</ul></div>}
        </div>
      )}

      {layout === 'agent' && (canDo.length > 0 || cantDo.length > 0) && (
        <div class="who-for-grid" data-section="agent_honesty">
          {canDo.length > 0 && <div><h3>SHE CAN</h3><ul>{canDo.map((s) => <li>{s}</li>)}</ul></div>}
          {cantDo.length > 0 && <div><h3>SHE CAN'T</h3><ul>{cantDo.map((s) => <li>{s}</li>)}</ul></div>}
        </div>
      )}

      {layout === 'agent' && sampleChat.length > 0 && (
        <div class="sample-chat" data-section="sample_chat">
          <h2 class="eyebrow">SAMPLE CHAT</h2>
          {sampleChat.slice(0, 6).map((m) => (
            <div class={`chat-line ${m.who === 'agent' ? 'chat-agent' : 'chat-user'}`}>{m.line}</div>
          ))}
        </div>
      )}

      {layout === 'consult' && credential && creator?.kyc_verified && (
        <p class="credential-line">{credential}</p>
      )}
      {layout === 'consult' && prepText && (
        <div class="prep-box" data-section="prep">
          <h2 class="eyebrow">WHAT WE'LL COVER</h2>
          <p>{prepText}</p>
        </div>
      )}
      {layout === 'consult' && sampleQa.length > 0 && (
        <div class="sample-qa" data-section="sample_qa">
          <h2 class="eyebrow">SAMPLE Q&amp;A</h2>
          {sampleQa.slice(0, 3).map((qa) => (
            <div class="qa-pair"><p class="qa-q">Q. {qa.q}</p><p class="qa-a">A. {qa.a}</p></div>
          ))}
        </div>
      )}
    </div>
  </div>

  {howItWorks.length > 0 && (
    <section class="how-it-works" data-section="how_it_works">
      <h2 class="section-title">{sectionTitles.howItWorks}</h2>
      <div class="step-grid">
        {howItWorks.map((s, i) => (
          <div class="step-card">
            <span class="step-num">{i + 1}</span>
            <h3>{s.label}</h3>
            <p>{s.body}</p>
          </div>
        ))}
      </div>
    </section>
  )}

  {creator && (
    <HostCard
      creator={creator}
      creatorSlug={creatorSlug}
      avatarUrl={creatorAvatarUrl}
      city={listing.location}
      bio={null}
      chips={hostChips}
      isAgent={isAgent}
      hostSinceLabel={hostSince}
      trust={trust}
    />
  )}

  {creator && !isOwner && !isAgent && (
    <AskHostIsland client:visible listingId={id} hostName={hostFirstName} />
  )}

  {(houseRulesList.length > 0 || houseRulesIntro) && (
    <section class="house-rules" data-section="house_rules">
      <h2 class="section-title">{houseRules.title}</h2>
      {houseRulesIntro && <p class="rules-intro">"{houseRulesIntro}"</p>}
      <div class="rules-grid">
        {houseRulesList.map((r, i) => (
          <div class="rule-card"><span class="rule-num">{i + 1}</span><h3>{r.heading}</h3><p>{r.body}</p></div>
        ))}
      </div>
      <p class="rules-baseline">{houseRules.platformBaseline}</p>
    </section>
  )}

  {faq.length > 0 && (
    <section class="faq" data-section="faq">
      <h2 class="section-title">FAQ</h2>
      <div class="faq-list">
        {faq.map((f) => (
          <details class="faq-item"><summary>{f.q}</summary><p>{f.a}</p></details>
        ))}
      </div>
    </section>
  )}

  <ReviewsSection listingId={id} reviewList={reviewList} />

  <PromisesBand refundHours={isRefund ? refundHours : null} cancelHours={!isRefund ? refundHours : null} />

  <BrowseMore cards={browseMore} excludeId={id} />

  <!-- Sticky booking box (rendered inline in flow on mobile; sticky on desktop via CSS) -->
  <aside class="booking-sticky" data-section="booking_box">
    <BookingBoxIsland
      client:load
      listingId={id}
      kind={kind}
      isLive={isLive}
      isFreeEntry={isFreeEntry}
      price={price}
      maxPerBooking={listing.max_per_booking ?? 4}
      watching={listing.watching ?? null}
      seatsLeft={seatsLeft}
      freeSpotsLeft={freeSpotsLeft}
      startsAtLabel={startsAtLabel}
      startsAtMs={startMs}
      timezone={listing.timezone ?? null}
      slots={slots}
      joinLeadMinutes={joinLeadMinutes}
      recurrenceDays={listing.recurrence_days ?? null}
      scheduleMode={listing.schedule_mode ?? null}
    />
  </aside>
</div>

<script define:vars={{ listingViewProps }}>
  // [WEB-POSTHOG-1] §2.4 listing_view / listing_section_view / listing_cta_click /
  // listing_gallery_open / listing_video_play. Contract:
  // Specs/SPEC-2026-09-02-TELEMETRY-CATALOG.md §2.4.
  import('../lib/analytics').then(({ capture }) => {
    capture('listing_view', listingViewProps);
    if (listingViewProps.kind) capture('creator_view', { listing_id: listingViewProps.listing_id });

    const seenSections = new Set();
    const sectionObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const section = entry.target.getAttribute('data-section');
          if (!section || seenSections.has(section)) continue;
          seenSections.add(section);
          capture('listing_section_view', { section, listing_id: listingViewProps.listing_id });
          sectionObserver.unobserve(entry.target);
        }
      },
      { threshold: 0.4 },
    );
    document.querySelectorAll('[data-section]').forEach((el) => sectionObserver.observe(el));

    document.querySelectorAll('[data-cta]').forEach((el) => {
      el.addEventListener('click', () => {
        capture('listing_cta_click', { cta: el.getAttribute('data-cta'), listing_id: listingViewProps.listing_id });
      });
    });

    document.querySelectorAll('[data-gallery-open]').forEach((el) => {
      el.addEventListener('click', () => capture('listing_gallery_open', { listing_id: listingViewProps.listing_id }));
    });

    let videoFired = false;
    const fireVideoPlay = () => {
      if (videoFired) return;
      videoFired = true;
      capture('listing_video_play', { listing_id: listingViewProps.listing_id });
    };
    const videoBlock = document.querySelector('[data-video-block]');
    if (videoBlock) {
      const vo = new IntersectionObserver((entries) => {
        for (const entry of entries) if (entry.isIntersecting) { fireVideoPlay(); vo.disconnect(); }
      }, { threshold: 0.6 });
      vo.observe(videoBlock);
    }
  });
</script>

<style>
  .listing-page {
    max-width: 1200px; margin: 0 auto; padding: 20px 16px 80px;
    display: flex; flex-direction: column; gap: 28px;
