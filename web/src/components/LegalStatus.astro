---
/*
 * LegalStatus — the single source of truth for who operates Saa Thum.
 *
 * This component is the single source of truth for the companies behind
 * Saa Thum. Every legal page imports it so the disclosure stays consistent
 * across the site.
 *
 * `variant`:
 *   'full'  — who we are + current status + address. Use on terms, privacy,
 *             about, refunds and the other commerce/policy pages.
 *   'who'   — who we are + address only. For pages that already describe the
 *             testing stage in their own words.
 *   'short' — one paragraph, for pages where the block would crowd the page.
 */
export interface Props {
  variant?: 'full' | 'who' | 'short';
  heading?: string;
}

import { ORG } from '../lib/org';

const { variant = 'full', heading } = Astro.props;
---

{heading && <h2 id="status">{heading}</h2>}

{/* [WEB-SEO-REBRAND-1 2026-09-27] OWNER DECISION: one statement, matching /about.
    No company name, no foreign entity, no US/Delaware address. Update here (and
    org.ts) only when an Indian company is actually registered. */}
<div class="note" id={heading ? undefined : 'status'}>
  <p>
    <strong>Who we are.</strong> Saa Thum (saathum.com) is run by a small team in
    West Andheri, Mumbai, India. We work with temple priests who perform pujas and
    havans for families anywhere in the world, who receive the video afterwards.
  </p>
  {variant !== 'short' && (
    <p style="margin-top:12px">
      <strong>Contact.</strong> {ORG.email.replace('@', ' (@) ')} (support and billing) ·
      hello (@) saathum.com (general enquiries) · privacy (@) saathum.com (privacy).
    </p>
  )}
</div>
