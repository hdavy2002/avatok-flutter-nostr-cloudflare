---
/*
 * LegalStatus — the single source of truth for who operates Saa Thum.
 *
 * This component is the single source of truth for the companies behind
 * Saa Thum. Every legal page imports it so the disclosure stays consistent
 * across the site.
 *
 * `variant`:
 *   'full'  — who we are + current status + address. Use on terms, privacy,
 *             about, refunds and the other commerce/policy pages.
 *   'who'   — who we are + address only. For pages that already describe the
 *             testing stage in their own words.
 *   'short' — one paragraph, for pages where the block would crowd the page.
 */
export interface Props {
  variant?: 'full' | 'who' | 'short';
  heading?: string;
}

import { ORG } from '../lib/org';

const { variant = 'full', heading } = Astro.props;
---

{heading && <h2 id="status">{heading}</h2>}

<div class="note" id={heading ? undefined : 'status'}>
  {variant === 'short' ? (
    <p>
      <ui-copy style="display:inline" data-i18n="web-common.0f8ef52b8743d566">Saa Thum is built and operated through</ui-copy>{' '}
      <strong>{ORG.legalName}</strong><ui-copy style="display:inline" data-i18n="web-common.c8dc98e3e76b237a">. The service is
      being developed and expanded globally. Contact:</ui-copy>
      {ORG.email.replace('@', ' (@) ')}.
    </p>
  ) : (
    <Fragment>
      <p>
        <strong data-i18n="web-common.111d670158826d45">Who you are dealing with.</strong>{' '}<ui-copy style="display:inline">Saa Thum is the puja and havan service brand of</ui-copy>{' '}
        <strong>{ORG.legalName}</strong><ui-copy style="display:inline" data-i18n="web-common.92be743e72be1116">,
        and the global headquarters of Saa Thum.</ui-copy>
      </p>
      <p style="margin-top:12px">
        <strong data-i18n="web-common.d3bcb3151962cd25">Our legal entity.</strong>{' '}{ORG.legalName}{' '}<ui-copy style="display:inline" data-i18n="web-common.4f0efbd0c721c459">is registered in Delaware.
        The public registered-agent address is</ui-copy>{' '}{ORG.address.street}, {ORG.address.locality},
        {ORG.address.region}{' '}{ORG.address.postalCode}<ui-copy style="display:inline" data-i18n="web-common.12a81824123d9b3a">. For general and investor enquiries,
        write to</ui-copy>{' '}hello (@) saathum.com.
      </p>
      <p style="margin-top:12px">
        <strong data-i18n="web-common.4a9f7bc8b5d34e21">India.</strong>{' '}{ORG.indianEntity.name}{' '}
        <ui-copy style="display:inline" data-i18n="web-common.7b8c6d5e4f3a2910">An Indian subsidiary is being incorporated in Mumbai; its details will be published here once registered.</ui-copy>
      </p>

      {variant === 'full' && (
        <p style="margin-top:12px">
          <strong data-i18n="web-common.10e95e374afe1262">The site is evolving.</strong>{' '}<ui-copy style="display:inline" data-i18n="web-common.9293a402b5bac613">Features may change, be paused, or be
          removed as we expand the service. Prices, fees and token values shown on the
          site are subject to the applicable product terms.</ui-copy>
        </p>
      )}

      <p style="margin-top:12px">
        <strong data-i18n="web-common.fe2a3ce339afe0a0">Registered office.</strong>{' '}{ORG.address.street}, {ORG.address.locality},
        {ORG.address.region}{' '}{ORG.address.postalCode}<ui-copy style="display:inline" data-i18n="web-common.6ce614f2ee8cbd80">, United States.</ui-copy><br />
        <strong data-i18n="web-common.b30d6d5e28d714c8">Contact.</strong>{' '}{ORG.email.replace('@', ' (@) ')}{' '}
        <ui-copy style="display:inline" data-i18n="web-common.1e2754fc6999db70">(support and billing) ·</ui-copy>{' '}hello (@) saathum.com{' '}
        <ui-copy style="display:inline" data-i18n="web-common.e355f15f55aecab4">(general and investor enquiries) ·</ui-copy>{' '}
        privacy (@) saathum.com{' '}<ui-copy style="display:inline" data-i18n="web-common.a3496efa95e8fcbd">(privacy).</ui-copy>
      </p>
    </Fragment>
  )}
</div>
