---
/*
 * LegalStatus — the single source of truth for who operates avaTOK.
 *
 * This component is the single source of truth for the registered Delaware
 * corporation behind avaTOK. Every legal page imports it so the disclosure
 * stays consistent across the site.
 *
 * `variant`:
 *   'full'  — who we are + current status + address. Use on terms, privacy,
 *             about, refunds and the other commerce/policy pages.
 *   'who'   — who we are + address only. For pages that already describe the
 *             testing stage in their own words.
 *   'short' — one paragraph, for pages where the block would crowd the page.
 */
export interface Props {
  variant?: 'full' | 'who' | 'short';
  heading?: string;
}

import { ORG } from '../lib/org';

const { variant = 'full', heading } = Astro.props;
---

{heading && <h2 id="status">{heading}</h2>}

<div class="note" id={heading ? undefined : 'status'}>
  {variant === 'short' ? (
    <p>
      avaTOK is built and operated by American and Indian founders through
      <strong>{ORG.legalName}</strong>, a Delaware corporation. The service is
      being developed and expanded globally. Contact:
      <a href={`mailto:${ORG.email}`}>{ORG.email}</a>.
    </p>
  ) : (
    <Fragment>
      <p>
        <strong>Who you are dealing with.</strong> avaTOK is the platform brand of
        <strong>{ORG.legalName}</strong>, a domestic Delaware corporation founded by
        American and Indian founders.
      </p>
      <p style="margin-top:12px">
        <strong>Our legal entity.</strong> {ORG.legalName} is registered in Delaware.
        The public registered-agent address is {ORG.address.street}, {ORG.address.locality},
        {ORG.address.region} {ORG.address.postalCode}. For general and investor enquiries,
        write to <a href="mailto:hello@avatok.ai">hello@avatok.ai</a>.
      </p>

      {variant === 'full' && (
        <p style="margin-top:12px">
          <strong>The site is evolving.</strong> Features may change, be paused, or be
          removed as we expand the service. Prices, fees and token values shown on the
          site are subject to the applicable product terms.
        </p>
      )}

      <p style="margin-top:12px">
        <strong>Registered office.</strong> {ORG.address.street}, {ORG.address.locality},
        {ORG.address.region} {ORG.address.postalCode}, United States.<br />
        <strong>Contact.</strong> <a href={`mailto:${ORG.email}`}>{ORG.email}</a>
        (support and billing) · <a href="mailto:hello@avatok.ai">hello@avatok.ai</a>
        (general and investor enquiries) ·
        <a href="mailto:privacy@avatok.ai">privacy@avatok.ai</a> (privacy).
      </p>
    </Fragment>
  )}
</div>
