---
/*
 * LegalStatus — the single source of truth for who operates avaTOK.
 *
 * This component is the single source of truth for the companies behind
 * avaTOK. Every legal page imports it so the disclosure stays consistent
 * across the site.
 *
 * `variant`:
 *   'full'  — who we are + current status + address. Use on terms, privacy,
 *             about, refunds and the other commerce/policy pages.
 *   'who'   — who we are + address only. For pages that already describe the
 *             testing stage in their own words.
 *   'short' — one paragraph, for pages where the block would crowd the page.
 */
export interface Props {
  variant?: 'full' | 'who' | 'short';
  heading?: string;
}

import { ORG } from '../lib/org';

const { variant = 'full', heading } = Astro.props;
---

{heading && <h2 id="status">{heading}</h2>}

<div class="note" id={heading ? undefined : 'status'}>
  {variant === 'short' ? (
    <p>
      <ui-copy style="display:inline" data-i18n="web-common.0f8ef52b8743d566">avaTOK is built and operated by</ui-copy>{' '}
      <strong>{ORG.legalName}</strong><ui-copy style="display:inline" data-i18n="web-common.c8dc98e3e76b237a">, a Delaware corporation. The service is
      being developed and expanded globally. Contact:</ui-copy>
      <a href={`mailto:${ORG.email}`}>{ORG.email}</a>.
    </p>
  ) : (
    <Fragment>
      <p>
        <strong data-i18n="web-common.111d670158826d45">Who you are dealing with.</strong>{' '}<ui-copy style="display:inline" data-i18n="web-common.b47db0c3cd5c3c93">avaTOK is the platform brand of</ui-copy>{' '}
        <strong>{ORG.legalName}</strong><ui-copy style="display:inline" data-i18n="web-common.92be743e72be1116">, a domestic Delaware corporation and the
        global headquarters of avaTOK.</ui-copy>{' '}<ui-copy style="display:inline" data-i18n="web-common.4a9f7bc8b5d34e21">{ORG.indiaSubsidiaryNote}</ui-copy>
      </p>
      <p style="margin-top:12px">
        <strong data-i18n="web-common.fe2a3ce339afe0a0">Registered office.</strong>{' '}{ORG.address.street}, {ORG.address.locality},
        {ORG.address.region}{' '}{ORG.address.postalCode}<ui-copy style="display:inline" data-i18n="web-common.6ce614f2ee8cbd80">, United States.</ui-copy><br />
        <strong data-i18n="web-common.b30d6d5e28d714c8">Contact.</strong>{' '}<a href={`mailto:${ORG.email}`}>{ORG.email}</a>{' '}
        <ui-copy style="display:inline" data-i18n="web-common.1e2754fc6999db70">(support and billing) ·</ui-copy>{' '}<a href="mailto:hello@avatok.ai">hello@avatok.ai</a>{' '}
        <ui-copy style="display:inline" data-i18n="web-common.e355f15f55aecab4">(general and investor enquiries) ·</ui-copy>{' '}
        <a href="mailto:privacy@avatok.ai">privacy@avatok.ai</a>{' '}<ui-copy style="display:inline" data-i18n="web-common.a3496efa95e8fcbd">(privacy).</ui-copy>
      </p>
    </Fragment>
  )}
</div>
