---
// [HF-MERCH-FAN-WEB-1] "Merch" strip on /h/<slug>, under the call booking. Rendered only when the merch feature is on and the
// influencer has live products (the caller passes null otherwise). Product cards are plain links so search and AI crawlers see them.
// Telemetry: merch_strip_viewed (once, when it scrolls into view).
import ShareButtons from './ShareButtons.astro';
import { rupees, type PublicProduct } from '../../lib/merchPublic';
import { BRAND } from '../../lib/brand';
import { publicImage } from '../../lib/config';
interface Props { host: { slug: string; displayName: string }; products: PublicProduct[] }
const { host, products } = Astro.props;
const pageUrl = new URL(`/h/${host.slug}`, BRAND.webOrigin).toString();
---
<section class="hfm-strip" id="merch" aria-labelledby="merch-heading" data-hfm-strip data-host={host.slug} data-count={products.length}>
  <div class="hfm-strip-head">
    <div>
      <h2 id="merch-heading">{host.displayName}’s <em>merch</em></h2>
      <p class="hfm-sub">T-shirts printed to order · Free delivery across India</p>
    </div>
    <ShareButtons url={pageUrl} text={`${host.displayName}’s merch`} surface="strip" hostSlug={host.slug} />
  </div>
  <ul class="hfm-strip-list">
    {products.map((p, i) => (
      <li>
        <a class="hfm-card" href={`/h/${host.slug}/merch/${p.slug}`} data-hfm-card={p.slug}>
          <span class="ph">{p.imageUrl ? <img src={publicImage(p.imageUrl, { width: 400 })} alt={`${p.title} T-shirt by ${host.displayName}`} width="200" height="200" loading={i < 2 ? 'eager' : 'lazy'} decoding="async" /> : null}</span>
          <b>{p.title}</b>
          <span class="pr">From {rupees(p.fromPricePaise)}</span>
          <small class="pr-note">incl. GST &amp; free delivery</small>
        </a>
      </li>
    ))}
  </ul>
</section>
<script>
  import { capture } from '../../lib/analytics';
  const el = document.querySelector<HTMLElement>('[data-hfm-strip]');
  if (el) {
    const fire = () => capture('merch_strip_viewed', { host_slug: el.dataset.host, products: Number(el.dataset.count) || 0 });
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(entries => { if (entries.some(e => e.isIntersecting)) { io.disconnect(); fire(); } }, { threshold: 0.4 });
      io.observe(el);
    } else fire();
  }
</script>
