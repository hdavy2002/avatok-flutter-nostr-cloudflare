---
// [WEB-HELP-2 2026-09-11] The full-bleed help-centre hero, replacing the
// boxed `<Content>` header the owner rejected (see pages/help/index.astro's
// top comment). Lifted from design/help-centre/Main.dc.html (desktop) and
// Phone.dc.html (<1024px): a terracotta band bordered by the real
// TruckBorder "tassels" strip, the display headline with the hard-shadow
// "works." reveal, the lead, the big HelpSearch (size="hero"), and the
// STD/ISD/PCO signboard art tilted like a listing-tile photo with the
// sneakers-saree cut-out sticker layered on top — sticker hidden below
// 1024px per the comp (Phone.dc.html never references sneakers-saree.png
// at all), where the signboard shrinks and moves inline next to the lead.
//
// Colour/type tokens come from the scoped custom-property block
// pages/help/index.astro defines on `.help-page` (mirrors what
// layouts/Content.astro used to supply — HelpSearch's own styles already
// read var(--white)/var(--ink)/var(--blue)/var(--paper)/var(--sky), so this
// page has to keep providing those same names now that Content.astro is no
// longer the wrapper).
import TruckBorder from '../TruckBorder.astro';
import HelpSearch from '../HelpSearch.astro';
---

<section class="help-hero">
  <TruckBorder kind="tassels" />
  <div class="help-hero-inner">
    <div class="help-hero-copy">
      <p class="help-hero-eyebrow"><span class="dot" aria-hidden="true"></span>Help centre</p>
      <h1 class="help-hero-title">
        How avaTOK<br /><span class="help-hero-title-hit">works.</span>
      </h1>
      <div class="help-hero-lead-row">
        <p class="help-hero-lead">
          Plain-English answers to how booking, paying, creating and getting paid actually work on avaTOK.
        </p>
        {/* [WEB-HELP-2] Phone.dc.html scale — shown only below 1024px, next
            to the lead rather than in the standalone art block. */}
        {/* [WEB-HELP-2 review] alt="" — decorative, like the desktop copy
            below: the signboard sets a tone the eyebrow/heading already
            state in words, unlike HelpTiles' art, which stays meaningfully
            described since it's the only visual cue for each section. */}
        <img
          class="help-hero-signboard help-hero-signboard-inline"
          src="/help/art/std-isd-pco.jpg"
          alt=""
          width="506"
          height="900"
          loading="eager"
        />
      </div>
      <div class="help-hero-search">
        <HelpSearch variant="hero" size="hero" id="hero" />
      </div>
      <p class="help-hero-browse">Or browse the five topics below</p>
    </div>
    <div class="help-hero-art" aria-hidden="true">
      <img
        class="help-hero-signboard help-hero-signboard-desktop"
        src="/help/art/std-isd-pco.jpg"
        alt=""
        width="506"
        height="900"
        loading="eager"
        fetchpriority="high"
      />
      <img
        class="help-hero-sticker"
        src="/help/art/sneakers-saree.png"
        alt=""
        width="300"
        height="453"
        loading="lazy"
      />
    </div>
  </div>
</section>

<style>
  .help-hero {
    position: relative;
    background: var(--zine-terracotta); /* mockup #d46e59, same value */
    border-top: 0.1875rem solid var(--ink);
    border-bottom: 0.1875rem solid var(--ink);
  }
  .help-hero-inner {
    max-width: 110rem;
    margin: 0 auto;
    padding: 1.75rem 2.5rem 7rem;
    display: flex;
    align-items: center;
    gap: 3rem;
  }
  .help-hero-copy { flex: 1 1 0; min-width: 0; display: flex; flex-direction: column; }
  .help-hero-eyebrow {
    margin: 0 0 1rem;
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-family: var(--sans-label);
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--zine-terracottaBody); /* [WEB-HELP-2 review] was --zine-terracottaInk (#4a1b12) — small text on the terracotta band needs the darker of the two mockup inks for contrast */
  }
  .help-hero-eyebrow .dot { display: block; width: 0.625rem; height: 0.625rem; border-radius: 50%; background: var(--red); flex: none; }
  .help-hero-title {
    margin: 0;
    font-family: var(--display);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.055em;
    word-spacing: 0.2em;
    font-size: 5.5rem;
    line-height: 1.12;
    color: var(--ink);
  }
  .help-hero-title-hit { color: var(--white); text-shadow: 0.375rem 0.375rem 0 var(--ink); }
  .help-hero-lead-row { display: flex; align-items: center; gap: 1.125rem; }
  .help-hero-lead {
    flex: 1;
    min-width: 0;
    margin: 1.5rem 0 0;
    max-width: 50ch;
    font-family: var(--sans);
    font-size: 1.1875rem;
    font-weight: 500;
    line-height: 1.5;
    color: var(--zine-terracottaBody); /* mockup #2a0f0a, same value */
    text-wrap: pretty;
  }
  .help-hero-search { margin-top: 2.25rem; max-width: 47.5rem; }
  .help-hero-browse {
    margin: 1.375rem 0 0;
    font-family: var(--sans-label);
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--zine-terracottaBody); /* [WEB-HELP-2 review] was --zine-terracottaInk, same contrast fix as the eyebrow above */
  }

  .help-hero-signboard {
    display: block;
    object-fit: cover;
    object-position: 50% 50%;
    border: 0.1875rem solid var(--ink);
    border-radius: 1.5rem;
    box-shadow: 0.375rem 0.4375rem 0 var(--ink);
    background: var(--white);
  }
  .help-hero-signboard-inline { display: none; }

  .help-hero-art { flex: none; position: relative; width: 33.75rem; height: 33.75rem; margin-right: 0.75rem; }
  .help-hero-signboard-desktop {
    position: absolute;
    right: 0.625rem;
    top: 0.375rem;
    width: 16.875rem;
    height: 30rem;
    transform: rotate(3deg);
  }
  .help-hero-sticker {
    position: absolute;
    left: 0;
    bottom: -1.125rem;
    width: 18.125rem;
    height: auto;
    transform: rotate(-3deg);
    filter: drop-shadow(0.375rem 0.4375rem 0 rgba(22, 22, 20, 0.55));
  }

  /* [WEB-HELP-2] Below 1024px the comp drops the standalone art block and
     the sticker entirely (Phone.dc.html never loads sneakers-saree.png —
     see this file's header comment) and puts a small signboard next to the
     lead paragraph instead. */
  @media (max-width: 1024px) {
    .help-hero-inner { flex-direction: column; align-items: stretch; gap: 0; padding: 1.125rem 1rem 4rem; }
    .help-hero-art { display: none; }
    /* [WEB-HELP-2 review] Only font-size shrinks at this width — CLAUDE.md's
       type rules fix display letter-spacing at 0.055em-0.07em and
       word-spacing at 0.2em-0.24em regardless of viewport (the un-cramped
       tracking is what keeps Comfortaa's letters from touching at ANY
       size); the previous 0.04em/0.12em mobile override undercut both
       floors. */
    .help-hero-title { font-size: clamp(2.5rem, 9vw, 3.5rem); }
    /* [WEB-HELP-2 review] The hard shadow scales down with the type here —
       6px reads as a smear rather than an offset print at ~40px, where the
       desktop rule's 88px headline earns the bigger 6px shadow. */
    .help-hero-title-hit { text-shadow: 0.1875rem 0.1875rem 0 var(--ink); }
    .help-hero-signboard-inline {
      display: block;
      flex: none;
      width: 6.5rem;
      height: 11.5625rem;
      border-radius: 1rem;
      box-shadow: 0.25rem 0.3125rem 0 var(--ink);
      transform: rotate(3deg);
      margin-right: 0.375rem;
    }
    .help-hero-search { margin-top: 1.5rem; max-width: none; }
  }
  @media (max-width: 480px) {
    .help-hero-lead-row { align-items: flex-start; }
    .help-hero-signboard-inline { width: 5.25rem; height: 9.375rem; }
  }
</style>
