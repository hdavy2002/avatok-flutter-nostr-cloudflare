---
// [WEB-HELP-2 2026-09-11] "On this page" anchor list for a help article —
// the right-hand column at >=1200px, and the collapsed <details> above the
// article at 1024-1199px (Help.astro renders this component in both spots
// from the same `headings` prop). Depth-2 headings only, matching the
// mockup (design/help-centre/Article.dc.html — it skips h3s). Help.astro
// already filters to depth===2 and only renders this component when there
// are >=2 of them; the filter is repeated here so the component is correct
// on its own if a future caller forgets that rule.
export interface Props {
  headings: { depth: number; slug: string; text: string }[];
}

const { headings } = Astro.props;
const items = headings.filter((h) => h.depth === 2);
---

{items.length >= 2 && (
  <nav class="help-otp" aria-label="On this page">
    <span class="help-otp-label">On this page</span>
    <ul>
      {items.map((h) => (
        <li>
          {/* [WEB-HELP-2] No SSR aria-current here — the "current section"
              dot is a scroll-spy affordance, not the page's real current
              state, so it's set only once IntersectionObserver has actually
              observed a heading in view (below). aria-current="location"
              (not "true") since this marks a scroll position within the
              page, not the page itself. */}
          <a href={`#${h.slug}`} data-help-otp-link data-slug={h.slug}>
            <span class="help-otp-dot" aria-hidden="true"></span>
            {h.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}

<style>
  .help-otp { display: flex; flex-direction: column; gap: 0.875rem; }
  .help-otp-label {
    font-family: var(--ava-font-stub);
    font-weight: 800;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ava-text-label);
  }
  .help-otp ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.75rem; }
  .help-otp a {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
    font-family: var(--ava-font-sans);
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.4;
    color: var(--ava-text-label);
    text-decoration: none;
  }
  .help-otp a:hover { color: var(--ava-ink); }
  .help-otp a:focus-visible { outline: var(--ava-focus-ring); outline-offset: var(--ava-focus-offset); border-radius: 0.25rem; }
  .help-otp-dot {
    display: block;
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    margin-top: 0.375rem;
    border-radius: 50%;
    border: 1.5px solid var(--ava-text-placeholder);
  }
  .help-otp a[aria-current='location'] {
    font-weight: 600;
    color: var(--ava-ink);
  }
  .help-otp a[aria-current='location'] .help-otp-dot {
    border-color: var(--ava-signal);
    background: var(--ava-signal);
  }
</style>

<script>
  // [WEB-HELP-2 2026-09-11] Progressive scroll-spy: highlights the heading
  // currently in view. No analytics — purely visual, mirrors the mockup's
  // "current section" dot. Astro dedupes this identical inline module script
  // across the two HelpOnThisPage instances a page can render (the 1024-1199
  // <details> copy and the >=1200 sidebar copy), so it runs once and updates
  // both sets of links together even though only one is ever visible via CSS.
  function initHelpOnThisPage() {
    const links = Array.from(
      document.querySelectorAll<HTMLAnchorElement>('[data-help-otp-link]'),
    );
    if (!links.length) return;

    const targets = links
      .map((a) => ({ a, el: document.getElementById(a.dataset.slug ?? '') }))
      .filter((t): t is { a: HTMLAnchorElement; el: HTMLElement } => !!t.el);
    if (!targets.length) return;

    const setActive = (slug: string) => {
      for (const a of links) {
        if (a.dataset.slug === slug) a.setAttribute('aria-current', 'location');
        else a.removeAttribute('aria-current');
      }
    };

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((x, y) => x.boundingClientRect.top - y.boundingClientRect.top);
        if (visible.length) setActive(visible[0].target.id);
      },
      // [WEB-HELP-2] IntersectionObserver's rootMargin must be px/%, never a
      // font-relative unit (rem/em) — the constructor throws otherwise. 6rem
      // is 96px at the root 16px size this project builds at.
      { rootMargin: '-96px 0px -70% 0px', threshold: 0 },
    );
    for (const t of targets) observer.observe(t.el);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHelpOnThisPage);
  } else {
    initHelpOnThisPage();
  }
</script>
