---
// [WEB-FOOTER-2 2026-08-26] Truck-art border strips, ported from the design
// kit's TruckBorder.dc.html so the site can use them without the Design
// Component runtime.
//
// Only the three kinds the footer needs are here (chai, auto, tassels). The kit
// also draws jhalar, lotus and eyes; add them from TruckBorder.dc.html if a
// page ever wants one, keeping the motif markup identical so the two stay in
// step.
//
// The motif is repeated `count` times and the row is centre-justified with
// overflow hidden, exactly as the kit does it — the strip is decorative and is
// meant to bleed off both edges at any width rather than tile to fit.
interface Props {
  kind: 'chai' | 'auto' | 'tassels' | 'jhalar';
  count?: number;
  class?: string;
}
const { kind, count = 40, class: className = '' } = Astro.props;
const items = Array.from({ length: count }, (_, i) => i);
// Tassel droppers alternate length so the row reads as hand-strung, not printed.
const tasselHeights = [10, 16, 12, 18];
---

<div class={`truck-border ${className}`} aria-hidden="true" style="width:100%; overflow:hidden;">
  {kind === 'jhalar' && (
    <div style="height:30px; background:#3a3a9e; box-shadow:inset 0 3px 0 #f0d018, inset 0 -3px 0 #f0d018; display:flex; justify-content:center; overflow:hidden;">
      {items.map(() => (
        <div style="flex:none; width:26px; height:16px; margin-top:3px; background:#d93825; border-radius:0 0 13px 13px; display:flex; justify-content:center; align-items:flex-start; padding-top:4px;"><span style="width:5px; height:5px; border-radius:50%; background:#f0d018; display:block;"></span></div>
      ))}
    </div>
  )}

  {kind === 'chai' && (
    <div style="height:32px; background:#3a3a9e; box-shadow:inset 0 -3px 0 #f0d018; display:flex; justify-content:center; align-items:center; gap:20px; overflow:hidden;">
      {items.map(() => (
        <div style="flex:none; width:27px; height:22px; position:relative;">
          <span style="position:absolute; right:0; bottom:6px; width:9px; height:9px; border:2.5px solid #fdf1d3; border-radius:50%; display:block;"></span>
          <span style="position:absolute; left:0; bottom:9px; width:9px; height:4px; background:#f0d018; transform:rotate(-32deg); border-radius:2px; display:block;"></span>
          <span style="position:absolute; left:9px; top:3px; width:7px; height:4px; background:#fdf1d3; border-radius:3px 3px 0 0; display:block;"></span>
          <span style="position:absolute; left:4px; bottom:1px; width:17px; height:14px; background:#f0d018; border-radius:4px 4px 8px 8px; display:grid; place-items:center;"><span style="width:5px; height:5px; border-radius:50%; background:#f03060; display:block;"></span></span>
        </div>
      ))}
    </div>
  )}

  {kind === 'auto' && (
    <div style="height:32px; background:#15773d; box-shadow:inset 0 -3px 0 #f0d018; display:flex; justify-content:center; align-items:flex-end; gap:22px; padding-bottom:4px; overflow:hidden;">
      {items.map(() => (
        <div style="flex:none; width:26px; height:22px; position:relative;">
          <span style="position:absolute; top:0; left:2px; width:20px; height:8px; background:#161614; border-radius:9px 9px 0 0; display:block;"></span>
          <span style="position:absolute; top:7px; left:2px; width:20px; height:9px; background:#f0d018; border-radius:1px 1px 3px 6px; display:grid; place-items:center;"><span style="width:6px; height:4px; background:#fdf1d3; border-radius:1px; display:block;"></span></span>
          <span style="position:absolute; top:9px; right:0; width:4px; height:4px; border-radius:50%; background:#d93825; display:block;"></span>
          <span style="position:absolute; bottom:0; left:4px; width:6px; height:6px; border-radius:50%; background:#161614; box-shadow:inset 0 0 0 1.5px #fdf1d3; display:block;"></span>
          <span style="position:absolute; bottom:0; right:5px; width:6px; height:6px; border-radius:50%; background:#161614; box-shadow:inset 0 0 0 1.5px #fdf1d3; display:block;"></span>
        </div>
      ))}
    </div>
  )}

  {kind === 'tassels' && (
    <div>
      <div style="height:9px; background:repeating-linear-gradient(90deg,#d93825 0 10px,#f0d018 10px 20px); border-bottom:2px solid #161614;"></div>
      <div style="height:34px; display:flex; justify-content:center; align-items:flex-start; gap:18px; overflow:hidden;">
        {items.map((i) => (
          <div style="flex:none; display:flex; flex-direction:column; align-items:center;">
            <span style={`width:2px; height:${tasselHeights[i % tasselHeights.length]}px; background:#f0d018; display:block;`}></span>
            <span style="width:8px; height:8px; border-radius:50%; background:#f0d018; border:1.5px solid #161614; display:block;"></span>
            <span style="width:10px; height:11px; background:#d93825; clip-path:polygon(50% 100%, 0 0, 100% 0); margin-top:1px; display:block;"></span>
          </div>
        ))}
      </div>
    </div>
  )}
</div>
