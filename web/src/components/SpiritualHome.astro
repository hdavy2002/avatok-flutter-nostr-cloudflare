---
import { publicImage } from '../lib/config';
import '../styles/spiritual-home.css';

type SpiritualListing = {
  name: string; place: string; guru: string; creator: string; when: string;
  type: string; purpose: string; price: string; joined: number; image: string; live?: boolean;
};

// SAMPLE DATA ONLY: these cards are realistic Hindu experiences used until the
// live marketplace feed is connected to the landing page.
const listings: SpiritualListing[] = [
  { name: 'Subah Ganga Aarti', place: 'Har Ki Pauri, Haridwar', guru: 'Acharya Devendra Joshi', creator: 'Ganga Seva Collective', when: 'LIVE NOW', type: 'Aarti & Darshan', purpose: 'Peace', price: '₹151 to join', joined: 84, image: '/assets/ideas/guides/subah-ki-aarti-card.jpg', live: true },
  { name: 'Rudrabhishek at Dawn', place: 'Kashi Vishwanath, Varanasi', guru: 'Pandit Raghav Shukla', creator: 'Kashi Live Darshan', when: 'Today · 6:30 AM IST', type: 'Puja & Havan', purpose: 'Health', price: '₹251 to join', joined: 42, image: '/assets/ideas/guides/mandir-se-live-darshan-card.jpg' },
  { name: 'Evening Satsang & Katha', place: 'Vrindavan Dham', guru: 'Sadhvi Meera Das', creator: 'Braj Bhakti Live', when: 'Today · 7:00 PM IST', type: 'Katha & Pravachan', purpose: 'Peace for ancestors', price: 'Free to watch', joined: 126, image: '/assets/ideas/guides/satsang-questions-card.jpg' },
  { name: 'Ganesh Havan for New Beginnings', place: 'Mahakaleshwar, Ujjain', guru: 'Pandit Nitin Vyas', creator: 'Ujjain Seva Network', when: 'Tomorrow · 8:00 AM IST', type: 'Puja & Havan', purpose: 'New beginnings', price: '₹201 to join', joined: 31, image: '/assets/ideas/guides/ganga-ghat-se-shaam-card.jpg' },
  { name: 'Guided Meditation by the Ganga', place: 'Rishikesh', guru: 'Acharya Kavita Sharma', creator: 'Rishikesh Stillness', when: 'Sat · 6:00 AM IST', type: 'Meditation', purpose: 'Peace', price: '₹101 to join', joined: 58, image: '/assets/ideas/guides/spiritual-conversation-card.jpg' },
  { name: 'Kedarnath Sankalp Darshan', place: 'Kedarnath Temple', guru: 'Rawal Seva Team', creator: 'Kedar Jyoti', when: 'Sun · 5:30 AM IST', type: 'Aarti & Darshan', purpose: 'Protection', price: '₹301 to join', joined: 97, image: '/assets/ideas/guides/bhajan-ki-mehfil-card.jpg' },
];
const purposeSections: Array<[string, string, SpiritualListing[]]> = [
  ['Health', 'For good health and wellbeing', listings.slice(0, 2)], ['Education and exams', 'For focus, learning and exams', listings.slice(1, 3)], ['Marriage and family', 'For harmony at home', listings.slice(2, 4)], ['Business and career', 'For courage at work and new opportunities', listings.slice(3, 5)], ['Peace for ancestors', 'For remembrance and shanti', listings.slice(0, 2)], ['Protection and obstacles', 'For strength through difficult times', listings.slice(4, 6)], ['New home and new beginnings', 'For a blessed beginning', listings.slice(2, 4)],
];
const typeSections: Array<[string, SpiritualListing[]]> = [['Puja and Havan', listings.slice(0, 3)], ['Aarti and Darshan', listings.slice(0, 2)], ['Katha and Pravachan', listings.slice(2, 5)], ['Bhajan and Kirtan', listings.slice(0, 3)], ['Yoga', listings.slice(3, 5)], ['Meditation', listings.slice(4, 6)]];
const places = ['Haridwar', 'Rishikesh', 'Varanasi', 'Ujjain', 'Kedarnath', 'Vrindavan'];
---

{/* Purpose: tell a first-time visitor in one glance what this is (live spiritual experiences from real places in India) and send each audience the right way. One action for devotees (find an experience), one for creators (list an experience). */}
<section class="spiritual-hero" aria-labelledby="spiritual-title"><div class="spiritual-wrap spiritual-hero__grid"><div class="spiritual-hero__copy"><p class="spiritual-kicker"><span aria-hidden="true">✦</span> Live Hindu spiritual experiences from India</p><h1 id="spiritual-title">Be there for the moment.<br /><em>Wherever you are.</em></h1><p class="spiritual-lead">Join real pujas, aartis, darshans, kathas and meditations streamed live from temples and sacred places across India.</p><div class="spiritual-actions"><a class="spiritual-button spiritual-button--coral" href="#live-now">Find an experience <span aria-hidden="true">↗</span></a><a class="spiritual-button spiritual-button--outline" href="#creators">List an experience <span aria-hidden="true">↗</span></a></div><p class="spiritual-note"><span>ॐ</span> Public, live and recorded. Your name can be read in the sankalp.</p></div><div class="spiritual-hero__art"><div class="spiritual-art-sticker spiritual-art-sticker--top"><span>ॐ</span> real places<br />real moments</div><img src={publicImage('/assets/ideas/guides/ganga-ghat-se-shaam.jpg', { width: 1100, fit: 'cover' })} alt="Evening aarti beside the Ganga in India" width="1100" height="780" fetchpriority="high" /><div class="spiritual-art-caption"><strong>LIVE FROM INDIA</strong><span>Ganga ghat · Haridwar</span></div><div class="spiritual-art-sticker spiritual-art-sticker--bottom"><span>✺</span> your devotion,<br />from anywhere</div></div></div></section>

{/* Purpose: prove the marketplace is alive. Shows experiences that are live or starting soonest. This is the most important section on the page. */}
<section class="spiritual-section spiritual-section--live" id="live-now" aria-labelledby="live-title"><div class="spiritual-wrap"><div class="spiritual-section-heading"><div><p class="spiritual-eyebrow">HAPPENING NOW & SOON</p><h2 id="live-title">Be part of something <em>live.</em></h2></div><a class="spiritual-text-link" href="/marketplace">See all experiences ↗</a></div><div class="spiritual-card-grid spiritual-card-grid--rail">{listings.slice(0, 4).map((listing) => <article class="spiritual-card"><a href="/marketplace" class="spiritual-card__image"><img src={publicImage(listing.image, { width: 720, fit: 'cover' })} alt="" loading="lazy" /><span class:list={['spiritual-live-pill', listing.live && 'is-live']}>{listing.live ? '● Live now' : 'Upcoming'}</span></a><div class="spiritual-card__body"><h3>{listing.name}</h3><p class="spiritual-card__place">{listing.place}</p><p class="spiritual-card__guru">{listing.guru} <span aria-label="Verified">✓</span></p><p class="spiritual-card__creator">Listed by {listing.creator}</p><div class="spiritual-card__meta"><span>{listing.when}</span><span>{listing.price}</span></div><div class="spiritual-card__foot"><span>{listing.joined} devotees joined</span><a href="/marketplace">View</a></div></div></article>)}</div></div></section>

{/* Purpose: let devotees find an experience by the reason they came. Categories: Health, Education and exams, Marriage and family, Business and career, Peace for ancestors, Protection and obstacles, New home and new beginnings. Each category shows a few listing cards and a link to see all. */}
<section class="spiritual-section" aria-labelledby="purpose-title"><div class="spiritual-wrap"><p class="spiritual-eyebrow">COME WITH AN INTENTION</p><h2 id="purpose-title">Browse by <em>purpose.</em></h2><p class="spiritual-section-intro">Whatever brought you here, find a sincere experience for the moment you are in.</p><div class="spiritual-shelf-list">{purposeSections.map(([title, blurb, items]) => <section class="spiritual-shelf"><div class="spiritual-shelf__heading"><div><h3>{title}</h3><p>{blurb}</p></div><a class="spiritual-text-link" href="/marketplace">See all ↗</a></div><div class="spiritual-card-grid">{items.map((listing) => <article class="spiritual-card spiritual-card--compact"><a href="/marketplace" class="spiritual-card__image"><img src={publicImage(listing.image, { width: 600, fit: 'cover' })} alt="" loading="lazy" /></a><div class="spiritual-card__body"><h3>{listing.name}</h3><p class="spiritual-card__place">{listing.place}</p><p class="spiritual-card__guru">{listing.guru} <span aria-label="Verified">✓</span></p><p class="spiritual-card__creator">Listed by {listing.creator}</p><div class="spiritual-card__meta"><span>{listing.type}</span><span>{listing.price}</span></div><div class="spiritual-card__foot"><span>{listing.joined} joined</span><a href="/marketplace">View</a></div></div></article>)}</div></section>)}</div></div></section>

{/* Purpose: let devotees who know what they want go straight to it. Categories: Puja and Havan, Aarti and Darshan, Katha and Pravachan, Bhajan and Kirtan, Yoga, Meditation. Each category shows a few listing cards and a link to see all. */}
<section class="spiritual-section spiritual-section--soft" aria-labelledby="type-title"><div class="spiritual-wrap"><p class="spiritual-eyebrow">CHOOSE YOUR WAY IN</p><h2 id="type-title">Browse by <em>type.</em></h2><div class="spiritual-type-grid">{typeSections.map(([title], index) => <a class="spiritual-type-tile" href="/marketplace"><span class="spiritual-sticker" aria-hidden="true"><span>{['ॐ', '✺', '◌', '♫', '◒', '☼'][index]}</span>{title}</span><b aria-hidden="true">↗</b></a>)}</div><div class="spiritual-shelf-list spiritual-type-shelves">{typeSections.map(([title, items]) => <section class="spiritual-shelf"><div class="spiritual-shelf__heading"><h3>{title}</h3><a class="spiritual-text-link" href="/marketplace">See all ↗</a></div><div class="spiritual-card-grid">{items.slice(0, 2).map((listing) => <article class="spiritual-card spiritual-card--compact"><a href="/marketplace" class="spiritual-card__image"><img src={publicImage(listing.image, { width: 600, fit: 'cover' })} alt="" loading="lazy" /></a><div class="spiritual-card__body"><h3>{listing.name}</h3><p class="spiritual-card__place">{listing.place}</p><p class="spiritual-card__guru">{listing.guru} <span aria-label="Verified">✓</span></p><div class="spiritual-card__meta"><span>{listing.when}</span><span>{listing.price}</span></div><div class="spiritual-card__foot"><span>{listing.joined} joined</span><a href="/marketplace">View</a></div></div></article>)}</div></section>)}</div></div></section>

{/* Purpose: let devotees choose by sacred place, and show that experiences come from real locations. Places: Haridwar, Rishikesh, Varanasi, Ujjain, Kedarnath, Vrindavan, plus a link to all places. */}
<section class="spiritual-section" aria-labelledby="place-title"><div class="spiritual-wrap"><div class="spiritual-section-heading"><div><p class="spiritual-eyebrow">FROM SACRED PLACES</p><h2 id="place-title">Choose your <em>place.</em></h2></div><a class="spiritual-text-link" href="/marketplace">All places ↗</a></div><div class="spiritual-place-grid">{places.map((place, index) => <a href="/marketplace" class="spiritual-place-tile"><img src={publicImage(listings[index].image, { width: 640, fit: 'cover' })} alt="" loading="lazy" /><span>{place}</span><small>Live experiences ↗</small></a>)}</div></div></section>

{/* Purpose: remove confusion for a devotee who has never booked a puja online. Steps: choose an experience, add your name and gotra, watch it live and hear your name in the sankalp, receive the recording. */}
<section class="spiritual-explainer spiritual-explainer--saffron" id="how-it-works" aria-labelledby="how-title"><div class="spiritual-wrap"><div class="spiritual-explainer__head"><span class="spiritual-sticker" aria-hidden="true"><span>✦</span>A SIMPLE WAY TO JOIN</span><h2 id="how-title">From intention to <em>darshan.</em></h2></div><ol class="spiritual-steps"><li><b>01</b><h3>Choose an experience</h3><p>Find a live puja, aarti, katha or meditation from a place that calls to you.</p></li><li><b>02</b><h3>Add your name and gotra</h3><p>Share the details you want the pandit to include in the sankalp.</p></li><li><b>03</b><h3>Watch it live</h3><p>Be present from wherever you are and hear your name in the prayer.</p></li><li><b>04</b><h3>Receive the recording</h3><p>Keep the recording as a reminder of the moment you joined.</p></li></ol></div></section>

{/* Purpose: answer the devotee's main fear, which is "was the puja really done, by a real pandit, in my name?" Points: verified gurus, every experience is live and public, every experience is recorded, names are read in the sankalp, refund if the experience does not happen. */}
<section class="spiritual-section spiritual-trust" aria-labelledby="trust-title"><div class="spiritual-wrap spiritual-trust__grid"><div><p class="spiritual-eyebrow">WHY DEVOTEES TRUST SAATHUM</p><h2 id="trust-title">Faith deserves <em>proof.</em></h2><p class="spiritual-section-intro">Every experience is designed to be visible, honest and easy to understand before you join.</p></div><div class="spiritual-trust-list"><div><span>✓</span><p><strong>Verified gurus</strong><br />Know who is performing the experience.</p></div><div><span>◉</span><p><strong>Live and public</strong><br />Watch the moment as it happens.</p></div><div><span>▣</span><p><strong>Recorded every time</strong><br />Receive a recording after the experience.</p></div><div><span>ॐ</span><p><strong>Your name in the sankalp</strong><br />Share your name and gotra when you book.</p></div><div><span>↺</span><p><strong>Refund if it does not happen</strong><br />Clear support when an experience is cancelled.</p></div></div></div></section>

{/* Purpose: recruit creators. Message: if you have a phone and know a pandit, guru or teacher in your area, you can list their experiences, stream them, and earn. Steps: partner with a guru, list the experience, stream it live, get paid. One action: start listing. */}
<section class="spiritual-explainer spiritual-explainer--blue" id="creators" aria-labelledby="creator-title"><div class="spiritual-wrap spiritual-creator"><div><p class="spiritual-eyebrow">FOR CREATORS</p><h2 id="creator-title">Have a phone and know a <em>guru?</em></h2><p class="spiritual-section-intro">Bring a pandit, guru or teacher from your area online. List their experience, stream it live and earn when devotees join from anywhere.</p><a class="spiritual-button spiritual-button--ink" href="/sign-up">Start listing <span aria-hidden="true">↗</span></a></div><div class="spiritual-creator__steps"><div><b>01</b><strong>Partner with a guru</strong><span>Find the person and place you want to share.</span></div><div><b>02</b><strong>List the experience</strong><span>Add the time, price and details.</span></div><div><b>03</b><strong>Stream it live</strong><span>Use your phone. We help with the rest.</span></div><div><b>04</b><strong>Get paid</strong><span>Earn when devotees take part.</span></div></div></div></section>

{/* Purpose: handle the last objections from both audiences. Questions: I don't know my gotra. Who performs the puja? How do I know it was done? Can I watch later? How do creators and gurus get paid? Who can become a creator? */}
<section class="spiritual-section spiritual-faq" id="faq" aria-labelledby="faq-title"><div class="spiritual-wrap"><p class="spiritual-eyebrow">YOU ASKED</p><h2 id="faq-title">A few things you may be <em>wondering.</em></h2><div class="spiritual-faq__grid"><details><summary>I don't know my gotra. <span>+</span></summary><p>That is okay. You can choose “I don't know” when you join. The pandit can guide you through the available options.</p></details><details><summary>Who performs the puja? <span>+</span></summary><p>Each listing shows the performing pandit, guru or teacher. Look for the verified mark and the place they are streaming from.</p></details><details><summary>How do I know it was done? <span>+</span></summary><p>Experiences are public and live, names can be read in the sankalp, and a recording is sent after the experience.</p></details><details><summary>Can I watch later? <span>+</span></summary><p>Yes. Experiences are recorded, subject to the permissions and recording details shown on the listing.</p></details><details><summary>How do creators and gurus get paid? <span>+</span></summary><p>Devotees pay through the listing. Saathum handles the booking record and payout flow for the creator and their partner.</p></details><details><summary>Who can become a creator? <span>+</span></summary><p>Anyone with a phone, a reliable connection and a genuine local partnership with a pandit, guru or teacher can start listing.</p></details></div></div></section>
