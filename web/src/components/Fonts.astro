---
// A document has one font owner: its layout. Variable ranges keep the existing
// design weights and Unicode subsets without duplicating local/Google Nunito.
interface Props { global?: boolean; india?: boolean }
const { global: globalDesign = false, india = false } = Astro.props;
const families = globalDesign
  ? 'Fraunces:opsz,wght,SOFT@144,800..900,100&family=Instrument+Sans:wght@400..700&family=Kalam:wght@400;700'
  : 'Comfortaa:wght@300..700&family=Playfair+Display:ital,wght@0,700..900;1,700..900&family=Instrument+Sans:wght@400..700&family=Nunito:wght@400..900&family=Baloo+2:wght@600..800&family=Kalam:wght@400;700';
const href = `https://fonts.googleapis.com/css2?family=${families}${india ? '&family=Noto+Sans:wght@400..700' : ''}&display=swap`;
---
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href={href} data-avatok-fonts />
