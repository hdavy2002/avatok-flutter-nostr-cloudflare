---
import IndiaLanguageSelector from './IndiaLanguageSelector.astro';
interface Props { compact?: boolean; }
const { compact = false } = Astro.props;
---
<div class:list={['global-locales', compact && 'global-locales--compact']}>
  <details class="global-selector">
    <summary data-india-i18n-attr="aria-label:web-common.a39d5691b0ce64d4" aria-label="Choose country experience"><span aria-hidden="true">🌐</span> <ui-copy style="display:contents" data-i18n="web-common.a258b30f88c30650">Global</ui-copy> <span class="global-chevron" aria-hidden="true">⌄</span></summary>
    <div class="global-selector__menu">
      <p data-i18n="web-common.b5fcd3657c5e3959">Choose your experience</p>
      <a href="/" aria-current="page" data-site-experience="global"><ui-copy style="display:contents" data-i18n="web-common.abd2373108b0e135">🌐 Global · English</ui-copy> <span aria-hidden="true">✓</span></a>
      <a href="/india" data-site-experience="india"><ui-copy style="display:contents" data-i18n="web-common.e632a1efa068f672">🇮🇳 India</ui-copy> <span aria-hidden="true">→</span></a>
      <small data-i18n="web-common.82abb7ff5ecb8983">More country experiences are on the way.</small>
    </div>
  </details>
  <IndiaLanguageSelector id={compact ? "global-language-compact" : "global-language"} />
</div>
<script>
  document.querySelectorAll<HTMLDetailsElement>('.global-selector').forEach((selector) => {
    selector.addEventListener('toggle', () => {
      if (selector.open) document.querySelectorAll<HTMLDetailsElement>('.global-selector').forEach((other) => {
        if (other !== selector) other.open = false;
      });
    });
    selector.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        selector.open = false;
        selector.querySelector<HTMLElement>('summary')?.focus();
      }
    });
  });
  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element) || event.target.closest('.global-selector')) return;
    document.querySelectorAll<HTMLDetailsElement>('.global-selector[open]').forEach((selector) => { selector.open = false; });
  });
</script>
