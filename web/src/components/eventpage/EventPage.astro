---
// [SAATHUM-EVENT-PAGE 2026-09-26] The public event page for a `live_event`
// listing — matches the owner-approved mockup `Claude outputs/booking-page-
// layout.html` §1 ("The event page"). Rendered by pages/book/[id].astro,
// which keeps the old BookingFlow checkout shell for every other kind.
//
// Everything here is SSR except: the live countdown, the tooltip toggles, and
// the "Offer chadhava" fetch (ChadhavaOffer.tsx, a small client island) — see
// the inline <script> at the bottom for the first two.
import { cfImage } from '../../lib/config';
import { scheduleStateOf, durationLabel } from '../../lib/card';
import { ritualBySlug } from '../../lib/ritualGuides';
import { ritualStories } from '../../lib/ritualStories';
import { listingPath } from '../../lib/urls';
import ChadhavaOffer from '../../islands/eventpage/ChadhavaOffer.tsx';
import type { CoverMedia, Listing } from '../../lib/types';
import './eventpage.css';

interface Props { listing: Listing }
const { listing } = Astro.props;

const attrs = (listing.attrs ?? {}) as Record<string, unknown>;
const now = Date.now();

function attrBool(keys: string[], fallback: boolean): boolean {
  for (const k of keys) {
    const v = attrs[k];
    if (typeof v === 'boolean') return v;
    if (v === 'yes' || v === 'true' || v === 1) return true;
    if (v === 'no' || v === 'false' || v === 0) return false;
  }
  return fallback;
}
function attrNum(key: string, fallback: number): number {
  const v = attrs[key];
  const n = Number(v);
  return Number.isFinite(n) ? n : fallback;
}

// [SAATHUM-CHECKOUT §Data] listings.attrs defaults per the owner's spec.
const prasadCourier = attrBool(['prasad_courier'], true);
const prasadPriceRupees = attrNum('prasad_price_rupees', 99);
const videoDownload = attrBool(['video_download', 'replay'], true);
const visibility = attrs.visibility === 'private' ? 'private' : 'public';
const isPrivate = visibility === 'private';
const deity = typeof attrs.deity === 'string' ? attrs.deity : null;

// [SAATHUM-EVENT-FIELDS-1] mirrors islands/home/BookNowShelf.tsx's INTENTION_LABELS.
const INTENTION_LABELS: Record<string, string> = {
  education: 'Education', luck: 'Good luck', wealth: 'Wealth', career: 'Career', health: 'Health',
  family: 'Family', peace: 'Peace', life: 'Life events', festival: 'Festivals',
};
const intentionLabel = (typeof attrs.intention === 'string' && INTENTION_LABELS[attrs.intention]) || listing.category_label || listing.category || null;

const guideSlug = typeof attrs.guide_slug === 'string' ? attrs.guide_slug : '';
const ritual = guideSlug ? ritualBySlug(guideSlug) : undefined;
// storyFor() throws on a missing slug; read the map directly so a stale/typo'd
// guide_slug degrades to "no story" instead of a 500 on a public page.
const story = ritual ? ritualStories[ritual.slug] : undefined;
const ritualNoun = ritual?.type === 'puja' ? 'puja' : 'havan';

function firstCoverUrl(media: CoverMedia[] | null | undefined): string | null {
  for (const m of media ?? []) {
    const url = m?.url ?? (m as unknown as { r2_key?: string } | null)?.r2_key;
    if (typeof url === 'string' && url) return url;
  }
  return null;
}
// [SAATHUM-EVENT-PAGE] Owner rule: hide the thumbnail row entirely when the
// listing has fewer than two images — a lone thumbnail duplicating the hero
// photo reads as a bug, not a gallery.
const rawImages = (listing.cover_media ?? [])
  .map((m) => m?.url ?? (m as unknown as { r2_key?: string } | null)?.r2_key)
  .filter((u): u is string => typeof u === 'string' && u.length > 0);
const heroImage = listing.poster || rawImages[0] || firstCoverUrl(listing.cover_media);
const galleryImages = [...new Set([heroImage, ...rawImages].filter((u): u is string => Boolean(u)))];
const showThumbs = galleryImages.length >= 2;

const TZ_ABBR: Record<string, string> = { 'Asia/Kolkata': 'IST', 'Asia/Calcutta': 'IST', 'Asia/Dubai': 'GST', 'Asia/Singapore': 'SGT' };
function toMs(t?: number | null): number | null { if (t == null) return null; return t < 1e12 ? t * 1000 : t; }
function tzAbbr(ms: number, timeZone: string): string {
  try {
    const parts = new Intl.DateTimeFormat('en-US', { timeZone, timeZoneName: 'short' }).formatToParts(new Date(ms));
    const raw = parts.find((p) => p.type === 'timeZoneName')?.value ?? '';
    return TZ_ABBR[timeZone] ?? raw;
  } catch { return ''; }
}
function formatListingTime(ms: number, timeZone: string): string {
  const d = new Date(ms);
  if (Number.isNaN(d.getTime())) return '';
  try {
    const datePart = new Intl.DateTimeFormat('en-IN', { timeZone, weekday: 'short', day: 'numeric', month: 'short' }).format(d);
    const timePart = new Intl.DateTimeFormat('en-IN', { timeZone, hour: 'numeric', minute: '2-digit' }).format(d);
    const abbr = tzAbbr(ms, timeZone);
    return `${datePart} · ${timePart}${abbr ? ` ${abbr}` : ''}`;
  } catch { return d.toISOString(); }
}
const tz = listing.timezone || 'Asia/Kolkata';
const startMs = toMs(listing.starts_at);
const startsAtLabel = startMs != null ? formatListingTime(startMs, tz) : null;
const durationTag = durationLabel(listing.duration_min ?? null);

const scheduleState = scheduleStateOf(listing, now);
const liveNow = scheduleState === 'live' || scheduleState === 'starting' || Boolean((listing as unknown as { live?: boolean }).live);
const showCountdown = !liveNow && startMs != null && startMs > now;
const bookable = listing.booking_open !== false && scheduleState !== 'ended' && scheduleState !== 'cancelled' && scheduleState !== 'expired';

const hostName = listing.creator?.name || (listing.creator?.handle ? `@${listing.creator.handle}` : null);
const location = listing.location ?? null;
const ratingAvg = (listing.rating_count ?? 0) > 0 ? listing.rating_avg ?? null : null;
const ratingCount = listing.rating_count ?? 0;
const booked = listing.joined_count ?? 0;
const price = listing.effective_price ?? listing.price ?? null;

const origin = Astro.url.origin;
const canonicalHref = listingPath({ id: listing.id, handle: listing.creator?.handle ?? null, slug: listing.slug ?? null });
const checkoutHref = `/book/${encodeURIComponent(listing.id)}/checkout`;

function gcalHref(): string {
  const start = startMs ?? now;
  const end = start + (listing.duration_min ?? 60) * 60_000;
  const f = (ms: number) => new Date(ms).toISOString().replace(/[-:]/g, '').replace(/\.\d{3}/, '');
  const q = new URLSearchParams({
    action: 'TEMPLATE',
    text: `${listing.title} — Saa Thum`,
    dates: `${f(start)}/${f(end)}`,
    details: `Join live: ${origin}${canonicalHref}`,
  });
  return 'https://calendar.google.com/calendar/render?' + q.toString();
}
function waHref(): string {
  const priceText = price != null ? ` Starting from ₹${price.toLocaleString('en-IN')}.` : '';
  const whenText = startsAtLabel ? ` ${startsAtLabel}.` : '';
  return 'https://wa.me/?text=' + encodeURIComponent(`🙏 ${listing.title} on Saa Thum.${whenText}${priceText} ${origin}${canonicalHref}`);
}

const ticks: { key: string; label: string; on: boolean; tip?: string }[] = [
  { key: 'prasad', label: 'Prasad courier', on: prasadCourier },
  { key: 'sankalp', label: 'Sankalp in your name', on: true },
  { key: 'video', label: 'Video download', on: videoDownload, tip: 'You can download your video anytime.' },
  { key: 'youtube', label: 'Live on YouTube', on: true },
  {
    key: 'visibility',
    label: isPrivate ? 'Private' : 'Public',
    on: true,
    tip: 'Public: many devotees join the same havan together. Private: a 1:1 session just for your family.',
  },
];

const sticker = (name: string) => `/assets/saathum-booking-stickers/${name}.png`;
---

<div class="ep-page" data-ep-listing-id={listing.id} data-ep-tz={tz}>
  <div class="ep-inner">
    <div class="ep-crumb">
      <a href="/">Home</a> › <a href="/marketplace">Our Pujas</a>
      {intentionLabel && <> › <span>{intentionLabel}</span></>}
      › {listing.title}
    </div>

    <div class="ep-hero">
      <div>
        <div class="ep-art">
          {heroImage ? (
            <img
              src={cfImage(heroImage, { width: 1200, fit: 'cover' })}
              alt={listing.title}
              onerror="this.onerror=null;this.closest('.ep-art').classList.add('ep-art-fallback');this.remove();"
            />
          ) : (
            <div class="ep-art-empty">{ritualNoun === 'puja' ? 'Puja' : 'Havan'}</div>
          )}
          <div class="ep-top">
            <span style="display:flex;gap:8px;flex-wrap:wrap">
              {liveNow && !isPrivate && <span class="ep-pill ep-pill--live"><i></i>Live</span>}
              {isPrivate ? (
                <span class="ep-pill ep-pill--priv">🔒 Private · 1:1</span>
              ) : (
                <span class="ep-pill ep-pill--pub">👥 Public</span>
              )}
            </span>
            {intentionLabel && <span class="ep-pill ep-pill--soft">{intentionLabel}</span>}
          </div>
          <div class="ep-when">
            {startsAtLabel && <div class="ep-d">📅 {startsAtLabel}{durationTag ? ` · ${durationTag}` : ''}</div>}
            {showCountdown && (
              <>
                <span class="ep-cdl">{ritualNoun === 'puja' ? 'Puja starts in' : 'Havan starts in'}</span>
                <div class="ep-cd" data-ep-countdown data-starts-at={startMs}>
                  <span><b data-u="d">00</b><small>Day</small></span>
                  <span><b data-u="h">00</b><small>Hrs</small></span>
                  <span><b data-u="m">00</b><small>Min</small></span>
                  <span><b data-u="s">00</b><small>Sec</small></span>
                </div>
              </>
            )}
            {liveNow && <span class="ep-cdl">Happening now</span>}
          </div>
        </div>
        {showThumbs && (
          <div class="ep-thumbs">
            {galleryImages.slice(0, 4).map((url) => (
              <img src={cfImage(url, { width: 200, fit: 'cover' })} alt="" loading="lazy" />
            ))}
          </div>
        )}
      </div>

      <aside class="ep-panel">
        <h1>{listing.title}</h1>
        {deity && <div class="ep-deity">{deity}</div>}
        <div class="ep-meta">
          {startsAtLabel}{durationTag ? ` · ${durationTag}` : ''}
          {startsAtLabel && <br />}
          <span class="ep-viewer-time" data-ep-viewer-time data-ms={startMs} data-tz={tz}></span>
        </div>
        <div class="ep-blips">
          {location && <span class="ep-blip">📍 {location}</span>}
          {ratingAvg != null && (
            <span class="ep-blip ep-blip--star">⭐ {ratingAvg.toFixed(1)}/5 · <a href="#reviews">{ratingCount} reviews</a></span>
          )}
          {booked > 0 && <span class="ep-blip ep-blip--bk">👥 {booked.toLocaleString('en-IN')} booked</span>}
        </div>
        <div class="ep-feats">
          {ticks.map((t) => (
            <div class="ep-feat" tabindex={t.tip ? 0 : undefined}>
              <span class="ep-tick">✓</span>{t.label}
              {t.tip && (
                <>
                  <button type="button" class="ep-info" aria-describedby={`ep-tip-${t.key}`} aria-label={`More info: ${t.label}`}>i</button>
                  <span class="ep-tip" role="tooltip" id={`ep-tip-${t.key}`}>{t.tip}</span>
                </>
              )}
            </div>
          ))}
        </div>
        <div class="ep-price">
          {price != null ? (
            <div><small>Starting from</small><b>₹{price.toLocaleString('en-IN')}</b> <em>per family</em></div>
          ) : <div />}
          <div class="ep-icons">
            {showCountdown && (
              <a class="ep-ib ep-ib--bell" href={gcalHref()} target="_blank" rel="noopener" title="Remind me" aria-label="Remind me" data-ep-action="remind" data-ep-listing-id={listing.id}>🔔</a>
            )}
            <a class="ep-ib ep-ib--wa" href={waHref()} target="_blank" rel="noopener" title="Share" aria-label="Share on WhatsApp" data-ep-action="whatsapp" data-ep-listing-id={listing.id}>✆</a>
          </div>
        </div>
        {bookable ? (
          <a class="ep-btn ep-btn--book" href={checkoutHref} data-ep-action="book" data-ep-listing-id={listing.id}>Book with my sankalp →</a>
        ) : (
          <span class="ep-btn ep-btn--book" aria-disabled="true">Booking closed</span>
        )}
        <a class="ep-btn ep-btn--ghost" href="#benefits" data-ep-action="benefits" data-ep-listing-id={listing.id}>Read benefits</a>
        <div class="ep-fine">Performed by {hostName ?? 'temple priests'} · Free cancellation 24 hrs before</div>
        <div class="ep-trust">
          <div><span>🔒</span>UPI payment</div>
          {prasadCourier && <div><span>📦</span>Prasad ships same day</div>}
          <div><span>🧾</span>PDF receipt</div>
        </div>
      </aside>
    </div>

    <div class="ep-grid2">
      <div>
        <div class="ep-sec" id="about">
          <div class="ep-stk ep-corner"><img src={sticker('havan-kund')} alt="" loading="lazy" onerror="this.parentElement.style.display='none'" /></div>
          <div class="ep-kick">About this {ritualNoun}</div>
          <h2>{ritual?.title ?? listing.title}</h2>
          {story ? (
            <>
              <p>{story.why}</p>
              <p>{story.story}</p>
              {ritual && <a href={ritual.href} style="font:800 14px Nunito, sans-serif;color:var(--ep-red)">Read the full story →</a>}
            </>
          ) : (
            <p>{listing.description || `${listing.title}, performed by verified priests and watched live on Saa Thum.`}</p>
          )}
        </div>

        {ritual && ritual.benefits.length > 0 && (
          <div class="ep-sec" id="benefits">
            <div class="ep-kick">What devotees traditionally seek</div>
            <h2>Benefits</h2>
            <div class="ep-ben">
              {ritual.benefits.slice(0, 3).map((b) => (
                <div><span>🙏</span>{b}</div>
              ))}
            </div>
            <p style="margin-top:12px;font-size:13px;color:var(--ep-sub)">Benefits described are those traditionally sought by devotees; Saa Thum makes no claims of guaranteed outcomes.</p>
          </div>
        )}

        <div class="ep-sec">
          <div class="ep-kick">How it works</div>
          <h2>From your home, in three steps</h2>
          <div class="ep-steps">
            <div class="ep-step">
              <div class="ep-stk"><img src={sticker('sankalp-thali')} alt="" loading="lazy" onerror="this.parentElement.style.display='none'" /></div>
              <b>1. Book with your sankalp</b>
              <p>Your name, gotra and wish are read out by the priest.</p>
            </div>
            <div class="ep-step">
              <div class="ep-stk"><img src={sticker('whatsapp-diya')} alt="" loading="lazy" onerror="this.parentElement.style.display='none'" /></div>
              <b>2. Get the live link</b>
              <p>By email, 30 minutes before the {ritualNoun} starts.</p>
            </div>
            <div class="ep-step">
              <div class="ep-stk"><img src={sticker('prasad-box')} alt="" loading="lazy" onerror="this.parentElement.style.display='none'" /></div>
              <b>3. Watch, then receive prasad</b>
              <p>Download the video anytime.{prasadCourier ? ' Prasad ships the same day.' : ''}</p>
            </div>
          </div>
        </div>

        <ChadhavaOffer client:visible listingId={listing.id} />
      </div>

      <div class="ep-side">
        {prasadCourier && (
          <div class="ep-sec">
            <div class="ep-stk ep-corner" style="width:64px;height:64px"><img src={sticker('prasad-box')} alt="" loading="lazy" onerror="this.parentElement.style.display='none'" /></div>
            <h2>Prasad at your door</h2>
            <div class="ep-row"><span>Courier anywhere in India</span><b>₹{prasadPriceRupees.toLocaleString('en-IN')}</b></div>
            <div class="ep-row" style="border:0"><span>Ships the same day as the {ritualNoun}. You can change your address any time before it starts.</span></div>
          </div>
        )}
        <div class="ep-sec">
          <h2>Performed by</h2>
          <p><b>{hostName ?? 'Temple priests'}{location ? `, ${location}` : ''}</b><br />Years of experience in Vedic rituals. Your booking supports priests and their families.</p>
        </div>
        <div class="ep-sec ep-faq">
          <h2>Questions</h2>
          <details open>
            <summary>How do I join?</summary>
            <p>We send the live link by email 30 minutes before the start.</p>
          </details>
          <details>
            <summary>What if I miss it?</summary>
            <p>Download the video anytime from My events.</p>
          </details>
          <details>
            <summary>Can I cancel?</summary>
            <p>Full refund if you cancel at least 24 hours before the start.</p>
          </details>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .ep-art-fallback { background-image: repeating-linear-gradient(45deg, rgba(90,31,20,.14) 0 10px, rgba(90,31,20,.22) 10px 20px); }
</style>

<script>
  // [SAATHUM-EVENT-PAGE] Countdown ticking, the viewer's-local-time note, the
  // tap/keyboard tooltip toggle, and click telemetry — all plain DOM, no
  // hydration, so the page stays SSR-first (SPEC-2026-09-26 build item 2).
  import { capture } from '../../lib/analytics';

  document.querySelectorAll<HTMLElement>('.ep-page').forEach((page) => {
    const listingId = page.dataset.epListingId;
    if (listingId) capture('event_page_view', { listing_id: listingId });
  });

  // Countdown
  function tickCountdowns() {
    document.querySelectorAll<HTMLElement>('[data-ep-countdown]').forEach((el) => {
      const startsAt = Number(el.getAttribute('data-starts-at'));
      if (!Number.isFinite(startsAt)) return;
      const s = Math.max(0, Math.floor((startsAt - Date.now()) / 1000));
      const parts: [string, number][] = [['d', Math.floor(s / 86400)], ['h', Math.floor((s % 86400) / 3600)], ['m', Math.floor((s % 3600) / 60)], ['s', s % 60]];
      for (const [unit, value] of parts) {
        const cell = el.querySelector<HTMLElement>(`[data-u="${unit}"]`);
        if (cell) cell.textContent = String(value).padStart(2, '0');
      }
    });
  }
  if (document.querySelector('[data-ep-countdown]')) {
    tickCountdowns();
    window.setInterval(tickCountdowns, 1000);
  }

  // Viewer's local time, appended only when it differs from the listing's zone
  // — same rule as the listing details page's enhancer.
  document.querySelectorAll<HTMLElement>('[data-ep-viewer-time]').forEach((el) => {
    let viewerTz = 'Asia/Kolkata';
    try { viewerTz = Intl.DateTimeFormat().resolvedOptions().timeZone || viewerTz; } catch { /* keep default */ }
    const ms = Number(el.getAttribute('data-ms'));
    const listingTz = el.getAttribute('data-tz');
    if (!Number.isFinite(ms) || !listingTz || listingTz === viewerTz) return;
    try {
      el.textContent = 'Your time: ' + new Intl.DateTimeFormat('en-IN', {
        timeZone: viewerTz, weekday: 'short', day: 'numeric', month: 'short', hour: 'numeric', minute: '2-digit',
      }).format(new Date(ms));
    } catch { /* leave blank */ }
  });

  // Tooltip: hover/focus is CSS-only; this adds tap-to-toggle and Escape-to-close
  // for touch and keyboard users, and reports a first open per feature.
  const seenTooltips = new Set<string>();
  document.querySelectorAll<HTMLElement>('.ep-feat .ep-info').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      const feat = btn.closest<HTMLElement>('.ep-feat');
      if (!feat) return;
      const wasOpen = feat.classList.contains('ep-show');
      document.querySelectorAll('.ep-feat.ep-show').forEach((f) => f.classList.remove('ep-show'));
      if (!wasOpen) {
        feat.classList.add('ep-show');
        const key = btn.getAttribute('aria-describedby') ?? '';
        if (key && !seenTooltips.has(key)) {
          seenTooltips.add(key);
          const page = btn.closest<HTMLElement>('.ep-page');
          capture('event_page_click', { action: 'tooltip', listing_id: page?.dataset.epListingId, tip: key });
        }
      }
    });
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') document.querySelectorAll('.ep-feat.ep-show').forEach((f) => f.classList.remove('ep-show'));
  });

  // book / benefits / whatsapp / remind clicks
  document.querySelectorAll<HTMLElement>('[data-ep-action]').forEach((el) => {
    el.addEventListener('click', () => {
      capture('event_page_click', { action: el.dataset.epAction, listing_id: el.dataset.epListingId });
    });
  });
</script>
