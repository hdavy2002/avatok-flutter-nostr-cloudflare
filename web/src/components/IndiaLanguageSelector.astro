---
import indiaLandingLocales from '../../../shared/i18n/locales.json';
interface Props { id: string; class?: string; }
const { id, class: className = '' } = Astro.props;
---
<label class:list={['india-language-picker', className]} for={id} data-india-language-label>
  <span class="sr-only" data-india-i18n="chrome.chooseLanguage">Choose language</span>
  <select id={id} name="india-language" data-india-language-select aria-label="Choose language" data-india-i18n-attr="aria-label:chrome.chooseLanguage">
    {indiaLandingLocales.map((locale) => <option value={locale.code} selected={locale.code === "en"}>{locale.nativeName}</option>)}
  </select>
  <small data-ui-locale-status role="status" aria-live="polite"></small>
</label>

<style>
  .india-language-picker { display: inline-flex; align-items: center; flex-wrap: wrap; gap: 4px; }
  .india-language-picker small { max-width: 15rem; font-size: .65rem; line-height: 1.3; }
  .india-language-picker select { min-height: 2.25rem; border: 1px solid currentColor; border-radius: 999px; background: transparent; color: inherit; padding: .3rem 2rem .3rem .7rem; font: inherit; cursor: pointer; }
  .india-language-picker select:focus-visible { outline: 3px solid #ffc94d; outline-offset: 2px; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
</style>

<script>
import { initUiLocale } from '../lib/i18n/dom';
initUiLocale();
</script>
