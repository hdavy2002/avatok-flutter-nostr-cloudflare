---
import { sourceHinglish as copy } from '../../lib/indiaLandingSource';
---

<section class="india-hero india-wrap" aria-labelledby="addon-india-hero-title" id="addon-intro">
      <div class="india-hero__copy">
        <p class="india-kicker">
<span aria-hidden="true">✦</span> <span data-india-i18n="eyebrow">{copy.eyebrow}</span>
</p>
        <h2 id="addon-india-hero-title">
<span data-india-i18n="heroTitle">{copy.heroTitle}</span>
</h2>
        <p class="india-lede">
<span data-india-i18n="heroBody">{copy.heroBody}</span>
</p>
        <div class="india-actions">
<a class="india-button india-button--dark" href="/sign-up">
<span data-india-i18n="heroPrimary">{copy.heroPrimary}</span> <span aria-hidden="true">↗</span>
</a>
<a class="india-text-link" href="#addon-formats">
<span data-india-i18n="heroSecondary">{copy.heroSecondary}</span> <span aria-hidden="true">↓</span>
</a>
</div>
        <div class="india-hero__ticket">
<span aria-hidden="true">✹</span>
<strong>
<span data-india-i18n="heroTicket">{copy.heroTicket}</span>
</strong>
<span aria-hidden="true">✹</span>
</div>
      </div>
      <div class="india-hero__visual" aria-hidden="true">
<img class="india-help-sticker india-help-sticker--welcome" src="/help/art/thoko-taali.png" width="640" height="854" alt="" aria-hidden="true" loading="lazy" />
<span class="india-poster-orbit">✦</span>
</div>
    </section>
