---
// [WEB-HELP-1 2026-09-11] The help centre search box — zero-dependency client
// search (plan §6). Progressive by design: with JS disabled this is a plain GET
// form to /help?q=. With JS on, first focus lazily fetches /help/search.json
// (built by buildSearchIndex() in lib/help.ts) and scores it client-side:
// title beats keyword beats heading beats description beats body.
//
// [WEB-HELP-SKIN-2 2026-09-27] Re-skinned to the approved help skin v2 mockup
// (design/help-centre/saathum-help-skin-v2.src.html): the marketplace-style
// white search card — one wide cream `.hs-field` with a small caps label and
// a magnifier, plus a red `.hs-search-btn`. The results dropdown uses the same
// white-card language. ALL styling lives in styles/help-skin.css (scoped under
// `.folk-site … .hs`), so this component must be mounted inside a help page's
// `<main class="hs">`. The old `variant`/`size` props (rail / hero / band) are
// gone with the old skin; `compact` is the article band's smaller box.
// The DOM hooks the script below queries are unchanged
// (`[data-help-search]`, `[data-help-search-input]`, `.help-search-listbox`,
// `.help-search-empty`, `.help-search-status`), so the script is untouched.
export interface Props {
  /** Unique id suffix so two boxes can share a page without id collisions. */
  id?: string;
  /** The small caps label inside the field. */
  label?: string;
  placeholder?: string;
  /** Short placeholder swapped in below 600px (see the script). */
  placeholderShort?: string;
  button?: string;
  /** Article-band size: no arrow on the button. Sizing itself is CSS (.hs-aband .hs-search). */
  compact?: boolean;
}

const {
  id = 'main',
  label = 'Search the help centre',
  placeholder = 'Try “gotra”, “refund”, “prasad”, “video”…',
  placeholderShort = 'Search help',
  button = 'Search',
  compact = false,
} = Astro.props;
const inputId = `help-search-input-${id}`;
const listboxId = `help-search-listbox-${id}`;
---

<form class="hs-search" action="/help" method="get" role="search" aria-label="Search help" data-help-search>
  <label class="hs-field" for={inputId}>
    <span>{label}</span>
    <input
      id={inputId}
      type="search"
      name="q"
      autocomplete="off"
      placeholder={placeholder}
      role="combobox"
      aria-expanded="false"
      aria-controls={listboxId}
      aria-autocomplete="list"
      data-help-search-input
      data-placeholder-full={placeholder}
      data-placeholder-short={placeholderShort}
    />
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
  </label>
  <button class="hs-search-btn" type="submit">{button}{!compact && <span aria-hidden="true">→</span>}</button>
  <ul id={listboxId} class="hs-results help-search-listbox" role="listbox" aria-label="Search results" hidden></ul>
  {/* [WEB-HELP-1] "No results" is a status message, not an option — a sibling
      <p> outside the listbox. The sr-only live region announces the count. */}
  <p class="hs-empty help-search-empty" hidden></p>
  <p class="help-search-status hs-sr" aria-live="polite"></p>
</form>

<script>
  // [WEB-HELP-1 2026-09-11] Vanilla client search — no framework, per plan
  // §6. Runs once per <form data-help-search> on the page (rail + hero can
  // both be present). Index is fetched lazily and cached on `window` so two
  // boxes on one page (e.g. desktop rail + mobile <details> rail) share one
  // fetch.
  import { authoredKey } from '../lib/i18n/authoredKey';
  import { t, subscribe, registerNamespace, refreshLocale } from '../lib/i18n/localeStore';
  registerNamespace('web-authored');registerNamespace('web-help');refreshLocale();
  import { capture, captureException } from '../lib/analytics';

  type SearchDoc = {
    url: string;
    title: string;
    section: string;
    description: string;
    keywords: string[];
    headings: string[];
    body: string;
  };

  let indexPromise: Promise<SearchDoc[]> | null = null;
  function loadIndex(): Promise<SearchDoc[]> {
    if (!indexPromise) {
      indexPromise = fetch('/help/search.json')
        .then((r) => {
          if (!r.ok) {
            captureException(new Error(`help search.json ${r.status}`), { surface: 'help_search' });
            return [];
          }
          return r.json();
        })
        .catch((err) => {
          captureException(err, { surface: 'help_search' });
          return [];
        });
    }
    return indexPromise;
  }

  // [WEB-HELP-1] Sum every field a term hits rather than taking the max —
  // taking the max meant a term appearing in BOTH the title and the body of
  // one doc scored the same (10) as a term appearing only in the title of
  // another, so a body-heavy doc with an incidental title mention could
  // outrank the doc whose title is actually about the term (e.g. "UPI"
  // ranked tokens-explained above the payouts article, which says UPI in
  // its title). Still AND across terms: a doc must hit every term in at
  // least one field or it scores 0 and is dropped.
  function score(doc: SearchDoc, terms: string[]): number {
    const title = (doc.title+' '+t(authoredKey(doc.title),doc.title)).toLowerCase();
    const keywords = doc.keywords.join(' ').toLowerCase();
    const headings = doc.headings.join(' ').toLowerCase();
    const description = (doc.description+' '+t(authoredKey(doc.description),doc.description)).toLowerCase();
    const body = doc.body.toLowerCase();
    let total = 0;
    for (const term of terms) {
      let hit = 0;
      if (title.includes(term)) hit += 10;
      if (keywords.includes(term)) hit += 6;
      if (headings.includes(term)) hit += 4;
      if (description.includes(term)) hit += 3;
      if (body.includes(term)) hit += 1;
      if (hit === 0) return 0; // multi-term AND: every term must hit something
      total += hit;
    }
    return total;
  }

  function search(docs: SearchDoc[], query: string): SearchDoc[] {
    const terms = query.toLowerCase().trim().split(/\s+/).filter(Boolean);
    if (terms.length === 0) return [];
    return docs
      .map((doc) => ({ doc, s: score(doc, terms) }))
      .filter((r) => r.s > 0)
      .sort((a, b) => b.s - a.s)
      .slice(0, 8)
      .map((r) => r.doc);
  }

  // [WEB-HELP-1] Only ever navigate within the help centre — a doc.url that
  // somehow isn't a /help/ path (a stale/corrupt search.json entry) is never
  // followed, client-side or via the no-JS fallback.
  function isHelpUrl(url: string): boolean {
    return url.startsWith('/help/');
  }

  function initForm(form: HTMLFormElement) {
    const input = form.querySelector<HTMLInputElement>('[data-help-search-input]');
    const listbox = form.querySelector<HTMLUListElement>('.help-search-listbox');
    const emptyEl = form.querySelector<HTMLParagraphElement>('.help-search-empty');
    const statusEl = form.querySelector<HTMLParagraphElement>('.help-search-status');
    if (!input || !listbox) return;

    // [WEB-HELP-2 review] Below 600px the full placeholder ("Search help —
    // try "UPI" or "refund"") gets clipped by ellipsis before the hint
    // clause ever shows, so it's dead weight at that width — swap to the
    // short form via `matchMedia` rather than dropping the hint everywhere.
    // Markup-driven (the two strings live in `data-placeholder-*`, not
    // hardcoded here) so this stays in sync if either copy changes.
    const placeholderFull = input.dataset.placeholderFull;
    const placeholderShort = input.dataset.placeholderShort;
    if (placeholderFull && placeholderShort) {
      const narrowQuery = window.matchMedia('(max-width: 600px)');
      const applyPlaceholder = () => {
        const source=narrowQuery.matches ? placeholderShort : placeholderFull; input!.placeholder=t(authoredKey(source),source);
      };
      applyPlaceholder();
      narrowQuery.addEventListener('change', applyPlaceholder);subscribe(applyPlaceholder);
    }

    let results: SearchDoc[] = [];
    let activeIndex = -1;

    function go(url: string, rank: number) {
      if (!isHelpUrl(url)) return;
      capture('help_search_select', { rank });
      window.location.href = url;
    }

    function setExpanded(expanded: boolean) {
      input!.setAttribute('aria-expanded', String(expanded));
    }

    function render() {
      if (!listbox) return;
      listbox.innerHTML = '';
      const hasQuery = Boolean(input!.value.trim());

      if (results.length === 0) {
        listbox.hidden = true;
        if (emptyEl) {
          if (hasQuery) {
            emptyEl.textContent = t('web-help.search.empty','No results — try a different word.');
            emptyEl.hidden = false;
          } else {
            emptyEl.hidden = true;
            emptyEl.textContent = '';
          }
        }
        setExpanded(false);
        if (statusEl) statusEl.textContent = hasQuery ? t('web-help.search.none','No results') : '';
        return;
      }

      if (emptyEl) {
        emptyEl.hidden = true;
        emptyEl.textContent = '';
      }
      results.forEach((doc, i) => {
        const li = document.createElement('li');
        li.id = `${listbox.id}-opt-${i}`;
        li.className = 'help-search-option';
        li.setAttribute('role', 'option');
        li.tabIndex = -1;
        li.setAttribute('aria-selected', String(i === activeIndex));
        const titleEl = document.createElement('span');
        titleEl.className = 'hs-title';
        titleEl.textContent = t(authoredKey(doc.title),doc.title);
        const metaEl = document.createElement('span');
        metaEl.className = 'hs-meta';
        metaEl.textContent = `${t(authoredKey(doc.section),doc.section)} · ${t(authoredKey(doc.description),doc.description)}`;
        li.append(titleEl, metaEl);
        li.addEventListener('mousedown', (e) => {
          e.preventDefault();
          go(doc.url, i);
        });
        listbox.append(li);
      });
      listbox.hidden = false;
      setExpanded(true);
      if (statusEl) statusEl.textContent = t(results.length===1?'web-help.search.one':'web-help.search.many',results.length===1?'{count} result':'{count} results',{count:results.length});
    }

    // [WEB-HELP-1] `help_search` fires 600ms after the query settles (not on
    // every keystroke) and never carries the raw query text — only its
    // length and the outcome, per the telemetry catalog's "never send the
    // raw query" rule for search surfaces.
    let telemetryHandle: number | undefined;
    function scheduleSearchTelemetry(q: string) {
      window.clearTimeout(telemetryHandle);
      telemetryHandle = window.setTimeout(() => {
        capture('help_search', {
          q_len: q.trim().length,
          result_count: results.length,
          zero_result: results.length === 0,
        });
      }, 600);
    }

    async function runSearch() {
      const q = input!.value;
      if (!q.trim()) {
        window.clearTimeout(telemetryHandle);
        results = [];
        activeIndex = -1;
        input!.removeAttribute('aria-activedescendant');
        render();
        return;
      }
      const docs = await loadIndex();
      results = search(docs, q);
      activeIndex = -1;
      input!.removeAttribute('aria-activedescendant');
      render();
      scheduleSearchTelemetry(q);
    }

    subscribe(()=>{if(input!.value.trim())void runSearch();});
    let debounceHandle: number | undefined;
    input.addEventListener('input', () => {
      window.clearTimeout(debounceHandle);
      debounceHandle = window.setTimeout(runSearch, 120);
    });

    input.addEventListener('focus', () => {
      loadIndex();
      if (input!.value.trim()) runSearch();
    });

    input.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        // [WEB-HELP-1] Escape just closes the open listbox/empty-state — it
        // used to call render() with the existing (non-empty) query, which
        // re-opened the box and showed "No results" instead of dismissing.
        listbox!.hidden = true;
        if (emptyEl) emptyEl.hidden = true;
        setExpanded(false);
        input!.removeAttribute('aria-activedescendant');
        return;
      }
      if (results.length === 0) return;
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        activeIndex = (activeIndex + 1) % results.length;
        render();
        input!.setAttribute('aria-activedescendant', `${listbox.id}-opt-${activeIndex}`);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        activeIndex = (activeIndex - 1 + results.length) % results.length;
        render();
        input!.setAttribute('aria-activedescendant', `${listbox.id}-opt-${activeIndex}`);
      } else if (e.key === 'Enter') {
        // [WEB-HELP-1] With results on screen but none highlighted, Enter
        // used to fall through to the native form submit (a full GET
        // navigation to /help?q=) even though a perfectly good client-side
        // result list was showing. Take the highlighted result, or the top
        // result when none is highlighted; only let the native submit go
        // through when there are truly zero results (the no-JS fallback) —
        // or when Escape just hid the listbox: `results` is still non-empty
        // then (Escape only hides, it doesn't clear), so without this check
        // Enter would silently re-navigate to the dismissed dropdown's top
        // result instead of letting the form submit normally.
        if (listbox!.hidden) return;
        e.preventDefault();
        const target = results[activeIndex >= 0 ? activeIndex : 0];
        if (target) go(target.url, activeIndex >= 0 ? activeIndex : 0);
      }
    });

    document.addEventListener('click', (e) => {
      if (!form.contains(e.target as Node)) {
        listbox!.hidden = true;
        if (emptyEl) emptyEl.hidden = true;
        setExpanded(false);
      }
    });

    // Prefill + auto-run from ?q= when JS is on and this box sits on /help.
    const params = new URLSearchParams(window.location.search);
    const q = params.get('q');
    if (q && !input.value) {
      input.value = q;
      runSearch();
    }
  }

  document.querySelectorAll<HTMLFormElement>('form[data-help-search]').forEach(initForm);
</script>
