---
// [LIST-PAGE-2 / LIST-DESIGN-1] "SEEDHI BAAT NO CHAKKAR" promises band — six
// guarantee cards on the comp's teal plate (not the dark plate this used to
// render — #2d7180 with a "lotus" truck strip and text-shadowed heading,
// per design/live-streaming/avaTOK Listing Details.dc.html:511-547). Refund/
// cancel windows come from the listing's own commercial policy attrs (never
// hardcoded), per SPEC-2026-09-02 §1 row 9.
import { promiseBand } from '../../lib/copy';
import TruckBorder from '../TruckBorder.astro';

interface Props { refundHours?: number | null; cancelHours?: number | null }
const { refundHours, cancelHours } = Astro.props;

const cards: { title: string; body: string }[] = [
  { title: promiseBand.escrowTitle, body: promiseBand.escrowBody },
  { title: promiseBand.numberTitle, body: promiseBand.numberBody },
  { title: promiseBand.hostTitle, body: promiseBand.hostBody },
  { title: promiseBand.supportTitle, body: promiseBand.supportBody },
  { title: promiseBand.reviewsTitle, body: promiseBand.reviewsBody },
];
if (refundHours != null && Number.isFinite(refundHours)) {
  cards.push({ title: 'REFUND OK', body: promiseBand.refund(refundHours) });
} else if (cancelHours != null && Number.isFinite(cancelHours)) {
  cards.push({ title: 'CANCEL OK', body: promiseBand.cancel(cancelHours) });
}
---

<section class="ld-promises" data-section="promises">
  <div class="ld-strip-frame ld-strip-frame--top"><TruckBorder kind="lotus" count={40} /></div>
  <div class="ld-promises-body">
    <div class="ld-promises-head">
      <h2 class="ld-promises-title">{promiseBand.title}</h2>
      <span class="ld-promises-note">THESE PROMISES APPLY TO EVERY LISTING</span>
    </div>
    <div class="ld-promises-grid">
      {cards.map((c) => (
        <div class="ld-promise-card">
          <span class="ld-promise-title">{c.title}</span>
          <p class="ld-promise-body">{c.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>
