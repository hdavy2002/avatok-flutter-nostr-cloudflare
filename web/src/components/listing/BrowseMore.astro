---
// [LIST-PAGE-2 / LIST-DESIGN-1] "BROWSE MORE EVENTS" — reuses the real ListingTile
// card (the same one the marketplace renders) via /api/explore, per the task
// brief. Section chrome (truck strip, count meta) restyled to the comp; the
// grid itself stays ListingTile's own component — that card is shared with
// the marketplace and out of scope here.
import { ListingTile } from '../../components';
import TruckBorder from '../TruckBorder.astro';
import type { Card } from '../../lib/types';

interface Props { cards: Card[]; excludeId: string }
const { cards, excludeId } = Astro.props;
const items = cards.filter((c) => c.id !== excludeId).slice(0, 8);
---

{items.length > 0 && (
  <div class="ld-wrap ld-browse-section">
    <div class="ld-section-head">
      <h2 class="ld-section-title">Browse more <span class="ld-accent">events.</span></h2>
      <span class="ld-section-note">{items.length} MORE LIKE THIS</span>
    </div>
    <div class="ld-strip-frame"><TruckBorder kind="jhalar" count={40} /></div>
    <div class="ld-browse-grid" data-section="browse_more">
      {items.map((c, i) => (
        <ListingTile listing={c} position={i} section="listing_detail_browse_more" />
      ))}
    </div>
  </div>
)}
