---
// [LIST-PAGE-2 / LIST-DESIGN-1] "PUBLIC KI RAI" — SPEC-2026-09-02-LISTING-TRUST-AND-VIBE.md §1
// row 5 / §3.1.9. Reads from the paginated /api/listings/:id/reviews envelope
// (histogram, verified_count, show_rating) rather than the plain `reviews[]`
// array on the detail response, per the task brief — the detail response's
// array is only the latest 20 with no histogram.
//
// [LIST-DESIGN-1] Restructured to the comp's two-column layout: a rating +
// histogram card on the left, review cards + a pager on the right (every 3rd
// review card gets the comp's teal variant). The comp's pager is page-number
// based; the API here is cursor-based, so PREV is a browser-back affordance
// and NEXT walks `next_cursor` — same visual chrome, same underlying data.
import { Avatar } from '../../components';
import TruckBorder from '../TruckBorder.astro';
import { reviewsCopy } from '../../lib/copy';
import type { ReviewList } from '../../lib/types';

interface Props { listingId: string; reviewList: ReviewList | null }
const { listingId, reviewList } = Astro.props;
const items = reviewList?.items ?? [];
const hist = reviewList?.histogram;
const total = reviewList?.total ?? items.length;
const showRating = reviewList?.show_rating ?? false;
const avg = total > 0 && hist
  ? (Object.entries(hist).reduce((s, [k, v]) => s + Number(k) * v, 0) / Math.max(1, total))
  : null;
---

{(items.length > 0 || total === 0) && (
  <section data-section="reviews">
    <div class="ld-section-head">
      <h2 class="ld-section-title">Public ki <span class="ld-accent">Rai.</span></h2>
      <span class="ld-section-note">ALL FROM VERIFIED BOOKINGS · WE DELETE NOTHING</span>
    </div>
    <div class="ld-strip-frame"><TruckBorder kind="chai" count={40} /></div>

    {total === 0 ? (
      <p class="ld-about-text">{reviewsCopy.empty}</p>
    ) : (
      <div class="ld-reviews-row">
        <div class="ld-rating-col">
          <div class="ld-card ld-rating-card">
            {showRating && avg != null && <div class="ld-big-rating">{avg.toFixed(1)}</div>}
            <div class="ld-rating-sub">{total} review{total === 1 ? '' : 's'}</div>
            {hist && (
              <div>
                {(['5', '4', '3', '2', '1'] as const).map((star) => {
                  const n = hist[star] ?? 0;
                  const pct = total > 0 ? Math.round((n / total) * 100) : 0;
                  return (
                    <div class="ld-hist-row">
                      <span class="ld-hist-star">{star}★</span>
                      <div class="ld-hist-bar"><div class="ld-hist-fill" style={`width:${pct}%`}></div></div>
                      <span class="ld-hist-n">{n}</span>
                    </div>
                  );
                })}
              </div>
            )}
          </div>
        </div>

        <div class="ld-review-list-col">
          {items.map((r, i) => (
            <div class={`ld-card ld-review-card ${i % 3 === 2 ? 'ld-review-card--teal' : ''}`}>
              <div class="ld-review-head">
                <Avatar src={r.author_avatar} name={r.author_name} size={32} />
                <span class="ld-review-author">{r.author_name ?? 'Guest'}</span>
                {(r.verified_attendee === 1) && <span class="ld-verified-tag">{reviewsCopy.verifiedTag}</span>}
                <span class="ld-review-stars">★ {r.rating.toFixed(1)}</span>
                <span class="ld-review-meta">VERIFIED</span>
              </div>
              {r.body && <p class="ld-review-body">{r.body}</p>}
              {(r.creator_reply || r.reply) && (
                <div style="margin-top:8px; padding:10px; border-radius:10px; background:rgba(255,255,255,.5);">
                  <span class="ld-review-meta">{reviewsCopy.hostReply}</span>
                  <p class="ld-review-body" style="margin-top:4px;">{r.creator_reply ?? r.reply}</p>
                </div>
              )}
              <button type="button" class="ld-pager-btn" style="margin-top:8px; align-self:flex-start;" data-review-helpful={r.id} data-helpful-count={r.helpful_count ?? 0}>
                {reviewsCopy.helpful(r.helpful_count ?? 0)}
              </button>
            </div>
          ))}

          {reviewList?.next_cursor && (
            <div class="ld-pager">
              <a class="ld-pager-btn" href={`?reviews_cursor=${encodeURIComponent(reviewList.next_cursor)}#reviews`} data-cta="reviews_load_more">
                {reviewsCopy.loadMore} ›
              </a>
            </div>
          )}
        </div>
      </div>
    )}
  </section>
)}

<script define:vars={{ listingId }}>
  import('../../lib/analytics').then(({ capture }) => {
    document.querySelectorAll('[data-review-helpful]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const reviewId = btn.getAttribute('data-review-helpful');
        try {
          const { markReviewHelpful } = await import('../../lib/apiClient');
          const r = await markReviewHelpful(reviewId);
          btn.textContent = r.marked_helpful ? `Helpful (${r.helpful_count})` : `Helpful (${r.helpful_count})`;
        } catch (e) {
          // Guest with no session, or a network error — leave the count as-is,
          // this is a nice-to-have vote, not a critical path.
        }
        capture('listing_review_helpful', { listing_id: listingId, review_id: reviewId });
      });
    });
  });
</script>
