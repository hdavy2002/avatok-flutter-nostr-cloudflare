---
// [LIST-PAGE-2 / LIST-DESIGN-1] "MEET THE HOST" — SPEC-2026-09-02 §3.1.7 / §3.2.6 / §3.3.6.
// Shared across all three layouts; what differs per layout is which stat chips
// are meaningful (a consult expert's "on-time %" reads differently from a live
// host's "shows hosted"), so the caller passes the chip list already built.
// Restructured to the comp's two-column card: photo column (left, `.ld-host-
// col`) + bio/sessions/also-listed column (right). "Past sessions" and "Also
// listed by" are comp furniture with no data source on the Listing type today
// — they're intentionally left out rather than faked; see task report.
import { Avatar } from '../../components';
import { creatorPath } from '../../lib/urls';
import type { CreatorRef, CreatorTrustStats } from '../../lib/types';

interface Props {
  creator: CreatorRef;
  creatorSlug: string | null;
  avatarUrl: string | null;
  city?: string | null;
  bio?: string | null;
  chips: string[];
  isAgent?: boolean;
  hostSinceLabel?: string | null;
  trust?: CreatorTrustStats | null;
  hostInitials?: string;
}
const { creator, creatorSlug, avatarUrl, city, bio, chips, isAgent = false, hostSinceLabel, trust, hostInitials } = Astro.props;
// [LIST-DETAIL-BUG-5] `??` only falls through on null/undefined — an empty-string
// `creator.name`/`creator.handle` used to slip past this fallback and leave `name`
// blank, which fed a blank string into <Avatar> (rendering its own bare "?"
// fallback instead of initials). `||` treats "" the same as absent.
const name = creator.name || (creator.handle ? `@${creator.handle}` : 'avaTOK creator');
const verified = !isAgent && Boolean(creator.kyc_verified);
const profileHref = creatorSlug ? creatorPath(creatorSlug) : null;
const initials = hostInitials || name.split(/\s+/).map((w) => w[0]).filter(Boolean).slice(0, 2).join('').toUpperCase() || 'AC';
---

<div class="ld-host-card">
  <div class="ld-host-card-inner">
    <div class="ld-host-col">
      {profileHref ? (
        <a href={profileHref} class="ld-host-photo">
          <Avatar src={avatarUrl} name={name} size={210} />
          {verified && <span class="ld-host-photo-badge">✓ ID VERIFIED</span>}
        </a>
      ) : (
        <div class="ld-host-photo">
          <Avatar src={avatarUrl} name={name} size={210} />
          {verified && <span class="ld-host-photo-badge">✓ ID VERIFIED</span>}
        </div>
      )}
      <div>
        <div class="ld-host-name-big">
          {profileHref ? <a href={profileHref} style="color:inherit;">{name}</a> : name}
          {isAgent && <span class="ld-chip ld-chip--ai" style="margin-left:8px; vertical-align:middle;">AI</span>}
        </div>
        <div class="ld-host-meta-line">
          {hostSinceLabel && <>HOST SINCE {hostSinceLabel}</>}
          {hostSinceLabel && city && ' · '}
          {city}
        </div>
      </div>
      {chips.length > 0 && (
        <div class="ld-host-chip-row">
          {chips.map((c) => <span class="ld-host-chip">{c}</span>)}
        </div>
      )}
      {profileHref && !isAgent && (
        <a href={profileHref} class="ld-msg-btn" data-cta="message_host">MESSAGE {name.split(' ')[0].toUpperCase()}</a>
      )}
      <span class="ld-msg-note">MESSAGES STAY ON AVATOK · NO PHONE NUMBERS SHARED</span>
    </div>

    <div class="ld-host-bio-col">
      {bio && (
        <div>
          <div class="ld-about-label">ABOUT {name.split(' ')[0].toUpperCase()}</div>
          <p class="ld-about-text">{bio}</p>
        </div>
      )}

      {trust && trust.shows_hosted > 0 && (
        <div class="ld-stats-board" style="margin-top:0;">
          <div><b>{trust.shows_hosted}</b><span>SHOWS</span></div>
          {trust.comeback_pct != null && <div><b>{Math.round(trust.comeback_pct)}%</b><span>COME BACK</span></div>}
          {trust.on_time_pct != null && <div><b>{Math.round(trust.on_time_pct)}%</b><span>ON TIME</span></div>}
          {trust.sold_out_count > 0 && <div><b>{trust.sold_out_count}</b><span>SOLD OUT</span></div>}
        </div>
      )}

      {profileHref && (
        <div>
          <div class="ld-also-listed-head">
            <span class="ld-also-listed-label">MORE FROM {name.split(' ')[0].toUpperCase()}</span>
          </div>
          <a href={profileHref} class="ld-also-listed-label" style="color:#2d7180; text-decoration:none;" data-cta="also_listed_by">
            See {name.split(' ')[0]}'s full profile →
          </a>
        </div>
      )}
    </div>
  </div>
</div>
