---
// Shared marketplace browse surface — rendered both on the public /marketplace
// (Base chrome) and inside the dashboard at /dashboard/marketplace. `hrefBase`
// keeps logged-in users inside the dashboard: '' for public, '/dashboard' for
// the authed shell (so cards and category tiles link to /dashboard/l/<id> etc).
//
// [MARKET-BAZAAR-1 2026-08-31, owner decision] The shell is the bazaar comp
// (design/marketplace/avaTOK Marketplace.dc.html): terracotta hero, truck-art
// category tiles, section rules. What it is NOT is the comp's DATA. The comp
// hardcodes eight cards per section with invented counts, ratings and
// followings, all linking to one demo listing — that is what [DEMO-MARKET-1]
// shipped and [DEMO-MARKET-2] reverted. Every number on this page now comes
// from /api/explore, and where the API has nothing, the slot renders empty
// rather than inventing a plausible figure.
import LiveNowRail from '../islands/marketplace/LiveNowRail.tsx';
import ExploreGrid from '../islands/marketplace/ExploreGrid.tsx';
import BazaarHero from './BazaarHero.astro';
import BazaarSearchStrip from './BazaarSearchStrip.astro';
import TruckBorder from './TruckBorder.astro';
import { VERTICALS, VERTICALS_WITHOUT_A_SOURCE } from '../lib/verticals';

interface Props {
  hrefBase?: string;
  /** Search query from the URL (?q=), set by the hero search strip. */
  q?: string;
  /** Vertical from the URL (?vertical=), set by the category tiles. */
  vertical?: string;
  /** Show the marketing "for fans / for creators" block (public only). */
  showSplit?: boolean;
  /** Show the big bazaar hero (public only; the dashboard has its own header). */
  showHero?: boolean;
}
const { hrefBase = '', vertical, q, showSplit = false, showHero = false } = Astro.props;
const mpBase = `${hrefBase}/marketplace`;

// [MARKET-BAZAAR-2 2026-08-31] The tiles are the seven VERTICALS, not the 25
// classifieds categories the API returns. That is the comp's taxonomy and the
// owner's decision. The three with no data source (see verticals.ts) still get
// a tile — they are real products — but they are marked, not silently dead.
const tiles = VERTICALS;
// [MARKET-TILE-CURATION-1] Keep these products available to the server and
// section model, but omit the three tiles the owner does not want in the first
// row of the public bazaar navigation.
const visibleTiles = tiles.filter((v) => !['astro_tarot', 'consulting', 'glow_up'].includes(v.id));

// The comp gives each tile a different truck-art strip. Cycling by INDEX (not
// at random) keeps a tile's strip stable across renders — a tile that changes
// its border on reload reads as a glitch.
//
// `tassels` is deliberately NOT in this list even though the kit draws it. It
// is the only motif with a dangling row, so it stands 43px tall against the
// others' 30–32px, and inside a grid of equal-height tiles that pushed the
// title of every tassels tile a visible ~12px lower than its neighbours' —
// the row read as misaligned. Tassels is the hero band's motif; the tiles
// take the five flat ones.
const MOTIFS = ['jhalar', 'lotus', 'eyes', 'chai', 'auto'] as const;

// Display type: Anton, POSITIVE tracking. See the note in BazaarHero.astro —
// the comp's negative values are the one thing deliberately not copied.
const stub = 'font-label text-[0.75rem] font-bold uppercase tracking-[0.1em] text-inkMute';

const ctaLime = 'inline-flex items-center justify-center gap-2.5 select-none no-underline rounded-full border-zine border-ink shadow-zine-sm transition-transform duration-zine ease-out active:translate-x-[2px] active:translate-y-[2px] active:shadow-zine-pressed px-7 py-4 font-display font-normal uppercase text-[1rem] leading-none tracking-[0.06em] bg-lime text-ink';
const ctaBlue = 'inline-flex items-center justify-center gap-2.5 select-none no-underline rounded-full border-zine border-ink shadow-zine-sm transition-transform duration-zine ease-out active:translate-x-[2px] active:translate-y-[2px] active:shadow-zine-pressed px-7 py-4 font-display font-normal uppercase text-[1rem] leading-none tracking-[0.06em] bg-card text-ink';

// The public page renders this component full-bleed (the hero band has to reach
// both edges), so the component owns its own gutters there. Inside the
// dashboard the shell already provides them, and adding a second set would
// double-indent the grid — hence one wrapper class, not two hardcoded ones.
// [MARKET-BAZAAR-3 2026-08-31] 1760px, not the comp's 1560.
//
// The comp is drawn at a fixed canvas width, so its 1560 reads as edge-to-edge
// in the artboard. On a real 2000px+ monitor the same number leaves ~11% dead
// paper down each side, and the bazaar — seven tiles, a rail and a four-up card
// grid — visibly shrinks into the middle of the screen. 1760 keeps the comp's
// proportions at the sizes people actually use without letting the card grid run
// so wide that a section's cards drift apart from its heading.
const gutters = showHero ? 'mx-auto max-w-[1760px] px-4 sm:px-10' : '';
---

{showHero && (
  <>
    <BazaarSearchStrip action={mpBase || '/marketplace'} value={q} />
    <BazaarHero browseHref="#listings" liveHref={`${mpBase}?vertical=live_streaming#listings`} />
  </>
)}

<section class={showHero ? 'relative -mt-10' : 'pt-2'}>
  <div class={`grid gap-3.5 ${gutters}`} style="grid-template-columns:repeat(auto-fit,minmax(180px,1fr));">
    {visibleTiles.map((v, i) => {
      const soon = VERTICALS_WITHOUT_A_SOURCE.has(v.id);
      return (
        <a
          href={soon ? '/sign-up' : `${mpBase}?vertical=${encodeURIComponent(v.id)}#listings`}
          class="block overflow-hidden rounded-[18px] border-[3px] border-ink bg-card no-underline shadow-zine transition-transform duration-zine ease-out hover:-translate-y-[3px] active:translate-y-0 active:shadow-zine-pressed"
        >
          <div class="border-b-zine border-ink"><TruckBorder kind={MOTIFS[i % MOTIFS.length]} /></div>
          {/* [MARKET-BAZAAR-3] Taller and roomier than before. The tiles were
              px-4/pt-3/pb-3.5, which made a 120px strip that read as a row of
              buttons rather than the comp's stall signs. */}
          <div class="flex flex-col gap-2 px-5 pb-5 pt-4">
            <span class="font-display text-[1.1875rem] font-normal uppercase leading-[1.15] tracking-[0.05em] text-ink">{v.label}</span>
            {/* The comp prints "8 LISTINGS · PAWRI ZONE" on every tile. The 8 is
                mock, so only the zone survives here — a count would have to be
                fetched per vertical and would be a lie the moment it is stale.
                A vertical nothing can be published into says so instead. */}
            <span class={stub}>{soon ? `Coming soon · ${v.zone}` : v.zone}</span>
          </div>
        </a>
      );
    })}
  </div>
</section>

<div class={gutters}>
  {/* [MARKET-BAZAAR-3] The live rail lives HERE and nowhere else.
      It was being rendered twice — once in this file and again inside
      ExploreGrid, whose `showLiveRail` defaults to true. Nothing was visibly
      wrong only because no listing is live: the moment one is, the page would
      have shown two identical "Live now" rails. ExploreGrid is told not to
      render its own below.

      The wrapper has NO vertical padding of its own. LiveNowRail returns null
      when nothing is live (hideWhenEmpty), so a padded wrapper left a 64px band
      of dead paper above the results on every normal day — part of what made
      the page read as boxed in. The rail brings its own bottom margin when it
      actually has something to show. */}
  <div class="pt-8"><LiveNowRail client:visible /></div>

  {/* [MARKET-BAZAAR-2] No heading above the results any more. Each vertical
      section brings its own numbered eyebrow and Anton heading, so a single
      "EXPLORE LISTINGS" on top of them was a heading about headings. */}
  <section id="listings" class="scroll-mt-20 pb-16 pt-0">
    {/* showSearch is the inverse of showHero on purpose: the public page puts
        the search field in the strip above the hero (BazaarSearchStrip), so
        rendering a second one here would give the page two search boxes that
        do not agree with each other. The dashboard has no strip, so the grid
        keeps its own. */}
    <ExploreGrid
      client:visible
      initialQ={q}
      initialVertical={vertical}
      hrefBase={hrefBase}
      showSearch={!showHero}
      showLiveRail={false}
    />
  </section>

  {/* [MARKET-BAZAAR-3] The marketing band moved BELOW the listings.
      It used to sit between the category tiles and the results — two large,
      mostly-empty bordered boxes spanning the full width, exactly where the comp
      goes straight from the stalls into the goods. On a wide screen that band
      was the thing that made the page read as boxed in: the bazaar itself got
      pushed a screenful down behind an ad for the bazaar.
      Below the listings it still does its job for anyone who scrolls the whole
      page, without standing between a visitor and what they came for. */}
  {showSplit && (
    <section class="pb-20">
      <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
        <div class="flex flex-col gap-3 rounded-zine border-zine border-ink bg-paper2 p-7 shadow-zine">
          <span class="font-label text-[0.8125rem] font-extrabold uppercase tracking-[0.12em] text-blueInk">For fans</span>
          <h3 class="font-display text-[1.5rem] font-normal uppercase tracking-[0.05em] text-ink">Browse right here</h3>
          <p class="font-body text-[0.9375rem] font-medium leading-[1.5] text-inkSoft">Everything works in your browser — explore, book and watch without downloading a thing.</p>
          <div class="pt-1"><a href="#listings" class={ctaLime}>Start browsing</a></div>
        </div>
        <div class="flex flex-col gap-3 rounded-zine border-zine border-ink bg-card p-7 shadow-zine">
          <span class="font-label text-[0.8125rem] font-extrabold uppercase tracking-[0.12em] text-blueInk">For creators</span>
          <h3 class="font-display text-[1.5rem] font-normal uppercase tracking-[0.05em] text-ink">Sell from your dashboard</h3>
          <p class="font-body text-[0.9375rem] font-medium leading-[1.5] text-inkSoft">Create listings, bookings and AI agents on the web. Going live and sessions happen in the app.</p>
          <div class="pt-1"><a href="/sign-up" class={ctaBlue}>Become a creator</a></div>
        </div>
      </div>
    </section>
  )}
</div>

<script>
  // [WEB-POSTHOG-1] island_visible_never — both ExploreGrid and LiveNowRail
  // hydrate with client:visible, so they only ever mount once their
  // astro-island element scrolls into view. If that never actually happens
  // (the observer never fires, the component chunk 404s, a hydration error
  // throws before Astro clears the `ssr` marker) the section stays a dead
  // server-rendered husk forever with nothing telling us so. This watches
  // both islands and reports the ones that stayed unhydrated 10s after they
  // were first seen.
  //
  // Astro marks an island `ssr` (still server-rendered, not yet hydrated)
  // and removes that attribute once client-side hydration completes — so its
  // continued presence 10s after intersection is the signal something is
  // stuck.
  (function () {
    if (typeof IntersectionObserver === 'undefined') return;

    const islands = Array.from(
      document.querySelectorAll<HTMLElement>('astro-island'),
    ).filter((el) => {
      const url = el.getAttribute('component-url') || '';
      return url.includes('ExploreGrid') || url.includes('LiveNowRail');
    });
    if (islands.length === 0) return;

    const nameFor = (el: HTMLElement): string => {
      const url = el.getAttribute('component-url') || '';
      if (url.includes('ExploreGrid')) return 'marketplace-explore-grid';
      if (url.includes('LiveNowRail')) return 'marketplace-live-now-rail';
      return 'unknown';
    };

    const seen = new WeakSet<HTMLElement>();
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const el = entry.target as HTMLElement;
          if (!entry.isIntersecting || seen.has(el)) continue;
          seen.add(el);
          observer.unobserve(el);

          setTimeout(() => {
            if (!el.hasAttribute('ssr')) return; // hydrated fine
            import('../lib/analytics').then(({ capture }) => {
              capture('island_visible_never', {
                island: nameFor(el),
                url: window.location.href,
              });
            });
          }, 10000);
        }
      },
      { threshold: 0.1 },
    );

    for (const el of islands) observer.observe(el);
  })();
</script>
