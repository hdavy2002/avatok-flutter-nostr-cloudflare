---
// Shared marketplace browse surface — rendered both on the public /marketplace
// (Base chrome) and inside the dashboard at /dashboard/marketplace. `hrefBase`
// keeps logged-in users inside the dashboard: '' for public, '/dashboard' for
// the authed shell (so cards and category tiles link to /dashboard/l/<id> etc).
//
// [MARKET-BAZAAR-1 2026-08-31, owner decision] The shell is the bazaar comp
// (design/marketplace/avaTOK Marketplace.dc.html): terracotta hero, truck-art
// category tiles, section rules. What it is NOT is the comp's DATA. The comp
// hardcodes eight cards per section with invented counts, ratings and
// followings, all linking to one demo listing — that is what [DEMO-MARKET-1]
// shipped and [DEMO-MARKET-2] reverted. Every number on this page now comes
// from /api/explore, and where the API has nothing, the slot renders empty
// rather than inventing a plausible figure.
import LiveNowRail from '../islands/marketplace/LiveNowRail.tsx';
import ExploreGrid from '../islands/marketplace/ExploreGrid.tsx';
import BazaarHero from './BazaarHero.astro';
import BazaarSearchStrip from './BazaarSearchStrip.astro';
import TruckBorder from './TruckBorder.astro';
import { getCategories } from '../islands/marketplace/api';
import type { MarketCategory } from '../islands/marketplace/api';

interface Props {
  hrefBase?: string;
  category?: string;
  kind?: string;
  /** Search query from the URL (?q=), set by the hero search strip. */
  q?: string;
  /** Show the marketing "for fans / for creators" block (public only). */
  showSplit?: boolean;
  /** Show the big bazaar hero (public only; the dashboard has its own header). */
  showHero?: boolean;
}
const { hrefBase = '', category, kind, q, showSplit = false, showHero = false } = Astro.props;
const mpBase = `${hrefBase}/marketplace`;

let categories: MarketCategory[] = [];
try { categories = await getCategories(); } catch { categories = []; }

// The comp gives each tile a different truck-art strip. Cycling by INDEX (not
// at random) keeps a tile's strip stable across renders — a tile that changes
// its border on reload reads as a glitch.
//
// `tassels` is deliberately NOT in this list even though the kit draws it. It
// is the only motif with a dangling row, so it stands 43px tall against the
// others' 30–32px, and inside a grid of equal-height tiles that pushed the
// title of every tassels tile a visible ~12px lower than its neighbours' —
// the row read as misaligned. Tassels is the hero band's motif; the tiles
// take the five flat ones.
const MOTIFS = ['jhalar', 'lotus', 'eyes', 'chai', 'auto'] as const;

// Display type: Anton, POSITIVE tracking. See the note in BazaarHero.astro —
// the comp's negative values are the one thing deliberately not copied.
const h2 = 'm-0 font-display font-normal uppercase text-[clamp(30px,3.4vw,44px)] leading-[1.02] tracking-[0.055em] [word-spacing:0.2em] text-ink';
const eyebrow = 'font-label text-[13px] font-extrabold uppercase tracking-[0.16em] text-coral';
const stub = 'font-label text-[12px] font-bold uppercase tracking-[0.1em] text-inkMute';

const ctaLime = 'inline-flex items-center justify-center gap-2.5 select-none no-underline rounded-full border-zine border-ink shadow-zine-sm transition-transform duration-zine ease-out active:translate-x-[2px] active:translate-y-[2px] active:shadow-zine-pressed px-7 py-4 font-display font-normal uppercase text-[16px] leading-none tracking-[0.06em] bg-lime text-ink';
const ctaBlue = 'inline-flex items-center justify-center gap-2.5 select-none no-underline rounded-full border-zine border-ink shadow-zine-sm transition-transform duration-zine ease-out active:translate-x-[2px] active:translate-y-[2px] active:shadow-zine-pressed px-7 py-4 font-display font-normal uppercase text-[16px] leading-none tracking-[0.06em] bg-card text-ink';

// The public page renders this component full-bleed (the hero band has to reach
// both edges), so the component owns its own gutters there. Inside the
// dashboard the shell already provides them, and adding a second set would
// double-indent the grid — hence one wrapper class, not two hardcoded ones.
const gutters = showHero ? 'mx-auto max-w-[1560px] px-4 sm:px-10' : '';
---

{showHero && (
  <>
    <BazaarSearchStrip action={mpBase || '/marketplace'} value={q} />
    <BazaarHero browseHref="#listings" liveHref={`${mpBase}?kind=live#listings`} />
  </>
)}

{categories.length > 0 && (
  <section class={showHero ? 'relative -mt-10' : 'pt-2'}>
    <div class={`grid gap-3.5 ${gutters}`} style="grid-template-columns:repeat(auto-fit,minmax(180px,1fr));">
      {categories.map((c, i) => (
        <a
          href={`${mpBase}?category=${encodeURIComponent(c.id)}#listings`}
          class="block overflow-hidden rounded-[18px] border-[3px] border-ink bg-card no-underline shadow-zine transition-transform duration-zine ease-out hover:-translate-y-[3px] active:translate-y-0 active:shadow-zine-pressed"
        >
          <div class="border-b-zine border-ink"><TruckBorder kind={MOTIFS[i % MOTIFS.length]} /></div>
          <div class="flex flex-col gap-1.5 px-4 pb-3.5 pt-3">
            <div class="flex items-center justify-between gap-2">
              <span class="font-display text-[18px] font-normal uppercase tracking-[0.05em] text-ink">{c.label}</span>
              {c.emoji && <span class="text-[16px] leading-none">{c.emoji}</span>}
            </div>
            {/* Real count or nothing. The comp prints "8 LISTINGS · PAWRI ZONE"
                on every tile; that count is mock and the zone name is flavour
                the API does not carry. */}
            {typeof c.count === 'number' && (
              <span class={stub}>{c.count.toLocaleString('en-IN')} {c.count === 1 ? 'listing' : 'listings'}</span>
            )}
          </div>
        </a>
      ))}
    </div>
  </section>
)}

<div class={gutters}>
  <section class="pb-10 pt-9"><LiveNowRail client:visible /></section>

  {showSplit && (
    <section class="pb-12">
      <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
        <div class="flex flex-col gap-3 rounded-zine border-zine border-ink bg-paper2 p-7 shadow-zine">
          <span class="font-label text-[13px] font-extrabold uppercase tracking-[0.12em] text-blueInk">For fans</span>
          <h3 class="font-display text-[24px] font-normal uppercase tracking-[0.05em] text-ink">Browse right here</h3>
          <p class="font-body text-[15px] font-medium leading-[1.5] text-inkSoft">Everything works in your browser — explore, book and watch without downloading a thing.</p>
          <div class="pt-1"><a href="#listings" class={ctaLime}>Start browsing</a></div>
        </div>
        <div class="flex flex-col gap-3 rounded-zine border-zine border-ink bg-card p-7 shadow-zine">
          <span class="font-label text-[13px] font-extrabold uppercase tracking-[0.12em] text-blueInk">For creators</span>
          <h3 class="font-display text-[24px] font-normal uppercase tracking-[0.05em] text-ink">Sell from your dashboard</h3>
          <p class="font-body text-[15px] font-medium leading-[1.5] text-inkSoft">Create listings, bookings and AI agents on the web. Going live and sessions happen in the app.</p>
          <div class="pt-1"><a href="/sign-up" class={ctaBlue}>Become a creator</a></div>
        </div>
      </div>
    </section>
  )}

  <section id="listings" class="scroll-mt-20 pb-20">
    <div class="flex flex-wrap items-end gap-5">
      <div class="min-w-0 flex-[1_1_300px]">
        <p class={`${eyebrow} mb-2.5`}>Sab kuch, ek jagah</p>
        <h2 class={h2}>Explore <span class="text-coral">listings</span></h2>
      </div>
      <p class="max-w-[30ch] pb-1 font-body text-[17px] font-medium italic leading-[1.3] text-inkSoft">
        Jo dhoondoge, wahi milega.
      </p>
    </div>

    <div class="my-4 overflow-hidden rounded-[10px] border-zine border-ink"><TruckBorder kind="eyes" /></div>

    {/* showSearch is the inverse of showHero on purpose: the public page puts
        the search field in the strip above the hero (BazaarSearchStrip), so
        rendering a second one here would give the page two search boxes that
        do not agree with each other. The dashboard has no strip, so the grid
        keeps its own. */}
    <ExploreGrid
      client:visible
      initialQ={q}
      initialCategory={category}
      initialKind={kind}
      hrefBase={hrefBase}
      showSearch={!showHero}
    />
  </section>
</div>
