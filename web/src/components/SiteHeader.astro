---
/*
 * SiteHeader — the standard avaTOK header, site-wide.
 *
 * [WEB-HEADER-1 2026-08-26] Replaces two things at once:
 *   1. The nav that was PAINTED INTO the home page poster. Those words were
 *      pixels with transparent `.hotspot` anchors laid over them — unreadable to
 *      Google and to screen readers, and impossible to add a menu item to
 *      without redrawing the artwork. The poster is now cropped below the nav
 *      (`hero-poster-nonav.png`) and this header sits in its place.
 *   2. `Nav.astro`, whose five menu links pointed at homepage sections that no
 *      longer exist after the redesign (`#features`, `#receptionist`, `#number`,
 *      `#messaging`, `#faq` — all verified absent).
 *
 * It is built to blend into the poster: same cream ground (#f7ead5), the real
 * hand-drawn wordmark and the marigold ornament lifted straight out of the
 * artwork as PNGs, so the seam between header and hero is invisible.
 *
 * MENU ITEMS ARE DATA. Change `DEFAULT_LINKS` below, or pass `links` for one
 * page. That was the point of the exercise — the menu is editable on demand
 * now, which it could never be while it lived inside a JPEG.
 */
import HeaderAuth from '../islands/site/HeaderAuth.tsx';
import TruckBorder from './TruckBorder.astro';
// [LEGAL-UNREG-1 2026-08-28] Site-wide product-status disclosure. Lives here
// rather than in a layout because the home page emits its own document and
// never touches Base.astro — the header is the one thing every page shares.
import BetaBanner from './BetaBanner.astro';

export interface HeaderLink { href: string; label: string }

interface Props {
  /** Override the menu for a single page. Omit to use the site default. */
  links?: HeaderLink[];
  /** Sticky by default; the home page pins it over the poster. */
  sticky?: boolean;
  /**
   * How the right-hand CTA decides what to show.
   *
   * [WEB-HEADER-4 2026-08-26] `auto` mounts a Clerk island to read the live
   * session. That island brings its own <ClerkProvider>, and
   * @clerk/clerk-react THROWS "multiple <ClerkProvider>" if two of them mount
   * on one page — the React root then renders nothing and the CTA silently
   * vanishes. Caught on the live dashboard: the sidebar's SidebarUser already
   * owns a provider, so the header's disappeared. 15 pages mount a body Clerk
   * island (dashboard, all 7 admin pages, book, consult, agent, 4 vision).
   *
   * So pages that already know the answer say so instead of asking Clerk:
   *   'in'     — signed-in-only pages (dashboard, admin): static Dashboard link
   *   'static' — pages with their own Clerk island: static Log in / Sign up
   *   'auto'   — everywhere else: the island reads the real session
   *
   * Static means no second provider, no crash, and no JavaScript needed.
   */
  auth?: 'auto' | 'in' | 'static';
}

// The site menu. Every entry points at something that exists — checked.
const DEFAULT_LINKS: HeaderLink[] = [
  { href: '/marketplace', label: 'Marketplace' },
  { href: '/#live-streaming', label: 'Live events' },
  { href: '/#consultations', label: 'Private sessions' },
  { href: '/#voice-agents', label: 'AI voice' },
  { href: '/#marketplace-catalogue', label: 'Categories' },
  { href: '/sign-up', label: 'For creators' },
];

const { links = DEFAULT_LINKS, sticky = true, auth = 'auto' } = Astro.props;
---

{/* [WEB-THEME-1] The five brand faces. Loaded by the component rather than
    the layout because the HOME
    page does not use Base.astro at all — it emits its own raw document — so a
    layout-level font link would miss the one page the header matters most on.
    A stylesheet <link> in the body is honoured by every browser. */}
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Anton&family=Playfair+Display:ital,wght@1,900&family=Instrument+Sans:wght@400;500;600;700&family=Nunito:wght@400;600;700;800;900&family=Baloo+2:wght@700;800&family=Kalam:wght@400;700&display=swap" />

{/* [WEB-HEADER-5 2026-08-26] Owner: the bazaar band belongs above the site
    header. Inside <header> on purpose — a sticky header that left the band
    outside would scroll the band away and pin the bar on its own. */}
<BetaBanner />

<header class:list={['avh', sticky && 'avh--sticky']}>
  <TruckBorder kind="jhalar" count={60} class="avh-band" />
  <div class="avh-bar">
  <a class="avh-logo" href="/" aria-label="avaTOK home">
    <img src="/avatok-logo.png" alt="avaTOK" width="231" height="90" />
  </a>

  <nav class="avh-nav" aria-label="Main">
    {links.map((l) => <a href={l.href}>{l.label}</a>)}
  </nav>

  <div class="avh-right">
    {/* [WEB-HEADER-2 2026-08-26] Search pill removed at the owner's request.
        Browsing is reachable via the Marketplace link. */}
    {auth === 'in' ? (
      <Fragment>
        {/* [WEB-HEADER-SIGNOUT-2 2026-08-28] Dashboard AND Sign out. Signed-in
            pages previously rendered the Dashboard link alone, on the assumption
            that SidebarUser's profile card carried sign out — but in the current
            dashboard shell that card is below the fold, so there was no way out
            on screen. /sign-out works without a Clerk island on the page. */}
        <a class="avh-cta avh-cta--solid" href="/dashboard">Dashboard</a>
        <a class="avh-cta" href="/sign-out">Sign out</a>
      </Fragment>
    ) : auth === 'static' ? (
      <Fragment>
        <a class="avh-cta" href="/sign-in">Log in</a>
        <a class="avh-cta avh-cta--solid" href="/sign-up">Sign up</a>
      </Fragment>
    ) : (
      <HeaderAuth client:idle />
    )}
    <img class="avh-orn" src="/ornament-flower.png" alt="" width="85" height="80" aria-hidden="true" />
  </div>

  <button class="avh-burger" type="button" aria-label="Menu" aria-expanded="false" aria-controls="avh-mobile">
    <svg width="20" height="15" viewBox="0 0 20 15" aria-hidden="true">
      <path d="M1 1.5h18M1 7.5h18M1 13.5h18" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" />
    </svg>
  </button>
  </div>
</header>

<nav class="avh-mobile" id="avh-mobile" aria-label="Main (mobile)" hidden>
  {links.map((l) => <a href={l.href}>{l.label}</a>)}
  {/* [WEB-HEADER-10] Auth moves OUT of the bar and in here below 1100px. In the
      bar it sat between the wordmark and the burger and read as the header's
      main content on a phone. These are static links on purpose even when
      auth="auto": the bar's HeaderAuth island already owns a <ClerkProvider>,
      and a second one on the same page makes @clerk/clerk-react throw. */}
  {auth === 'in' ? (
    <Fragment>
      <a class="avh-mobile-auth avh-mobile-auth--solid" href="/dashboard">Dashboard</a>
      <a class="avh-mobile-auth" href="/sign-out">Sign out</a>
    </Fragment>
  ) : (
    <Fragment>
      <a class="avh-mobile-auth" href="/sign-in">Log in</a>
      <a class="avh-mobile-auth avh-mobile-auth--solid" href="/sign-up">Sign up</a>
    </Fragment>
  )}
</nav>

<script>
  // Progressive enhancement: the header is fully usable without this — the
  // mobile list is simply hidden until toggled.
  const burger = document.querySelector<HTMLButtonElement>('.avh-burger');
  const panel = document.getElementById('avh-mobile');
  burger?.addEventListener('click', () => {
    const open = burger.getAttribute('aria-expanded') === 'true';
    burger.setAttribute('aria-expanded', String(!open));
    if (panel) panel.hidden = open;
  });
</script>

<style is:global>
  /* Published header height. The dashboard pins its sidebar and its own toolbar
     to the viewport, so it needs to offset both by exactly this much or they
     slide underneath. Exposed as a variable so the two can never drift apart —
     change the padding below and the dashboard follows automatically. */
  :root { --avh-h: 90px; }
  @media (max-width: 620px) { :root { --avh-h: 60px; } }

  /* Header type: Anton matches the poster's condensed hand-lettered caps most
     closely of the faces already loaded for the auth screens. */
  /* [WEB-HEADER-5] .avh is now the SHELL: the bazaar band stacked over the bar.
     The row styles moved to .avh-bar — .avh used to be the flex row itself, and
     a band added as one of its children would have sat inline beside the logo. */
  .avh {
    --avh-cream: #f7ead5;
    --avh-ink: #161614;
    --avh-red: #d93825;
    display: block;
    background: var(--avh-cream);
    color: var(--avh-ink);
    font-family: 'Anton', Impact, 'Arial Narrow Bold', sans-serif;
  }

  .avh-bar {
    display: flex;
    align-items: center;
    gap: 30px;
    /* [WEB-HEADER-2] Taller at the owner's request: ~92px against the previous
       ~58px, so the header reads as real site chrome rather than a thin strip. */
    padding: 18px 30px;
  }

  .avh-band { display: block; }
  .avh--sticky { position: sticky; top: 0; z-index: 60; }

  .avh-logo { display: flex; align-items: center; flex: 0 0 auto; }
  .avh-logo img { display: block; height: 54px; width: auto; }

  .avh-nav { display: flex; align-items: center; gap: 24px; }
  .avh-nav a,
  .avh-mobile a {
    font-size: 16px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--avh-ink);
    text-decoration: none;
    white-space: nowrap;
  }
  .avh-nav a:hover,
  .avh-nav a:focus-visible {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  .avh-right { margin-left: auto; display: flex; align-items: center; gap: 14px; }


  .avh-orn { display: block; height: 46px; width: auto; }

  /* Auth CTAs (island) */
  .avh-cta {
    font-family: 'Anton', Impact, sans-serif;
    word-spacing: 0.22em;
    font-size: 16px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--avh-ink);
    text-decoration: none;
    background: none;
    border: 0;
    cursor: pointer;
    white-space: nowrap;
  }
  .avh-cta--solid {
    background: var(--avh-red);
    color: #fdf1d3;
    border-radius: 100px;
    padding: 12px 26px;
  }
  .avh-cta:focus-visible { outline: 3px solid var(--avh-red); outline-offset: 2px; }

  .avh-burger { display: none; margin-left: auto; border: 2px solid var(--avh-ink); border-radius: 100px; background: none; padding: 8px 11px; cursor: pointer; color: var(--avh-ink); }

  .avh-mobile { display: none; }

  @media (max-width: 1100px) {
    /* .avh-right holds Log in / Sign up; both are in the panel below now. */
    .avh-nav, .avh-orn, .avh-right { display: none; }
    .avh-burger { display: block; margin-left: auto; }
    .avh-mobile-auth { grid-column: 1 / -1; }
    .avh-mobile-auth--solid { background: var(--avh-red); color: #fdf1d3; }
    .avh-mobile:not([hidden]) {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
      padding: 0 16px 14px;
      background: var(--avh-cream);
    }
    .avh-mobile a {
      display: flex;
      min-height: 44px;
      align-items: center;
      justify-content: center;
      border: 2px solid var(--avh-ink);
      border-radius: 100px;
      background: #fff7e6;
    }
  }
  @media (max-width: 620px) {
    .avh-bar { gap: 12px; padding: 10px 14px; }
    .avh-logo img { height: 40px; }
  }
</style>
