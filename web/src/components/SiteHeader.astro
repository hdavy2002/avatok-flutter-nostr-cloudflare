---
import { HOME_HEADER_LINKS } from '../lib/homeNavigation';
import '../styles/folk-chrome.css';
// [SAATHUM-CHROME-1] The landing page's header/footer rules live here; imported
// by the chrome itself so every page that renders the header gets them.
import '../styles/saathum-folk.css';
import { publicImage } from '../lib/config';
/*
 * SiteHeader — the standard Saathum header, site-wide.
 *
 * [WEB-HEADER-1 2026-08-26] Replaces two things at once:
 *   1. The nav that was PAINTED INTO the home page poster. Those words were
 *      pixels with transparent `.hotspot` anchors laid over them — unreadable to
 *      Google and to screen readers, and impossible to add a menu item to
 *      without redrawing the artwork. The poster is now cropped below the nav
 *      (`hero-poster-nonav.png`) and this header sits in its place.
 *   2. `Nav.astro`, whose five menu links pointed at homepage sections that no
 *      longer exist after the redesign (`#features`, `#receptionist`, `#number`,
 *      `#messaging`, `#faq` — all verified absent).
 *
 * It is built to blend into the poster: same cream ground (#f7ead5), the real
 * hand-drawn wordmark and the marigold ornament lifted straight out of the
 * artwork as PNGs, so the seam between header and hero is invisible.
 *
 * MENU ITEMS ARE DATA. Change `DEFAULT_LINKS` below, or pass `links` for one
 * page. That was the point of the exercise — the menu is editable on demand
 * now, which it could never be while it lived inside a JPEG.
 */
// [WEB-AUTH-STATE-1 2026-08-28] HeaderAuth is no longer imported: the header's
// auth CTAs are plain links toggled by CSS from the cookie-derived
// html[data-avatok-auth] attribute. The island (and its <ClerkProvider>) was the
// reason the `static` and `in` modes had to exist at all. The file is kept for
// now rather than deleted, in case another surface still wants a React-side
// signal, but nothing renders it.
import TruckBorder from './TruckBorder.astro';
import GlobalHeader from './GlobalHeader.astro';
// [WEB-BANNER-OFF-1 2026-09-02] Owner asked for the site-wide product-status
// strip to come out of the header. BetaBanner.astro is kept on disk (unused) so
// it can be re-mounted here in one line if the payment-gateway review wants it
// back. The same disclosure still lives on /terms#status.
// [SHV2-S8 2026-09-21] IndiaLanguageSelector import removed: D9 hides the
// language picker on the India/Saathum shell (English only, no new translation
// catalogues). The component file itself is untouched — only unmounted here.

export interface HeaderLink { href: string; label: string }

interface Props {
  /** Approved reference homepage guest labels; other routes keep their existing auth links. */
  referenceHome?: boolean;
  /** Homepage-only phone and tablet navigation layouts. */
  responsiveHome?: boolean;
  /** Warm paper chrome, opt-in for the folk homepage only. */
  folk?: boolean;
  /** Override the menu for a single page. Omit to use the site default. */
  links?: HeaderLink[];
  /** Sticky by default; the home page pins it over the poster. */
  sticky?: boolean;
  /**
   * @deprecated [WEB-AUTH-STATE-1 2026-08-28] IGNORED. Accepted only so the ~15
   * pages that still pass it keep compiling; remove those and then remove this.
   *
   * It used to make each PAGE assert its visitor's auth state:
   *   'in'     — assume signed in  (dashboard, admin)
   *   'static' — assume signed OUT (pages with their own Clerk island)
   *   'auto'   — mount a Clerk island and actually check
   * ...which existed because a second <ClerkProvider> crashes
   * @clerk/clerk-react, so most pages could not ask. An assumption is wrong
   * whenever it is wrong: signed-out visitors on a dashboard URL saw "Sign out",
   * signed-in visitors on 'static' pages saw "Log in", and the mobile panel
   * showed signed-out links to everyone, always.
   *
   * The header now reads the real state from a cookie, before paint, with no
   * island. See lib/authState.ts.
   */
  auth?: 'auto' | 'in' | 'static';
  /** Global landing experience; the default remains the India header. */
  variant?: 'india' | 'global';
  /** Opt-in translation chrome for the India landing experience. */
  indiaLandingLanguage?: boolean;
  authMobileOnly?: boolean;
}

// [SHV2-S8 2026-09-21] Saathum attendee/organiser nav (Spec Part A3). Every
// entry points at something that exists — checked. Replaces the earlier
// Marketplace/Wiki/Pricing/Ideas set: "Live now" is deliberately not a nav
// item (A3 — with little or no inventory it would permanently lead nowhere).
const DEFAULT_LINKS: HeaderLink[] = [
  { href: '/marketplace', label: 'Explore events' },
  { href: '/#experiences', label: 'Experiences' },
  { href: '/organisers', label: 'For organisers' },
  { href: '/help', label: 'Help' },
];

// [SAATHUM-CHROME-1 2026-09-23] OWNER DECISION: the landing-page header is the
// ONE standard header, site-wide. The old truck-art header (jhalar band, flower
// ornament, "Log in / Sign up") is retired for the india variant — folk,
// referenceHome and responsiveHome now default ON, and the menu defaults to the
// landing page's menu. Do not re-introduce a second india header style.
const LANDING_LINKS: HeaderLink[] = [
  { href: '/marketplace', label: 'Explore events' },
  { href: '/#experiences', label: 'Experiences' },
  { href: '/#joining', label: 'How it works' },
];
void HOME_HEADER_LINKS; void DEFAULT_LINKS;
// `auth` is destructured and ignored on purpose — see the deprecation note above.
const { folk = true, referenceHome = folk, links = folk ? LANDING_LINKS : DEFAULT_LINKS, sticky = true, responsiveHome = folk, variant = 'india', indiaLandingLanguage = true, authMobileOnly = false } = Astro.props;
const folkBorder = `--folk-border-url:url(${publicImage('/assets/saathum-bright/border.png', { width: 640, fit: 'scale-down' })})`;
const globalLinks: HeaderLink[] = [
  { href: '/global-ideas', label: 'Ideas' },
  { href: '#formats', label: 'For creators' },
  { href: '#how-it-works', label: 'How it works' },
  { href: '#payouts', label: 'Payouts' },
];
const headerLinks = variant === 'global' ? globalLinks : links;
// [SHV2-S8] Only the 'global' variant's nav is still localised — D9 takes the
// India/Saathum shell English-only, so the new default links never carry a
// data-india-i18n key (AC-18: no old key may be reused with new wording under
// it, since dom.ts would replay a stale translation over the new copy).
const chromeNavKey = (label: string) => ({ Ideas: 'chrome.ideas', 'For creators': 'chrome.forCreators', 'How it works': 'chrome.howItWorks', Payouts: 'chrome.payouts' } as Record<string, string>)[label];
---

{variant === 'global' ? <GlobalHeader sticky={sticky} /> : <>
{/* [WEB-THEME-1] The five brand faces. Loaded by the component rather than
    the layout because the HOME
    page does not use Base.astro at all — it emits its own raw document — so a
    layout-level font link would miss the one page the header matters most on.
    A stylesheet <link> in the body is honoured by every browser. */}
{folk && <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&display=swap" />}
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Comfortaa:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,700;0,900;1,700;1,900&family=Instrument+Sans:wght@400;500;600;700&family=Nunito:wght@400;600;700;800;900&family=Baloo+2:wght@600;700;800&family=Kalam:wght@400;700&display=swap" />
{indiaLandingLanguage && <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans:wght@400;600;700&display=swap" />}

{/* [WEB-HEADER-5 2026-08-26] Owner: the bazaar band belongs above the site
    header. Inside <header> on purpose — a sticky header that left the band
    outside would scroll the band away and pin the bar on its own. */}
{/* [WEB-AUTH-STATE-1] Runs BEFORE paint (is:inline, no bundle, no await), so the
    correct buttons are the first ones drawn — no flash of "Log in" for a
    signed-in user. Duplicated from lib/authState.ts on purpose: an inline
    pre-paint script cannot import a module. Keep the two in step; the module is
    the documented original. */}
<script is:inline>
  (function () {
    try {
      var c = document.cookie;
      var m = c.match(/(?:^|;\s*)__client_uat(?:_[A-Za-z0-9]+)?=([^;]*)/);
      var signedIn = !!(m && m[1] && m[1] !== '0');
      if (!signedIn) {
        try { signedIn = !!localStorage.getItem('avatok_guest_jwt'); } catch (e) {}
      }
      document.documentElement.setAttribute('data-avatok-auth', signedIn ? 'in' : 'out');
    } catch (e) {
      document.documentElement.setAttribute('data-avatok-auth', 'out');
    }
  })();
</script>

{/* [SAATHUM-CHROME-1] display:contents wrapper: carries the landing page's
    .folk-site[data-design="saathum-reference-v5"] scope (fonts, colours,
    --grand-* tokens) onto the header on EVERY page without creating a box,
    so position:sticky still pins to the viewport. The marigold ribbon that
    used to be hand-placed on index/organisers now lives here. */}
<div class:list={[folk && 'folk-site saathum-chrome']} data-design={folk ? 'saathum-reference-v5' : undefined} style={folk ? `display:contents;${folkBorder}` : 'display:contents'}>
{folk && <div class="folk-ribbon" aria-hidden="true"></div>}
<header class:list={['avh', folk && 'avh--folk', authMobileOnly && 'avh--auth-mobile', sticky && 'avh--sticky', responsiveHome && 'avh--home', variant === 'global' && 'avh--global']}>
  {!folk && <TruckBorder kind="jhalar" count={60} class="avh-band" />}
  <div class="avh-bar">
  {/* [SHV2-S8 2026-09-21] D8/A2: diya mark + "Saathum" set in the existing
      heading face, replacing the avaTOK wordmark PNG (the header previously
      already said alt="Saathum" while the artwork itself still read "avaTOK"
      — a mismatch this fixes). Icon is decorative (alt=""); the anchor's own
      aria-label carries the accessible name. */}
  <a class="avh-logo" href="/" aria-label="Saathum home" data-india-i18n-attr={indiaLandingLanguage ? 'aria-label:chrome.home' : undefined}>
    {folk ? <img class="folk-lotus-mark" data-folk-artwork="lotus" src={publicImage('/assets/saathum-bright/lotus.png', { width: 160, fit: 'scale-down' })} alt="" width="64" height="64" /> : <img src={publicImage('/diya-logo.png', { width: 160, fit: 'scale-down' })} alt="" width="54" height="54" />}
    <span class="avh-logo-text">Saathum</span>
  </a>

  <nav class="avh-nav" aria-label="Main" data-india-i18n-attr={indiaLandingLanguage ? 'aria-label:chrome.mainNav' : undefined}>
    {headerLinks.map((l) => <a href={l.href} data-india-i18n={variant === 'global' && indiaLandingLanguage ? chromeNavKey(l.label) : undefined}>{l.label}</a>)}
  </nav>

  <div class="avh-right">
    {/* [SHV2-S8 2026-09-21] IndiaLanguageSelector unmounted here — D9 hides
        the language picker on the India/Saathum shell (English only). */}
    {/* [WEB-HEADER-2 2026-08-26] Search pill removed at the owner's request.
        Browsing is reachable via the Categories and Ideas links. */}
    {/* [WEB-AUTH-STATE-1 2026-08-28] BOTH states are rendered, and CSS shows one.
        See lib/authState.ts for why. In short: the old three-way `auth` prop made
        each PAGE assert whether its visitor was signed in, so a signed-out
        visitor on a dashboard URL saw "Sign out", a signed-in visitor on a
        `static` page saw "Log in", and the mobile panel showed signed-out links
        to everyone. The truth lives in a cookie; the page should not be guessing.

        No Clerk island is needed for this any more, which also removes the
        double-<ClerkProvider> crash that forced the `static` mode to exist. */}
    <Fragment>
      <a class="avh-cta avh-auth-out" href={variant === 'global' ? '/sign-in?next=/' : '/sign-in'} data-india-i18n={indiaLandingLanguage ? 'chrome.login' : undefined}>{referenceHome ? 'Sign in' : 'Log in'}</a>
      <a class="avh-cta avh-cta--solid avh-auth-out" href={referenceHome ? '/organisers' : variant === 'global' ? '/sign-up?role=creator&country=global' : '/sign-up'} data-india-i18n={indiaLandingLanguage ? 'chrome.signup' : undefined}>{referenceHome ? 'Become an organiser' : 'Sign up'}</a>
      <a class="avh-cta avh-cta--solid avh-auth-in" href="/dashboard" data-india-i18n={indiaLandingLanguage ? 'chrome.dashboard' : undefined}>Dashboard</a>
    <a class="avh-cta avh-auth-in" href="/sign-out" data-india-i18n={indiaLandingLanguage ? 'chrome.signout' : undefined}>Sign out</a>
    {variant === 'global' && <span data-india-i18n-attr="aria-label:web-common.c8b7fff1b82d47c8" data-i18n="web-common.a723fec7087f1226" class="avh-locale" aria-label="Current country">🌍 Global</span>}
    {variant === 'global' && <a data-india-i18n-attr="aria-label:web-common.268947545b973f7d" data-i18n="web-common.e632a1efa068f672" class="avh-locale" href="/india" aria-label="Open India experience">🇮🇳 India</a>}
    {variant === 'global' && <a data-india-i18n-attr="aria-label:web-common.bba5b40bdd28c66e" data-i18n="web-common.69374b09b1681162" class="avh-locale" href="#language" aria-label="Choose language">EN</a>}
    </Fragment>
    {!folk && <img class="avh-orn" src={publicImage('/ornament-flower.png', { width: 170, fit: 'scale-down' })} alt="" width="85" height="80" aria-hidden="true" />}
  </div>

  <button class="avh-burger" type="button" aria-label={folk ? "Open menu" : "Menu"} aria-expanded="false" aria-controls="avh-drawer" aria-haspopup="dialog" data-india-i18n-attr={!folk && indiaLandingLanguage ? 'aria-label:chrome.menu' : undefined}>
    <svg width="20" height="15" viewBox="0 0 20 15" aria-hidden="true">
      <path d="M1 1.5h18M1 7.5h18M1 13.5h18" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" />
    </svg>
  </button>
  </div>

</header>

{/* Independent top-layer drawer: the sticky header never moves or resizes. */}
<dialog data-india-i18n-attr="aria-label:web-common.3f9abc8733ba366a" class:list={['avh-drawer', folk && 'avh-drawer--folk', authMobileOnly && 'avh--auth-mobile']} id="avh-drawer" aria-label="Navigation menu">
  <div class="avh-drawer-heading">
    {/* [SHV2-S8 2026-09-21] Same diya + "Saathum" lockup as the desktop bar,
        scaled for the drawer's narrower heading row. */}
    <div class="avh-drawer-brand">
      {folk ? <img class="folk-lotus-mark" data-folk-artwork="lotus" src={publicImage('/assets/saathum-bright/lotus.png', { width: 128, fit: 'scale-down' })} alt="" width="48" height="48" /> : <img src={publicImage('/diya-logo.png', { width: 128, fit: 'scale-down' })} alt="" width="44" height="44" />}
      <span class="avh-drawer-brand-text">Saathum</span>
    </div>
    <button data-india-i18n-attr="aria-label:web-common.6ccd5c7856042d36" class="avh-drawer-close" type="button" aria-label="Close menu" autofocus>×</button>
  </div>
<nav class:list={['avh-mobile', responsiveHome && 'avh-mobile--home']} id="avh-mobile" aria-label="Main (mobile)" data-india-i18n-attr={indiaLandingLanguage ? 'aria-label:chrome.mainNav' : undefined}>
  {/* [SHV2-S8 2026-09-21] IndiaLanguageSelector unmounted here too — see the
      desktop instance above. */}
  {headerLinks.map((l) => <a href={l.href} data-india-i18n={variant === 'global' && indiaLandingLanguage ? chromeNavKey(l.label) : undefined}>{l.label}</a>)}
  {/* [WEB-HEADER-10] Auth moves OUT of the bar and in here below 1100px.
      [WEB-AUTH-STATE-1 2026-08-28] These used to be signed-OUT links on every
      page regardless of session — the comment here said so, blaming the
      double-<ClerkProvider> crash. The result was that a signed-in user on a
      phone was shown "Log in / Sign up" with no way to reach their dashboard or
      sign out. CSS-driven state fixes it with no provider at all. */}
  <Fragment>
    <a class="avh-mobile-auth avh-auth-out" href={variant === 'global' ? '/sign-in?next=/' : '/sign-in'} data-india-i18n={indiaLandingLanguage ? 'chrome.login' : undefined}>{referenceHome ? 'Sign in' : 'Log in'}</a>
    <a class="avh-mobile-auth avh-mobile-auth--solid avh-auth-out" href={referenceHome ? '/organisers' : variant === 'global' ? '/sign-up?role=creator&country=global' : '/sign-up'} data-india-i18n={indiaLandingLanguage ? 'chrome.signup' : undefined}>{referenceHome ? 'Become an organiser' : 'Sign up'}</a>
    <a class="avh-mobile-auth avh-mobile-auth--solid avh-auth-in" href="/dashboard" data-india-i18n={indiaLandingLanguage ? 'chrome.dashboard' : undefined}>Dashboard</a>
    <a class="avh-mobile-auth avh-auth-in" href="/sign-out" data-india-i18n={indiaLandingLanguage ? 'chrome.signout' : undefined}>Sign out</a>
  </Fragment>
  {variant === 'global' && <a data-i18n="web-common.a9744a11b7d55a26" class="avh-mobile-auth" href="/india">🌍 India</a>}
</nav>
</dialog>
</div>



</>}

<script>
  if (document.querySelector('[data-india-language-select]')) {
    import('../lib/indiaLandingLanguage').then(({ initIndiaLandingLanguage }) => initIndiaLandingLanguage(document));
  }
  const burger = document.querySelector<HTMLButtonElement>('.avh-burger');
  const drawer = document.querySelector<HTMLDialogElement>('#avh-drawer');
  const panel = document.getElementById('avh-mobile');
  window.matchMedia('(min-width: 768px)').addEventListener('change', event => { if (event.matches && drawer?.classList.contains('avh--auth-mobile')) finishClose(false); });
  const closeButton = drawer?.querySelector<HTMLButtonElement>('.avh-drawer-close');
  let closeTimer: ReturnType<typeof setTimeout> | undefined;
  let rootOverflow = '';
  let savedScrollY = 0;
  let savedScrollX = 0;
  let closing = false;

  function finishClose(restoreFocus = true) {
    if (!drawer?.open) return;
    clearTimeout(closeTimer);
    drawer.classList.remove('is-open');
    drawer.close();
    document.documentElement.style.overflow = rootOverflow;
    window.scrollTo({ left: savedScrollX, top: savedScrollY, behavior: 'instant' });
    burger?.setAttribute('aria-expanded', 'false');
    closing = false;
    if (restoreFocus) burger?.focus({ preventScroll: true });
  }

  function closeDrawer(immediate = false, restoreFocus = true) {
    if (!drawer?.open || closing) return;
    closing = true;
    drawer.classList.remove('is-open');
    burger?.setAttribute('aria-expanded', 'false');
    if (immediate || window.matchMedia('(prefers-reduced-motion: reduce)').matches) finishClose(restoreFocus);
    else closeTimer = setTimeout(() => finishClose(restoreFocus), 220);
  }

  function openDrawer() {
    if (!drawer || drawer.open) return;
    savedScrollY = window.scrollY;
    savedScrollX = window.scrollX;
    rootOverflow = document.documentElement.style.overflow;
    drawer.showModal(); // Native focus containment and an inert background.
    document.documentElement.style.overflow = 'hidden';
    window.scrollTo({ left: savedScrollX, top: savedScrollY, behavior: 'instant' });
    burger?.setAttribute('aria-expanded', 'true');
    requestAnimationFrame(() => requestAnimationFrame(() => {
      if (drawer.open && !closing) drawer.classList.add('is-open');
    }));
  }

  burger?.addEventListener('click', openDrawer);
  closeButton?.addEventListener('click', () => closeDrawer());
  drawer?.addEventListener('cancel', (event) => { event.preventDefault(); closeDrawer(); });
  drawer?.addEventListener('click', (event) => {
    if (event.target !== drawer) return;
    const rect = drawer.getBoundingClientRect();
    if (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom) closeDrawer();
  });
  panel?.addEventListener('click', (event) => {
    if ((event.target as Element).closest('a')) closeDrawer(true, false);
  });
  window.matchMedia('(min-width: 1101px)').addEventListener('change', (event) => {
    if (event.matches) closeDrawer(true, false);
  });

  // [WEB-POSTHOG-1] §2.9 nav_click{item}. Contract:
  // Specs/SPEC-2026-09-02-TELEMETRY-CATALOG.md §2.9. Delegated on the header
  // root rather than per-link, so it keeps working across the desktop bar, the
  // mobile panel and either auth-state pair without re-wiring on toggle.
  document.querySelectorAll<HTMLAnchorElement>('.avh-nav a, .avh-mobile a, .avh-cta, .avh-mobile-auth').forEach((el) => {
    el.addEventListener('click', () => {
      const item = (el.textContent || el.getAttribute('href') || 'unknown').trim();
      import('../lib/analytics').then(({ capture }) => capture('nav_click', { item }));
    });
  });
</script>

<style is:global>
  /* [WEB-AUTH-STATE-1 2026-08-28] Which auth CTAs are visible.
     Default — attribute absent, e.g. JS disabled — is SIGNED OUT, because
     offering "Log in" to someone already signed in is a mild annoyance while
     offering "Dashboard / Sign out" to an anonymous visitor is a broken page.
     `display: none !important` because .avh-cta sets its own display. */
  .avh-auth-in { display: none !important; }
  html[data-avatok-auth='in'] .avh-auth-in { display: inline-flex !important; }
  html[data-avatok-auth='in'] .avh-auth-out { display: none !important; }

  /* Published header height. The dashboard pins its sidebar and its own toolbar
     to the viewport, so it needs to offset both by exactly this much or they
     slide underneath. Exposed as a variable so the two can never drift apart —
     change the padding below and the dashboard follows automatically. */
  :root { --avh-h: 90px; }
  @media (max-width: 620px) { :root { --avh-h: 60px; } }

  /* Header type: [UI-COMFORTAA-1 2026-09-10] Was Anton. The logo itself is a
     PNG of the hand-drawn wordmark (not set type), so this only ever styled the
     nav links and auth CTAs — short, uppercase, tracked label text. That is
     Nunito's job sitewide (CLAUDE.md type rules), not the new display face. */
  /* [WEB-HEADER-5] .avh is now the SHELL: the bazaar band stacked over the bar.
     The row styles moved to .avh-bar — .avh used to be the flex row itself, and
     a band added as one of its children would have sat inline beside the logo. */
  .avh {
    --avh-cream: #f7ead5;
    --avh-ink: #161614;
    --avh-red: #d93825;
    display: block;
    background: var(--avh-cream);
    color: var(--avh-ink);
    font-family: 'Nunito', system-ui, sans-serif;
  }

  .avh-bar {
    display: flex;
    align-items: center;
    gap: 30px;
    /* [WEB-HEADER-2] Taller at the owner's request: ~92px against the previous
       ~58px, so the header reads as real site chrome rather than a thin strip. */
    padding: 18px 30px;
  }

  .avh-band { display: block; }
  @media (min-width: 768px) { .avh--auth-mobile { display: none !important; } }
  .avh--sticky { position: sticky; top: 0; z-index: 60; }

  .avh-logo { display: flex; align-items: center; gap: 10px; flex: 0 0 auto; }
  .avh-logo img { display: block; height: 54px; width: auto; }
  /* [SHV2-S8 2026-09-21] "Saathum" set in the same face as the footer's own
     text lockup (.bf-logo) — Comfortaa/Baloo 2 are already loaded above and
     var(--avh-ink) is the header's existing ink token, so nothing new here. */
  .avh-logo-text {
    font-family: 'Comfortaa', 'Baloo 2', sans-serif;
    font-weight: 700;
    font-size: 26px;
    color: var(--avh-ink);
    white-space: nowrap;
  }

  /* [SHV2-S8 2026-09-21] Four items at the desktop tier (Explore events,
     Experiences, For organisers, Help — A3). The switch to the mobile burger
     stays at max-width:1100px below, unchanged. */
  .avh-nav { display: flex; align-items: center; gap: 24px; }
  .avh-nav a,
  .avh-mobile a {
    font-size: 16px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--avh-ink);
    text-decoration: none;
    white-space: nowrap;
  }
  .avh-nav a:hover,
  .avh-nav a:focus-visible {
    text-decoration: underline;
    text-decoration-thickness: 2px;
