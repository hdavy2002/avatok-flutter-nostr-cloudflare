---
import { globalCreatorIdeas } from '../lib/globalCreatorIdeas';
import { publicImage } from '../lib/config';
interface Props {
  idea: { slug: string; platform: string; title: string; description: string; color: string; eyebrow: string };
  headingLevel?: 'h2' | 'h3';
}
const { idea, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
const index = globalCreatorIdeas.findIndex(item => item.slug === idea.slug);
const width = [396, 376, 368, 396][index % 4];
---
<a class="original-idea-card" href={`/blog/global-creator-ideas/${idea.slug}/`} data-india-i18n-attr={`aria-label:web-global-ideas.${idea.slug}.aria`} aria-label={`${idea.title} — read the ${idea.platform} creator guide`}>
  <img src={publicImage(`/assets/global-original/ideas-${idea.slug}.png`, { width, fit: 'scale-down' })} alt="" width={width} height={index < 4 ? 308 : 320} loading="lazy" decoding="async" />
  <div class="original-idea-card__text"><Heading data-i18n={`web-global-ideas.${idea.slug}.title`}>{idea.title}</Heading><span>{idea.platform}. <ui-copy style="display:contents" data-i18n={`web-global-ideas.${idea.slug}.description`}>{idea.description}</ui-copy> <ui-copy style="display:contents" data-i18n="web-common.53ee635fa07e53b4">Read the guide.</ui-copy></span></div>
</a>
<style>
  .original-idea-card{display:block;position:relative;min-width:0;width:100%;text-decoration:none;background:transparent}
  .original-idea-card img{display:block;width:100%;height:auto;opacity:1;visibility:visible;transform:none;animation:none}
  .original-idea-card__text{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}
  .original-idea-card:focus-visible{outline:4px solid #ed2924;outline-offset:-4px}
  :global(html:not([lang="en"])) .original-idea-card img { display:none; }
  :global(html:not([lang="en"])) .original-idea-card__text { position:static;width:auto;height:auto;overflow:visible;clip-path:none;padding:24px;border:2px solid currentColor;border-radius:16px;background:var(--paper,#fff5df); }
  :global(html:not([lang="en"])) .original-idea-card__text :is(h2,h3) { font-size:1.5rem;line-height:1.3;margin:0 0 12px; }
</style>
