---
interface Props {
  idea: { slug: string; platform: string; title: string; description: string; color: string; eyebrow: string };
  headingLevel?: 'h2' | 'h3';
}
const { idea, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
---
<a class:list={['global-idea', `global-idea--${idea.color}`]} href={`/blog/global-creator-ideas/${idea.slug}/`}>
  <picture><source type="image/webp" srcset={`/assets/global/idea-${idea.slug}-480.webp 480w, /assets/global/idea-${idea.slug}-960.webp 960w`} sizes="(max-width: 430px) 95vw, (max-width: 1100px) 46vw, 24vw" /><img class="global-idea__image" src={`/assets/global/idea-${idea.slug}.png`} alt="" width="1254" height="1254" loading="lazy" decoding="async" /></picture>
  <span class="global-idea__platform">{idea.platform.split(' + ').map((platform, index) => <>{index > 0 && <span aria-hidden="true"> + </span>}<span class:list={['global-platform-icon', `global-platform-icon--${platform.toLowerCase()}`]} aria-hidden="true">{platform === 'YouTube' ? '▶' : platform === 'TikTok' ? '♪' : '◎'}</span> {platform}</>)}</span>
  <div class="global-idea__copy"><Heading><span>{idea.title}</span></Heading><p>{idea.description}</p><span class="global-idea__link">Read the guide <span aria-hidden="true">↗</span></span></div>
  <span class="global-idea__note" aria-hidden="true">Real fans.<br />Real connection. ♡</span>
</a>
