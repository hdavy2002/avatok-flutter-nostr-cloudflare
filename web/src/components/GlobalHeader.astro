---
import { publicImage } from '../lib/config';
import GlobalLocaleControls from './GlobalLocaleControls.astro';
import '../styles/global-home.css';
interface Props { sticky?: boolean; }
const { sticky = true } = Astro.props;
const links = [
  { href: '/marketplace', label: 'Explore' },
  { href: '/#formats', label: 'For creators' },
  { href: '/#how-it-works', label: 'How it works' },
  { href: '/#payouts', label: 'Payouts' },
];
---
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT@144,800,100;144,900,100&family=Instrument+Sans:wght@400;500;600;700&family=Kalam:wght@400;700&display=swap" />
<script is:inline>
  try {
    var match = document.cookie.match(/(?:^|;\s*)__client_uat(?:_[A-Za-z0-9]+)?=([^;]*)/);
    var signedIn = !!(match && match[1] && match[1] !== '0');
    try { signedIn = signedIn || !!localStorage.getItem('avatok_guest_jwt'); } catch (_) {}
    document.documentElement.setAttribute('data-avatok-auth', signedIn ? 'in' : 'out');
  } catch (_) { document.documentElement.setAttribute('data-avatok-auth', 'out'); }
</script>
<header class:list={['avh', 'global-header', sticky && 'global-header--sticky']}>
  <div class="global-header__doodle original-header-doodle" aria-hidden="true"><img src={publicImage('/assets/global-original/ideas-header-doodle.png', { width: 1536, fit: 'scale-down' })} alt="" width="1536" height="30" /></div>
  <div class="global-header__bar">
    <a class="global-wordmark" href="/" aria-label="avaTOK global home"><img src={publicImage('/assets/global-original/ideas-header-logo.png', { width: 336, fit: 'scale-down' })} alt="avaTOK" width="168" height="57" /></a>
    <nav class="global-header__nav" aria-label="Main">{links.map(link => <a href={link.href}>{link.label}</a>)}</nav>
    <div class="global-header__actions">
      <GlobalLocaleControls />
      <a class="global-header__login avh-auth-out" href="/sign-in">Log in</a>
      <a class="global-button global-button--red avh-auth-out" href="/sign-up?role=creator&country=global">Start earning <span aria-hidden="true">↗</span></a>
      <a class="global-button global-button--red avh-auth-in" href="/dashboard">Dashboard</a>
      <a class="global-header__login avh-auth-in" href="/sign-out">Sign out</a>
    </div>
    <details class="global-mobile-menu">
      <summary aria-label="Open navigation"><svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg></summary>
      <nav aria-label="Main mobile">
        {links.map(link => <a href={link.href}>{link.label}</a>)}
        <a href="/global-ideas">Creator ideas</a>
        <a class="avh-auth-out" href="/sign-in">Log in</a>
        <a class="avh-auth-out" href="/sign-up?role=creator&country=global">Start earning →</a>
        <a class="avh-auth-in" href="/dashboard">Dashboard</a>
        <a class="avh-auth-in" href="/sign-out">Sign out</a>
        <a href="/india">🇮🇳 Switch to India</a>
      </nav>
    </details>
  </div>
</header>
<style>
  .global-header .original-header-doodle{padding:4px 0;height:auto;min-height:38px;justify-content:center;gap:0}
  .global-header .original-header-doodle img{display:block;flex:0 0 auto;width:100%;min-width:1536px;max-width:none;height:auto;object-fit:contain;object-position:center;opacity:1;transform:none}
</style>
<script>
  document.querySelectorAll<HTMLAnchorElement>('.global-header a').forEach(link => {
    link.addEventListener('click', () => {
      const item = (link.textContent || link.getAttribute('href') || 'unknown').trim();
      import('../lib/analytics').then(({ capture }) => capture('nav_click', { item, location: 'header' }));
    });
  });
  document.querySelectorAll<HTMLDetailsElement>('.global-mobile-menu').forEach(menu => {
    menu.querySelectorAll('a').forEach(link => link.addEventListener('click', () => { menu.open = false; }));
    menu.addEventListener('keydown', event => {
      if (event.key === 'Escape') { menu.open = false; menu.querySelector<HTMLElement>('summary')?.focus(); }
    });
  });
</script>
