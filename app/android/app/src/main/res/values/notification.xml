<?xml version="1.0" encoding="utf-8"?>
<!-- [NOTIF-ICON-1] Tint applied by Android behind the monochrome status-bar
     glyph (drawable-*/ic_notification.png) and to the small icon shown inside
     the expanded notification. Android throws away every colour in the icon
     itself, so this resource is the ONLY way to get brand colour into the
     shade. Bright AvaTOK yellow makes message alerts immediately recognizable;
     the status-bar glyph itself remains Android's required monochrome shape. -->
<resources>
    <color name="avatok_notification_accent">#FFD400</color>
</resources>
