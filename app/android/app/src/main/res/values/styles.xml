<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme applied to the Android Window while the process is starting when the OS's Dark Mode setting is off -->
    <!-- [UI-COLDSTART-1 2026-08-05] Theme.Light -> Theme.Black. AvaTOK's UI does
         not follow the system light/dark setting; it is dark always. Parenting
         the light-mode launch theme to Theme.Light meant a light-mode phone got
         a white system window before Flutter's first dark frame. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <!-- Show a splash screen on the activity. Automatically removed when
             the Flutter engine draws its first frame -->
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Theme applied to the Android Window as soon as the process has started.
         This theme determines the color of the Android Window while your
         Flutter UI initializes, as well as behind your Flutter UI while its
         running.

         This Theme is only used starting with V2 of Flutter's Android embedding. -->
    <!-- flutter_stripe requires the host activity's theme to descend from
         Theme.AppCompat / Theme.MaterialComponents (the PaymentSheet uses
         AppCompat components). Flutter draws its own UI, so this is invisible. -->
    <!-- [UI-COLDSTART-2 2026-08-06] windowBackground pinned to the app's real
         background, NOT ?android:colorBackground.

         This is the flash the owner still saw after [UI-COLDSTART-1]. That fix
         patched LaunchTheme and launch_background.xml, but MISSED this one —
         and NormalTheme is the window shown AFTER LaunchTheme and BEFORE
         Flutter's first frame. `?android:colorBackground` resolves against
         DayNight, so on a phone in LIGHT mode it is WHITE, while AvaTOK is dark
         on every surface regardless of the system setting. Result: dark splash
         -> white window -> dark app, every single cold start.

         Keep the MaterialComponents parent: flutter_stripe's PaymentSheet needs
         an AppCompat/MaterialComponents-descended host activity theme. Only the
         window background is overridden. -->
    <style name="NormalTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/avatok_launch_bg</item>
    </style>
</resources>
