<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- [STREAM-PROD-11] This production pilot is 1:1 audio only. Stream core's
         library manifest also advertises livestream playback and screen-share
         projection. Those unused capabilities add Play foreground-service
         declarations that are unrelated to an audio call, so remove both the
         permissions and their owning services in this pilot source set. -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION"
        tools:node="remove" />
    <application>
        <!-- Present only in the opt-in pilot source set. Normal Cloudflare APKs
             expose none of Stream's notification actions. -->
        <activity
            android:name="ai.avatok.avatok_call.MainActivity"
            tools:node="merge">
            <intent-filter android:priority="1">
                <action android:name="io.getstream.video.android.action.INCOMING_CALL" />
                <action android:name="io.getstream.video.android.action.ACCEPT_CALL" />
                <action android:name="io.getstream.video.android.action.OUTGOING_CALL" />
                <action android:name="io.getstream.video.android.action.ONGOING_CALL" />
                <action android:name="io.getstream.video.android.action.NOTIFICATION" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <service
            android:name="io.getstream.android.push.firebase.ChatFirebaseMessagingService"
            tools:node="remove" />
        <service
            android:name="io.getstream.video.android.core.screenshare.StreamScreenShareService"
            tools:node="remove" />
        <service
            android:name="io.getstream.video.android.core.notifications.internal.service.LivestreamViewerService"
            tools:node="remove" />
        <service
            android:name="ai.avatok.streamcall.AvaTokStreamFirebaseMessagingService"
            android:exported="false">
            <intent-filter android:priority="1">
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
