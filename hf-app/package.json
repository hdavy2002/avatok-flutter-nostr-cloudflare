{
  "name": "hf-app",
  "version": "1.0.0",
  "private": true,
  "description": "Android shell (Capacitor) that opens the live website. See README.md.",
  "scripts": {
    "brand": "node scripts/brand.mjs print",
    "icons": "node scripts/make-icons.mjs && capacitor-assets generate --android --assetPath assets",
    "sync": "cap sync android && node scripts/brand.mjs offline",
    "doctor": "cap doctor"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.5.3",
    "@capacitor/network": "8.0.1",
    "@capacitor/push-notifications": "8.1.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.3",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
