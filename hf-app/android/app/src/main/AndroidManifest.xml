<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Custom scheme (first label of the site domain): the DigiLocker return fallback.
                 ${hfScheme} and ${hfHost} are filled from Specs/brand.json by app/build.gradle. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${hfScheme}" />
            </intent-filter>

            <!-- [HF-APP-LINKS-1] Verified Android App Links for the WHOLE site: every https link on the brand host
                 (apex and www), any path. Links in emails, WhatsApp and SMS open the app when it is installed; the site
                 (appMode.ts) then loads the same path. Needs assetlinks.json on BOTH hosts (see Specs/HF-APP-DEEPLINK.md).
                 ${hfHost} and ${hfWwwHost} come from Specs/brand.json via app/build.gradle. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="${hfHost}" />
                <data android:host="${hfWwwHost}" />
            </intent-filter>
        </activity>

        <!-- [HF-APP-4] Push: icon, accent colour and channel used when FCM shows a notification while the app is closed.
             The channel itself is created by the site (lib/appPush.ts) with the same id. -->
        <meta-data android:name="com.google.firebase.messaging.default_notification_icon" android:resource="@drawable/ic_stat_notify" />
        <meta-data android:name="com.google.firebase.messaging.default_notification_color" android:resource="@color/hf_notification_color" />
        <meta-data android:name="com.google.firebase.messaging.default_notification_channel_id" android:value="@string/hf_notification_channel_id" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions: this is the COMPLETE list. Never add phone, SMS, contacts, call-log or location. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Camera and microphone are optional hardware, so Play does not hide the app from other devices. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
</manifest>
